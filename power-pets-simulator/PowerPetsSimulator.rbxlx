	Hatch = { Id = "rbxasset://sounds/glassbreak.wav", Volume = 0.35, Pitch = 1.4 },
	Rare = { Id = "rbxasset://sounds/victory.wav", Volume = 0.6, Pitch = 1 },
	Rebirth = { Id = "rbxasset://sounds/victory.wav", Volume = 0.7, Pitch = 0.85 },
