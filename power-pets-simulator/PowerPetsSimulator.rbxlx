        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Backpacks</string>
            <string name="Source"><![CDATA[--[[
	Backpacks — рюкзаки. Сила от кликов копится до Capacity, потом её нужно продать.
	Рюкзаки покупаются по порядку за монеты в магазине. Первый выдаётся бесплатно.
]]

local Backpacks = {
	{ Name = "Мешочек", Icon = "👝", Capacity = 50, Price = 0 },
	{ Name = "Школьный рюкзак", Icon = "🎒", Capacity = 250, Price = 150 },
	{ Name = "Походный рюкзак", Icon = "🏕️", Capacity = 1000, Price = 1000 },
	{ Name = "Большой рюкзак", Icon = "🧳", Capacity = 4000, Price = 5000 },
	{ Name = "Пустынный мешок", Icon = "🏺", Capacity = 15000, Price = 25000 },
	{ Name = "Сундук фараона", Icon = "📦", Capacity = 60000, Price = 120000 },
	{ Name = "Космический контейнер", Icon = "🛰️", Capacity = 250000, Price = 600000 },
	{ Name = "Карманный портал", Icon = "🌀", Capacity = 1000000, Price = 3000000 },
	{ Name = "Чёрная дыра", Icon = "🕳️", Capacity = 10000000, Price = 20000000 },
}

return Backpacks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--[[
	Eggs — яйца с питомцами.

	World     — в каком мире стоит яйцо (ключ из Worlds)
	Price     — цена одного открытия в монетах
	Position  — место подставки внутри мира (X и Z относительно центра мира)
	Color / SpotColor — цвета скорлупы
	Pets      — ID питомцев из Pets.lua. Шанс выпадения зависит от редкости питомца (Rarities.lua),
	            а внутри одной редкости питомцы выпадают поровну.

	Чтобы добавить яйцо: допиши запись, добавь ID в Eggs.Order и выбери свободное место в мире.
]]

local Eggs = {
	ForestEgg = {
		Name = "Лесное яйцо",
		World = "Forest",
		Price = 50,
		Position = Vector3.new(40, 0, 32),
		Color = Color3.fromRGB(150, 225, 110),
		SpotColor = Color3.fromRGB(80, 165, 60),
		Pets = { "Kitten", "Puppy", "Fox", "Owl", "ForestSpirit" },
	},
	MushroomEgg = {
		Name = "Грибное яйцо",
		World = "Forest",
		Price = 400,
		Position = Vector3.new(40, 0, 8),
		Color = Color3.fromRGB(255, 96, 96),
		SpotColor = Color3.fromRGB(255, 255, 255),
		Pets = { "Bunny", "Hedgehog", "Bear", "Raccoon", "Unicorn" },
	},

	SandEgg = {
		Name = "Песчаное яйцо",
		World = "Desert",
		Price = 2500,
		Position = Vector3.new(40, 0, 32),
		Color = Color3.fromRGB(246, 214, 140),
		SpotColor = Color3.fromRGB(210, 150, 80),
		Pets = { "Lizard", "Fennec", "Scorpion", "Camel", "Sphinx" },
	},
	PyramidEgg = {
		Name = "Пирамидное яйцо",
		World = "Desert",
		Price = 15000,
		Position = Vector3.new(40, 0, 8),
		Color = Color3.fromRGB(255, 200, 60),
		SpotColor = Color3.fromRGB(60, 110, 220),
		Pets = { "Scarab", "Snake", "MummyCat", "Phoenix", "Pharaoh" },
	},

	MoonEgg = {
		Name = "Лунное яйцо",
		World = "Space",
		Price = 120000,
		Position = Vector3.new(40, 0, 32),
		Color = Color3.fromRGB(210, 215, 235),
		SpotColor = Color3.fromRGB(140, 145, 175),
		Pets = { "Alien", "Robot", "SpaceCat", "StarDragon", "BlackHole" },
	},
	GalaxyEgg = {
		Name = "Галактическое яйцо",
		World = "Space",
		Price = 800000,
		Position = Vector3.new(40, 0, 8),
		Color = Color3.fromRGB(150, 80, 255),
		SpotColor = Color3.fromRGB(90, 230, 255),
		Pets = { "Meteor", "Ufo", "CrystalGolem", "GalaxyWhale", "CosmicGod" },
	},
}

-- Порядок для интерфейса и построения мира.
Eggs.Order = { "ForestEgg", "MushroomEgg", "SandEgg", "PyramidEgg", "MoonEgg", "GalaxyEgg" }

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig — общие настройки и баланс игры.
	Все числа можно менять здесь: сервер и клиент читают один и тот же модуль.
]]

local GameConfig = {}

GameConfig.GameName = "Power Pets Simulator"

-- Сохранение ---------------------------------------------------------------
-- Если поменять имя хранилища, у всех игроков начнётся новый прогресс.
GameConfig.DataStoreName = "PowerPetsSimulator_v1"
GameConfig.AutosaveInterval = 60 -- секунд между автосохранениями

-- Клики ----------------------------------------------------------------------
GameConfig.BaseClickPower = 1 -- сила за один клик без бонусов
GameConfig.MaxClicksPerSecond = 15 -- сервер не засчитывает клики сверх этого (защита от автокликеров)

-- Питомцы --------------------------------------------------------------------
GameConfig.MaxPets = 150 -- размер инвентаря
GameConfig.BaseEquipSlots = 3 -- сколько питомцев можно надеть без геймпасса
GameConfig.GamepassEquipSlots = 5 -- сколько можно надеть с геймпассом
GameConfig.GoldenMergeCount = 5 -- сколько одинаковых питомцев сливаются в одного золотого
GameConfig.GoldenMultiplier = 2 -- золотой питомец даёт множитель ×2 к своему обычному

-- Геймпасс «+2 слота питомцев».
-- 0 = заглушка: кнопка в магазине выдаёт слоты бесплатно (удобно для тестов).
-- Создай геймпасс на create.roblox.com и впиши сюда его ID — тогда будет настоящая покупка за Robux.
GameConfig.PetSlotsGamepassId = 0

-- Яйца -----------------------------------------------------------------------
GameConfig.EggOpenDistance = 16 -- с какого расстояния сервер разрешает открыть яйцо
GameConfig.EggOpenCooldown = 0.6 -- пауза между открытиями одного игрока (секунды)
GameConfig.MultiOpenCount = 3 -- вторая кнопка у яйца: «Открыть ×3»

-- Перерождение ---------------------------------------------------------------
GameConfig.RebirthBonus = 0.5 -- +50% к силе за каждое перерождение
GameConfig.RebirthBaseCost = 50000 -- сколько накопленной силы нужно для первого перерождения
GameConfig.RebirthCostGrowth = 3 -- во сколько раз дорожает каждое следующее перерождение

-- Мир ------------------------------------------------------------------------
GameConfig.StartWorld = "Forest"
GameConfig.SellRadius = 9 -- радиус точки продажи (в стадах)
GameConfig.CoinRespawnTime = 12 -- через сколько секунд появляется новая монета
GameConfig.BigCoinChance = 0.1 -- шанс большой монеты
GameConfig.BigCoinMultiplier = 5 -- во сколько раз большая монета дороже
-- Удалить стандартные Baseplate и SpawnLocation из шаблона Studio: карта строится кодом.
GameConfig.RemoveTemplateBaseplate = true

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--[[
	Pets — все питомцы игры.

	Ключ таблицы — ID питомца (его используют яйца и сохранения, не меняй ID у уже выпущенных питомцев).
	Name        — имя в интерфейсе
	Rarity      — ключ из Rarities (Common, Rare, Epic, Legendary, Mythic)
	Multiplier  — множитель силы за клик (x1.2 … x50). Золотой питомец даёт вдвое больше.
	Icon        — эмодзи для карточки в инвентаре
	Look        — как собрать 3D-модель (см. Modules/PetBuilder):
		Shape      "Ball" | "Blob" | "Long" | "Box" | "Disc" | "Gem" | "Hole"
		Color      основной цвет, Accent — второй цвет (живот, внутренность ушей)
		Ears       "Pointy" | "Round" | "Long" | "Floppy" | "Tiny"   (EarScale — размер ушей)
		Tail       "Thin" | "Fluffy" | "Puff" | "Stinger" | "Fins" | "Flame"
		Wings      "Feather" | "Bat" | "Bug"
		EyeStyle   "Ball" | "Big" | "Led" | "Alien"
		и украшения: Snout, Nose, Beak, Horn, Horns ("Dragon"/"Antlers"), Antenna (1/2), Halo,
		Crown, Headdress, Spikes, Mask, Ring, Bandage, Hump, Claws, Helmet, Mane, Glow.

	Чтобы добавить питомца: допиши запись сюда и добавь его ID в список Pets нужного яйца (Eggs.lua).
]]

