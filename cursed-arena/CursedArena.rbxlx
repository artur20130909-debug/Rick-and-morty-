---------------------------------------------------------------- подготовка
-- переводим ключи в плоские массивы чисел: kf[i] = { t, e, vals = { T = {6 чисел}, ... } }
local FIELDS = { "p", "y", "r", "x", "u", "f" }
local JOINTS = { "T", "H", "RA", "LA", "RL", "LL" }
Poses.FIELDS = FIELDS
Poses.JOINTS = JOINTS

local function vec(j)
	local v = {}
	for i, f in ipairs(FIELDS) do v[i] = (j and j[f]) or 0 end
	return v
end
Poses.vec = vec

local function prepare(anim)
	local mask = {}
	for _, k in ipairs(anim.k) do
		for _, j in ipairs(JOINTS) do if k.p[j] then mask[j] = true end end
	end
	local prev = {}
	local frames = {}
	for i, k in ipairs(anim.k) do
		local vals = {}
		for j in pairs(mask) do
			local src = k.p[j]
			if src then
				local base = prev[j] or vec(nil)
				local v = {}
				for fi, f in ipairs(FIELDS) do
					if src[f] ~= nil then v[fi] = src[f] else v[fi] = base[fi] end
				end
				vals[j] = v
			else
				vals[j] = prev[j] or vec(nil)
			end
			prev[j] = vals[j]
		end
		frames[i] = { t = k.t, e = k.e, vals = vals }
	end
	anim.frames = frames
	anim.mask = mask
	anim.fi = anim.fi or 0.05
	anim.fo = anim.fo or 0.1
end
for _, anim in pairs(A) do
	if not anim.frames then prepare(anim) end
end

-- базовые позы в виде чисел
Poses.BaseVals = {}
for name, pose in pairs(Poses.Base) do
	local t = {}
	for _, j in ipairs(JOINTS) do t[j] = vec(pose[j]) end
	Poses.BaseVals[name] = t
end
Poses.FlinchVals = {}
for name, pose in pairs(Poses.Flinch) do
	local t = {}
	for _, j in ipairs(JOINTS) do t[j] = vec(pose[j]) end
	Poses.FlinchVals[name] = t
end

-- плавность
local function ease(e, a)
	if e == "lin" then return a end
	if e == "in" then return a * a end
	if e == "out" then return 1 - (1 - a) * (1 - a) end
	if e == "back" then
		local c1 = 1.70158
		local c3 = c1 + 1
		local x = a - 1
		return 1 + c3 * x * x * x + c1 * x * x
	end
	return a < 0.5 and 2 * a * a or 1 - ((-2 * a + 2) ^ 2) / 2
end
Poses.ease = ease

-- значение анимации в момент t: out[j] = {6 чисел} только для суставов маски
function Poses.sample(anim, t, out)
	local frames = anim.frames
	local n = #frames
	if anim.loop then
		t = t % anim.d
	end
	local i = 1
	while i < n and frames[i + 1].t <= t do i = i + 1 end
	local a, b = frames[i], frames[math.min(i + 1, n)]
	local k = 0
	if b ~= a and b.t > a.t then
		k = ease(b.e, math.clamp((t - a.t) / (b.t - a.t), 0, 1))
	end
	for j, va in pairs(a.vals) do
		local vb = b.vals[j]
		local o = out[j]
		if not o then
			o = {}
			out[j] = o
		end
		for fi = 1, 6 do o[fi] = va[fi] + (vb[fi] - va[fi]) * k end
	end
	return out
end

function Poses.get(name)
	return A[name]
end

return Poses
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- Суставы R6 и перевод «понятной» позы в Motor6D.Transform.
--
-- Поза сустава задаётся в градусах:
--   T (торс относительно HumanoidRootPart): p — наклон вперёд, y — поворот вправо, r — наклон вправо,
--     x/u/f — сдвиг вправо/вверх/вперёд (в studs);
--   H (голова): p — кивок вниз, y — взгляд вправо, r — наклон вправо;
--   RA/LA (руки), RL/LL (ноги): p — вперёд (поднять перед собой), r — в сторону (наружу),
--     y — поворот вокруг своей оси. Левая сторона зеркалится сама.
-- Transform = Rot0⁻¹ · M · Rot0, где M — поворот в системе родительской детали вокруг сустава,
-- Rot0 — поворот C0. Так поза не зависит от того, как в риге повёрнуты сами суставы.
local Rig = {}

Rig.Joints = { T = "RootJoint", H = "Neck", RA = "Right Shoulder", LA = "Left Shoulder", RL = "Right Hip", LL = "Left Hip" }
Rig.Order = { "T", "H", "RA", "LA", "RL", "LL" }
Rig.Parts = { T = "HumanoidRootPart", H = "Torso", RA = "Torso", LA = "Torso", RL = "Torso", LL = "Torso" }
Rig.Fields = { "p", "y", "r", "x", "u", "f" }

local rad = math.rad
local SIDE = { RA = 1, RL = 1, LA = -1, LL = -1 }

-- поворот (и сдвиг) в системе родительской детали
function Rig.localCF(key, p, y, r, x, u, f)
	p, y, r = rad(p or 0), rad(y or 0), rad(r or 0)
	if key == "T" or key == "H" then
		local cf = CFrame.Angles(-p, -y, -r)
		if key == "T" and (x ~= 0 or u ~= 0 or f ~= 0) then
			cf = CFrame.new(x or 0, u or 0, -(f or 0)) * cf
		end
		return cf
	end
	local s = SIDE[key]
	return CFrame.Angles(p, 0, 0) * CFrame.Angles(0, 0, r * s) * CFrame.Angles(0, y * s, 0)
end

-- найти суставы персонажа: { T = Motor6D, ... } и их Rot0
function Rig.find(model)
	local out = {}
	local rot0 = {}
	for key, jname in pairs(Rig.Joints) do
		local part = model:FindFirstChild(Rig.Parts[key])
		local m = part and part:FindFirstChild(jname)
		if m and m:IsA("Motor6D") then
			out[key] = m
			rot0[key] = m.C0 - m.C0.Position
		end
	end
	return out, rot0
end

-- применить позу: values[key] = { p, y, r, x, u, f } (числа в градусах/studs)
function Rig.apply(motors, rot0, values)
	for key, m in pairs(motors) do
		local v = values[key]
		local r0 = rot0[key]
		if v and r0 then
			local M = Rig.localCF(key, v[1], v[2], v[3], v[4], v[5], v[6])
			m.Transform = r0:Inverse() * M * r0
		end
	end
end

-- сбросить в нейтраль
function Rig.reset(motors)
	for _, m in pairs(motors) do m.Transform = CFrame.new() end
end

return Rig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Звуки игры.
-- 1) Если в ReplicatedStorage есть папка SoundLibrary со звуком с таким же именем —
--    играет он (туда вставляются звуки из набора assets/sounds, см. README).
-- 2) Иначе — встроенный звук Roblox (rbxasset://), подобранный по смыслу.
-- volume — громкость, pitch = { от, до } — случайная высота, чтобы удары не звучали одинаково.
local Sounds = {}

local S = "rbxasset://sounds/"

Sounds.List = {
	Swing = { id = S .. "swordlunge.wav", volume = 0.35, pitch = { 1.35, 1.6 } },
	SwingHeavy = { id = S .. "swordlunge.wav", volume = 0.55, pitch = { 0.9, 1.05 } },
	Punch = { id = S .. "action_jump_land.mp3", volume = 0.9, pitch = { 1.25, 1.5 } },
	PunchHeavy = { id = S .. "collide.wav", volume = 0.55, pitch = { 1.5, 1.7 } },
	Slash = { id = S .. "swordslash.wav", volume = 0.6, pitch = { 0.95, 1.15 } },
	SlashHeavy = { id = S .. "swordslash.wav", volume = 0.8, pitch = { 0.75, 0.85 } },
	Block = { id = S .. "action_jump_land.mp3", volume = 0.7, pitch = { 0.7, 0.8 } },
	Parry = { id = S .. "electronicpingshort.wav", volume = 0.7, pitch = { 0.55, 0.6 } },
	GuardBreak = { id = S .. "collide.wav", volume = 0.7, pitch = { 1.1, 1.2 } },
	Dash = { id = S .. "swordlunge.wav", volume = 0.45, pitch = { 0.75, 0.85 } },
	Jump = { id = S .. "action_jump.mp3", volume = 0.4, pitch = { 1, 1.1 } },
	Land = { id = S .. "action_jump_land.mp3", volume = 0.5, pitch = { 0.9, 1 } },
	Explosion = { id = S .. "collide.wav", volume = 0.8, pitch = { 0.85, 1 } },
	ExplosionBig = { id = S .. "collide.wav", volume = 1, pitch = { 0.5, 0.6 } },
	Launch = { id = S .. "Rocket shot.wav", volume = 0.6, pitch = { 0.9, 1.1 } },
	Fire = { id = S .. "Launching rocket.wav", volume = 0.6, pitch = { 0.9, 1.05 } },
	Zap = { id = S .. "electronicpingshort.wav", volume = 0.5, pitch = { 1.6, 2 } },
	Thunder = { id = S .. "collide.wav", volume = 0.9, pitch = { 0.7, 0.8 } },
	Charge = { id = S .. "Launching rocket.wav", volume = 0.45, pitch = { 0.55, 0.6 } },
	Beam = { id = S .. "Launching rocket.wav", volume = 0.8, pitch = { 1.2, 1.3 } },
	Teleport = { id = S .. "swordlunge.wav", volume = 0.5, pitch = { 1.8, 2 } },
	Void = { id = S .. "collide.wav", volume = 0.6, pitch = { 0.6, 0.7 } },
	Shadow = { id = S .. "swordlunge.wav", volume = 0.45, pitch = { 0.5, 0.6 } },
	Bite = { id = S .. "action_jump_land.mp3", volume = 0.8, pitch = { 1.7, 1.9 } },
	Crow = { id = S .. "swordlunge.wav", volume = 0.4, pitch = { 2.2, 2.6 } },
	Awaken = { id = S .. "Launching rocket.wav", volume = 1, pitch = { 0.5, 0.55 } },
	Domain = { id = S .. "collide.wav", volume = 1, pitch = { 0.35, 0.4 } },
	Resonance = { id = S .. "collide.wav", volume = 1, pitch = { 1.9, 2.1 } },
	Death = { id = S .. "uuhhh.mp3", volume = 0.6, pitch = { 1, 1 } },
	Click = { id = S .. "clickfast.wav", volume = 0.5, pitch = { 1, 1.05 } },
	Select = { id = S .. "electronicpingshort.wav", volume = 0.45, pitch = { 1.2, 1.25 } },
	Ready = { id = S .. "electronicpingshort.wav", volume = 0.3, pitch = { 1.6, 1.7 } },
	Kill = { id = S .. "electronicpingshort.wav", volume = 0.6, pitch = { 0.9, 0.95 } },
	Rumble = { id = S .. "collide.wav", volume = 0.5, pitch = { 0.3, 0.35 } },
}

function Sounds.get(name)
	return Sounds.List[name]
end

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Мелкие помощники для сервера и клиента
local Util = {}

-- общее время сервера и клиентов (одинаковое на всех машинах)
function Util.now()
	return workspace:GetServerTimeNow()
end

function Util.clamp(x, a, b)
	if x < a then return a end
	if x > b then return b end
	return x
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- горизонтальное направление (без Y), единичное; если вектор нулевой — запасное
function Util.flat(v, fallback)
	if typeof(v) ~= "Vector3" then return fallback or Vector3.new(0, 0, -1) end
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-3 then return fallback or Vector3.new(0, 0, -1) end
	return f.Unit
end

-- CFrame в точке pos, смотрящий по горизонтальному направлению dir
function Util.facing(pos, dir)
	local d = Util.flat(dir)
	return CFrame.lookAt(pos, pos + d)
end

function Util.root(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

function Util.hum(model)
	return model and model:FindFirstChildOfClass("Humanoid")
end

function Util.alive(model)
	local h = Util.hum(model)
	return h ~= nil and h.Health > 0 and model.Parent ~= nil
end

-- точка на земле под pos (или pos, если земли нет)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
function Util.ground(pos, depth)
	local map = workspace:FindFirstChild("Map")
	if not map then return pos, nil end
	groundParams.FilterDescendantsInstances = { map }
	local r = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -(depth or 60), 0), groundParams)
	if r then return r.Position, r end
	return pos, nil
end

-- луч только по карте
function Util.mapRay(origin, dir)
	local map = workspace:FindFirstChild("Map")
	if not map then return nil end
	groundParams.FilterDescendantsInstances = { map }
	return workspace:Raycast(origin, dir, groundParams)
end

function Util.weld(p0, p1)
	local w = Instance.new("WeldConstraint")
	w.Part0 = p0
	w.Part1 = p1
	w.Parent = p0
	return w
end

-- простая деталь: Util.part({ Size = ..., CFrame = ..., Color = ... }, parent)
function Util.part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do p[k] = v end
	if parent then p.Parent = parent end
	return p
end

function Util.shuffle(t, rng)
	for i = #t, 2, -1 do
		local j = rng and rng:NextInteger(1, i) or math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

-- случайное число из [a, b]
function Util.rand(a, b)
	return a + math.random() * (b - a)
end

-- случайный элемент
function Util.pick(t)
	return t[math.random(1, #t)]
end

function Util.colorHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000029"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000002A"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Точка входа сервера CURSED ARENA
local ServerScriptService = game:GetService("ServerScriptService")
local Server = ServerScriptService:WaitForChild("Server")

local Kit = require(Server.Kit)
local Actions = require(Server.Actions)
local Spawner = require(Server.Spawner)
local MapService = require(Server.MapService)
local Bots = require(Server.Bots)
local Domains = require(Server.Domains)

-- папка для серверных «призывов» (псы, кулак тени и т.п.)
local fx = Instance.new("Folder")
fx.Name = "FX"
fx.Parent = workspace

Kit.MapService = MapService
Kit.Domains = Domains

-- приёмы персонажей: Server/Moves/<Персонаж>
for _, mod in ipairs(Server.Moves:GetChildren()) do
	if mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok then
			Actions.Moves[mod.Name] = res
		else
			warn("[Main] не загрузились приёмы " .. mod.Name .. ": " .. tostring(res))
		end
	end
end

MapService.init()
Spawner.init()
Actions.init(Spawner, Bots)
Bots.init()

-- облака
local terrain = workspace:FindFirstChildOfClass("Terrain")
if terrain and not terrain:FindFirstChildOfClass("Clouds") then
	local c = Instance.new("Clouds")
	c.Cover = 0.55
	c.Density = 0.55
	c.Color = Color3.fromRGB(255, 250, 245)
	c.Parent = terrain
end

print("[CURSED ARENA] сервер запущен")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000002B"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">Actions</string><ProtectedString name="Source"><![CDATA[-- Действия бойца: M1-серия, блок, рывок, приёмы 1–4, пробуждение.
-- Игроки присылают их через Remotes.Action, боты вызывают напрямую.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Characters = require(Shared.Characters)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local Hitbox = require(script.Parent.Hitbox)
local Kit = require(script.Parent.Kit)
local Net = require(script.Parent.Net)

local Actions = {}
Actions.Moves = {} -- charId -> { MoveId = function(Kit, f, aim, def, slot) }

-- настройки M1 с учётом персонажа
local m1Cache = {}
function Actions.m1Config(charId)
	local c = m1Cache[charId]
	if c then return c end
	c = {}
	for k, v in pairs(Config.M1) do c[k] = v end
	local def = Characters.get(charId)
	if def.M1 then for k, v in pairs(def.M1) do c[k] = v end end
	m1Cache[charId] = c
	return c
end

local M1_FX = { fists = "punch", flame = "fire", zap = "zap", claws = "shadow", palms = "void", sword = "slash" }

---------------------------------------------------------------- M1
function Actions.m1(f, aim, jumpHeld)
	local now = Util.now()
	if not Fighters.canAct(f, now) then return false end
	if now < f.m1CdEnd then return false end
	local cfg = Actions.m1Config(f.charId)
	if now - f.m1Last < cfg.Interval then return false end
	if now - f.m1Last > cfg.ComboWindow then f.m1Index = 0 end
	f.m1Index = f.m1Index + 1
	f.m1Last = now
	local idx = f.m1Index
	local finisher = idx >= cfg.Count
	local variant = "n"
	if finisher then
		if f.hum.FloorMaterial == Enum.Material.Air then variant = "down"
		elseif jumpHeld then variant = "up" end
		f.m1CdEnd = now + cfg.EndLag
		f.m1Index = 0
	end
	local dir = Kit.dir(f, aim)
	if not f.player then Kit.face(f, dir) end
	Fighters.busy(f, cfg.BusyTime * (finisher and 1.7 or 1), cfg.BusySpeed, not finisher)
	local style = f.def.M1Style
	Net.fxExcept(f.player, "M1", { m = f.model, i = idx, v = variant, st = style })
	local tok = f.moveToken
	task.delay(cfg.Windup * (finisher and 1.5 or 1), function()
		if not Fighters.alive(f) or f.ragdolled or Util.now() < f.stunEnd or f.moveToken ~= tok then return end
		local d = Kit.dir(f, { dir = dir })
		local pos = f.root.Position + d * cfg.Reach
		local cf = CFrame.lookAt(pos, pos + d)
		local list = Hitbox.box(cf, cfg.HitboxSize, { [f] = true })
		local fx = M1_FX[style] or "punch"
		local any = false
		for _, t in ipairs(list) do
			local info = {
				damage = finisher and cfg.FinisherDamage or cfg.Damage,
				stun = finisher and 0.95 or cfg.Stun,
				m1 = true, fx = fx, heavy = finisher, pos = t.root.Position - d * 1.2,
			}
			if finisher then
				local away = Combat.away(f, t)
				info.blockCost = 2
				if variant == "up" then
					info.knockback = away * 8 + Vector3.new(0, cfg.UppercutUp, 0)
					info.ragdoll = 1.35
					info.kbTime = 0.2
				elseif variant == "down" then
					info.knockback = away * 10 + Vector3.new(0, -cfg.DownslamDown, 0)
					info.ragdoll = 1.2
					info.kbTime = 0.15
				else
					info.knockback = away * cfg.Knockback + Vector3.new(0, cfg.KnockUp, 0)
					info.ragdoll = cfg.Ragdoll
					info.kbTime = 0.2
				end
				info.shake = 0.6
				info.hitstop = 0.07
			else
				info.knockback = Combat.away(f, t) * 5
				info.kbTime = 0.08
				info.hitstop = 0.03
			end
			local r = Combat.hit(f, t, info)
			if r == "hit" or r == "killed" then any = true end
		end
		-- шаг вперёд, чтобы серия не «распадалась»
		if any and not finisher and Fighters.alive(f) then
			Kit.setVel(f, d * 9)
			task.delay(0.08, function()
				if Fighters.alive(f) and f.moveToken == tok then Kit.stopVel(f) end
			end)
		end
		if finisher and variant == "down" and any then
			Net.fx("Impact", { p = Util.ground(pos), r = 7, k = "dust" })
		end
	end)
	return true
end

---------------------------------------------------------------- блок
function Actions.block(f, on)
	local now = Util.now()
	if on then
		if not Fighters.alive(f) or f.ragdolled or now < f.stunEnd or now < f.rootEnd or now < f.busyEnd or now < f.blockLockEnd then
			return false
		end
		if f.blockReleased and now - f.blockReleased < Config.Block.Cooldown then return false end
		if not f.blocking then
			f.blocking = true
			f.blockStart = now
		end
		return true
	end
	if f.blocking then
		f.blocking = false
		f.blockReleased = now
	end
	return true
end

---------------------------------------------------------------- рывок
local DASH_CD = { F = "FrontCooldown", B = "BackCooldown", L = "SideCooldown", R = "SideCooldown" }
function Actions.dash(f, key, vec)
	local now = Util.now()
	if not Fighters.alive(f) or f.ragdolled or now < f.stunEnd or now < f.rootEnd then return false end
	if now < f.busyEnd or f.blocking then return false end
	if not DASH_CD[key] then key = "F" end
	if now < f.dashCd[key] then return false end
	f.dashCd[key] = now + Config.Dash[DASH_CD[key]]
	if key == "L" or key == "R" then f.evadeEnd = now + Config.Dash.EvadeTime end
	if not f.player then
		-- боты: двигает сервер
		local look = f.root.CFrame.LookVector
		local right = f.root.CFrame.RightVector
		local d = (key == "B" and -look) or (key == "L" and -right) or (key == "R" and right) or look
		if typeof(vec) == "Vector3" and vec.Magnitude > 0.1 then d = vec end
		d = Util.flat(d, look)
		local root = f.root
		local att = root:FindFirstChild("DashAtt") or Instance.new("Attachment")
		att.Name = "DashAtt"
		att.Parent = root
		local lv = Instance.new("LinearVelocity")
		lv.Name = "DashVel"
		lv.Attachment0 = att
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.MaxForce = 1e7
		lv.VectorVelocity = d * Config.Dash.Speed
		lv.Parent = root
		task.delay(Config.Dash.Time, function() lv:Destroy() end)
	end
	Net.fxExcept(f.player, "Dash", { m = f.model, d = key })
	return true
end

---------------------------------------------------------------- приёмы
function Actions.move(f, slot, aim)
	local now = Util.now()
	if type(slot) ~= "number" or slot < 1 or slot > 4 or slot ~= math.floor(slot) then return false end
	-- повторное нажатие (Резонанс, выход из тени)
	local rc = f.recast
	if rc and rc.slot == slot then
		f.recast = nil
		if now <= rc.untilT and now >= (rc.fromT or 0) then
			task.spawn(rc.cb, Kit.cleanAim(aim))
			return true
		end
		if now < (rc.fromT or 0) then
			-- поспешил: окно ещё не открылось
			if rc.miss then task.spawn(rc.miss) end
			return true
		end
	end
	if not Fighters.canAct(f, now) then return false end
	if now < f.silenceEnd then
		Net.to(f.player, "Notify", { text = "Внутри чужой территории приёмы не работают!", kind = "bad" })
		return false
	end
	if now < f.cds[slot] then return false end
	local def = Characters.moveset(f.charId, f.awakened)[slot]
	if not def then return false end
	if def.Ultimate and f.ultUsed then return false end
	local mod = Actions.Moves[f.charId]
	local fn = mod and mod[def.Id]
	if not fn then
		warn("[Actions] нет приёма " .. tostring(def.Id))
		return false
	end
	if def.Ultimate then
		f.ultUsed = true
		f.cds[slot] = f.awakenEnd
	else
		f.cds[slot] = now + def.Cooldown
	end
	Net.to(f.player, "CD", { slot = slot, t = f.cds[slot], d = def.Ultimate and (f.awakenEnd - now) or def.Cooldown })
	aim = Kit.cleanAim(aim)
	if not f.player then Kit.face(f, Kit.dir(f, aim)) end
	task.spawn(function()
		local ok, err = pcall(fn, Kit, f, aim, def, slot)
		if not ok then
			warn("[Moves] " .. def.Id .. ": " .. tostring(err))
			if Fighters.alive(f) then Combat.cancelMove(f) end
		end
	end)
	return true
end

function Actions.awaken(f)
	return Combat.awaken(f)
end

---------------------------------------------------------------- приём от игроков
local rate = {}
function Actions.init(Spawner, Bots)
	Net.Action.OnServerEvent:Connect(function(player, kind, a, b)
		if type(kind) ~= "string" then return end
		-- защита от спама
		local t = os.clock()
		local r = rate[player]
		if not r or t - r.t > 1 then
			r = { t = t, n = 0 }
			rate[player] = r
		end
		r.n = r.n + 1
		if r.n > 40 then return end
		if kind == "Select" then
			Spawner.select(player, a)
			return
		elseif kind == "Bots" then
			if Bots then Bots.configure(a, b) end
			return
		elseif kind == "Respawn" then
			Spawner.respawn(player)
			return
		end
		local f = Fighters.ofPlayer(player)
		if not f then return end
		if kind == "M1" then
			Actions.m1(f, Kit.cleanAim(a), b == true)
		elseif kind == "Block" then
			Actions.block(f, a == true)
		elseif kind == "Dash" then
			Actions.dash(f, type(a) == "string" and a or "F", typeof(b) == "Vector3" and b or nil)
		elseif kind == "Move" then
			Actions.move(f, a, b)
		elseif kind == "Awaken" then
			Actions.awaken(f)
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(p) rate[p] = nil end)
end

-- общий цикл бойцов
RunService.Heartbeat:Connect(function(dt)
	Fighters.step(dt)
end)

return Actions
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Bots</string><ProtectedString name="Source"><![CDATA[-- Боты-соперники и тренировочные манекены.
-- Боты пользуются теми же действиями, что и игроки: M1, блок, рывки, приёмы, пробуждение.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Characters = require(Shared.Characters)
local Costumes = require(Shared.Costumes)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local Actions = require(script.Parent.Actions)
local Spawner = require(script.Parent.Spawner)
local MapService = require(script.Parent.MapService)
local Net = require(script.Parent.Net)

local Bots = {}
Bots.count = Config.Bots.Default
Bots.level = Config.Bots.DefaultDifficulty
Bots.list = {}     -- { f, name, charId, slot }
Bots.dummies = {}

local folder
local rng = Random.new()
local usedNames = {}

local function template()
	return game:GetService("StarterPlayer"):FindFirstChild("StarterCharacter")
end

local function spawnPoint(i)
	local pts = MapService.markers("BotSpawn")
	if #pts == 0 then
		local spawns = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("SpawnLocation") then spawns[#spawns + 1] = d.CFrame end
		end
		pts = spawns
	end
	if #pts == 0 then return CFrame.new(0, 5, 0) end
	local cf = pts[((i or rng:NextInteger(1, #pts)) - 1) % #pts + 1]
	return cf + Vector3.new(rng:NextNumber(-6, 6), 3, rng:NextNumber(-6, 6))
end

local function makeModel(name, charId, cf, costume)
	local tmpl = template()
	if not tmpl then return nil end
	local m = tmpl:Clone()
	m.Name = name
	Costumes.apply(m, costume or charId)
	local hum = m:FindFirstChildOfClass("Humanoid")
	hum.DisplayName = name
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 80
	m:SetAttribute("DisplayName", name)
	m:PivotTo(cf)
	m.Parent = folder
	pcall(function() m.HumanoidRootPart:SetNetworkOwner(nil) end)
	return m
end

local function pickName()
	for _, n in ipairs(Config.Bots.Names) do
		if not usedNames[n] then
			usedNames[n] = true
			return n
		end
	end
	return "Бот" .. rng:NextInteger(10, 99)
end

---------------------------------------------------------------- боты
local function spawnBot(b)
	local charId = Characters.List[rng:NextInteger(1, #Characters.List)]
	b.charId = charId
	local m = makeModel(b.name, charId, spawnPoint(b.slot), charId)
	if not m then return end
	local f = Fighters.new(m, "bot", nil, charId)
	b.f = f
	b.target = nil
	b.retarget = 0
	b.nextThink = 0
	b.blockUntil = 0
	b.strafe = rng:NextInteger(0, 1) == 0 and 1 or -1
	Spawner.setupWeapon(f)
	Net.fx("Swap", { m = m, c = charId })
end

local function addBot(slot)
	local b = { name = pickName(), slot = slot }
	Bots.list[#Bots.list + 1] = b
	spawnBot(b)
	return b
end

local function removeBot(b)
	usedNames[b.name] = nil
	b.removed = true
	if b.f and b.f.model.Parent then b.f.model:Destroy() end
	for i = #Bots.list, 1, -1 do
		if Bots.list[i] == b then table.remove(Bots.list, i) end
	end
end

function Bots.configure(count, level)
	if type(count) == "number" then Bots.count = math.clamp(math.floor(count), 0, Config.Bots.Max) end
	if type(level) == "number" then Bots.level = math.clamp(math.floor(level), 1, #Config.Bots.Difficulty) end
	while #Bots.list > Bots.count do removeBot(Bots.list[#Bots.list]) end
	while #Bots.list < Bots.count do addBot(#Bots.list + 1) end
	Net.fx("BotsConfig", { n = Bots.count, l = Bots.level })
	return Bots.count, Bots.level
end

-- выбрать цель: ближайший живой, игроки чуть «приятнее»
local function chooseTarget(b)
	local f = b.f
	local best, bestS
	for _, o in ipairs(Fighters.list) do
		if o ~= f and Fighters.alive(o) and o.kind ~= "dummy" then
			local d = (o.root.Position - f.root.Position).Magnitude
			local s = d * (o.kind == "player" and 0.75 or 1)
			if not bestS or s < bestS then best, bestS = o, s end
		end
	end
	return best
end

local function think(b, now)
	local f = b.f
	if not f or not Fighters.alive(f) then return end
	local lvl = Config.Bots.Difficulty[Bots.level]
	if now < b.nextThink then return end
	b.nextThink = now + lvl.React * rng:NextNumber(0.7, 1.3)
	local hum = f.hum
	if f.ragdolled or now < f.stunEnd then
		if f.blocking then Actions.block(f, false) end
		return
	end
	if not b.target or not Fighters.alive(b.target) or now > b.retarget then
		b.target = chooseTarget(b)
		b.retarget = now + rng:NextNumber(2, 4)
	end
	local t = b.target
	if not t then
		hum:MoveTo(f.root.Position)
		return
	end
	local myPos, tPos = f.root.Position, t.root.Position
	local delta = tPos - myPos
	local dist = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local dir = Util.flat(delta, f.root.CFrame.LookVector)
	local aim = { dir = dir, pos = tPos }

	-- блок, если враг рядом бьёт
	if f.blocking then
		if now > b.blockUntil or dist > 12 then Actions.block(f, false) end
		return
	end
	local tAttacking = now < t.busyEnd and dist < 10
	if tAttacking and rng:NextNumber() < lvl.Block then
		hum:MoveTo(myPos)
		Actions.block(f, true)
		b.blockUntil = now + rng:NextNumber(0.4, 0.9)
		return
	end

	-- пробуждение
	if f.meter >= Config.Awaken.Max and not f.awakened and dist < 40 then
		if Actions.awaken(f) then return end
	end

	-- приёмы
	if rng:NextNumber() < lvl.MoveChance then
		local moves = Characters.moveset(f.charId, f.awakened)
		local order = { 1, 2, 3, 4 }
		Util.shuffle(order, rng)
		for _, slot in ipairs(order) do
			local mv = moves[slot]
			local ai = mv.AI or {}
			local range = ai.range or 10
			local okRange = dist <= range and (ai.kind ~= "melee" or dist <= 9) and (ai.kind ~= "aoe" or dist <= range)
			if ai.kind == "defense" then okRange = tAttacking end
			if mv.Ultimate and (not f.awakened or f.ultUsed) then okRange = false end
			if okRange and now >= f.cds[slot] then
				if Actions.move(f, slot, aim) then return end
			end
		end
	end

	-- низкое здоровье: отскок
	if hum.Health < 25 and dist < 8 and rng:NextNumber() < lvl.Dash then
		Actions.dash(f, "B", -dir)
		return
	end

	if dist > 6.5 then
		-- сближение
		local goal = tPos - dir * 3.2
		hum:MoveTo(goal)
		if dist > 18 and dist < 45 and rng:NextNumber() < lvl.Dash * 0.5 then
			Actions.dash(f, "F", dir)
		end
	else
		-- вплотную: бой
		if rng:NextNumber() < 0.25 then
			local side = f.root.CFrame.RightVector * b.strafe
			hum:MoveTo(myPos + side * 4 + dir * 0.5)
			if rng:NextNumber() < 0.15 then b.strafe = -b.strafe end
		else
			hum:MoveTo(myPos + dir * 0.6)
		end
		if rng:NextNumber() < lvl.Aggro then
			Actions.m1(f, aim, rng:NextNumber() < 0.25)
		end
		if rng:NextNumber() < lvl.Dash * 0.15 then
			Actions.dash(f, rng:NextInteger(0, 1) == 0 and "L" or "R")
		end
	end
end

---------------------------------------------------------------- манекены
local function spawnDummy(d)
	local m = makeModel("Манекен", "Dummy", d.cf + Vector3.new(0, 3, 0), "Dummy")
	if not m then return end
	local f = Fighters.new(m, "dummy", nil, "StormFist")
	f.iframesEnd = 0
	d.f = f
	m:SetAttribute("Char", "Dummy")
	m:SetAttribute("DisplayName", "Манекен")
end

function Bots.init()
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = workspace
	for _, cf in ipairs(MapService.markers("Dummy")) do
		local d = { cf = cf }
		Bots.dummies[#Bots.dummies + 1] = d
		spawnDummy(d)
	end
	Bots.configure(Bots.count, Bots.level)

	table.insert(Combat.onKill, function(killer, victim)
		for _, b in ipairs(Bots.list) do
			if b.f == victim then
				local model = victim.model
				task.delay(Config.Bots.RespawnTime, function()
					if b.removed then return end
					if model.Parent then model:Destroy() end
					spawnBot(b)
				end)
			end
		end
		for _, d in ipairs(Bots.dummies) do
			if d.f == victim then
				local model = victim.model
				task.delay(Config.Dummy.RespawnTime, function()
					if model.Parent then model:Destroy() end
					spawnDummy(d)
				end)
			end
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.05 then return end
		acc = 0
		local now = Util.now()
		for _, b in ipairs(Bots.list) do
			local ok, err = pcall(think, b, now)
			if not ok then warn("[Bots] " .. tostring(err)) end
		end
		-- манекены возвращаются на место
		for _, d in ipairs(Bots.dummies) do
			local f = d.f
			if f and Fighters.alive(f) and not f.ragdolled and now > f.stunEnd + 1.5 then
				local home = d.cf.Position + Vector3.new(0, 3, 0)
				if (f.root.Position - home).Magnitude > 4 then
					f.root.CFrame = CFrame.lookAt(home, home + d.cf.LookVector)
					f.root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
	end)
end

return Bots
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Урон, блок, парирование, оглушение, отбрасывание, шкала пробуждения, убийства.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Characters = require(Shared.Characters)
local Fighters = require(script.Parent.Fighters)
local Ragdoll = require(script.Parent.Ragdoll)
local Net = require(script.Parent.Net)

local Combat = {}
Combat.onKill = {}  -- function(killer, victim)

local function now() return Util.now() end

-- множитель урона атакующего
function Combat.damageMult(f)
	if not f then return 1 end
	local m = f.dmgBuff or 1
	if f.awakened then m = m * Config.Awaken.DamageMult end
	return m
end

function Combat.setMeter(f, v)
	f.meter = math.clamp(v, 0, Config.Awaken.Max)
	local shown = math.floor(f.meter + 0.5)
	if f.attrs.Meter ~= shown then
		f.attrs.Meter = shown
		f.model:SetAttribute("Meter", shown)
	end
end

function Combat.addMeter(f, amount)
	if not f or f.awakened or f.kind == "dummy" then return end
	Combat.setMeter(f, f.meter + amount)
end

-- прервать текущий приём бойца
function Combat.cancelMove(f)
	f.moveToken = f.moveToken + 1
	f.moveId = nil
	f.counter = nil
	f.recast = nil
	Fighters.clearBusy(f)
	for _, c in ipairs(f.cleanup) do pcall(function() c:Destroy() end) end
	f.cleanup = {}
	Net.fx("AnimStop", { m = f.model })
end

function Combat.stun(f, t)
	if not f or t <= 0 then return end
	f.stunEnd = math.max(f.stunEnd, now() + t)
	f.blocking = false
end

-- отбросить: скорость vel (мировая) на время t
function Combat.knockback(f, vel, t)
	local root = f.root
	if not root or not root.Parent then return end
	local old = root:FindFirstChild("Knockback")
	if old then old:Destroy() end
	local att = root:FindFirstChild("KnockbackAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "KnockbackAtt"
		att.Parent = root
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Knockback"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e7
	lv.VectorVelocity = vel
	lv.Parent = root
	Debris:AddItem(lv, t or 0.18)
end

-- направление «от атакующего к цели» по горизонтали
function Combat.away(attacker, target)
	if not attacker then return Util.flat(target.root.CFrame.LookVector * -1) end
	return Util.flat(target.root.Position - attacker.root.Position, attacker.root.CFrame.LookVector)
end

function Combat.guardBreak(target, attacker)
	target.blocking = false
	target.blockHp = Config.Block.MaxDurability
	target.stunEnd = math.max(target.stunEnd, now() + Config.Block.GuardBreakStun)
	target.blockLockEnd = now() + Config.Block.GuardBreakStun + 0.3
	Combat.cancelMove(target)
	Net.fx("GuardBreak", { t = target.model, p = target.root.Position })
end

-- голый урон (без оглушения). Возвращает true, если цель умерла.
function Combat.damage(attacker, target, amount, silent)
	if not Fighters.alive(target) or amount <= 0 then return false end
	local hum = target.hum
	local t = now()
	hum.Health = math.max(0, hum.Health - amount)
	target.lastDamageTime = t
	if attacker and attacker ~= target then
		target.lastHitBy = attacker
		target.lastHitTime = t
		attacker.lastDealtTime = t
		Combat.addMeter(attacker, amount * Config.Awaken.PerDamageDealt)
	end
	Combat.addMeter(target, amount * Config.Awaken.PerDamageTaken)
	if not silent then
		Net.fx("Dmg", { t = target.model, d = amount, a = attacker and attacker.model })
	end
	if hum.Health <= 0 then
		Combat.die(target)
		return true
	end
	return false
end

-- основной удар по цели. info:
--   damage, stun, knockback (Vector3), kbTime, ragdoll, guardBreak, unblockable, parryable,
--   chip, blockCost, fx, heavy, pos, m1, trueDamage, cancel, noCombo, shake, hitstop
-- Возвращает: "hit" | "blocked" | "parried" | "evaded" | "immune" | "countered" | "killed" | nil
function Combat.hit(attacker, target, info)
	if not Fighters.alive(target) then return nil end
	if attacker == target then return nil end
	local t = now()
	if not info.trueDamage and t < target.iframesEnd then return "immune" end
	if info.m1 and t < target.evadeEnd then
		Net.fx("Evade", { t = target.model })
		return "evaded"
	end
	-- контрстойка цели
	if target.counter and attacker and not info.trueDamage then
		local c = target.counter
		target.counter = nil
		if c(attacker, info) then return "countered" end
	end
	local pos = info.pos or target.root.Position
	-- блок
	if target.blocking and attacker and not info.unblockable and not info.trueDamage then
		local toA = Util.flat(attacker.root.Position - target.root.Position, target.root.CFrame.LookVector)
		local front = target.root.CFrame.LookVector:Dot(toA) > Config.Block.FrontDot
		if front then
			if info.parryable ~= false and t - target.blockStart <= Config.Block.ParryWindow and not info.guardBreak then
				Combat.stun(attacker, Config.Block.ParryStun)
				Combat.cancelMove(attacker)
				Combat.knockback(attacker, Combat.away(target, attacker) * 18 + Vector3.new(0, 6, 0), 0.15)
				Net.fx("Parry", { t = target.model, a = attacker.model, p = pos })
				return "parried"
			end
			if info.guardBreak then
				Combat.guardBreak(target, attacker)
			else
				target.blockHp = target.blockHp - (info.blockCost or 1)
				local chip = info.chip
				if chip == nil then chip = info.m1 and 0 or Config.Block.ChipMult end
				if chip > 0 then Combat.damage(attacker, target, (info.damage or 0) * chip * Combat.damageMult(attacker), true) end
				Combat.knockback(target, Combat.away(attacker, target) * (info.heavy and 26 or 12), 0.1)
				Net.fx("Block", { t = target.model, p = pos, heavy = info.heavy })
				if target.blockHp <= 0 then Combat.guardBreak(target, attacker) end
				return "blocked"
			end
		end
	end
	-- урон
	local dmg = (info.damage or 0) * Combat.damageMult(attacker)
	if info.trueDamage then dmg = info.damage or 0 end
	target.blocking = false
	if info.stun and info.stun > 0 then Combat.stun(target, info.stun) end
	if info.cancel ~= false and t >= target.armorEnd then
		if target.moveId then Combat.cancelMove(target) end
	end
	local died = Combat.damage(attacker, target, dmg, true)
	if info.knockback and not (target.kind == "dummy" and info.knockback.Magnitude < 1) then
		Combat.knockback(target, info.knockback, info.kbTime)
	end
	if info.ragdoll and info.ragdoll > 0 then Ragdoll.start(target, info.ragdoll) end
	-- комбо атакующего
	if attacker and not info.noCombo then
		if t - attacker.comboLast > Config.ComboResetTime then attacker.combo = 0 end
		attacker.combo = attacker.combo + 1
		attacker.comboLast = t
		if attacker.player then Net.to(attacker.player, "Combo", { n = attacker.combo }) end
	end
	Net.fx("Hit", {
		t = target.model, a = attacker and attacker.model, p = pos, k = info.fx or "punch", d = math.floor(dmg * 10 + 0.5) / 10,
		heavy = info.heavy, s = info.shake, hs = info.hitstop, crit = info.crit,
	})
	if died then return "killed" end
	return "hit"
end

-- смерть: рэгдолл, засчитать убийство
function Combat.die(f)
	if f.dead then return end
	f.dead = true
	f.blocking = false
	f.counter = nil
	Combat.cancelMove(f)
	Ragdoll.start(f, 1e6)
	local t = now()
	local killer = f.lastHitBy
	if killer and (t - f.lastHitTime > 12 or killer == f) then killer = nil end
	Net.fx("Death", { m = f.model, p = f.root.Position })
	for _, fn in ipairs(Combat.onKill) do
		local ok, err = pcall(fn, killer, f)
		if not ok then warn("[Combat] onKill: " .. tostring(err)) end
	end
end

Fighters.onDied = function(f)
	if not f.dead then Combat.die(f) end
end

Fighters.onCombo = function(f)
	Net.to(f.player, "Combo", { n = 0 })
end

---------------------------------------------------------------- пробуждение
function Combat.canAwaken(f)
	return Fighters.alive(f) and not f.awakened and f.meter >= Config.Awaken.Max and Fighters.canAct(f) and f.kind ~= "dummy"
end

function Combat.awaken(f)
	if not Combat.canAwaken(f) then return false end
	local t = now()
	Combat.cancelMove(f)
	f.awakened = true
	f.ultUsed = false
	f.awakenStart = t
	f.awakenEnd = t + Config.Awaken.Invuln + Config.Awaken.Duration
	f.iframesEnd = math.max(f.iframesEnd, t + Config.Awaken.Invuln)
	Fighters.busy(f, Config.Awaken.Invuln, 0)
	f.cds = { 0, 0, 0, 0 }
	f.hum.Health = math.min(f.hum.MaxHealth, f.hum.Health + Config.Awaken.Heal)
	f.model:SetAttribute("Awakened", true)
	f.attrs.Awakened = true
	Combat.setMeter(f, Config.Awaken.Max)
	local def = Characters.get(f.charId)
	Net.fx("Awaken", { m = f.model, c = f.charId, name = def.Awakening.Name })
	Net.fx("Anim", { m = f.model, a = "awaken" })
	if f.player then Net.to(f.player, "Moveset", { awakened = true }) end
	return true
end

function Combat.endAwaken(f)
	if not f.awakened then return end
	f.awakened = false
	f.ultUsed = false
	f.cds = { 0, 0, 0, 0 }
	f.model:SetAttribute("Awakened", false)
	f.attrs.Awakened = false
	Combat.setMeter(f, 0)
	Net.fx("AwakenEnd", { m = f.model })
	if f.player then Net.to(f.player, "Moveset", { awakened = false }) end
end

-- таймеры (через Fighters.onExpire)
table.insert(Fighters.onExpire, function(f, t)
	Ragdoll.tick(f, t)
	if f.awakened then
		local total = Config.Awaken.Duration
		local left = f.awakenEnd - t
		if left <= 0 then
			Combat.endAwaken(f)
		else
			Combat.setMeter(f, Config.Awaken.Max * math.clamp(left / total, 0, 1))
		end
	end
	-- горение
	if t < f.burnEnd and f.burnTick and t >= f.burnTick then
		f.burnTick = t + 0.5
		Combat.damage(f.burnBy, f, f.burnDmg or 1)
	end
end)

-- поджечь: dmg раз в полсекунды, dur секунд
function Combat.burn(attacker, target, dps, dur)
	if not Fighters.alive(target) then return end
	local t = now()
	target.burnEnd = math.max(target.burnEnd, t + dur)
	target.burnTick = target.burnTick and math.min(target.burnTick, t + 0.5) or t + 0.5
	target.burnDmg = dps * 0.5
	target.burnBy = attacker
end

return Combat
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">Domains</string><ProtectedString name="Source"><![CDATA[-- Территории (ульты Повелителя Пустоты, Алого Клинка и Призывателя Теней).
-- Купол радиуса r на dur секунд: враги внутри получают эффекты своего стиля,
-- выйти за границу нельзя (выталкивает обратно). Две территории рядом — ломают друг друга.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local Net = require(script.Parent.Net)

local Domains = {}
Domains.active = {}
local nextId = 0

local function inside(d, f)
	local p = f.root.Position
	local c = d.center
	return (Vector3.new(p.X, 0, p.Z) - Vector3.new(c.X, 0, c.Z)).Magnitude <= d.radius and math.abs(p.Y - c.Y) < d.radius
end
Domains.inside = inside

function Domains.close(d, reason)
	if d.closed then return end
	d.closed = true
	for i = #Domains.active, 1, -1 do
		if Domains.active[i] == d then table.remove(Domains.active, i) end
	end
	Net.fx("DomainEnd", { id = d.id, reason = reason })
	if d.onEnd then pcall(d.onEnd, d, reason) end
end

-- opts: style, radius, duration, tick (интервал), onTick(d, victims), onEnd
function Domains.open(f, opts)
	nextId = nextId + 1
	local center = Util.ground(f.root.Position)
	local d = {
		id = nextId, owner = f, style = opts.style, center = center, radius = opts.radius or Config.Domain.Radius,
		endTime = Util.now() + (opts.duration or Config.Domain.Duration), tick = opts.tick or 0.5, nextTick = Util.now() + 0.6,
		onTick = opts.onTick, onEnd = opts.onEnd, closed = false,
	}
	-- столкновение территорий
	for _, o in ipairs(Domains.active) do
		if (o.center - center).Magnitude < (o.radius + d.radius) * Config.Domain.ClashDistance then
			Net.fx("DomainClash", { p = (o.center + center) / 2 })
			Domains.close(o, "clash")
			return nil
		end
	end
	table.insert(Domains.active, d)
	Net.fx("Domain", { id = d.id, m = f.model, style = d.style, c = center, r = d.radius, dur = opts.duration or Config.Domain.Duration,
		name = opts.name })
	return d
end

RunService.Heartbeat:Connect(function()
	if #Domains.active == 0 then return end
	local now = Util.now()
	for i = #Domains.active, 1, -1 do
		local d = Domains.active[i]
		if d and not d.closed then
			if now >= d.endTime or not Fighters.alive(d.owner) then
				Domains.close(d, "end")
			else
				-- враги внутри: замедление, тишина, не выйти
				local victims = {}
				for _, f in ipairs(Fighters.list) do
					if f ~= d.owner and Fighters.alive(f) then
						local p = f.root.Position
						local flat = Vector3.new(p.X - d.center.X, 0, p.Z - d.center.Z)
						local dist = flat.Magnitude
						if dist <= d.radius and math.abs(p.Y - d.center.Y) < d.radius then
							victims[#victims + 1] = f
							f.silenceEnd = math.max(f.silenceEnd, now + 0.25)
							f.slowEnd = math.max(f.slowEnd, now + 0.25)
							f.slowMult = math.min(f.slowMult < 1 and now < f.slowEnd and f.slowMult or 1, d.slow or 0.45)
						elseif dist <= d.radius + 6 and dist > d.radius and f.domainId == d.id then
							-- пытается выйти — вталкиваем обратно
							Combat.knockback(f, -flat.Unit * 40, 0.12)
						end
						if dist <= d.radius then f.domainId = d.id end
					end
				end
				if now >= d.nextTick then
					d.nextTick = now + d.tick
					if d.onTick then
						local ok, err = pcall(d.onTick, d, victims)
						if not ok then warn("[Domains] " .. tostring(err)) end
					end
				end
			end
		end
	end
end)

-- сбросить замедление после территории
table.insert(Fighters.onExpire, function(f, now)
	if f.slowMult < 1 and now >= f.slowEnd then f.slowMult = 1 end
end)

return Domains
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">Fighters</string><ProtectedString name="Source"><![CDATA[-- Реестр бойцов (игроки, боты, манекены) и их состояние.
-- Каждый кадр: скорость и прыжок по состоянию, атрибуты для клиентов, лечение, таймеры.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Characters = require(Shared.Characters)
local Util = require(Shared.Util)

local Fighters = {}
Fighters.list = {}
Fighters.byModel = {}
Fighters.onDied = nil      -- ставит Combat
Fighters.onExpire = {}     -- ставят другие модули: function(f, now)

local nextId = 0

function Fighters.new(model, kind, player, charId)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil end
	local old = Fighters.byModel[model]
	if old then Fighters.remove(old) end
	nextId = nextId + 1
	local now = Util.now()
	local f = {
		id = nextId, model = model, hum = hum, root = root, player = player, kind = kind,
		charId = Characters.valid(charId) and charId or Characters.Default,
		awakened = false, awakenEnd = 0, ultUsed = false, meter = 0,
		stunEnd = 0, busyEnd = 0, busySpeed = nil, busyJump = false, ragdollEnd = 0, ragdolled = false,
		iframesEnd = now + (kind == "dummy" and 0 or Config.SpawnProtection), evadeEnd = 0, armorEnd = 0,
		blocking = false, blockStart = 0, blockHp = Config.Block.MaxDurability, blockLockEnd = 0,
		m1Index = 0, m1Last = -100, m1CdEnd = 0,
		cds = { 0, 0, 0, 0 }, dashCd = { F = 0, B = 0, L = 0, R = 0 },
		moveToken = 0, moveId = nil, cleanup = {},
		lastHitBy = nil, lastHitTime = -100, lastDamageTime = -100, lastDealtTime = -100,
		combo = 0, comboLast = -100,
		silenceEnd = 0, rootEnd = 0, slowMult = 1, slowEnd = 0, invisEnd = 0, burnEnd = 0, blindEnd = 0,
		dead = false, spawnTime = now, attrs = {}, counter = nil, recast = nil,
		dmgBuff = 1, dmgBuffEnd = 0,
	}
	f.def = Characters.get(f.charId)
	Fighters.byModel[model] = f
	table.insert(Fighters.list, f)
	model:SetAttribute("Fighter", true)
	model:SetAttribute("Char", f.charId)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Meter", 0)
	model:SetAttribute("Awakened", false)
	hum.MaxHealth = Config.MaxHealth
	hum.Health = Config.MaxHealth
	hum.UseJumpPower = false
	hum.BreakJointsOnDeath = false
	hum.Died:Connect(function()
		if Fighters.onDied then Fighters.onDied(f) end
	end)
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then Fighters.remove(f) end
	end)
	Fighters.dirty = true
	return f
end

function Fighters.remove(f)
	if not f or f.removed then return end
	f.removed = true
	f.dead = true
	if Fighters.byModel[f.model] == f then Fighters.byModel[f.model] = nil end
	for i = #Fighters.list, 1, -1 do
		if Fighters.list[i] == f then table.remove(Fighters.list, i) end
	end
	for _, c in ipairs(f.cleanup) do pcall(function() c:Destroy() end) end
	f.cleanup = {}
	Fighters.dirty = true
end

function Fighters.get(model)
	return model and Fighters.byModel[model]
end

-- боец по любой детали внутри модели
function Fighters.fromPart(part)
	local a = part
	for _ = 1, 6 do
		if not a then return nil end
		local f = Fighters.byModel[a]
		if f then return f end
		a = a.Parent
	end
	return nil
end

function Fighters.ofPlayer(player)
	for _, f in ipairs(Fighters.list) do
		if f.player == player and not f.dead then return f end
	end
	return nil
end

function Fighters.alive(f)
	return f ~= nil and not f.dead and not f.removed and f.hum.Health > 0 and f.model.Parent ~= nil
end

function Fighters.isStunned(f, now)
	now = now or Util.now()
	return now < f.stunEnd or f.ragdolled or now < f.rootEnd
end

-- может ли боец начать действие (удар, приём, рывок)
function Fighters.canAct(f, now)
	now = now or Util.now()
	if not Fighters.alive(f) then return false end
	if now < f.stunEnd or f.ragdolled or now < f.rootEnd then return false end
	if now < f.busyEnd then return false end
	if f.blocking then return false end
	return true
end

-- занят приёмом: на время замедлен, атаки недоступны
function Fighters.busy(f, t, speed, canJump)
	local now = Util.now()
	f.busyEnd = math.max(f.busyEnd, now + t)
	f.busySpeed = speed
	f.busyJump = canJump and true or false
end

function Fighters.clearBusy(f)
	f.busyEnd = 0
	f.busySpeed = nil
	f.busyJump = false
end

local function setAttr(f, name, value)
	if f.attrs[name] ~= value then
		f.attrs[name] = value
		f.model:SetAttribute(name, value)
	end
end
Fighters.setAttr = setAttr

-- враги этого бойца (все остальные живые)
function Fighters.enemies(f)
	local out = {}
	for _, o in ipairs(Fighters.list) do
		if o ~= f and Fighters.alive(o) then out[#out + 1] = o end
	end
	return out
end

local regenAcc = 0
function Fighters.step(dt)
	local now = Util.now()
	regenAcc = regenAcc + dt
	local doRegen = regenAcc >= 0.25
	if doRegen then regenAcc = 0 end
	for i = #Fighters.list, 1, -1 do
		local f = Fighters.list[i]
		if f and not f.dead and f.model.Parent then
			local hum = f.hum
			local stunned = now < f.stunEnd
			local rooted = now < f.rootEnd
			local busy = now < f.busyEnd
			local speed, jump
			if f.ragdolled or rooted then
				speed, jump = 0, 0
			elseif stunned then
				speed, jump = Config.StunSpeed, 0
			elseif f.blocking then
				speed, jump = Config.Block.Speed, 0
			elseif busy then
				speed = f.busySpeed or Config.BusySpeed
				jump = f.busyJump and Config.JumpHeight or 0
			else
				speed, jump = Config.WalkSpeed, Config.JumpHeight
			end
			if f.awakened and speed > 0 then speed = speed * Config.Awaken.SpeedMult end
			if now < f.slowEnd then speed = speed * f.slowMult end
			if f.kind == "dummy" then speed, jump = 0, 0 end
			if hum.WalkSpeed ~= speed then hum.WalkSpeed = speed end
			if hum.JumpHeight ~= jump then hum.JumpHeight = jump end
			if f.dmgBuffEnd > 0 and now >= f.dmgBuffEnd then
				f.dmgBuff = 1
				f.dmgBuffEnd = 0
			end
			-- атрибуты для клиентов (анимации, интерфейс)
			setAttr(f, "Stunned", stunned and not f.ragdolled)
			setAttr(f, "Blocking", f.blocking)
			setAttr(f, "Busy", busy)
			setAttr(f, "Rooted", rooted)
			setAttr(f, "Silenced", now < f.silenceEnd)
			setAttr(f, "IFrames", now < f.iframesEnd)
			setAttr(f, "Invisible", now < f.invisEnd)
			setAttr(f, "Burning", now < f.burnEnd)
			setAttr(f, "Blind", now < f.blindEnd)
			setAttr(f, "GuardBroken", now < f.blockLockEnd and stunned)
			-- блок понемногу восстанавливается
			if not f.blocking and f.blockHp < Config.Block.MaxDurability then
				f.blockHp = math.min(Config.Block.MaxDurability, f.blockHp + Config.Block.RegenPerSecond * dt)
			end
			-- счётчик комбо гаснет
			if f.combo > 0 and now - f.comboLast > Config.ComboResetTime then
				f.combo = 0
				if f.player and Fighters.onCombo then Fighters.onCombo(f) end
			end
			-- лечение вне боя
			if doRegen and hum.Health < hum.MaxHealth and hum.Health > 0 then
				if f.kind == "dummy" then
					if now - f.lastDamageTime > Config.Dummy.HealDelay then hum.Health = hum.MaxHealth end
				elseif now - f.lastDamageTime > Config.RegenDelay then
					hum.Health = math.min(hum.MaxHealth, hum.Health + Config.RegenPerSecond * 0.25)
				end
			end
			-- падение с карты
			if f.root.Position.Y < Config.KillPlaneY then
				hum.Health = 0
			end
			for _, fn in ipairs(Fighters.onExpire) do fn(f, now) end
		end
	end
end

return Fighters
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Hitbox</string><ProtectedString name="Source"><![CDATA[-- Попадания: геометрия по корню персонажа (капсула ~ радиус 1.4, высота 5.5).
-- Так хитбоксы одинаковы для игроков, ботов и манекенов и не зависят от аксессуаров.
local Fighters = require(script.Parent.Fighters)

local Hitbox = {}

local R = 1.4      -- «толщина» персонажа
local HALF_H = 2.8 -- половина высоты (корень — в центре торса)

local function ok(f, exclude)
	return Fighters.alive(f) and not (exclude and exclude[f])
end

-- ящик cf/size (cf — центр и поворот ящика)
function Hitbox.box(cf, size, exclude)
	local out = {}
	local hx, hy, hz = size.X / 2 + R, size.Y / 2 + HALF_H * 0.6, size.Z / 2 + R
	for _, f in ipairs(Fighters.list) do
		if ok(f, exclude) then
			local lp = cf:PointToObjectSpace(f.root.Position)
			if math.abs(lp.X) <= hx and math.abs(lp.Y) <= hy and math.abs(lp.Z) <= hz then
				out[#out + 1] = f
			end
		end
	end
	return out
end

-- шар вокруг точки
function Hitbox.radius(pos, r, exclude)
	local out = {}
	for _, f in ipairs(Fighters.list) do
		if ok(f, exclude) then
			local d = f.root.Position - pos
			local dy = math.max(0, math.abs(d.Y) - HALF_H * 0.5)
			local dist = math.sqrt(d.X * d.X + d.Z * d.Z + dy * dy)
			if dist <= r + R then out[#out + 1] = f end
		end
	end
	return out
end

-- отрезок (луч, разрез): все, кто ближе width/2 к отрезку от a до b
function Hitbox.segment(a, b, width, exclude)
	local out = {}
	local ab = b - a
	local L2 = ab:Dot(ab)
	for _, f in ipairs(Fighters.list) do
		if ok(f, exclude) then
			local p = f.root.Position
			local t = 0
			if L2 > 1e-6 then t = math.clamp((p - a):Dot(ab) / L2, 0, 1) end
			local q = a + ab * t
			local d = p - q
			local dy = math.max(0, math.abs(d.Y) - HALF_H * 0.5)
			local dist = math.sqrt(d.X * d.X + d.Z * d.Z + dy * dy)
			if dist <= width / 2 + R then out[#out + 1] = { f = f, t = t } end
		end
	end
	table.sort(out, function(x, y) return x.t < y.t end)
	local res = {}
	for i, e in ipairs(out) do res[i] = e.f end
	return res
end

-- ближайший враг в конусе перед origin (cosAngle — косинус половины угла)
function Hitbox.cone(origin, dir, range, cosAngle, exclude)
	local best, bestD
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then return nil end
	flat = flat.Unit
	for _, f in ipairs(Fighters.list) do
		if ok(f, exclude) then
			local d = f.root.Position - origin
			local fd = Vector3.new(d.X, 0, d.Z)
			local dist = fd.Magnitude
			if dist <= range and dist > 0.01 then
				local c = fd.Unit:Dot(flat)
				if c >= cosAngle then
					-- чуть предпочитаем тех, кто ближе к центру прицела
					local score = dist * (1.6 - c)
					if not bestD or score < bestD then best, bestD = f, score end
				end
			elseif dist <= 0.01 then
				best = f
				bestD = 0
			end
		end
	end
	return best
end

-- ближайший враг вообще
function Hitbox.nearest(origin, range, exclude)
	local best, bestD
	for _, f in ipairs(Fighters.list) do
		if ok(f, exclude) then
			local d = (f.root.Position - origin).Magnitude
			if d <= range and (not bestD or d < bestD) then best, bestD = f, d end
		end
	end
	return best, bestD
end

return Hitbox
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[-- Набор инструментов для приёмов: начало/конец приёма, ожидание с проверкой прерывания,
-- рывки, хитбоксы, снаряды, захваты, эффекты.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local Hitbox = require(script.Parent.Hitbox)
local Ragdoll = require(script.Parent.Ragdoll)
local Net = require(script.Parent.Net)

local Kit = {}
Kit.Config = Config
Kit.Util = Util
Kit.Fighters = Fighters
Kit.Combat = Combat
Kit.Hitbox = Hitbox
Kit.Ragdoll = Ragdoll
Kit.Net = Net
Kit.MapService = nil -- ставит Main

function Kit.now() return Util.now() end

---------------------------------------------------------------- жизнь приёма
function Kit.start(f, moveId, busyTime, speed, canJump)
	f.moveToken = f.moveToken + 1
	f.moveId = moveId
	Fighters.busy(f, busyTime or 0.5, speed, canJump)
	return f.moveToken
end

function Kit.valid(f, tok)
	return Fighters.alive(f) and f.moveToken == tok and not f.ragdolled
end

-- подождать; false — приём прерван (боец оглушён, умер, начал другое)
function Kit.wait(f, tok, t)
	if t and t > 0 then task.wait(t) end
	return Kit.valid(f, tok)
end

function Kit.finish(f, tok)
	if f.moveToken == tok then
		f.moveId = nil
		f.counter = nil
		Fighters.clearBusy(f)
	end
end

-- продлить «занятость» приёма
function Kit.busy(f, t, speed, canJump)
	Fighters.busy(f, t, speed, canJump)
end

-- суперброня: удары не прерывают приём (урон проходит)
function Kit.armor(f, t)
	f.armorEnd = math.max(f.armorEnd, Util.now() + t)
end

function Kit.iframes(f, t)
	f.iframesEnd = math.max(f.iframesEnd, Util.now() + t)
end

-- удалить вместе с прерыванием приёма
function Kit.track(f, inst)
	table.insert(f.cleanup, inst)
	return inst
end

---------------------------------------------------------------- эффекты
function Kit.anim(f, name, speed)
	Net.fx("Anim", { m = f.model, a = name, s = speed })
end

function Kit.stopAnim(f)
	Net.fx("AnimStop", { m = f.model })
end

function Kit.fx(name, data)
	Net.fx(name, data)
end

function Kit.shake(pos, mag, radius)
	Net.fx("Shake", { p = pos, m = mag or 1, r = radius or 60 })
end

function Kit.sound(name, pos, parent)
	Net.fx("Sound", { n = name, p = pos, m = parent })
end

---------------------------------------------------------------- направление и цели
local function finite(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z and v.Magnitude < 1e6
end

-- данные прицела от клиента: { dir = Vector3, pos = Vector3 }
function Kit.cleanAim(aim)
	local out = {}
	if type(aim) == "table" then
		if finite(aim.dir) and aim.dir.Magnitude > 0.01 then out.dir = aim.dir.Unit end
		if finite(aim.pos) then out.pos = aim.pos end
	end
	return out
end

function Kit.dir(f, aim)
	local look = f.root.CFrame.LookVector
	if aim and aim.dir then return Util.flat(aim.dir, Util.flat(look)) end
	return Util.flat(look)
end

function Kit.face(f, dir)
	local p = f.root.Position
	local d = Util.flat(dir, Util.flat(f.root.CFrame.LookVector))
	f.root.CFrame = CFrame.lookAt(p, p + d)
end

function Kit.faceTarget(f, target)
	if target and target.root then Kit.face(f, target.root.Position - f.root.Position) end
end

-- враг в конусе прицела (мягкое наведение)
function Kit.target(f, aim, range, cosAngle)
	return Hitbox.cone(f.root.Position, Kit.dir(f, aim), range, cosAngle or 0.55, { [f] = true })
end

-- точка на земле для приёмов «по месту»: курсор (если близко), иначе враг, иначе впереди
function Kit.aimPoint(f, aim, maxDist, fallbackDist)
	local origin = f.root.Position
	local t = Kit.target(f, aim, maxDist, 0.5)
	if t then return Util.ground(t.root.Position), t end
	if aim and aim.pos then
		local d = aim.pos - origin
		local flat = Vector3.new(d.X, 0, d.Z)
		if flat.Magnitude <= maxDist and flat.Magnitude > 2 then return Util.ground(aim.pos), nil end
		if flat.Magnitude > maxDist then
			return Util.ground(origin + flat.Unit * maxDist), nil
		end
	end
	return Util.ground(origin + Kit.dir(f, aim) * (fallbackDist or 20)), nil
end

-- от атакующего к цели, с подбросом
function Kit.knock(f, target, force, up)
	local d = Combat.away(f, target)
	return d * (force or 50) + Vector3.new(0, up or 0, 0)
end

---------------------------------------------------------------- попадания
-- info может быть таблицей или функцией(target) -> таблица
local function infoFor(info, target)
	if type(info) == "function" then return info(target) end
	return info
end

function Kit.hitList(f, list, info, hitSet)
	local res = {}
	for _, t in ipairs(list) do
		if t ~= f and not (hitSet and hitSet[t]) then
			if hitSet then hitSet[t] = true end
			local r = Combat.hit(f, t, infoFor(info, t))
			res[#res + 1] = { f = t, r = r }
		end
	end
	return res
end

-- ящик перед бойцом: ширина, высота, длина; forward — смещение центра вперёд
function Kit.boxFront(f, dir, width, height, length, info, hitSet, forward)
	local pos = f.root.Position + dir * (forward or length / 2)
	local cf = CFrame.lookAt(pos, pos + dir)
	local list = Hitbox.box(cf, Vector3.new(width, height, length), { [f] = true })
	return Kit.hitList(f, list, info, hitSet)
end

function Kit.radiusHit(f, pos, r, info, hitSet)
	local list = Hitbox.radius(pos, r, { [f] = true })
	return Kit.hitList(f, list, info, hitSet)
end

function Kit.segmentHit(f, a, b, width, info, hitSet)
	local list = Hitbox.segment(a, b, width, { [f] = true })
	return Kit.hitList(f, list, info, hitSet)
end

function Kit.anyHit(res)
	for _, e in ipairs(res) do
		if e.r == "hit" or e.r == "killed" then return true end
	end
	return false
end

function Kit.firstHit(res)
	for _, e in ipairs(res) do
		if e.r == "hit" or e.r == "killed" then return e.f end
	end
	return nil
end

---------------------------------------------------------------- движение
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include

local function setVel(f, vel)
	local root = f.root
	local att = root:FindFirstChild("MoveAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "MoveAtt"
		att.Parent = root
	end
	local lv = root:FindFirstChild("MoveVel")
	if not lv then
		lv = Instance.new("LinearVelocity")
		lv.Name = "MoveVel"
		lv.Attachment0 = att
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.MaxForce = 1e7
		lv.Parent = root
		Kit.track(f, lv)
	end
	lv.VectorVelocity = vel
	return lv
end
Kit.setVel = setVel

function Kit.stopVel(f)
	local lv = f.root:FindFirstChild("MoveVel")
	if lv then lv:Destroy() end
end

-- рывок: dir * speed на time секунд. opts:
--   contact = радиус касания врага (вернёт первого задетого и остановится, если stop ~= false)
--   onContact = function(target) (для пролёта сквозь), up = вертикальная скорость
-- Возвращает цель (если коснулись), иначе nil.
function Kit.dash(f, tok, dir, speed, time, opts)
	opts = opts or {}
	local d = dir.Unit
	local vel = d * speed + Vector3.new(0, opts.up or 0, 0)
	setVel(f, vel)
	local t0 = os.clock()
	local hitTarget
	local touched = {}
	local map = workspace:FindFirstChild("Map")
	while os.clock() - t0 < time do
		local dt = RunService.Heartbeat:Wait()
		if not Kit.valid(f, tok) then
			Kit.stopVel(f)
			return nil
		end
		-- стена впереди — стоп
		if map then
			wallParams.FilterDescendantsInstances = { map }
			local r = workspace:Raycast(f.root.Position, d * (speed * dt + 2.2), wallParams)
			if r and r.Normal.Y < 0.5 then break end
		end
		if opts.contact then
			local list = Hitbox.radius(f.root.Position + d * 1.5, opts.contact, { [f] = true })
			for _, t in ipairs(list) do
				if not touched[t] then
					touched[t] = true
					if opts.onContact then opts.onContact(t) end
					if opts.stop ~= false then
						hitTarget = t
						break
					end
				end
			end
			if hitTarget then break end
		end
	end
	Kit.stopVel(f)
	f.root.AssemblyLinearVelocity = Vector3.new(0, f.root.AssemblyLinearVelocity.Y, 0)
	return hitTarget
end

-- мгновенно переместить
function Kit.teleport(f, pos, lookDir)
	local d = Util.flat(lookDir or f.root.CFrame.LookVector)
	f.root.CFrame = CFrame.lookAt(pos, pos + d)
	f.root.AssemblyLinearVelocity = Vector3.zero
end

-- безопасная точка рядом (не в стене)
function Kit.safePoint(from, to)
	local map = workspace:FindFirstChild("Map")
	if not map then return to end
	wallParams.FilterDescendantsInstances = { map }
	local d = to - from
	if d.Magnitude < 0.1 then return to end
	local r = workspace:Raycast(from, d, wallParams)
	if r then return r.Position - d.Unit * 2.5 end
	return to
end

-- держать цель перед собой (захват) на время t; offset — CFrame относительно атакующего
function Kit.hold(f, target, offset, t, tok)
	target.rootEnd = math.max(target.rootEnd, Util.now() + t)
	local t0 = os.clock()
	while os.clock() - t0 < t do
		RunService.Heartbeat:Wait()
		if tok and not Kit.valid(f, tok) then break end
		if not Fighters.alive(target) then break end
		local cf = f.root.CFrame * offset
		target.root.CFrame = cf
		target.root.AssemblyLinearVelocity = Vector3.zero
	end
	target.rootEnd = 0
end

---------------------------------------------------------------- снаряды
-- Снаряд летит по прямой; на сервере — проверка попаданий, у клиентов — картинка.
-- opts: from, dir, speed, range, radius, pierce, kind, color, size, onHit(target, pos) -> true = продолжить,
--       onEnd(pos, hitWall), ghost (сквозь стены), info (если нет onHit — обычный удар)
local projectiles = {}
local projId = 0
function Kit.projectile(f, opts)
	projId = projId + 1
	local p = {
		id = projId, f = f, pos = opts.from, dir = opts.dir.Unit, speed = opts.speed or 80, range = opts.range or 80,
		radius = opts.radius or 2, pierce = opts.pierce or 1, opts = opts, travelled = 0, hit = {}, dead = false,
	}
	p.hit[f] = true
	projectiles[#projectiles + 1] = p
	Net.fx("Proj", { id = p.id, k = opts.kind or "orb", p = p.pos, v = p.dir * p.speed, r = p.range, t0 = Util.now(),
		m = f.model, c = opts.color, s = opts.size or p.radius, x = opts.extra })
	return p
end

local function endProj(p, pos, hitWall)
	if p.dead then return end
	p.dead = true
	Net.fx("ProjEnd", { id = p.id, p = pos, w = hitWall })
	if p.opts.onEnd then
		task.spawn(function()
			local ok, err = pcall(p.opts.onEnd, pos, hitWall)
			if not ok then warn("[Kit] projectile onEnd: " .. tostring(err)) end
		end)
	end
end

function Kit.endProjectile(p, pos)
	endProj(p, pos or p.pos, false)
end

local projParams = RaycastParams.new()
projParams.FilterType = Enum.RaycastFilterType.Include
RunService.Heartbeat:Connect(function(dt)
	if #projectiles == 0 then return end
	local map = workspace:FindFirstChild("Map")
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		if p.dead then
			table.remove(projectiles, i)
		else
			local step = math.min(p.speed * dt, p.range - p.travelled)
			local a = p.pos
			local b = a + p.dir * step
			local wallHit
			if map and not p.opts.ghost then
				projParams.FilterDescendantsInstances = { map }
				local r = workspace:Raycast(a, b - a, projParams)
				if r then
					b = r.Position
					wallHit = true
				end
			end
			local list = Hitbox.segment(a, b, p.radius * 2, p.hit)
			for _, t in ipairs(list) do
				if not p.dead then
					p.hit[t] = true
					local cont = false
					if p.opts.onHit then
						local ok, res = pcall(p.opts.onHit, t, t.root.Position)
						if not ok then warn("[Kit] projectile onHit: " .. tostring(res)) end
						cont = ok and res == true
					elseif p.opts.info then
						Combat.hit(p.f, t, infoFor(p.opts.info, t))
					end
					p.pierce = p.pierce - 1
					if not cont and p.pierce <= 0 then
						endProj(p, t.root.Position, false)
					end
				end
			end
			if not p.dead then
				p.pos = b
				p.travelled = p.travelled + (b - a).Magnitude
				if wallHit then
					endProj(p, b, true)
				elseif p.travelled >= p.range - 1e-3 then
					endProj(p, b, false)
				end
			end
		end
	end
end)

---------------------------------------------------------------- карта и разное
function Kit.breakAt(pos, radius, force)
	if Kit.MapService then Kit.MapService.breakAt(pos, radius, force) end
end

function Kit.ground(pos, depth)
	return (Util.ground(pos, depth))
end

-- через t секунд выполнить fn (ошибки — в Output, без падения сервера)
function Kit.after(t, fn)
	task.delay(t, function()
		local ok, err = pcall(fn)
		if not ok then warn("[Kit] " .. tostring(err)) end
	end)
end

-- серверная деталь-«призыв» (видна всем, двигается сервером)
function Kit.part(props, f)
	local p = Util.part(props, workspace:FindFirstChild("FX") or workspace)
	if f then Kit.track(f, p) end
	return p
end

function Kit.debris(inst, t)
	Debris:AddItem(inst, t)
end

return Kit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[-- Карта: ломающиеся предметы (фонари, скамейки, ящики, машины), метки (манекены, боты).
-- Сломанный предмет прячется на сервере, обломки рисуют клиенты; через время предмет возвращается.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(script.Parent.Net)

local MapService = {}
local items = {}   -- { model, center, radius, broken, saved }

local function partsOf(inst)
	local out = {}
	if inst:IsA("BasePart") then out[#out + 1] = inst end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then out[#out + 1] = d end
	end
	return out
end

function MapService.init()
	local map = workspace:WaitForChild("Map")
	local folder = map:FindFirstChild("Breakables")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			local parts = partsOf(m)
			if #parts > 0 then
				local minV, maxV
				for _, p in ipairs(parts) do
					local a, b = p.Position - p.Size / 2, p.Position + p.Size / 2
					minV = minV and Vector3.new(math.min(minV.X, a.X), math.min(minV.Y, a.Y), math.min(minV.Z, a.Z)) or a
					maxV = maxV and Vector3.new(math.max(maxV.X, b.X), math.max(maxV.Y, b.Y), math.max(maxV.Z, b.Z)) or b
				end
				items[#items + 1] = { model = m, parts = parts, center = (minV + maxV) / 2, radius = (maxV - minV).Magnitude / 2, broken = false }
			end
		end
	end
end

local function restore(it)
	if not it.broken then return end
	it.broken = false
	for p, s in pairs(it.saved) do
		if p.Parent then
			p.Transparency = s.t
			p.CanCollide = s.c
			p.CanQuery = s.q
		end
	end
	it.saved = nil
	Net.fx("Restore", { m = it.model })
end

-- сломать всё в радиусе
function MapService.breakAt(pos, radius, force)
	local broken = {}
	for _, it in ipairs(items) do
		if not it.broken and (it.center - pos).Magnitude <= radius + it.radius * 0.6 then
			it.broken = true
			it.saved = {}
			for _, p in ipairs(it.parts) do
				it.saved[p] = { t = p.Transparency, c = p.CanCollide, q = p.CanQuery }
				p.Transparency = 1
				p.CanCollide = false
				p.CanQuery = false
			end
			broken[#broken + 1] = it.model
			task.delay(Config.Breakables.RestoreTime, function() restore(it) end)
		end
	end
	if #broken > 0 then
		Net.fx("Break", { list = broken, p = pos, f = force or 1 })
	end
	return #broken
end

-- метки на карте: Map/Markers/<имя>
function MapService.markers(name)
	local out = {}
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Markers")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if m.Name == name and m:IsA("BasePart") then out[#out + 1] = m.CFrame end
		end
	end
	return out
end

return MapService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Сеть сервера: эффекты всем игрокам и личные сообщения
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = {}
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
Net.Action = Remotes:WaitForChild("Action")
Net.FXEvent = Remotes:WaitForChild("FX")
Net.PrivateEvent = Remotes:WaitForChild("Private")

-- эффект для всех: имя + таблица данных (модели, позиции, числа)
function Net.fx(name, data)
	Net.FXEvent:FireAllClients(name, data or {})
end

-- эффект всем, кроме одного игрока (он уже показал его у себя сам)
function Net.fxExcept(player, name, data)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then Net.FXEvent:FireClient(p, name, data or {}) end
	end
end

-- личное сообщение игроку
function Net.to(player, kind, data)
	if player and player.Parent then
		Net.PrivateEvent:FireClient(player, kind, data or {})
	end
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">Ragdoll</string><ProtectedString name="Source"><![CDATA[-- Рэгдолл для R6: суставы Motor6D отключаются, их заменяют шарниры BallSocket.
-- Игрокам состояние «Physics» включает их собственный клиент (так требует Roblox),
-- ботам и манекенам — сервер.
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local Ragdoll = {}

local JOINTS = {
	{ motor = "Neck", part = "Head", a0 = Vector3.new(0, 1, 0), a1 = Vector3.new(0, -0.5, 0), up = true, cone = 40, twist = 40 },
	{ motor = "Right Shoulder", part = "Right Arm", a0 = Vector3.new(1, 0.5, 0), a1 = Vector3.new(-0.5, 0.5, 0), cone = 100, twist = 70 },
	{ motor = "Left Shoulder", part = "Left Arm", a0 = Vector3.new(-1, 0.5, 0), a1 = Vector3.new(0.5, 0.5, 0), cone = 100, twist = 70 },
	{ motor = "Right Hip", part = "Right Leg", a0 = Vector3.new(0.5, -1, 0), a1 = Vector3.new(0, 1, 0), cone = 70, twist = 30 },
	{ motor = "Left Hip", part = "Left Leg", a0 = Vector3.new(-0.5, -1, 0), a1 = Vector3.new(0, 1, 0), cone = 70, twist = 30 },
}

local DOWN = CFrame.Angles(0, 0, -math.pi / 2) -- ось X вложения смотрит вниз
local UP = CFrame.Angles(0, 0, math.pi / 2)

local function setup(model)
	local torso = model:FindFirstChild("Torso")
	if not torso then return nil end
	local data = model:FindFirstChild("RagdollRig")
	if data then return data end
	data = Instance.new("Folder")
	data.Name = "RagdollRig"
	for _, j in ipairs(JOINTS) do
		local part = model:FindFirstChild(j.part)
		if part then
			local rot = j.up and UP or DOWN
			local a0 = Instance.new("Attachment")
			a0.Name = "RD_" .. j.part .. "_0"
			a0.CFrame = CFrame.new(j.a0) * rot
			a0.Parent = torso
			local a1 = Instance.new("Attachment")
			a1.Name = "RD_" .. j.part .. "_1"
			a1.CFrame = CFrame.new(j.a1) * rot
			a1.Parent = part
			local s = Instance.new("BallSocketConstraint")
			s.Name = j.part
			s.Attachment0 = a0
			s.Attachment1 = a1
			s.LimitsEnabled = true
			s.UpperAngle = j.cone
			s.TwistLimitsEnabled = true
			s.TwistLowerAngle = -j.twist
			s.TwistUpperAngle = j.twist
			s.Enabled = false
			s.Parent = data
			local nc = Instance.new("NoCollisionConstraint")
			nc.Part0 = torso
			nc.Part1 = part
			nc.Parent = data
		end
	end
	local ll, rl = model:FindFirstChild("Left Leg"), model:FindFirstChild("Right Leg")
	if ll and rl then
		local nc = Instance.new("NoCollisionConstraint")
		nc.Part0 = ll
		nc.Part1 = rl
		nc.Parent = data
	end
	data.Parent = model
	return data
end
Ragdoll.setup = setup

local function setEnabled(f, on)
	local model = f.model
	local torso = model:FindFirstChild("Torso")
	local data = setup(model)
	if not torso or not data then return end
	for _, j in ipairs(JOINTS) do
		local m = torso:FindFirstChild(j.motor)
		local s = data:FindFirstChild(j.part)
		local part = model:FindFirstChild(j.part)
		if m then m.Enabled = not on end
		if s then s.Enabled = on end
		if part and j.part ~= "Head" then part.CanCollide = on end
	end
end

function Ragdoll.start(f, duration)
	local now = Util.now()
	f.ragdollEnd = math.max(f.ragdollEnd, now + duration)
	f.blocking = false
	if f.ragdolled then return end
	f.ragdolled = true
	setEnabled(f, true)
	f.model:SetAttribute("Ragdoll", true)
	if not f.player then
		f.hum.PlatformStand = false
		f.hum:ChangeState(Enum.HumanoidStateType.Physics)
	end
end

function Ragdoll.stop(f)
	if not f.ragdolled then return end
	f.ragdolled = false
	f.ragdollEnd = 0
	setEnabled(f, false)
	f.model:SetAttribute("Ragdoll", false)
	if not f.player and f.hum.Health > 0 then
		f.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	-- встаём ровно: убираем крен корня
	local root = f.root
	if root and root.Parent and f.hum.Health > 0 then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, -1) end
		local pos = root.Position
		local ground = Util.ground(pos, 12)
		local y = math.max(pos.Y, ground.Y + 3)
		root.CFrame = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + flat.Unit)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

-- проверка окончания (зовёт Fighters.step через onExpire)
function Ragdoll.tick(f, now)
	if f.ragdolled and not f.dead and now >= f.ragdollEnd then
		Ragdoll.stop(f)
	end
end

return Ragdoll
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Spawner</string><ProtectedString name="Source"><![CDATA[-- Игроки: появление, внешний вид аватара, смена персонажа, возрождение, статистика.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Characters = require(Shared.Characters)
local Costumes = require(Shared.Costumes)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local Net = require(script.Parent.Net)

local Spawner = {}

local function stat(player, name)
	local ls = player:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild(name)
end

-- имя для ленты убийств
function Spawner.nameOf(f)
	if not f then return "?" end
	if f.player then return f.player.DisplayName end
	return f.model:GetAttribute("DisplayName") or f.model.Name
end

local function setupWeapon(f)
	local w = f.model:FindFirstChild("Weapon")
	if f.charId == "CrimsonBlade" then
		if not w then Costumes.sword(f.model, f.def.Color) end
	elseif w then
		w:Destroy()
	end
end
Spawner.setupWeapon = setupWeapon

local function applyAppearance(player, model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or player.UserId <= 0 then return end
	local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(player.UserId) end)
	if not ok or not desc then return end
	-- масштаб R15 к R6 не относится
	pcall(function()
		desc.HeightScale, desc.WidthScale, desc.DepthScale, desc.HeadScale = 1, 1, 1, 1
		desc.BodyTypeScale, desc.ProportionScale = 0, 0
	end)
	local ok2, err = pcall(function() hum:ApplyDescription(desc) end)
	if not ok2 then warn("[Spawner] не удалось надеть аватар: " .. tostring(err)) end
end

local function onCharacter(player, model)
	local charId = player:GetAttribute("CharId")
	if not Characters.valid(charId) then charId = Characters.Default end
	local f = Fighters.new(model, "player", player, charId)
	if not f then return end
	setupWeapon(f)
	task.spawn(applyAppearance, player, model)
	Net.to(player, "Spawned", { c = charId })
end

local function onPlayerAdded(player)
	if not Characters.valid(player:GetAttribute("CharId")) then
		player:SetAttribute("CharId", Characters.Default)
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local kills = Instance.new("IntValue")
	kills.Name = "Убийства"
	kills.Parent = ls
	local streak = Instance.new("IntValue")
	streak.Name = "Серия"
	streak.Parent = ls
	ls.Parent = player
	player.CharacterAdded:Connect(function(model) onCharacter(player, model) end)
	task.defer(function()
		if player.Parent then player:LoadCharacter() end
	end)
end

function Spawner.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end
	Players.PlayerRemoving:Connect(function(player)
		local f = Fighters.ofPlayer(player)
		if f then Fighters.remove(f) end
	end)

	-- убийства: статистика, лента, возрождение игрока
	table.insert(Combat.onKill, function(killer, victim)
		local kname, vname = Spawner.nameOf(killer), Spawner.nameOf(victim)
		Net.fx("Kill", {
			k = killer and kname or nil, kc = killer and killer.def.Color or nil,
			v = vname, vc = victim.def.Color, kind = victim.kind,
		})
		if victim.player then
			local s = stat(victim.player, "Серия")
			if s then s.Value = 0 end
			local p = victim.player
			local model = victim.model
			task.delay(Config.RespawnTime, function()
				if p.Parent and p.Character == model then p:LoadCharacter() end
			end)
		end
		if killer and killer.player and killer ~= victim then
			local k = stat(killer.player, "Убийства")
			if k then k.Value = k.Value + 1 end
			local s = stat(killer.player, "Серия")
			if s then
				s.Value = s.Value + 1
				local n = s.Value
				if n == 3 or n == 5 or n == 10 or (n > 10 and n % 5 == 0) then
					Net.fx("Streak", { name = kname, n = n, c = killer.def.Color })
				end
			end
			-- небольшая награда: немного шкалы и здоровья
			Combat.addMeter(killer, 12)
			if Fighters.alive(killer) then
				killer.hum.Health = math.min(killer.hum.MaxHealth, killer.hum.Health + 10)
			end
		end
	end)
end

-- смена персонажа (из меню)
function Spawner.select(player, charId)
	if not Characters.valid(charId) then return end
	local f = Fighters.ofPlayer(player)
	if f and Fighters.alive(f) then
		local now = Util.now()
		if f.charId == charId then return end
		if now - math.max(f.lastDamageTime, f.lastDealtTime) < Config.InCombatTime then
			Net.to(player, "Notify", { text = "В бою персонажа сменить нельзя — подожди пару секунд", kind = "bad" })
			Net.to(player, "Selected", { c = player:GetAttribute("CharId"), ok = false })
			return
		end
		player:SetAttribute("CharId", charId)
		Combat.cancelMove(f)
		if f.awakened then Combat.endAwaken(f) end
		f.charId = charId
		f.def = Characters.get(charId)
		f.cds = { 0, 0, 0, 0 }
		f.m1Index = 0
		Combat.setMeter(f, 0)
		f.model:SetAttribute("Char", charId)
		setupWeapon(f)
		Net.fx("Swap", { m = f.model, c = charId })
		Net.to(player, "Moveset", { awakened = false })
		Net.to(player, "Selected", { c = charId, ok = true })
	else
		player:SetAttribute("CharId", charId)
		Net.to(player, "Selected", { c = charId, ok = true })
	end
end

-- «Возродиться» из меню (если застрял)
function Spawner.respawn(player)
	local f = Fighters.ofPlayer(player)
	if f and Fighters.alive(f) then
		local now = Util.now()
		if now - math.max(f.lastDamageTime, f.lastDealtTime) < Config.InCombatTime then
			Net.to(player, "Notify", { text = "В бою нельзя — подожди пару секунд", kind = "bad" })
			return
		end
	end
	player:LoadCharacter()
end

return Spawner
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000037"><Properties><string name="Name">Moves</string></Properties><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">CrimsonBlade</string><ProtectedString name="Source"><![CDATA[-- Алый Клинок: летящие разрезы, контрстойка, пролёт сквозь врагов, подброс; «Кровавая Луна» и Сад Клинков.
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("CrimsonBlade")
local CRIMSON, WHITE = DEF.Color, DEF.Accent

local M = {}

-- веер летящих разрезов
local function cuts(K, f, aim, def, p)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.5 + 0.08 * p.count, 6)
	K.anim(f, "m1_s2")
	if not K.wait(f, tok, 0.13) then return end
	K.sound("Slash", f.root.Position)
	for i = 1, p.count do
		local ang = 0
		if p.count > 1 then ang = -p.spread / 2 + p.spread * (i - 1) / (p.count - 1) end
		local d = CFrame.Angles(0, math.rad(ang), 0):VectorToWorldSpace(dir)
		K.projectile(f, {
			from = f.root.Position + d * 2.5 + Vector3.new(0, 0.3, 0), dir = d, speed = 125, range = p.range, radius = 3, pierce = 3,
			kind = "slash", color = CRIMSON, size = p.size,
			info = function(t)
				return { damage = p.dmg, stun = 0.85, fx = "slash", knockback = d * 30 + Vector3.new(0, 10, 0), kbTime = 0.12, hitstop = 0.04 }
			end,
		})
	end
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

function M.WindCut(K, f, aim, def)
	cuts(K, f, aim, def, { count = 1, spread = 0, dmg = 11, range = 85, size = 6 })
end

function M.BladeFan(K, f, aim, def)
	cuts(K, f, aim, def, { count = 5, spread = 52, dmg = 9, range = 75, size = 5 })
end

-- контрстойка
function M.Counter(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 1.05, 0)
	K.anim(f, "counter_stance")
	K.fx("Glint", { m = f.model, c = WHITE })
	local triggered = false
	f.counter = function(attacker, info)
		if not K.valid(f, tok) then return false end
		triggered = true
		task.spawn(function()
			K.busy(f, 0.8, 0)
			K.iframes(f, 0.6)
			K.fx("Text", { p = f.root.Position + Vector3.new(0, 4, 0), text = "КОНТРАТАКА!", c = CRIMSON })
			local from = f.root.Position
			local behind = attacker.root.Position - attacker.root.CFrame.LookVector * 3.6
			behind = K.safePoint(attacker.root.Position, behind)
			K.teleport(f, behind, attacker.root.Position - behind)
			K.fx("Blink", { a = from, b = behind, c = CRIMSON })
			K.anim(f, "slash_through")
			K.fx("SlashArc", { cf = f.root.CFrame, c = CRIMSON, r = 7, w = 1.4 })
			C.hit(f, attacker, { damage = 15, stun = 1.2, unblockable = true, heavy = true, fx = "slashHeavy", knockback = K.knock(f, attacker, 62, 34),
				ragdoll = 1.4, kbTime = 0.2, hitstop = 0.12, shake = 1 })
			task.wait(0.45)
			K.finish(f, tok)
		end)
		return true
	end
	if not K.wait(f, tok, 0.95) then
		f.counter = nil
		return
	end
	if not triggered then
		f.counter = nil
		K.stopAnim(f)
		K.finish(f, tok)
	end
end

-- пролёт сквозь врагов, затем порезы
function M.BladeFlurry(K, f, aim, def)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.2, 0)
	K.anim(f, "slash_through")
	K.iframes(f, 0.4)
	K.fx("Trail", { m = f.model, c = CRIMSON, t = 0.4, k = "blade" })
	local start = f.root.Position
	local passed = {}
	K.dash(f, tok, dir, 112, 0.3, { contact = 4, stop = false, onContact = function(t)
		passed[#passed + 1] = t
		C.hit(f, t, { damage = 2, stun = 1.3, fx = "slash", knockback = Vector3.zero, kbTime = 0.01, noCombo = true })
	end })
	K.fx("Lines", { a = start, b = f.root.Position, c = CRIMSON })
	if #passed == 0 then
		K.finish(f, tok)
		return
	end
	if not K.wait(f, tok, 0.28) then return end
	for _ = 1, 4 do
		for _, t in ipairs(passed) do
			if F.alive(t) then
				K.fx("SlashMark", { p = t.root.Position, c = CRIMSON })
				C.hit(f, t, { damage = 3, stun = 0.7, fx = "slash", knockback = Vector3.zero, kbTime = 0.01 })
			end
		end
		task.wait(0.09)
	end
	for _, t in ipairs(passed) do
		if F.alive(t) then
			C.hit(f, t, { damage = 4, stun = 0.9, heavy = true, fx = "slashHeavy", knockback = K.knock(f, t, 46, 30), ragdoll = 1, kbTime = 0.15, hitstop = 0.06 })
		end
	end
	K.wait(f, tok, 0.2)
	K.finish(f, tok)
end

-- подброс и удар сверху
function M.RisingSlash(K, f, aim, def)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.4, 0)
	K.anim(f, "rising_slash")
	if not K.wait(f, tok, 0.19) then return end
	local res = K.boxFront(f, dir, 7, 7, 8, { damage = 8, stun = 1.5, fx = "slash", knockback = Vector3.new(0, 72, 0) + dir * 6, kbTime = 0.25, hitstop = 0.06 }, {})
	K.fx("SlashArc", { cf = CFrame.lookAt(f.root.Position + dir * 3, f.root.Position + dir * 4) * CFrame.Angles(0, 0, math.rad(90)), c = CRIMSON, r = 6, w = 1.2 })
	local t = K.firstHit(res)
	if not t then
		K.wait(f, tok, 0.3)
		K.finish(f, tok)
		return
	end
	K.setVel(f, Vector3.new(0, 78, 0) + dir * 4)
	if not K.wait(f, tok, 0.3) then K.stopVel(f) return end
	K.stopVel(f)
	K.anim(f, "overhead")
	if not K.wait(f, tok, 0.12) then return end
	if F.alive(t) then
		C.hit(f, t, { damage = 10, stun = 1.2, heavy = true, fx = "slashHeavy", knockback = Vector3.new(0, -115, 0) + dir * 10, ragdoll = 1.5, kbTime = 0.18,
			shake = 1, hitstop = 0.1 })
		K.fx("SlashArc", { cf = f.root.CFrame * CFrame.new(0, -1, -3) * CFrame.Angles(0, 0, math.rad(90)), c = CRIMSON, r = 6, w = 1.4 })
	end
	K.setVel(f, Vector3.new(0, -85, 0))
	K.wait(f, tok, 0.22)
	K.stopVel(f)
	if F.alive(t) then K.fx("Crater", { p = K.ground(t.root.Position), r = 7, c = CRIMSON }) end
	K.finish(f, tok)
end

-- мгновенный разрез насквозь
function M.InstantCut(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 0.9, 0)
	local t = K.target(f, aim, 55, 0.35)
	local from = f.root.Position
	local dir = K.dir(f, aim)
	if t then dir = K.Util.flat(t.root.Position - from, dir) end
	local dest
	if t then
		dest = K.safePoint(t.root.Position, t.root.Position + dir * 6)
	else
		dest = K.safePoint(from, from + dir * 30)
	end
	K.fx("Afterimage", { m = f.model, c = CRIMSON })
	K.teleport(f, dest, dir)
	K.anim(f, "slash_through")
	K.fx("Lines", { a = from, b = dest, c = CRIMSON, w = 1.2 })
	K.sound("SlashHeavy", dest)
	K.segmentHit(f, from, dest, 4, function(x)
		return { damage = 12, stun = 1.1, heavy = true, fx = "slashHeavy", knockback = dir * 30 + Vector3.new(0, 26, 0), ragdoll = 1, kbTime = 0.15, hitstop = 0.1 }
	end, {})
	K.wait(f, tok, 0.35)
	K.finish(f, tok)
end

-- буря порезов вокруг
function M.ThousandCuts(K, f, aim, def)
	local C, H = K.Combat, K.Hitbox
	local tok = K.start(f, def.Id, 1.6, 0)
	K.armor(f, 1.2)
	K.anim(f, "spin_loop")
	local center = f.root.Position
	K.fx("Ring", { p = K.ground(center), c = CRIMSON, r = 14, t = 1.1 })
	for i = 1, 10 do
		if not K.wait(f, tok, 0.1) then return end
		for _, t in ipairs(H.radius(f.root.Position, 14, { [f] = true })) do
			K.fx("SlashMark", { p = t.root.Position, c = CRIMSON })
			C.hit(f, t, { damage = 1.7, stun = 0.5, fx = "slash", knockback = Vector3.zero, kbTime = 0.01, noCombo = i % 2 == 0 })
		end
	end
	K.radiusHit(f, f.root.Position, 14, function(t)
		return { damage = 6, stun = 1, heavy = true, fx = "slashHeavy", knockback = K.knock(f, t, 70, 30), ragdoll = 1.3, kbTime = 0.2, shake = 1 }
	end, {})
	K.fx("Burst", { p = f.root.Position, c = CRIMSON, r = 12, k = "slash" })
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

-- территория: Сад Клинков
function M.BladeGarden(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 1.7, 0)
	K.iframes(f, 1.6)
	K.anim(f, "sign")
	K.fx("Ult", { m = f.model, text = def.Name, c = CRIMSON, c2 = WHITE, domain = true })
	if not K.wait(f, tok, 1.15) then return end
	K.Domains.open(f, {
		style = "blade", name = def.Name, radius = 40, duration = 8, tick = 0.4, slow = 0.55,
		onTick = function(d, victims)
			for _, v in ipairs(victims) do
				K.fx("SlashMark", { p = v.root.Position, c = CRIMSON, big = true })
				C.hit(f, v, { damage = 3, stun = 0.35, trueDamage = true, fx = "slash", knockback = Vector3.zero, kbTime = 0.01 })
			end
		end,
	})
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">FlameDemon</string><ProtectedString name="Source"><![CDATA[-- Пламенный Демон: шары, огненный рывок, столб, метеор; «Инферно» и Солнечная Вспышка.
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("FlameDemon")
local ORANGE, YELLOW = DEF.Color, DEF.Accent
local RED = Color3.fromRGB(230, 50, 20)

local M = {}

local function explode(K, f, pos, r, dmg, burn)
	local C = K.Combat
	K.fx("Explosion", { p = pos, r = r, c = ORANGE, c2 = YELLOW, k = "fire" })
	K.sound("Explosion", pos)
	K.radiusHit(f, pos, r, function(t)
		local d = t.root.Position - pos
		local away = Vector3.new(d.X, 0, d.Z)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 0)
		return { damage = dmg, stun = 0.9, heavy = dmg >= 12, fx = "fire", knockback = away * 45 + Vector3.new(0, 30, 0), ragdoll = dmg >= 12 and 1.1 or nil,
			kbTime = 0.18, hitstop = 0.05 }
	end, {})
	if burn then
		for _, t in ipairs(K.Hitbox.radius(pos, r, { [f] = true })) do C.burn(f, t, 2, burn) end
	end
	K.breakAt(pos, r * 0.7, 1)
end

local function fireball(K, f, from, dir, p)
	K.projectile(f, {
		from = from, dir = dir, speed = p.speed or 82, range = p.range or 80, radius = p.radius or 2, kind = "fireball", color = ORANGE, size = p.size or 2.2,
		onHit = function() return false end,
		onEnd = function(pos) explode(K, f, pos, p.blast or 9, p.dmg or 12, p.burn or 3) end,
	})
end

function M.Fireball(K, f, aim, def)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.55, 6)
	K.anim(f, "throw")
	K.fx("Charge", { m = f.model, c = ORANGE, t = 0.2, k = "fire", hand = "R" })
	if not K.wait(f, tok, 0.2) then return end
	K.sound("Fire", f.root.Position)
	fireball(K, f, f.root.Position + dir * 2.5 + Vector3.new(0, 0.8, 0), dir, {})
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

function M.FireBarrage(K, f, aim, def)
	local tok = K.start(f, def.Id, 1.1, 5)
	for i = 1, 5 do
		K.anim(f, i % 2 == 1 and "jab_r" or "jab_l")
		local dir = K.dir(f, aim)
		local spread = (i - 3) * 4
		local d = CFrame.Angles(0, math.rad(spread), 0):VectorToWorldSpace(dir)
		K.sound("Fire", f.root.Position)
		fireball(K, f, f.root.Position + d * 2.5 + Vector3.new(0, 0.8, 0), d, { dmg = 8, blast = 6, burn = 2, size = 1.6, speed = 95 })
		if not K.wait(f, tok, 0.16) then return end
	end
	K.finish(f, tok)
end

-- огненный рывок: за ним горит дорожка
function M.FlameDash(K, f, aim, def)
	local C, H = K.Combat, K.Hitbox
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.9, 0)
	K.anim(f, "rush")
	K.fx("Trail", { m = f.model, c = ORANGE, t = 0.45, k = "fire" })
	K.sound("Fire", f.root.Position)
	local a = f.root.Position
	K.dash(f, tok, dir, 100, 0.32, { contact = 3.6, stop = false, onContact = function(t)
		C.hit(f, t, { damage = 8, stun = 0.8, fx = "fire", knockback = K.knock(f, t, 40, 22), kbTime = 0.15, hitstop = 0.05 })
		C.burn(f, t, 2, 2.5)
	end })
	local b = f.root.Position
	local ga, gb = K.ground(a), K.ground(b)
	K.fx("FireTrail", { a = ga, b = gb, c = ORANGE, t = 2.2 })
	K.stopAnim(f)
	K.finish(f, tok)
	-- дорожка жжёт 2 секунды
	task.spawn(function()
		for _ = 1, 7 do
			task.wait(0.3)
			for _, t in ipairs(H.segment(ga + Vector3.new(0, 2.5, 0), gb + Vector3.new(0, 2.5, 0), 4, { [f] = true })) do
				C.burn(f, t, 2, 1.5)
			end
		end
	end)
end

-- столб пламени под врагом
function M.FlamePillar(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 0.6, 4)
	K.anim(f, "point")
	local point = K.aimPoint(f, aim, 55, 25)
	K.fx("Warn", { p = point, r = 6, c = ORANGE, t = 0.6 })
	if not K.wait(f, tok, 0.3) then return end
	K.finish(f, tok)
	K.after(0.3, function()
		K.fx("Pillar", { p = point, r = 6, h = 40, c = ORANGE, c2 = YELLOW, t = 0.9, k = "fire" })
		K.sound("Fire", point)
		K.radiusHit(f, point, 6.5, function(t)
			C.burn(f, t, 2, 3)
			return { damage = 15, stun = 1.2, heavy = true, fx = "fire", knockback = Vector3.new(0, 75, 0), ragdoll = 1.3, kbTime = 0.22, hitstop = 0.08, shake = 0.8 }
		end, {})
	end)
end

-- метеор с неба
function M.Meteor(K, f, aim, def)
	local tok = K.start(f, def.Id, 0.8, 3)
	K.anim(f, "rise")
	local point = K.aimPoint(f, aim, 60, 30)
	K.fx("Meteor", { p = point, t = 1.2, r = 16, c = ORANGE, c2 = RED })
	K.fx("Warn", { p = point, r = 16, c = RED, t = 1.2 })
	if not K.wait(f, tok, 0.5) then return end
	K.stopAnim(f)
	K.finish(f, tok)
	K.after(0.7, function()
		K.fx("Crater", { p = point, r = 13, c = ORANGE })
		K.shake(point, 1.6, 120)
		explode(K, f, point, 16, 22, 3)
	end)
end

-- кольцо огня вокруг себя
function M.FireRing(K, f, aim, def)
	local C, H = K.Combat, K.Hitbox
	local tok = K.start(f, def.Id, 0.9, 0)
	K.anim(f, "stomp")
	if not K.wait(f, tok, 0.24) then return end
	local center = K.ground(f.root.Position)
	K.fx("FireRing", { p = center, r = 22, c = ORANGE, c2 = YELLOW, t = 0.55 })
	K.sound("Explosion", center)
	local hitSet = {}
	for step = 1, 5 do
		local r = 22 * step / 5
		for _, t in ipairs(H.radius(center + Vector3.new(0, 3, 0), r, { [f] = true })) do
			if not hitSet[t] then
				hitSet[t] = true
				C.hit(f, t, { damage = 14, stun = 1, heavy = true, fx = "fire", knockback = C.away(f, t) * 70 + Vector3.new(0, 30, 0), ragdoll = 1.2, kbTime = 0.2, hitstop = 0.06 })
				C.burn(f, t, 2, 3)
			end
		end
		task.wait(0.08)
	end
	K.breakAt(center, 16, 1)
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

-- феникс: полёт сквозь врагов
function M.Phoenix(K, f, aim, def)
	local C = K.Combat
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.0, 0)
	K.iframes(f, 0.5)
	K.anim(f, "fly")
	K.fx("Phoenix", { m = f.model, c = ORANGE, c2 = YELLOW, t = 0.5 })
	K.sound("Fire", f.root.Position)
	local start = f.root.Position
	K.dash(f, tok, dir, 105, 0.42, { contact = 4.5, stop = false, onContact = function(t)
		C.hit(f, t, { damage = 16, stun = 1, heavy = true, fx = "fire", knockback = dir * 60 + Vector3.new(0, 40, 0), ragdoll = 1.4, kbTime = 0.22, hitstop = 0.08, shake = 0.8 })
		C.burn(f, t, 2, 3)
	end })
	K.fx("FireTrail", { a = K.ground(start), b = K.ground(f.root.Position), c = ORANGE, t = 1.2 })
	K.stopAnim(f)
	K.wait(f, tok, 0.15)
	K.finish(f, tok)
end

-- ульта: маленькое солнце
function M.SolarFlare(K, f, aim, def)
	local F = K.Fighters
	local tok = K.start(f, def.Id, 3.2, 0)
	K.iframes(f, 3)
	K.armor(f, 3.2)
	K.fx("Ult", { m = f.model, text = def.Name, c = ORANGE, c2 = YELLOW })
	K.anim(f, "rise")
	K.setVel(f, Vector3.new(0, 55, 0))
	if not K.wait(f, tok, 0.45) then K.stopVel(f) return end
	K.setVel(f, Vector3.new(0, 0, 0))
	local point = K.aimPoint(f, aim, 60, 30)
	K.fx("Sun", { m = f.model, t = 1.6, r = 9, c = ORANGE, c2 = YELLOW })
	K.fx("Warn", { p = point, r = 32, c = RED, t = 1.9 })
	if not K.wait(f, tok, 1.6) then K.stopVel(f) return end
	K.anim(f, "throw")
	K.fx("SunFall", { a = f.root.Position + Vector3.new(0, 6, 0), b = point, t = 0.35, c = ORANGE, c2 = YELLOW })
	if not K.wait(f, tok, 0.35) then K.stopVel(f) return end
	K.stopVel(f)
	K.radiusHit(f, point, 32, function(t)
		local dist = (t.root.Position - point).Magnitude
		local k = 1 - math.clamp(dist / 32, 0, 1) * 0.55
		K.Combat.burn(f, t, 3, 4)
		return { damage = 32 * k, stun = 1.5, guardBreak = true, heavy = true, fx = "fire", knockback = K.knock(f, t, 115 * k, 65), ragdoll = 2, kbTime = 0.25,
			shake = 2, hitstop = 0.15 }
	end, {})
	K.fx("Explosion", { p = point, r = 32, c = ORANGE, c2 = YELLOW, k = "fire", big = true })
	K.fx("Crater", { p = point, r = 22, c = ORANGE })
	K.breakAt(point, 32, 2)
	K.shake(point, 2.8, 200)
	K.wait(f, tok, 0.5)
	K.finish(f, tok)
	if F.alive(f) then f.root.AssemblyLinearVelocity = Vector3.zero end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">ShadowCaller</string><ProtectedString name="Source"><![CDATA[-- Призыватель Теней: псы, вороны, нырок в тень, пасть бездны; «Ночной Легион» и территория «Бездна».
local RunService = game:GetService("RunService")
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("ShadowCaller")
local PURPLE, BLUE = DEF.Color, DEF.Accent
local BLACK = Color3.fromRGB(14, 10, 22)

local M = {}

-- теневой пёс из деталей (виден всем, двигает сервер)
local function makeHound(K, cf)
	local model = Instance.new("Model")
	model.Name = "ShadowHound"
	local function part(name, size, offset, color, mat)
		local p = K.Util.part({ Name = name, Size = size, CFrame = cf * offset, Color = color, Material = mat or Enum.Material.SmoothPlastic })
		p.Parent = model
		return p
	end
	local body = part("Body", Vector3.new(1.4, 1.3, 3.2), CFrame.new(0, 0, 0), BLACK)
	part("Head", Vector3.new(1.2, 1.1, 1.3), CFrame.new(0, 0.45, -2), BLACK)
	part("Snout", Vector3.new(0.8, 0.6, 0.9), CFrame.new(0, 0.2, -2.9), BLACK)
	part("EyeL", Vector3.new(0.22, 0.12, 0.1), CFrame.new(-0.3, 0.65, -2.66), PURPLE, Enum.Material.Neon)
	part("EyeR", Vector3.new(0.22, 0.12, 0.1), CFrame.new(0.3, 0.65, -2.66), PURPLE, Enum.Material.Neon)
	part("EarL", Vector3.new(0.25, 0.6, 0.3), CFrame.new(-0.4, 1.15, -1.8), BLACK)
	part("EarR", Vector3.new(0.25, 0.6, 0.3), CFrame.new(0.4, 1.15, -1.8), BLACK)
	part("Tail", Vector3.new(0.3, 0.3, 1.6), CFrame.new(0, 0.4, 2.1) * CFrame.Angles(math.rad(25), 0, 0), BLACK)
	for _, x in ipairs({ -0.5, 0.5 }) do
		for _, z in ipairs({ -1.1, 1.1 }) do part("Leg", Vector3.new(0.35, 1.2, 0.35), CFrame.new(x, -1, z), BLACK) end
	end
	part("Mane", Vector3.new(1.6, 1.2, 0.9), CFrame.new(0, 0.5, -1.2), PURPLE, Enum.Material.Neon).Transparency = 0.6
	model.PrimaryPart = body
	model.Parent = workspace:FindFirstChild("FX") or workspace
	return model
end

local function hound(K, f, start, target, dmg)
	local C, F, H = K.Combat, K.Fighters, K.Hitbox
	local model = makeHound(K, start)
	K.fx("Smoke", { p = start.Position, c = PURPLE, r = 3 })
	local pos = start.Position
	local dir = start.LookVector
	local t0 = os.clock()
	local bit = false
	while os.clock() - t0 < 2.6 and F.alive(f) do
		local dt = RunService.Heartbeat:Wait()
		local tgt = target
		if not tgt or not F.alive(tgt) then tgt = H.nearest(pos, 40, { [f] = true }) end
		if tgt then
			local d = tgt.root.Position - pos
			local flat = Vector3.new(d.X, 0, d.Z)
			if flat.Magnitude > 0.5 then dir = dir:Lerp(flat.Unit, math.min(1, dt * 8)).Unit end
			if d.Magnitude < 3.4 then
				C.hit(f, tgt, { damage = dmg, stun = 0.95, fx = "bite", knockback = dir * 26 + Vector3.new(0, 14, 0), kbTime = 0.15, hitstop = 0.05 })
				K.fx("Burst", { p = tgt.root.Position, c = PURPLE, r = 3, k = "shadow" })
				bit = true
				break
			end
		end
		pos = pos + dir * 58 * dt
		local g = K.Util.ground(pos + Vector3.new(0, 3, 0), 12)
		pos = Vector3.new(pos.X, g.Y + 1.7, pos.Z)
		local bob = math.sin((os.clock() - t0) * 22) * 0.25
		model:PivotTo(CFrame.lookAt(pos, pos + dir) * CFrame.new(0, bob, 0))
	end
	K.fx("Smoke", { p = pos, c = PURPLE, r = bit and 4 or 3 })
	model:Destroy()
end

local function hounds(K, f, aim, def, n, dmg)
	local tok = K.start(f, def.Id, 0.65, 6)
	K.anim(f, "summon")
	K.fx("ShadowPool", { p = K.ground(f.root.Position), r = 4.5, t = 0.9, c = PURPLE })
	K.sound("Shadow", f.root.Position)
	if not K.wait(f, tok, 0.32) then return end
	K.finish(f, tok)
	local target = K.target(f, aim, 55, 0.25)
	for i = 1, n do
		local side = (i % 2 == 1) and 1 or -1
		local row = math.floor((i - 1) / 2)
		local start = f.root.CFrame * CFrame.new(side * (2.2 + row * 1.5), -1.3, -1 + row * 2)
		task.spawn(hound, K, f, start, target, dmg)
	end
end

function M.Hounds(K, f, aim, def) hounds(K, f, aim, def, 2, 7) end
function M.HoundPack(K, f, aim, def) hounds(K, f, aim, def, 4, 6) end

-- стая воронов
function M.CrowSwarm(K, f, aim, def)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.55, 5)
	K.anim(f, "throw")
	if not K.wait(f, tok, 0.18) then return end
	K.sound("Crow", f.root.Position)
	K.projectile(f, {
		from = f.root.Position + dir * 2 + Vector3.new(0, 1, 0), dir = dir, speed = 72, range = 75, radius = 5, pierce = 99,
		kind = "crows", color = PURPLE,
		onHit = function(t)
			t.blindEnd = math.max(t.blindEnd, K.now() + 1.6)
			task.spawn(function()
				for _ = 1, 3 do
					if F.alive(t) then C.hit(f, t, { damage = 3, stun = 0.65, fx = "shadow", knockback = dir * 4, kbTime = 0.06 }) end
					task.wait(0.1)
				end
			end)
			return true
		end,
	})
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

-- нырок в тень: неуязвимость и скорость, выход — апперкот
function M.ShadowDive(K, f, aim, def, slot)
	local C = K.Combat
	local tok = K.start(f, def.Id, 1.8, 0)
	K.anim(f, "sink")
	K.fx("ShadowPool", { p = K.ground(f.root.Position), r = 3.5, t = 0.6, c = PURPLE })
	K.sound("Shadow", f.root.Position)
	if not K.wait(f, tok, 0.22) then return end
	local now = K.now()
	f.invisEnd = now + 1.5
	K.iframes(f, 1.5)
	K.busy(f, 1.6, 40)
	local emerged = false
	local function emerge()
		if emerged or not K.valid(f, tok) then return end
		emerged = true
		f.invisEnd = 0
		f.iframesEnd = K.now() + 0.25
		K.busy(f, 0.55, 0)
		K.anim(f, "emerge")
		local pos = f.root.Position
		K.fx("ShadowBurst", { p = K.ground(pos), r = 7, c = PURPLE, c2 = BLUE })
		K.sound("Bite", pos)
		K.radiusHit(f, pos, 7, function(t)
			return { damage = 10, stun = 1, heavy = true, fx = "shadow", knockback = Vector3.new(0, 64, 0) + C.away(f, t) * 10, ragdoll = 1.2, kbTime = 0.22, hitstop = 0.08, shake = 0.8 }
		end, {})
		K.after(0.45, function() K.finish(f, tok) end)
	end
	f.recast = { slot = slot, fromT = now + 0.25, untilT = now + 1.45, cb = emerge }
	-- бот сам плывёт к цели
	if not f.player then
		local t = K.target(f, aim, 40, -1)
		if t then f.hum:MoveTo(t.root.Position) end
	end
	local t0 = os.clock()
	while os.clock() - t0 < 1.4 and not emerged do
		task.wait(0.1)
		if not K.valid(f, tok) then
			f.invisEnd = 0
			return
		end
		if not f.player then
			local t = K.Hitbox.nearest(f.root.Position, 4, { [f] = true })
			if t then
				f.recast = nil
				emerge()
			end
		end
	end
	if not emerged then
		f.recast = nil
		emerge()
	end
end

-- пасть бездны под врагом
function M.AbyssMaw(K, f, aim, def)
	local tok = K.start(f, def.Id, 0.7, 4)
	K.anim(f, "point")
	local point = K.aimPoint(f, aim, 50, 25)
	K.fx("ShadowPool", { p = point, r = 7, t = 1.0, c = PURPLE, warn = true })
	if not K.wait(f, tok, 0.4) then return end
	K.finish(f, tok)
	K.after(0.12, function()
		K.fx("Maw", { p = point, r = 7, c = PURPLE })
		K.sound("Bite", point)
		K.radiusHit(f, point, 7.5, { damage = 16, stun = 1.3, heavy = true, fx = "bite", knockback = Vector3.new(0, 66, 0), ragdoll = 1.4, kbTime = 0.2,
			shake = 1, hitstop = 0.1 }, {})
		K.breakAt(point, 6, 1)
	end)
end

-- огромный кулак тени
function M.ShadowGiant(K, f, aim, def)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.0, 2)
	K.anim(f, "punch_heavy")
	K.fx("GiantFist", { cf = CFrame.lookAt(f.root.Position, f.root.Position + dir), c = PURPLE, c2 = BLACK, len = 32, t = 0.6 })
	if not K.wait(f, tok, 0.3) then return end
	K.boxFront(f, dir, 12, 10, 32, function(t)
		return { damage = 18, stun = 1.2, heavy = true, fx = "shadow", knockback = dir * 92 + Vector3.new(0, 30, 0), ragdoll = 1.6, kbTime = 0.22,
			guardBreak = true, shake = 1.4, hitstop = 0.1 }
	end, {})
	for i = 1, 3 do K.breakAt(f.root.Position + dir * (i * 10), 6, 1.2) end
	K.shake(f.root.Position + dir * 10, 1.3, 80)
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

-- цепи: сковать всех вокруг
function M.ShadowChains(K, f, aim, def)
	local C, H = K.Combat, K.Hitbox
	local tok = K.start(f, def.Id, 0.8, 0)
	K.anim(f, "summon")
	K.fx("ShadowPool", { p = K.ground(f.root.Position), r = 20, t = 0.8, c = PURPLE })
	if not K.wait(f, tok, 0.35) then return end
	for _, t in ipairs(H.radius(f.root.Position, 20, { [f] = true })) do
		local r = C.hit(f, t, { damage = 6, stun = 0.6, fx = "shadow", knockback = Vector3.zero, kbTime = 0.01 })
		if r == "hit" then
			t.rootEnd = math.max(t.rootEnd, K.now() + 2)
			K.fx("Chains", { m = t.model, a = K.ground(f.root.Position), t = 2, c = PURPLE })
		end
	end
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- территория: Бездна
function M.Abyss(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 1.7, 0)
	K.iframes(f, 1.6)
	K.anim(f, "sign")
	K.fx("Ult", { m = f.model, text = def.Name, c = PURPLE, c2 = BLUE, domain = true })
	if not K.wait(f, tok, 1.15) then return end
	K.Domains.open(f, {
		style = "abyss", name = def.Name, radius = 42, duration = 8, tick = 0.8, slow = 0.4,
		onTick = function(d, victims)
			for _, v in ipairs(victims) do
				K.fx("Maw", { p = K.ground(v.root.Position), r = 3.5, c = PURPLE, small = true })
				C.hit(f, v, { damage = 5, stun = 0.5, trueDamage = true, fx = "bite", knockback = Vector3.new(0, 10, 0), kbTime = 0.08 })
			end
		end,
	})
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">StormFist</string><ProtectedString name="Source"><![CDATA[-- Кулак Бури: рывки, серии, отложенный удар, захват; пробуждение «Ярость Бури».
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("StormFist")
local RED, GOLD = DEF.Color, DEF.Accent

local M = {}

-- рывок с серией и Резонансом (нажать клавишу ещё раз во время вспышки)
local function rush(K, f, aim, def, slot, p)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.5, 0)
	K.anim(f, "rush")
	K.fx("Trail", { m = f.model, c = p.lightning and GOLD or RED, t = p.time + 0.1, k = p.lightning and "zap" or "wind" })
	K.sound("Dash", nil, f.model)
	local target = K.dash(f, tok, dir, p.speed, p.time, { contact = 3.4 })
	if not target then
		K.stopAnim(f)
		K.finish(f, tok)
		return
	end
	K.faceTarget(f, target)
	for i = 1, p.hits do
		if not F.alive(target) then break end
		K.anim(f, i % 2 == 1 and "jab_l" or "jab_r")
		C.hit(f, target, { damage = p.jab, stun = 0.85, fx = p.lightning and "zap" or "punch", knockback = K.knock(f, target, 4, 0), kbTime = 0.06, hitstop = 0.03 })
		if not K.wait(f, tok, 0.14) then return end
	end
	if not F.alive(target) then
		K.finish(f, tok)
		return
	end
	-- добивающий с окном Резонанса
	K.anim(f, "punch_heavy")
	local crit = false
	local now = K.now()
	f.recast = { slot = slot, fromT = now + 0.1, untilT = now + 0.34, cb = function() crit = true end }
	K.fx("Cue", { m = f.model, t = 0.34, d = 0.1, c = GOLD })
	if not K.wait(f, tok, 0.3) then
		f.recast = nil
		return
	end
	f.recast = nil
	local res = C.hit(f, target, {
		damage = crit and p.crit or p.fin, stun = 1.1, heavy = true, fx = crit and "crit" or "heavy", crit = crit,
		knockback = K.knock(f, target, crit and 100 or 72, 28), ragdoll = 1.35, kbTime = 0.22,
		shake = crit and 1.5 or 0.8, hitstop = crit and 0.14 or 0.07,
	})
	if crit and (res == "hit" or res == "killed") then
		K.fx("Resonance", { m = target.model, p = target.root.Position, c = RED, c2 = GOLD })
		K.shake(target.root.Position, 1.6, 90)
		K.breakAt(target.root.Position, 6, 1)
	end
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

function M.FistRush(K, f, aim, def, slot)
	rush(K, f, aim, def, slot, { speed = 95, time = 0.36, hits = 2, jab = 4, fin = 7, crit = 16 })
end

function M.ThunderRush(K, f, aim, def, slot)
	rush(K, f, aim, def, slot, { speed = 120, time = 0.42, hits = 3, jab = 4, fin = 8, crit = 18, lightning = true })
end

-- круговой пинок
local function whirl(K, f, aim, def, slot, p)
	local C = K.Combat
	local tok = K.start(f, def.Id, 0.55 + 0.2 * p.hits, 3)
	K.anim(f, p.hits > 2 and "spin_loop" or "spin_kick")
	K.sound("SwingHeavy", nil, f.model)
	if not K.wait(f, tok, 0.1) then return end
	local center = f.root.Position
	if p.pull then
		-- затянуть врагов в центр
		K.fx("Vortex", { p = K.ground(center), c = GOLD, r = p.radius + 6, t = 0.5, k = "wind" })
		for _, t in ipairs(K.Hitbox.radius(center, p.radius + 6, { [f] = true })) do
			local d = center - t.root.Position
			C.knockback(t, Vector3.new(d.X, 0, d.Z) * 4, 0.18)
			C.stun(t, 0.6)
		end
	end
	for i = 1, p.hits do
		center = f.root.Position
		K.fx("Ring", { p = K.ground(center), c = i == p.hits and RED or GOLD, r = p.radius, t = 0.3 })
		local last = i == p.hits
		K.radiusHit(f, center, p.radius, function(t)
			if last then
				return { damage = p.fin, stun = 1, heavy = true, fx = "heavy", knockback = K.knock(f, t, 48, 52), ragdoll = 1.2, kbTime = 0.2, hitstop = 0.06, shake = 0.7 }
			end
			return { damage = p.dmg, stun = 0.75, fx = "punch", knockback = Vector3.new(0, 6, 0), kbTime = 0.08 }
		end, {})
		if not last and not K.wait(f, tok, 0.18) then return end
	end
	K.fx("Burst", { p = f.root.Position, c = RED, r = p.radius * 0.8, k = "wind" })
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

function M.WhirlKick(K, f, aim, def, slot)
	whirl(K, f, aim, def, slot, { radius = 9, hits = 2, dmg = 5, fin = 6 })
end

function M.Hurricane(K, f, aim, def, slot)
	whirl(K, f, aim, def, slot, { radius = 14, hits = 3, dmg = 4, fin = 8, pull = true })
end

-- удар с отложенной волной (вторая волна пробивает блок)
function M.DelayedImpact(K, f, aim, def, slot)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.8, 2)
	K.anim(f, "punch_heavy")
	if not K.wait(f, tok, 0.27) then return end
	local res = K.boxFront(f, dir, 6, 6, 8, { damage = 6, stun = 1.15, heavy = true, fx = "heavy", knockback = dir * 4, kbTime = 0.08, hitstop = 0.06 }, {})
	K.fx("Burst", { p = f.root.Position + dir * 4.5, c = RED, r = 4, k = "punch" })
	local victims = {}
	for _, e in ipairs(res) do
		if e.r == "hit" or e.r == "blocked" then victims[#victims + 1] = e.f end
	end
	for _, v in ipairs(victims) do K.fx("Mark", { m = v.model, c = RED, t = 0.45 }) end
	if #victims > 0 then
		K.after(0.45, function()
			for _, v in ipairs(victims) do
				if F.alive(v) and F.alive(f) then
					K.fx("Shock", { p = v.root.Position, c = RED, c2 = GOLD, r = 8 })
					C.hit(f, v, { damage = 9, stun = 0.9, unblockable = true, heavy = true, fx = "crit2", knockback = K.knock(f, v, 70, 30),
						ragdoll = 1.4, kbTime = 0.2, shake = 1, hitstop = 0.08 })
				end
			end
		end)
	end
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- захват в прыжке и бросок о землю
function M.Crusher(K, f, aim, def, slot)
	local C, F = K.Combat, K.Fighters
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.0, 0)
	K.anim(f, "grab")
	local target = K.dash(f, tok, dir, 72, 0.3, { contact = 3.2, up = 16 })
	if not target then
		K.stopAnim(f)
		K.finish(f, tok)
		return
	end
	local r = C.hit(f, target, { damage = 3, stun = 2.2, unblockable = true, fx = "punch", hitstop = 0.05 })
	if r ~= "hit" then
		K.finish(f, tok)
		return
	end
	K.busy(f, 1.4, 0)
	K.iframes(f, 1.1)
	K.anim(f, "slam")
	K.hold(f, target, CFrame.new(0, 4.6, -1.2), 0.42, tok)
	if not K.valid(f, tok) or not F.alive(target) then
		K.finish(f, tok)
		return
	end
	local spot = K.ground(f.root.Position + dir * 4)
	target.root.CFrame = CFrame.new(spot + Vector3.new(0, 2.5, 0))
	C.hit(f, target, { damage = 16, stun = 1.2, unblockable = true, heavy = true, fx = "heavy", knockback = Vector3.new(0, 34, 0) + dir * 22,
		ragdoll = 1.7, kbTime = 0.15, shake = 1.3, hitstop = 0.11 })
	K.fx("Crater", { p = spot, r = 9, c = RED })
	K.breakAt(spot, 9, 1)
	K.shake(spot, 1.2, 70)
	K.wait(f, tok, 0.35)
	K.finish(f, tok)
end

-- град ударов
function M.ThousandFists(K, f, aim, def, slot)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 1.9, 2)
	K.armor(f, 1.5)
	K.anim(f, "barrage")
	for i = 1, 14 do
		if not K.wait(f, tok, 0.085) then return end
		K.boxFront(f, dir, 6, 6, 7, { damage = 1.4, stun = 0.55, fx = "punch", knockback = dir * 3, kbTime = 0.05, noCombo = i % 2 == 0 }, {})
		if i % 3 == 0 then K.fx("Burst", { p = f.root.Position + dir * 4 + Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, 0), c = GOLD, r = 2.5, k = "punch" }) end
	end
	K.anim(f, "punch_heavy")
	if not K.wait(f, tok, 0.27) then return end
	K.boxFront(f, dir, 7, 6, 8, function(t)
		return { damage = 8, stun = 1, heavy = true, fx = "heavy", knockback = K.knock(f, t, 88, 30), ragdoll = 1.3, kbTime = 0.22, shake = 1, hitstop = 0.09 }
	end, {})
	K.fx("Burst", { p = f.root.Position + dir * 5, c = RED, r = 6, k = "punch" })
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- ульта: прыжок в небо и удар о землю
function M.HeavenStrike(K, f, aim, def, slot)
	local F = K.Fighters
	local tok = K.start(f, def.Id, 3.0, 0)
	K.iframes(f, 2.4)
	K.armor(f, 3)
	K.fx("Ult", { m = f.model, text = def.Name, c = RED, c2 = GOLD })
	K.anim(f, "crouch_leap")
	if not K.wait(f, tok, 0.22) then return end
	K.setVel(f, Vector3.new(0, 125, 0))
	K.fx("Trail", { m = f.model, c = RED, t = 0.6, k = "zap" })
	if not K.wait(f, tok, 0.42) then K.stopVel(f) return end
	K.setVel(f, Vector3.new(0, 0, 0))
	K.anim(f, "hover")
	local point = K.aimPoint(f, aim, 70, 30)
	K.fx("Warn", { p = point, r = 24, c = RED, t = 0.75 })
	if not K.wait(f, tok, 0.45) then K.stopVel(f) return end
	K.anim(f, "dive")
	local t0 = os.clock()
	while os.clock() - t0 < 0.9 do
		local d = point + Vector3.new(0, 3, 0) - f.root.Position
		if d.Magnitude < 6 then break end
		K.setVel(f, d.Unit * 230)
		task.wait()
		if not F.alive(f) then return end
	end
	K.stopVel(f)
	K.teleport(f, point + Vector3.new(0, 3, 0), K.dir(f, aim))
	K.anim(f, "land")
	K.radiusHit(f, point, 24, function(t)
		local dist = (t.root.Position - point).Magnitude
		local k = 1 - math.clamp(dist / 24, 0, 1) * 0.55
		return { damage = 30 * k, stun = 1.5, guardBreak = true, heavy = true, fx = "heavy", knockback = K.knock(f, t, 110 * k, 62),
			ragdoll = 2, kbTime = 0.25, shake = 2, hitstop = 0.15 }
	end, {})
	K.fx("Explosion", { p = point, r = 24, c = RED, c2 = GOLD })
	K.fx("Crater", { p = point, r = 18, c = RED })
	K.breakAt(point, 24, 2)
	K.shake(point, 2.6, 180)
	K.wait(f, tok, 0.6)
	K.finish(f, tok)
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">Thunderer</string><ProtectedString name="Source"><![CDATA[-- Громовержец: шаги молнии, цепная молния, громовой хлопок, рельсотрон; «Буря» и Небесный Суд.
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("Thunderer")
local BLUE, YELLOW = DEF.Color, DEF.Accent

local M = {}

-- шаг молнии: почти мгновенный рывок, бьёт всех на пути
local function step(K, f, tok, dir, dist, dmg)
	local C = K.Combat
	local start = f.root.Position
	K.fx("Afterimage", { m = f.model, c = BLUE })
	K.dash(f, tok, dir, 230, dist / 230, { contact = 3.6, stop = false, onContact = function(t)
		C.hit(f, t, { damage = dmg, stun = 0.95, fx = "zap", knockback = dir * 8 + Vector3.new(0, 6, 0), kbTime = 0.08, hitstop = 0.05 })
	end })
	K.fx("Bolt", { a = start + Vector3.new(0, 0.5, 0), b = f.root.Position + Vector3.new(0, 0.5, 0), c = BLUE, c2 = YELLOW, w = 0.5 })
	K.sound("Zap", f.root.Position)
end

function M.FlashStep(K, f, aim, def)
	local tok = K.start(f, def.Id, 0.45, 0)
	K.anim(f, "rush")
	step(K, f, tok, K.dir(f, aim), 28, 7)
	K.stopAnim(f)
	K.wait(f, tok, 0.15)
	K.finish(f, tok)
end

function M.StormSteps(K, f, aim, def)
	local F = K.Fighters
	local tok = K.start(f, def.Id, 1.2, 0)
	K.anim(f, "rush")
	for i = 1, 3 do
		local t = K.target(f, aim, 40, 0)
		local dir = K.dir(f, aim)
		local dist = 24
		if t and F.alive(t) then
			local d = t.root.Position - f.root.Position
			dir = K.Util.flat(d, dir)
			dist = math.clamp(Vector3.new(d.X, 0, d.Z).Magnitude + 5, 8, 34)
		end
		step(K, f, tok, dir, dist, 6)
		if not K.wait(f, tok, 0.14) then return end
	end
	K.stopAnim(f)
	K.finish(f, tok)
end

-- цепная молния
function M.ChainLightning(K, f, aim, def)
	local C, F, H = K.Combat, K.Fighters, K.Hitbox
	local tok = K.start(f, def.Id, 0.6, 4)
	K.anim(f, "point")
	K.fx("Charge", { m = f.model, c = BLUE, t = 0.16, k = "zap", hand = "R" })
	if not K.wait(f, tok, 0.16) then return end
	local first = K.target(f, aim, 50, 0.4)
	local from = f.root.Position + K.dir(f, aim) * 2 + Vector3.new(0, 1, 0)
	if not first then
		K.fx("Bolt", { a = from, b = from + K.dir(f, aim) * 30, c = BLUE, c2 = YELLOW, w = 0.6 })
		K.sound("Zap", from)
		K.wait(f, tok, 0.2)
		K.finish(f, tok)
		return
	end
	local dmgs = { 10, 8, 6, 4 }
	local hit = { [f] = true }
	local cur = first
	local prev = from
	for i = 1, 4 do
		if not cur then break end
		hit[cur] = true
		K.fx("Bolt", { a = prev, b = cur.root.Position, c = BLUE, c2 = YELLOW, w = 0.7 })
		K.sound("Zap", cur.root.Position)
		C.hit(f, cur, { damage = dmgs[i], stun = 0.9, fx = "zap", knockback = Vector3.new(0, 8, 0), kbTime = 0.08, hitstop = 0.04 })
		prev = cur.root.Position
		local nxt = H.nearest(prev, 20, hit)
		cur = nxt
		task.wait(0.08)
		if not F.alive(f) then break end
	end
	K.wait(f, tok, 0.2)
	K.finish(f, tok)
end

-- хлопок: долгое оглушение вокруг
function M.ThunderClap(K, f, aim, def)
	local tok = K.start(f, def.Id, 0.8, 0)
	K.anim(f, "clap")
	if not K.wait(f, tok, 0.23) then return end
	local pos = f.root.Position
	K.fx("Shock", { p = pos, c = BLUE, c2 = YELLOW, r = 12, k = "zap" })
	K.sound("Thunder", pos)
	K.radiusHit(f, pos, 12, function(t)
		return { damage = 9, stun = 1.5, fx = "zap", knockback = K.knock(f, t, 22, 12), kbTime = 0.12, hitstop = 0.08, shake = 0.6 }
	end, {})
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- рельсотрон
function M.Railgun(K, f, aim, def)
	local tok = K.start(f, def.Id, 1.5, 3)
	K.anim(f, "charge")
	K.fx("Charge", { m = f.model, c = BLUE, t = 0.6, k = "zap", big = true })
	K.sound("Charge", nil, f.model)
	if not K.wait(f, tok, 0.6) then return end
	K.anim(f, "point")
	local dir = K.dir(f, aim)
	local a = f.root.Position + dir * 2 + Vector3.new(0, 0.8, 0)
	local hitWall = K.Util.mapRay(a, dir * 140)
	local b = hitWall and hitWall.Position or (a + dir * 140)
	K.fx("Beam", { a = a, b = b, c = BLUE, c2 = YELLOW, w = 3.5, t = 0.45, k = "zap" })
	K.sound("Thunder", a)
	K.shake(a, 1, 70)
	K.segmentHit(f, a, b, 4.5, function(t)
		return { damage = 20, stun = 1.1, heavy = true, fx = "zap", knockback = dir * 72 + Vector3.new(0, 28, 0), ragdoll = 1.4, kbTime = 0.22,
			guardBreak = true, hitstop = 0.1, shake = 1 }
	end, {})
	K.breakAt(b, 6, 1.2)
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

-- удар молнии с неба по всем вокруг
function M.Thunderbolt(K, f, aim, def)
	local C, H = K.Combat, K.Hitbox
	local tok = K.start(f, def.Id, 0.9, 0)
	K.anim(f, "rise")
	local targets = H.radius(f.root.Position, 35, { [f] = true })
	for _, t in ipairs(targets) do K.fx("Warn", { p = K.ground(t.root.Position), r = 5, c = YELLOW, t = 0.45 }) end
	if not K.wait(f, tok, 0.45) then return end
	for _, t in ipairs(targets) do
		local p = K.ground(t.root.Position)
		K.fx("Strike", { p = p, c = BLUE, c2 = YELLOW })
		K.sound("Thunder", p)
		C.hit(f, t, { damage = 14, stun = 1.1, heavy = true, fx = "zap", knockback = Vector3.new(0, 30, 0), ragdoll = 0.9, kbTime = 0.15, hitstop = 0.06 })
	end
	K.stopAnim(f)
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- перегрузка: разряды вокруг
function M.Overload(K, f, aim, def)
	local tok = K.start(f, def.Id, 1.4, 0)
	K.armor(f, 1.2)
	K.anim(f, "awaken")
	for i = 1, 4 do
		if not K.wait(f, tok, 0.22) then return end
		local pos = f.root.Position
		K.fx("Shock", { p = pos, c = BLUE, c2 = YELLOW, r = 16, k = "zap" })
		K.sound("Zap", pos)
		K.radiusHit(f, pos, 16, function(t)
			if i == 4 then
				return { damage = 6, stun = 1, heavy = true, fx = "zap", knockback = K.knock(f, t, 70, 30), ragdoll = 1.2, kbTime = 0.2, hitstop = 0.08 }
			end
			return { damage = 4, stun = 0.7, fx = "zap", knockback = Vector3.new(0, 6, 0), kbTime = 0.06 }
		end, {})
	end
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
end

-- ульта: гроза
function M.Judgment(K, f, aim, def)
	local C, F, H = K.Combat, K.Fighters, K.Hitbox
	local tok = K.start(f, def.Id, 4.2, 0)
	K.iframes(f, 4)
	K.armor(f, 4.2)
	K.fx("Ult", { m = f.model, text = def.Name, c = BLUE, c2 = YELLOW })
	K.anim(f, "rise")
	K.setVel(f, Vector3.new(0, 45, 0))
	if not K.wait(f, tok, 0.45) then K.stopVel(f) return end
	K.setVel(f, Vector3.new(0, 0, 0))
	K.fx("Storm", { p = f.root.Position, r = 60, t = 3.4 })
	for i = 1, 12 do
		local list = H.radius(f.root.Position, 60, { [f] = true })
		local t = list[math.random(1, math.max(1, #list))]
		local p
		if t then
			p = K.ground(t.root.Position + Vector3.new(math.random() * 4 - 2, 0, math.random() * 4 - 2))
		else
			p = K.ground(f.root.Position + Vector3.new(math.random(-40, 40), -20, math.random(-40, 40)))
		end
		K.fx("Warn", { p = p, r = 6, c = YELLOW, t = 0.22 })
		task.wait(0.12)
		K.fx("Strike", { p = p, c = BLUE, c2 = YELLOW })
		K.sound("Thunder", p)
		K.radiusHit(f, p, 6, { damage = 8, stun = 0.9, trueDamage = false, fx = "zap", knockback = Vector3.new(0, 24, 0), kbTime = 0.12, hitstop = 0.04 }, {})
		task.wait(0.13)
		if not K.valid(f, tok) then K.stopVel(f) return end
	end
	local point = K.aimPoint(f, aim, 70, 30)
	K.fx("Warn", { p = point, r = 12, c = YELLOW, t = 0.3 })
	task.wait(0.3)
	K.fx("Strike", { p = point, c = BLUE, c2 = YELLOW, big = true })
	K.fx("Explosion", { p = point, r = 12, c = BLUE, c2 = YELLOW, k = "zap" })
	K.sound("Thunder", point)
	K.shake(point, 2, 140)
	K.radiusHit(f, point, 12, function(t)
		return { damage = 20, stun = 1.4, guardBreak = true, heavy = true, fx = "zap", knockback = K.knock(f, t, 90, 50), ragdoll = 1.8, kbTime = 0.22, hitstop = 0.12, shake = 1.6 }
	end, {})
	K.breakAt(point, 12, 1.5)
	K.stopVel(f)
	K.wait(f, tok, 0.3)
	K.finish(f, tok)
	if F.alive(f) then f.root.AssemblyLinearVelocity = Vector3.zero end
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">VoidLord</string><ProtectedString name="Source"><![CDATA[-- Повелитель Пустоты: притяжение, отторжение, скачок, луч; пробуждение «Безмерность» и территория.
local Characters = require(game:GetService("ReplicatedStorage").Shared.Characters)
local DEF = Characters.get("VoidLord")
local CYAN, VIOLET = DEF.Color, DEF.Accent

local M = {}

-- водоворот пустоты в точке: тянет и бьёт
local function vortex(K, f, pos, p)
	local C, F, H = K.Combat, K.Fighters, K.Hitbox
	K.fx("Vortex", { p = pos, c = CYAN, c2 = VIOLET, r = p.radius, t = p.dur, k = "void" })
	K.sound("Void", pos)
	local t0 = os.clock()
	local nextDmg = 0
	while os.clock() - t0 < p.dur do
		task.wait(0.1)
		if not F.alive(f) then break end
		local el = os.clock() - t0
		for _, t in ipairs(H.radius(pos, p.radius * 1.35, { [f] = true })) do
			local d = pos - t.root.Position
			local flat = Vector3.new(d.X, d.Y * 0.4, d.Z)
			if flat.Magnitude > 1.2 then
				C.knockback(t, flat.Unit * math.min(p.pull, flat.Magnitude * 7), 0.12)
			end
			C.stun(t, 0.35)
		end
		if el >= nextDmg then
			nextDmg = el + 0.25
			K.radiusHit(f, pos, p.radius, { damage = p.tick, stun = 0.35, fx = "void", noCombo = false, knockback = Vector3.zero, kbTime = 0.01 }, {})
		end
	end
	K.fx("Burst", { p = pos, c = VIOLET, r = p.radius * 0.8, k = "void" })
	K.radiusHit(f, pos, p.radius * 0.8, function(t)
		return { damage = p.pop, stun = 0.7, heavy = true, fx = "void", knockback = Vector3.new(0, 34, 0) + (t.root.Position - pos) * 2, ragdoll = 0.9, kbTime = 0.15 }
	end, {})
end

local function attract(K, f, aim, def, p)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.55, 6)
	K.anim(f, "cast_palm")
	K.fx("Charge", { m = f.model, c = CYAN, t = 0.18, k = "void" })
	if not K.wait(f, tok, 0.18) then return end
	K.finish(f, tok)
	local origin = f.root.Position + dir * 3 + Vector3.new(0, 0.5, 0)
	K.projectile(f, {
		from = origin, dir = dir, speed = p.speed, range = p.range, radius = 2.4, kind = "voidorb", color = CYAN, size = p.size,
		onHit = function() return false end,
		onEnd = function(pos) vortex(K, f, pos, p) end,
	})
end

function M.Attract(K, f, aim, def)
	attract(K, f, aim, def, { speed = 58, range = 45, radius = 12, dur = 1.4, pull = 42, tick = 1.6, pop = 5, size = 2 })
end

function M.GravityWell(K, f, aim, def)
	attract(K, f, aim, def, { speed = 50, range = 50, radius = 20, dur = 2.8, pull = 55, tick = 1.8, pop = 8, size = 3.2 })
end

-- отторжение: конус перед собой
function M.Repel(K, f, aim, def)
	local dir = K.dir(f, aim)
	local tok = K.start(f, def.Id, 0.8, 2)
	K.anim(f, "cast_both")
	K.fx("Charge", { m = f.model, c = VIOLET, t = 0.3, k = "void" })
	if not K.wait(f, tok, 0.3) then return end
	K.boxFront(f, dir, 12, 9, 16, function(t)
		return { damage = 10, stun = 1, heavy = true, fx = "void", knockback = K.knock(f, t, 108, 36), ragdoll = 1.6, kbTime = 0.25, shake = 1.2, hitstop = 0.08 }
	end, {})
	K.fx("Cone", { p = f.root.Position + dir * 2, d = dir, c = VIOLET, c2 = CYAN, len = 16, w = 12 })
	K.sound("Void", f.root.Position)
	K.breakAt(f.root.Position + dir * 9, 8, 1)
	K.shake(f.root.Position, 0.9, 60)
	K.wait(f, tok, 0.35)
	K.finish(f, tok)
end

-- сверхновая: взрыв во все стороны
function M.Supernova(K, f, aim, def)
	local tok = K.start(f, def.Id, 1.0, 0)
	K.armor(f, 0.7)
	K.anim(f, "awaken")
	K.fx("Charge", { m = f.model, c = VIOLET, t = 0.45, k = "void" })
	if not K.wait(f, tok, 0.45) then return end
	local pos = f.root.Position
	K.radiusHit(f, pos, 18, function(t)
		return { damage = 14, stun = 1.1, heavy = true, fx = "void", knockback = K.knock(f, t, 112, 40), ragdoll = 1.6, kbTime = 0.25, shake = 1.4, hitstop = 0.1 }
	end, {})
	K.fx("Explosion", { p = pos, r = 18, c = VIOLET, c2 = CYAN, k = "void" })
	K.breakAt(pos, 18, 1.5)
	K.shake(pos, 1.6, 90)
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

-- скачок за спину
local function blinkTo(K, f, target, aim)
	local from = f.root.Position
	K.fx("Afterimage", { m = f.model, c = CYAN })
	K.sound("Teleport", from)
	if target then
		local behind = target.root.Position - target.root.CFrame.LookVector * 3.6
		behind = K.safePoint(target.root.Position, behind)
		K.teleport(f, behind, target.root.Position - behind)
		K.fx("Blink", { a = from, b = behind, c = CYAN })
		return true
	end
	local dest = K.safePoint(from, from + K.dir(f, aim) * 25)
	K.teleport(f, dest, K.dir(f, aim))
	K.fx("Blink", { a = from, b = dest, c = CYAN })
	return false
end

function M.Blink(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 0.65, 0)
	local t = K.target(f, aim, 45, 0.3)
	if blinkTo(K, f, t, aim) then
		K.anim(f, "kick_front")
		if not K.wait(f, tok, 0.13) then return end
		C.hit(f, t, { damage = 7, stun = 1, fx = "void", knockback = K.knock(f, t, 40, 32), ragdoll = 0.9, kbTime = 0.15, hitstop = 0.06 })
	end
	K.wait(f, tok, 0.25)
	K.finish(f, tok)
end

function M.Distortion(K, f, aim, def)
	local C, F = K.Combat, K.Fighters
	local tok = K.start(f, def.Id, 1.6, 0)
	local t = K.target(f, aim, 50, 0.2)
	for i = 1, 3 do
		if t and not F.alive(t) then t = nil end
		if not blinkTo(K, f, t, aim) then break end
		K.anim(f, i == 3 and "kick_front" or (i % 2 == 1 and "m1_p1" or "m1_p2"))
		if not K.wait(f, tok, 0.12) then return end
		if i < 3 then
			C.hit(f, t, { damage = 5, stun = 1, fx = "void", knockback = Vector3.new(0, 14, 0), kbTime = 0.1, hitstop = 0.05 })
		else
			C.hit(f, t, { damage = 7, stun = 1, heavy = true, fx = "void", knockback = K.knock(f, t, 60, 55), ragdoll = 1.3, kbTime = 0.2, hitstop = 0.09, shake = 0.8 })
		end
		if not K.wait(f, tok, 0.16) then return end
	end
	K.finish(f, tok)
end

-- луч пустоты
function M.VoidBeam(K, f, aim, def)
	local tok = K.start(f, def.Id, 1.9, 2)
	K.anim(f, "charge")
	K.fx("Charge", { m = f.model, c = VIOLET, t = 0.8, k = "void", big = true })
	K.sound("Charge", nil, f.model)
	if not K.wait(f, tok, 0.8) then return end
	K.anim(f, "beam")
	local dir = K.dir(f, aim)
	local a = f.root.Position + dir * 2 + Vector3.new(0, 0.6, 0)
	local b = a + dir * 120
	K.fx("Beam", { a = a, b = b, c = VIOLET, c2 = CYAN, w = 6, t = 0.7, k = "void" })
	K.sound("Beam", a)
	K.shake(a, 1.2, 90)
	K.segmentHit(f, a, b, 7, function(t)
		return { damage = 22, stun = 1.2, heavy = true, fx = "void", knockback = dir * 78 + Vector3.new(0, 30, 0), ragdoll = 1.5, kbTime = 0.22,
			guardBreak = true, shake = 1.2, hitstop = 0.1 }
	end, {})
	for i = 1, 6 do K.breakAt(a + dir * (i * 20), 7, 1.5) end
	K.wait(f, tok, 0.6)
	K.finish(f, tok)
end

-- территория: Горизонт Событий
function M.EventHorizon(K, f, aim, def)
	local C = K.Combat
	local tok = K.start(f, def.Id, 1.7, 0)
	K.iframes(f, 1.6)
	K.anim(f, "sign")
	K.fx("Ult", { m = f.model, text = def.Name, c = VIOLET, c2 = CYAN, domain = true })
	if not K.wait(f, tok, 1.15) then return end
	K.Domains.open(f, {
		style = "void", name = def.Name, radius = 42, duration = 9, tick = 0.5, slow = 0.35,
		onTick = function(d, victims)
			for _, v in ipairs(victims) do
				C.hit(f, v, { damage = 3, stun = 0.4, trueDamage = true, fx = "void", knockback = Vector3.zero, kbTime = 0.01 })
			end
		end,
	})
	K.wait(f, tok, 0.4)
	K.finish(f, tok)
end

return M
]]></ProtectedString></Properties></Item>
</Item>
</Item>
