local cineSub = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.945, 0), Size = UDim2.new(0.6, 0, 0.045, 0), BackgroundTransparency = 1, Font = FONT, TextScaled = true,
