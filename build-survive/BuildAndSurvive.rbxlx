    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Client</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">BuildController</string>
          <string name="Source"><![CDATA[-- Строительство на клиенте: «призрак» блока под курсором, установка, удаление, покраска,
-- пипетка, повороты. Всё проверяется ещё раз на сервере.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local BlockFactory = require(Shared.BlockFactory)
local Grid = require(Shared.Grid)
local MapLayout = require(Shared.MapLayout)
local Net = require(Shared.Net)

local Client = script.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local HUD = require(Client.UI.HUD)

local BuildController = {}

local player = Players.LocalPlayer
local ghost: Model? = nil
local ghostKey = ""
local ghostHighlight: Highlight
local hoverHighlight: Highlight
local ghostCF: CFrame? = nil
local ghostValid = false
local ghostCenter: Vector3? = nil
local hovered: BasePart? = nil
local holding = false
local lastHoldPlace = 0
local lastPlacedCenter: Vector3? = nil
local inFlight = 0
local touchPos: Vector2? = nil
local gridGui: SurfaceGui? = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local HINTS = {
	build = "ЛКМ — поставить (держи, чтобы ставить подряд)  •  R — повернуть  •  T — наклонить  •  Q — пипетка  •  Ctrl+Z — отмена",
	delete = "Кликай по блокам, чтобы удалить (можно держать)  •  Ctrl+Z — вернуть",
	paint = "Кликай по блокам, чтобы покрасить  •  цвет — в панели слева",
	pick = "Кликни по блоку — скопируешь материал, форму, размер, поворот и цвет",
}

local function myPlot(): (Model?, CFrame?)
	local idx = player:GetAttribute("Plot")
	if not idx then
		return nil, nil
	end
	local plots = workspace:FindFirstChild("Plots")
	local model = plots and plots:FindFirstChild("Plot" .. idx) :: Model?
	local layout = MapLayout.Plots[idx]
	return model, layout and layout.cf
end

local function canBuildNow(): boolean
	return not State.inSiege() and not State.launched and State.modal == nil
end

-- ПРИЗРАК ---------------------------------------------------------------------------
local function destroyGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	ghostKey = ""
	ghostCF = nil
end

local function ensureGhost()
	local spec = State.spec()
	local key = string.format("%d:%d:%d:%s:%d:%s", spec.mat, spec.shape, spec.item, tostring(spec.size), spec.rot, spec.color:ToHex())
	if ghost and key == ghostKey then
		return
	end
	local keepCF = ghostCF
	destroyGhost()
	ghostKey = key
	local m = Instance.new("Model")
	m.Name = "BuildGhost"
	local part = BlockFactory.build(spec, CFrame.identity * Grid.Rotations[spec.rot], { ghost = true })
	for _, p in BlockFactory.allParts(part) do
		p.Transparency = math.max(p.Transparency, 0) + (1 - p.Transparency) * 0.45
	end
	part.Parent = m
	m.PrimaryPart = part
	m.Parent = workspace
	ghostHighlight.Adornee = m
	ghost = m
	ghostCF = keepCF
end

local function setGhostValid(valid: boolean)
	ghostValid = valid
	ghostHighlight.OutlineColor = valid and Color3.fromRGB(90, 255, 140) or Color3.fromRGB(255, 70, 70)
	ghostHighlight.FillColor = valid and Color3.fromRGB(90, 255, 140) or Color3.fromRGB(255, 60, 60)
end

local function screenRay(): Ray?
	local cam = workspace.CurrentCamera
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		if not touchPos then
			return nil
		end
		return cam:ScreenPointToRay(touchPos.X, touchPos.Y)
	end
	local m = UserInputService:GetMouseLocation()
	return cam:ViewportPointToRay(m.X, m.Y)
end

local function castBuild(model: Model): RaycastResult?
	local ray = screenRay()
	if not ray then
		return nil
	end
	local base = model:FindFirstChild("Base")
	local blocks = model:FindFirstChild("Blocks")
	rayParams.FilterDescendantsInstances = { base :: Instance, blocks :: Instance }
	return workspace:Raycast(ray.Origin, ray.Direction * 600, rayParams)
end

local function blockFromHit(hit: RaycastResult?, model: Model): BasePart?
	if not hit then
		return nil
	end
	local inst = hit.Instance
	if inst:IsA("BasePart") and inst.Name == "Block" and inst.Parent == model:FindFirstChild("Blocks") then
		return inst
	end
	return nil
end

local function overlapsClient(model: Model, cf: CFrame, size: Vector3): boolean
	local blocks = model:FindFirstChild("Blocks")
	if not blocks then
		return false
	end
	overlap.FilterDescendantsInstances = { blocks }
	local hits = workspace:GetPartBoundsInBox(cf, size - Vector3.new(0.12, 0.12, 0.12), overlap)
	for _, h in hits do
		if h.Name == "Block" then
			return true
		end
	end
	return false
end

-- ДЕЙСТВИЯ --------------------------------------------------------------------------
local function invoke(name: string, okSound: string?, ...: any)
	if inFlight > 4 then
		return
	end
	inFlight += 1
	local args = { ... }
	task.spawn(function()
		local ok, msg = Net.func(name):InvokeServer(table.unpack(args))
		inFlight -= 1
		if ok then
			if okSound then
				SoundPlayer.play(okSound, { speed = 0.92 + math.random() * 0.16 })
			end
		elseif msg then
			HUD.toast(msg, "error")
		end
	end)
end

local function place()
	if not (ghost and ghostValid and ghostCenter) then
		return
	end
	local spec = State.spec()
	lastPlacedCenter = ghostCenter
	invoke("Place", "Place", {
		mat = spec.mat,
		shape = spec.shape,
		item = spec.item,
		pos = ghostCenter,
		size = spec.size,
		rot = spec.rot,
		color = spec.color,
	})
	-- маленький «пульс» призрака
	if ghost and ghost.PrimaryPart then
		local p = ghost.PrimaryPart
		ghostHighlight.FillTransparency = 0.35
		task.delay(0.08, function()
			ghostHighlight.FillTransparency = 0.82
		end)
		p.Transparency = p.Transparency
	end
end

local function pick(block: BasePart)
	local item = block:GetAttribute("Item") or 0
	local sel = State.sel
	if item > 0 then
		sel.kind = "item"
		sel.id = item
	else
		sel.kind = "mat"
		sel.id = block:GetAttribute("Mat") or 1
		sel.shape = block:GetAttribute("Shape") or 1
	end
	sel.size = block:GetAttribute("BlockSize") or block.Size
	sel.rot = block:GetAttribute("Rot") or 1
	sel.color = block:GetAttribute("BaseColor") or block.Color
	sel.customColor = true
	if not State.isUnlocked(sel.kind, sel.id) then
		HUD.toast("Этот блок ещё не куплен", "warning")
	end
	State.changed:Fire("sel", sel)
	BuildController.setTool("build")
	SoundPlayer.play("Click")
end

local function actOnHovered()
	local b = hovered
	if not b then
		return
	end
	if State.tool == "delete" then
		hovered = nil
		invoke("Delete", "Remove", b)
	elseif State.tool == "paint" then
		local c = State.sel.color
		if (b:GetAttribute("BaseColor") or b.Color) ~= c then
			invoke("Paint", "Paint", b, c)
		end
	elseif State.tool == "pick" then
		pick(b)
	end
end

-- СЕТКА НА УЧАСТКЕ ------------------------------------------------------------------
local function buildGrid(model: Model)
	if gridGui then
		gridGui:Destroy()
		gridGui = nil
	end
	local base = model:FindFirstChild("Base") :: BasePart?
	if not base then
		return
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "BuildGrid"
	g.Face = Enum.NormalId.Top
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 16
	g.LightInfluence = 0.6
	g.Adornee = base
	local n = Config.PlotSize.X
	for i = 0, n, 2 do
		local major = i % 8 == 0
		for _, vertical in { true, false } do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = major and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 44, 52)
			f.BackgroundTransparency = major and 0.72 or 0.8
			local w = major and 3 or 2
			if vertical then
				f.Size = UDim2.new(0, w, 1, 0)
				f.Position = UDim2.new(i / n, -w / 2, 0, 0)
			else
				f.Size = UDim2.new(1, 0, 0, w)
				f.Position = UDim2.new(0, 0, i / n, -w / 2)
			end
			f.Parent = g
		end
	end
	g.Enabled = false
	g.Parent = player:WaitForChild("PlayerGui")
	gridGui = g
end

-- ИНСТРУМЕНТЫ ------------------------------------------------------------------------
function BuildController.setTool(tool: string?)
	if (State.inSiege() or State.launched) and tool ~= nil then
		HUD.toast(State.launched and "Сначала останови испытание" or "Во время осады строить нельзя", "warning")
		tool = nil
	end
	State.set("tool", tool)
	HUD.setTool(tool)
	HUD.setHint(tool and HINTS[tool] or "")
	if tool ~= "build" then
		destroyGhost()
	end
	hovered = nil
	hoverHighlight.Adornee = nil
end

local function update(dt: number)
	local model, plotCF = myPlot()
	local tool = State.tool
	if gridGui then
		gridGui.Enabled = tool == "build" and State.settings.ShowGrid == true and canBuildNow()
	end
	if not model or not plotCF or not tool or not canBuildNow() then
		destroyGhost()
		hoverHighlight.Adornee = nil
		hovered = nil
		return
	end
	local hit = castBuild(model)
	if tool == "build" then
		hoverHighlight.Adornee = nil
		if not hit then
			if ghost then
				ghost.Parent = nil
			end
			ghostCenter = nil
			return
		end
		ensureGhost()
		local g = ghost :: Model
		g.Parent = workspace
		local spec = State.spec()
		local center = Grid.placement(plotCF, hit.Position, hit.Normal, spec.size, spec.rot)
		local e = Grid.extents(spec.size, spec.rot)
		local cf = Grid.worldCFrame(plotCF, center, spec.rot)
		ghostCenter = center
		local valid = Grid.inBounds(center, e) and not overlapsClient(model, cf, spec.size)
		setGhostValid(valid)
		-- плавное движение призрака
		if not ghostCF or (ghostCF.Position - cf.Position).Magnitude > 30 then
			ghostCF = cf
		else
			ghostCF = (ghostCF :: CFrame):Lerp(cf, math.clamp(dt * 22, 0, 1))
		end
		g:PivotTo(ghostCF :: CFrame)
		-- зажатая кнопка: ставим новые блоки, когда курсор переходит в новую клетку
		if holding and ghostValid and os.clock() - lastHoldPlace > Config.HoldRepeat and center ~= lastPlacedCenter then
			lastHoldPlace = os.clock()
			place()
		end
	else
		local b = blockFromHit(hit, model)
		hovered = b
		hoverHighlight.Adornee = b
		if b then
			local colors = {
				delete = Color3.fromRGB(255, 70, 70),
				paint = State.sel.color,
				pick = Color3.fromRGB(255, 220, 90),
			}
			hoverHighlight.OutlineColor = colors[tool] or Color3.new(1, 1, 1)
			hoverHighlight.FillColor = colors[tool] or Color3.new(1, 1, 1)
		end
		if holding and tool ~= "pick" and os.clock() - lastHoldPlace > 0.12 then
			lastHoldPlace = os.clock()
			actOnHovered()
		end
	end
end

function BuildController.init()
	-- подсветки лежат в пустой папке: без Adornee они ничего не подсвечивают
	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "BuildFx"
	fxFolder.Parent = workspace
	ghostHighlight = Instance.new("Highlight")
	ghostHighlight.FillTransparency = 0.82
	ghostHighlight.OutlineTransparency = 0
	ghostHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	ghostHighlight.Parent = fxFolder
	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.FillTransparency = 0.6
	hoverHighlight.OutlineTransparency = 0
	hoverHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hoverHighlight.Parent = fxFolder
	setGhostValid(true)

	local function onPlot()
		local model = myPlot()
		if model then
			buildGrid(model)
		end
	end
	player:GetAttributeChangedSignal("Plot"):Connect(onPlot)
	onPlot()

	HUD.onTool:Connect(function(tool)
		BuildController.setTool(tool)
	end)
	HUD.onUndo:Connect(function()
		invoke("Undo", "Remove")
	end)
	State.changed:Connect(function(key)
		if key == "siege" or key == "launched" then
			if State.inSiege() or State.launched then
				BuildController.setTool(nil)
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local kc = input.KeyCode
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
			if kc == Enum.KeyCode.Z and ctrl then
				invoke("Undo", "Remove")
			elseif kc == Enum.KeyCode.One then
				BuildController.setTool(if State.tool == "build" then nil else "build")
			elseif kc == Enum.KeyCode.Two then
				BuildController.setTool(if State.tool == "delete" then nil else "delete")
			elseif kc == Enum.KeyCode.Three then
				BuildController.setTool(if State.tool == "paint" then nil else "paint")
			elseif kc == Enum.KeyCode.Four then
				BuildController.setTool(if State.tool == "pick" then nil else "pick")
			elseif kc == Enum.KeyCode.R and State.tool == "build" then
				local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
				State.sel.rot = Grid.rotate(State.sel.rot, shift and "Z" or "Y")
				State.changed:Fire("sel", State.sel)
				SoundPlayer.play("Hover")
			elseif kc == Enum.KeyCode.T and State.tool == "build" then
				State.sel.rot = Grid.rotate(State.sel.rot, "X")
				State.changed:Fire("sel", State.sel)
				SoundPlayer.play("Hover")
			elseif kc == Enum.KeyCode.Q and State.tool == "build" then
				local model = myPlot()
				local b = model and blockFromHit(castBuild(model), model)
				if b then
					pick(b)
				end
			elseif kc == Enum.KeyCode.Escape and not State.modal then
				BuildController.setTool(nil)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not State.tool or not canBuildNow() then
				return
			end
			holding = true
			lastHoldPlace = os.clock()
			if State.tool == "build" then
				lastPlacedCenter = nil
				place()
			else
				actOnHovered()
			end
		elseif input.UserInputType == Enum.UserInputType.Touch then
			touchPos = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = false
		end
	end)
	-- на телефоне: короткое касание = клик
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or not State.tool or not canBuildNow() then
			return
		end
		local p = positions[1]
		touchPos = Vector2.new(p.X, p.Y)
		task.defer(function()
			update(1)
			if State.tool == "build" then
				place()
			else
				actOnHovered()
			end
		end)
	end)

	RunService.RenderStepped:Connect(update)
end

return BuildController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">CameraShake</string>
          <string name="Source"><![CDATA[-- Тряска камеры от взрывов. Несколько толчков складываются и плавно затухают.
-- Смещение снимается перед работой стандартной камеры, чтобы взгляд не «уплывал».
local RunService = game:GetService("RunService")

local CameraShake = {}

type Shake = { amp: number, dur: number, t: number, freq: number, seed: number }
local shakes: { Shake } = {}
local applied = CFrame.identity
CameraShake.enabled = true

-- amp — сила в градусах, dur — длительность в секундах
function CameraShake.shake(amp: number, dur: number, freq: number?)
	if not CameraShake.enabled or amp <= 0.01 then
		return
	end
	table.insert(shakes, { amp = math.min(amp, 9), dur = dur, t = 0, freq = freq or 18, seed = math.random() * 100 })
end

function CameraShake.init()
	RunService:BindToRenderStep("BuildSurviveShakeUndo", Enum.RenderPriority.Camera.Value - 1, function()
		if applied ~= CFrame.identity then
			local cam = workspace.CurrentCamera
			cam.CFrame = cam.CFrame * applied:Inverse()
			applied = CFrame.identity
		end
	end)
	RunService:BindToRenderStep("BuildSurviveShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if #shakes == 0 then
			return
		end
		local rx, ry, rz = 0, 0, 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			s.t += dt
			if s.t >= s.dur then
				table.remove(shakes, i)
			else
				local k = (1 - s.t / s.dur) ^ 2 * s.amp
				local x = s.t * s.freq + s.seed
				rx += math.noise(x, 0.5, 0) * k
				ry += math.noise(0.5, x, 0) * k
				rz += math.noise(0, 0.5, x) * k * 0.5
			end
		end
		applied = CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * applied
	end)
end

return CameraShake
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Fx</string>
          <string name="Source"><![CDATA[-- Визуальные эффекты: взрывы, искры, ударные волны, ядерный гриб, орбитальный лазер,
-- бомбардировщик, предупреждающие круги, щиты, выстрелы ПВО.
-- Используются только встроенные текстуры Roblox (rbxasset://), поэтому всё работает сразу.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local Client = script.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local CameraShake = require(Client.CameraShake)
local HUD = require(Client.UI.HUD)

local Fx = {}

local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder: Folder
local rng = Random.new()
local lastBulletSound = 0

local function quality(): number
	return State.settings.Graphics or 3
end

local function qmul(): number
	local q = quality()
	return q == 1 and 0.35 or (q == 2 and 0.65 or 1)
end

local function tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	if not props.Parent then
		p.Parent = folder
	end
	return p
end

local function ns(points: { { number } }): NumberSequence
	local kps = {}
	for _, pt in points do
		table.insert(kps, NumberSequenceKeypoint.new(pt[1], pt[2]))
	end
	return NumberSequence.new(kps)
end

local function cs(points: { { any } }): ColorSequence
	local kps = {}
	for _, pt in points do
		table.insert(kps, ColorSequenceKeypoint.new(pt[1], pt[2]))
	end
	return ColorSequence.new(kps)
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightInfluence = 0
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- Точка с прикреплением, к которой цепляются частицы
local function holderAt(pos: Vector3, life: number): (Part, Attachment)
	local h = part({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos) })
	local a = Instance.new("Attachment")
	a.Parent = h
	Debris:AddItem(h, life)
	return h, a
end

local function camDistance(pos: Vector3): number
	return (workspace.CurrentCamera.CFrame.Position - pos).Magnitude
end

local function soundDelay(pos: Vector3): number
	return math.min(camDistance(pos) / Sounds.SpeedOfSound, 3)
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundBelow(pos: Vector3, depth: number): RaycastResult?
	local list: { Instance } = { folder }
	local debris = workspace:FindFirstChild("Debris")
	if debris then
		table.insert(list, debris)
	end
	for _, p in game:GetService("Players"):GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
	return workspace:Raycast(pos + Vector3.new(0, 1, 0), Vector3.new(0, -depth - 1, 0), groundParams)
end

local function scorch(pos: Vector3, radius: number)
	if quality() == 1 then
		return
	end
	local hit = groundBelow(pos, radius * 0.8 + 2)
	if not hit or hit.Material == Enum.Material.Water then
		return
	end
	local d = radius * 1.3
	local cf = CFrame.lookAt(hit.Position, hit.Position + hit.Normal) * CFrame.Angles(0, math.pi / 2, 0)
	local mark = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.06, d, d),
		CFrame = cf * CFrame.new(-0.02, 0, 0),
		Color = Color3.fromRGB(24, 20, 18),
		Material = Enum.Material.Ground,
		Transparency = 0.15,
	})
	task.delay(12, function()
		tween(mark, 10, { Transparency = 1 })
	end)
	Debris:AddItem(mark, 23)
end

local function chunks(pos: Vector3, count: number, speed: number, color: Color3?)
	count = math.floor(count * qmul())
	for _ = 1, count do
		local s = rng:NextNumber(0.4, 1.3)
		local c = part({
			Size = Vector3.new(s, s * rng:NextNumber(0.5, 1), s),
			CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0),
			Color = color or Color3.fromRGB(60, 56, 52),
			Material = Enum.Material.Slate,
			Anchored = false,
			CanCollide = true,
			CastShadow = true,
		})
		c.CollisionGroup = "Debris"
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.4, 1.4), rng:NextNumber(-1, 1)).Unit
		c.AssemblyLinearVelocity = dir * speed * rng:NextNumber(0.5, 1.1)
		c.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-10, 10))
		task.delay(2.5, function()
			tween(c, 0.8, { Transparency = 1 })
		end)
		Debris:AddItem(c, 3.4)
	end
end

local function ring(pos: Vector3, from: number, to: number, time: number, color: Color3, transparency: number)
	local r = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, from, from),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = transparency,
	})
	tween(r, time, { Size = Vector3.new(0.2, to, to), Transparency = 1 })
	Debris:AddItem(r, time + 0.1)
end

-- ВЗРЫВЫ ----------------------------------------------------------------------------
local SIZES = {
	Small = { sound = "ExplosionSmall", shake = 0.5 },
	Medium = { sound = "ExplosionMedium", shake = 0.9 },
	Large = { sound = "ExplosionLarge", shake = 1.6 },
	Huge = { sound = "ExplosionHuge", shake = 2.6 },
}

export type ExplosionOpts = { water: boolean?, air: boolean?, aa: boolean?, shake: number? }

function Fx.explosion(size: string, pos: Vector3, R: number, o: ExplosionOpts?)
	local opts: ExplosionOpts = o or {}
	local info = SIZES[size] or SIZES.Medium
	local m = qmul()
	local life = 8
	local holder, att = holderAt(pos, life)

	-- вспышка
	local flash = part({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 232, 180),
		Size = Vector3.one * R * 0.4,
		CFrame = CFrame.new(pos),
	})
	tween(flash, 0.22, { Size = Vector3.one * R * 1.9, Transparency = 1 })
	Debris:AddItem(flash, 0.3)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = math.min(60, R * 5)
	light.Brightness = 12
	light.Shadows = quality() == 3
	light.Parent = holder
	tween(light, 0.8, { Brightness = 0 })

	if opts.water then
		-- столб воды
		local splash = emitter(att, {
			Texture = SMOKE,
			LightInfluence = 1,
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(14, 14),
			Speed = NumberRange.new(R * 2.5, R * 5),
			Acceleration = Vector3.new(0, -90, 0),
			Lifetime = NumberRange.new(0.8, 1.6),
			Size = ns({ { 0, R * 0.25 }, { 1, R * 0.8 } }),
			Color = cs({ { 0, Color3.fromRGB(240, 248, 255) }, { 1, Color3.fromRGB(200, 220, 230) } }),
			Transparency = ns({ { 0, 0.15 }, { 1, 1 } }),
		})
		splash:Emit(math.floor((14 + R * 2) * m))
		ring(pos + Vector3.new(0, 0.3, 0), R * 0.5, R * 3, 0.9, Color3.fromRGB(220, 240, 255), 0.4)
		SoundPlayer.play("Splash", { position = pos, delay = soundDelay(pos) })
	end

	local fire = emitter(att, {
		Texture = FIRE,
		LightEmission = 0.9,
		Speed = NumberRange.new(R * 1.2, R * 3),
		Drag = 5,
		Lifetime = NumberRange.new(0.35, 0.85),
		Size = ns({ { 0, R * 0.35 }, { 0.35, R * 0.8 }, { 1, R * 0.25 } }),
		Color = cs({ { 0, Color3.fromRGB(255, 244, 200) }, { 0.3, Color3.fromRGB(255, 150, 50) }, { 1, Color3.fromRGB(110, 40, 20) } }),
		Transparency = ns({ { 0, 0.05 }, { 0.7, 0.45 }, { 1, 1 } }),
		ZOffset = 1,
	})
	fire:Emit(math.floor((10 + R * 2.2) * m))

	local smoke = emitter(att, {
		Texture = SMOKE,
		LightInfluence = 1,
		Speed = NumberRange.new(R * 0.4, R * 1.2),
		Drag = 1.6,
		Lifetime = NumberRange.new(2.5, 5),
		Acceleration = Vector3.new(0, R * 0.25 + 2, 0),
		Size = ns({ { 0, R * 0.45 }, { 1, R * 1.5 } }),
		Color = cs({ { 0, Color3.fromRGB(78, 72, 66) }, { 1, Color3.fromRGB(46, 44, 42) } }),
		Transparency = ns({ { 0, 0.15 }, { 0.6, 0.5 }, { 1, 1 } }),
	})
	smoke:Emit(math.floor((6 + R * 1.2) * m))

	local sparks = emitter(att, {
		Texture = SPARK,
		LightEmission = 1,
		Speed = NumberRange.new(R * 3, R * 7),
		Acceleration = Vector3.new(0, -80, 0),
		Drag = 1,
		Lifetime = NumberRange.new(0.5, 1.4),
		Size = ns({ { 0, R * 0.06 + 0.25 }, { 1, 0 } }),
		Color = cs({ { 0, Color3.fromRGB(255, 236, 150) }, { 1, Color3.fromRGB(255, 110, 40) } }),
	})
	sparks:Emit(math.floor((8 + R * 2) * m))

	if size ~= "Small" and not opts.air then
		ring(pos, R * 0.5, R * 3.2, 0.5, Color3.fromRGB(255, 210, 160), 0.55)
	end
	if (size == "Large" or size == "Huge") and not opts.water then
		chunks(pos, size == "Huge" and 18 or 9, R * 3)
	end
	if not opts.air and not opts.water then
		scorch(pos, R)
	end
	SoundPlayer.play(info.sound, { position = pos, delay = soundDelay(pos), speed = rng:NextNumber(0.9, 1.1) })
	local dist = camDistance(pos)
	local shake = (opts.shake or info.shake) * math.clamp(1 - dist / (R * 30 + 120), 0, 1) * 4
	if shake > 0.05 then
		task.delay(soundDelay(pos), function()
			CameraShake.shake(shake, 0.5 + R * 0.03)
		end)
	end
	if dist < R * 1.5 then
		HUD.flash(Color3.fromRGB(255, 220, 180), 0.35, 0.4)
	end
end

-- ПОПАДАНИЕ ПУЛИ ------------------------------------------------------------------------
function Fx.impact(pos: Vector3, normal: Vector3?, water: boolean?, shield: boolean?)
	local _, att = holderAt(pos, 2)
	local n = normal or Vector3.yAxis
	att.WorldCFrame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(-math.pi / 2, 0, 0)
	if water then
		emitter(att, {
			Texture = SMOKE,
			LightInfluence = 1,
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(12, 12),
			Speed = NumberRange.new(10, 20),
			Acceleration = Vector3.new(0, -60, 0),
			Lifetime = NumberRange.new(0.4, 0.7),
			Size = ns({ { 0, 0.4 }, { 1, 1.4 } }),
			Color = cs({ { 0, Color3.new(1, 1, 1) }, { 1, Color3.fromRGB(210, 230, 240) } }),
			Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
		}):Emit(5)
		return
	end
	emitter(att, {
		Texture = SPARK,
		LightEmission = 1,
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(50, 50),
		Speed = NumberRange.new(14, 32),
		Acceleration = Vector3.new(0, -70, 0),
		Lifetime = NumberRange.new(0.15, 0.4),
		Size = ns({ { 0, 0.3 }, { 1, 0 } }),
		Color = shield and cs({ { 0, Color3.fromRGB(160, 230, 255) }, { 1, Color3.fromRGB(60, 140, 255) } })
			or cs({ { 0, Color3.fromRGB(255, 240, 170) }, { 1, Color3.fromRGB(255, 140, 50) } }),
	}):Emit(math.max(3, math.floor(8 * qmul())))
	emitter(att, {
		Texture = SMOKE,
		LightInfluence = 1,
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(30, 30),
		Speed = NumberRange.new(2, 6),
		Lifetime = NumberRange.new(0.6, 1.1),
		Size = ns({ { 0, 0.4 }, { 1, 1.6 } }),
		Color = cs({ { 0, Color3.fromRGB(150, 140, 130) }, { 1, Color3.fromRGB(110, 106, 100) } }),
		Transparency = ns({ { 0, 0.4 }, { 1, 1 } }),
	}):Emit(2)
	if os.clock() - lastBulletSound > 0.06 then
		lastBulletSound = os.clock()
		SoundPlayer.play("BulletHit", { position = pos, speed = rng:NextNumber(0.85, 1.3) })
	end
end

-- РАЗРУШЕННЫЕ БЛОКИ -----------------------------------------------------------------
function Fx.blocksBroken(list: { any }, kind: string)
	local m = qmul()
	for i, e in list do
		if i > math.max(4, math.floor(24 * m)) then
			break
		end
		local pos, color = e[1], e[2]
		local _, att = holderAt(pos, 4)
		emitter(att, {
			Texture = SMOKE,
			LightInfluence = 1,
			Speed = NumberRange.new(2, 8),
			Drag = 2,
			Lifetime = NumberRange.new(1.2, 2.4),
			Size = ns({ { 0, 1.5 }, { 1, 4.5 } }),
			Color = cs({ { 0, color:Lerp(Color3.fromRGB(120, 116, 110), 0.5) }, { 1, Color3.fromRGB(90, 86, 82) } }),
			Transparency = ns({ { 0, 0.3 }, { 1, 1 } }),
		}):Emit(3)
		if i <= 6 and kind ~= "nuke" then
			chunks(pos, 3, 30, color)
		end
	end
	if #list > 0 then
		local first = list[1][1]
		SoundPlayer.play(rng:NextNumber() < 0.5 and "Debris" or "MetalCrash", { position = first, speed = rng:NextNumber(0.85, 1.15) })
	end
end

-- ЯДЕРНЫЙ ВЗРЫВ ---------------------------------------------------------------------
function Fx.nuke(pos: Vector3)
	local m = qmul()
	local ground = pos - Vector3.new(0, 28, 0)
	local dist = camDistance(pos)
	local delay = math.min(dist / Sounds.SpeedOfSound, 4)

	-- 1. Ослепительная вспышка
	HUD.flash(Color3.new(1, 1, 1), math.clamp(1.2 - dist / 4000, 0.6, 1), 3)
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if bloom then
		local bi, bs = bloom.Intensity, bloom.Size
		bloom.Intensity = 3
		bloom.Size = 56
		tween(bloom, 4, { Intensity = bi, Size = bs })
	end
	if cc then
		local tint, br, sat = cc.TintColor, cc.Brightness, cc.Saturation
		cc.Brightness = 0.5
		cc.TintColor = Color3.fromRGB(255, 196, 150)
		cc.Saturation = -0.15
		tween(cc, 2.5, { Brightness = br })
		task.delay(3, function()
			tween(cc, 16, { TintColor = tint, Saturation = sat })
		end)
	end
	if atmo then
		local haze, color = atmo.Haze, atmo.Color
		tween(atmo, 4, { Haze = 3.2, Color = Color3.fromRGB(210, 170, 140) })
		task.delay(8, function()
			tween(atmo, 22, { Haze = haze, Color = color })
		end)
	end

	-- 2. Огненный шар
	local fireball = part({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = Color3.new(1, 1, 1),
		Size = Vector3.one * 6,
		CFrame = CFrame.new(pos),
	})
	tween(fireball, 1.4, { Size = Vector3.one * 95, Color = Color3.fromRGB(255, 190, 70) }, Enum.EasingStyle.Quart)
	task.delay(1.4, function()
		tween(fireball, 3, { Color = Color3.fromRGB(255, 80, 20), Transparency = 0.35, CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) })
		task.wait(3)
		tween(fireball, 3, { Transparency = 1, Size = Vector3.one * 120 })
	end)
	Debris:AddItem(fireball, 8)
	local light = Instance.new("PointLight")
	light.Range = 120
	light.Brightness = 40
	light.Color = Color3.fromRGB(255, 200, 140)
	light.Shadows = true
	light.Parent = fireball
	tween(light, 7, { Brightness = 0 })

	-- 3. Ударная волна и купол давления
	ring(ground + Vector3.new(0, 1.5, 0), 20, 1600, 4.5, Color3.fromRGB(255, 236, 210), 0.25)
	local dome = part({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(255, 220, 190),
		Size = Vector3.one * 10,
		CFrame = CFrame.new(ground),
	})
	tween(dome, 1.6, { Size = Vector3.one * 520, Transparency = 1 })
	Debris:AddItem(dome, 1.7)

	-- 4. Гриб: ножка, шляпка и кольцо
	local cap = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(pos) })
	local capAtt = Instance.new("Attachment")
	capAtt.Parent = cap
	local capFire = emitter(capAtt, {
		Texture = FIRE,
		LightEmission = 0.7,
		Rate = 60 * m,
		Speed = NumberRange.new(8, 22),
		Lifetime = NumberRange.new(1.5, 3),
		Size = ns({ { 0, 30 }, { 1, 55 } }),
		Color = cs({ { 0, Color3.fromRGB(255, 220, 140) }, { 0.5, Color3.fromRGB(255, 110, 40) }, { 1, Color3.fromRGB(90, 40, 20) } }),
		Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
		ZOffset = 2,
	})
	local capSmoke = emitter(capAtt, {
		Texture = SMOKE,
		LightInfluence = 0.6,
		LightEmission = 0.15,
		Rate = 45 * m,
		Speed = NumberRange.new(10, 30),
		Drag = 0.8,
		Lifetime = NumberRange.new(8, 14),
		Size = ns({ { 0, 40 }, { 0.5, 75 }, { 1, 95 } }),
		Color = cs({ { 0, Color3.fromRGB(150, 96, 60) }, { 0.4, Color3.fromRGB(104, 84, 72) }, { 1, Color3.fromRGB(80, 76, 74) } }),
		Transparency = ns({ { 0, 0.1 }, { 0.8, 0.4 }, { 1, 1 } }),
	})
	tween(cap, 12, { CFrame = CFrame.new(pos + Vector3.new(0, 250, 0)) }, Enum.EasingStyle.Sine)
	-- кольцо вокруг шляпки
	local ringAtts = {}
	for i = 1, (quality() == 1 and 5 or 10) do
		local a = Instance.new("Attachment")
		local ang = i / 10 * math.pi * 2
		a.Position = Vector3.new(math.cos(ang) * 45, -10, math.sin(ang) * 45)
		a.Parent = cap
		table.insert(ringAtts, emitter(a, {
			Texture = SMOKE,
			LightInfluence = 0.7,
			Rate = 6 * m,
			Speed = NumberRange.new(2, 8),
			Lifetime = NumberRange.new(6, 10),
			Size = ns({ { 0, 30 }, { 1, 60 } }),
			Color = cs({ { 0, Color3.fromRGB(140, 100, 74) }, { 1, Color3.fromRGB(90, 86, 84) } }),
			Transparency = ns({ { 0, 0.3 }, { 1, 1 } }),
		}))
	end
	-- ножка
	local stem = part({ Transparency = 1, Size = Vector3.one, CFrame = CFrame.new(ground) })
	local stemAtt = Instance.new("Attachment")
	stemAtt.Parent = stem
	local stemSmoke = emitter(stemAtt, {
		Texture = SMOKE,
		LightInfluence = 0.7,
		LightEmission = 0.1,
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(6, 6),
		Rate = 30 * m,
		Speed = NumberRange.new(26, 40),
		Lifetime = NumberRange.new(5, 7),
		Size = ns({ { 0, 22 }, { 1, 38 } }),
		Color = cs({ { 0, Color3.fromRGB(200, 120, 60) }, { 0.3, Color3.fromRGB(120, 96, 80) }, { 1, Color3.fromRGB(90, 88, 86) } }),
		Transparency = ns({ { 0, 0.15 }, { 1, 1 } }),
	})
	-- пылевая волна у земли
	local dust = emitter(stemAtt, {
		Texture = SMOKE,
		LightInfluence = 1,
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(88, 88),
		Speed = NumberRange.new(70, 140),
		Drag = 0.9,
		Lifetime = NumberRange.new(4, 7),
		Size = ns({ { 0, 18 }, { 1, 50 } }),
		Color = cs({ { 0, Color3.fromRGB(170, 150, 128) }, { 1, Color3.fromRGB(120, 116, 110) } }),
		Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
	})
	dust:Emit(math.floor(60 * m))
	task.delay(4, function()
		capFire.Enabled = false
	end)
	task.delay(9, function()
		capSmoke.Enabled = false
		stemSmoke.Enabled = false
		for _, e in ringAtts do
			e.Enabled = false
		end
	end)
	Debris:AddItem(cap, 26)
	Debris:AddItem(stem, 18)
	chunks(ground + Vector3.new(0, 4, 0), 30, 140)

	-- 5. Звук и тряска приходят позже вспышки — как в жизни
	SoundPlayer.play("NukeBlast", { delay = delay })
	SoundPlayer.play("NukeRumble", { delay = delay + 0.3 })
	SoundPlayer.play("Thunder", { delay = delay, speed = 0.6 })
	task.delay(delay, function()
		local k = math.clamp(1 - dist / 2600, 0.2, 1)
		CameraShake.shake(7 * k, 5)
		CameraShake.shake(2 * k, 12, 6)
	end)

	-- 6. Пепел падает вокруг камеры
	if quality() >= 2 then
		local ash = part({ Transparency = 1, Size = Vector3.new(160, 1, 160) })
		local ashEmitter = emitter(ash, {
			Texture = SMOKE,
			LightInfluence = 1,
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(20, 20),
			Rate = 40,
			Speed = NumberRange.new(4, 9),
			Lifetime = NumberRange.new(6, 9),
			Size = ns({ { 0, 0.25 }, { 1, 0.15 } }),
			Color = cs({ { 0, Color3.fromRGB(80, 78, 76) }, { 1, Color3.fromRGB(50, 48, 46) } }),
			Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
		})
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not ash.Parent then
				conn:Disconnect()
				return
			end
			ash.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position + Vector3.new(0, 50, 0))
		end)
		task.delay(18, function()
			ashEmitter.Enabled = false
		end)
		Debris:AddItem(ash, 28)
	end
end

-- ПРЕДУПРЕЖДАЮЩИЙ КРУГ ----------------------------------------------------------------
function Fx.marker(pos: Vector3, radius: number, eta: number, nuke: boolean?)
	local hit = groundBelow(pos + Vector3.new(0, 60, 0), 120)
	local y = hit and hit.Position.Y or pos.Y
	local center = Vector3.new(pos.X, y + 0.15, pos.Z)
	local model = Instance.new("Model")
	model.Name = "Marker"
	model.Parent = folder
	local segs = nuke and 48 or 28
	local r = math.min(radius, nuke and 150 or 40)
	local color = nuke and Color3.fromRGB(255, 220, 40) or Color3.fromRGB(255, 50, 40)
	local pieces = {}
	for i = 1, segs do
		local a = i / segs * math.pi * 2
		local len = 2 * math.pi * r / segs * 0.6
		local p = part({
			Size = Vector3.new(len, 0.25, nuke and 1.4 or 0.5),
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)) * CFrame.Angles(0, -a + math.pi / 2, 0),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = model,
		})
		table.insert(pieces, p)
	end
	local disk = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, r * 2, r * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.88,
		Parent = model,
	})
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(200, 60)
	bb.StudsOffsetWorldSpace = Vector3.new(0, nuke and 30 or 8, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 1500
	bb.Adornee = disk
	bb.Parent = disk
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Parent = bb
	local started = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local left = eta - (os.clock() - started)
		if left <= 0 or not model.Parent then
			conn:Disconnect()
			model:Destroy()
			return
		end
		label.Text = (nuke and "☢ " or "⚠ ") .. string.format("%.1f", left)
		local pulse = (math.sin(os.clock() * (left < 1.5 and 22 or 10)) + 1) / 2
		for _, p in pieces do
			p.Transparency = 0.1 + pulse * 0.5
		end
		disk.Transparency = 0.93 - pulse * 0.08
	end)
end

-- ВЫСТРЕЛ ПВО -----------------------------------------------------------------------
function Fx.aaShot(from: Vector3, to: Vector3)
	local dir = to - from
	for i = 0, 3 do
		task.delay(i * 0.05, function()
			local t = part({
				Size = Vector3.new(0.18, 0.18, 6),
				CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -3),
				Color = Color3.fromRGB(255, 230, 120),
				Material = Enum.Material.Neon,
			})
			tween(t, 0.12, { CFrame = CFrame.lookAt(to, to + dir) * CFrame.new(0, 0, 3) }, Enum.EasingStyle.Linear)
			Debris:AddItem(t, 0.14)
		end)
	end
	local flash = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, CFrame = CFrame.new(from), Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon })
	tween(flash, 0.12, { Transparency = 1, Size = Vector3.one * 3 })
	Debris:AddItem(flash, 0.15)
	-- чёрные клубы зенитных разрывов
	task.delay(0.15, function()
		local _, att = holderAt(to, 5)
		emitter(att, {
			Texture = SMOKE,
			LightInfluence = 1,
			Speed = NumberRange.new(2, 6),
			Lifetime = NumberRange.new(2, 3.5),
			Size = ns({ { 0, 2 }, { 1, 6 } }),
			Color = cs({ { 0, Color3.fromRGB(40, 38, 36) }, { 1, Color3.fromRGB(70, 68, 66) } }),
			Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
		}):Emit(4)
	end)
	SoundPlayer.play("AAShot", { position = from, speed = rng:NextNumber(1.05, 1.25) })
end

-- ЩИТ -------------------------------------------------------------------------------
function Fx.shield(data)
	if data.hit then
		local p = part({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(110, 210, 255),
			Size = Vector3.one * 2,
			CFrame = CFrame.new(data.hit),
			Transparency = 0.2,
		})
		tween(p, 0.45, { Size = Vector3.one * 14, Transparency = 1 })
		Debris:AddItem(p, 0.5)
		SoundPlayer.play("ShieldHit", { position = data.hit })
	elseif data.up == false then
		SoundPlayer.play("ShieldDown", { position = data.p })
		local p = part({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.ForceField,
			Color = Color3.fromRGB(255, 90, 90),
			Size = Vector3.one * data.r * 2,
			CFrame = CFrame.new(data.p),
		})
		tween(p, 0.8, { Size = Vector3.one * data.r * 2.6, Transparency = 1 })
		Debris:AddItem(p, 0.9)
	end
end

-- ОРБИТАЛЬНЫЙ ЛАЗЕР -----------------------------------------------------------------
type Laser = {
	phase: string,
	x: number,
	z: number,
	y: number,
	radius: number,
	model: Model,
	reticle: { Part },
	guide: BasePart,
	core: BasePart?,
	glow: BasePart?,
	impact: BasePart?,
	loop: Sound?,
	lastScorch: number,
}
local lasers: { [number]: Laser } = {}

local function laserCF(x: number, y: number, z: number, length: number): CFrame
	return CFrame.new(x, y + length / 2, z) * CFrame.Angles(0, 0, math.pi / 2)
end

function Fx.laserState(data)
	local id = data.id
	if data.phase == "charge" then
		local model = Instance.new("Model")
		model.Name = "Laser" .. id
		model.Parent = folder
		local r = data.r or 5
		local reticle = {}
		for i = 1, 16 do
			local a = i / 16 * math.pi * 2
			table.insert(reticle, part({
				Size = Vector3.new(1.6, 0.2, 0.35),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
				Parent = model,
				CFrame = CFrame.new(data.p + Vector3.new(math.cos(a) * r * 1.6, 0.3, math.sin(a) * r * 1.6)),
			}))
		end
		local guide = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1600, 0.25, 0.25),
			Color = Color3.fromRGB(255, 40, 40),
			Material = Enum.Material.Neon,
			Transparency = 0.35,
			Parent = model,
			CFrame = laserCF(data.p.X, data.p.Y, data.p.Z, 1600),
		})
		lasers[id] = {
			phase = "charge", x = data.p.X, z = data.p.Z, y = data.p.Y, radius = r,
			model = model, reticle = reticle, guide = guide, lastScorch = 0,
		}
		SoundPlayer.play("LaserCharge", { position = data.p })
		SoundPlayer.play("Thunder", { speed = 1.3, volume = 0.5 })
	elseif data.phase == "fire" then
		local L = lasers[id]
		if not L then
			return
		end
		L.phase = "fire"
		L.guide.Transparency = 1
		local r = L.radius
		L.core = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1600, r * 1.1, r * 1.1),
			Color = Color3.fromRGB(255, 250, 235),
			Material = Enum.Material.Neon,
			Parent = L.model,
			CFrame = laserCF(L.x, L.y, L.z, 1600),
		})
		L.glow = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1600, r * 2.8, r * 2.8),
			Color = Color3.fromRGB(255, 70, 30),
			Material = Enum.Material.Neon,
			Transparency = 0.55,
			Parent = L.model,
			CFrame = laserCF(L.x, L.y, L.z, 1600),
		})
		local impact = part({ Transparency = 1, Size = Vector3.one, Parent = L.model, CFrame = CFrame.new(L.x, L.y, L.z) })
		local att = Instance.new("Attachment")
		att.Parent = impact
		local light = Instance.new("PointLight")
		light.Range = 70
		light.Brightness = 14
		light.Color = Color3.fromRGB(255, 140, 90)
		light.Shadows = true
		light.Parent = impact
		emitter(att, {
			Texture = SPARK,
			LightEmission = 1,
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(70, 70),
			Rate = 140 * qmul(),
			Speed = NumberRange.new(20, 55),
			Acceleration = Vector3.new(0, -90, 0),
			Lifetime = NumberRange.new(0.4, 1.1),
			Size = ns({ { 0, 0.6 }, { 1, 0 } }),
			Color = cs({ { 0, Color3.fromRGB(255, 240, 180) }, { 1, Color3.fromRGB(255, 90, 30) } }),
		})
		emitter(att, {
			Texture = FIRE,
			LightEmission = 0.9,
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(30, 30),
			Rate = 50 * qmul(),
			Speed = NumberRange.new(6, 14),
			Lifetime = NumberRange.new(0.4, 0.8),
			Size = ns({ { 0, r * 1.2 }, { 1, r * 0.4 } }),
			Color = cs({ { 0, Color3.fromRGB(255, 230, 170) }, { 1, Color3.fromRGB(255, 80, 30) } }),
			Transparency = ns({ { 0, 0.1 }, { 1, 1 } }),
		})
		emitter(att, {
			Texture = SMOKE,
			LightInfluence = 1,
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(20, 20),
			Rate = 18 * qmul(),
			Speed = NumberRange.new(12, 24),
			Lifetime = NumberRange.new(2, 4),
			Size = ns({ { 0, 3 }, { 1, 12 } }),
			Color = cs({ { 0, Color3.fromRGB(70, 64, 60) }, { 1, Color3.fromRGB(110, 106, 102) } }),
			Transparency = ns({ { 0, 0.3 }, { 1, 1 } }),
		})
		L.impact = impact
		L.loop = SoundPlayer.play("LaserLoop", { parent = impact, loop = true })
		SoundPlayer.play("LaserFire", { position = Vector3.new(L.x, L.y, L.z) })
		local d = camDistance(Vector3.new(L.x, L.y, L.z))
		CameraShake.shake(2.2 * math.clamp(1 - d / 600, 0.1, 1), data.t or 5, 30)
		HUD.flash(Color3.fromRGB(255, 210, 190), math.clamp(0.6 - d / 1500, 0.1, 0.6), 0.6)
	elseif data.phase == "end" then
		local L = lasers[id]
		if not L then
			return
		end
		lasers[id] = nil
		if L.loop then
			SoundPlayer.fadeOut(L.loop, 0.5)
		end
		SoundPlayer.play("LaserEnd", { position = Vector3.new(L.x, L.y, L.z) })
		for _, p in { L.core, L.glow } do
			if p then
				tween(p, 0.45, { Size = Vector3.new(1600, 0.05, 0.05), Transparency = 1 })
			end
		end
		for _, p in L.reticle do
			tween(p, 0.4, { Transparency = 1 })
		end
		Debris:AddItem(L.model, 0.6)
	end
end

function Fx.laserTick(id: number, x: number, z: number, y: number?)
	local L = lasers[id]
	if not L then
		return
	end
	L.x, L.z = x, z
	if y then
		L.y = y
	end
end

local function updateLasers(dt: number)
	local t = os.clock()
	for _, L in lasers do
		local cf = laserCF(L.x, L.y, L.z, 1600)
		L.guide.CFrame = cf
		for i, p in L.reticle do
			local a = i / #L.reticle * math.pi * 2 + t * 1.5
			local rr = L.radius * (L.phase == "charge" and (1.6 + math.sin(t * 6) * 0.2) or 1.3)
			p.CFrame = CFrame.new(L.x + math.cos(a) * rr, L.y + 0.3, L.z + math.sin(a) * rr) * CFrame.Angles(0, -a, 0)
		end
		if L.core and L.glow then
			local flicker = 1 + math.sin(t * 40) * 0.06
			L.core.CFrame = cf
			L.glow.CFrame = cf
			L.glow.Size = Vector3.new(1600, L.radius * 2.8 * flicker, L.radius * 2.8 * flicker)
		end
		if L.impact then
			L.impact.CFrame = CFrame.new(L.x, L.y, L.z)
			if t - L.lastScorch > 0.3 then
				L.lastScorch = t
				scorch(Vector3.new(L.x, L.y + 1, L.z), L.radius * 0.9)
			end
		end
	end
end

-- БОМБАРДИРОВЩИК --------------------------------------------------------------------
function Fx.bomber(data)
	local s, e, v = data.s, data.e, data.v
	local dir = (e - s).Unit
	local total = (e - s).Magnitude / v
	local model = Instance.new("Model")
	model.Name = "Bomber"
	local body = Color3.fromRGB(78, 84, 92)
	local fus = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(34, 4.4, 4.4), Color = body, Material = Enum.Material.Metal, Parent = model })
	local function rel(p: BasePart, cf: CFrame)
		p:SetAttribute("Rel", cf)
	end
	rel(fus, CFrame.Angles(0, math.pi / 2, 0))
	local nose = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 4.4, Color = body, Material = Enum.Material.Metal, Parent = model })
	rel(nose, CFrame.new(0, 0, -17))
	local glass = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2, 4), Color = Color3.fromRGB(30, 40, 60), Material = Enum.Material.Glass, Reflectance = 0.4, Parent = model })
	rel(glass, CFrame.new(0, 1.6, -14))
	local wing = part({ Size = Vector3.new(44, 0.7, 7), Color = body, Material = Enum.Material.Metal, Parent = model })
	rel(wing, CFrame.new(0, -0.6, -2))
	local tail = part({ Size = Vector3.new(14, 0.5, 4), Color = body, Material = Enum.Material.Metal, Parent = model })
	rel(tail, CFrame.new(0, 0.5, 15))
	local fin = part({ Size = Vector3.new(0.5, 7, 5), Color = body, Material = Enum.Material.Metal, Parent = model })
	rel(fin, CFrame.new(0, 3.8, 15))
	local stripe = part({ Size = Vector3.new(0.55, 2, 2), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.SmoothPlastic, Parent = model })
	rel(stripe, CFrame.new(0, 4.5, 15.5))
	local trails = {}
	for _, x in { -14, -7, 7, 14 } do
		local eng = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 2.2, 2.2), Color = Color3.fromRGB(60, 62, 66), Material = Enum.Material.Metal, Parent = model })
		rel(eng, CFrame.new(x, -1.6, -1) * CFrame.Angles(0, math.pi / 2, 0))
		local glow = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.8, 1.8), Color = Color3.fromRGB(255, 150, 60), Material = Enum.Material.Neon, Parent = model })
		rel(glow, CFrame.new(x, -1.6, 2.1) * CFrame.Angles(0, math.pi / 2, 0))
		local a = Instance.new("Attachment")
		a.Parent = glow
		table.insert(trails, emitter(a, {
			Texture = SMOKE,
			LightInfluence = 1,
			Rate = 30 * qmul(),
			Speed = NumberRange.new(0, 1),
			SpreadAngle = Vector2.new(2, 2),
			Lifetime = NumberRange.new(3, 4.5),
			Size = ns({ { 0, 1.2 }, { 1, 4.5 } }),
			Color = cs({ { 0, Color3.new(1, 1, 1) }, { 1, Color3.fromRGB(220, 225, 230) } }),
			Transparency = ns({ { 0, 0.4 }, { 1, 1 } }),
		}))
	end
	model.Parent = folder
	local jet = SoundPlayer.play("Jet", { parent = fus })
	local base = data.t
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local k = now - base
		if k > total or not model.Parent then
			conn:Disconnect()
			for _, tr in trails do
				tr.Enabled = false
			end
			task.delay(4, function()
				model:Destroy()
			end)
			return
		end
		local pos = s + dir * v * math.max(0, k)
		local cf = CFrame.lookAt(pos, pos + dir)
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") then
				local r = p:GetAttribute("Rel") :: CFrame?
				if r then
					p.CFrame = cf * r
				end
			end
		end
	end)
	task.delay(total + 5, function()
		if jet and jet.Parent then
			jet:Destroy()
		end
	end)
end

function Fx.applyQuality()
	local q = quality()
	local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect")
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if dof then
		dof.Enabled = q >= 3
	end
	if rays then
		rays.Enabled = q >= 2
	end
	if bloom then
		bloom.Enabled = q >= 2
	end
	Lighting.GlobalShadows = q >= 2
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Enabled = q >= 2
	end
	workspace.Terrain.Decoration = q >= 3
end

function Fx.init()
	folder = Instance.new("Folder")
	folder.Name = "ClientFx"
	folder.Parent = workspace
	RunService.RenderStepped:Connect(updateLasers)
end

function Fx.folder(): Folder
	return folder
end

return Fx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[-- Снаряды на клиенте: красивые модели, дымные следы, свет, звук полёта.
-- Траекторию считает сервер; клиент повторяет её по формулам и подправляется по синхронизации.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)

local Client = script.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local Fx = require(Client.Fx)

local Projectiles = {}

local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

type Vis = {
	id: number,
	w: any,
	model: Model,
	root: BasePart,
	p0: Vector3,
	v0: Vector3,
	g: number,
	t0: number,
	pos: Vector3,
	vel: Vector3,
	guided: boolean,
	correction: Vector3,
	emitters: { ParticleEmitter },
	loop: Sound?,
	whistled: boolean,
	target: Vector3?,
	bomblet: boolean,
}

local active: { [number]: Vis } = {}
local lastLaunchSound: { [string]: number } = {}
local rng = Random.new()

local function quality(): number
	return State.settings.Graphics or 3
end

local function ns(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

local function basePart(model: Model, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = model
	return p
end

-- Детали модели снаряда хранят смещение относительно «корня» (вдоль -Z — вперёд)
local function attach(model: Model, root: BasePart, rel: CFrame, props: { [string]: any }): Part
	local p = basePart(model, props)
	p:SetAttribute("Rel", rel)
	return p
end

local ALONG = CFrame.Angles(0, math.pi / 2, 0) -- цилиндр осью вдоль Z

local function smokeTrail(parent: Instance, size: number, life: number, color: Color3?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Rate = (quality() == 1 and 25 or 70)
	e.Lifetime = NumberRange.new(life * 0.7, life)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(8, 8)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size * 2.6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(color or Color3.fromRGB(205, 200, 195), Color3.fromRGB(150, 148, 146))
	e.LightInfluence = 1
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-40, 40)
	e.Parent = parent
	return e
end

local function flame(parent: Instance, size: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = FIRE
	e.Rate = 120
	e.Lifetime = NumberRange.new(0.08, 0.18)
	e.Speed = NumberRange.new(5, 12)
	e.EmissionDirection = Enum.NormalId.Back
	e.SpreadAngle = Vector2.new(10, 10)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.2) })
	e.Color = ColorSequence.new(Color3.fromRGB(255, 240, 190), Color3.fromRGB(255, 110, 40))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Parent = parent
	return e
end

local function exhaustLight(parent: Instance, range: number)
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 160, 90)
	l.Range = range
	l.Brightness = 3
	l.Parent = parent
end

-- МОДЕЛИ ----------------------------------------------------------------------------
local function buildVisual(kind: string, w): (Model, BasePart, { ParticleEmitter })
	local model = Instance.new("Model")
	model.Name = "Projectile"
	local emitters = {}
	local root: Part
	if kind == "Tracer" then
		root = basePart(model, {
			Size = Vector3.new(0.16, 0.16, 5),
			Color = w.color or Color3.fromRGB(255, 220, 130),
			Material = Enum.Material.Neon,
		})
	elseif kind == "Grenade" then
		root = basePart(model, { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Color = Color3.fromRGB(60, 80, 50), Material = Enum.Material.Metal })
		local a = Instance.new("Attachment")
		a.Parent = root
		table.insert(emitters, smokeTrail(a, 0.4, 0.8, Color3.fromRGB(180, 180, 175)))
	elseif kind == "Bomblet" then
		root = basePart(model, { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, Color = Color3.fromRGB(70, 70, 64), Material = Enum.Material.Metal })
		local a = Instance.new("Attachment")
		a.Parent = root
		table.insert(emitters, smokeTrail(a, 0.3, 0.5))
	elseif kind == "Shell" then
		root = basePart(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 0.9, 0.9), Color = Color3.fromRGB(56, 64, 52), Material = Enum.Material.Metal })
		root:SetAttribute("Spin", ALONG)
		local a = Instance.new("Attachment")
		a.Parent = root
		table.insert(emitters, smokeTrail(a, 0.5, 1.2, Color3.fromRGB(170, 168, 160)))
	elseif kind == "Rocket" or kind == "Missile" or kind == "BigMissile" or kind == "Reentry" then
		local big = kind == "BigMissile" or kind == "Reentry"
		local len = big and 9 or (kind == "Missile" and 5 or 3.2)
		local d = big and 1.8 or (kind == "Missile" and 1.1 or 0.8)
		local bodyColor = kind == "Rocket" and Color3.fromRGB(86, 96, 70) or Color3.fromRGB(232, 234, 238)
		if kind == "Reentry" then
			bodyColor = Color3.fromRGB(255, 190, 120)
		end
		root = basePart(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(len, d, d),
			Color = bodyColor,
			Material = kind == "Reentry" and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		})
		root:SetAttribute("Spin", ALONG)
		attach(model, root, CFrame.new(0, 0, -len / 2 - d * 0.3), {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(d, d, d * 1.6),
			Color = kind == "Reentry" and Color3.fromRGB(255, 240, 200) or Color3.fromRGB(200, 40, 40),
			Material = kind == "Reentry" and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		})
		for i = 0, 3 do
			local a = i * math.pi / 2
			attach(model, root, CFrame.new(0, 0, len / 2 - d * 0.6) * CFrame.Angles(0, 0, a) * CFrame.new(0, d * 0.75, 0), {
				Size = Vector3.new(0.12, d * 0.9, d * 1.2),
				Color = Color3.fromRGB(60, 62, 66),
				Material = Enum.Material.Metal,
			})
		end
		if big and kind == "BigMissile" then
			attach(model, root, CFrame.new(0, 0, 0.5), { Size = Vector3.new(7, 0.2, 2), Color = Color3.fromRGB(200, 202, 208), Material = Enum.Material.Metal })
		end
		local tail = Instance.new("Attachment")
		tail.Position = Vector3.new(0, 0, 0)
		tail.Parent = root
		tail:SetAttribute("Tail", len / 2)
		table.insert(emitters, flame(tail, d * 1.3))
		table.insert(emitters, smokeTrail(tail, d * 1.1, big and 4 or 2.6))
		exhaustLight(root, big and 30 or 16)
		if kind == "Reentry" then
			local glow = Instance.new("ParticleEmitter")
			glow.Texture = FIRE
			glow.Rate = 80
			glow.Lifetime = NumberRange.new(0.3, 0.6)
			glow.Speed = NumberRange.new(1, 4)
			glow.Size = ns(6, 2)
			glow.Color = ColorSequence.new(Color3.fromRGB(255, 220, 160), Color3.fromRGB(255, 80, 30))
			glow.LightEmission = 1
			glow.Parent = root
			table.insert(emitters, glow)
		end
	elseif kind == "Bomb" then
		root = basePart(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 1.6, 1.6), Color = Color3.fromRGB(70, 76, 66), Material = Enum.Material.Metal })
		root:SetAttribute("Spin", ALONG)
		attach(model, root, CFrame.new(0, 0, -2.1), { Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, Color = Color3.fromRGB(70, 76, 66), Material = Enum.Material.Metal })
		attach(model, root, CFrame.new(0, 0, 2.2), { Size = Vector3.new(2.2, 0.15, 1), Color = Color3.fromRGB(50, 52, 50), Material = Enum.Material.Metal })
		attach(model, root, CFrame.new(0, 0, 2.2), { Size = Vector3.new(0.15, 2.2, 1), Color = Color3.fromRGB(50, 52, 50), Material = Enum.Material.Metal })
		attach(model, root, ALONG, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 1.65, 1.65), Color = Color3.fromRGB(240, 200, 40) })
	elseif kind == "Nuke" then
		root = basePart(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 3.2, 3.2), Color = Color3.fromRGB(78, 88, 70), Material = Enum.Material.Metal })
		root:SetAttribute("Spin", CFrame.Angles(0, 0, math.pi / 2)) -- вертикально
		attach(model, root, CFrame.new(0, -3.6, 0), { Shape = Enum.PartType.Ball, Size = Vector3.new(3.2, 3.4, 3.2), Color = Color3.fromRGB(78, 88, 70), Material = Enum.Material.Metal })
		for i, y in { 1.4, -1 } do
			attach(model, root, CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2), {
				Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 3.3, 3.3),
				Color = i == 1 and Color3.fromRGB(250, 210, 30) or Color3.fromRGB(20, 20, 20), Material = Enum.Material.SmoothPlastic,
			})
		end
		attach(model, root, CFrame.new(0, 4.2, 0), { Size = Vector3.new(4, 1.4, 0.2), Color = Color3.fromRGB(50, 54, 50), Material = Enum.Material.Metal })
		attach(model, root, CFrame.new(0, 4.2, 0), { Size = Vector3.new(0.2, 1.4, 4), Color = Color3.fromRGB(50, 54, 50), Material = Enum.Material.Metal })
		-- парашют
		attach(model, root, CFrame.new(0, 22, 0), {
			Shape = Enum.PartType.Ball, Size = Vector3.new(24, 9, 24),
			Color = Color3.fromRGB(240, 120, 40), Material = Enum.Material.Fabric,
		})
		attach(model, root, CFrame.new(0, 21.5, 0), {
			Shape = Enum.PartType.Ball, Size = Vector3.new(24.3, 8, 24.3),
			Color = Color3.fromRGB(245, 245, 240), Material = Enum.Material.Fabric, Transparency = 0.4,
		})
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			local top = Vector3.new(math.cos(a) * 11, 20, math.sin(a) * 11)
			local bottom = Vector3.new(0, 4.5, 0)
			local mid = (top + bottom) / 2
			attach(model, root, CFrame.lookAt(mid, top), { Size = Vector3.new(0.1, 0.1, (top - bottom).Magnitude), Color = Color3.fromRGB(220, 220, 220) })
		end
		local blink = attach(model, root, CFrame.new(0, -1.8, -1.7), { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon })
		blink:SetAttribute("Blink", true)
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 40, 40)
		l.Range = 18
		l.Brightness = 3
		l.Parent = blink
	else
		root = basePart(model, { Shape = Enum.PartType.Ball, Size = Vector3.one, Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon })
	end
	model.PrimaryPart = root
	return model, root, emitters
end

local function place(v: Vis, pos: Vector3, vel: Vector3)
	local dir = vel.Magnitude > 0.01 and vel.Unit or Vector3.new(0, -1, 0)
	local cf
	if v.w.key == "Nuke" and not v.bomblet then
		cf = CFrame.new(pos) * CFrame.Angles(math.sin(os.clock() * 1.3) * 0.08, os.clock() * 0.3, math.cos(os.clock() * 1.1) * 0.08)
	else
		cf = CFrame.lookAt(pos, pos + dir)
	end
	local spin = v.root:GetAttribute("Spin") :: CFrame?
	v.root.CFrame = spin and (cf * spin) or cf
	for _, p in v.model:GetChildren() do
		if p ~= v.root and p:IsA("BasePart") then
			local rel = p:GetAttribute("Rel") :: CFrame?
			if rel then
				p.CFrame = cf * rel
			end
			if p:GetAttribute("Blink") then
				p.Transparency = (math.floor(os.clock() * 3) % 2 == 0) and 0 or 0.9
			end
		end
	end
	-- хвостовое крепление пламени — сзади корпуса (+Z в системе «смотрит вперёд»)
	for _, a in v.root:GetChildren() do
		if a:IsA("Attachment") then
			local tail = a:GetAttribute("Tail") :: number?
			if tail then
				a.WorldCFrame = cf * CFrame.new(0, 0, tail)
			end
		end
	end
end

-- Оставить дымный след висеть в воздухе после взрыва
local function detachTrails(v: Vis)
	for _, e in v.emitters do
		local att = e.Parent
		if att and att:IsA("Attachment") then
			local holder = Instance.new("Part")
			holder.Anchored = true
			holder.CanCollide = false
			holder.CanQuery = false
			holder.CanTouch = false
			holder.Transparency = 1
			holder.Size = Vector3.one * 0.2
			holder.CFrame = att.WorldCFrame
			holder.Parent = Fx.folder()
			local na = Instance.new("Attachment")
			na.Parent = holder
			e.Parent = na
			e.Enabled = false
			Debris:AddItem(holder, 6)
		end
	end
end

local function remove(id: number)
	local v = active[id]
	if not v then
		return
	end
	active[id] = nil
	detachTrails(v)
	if v.loop then
		SoundPlayer.fadeOut(v.loop, 0.2)
	end
	v.model:Destroy()
end

local function onSpawn(d)
	local w = Weapons.ByKey[d.w]
	if not w then
		return
	end
	local kind = d.b and "Bomblet" or w.visual
	local model, root, emitters = buildVisual(kind, w)
	local v: Vis = {
		id = d.id,
		w = w,
		model = model,
		root = root,
		p0 = d.p,
		v0 = d.v,
		g = d.g or 0,
		t0 = d.t,
		pos = d.p,
		vel = d.v,
		guided = w.motion == "Homing" or w.motion == "Cruise",
		correction = Vector3.zero,
		emitters = emitters,
		loop = nil,
		whistled = false,
		target = d.tp,
		bomblet = d.b == true,
	}
	place(v, d.p, d.v)
	model.Parent = Fx.folder()
	active[d.id] = v
	-- звук выстрела (пулемёт не повторяет звук на каждую пулю)
	local launch = w.launchSound
	if launch and not d.b then
		local key = launch .. tostring(math.floor(d.p.X)) .. tostring(math.floor(d.p.Z))
		local gap = (w.key == "Minigun") and 1.1 or (w.key == "Bullet" and 0.25 or 0)
		if os.clock() - (lastLaunchSound[key] or 0) >= gap then
			lastLaunchSound[key] = os.clock()
			if launch == "Siren" or launch == "Incoming" or launch == "Jet" then
				-- сирена и рёв играют в SiegeUI / Fx
				if launch == "Incoming" then
					SoundPlayer.play("Incoming", { position = d.tp or d.p })
				end
			else
				SoundPlayer.play(launch, { position = d.p, speed = rng:NextNumber(0.94, 1.06) })
			end
		end
	end
	if w.loopSound then
		v.loop = SoundPlayer.play(w.loopSound, { parent = root, loop = true })
	end
end

local function step(dt: number)
	local now = workspace:GetServerTimeNow()
	for id, v in active do
		if v.guided then
			v.pos += v.vel * dt
			-- плавно гасим поправку от сервера
			local c = v.correction * math.min(1, dt * 8)
			v.pos += c
			v.correction -= c
		else
			local t = math.max(0, now - v.t0)
			v.pos = Weapons.ballistic(v.p0, v.v0, v.g, t)
			v.vel = v.v0 + Vector3.new(0, -v.g * t, 0)
			if v.w.motion == "Parachute" then
				v.pos += Vector3.new(math.sin(t * 0.7) * 2, 0, math.cos(t * 0.5) * 2)
			end
		end
		place(v, v.pos, v.vel)
		-- свист падающей мины / бомбы
		if not v.whistled and (v.w.visual == "Shell" or v.w.visual == "Bomb" or v.bomblet) and v.vel.Y < 0 and v.target then
			local h = v.pos.Y - v.target.Y
			if h > 0 and h / math.max(1, -v.vel.Y) < 1.6 then
				v.whistled = true
				if not v.bomblet or rng:NextNumber() < 0.25 then
					SoundPlayer.play("ShellWhistle", { parent = v.root, speed = rng:NextNumber(0.9, 1.15) })
				end
			end
		end
		if now - v.t0 > 30 then
			remove(id)
		end
	end
end

local function onSync(batch)
	for _, e in batch do
		local v = active[e[1]]
		if v then
			v.correction = e[2] - v.pos
			v.vel = e[3]
		end
	end
end

local function fxSize(key: string): string
	local w = Weapons.ByKey[key]
	return w and w.fx or "Medium"
end

local function onDetonate(d)
	local v = d.id and active[d.id]
	if d.id then
		remove(d.id)
	end
	if d.silent then
		return
	end
	local key = d.w
	if key == "ClusterOpen" then
		Fx.explosion("Small", d.p, 3, { air = true, shake = 0.2 })
		return
	end
	if key == "Bomblet" then
		Fx.explosion("Small", d.p, 6, { water = d.water })
		return
	end
	if key == "TNT" then
		Fx.explosion("Medium", d.p, 12, {})
		return
	end
	local w = Weapons.ByKey[key]
	if not w then
		return
	end
	if w.fx == "Nuke" then
		if d.aa then
			Fx.explosion("Large", d.p, 20, { air = true })
		else
			Fx.nuke(d.p)
		end
		return
	end
	local size = fxSize(key)
	local R = w.radius
	if d.aa then
		size = "Small"
		R = math.max(4, R * 0.5)
	end
	Fx.explosion(size, d.p, R, { water = d.water, air = d.air or d.aa, shake = w.shake })
	local _ = v
end

function Projectiles.init()
	Net.event("ProjectileSpawn").OnClientEvent:Connect(onSpawn)
	Net.unreliable("ProjectileSync").OnClientEvent:Connect(onSync)
	Net.event("Detonate").OnClientEvent:Connect(onDetonate)
	Net.event("Impact").OnClientEvent:Connect(function(d)
		if d.id then
			remove(d.id)
		end
		Fx.impact(d.p, d.n, d.water, d.shield)
	end)
	Net.event("Warning").OnClientEvent:Connect(function(d)
		Fx.marker(d.p, d.r, d.t, d.kind == "nuke")
	end)
	Net.event("AAShot").OnClientEvent:Connect(function(d)
		Fx.aaShot(d.from, d.to)
	end)
	Net.event("ShieldState").OnClientEvent:Connect(Fx.shield)
	Net.event("BlocksBroken").OnClientEvent:Connect(Fx.blocksBroken)
	Net.event("Bomber").OnClientEvent:Connect(Fx.bomber)
	Net.event("LaserState").OnClientEvent:Connect(Fx.laserState)
	Net.unreliable("LaserTick").OnClientEvent:Connect(Fx.laserTick)
	RunService.RenderStepped:Connect(step)
	-- пули пролетают рядом — свист
	local player = Players.LocalPlayer
	task.spawn(function()
		while true do
			task.wait(0.1)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				for _, v in active do
					if v.w.visual == "Tracer" and not v.whistled and (v.pos - root.Position).Magnitude < 12 then
						v.whistled = true
						if rng:NextNumber() < 0.35 then
							SoundPlayer.play("BulletWhiz", { position = v.pos, speed = rng:NextNumber(0.9, 1.2) })
						end
					end
				end
			end
		end
	end)
	local _ = TweenService
end

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SoundPlayer</string>
          <string name="Source"><![CDATA[-- Проигрывание звуков. Для каждого звука пробует ID по очереди и запоминает первый,
-- который реально загрузился (если ID закрыт или удалён — берёт следующий).
local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local SoundPlayer = {}

local resolved: { [string]: string } = {}
local resolving: { [string]: boolean } = {}
local sfxGroup: SoundGroup
local musicGroup: SoundGroup
local anchor: Part

local function group(name: string, volume: number): SoundGroup
	local g = SoundService:FindFirstChild(name) :: SoundGroup?
	if not g then
		local ng = Instance.new("SoundGroup")
		ng.Name = name
		ng.Volume = volume
		ng.Parent = SoundService
		g = ng
	end
	return g :: SoundGroup
end

local function tryLoad(id: string): boolean
	local s = Instance.new("Sound")
	s.SoundId = id
	local ok = false
	local done = false
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ s }, function(_, status)
				ok = status == Enum.AssetFetchStatus.Success
			end)
		end)
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < 12 do
		task.wait(0.05)
	end
	if ok or s.IsLoaded then
		s:Destroy()
		return true
	end
	s:Destroy()
	return false
end

local function resolve(key: string)
	if resolved[key] or resolving[key] then
		return
	end
	local def = Sounds.Defs[key]
	if not def then
		return
	end
	resolving[key] = true
	-- пока проверяем — используем первый вариант
	resolved[key] = def.ids[1]
	for _, id in def.ids do
		if tryLoad(id) then
			resolved[key] = id
			resolving[key] = nil
			return
		end
	end
	resolved[key] = def.ids[#def.ids]
	resolving[key] = nil
end

function SoundPlayer.init()
	sfxGroup = group("SFX", 1)
	musicGroup = group("Music", 0.5)
	anchor = Instance.new("Part")
	anchor.Name = "SoundAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Parent = workspace
	-- проверяем все звуки в фоне (сначала короткие эффекты, потом музыку)
	local list = {}
	for key, def in Sounds.Defs do
		table.insert(list, { key, def.music and 1 or 0 })
	end
	table.sort(list, function(a, b)
		return a[2] < b[2]
	end)
	for _, e in list do
		task.spawn(resolve, e[1])
	end
end

function SoundPlayer.setVolumes(sfx: number, music: number)
	if sfxGroup then
		sfxGroup.Volume = sfx
	end
	if musicGroup then
		musicGroup.Volume = music
	end
end

function SoundPlayer.idOf(key: string): string?
	local def = Sounds.Defs[key]
	if not def then
		return nil
	end
	return resolved[key] or def.ids[1]
end

export type PlayOpts = {
	volume: number?,
	speed: number?,
	loop: boolean?,
	parent: Instance?,
	position: Vector3?,
	delay: number?,
	noAutoDestroy: boolean?,
}

-- Создать и запустить звук. Без parent/position — звук «в голове» (2D).
function SoundPlayer.play(key: string, opts: PlayOpts?): Sound?
	local def = Sounds.Defs[key]
	if not def then
		return nil
	end
	local o: PlayOpts = opts or {}
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = SoundPlayer.idOf(key) or ""
	s.Volume = (def.volume or 0.5) * (o.volume or 1)
	s.PlaybackSpeed = (def.speed or 1) * (o.speed or 1)
	s.Looped = o.loop or def.loop or false
	s.SoundGroup = def.music and musicGroup or sfxGroup
	if def.range then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = math.max(10, def.range * 0.08)
		s.RollOffMaxDistance = def.range
	end
	local parent: Instance = SoundService
	if o.parent then
		parent = o.parent
	elseif o.position then
		local att = Instance.new("Attachment")
		att.WorldPosition = o.position
		att.Parent = anchor
		parent = att
		s.Ended:Connect(function()
			att:Destroy()
		end)
		task.delay(30, function()
			if att.Parent and not s.Looped then
				att:Destroy()
			end
		end)
	end
	s.Parent = parent
	local function start()
		if s.Parent then
			s:Play()
		end
	end
	if o.delay and o.delay > 0 then
		task.delay(o.delay, start)
	else
		start()
	end
	if not s.Looped and not o.noAutoDestroy then
		s.Ended:Connect(function()
			s:Destroy()
		end)
	end
	return s
end

function SoundPlayer.fadeOut(s: Sound?, t: number?)
	if not s then
		return
	end
	local tw = TweenService:Create(s, TweenInfo.new(t or 0.6), { Volume = 0 })
	tw.Completed:Connect(function()
		s:Destroy()
	end)
	tw:Play()
end

-- Музыка: плейлист с плавной сменой треков
local currentMusic: Sound? = nil
local currentList: { string }? = nil
local musicToken = 0

function SoundPlayer.playlist(list: { string }?)
	if list == currentList then
		return
	end
	currentList = list
	musicToken += 1
	local token = musicToken
	SoundPlayer.fadeOut(currentMusic, 1.5)
	currentMusic = nil
	if not list then
		return
	end
	task.spawn(function()
		local i = math.random(1, #list)
		while token == musicToken do
			local key = list[i]
			local s = SoundPlayer.play(key, { noAutoDestroy = true })
			if not s then
				return
			end
			local target = s.Volume
			s.Volume = 0
			TweenService:Create(s, TweenInfo.new(2), { Volume = target }):Play()
			currentMusic = s
			local started = os.clock()
			while token == musicToken and s.Parent and (s.IsPlaying or os.clock() - started < 3) do
				task.wait(0.5)
			end
			if token ~= musicToken then
				return
			end
			if s.Parent then
				s:Destroy()
			end
			i = i % #list + 1
			task.wait(1)
		end
	end)
end

return SoundPlayer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">State</string>
          <string name="Source"><![CDATA[-- Состояние клиента: золото, купленные блоки, выбранный инструмент и блок, режимы.
-- Модули подписываются на изменения через State.changed.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)

export type Signal = {
	Connect: (Signal, (...any) -> ()) -> { Disconnect: () -> () },
	Fire: (Signal, ...any) -> (),
}

local function newSignal(): Signal
	local handlers: { (...any) -> () } = {}
	local s = {}
	function s.Connect(_self, fn: (...any) -> ())
		table.insert(handlers, fn)
		return {
			Disconnect = function()
				local i = table.find(handlers, fn)
				if i then
					table.remove(handlers, i)
				end
			end,
		}
	end
	function s.Fire(_self, ...: any)
		for _, fn in table.clone(handlers) do
			task.spawn(fn, ...)
		end
	end
	return (s :: any) :: Signal
end

local State = {
	newSignal = newSignal,
	changed = newSignal(), -- (key, value)

	gold = 0,
	unlocked = {} :: { [string]: boolean },
	bestWave = 0,
	slots = {} :: { any },
	stats = {} :: { [string]: number },
	saveEnabled = false,
	settings = table.clone(Config.DefaultSettings) :: { [string]: any },

	tool = nil :: string?,          -- "build" | "delete" | "paint" | "pick" | nil
	modal = nil :: string?,         -- открытое окно
	siege = nil :: any,             -- последнее состояние осады с сервера
	launched = false,
	rangeTarget = "me",             -- полигон: "me" или "click"
	rangeWeapon = "Bullet",

	sel = {
		kind = "mat",               -- "mat" | "item"
		id = 1,
		shape = 1,
		size = Config.DefaultBlockSize,
		rot = 1,
		color = Blocks.MaterialById[1].color,
		customColor = false,
	},
}

function State.set(key: string, value: any)
	(State :: any)[key] = value
	State.changed:Fire(key, value)
end

function State.isUnlocked(kind: string, id: number): boolean
	local def = (kind == "item") and Blocks.ItemById[id] or Blocks.MaterialById[id]
	if not def then
		return false
	end
	if def.price <= 0 then
		return true
	end
	return State.unlocked[Blocks.unlockKey(kind, id)] == true
end

-- Текущая спецификация блока для строительства
function State.spec()
	local sel = State.sel
	local item = sel.kind == "item" and sel.id or 0
	local mat = sel.kind == "mat" and sel.id or 0
	local shape = sel.kind == "mat" and sel.shape or 1
	return {
		mat = mat,
		shape = shape,
		item = item,
		size = Blocks.normalizeSize(shape, item, sel.size, Config.MaxBlockSize),
		rot = sel.rot,
		color = sel.color,
	}
end

function State.selectBlock(kind: string, id: number)
	local sel = State.sel
	sel.kind = kind
	sel.id = id
	if not sel.customColor then
		local def = (kind == "item") and Blocks.ItemById[id] or Blocks.MaterialById[id]
		sel.color = def.color
	end
	State.changed:Fire("sel", sel)
end

function State.inSiege(): boolean
	return State.siege ~= nil and State.siege.active == true
end

return State
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BuildPanel</string>
            <string name="Source"><![CDATA[-- Левая панель: выбор блока, формы, размера, поворота и цвета.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)
local BlockFactory = require(Shared.BlockFactory)
local Grid = require(Shared.Grid)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)
local HUD = require(script.Parent.HUD)

local new = Lib.new
local BuildPanel = {}

local panel: Frame
local paintPanel: Frame
local grid: ScrollingFrame
local tab = "mat"
local tabButtons: { [string]: TextButton } = {}
local tiles: { [string]: { frame: TextButton, lock: Frame } } = {}
local shapeButtons: { [number]: TextButton } = {}
local sizeLabels: { [string]: TextLabel } = {}
local sizeRow: Frame
local shapeRow: Frame
local swatches: { { b: TextButton, c: Color3 } } = {}
local defaultColorBtn: TextButton
local nameLabel: TextLabel
local statsLabel: TextLabel

local SHAPE_ICONS = { "■", "◢", "◣", "▬", "●" }

local function tileKey(kind: string, id: number): string
	return kind .. id
end

local function previewSpec(kind: string, id: number)
	if kind == "item" then
		local it = Blocks.ItemById[id]
		return { mat = 0, shape = 1, item = id, size = it.size, rot = 1, color = it.color }
	end
	local m = Blocks.MaterialById[id]
	return { mat = id, shape = 1, item = 0, size = Vector3.new(2, 2, 2), rot = 1, color = m.color }
end

local function refreshTiles()
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child.Visible = child:GetAttribute("Kind") == tab
		end
	end
	for key, t in tiles do
		local kind = t.frame:GetAttribute("Kind")
		local id = t.frame:GetAttribute("Id")
		t.lock.Visible = not State.isUnlocked(kind, id)
		local selected = State.sel.kind == kind and State.sel.id == id
		local stroke = t.frame:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = selected and Theme.Accent or Theme.Stroke
			stroke.Transparency = selected and 0 or 0.86
			stroke.Thickness = selected and 3 or 1.5
		end
	end
	for k, b in tabButtons do
		Lib.setButtonColor(b, k == tab and Theme.Accent2 or Theme.Panel2)
	end
end

local function refreshSelection()
	local sel = State.sel
	local spec = State.spec()
	local def = Blocks.def(spec)
	nameLabel.Text = def.name
	local hp = Blocks.maxHp(spec, spec.size)
	statsLabel.Text = string.format("Прочность %s • Защита %d%%", Util.formatNumber(hp), math.floor((def.blast or 0) * 100 + 0.5))
	for id, b in shapeButtons do
		Lib.setButtonColor(b, (sel.kind == "mat" and sel.shape == id) and Theme.Accent2 or Theme.Panel2)
	end
	shapeRow.Visible = sel.kind == "mat"
	local resizable = sel.kind == "mat" or (Blocks.ItemById[sel.id] and Blocks.ItemById[sel.id].resizable)
	sizeRow.Visible = resizable == true
	sizeLabels.X.Text = tostring(spec.size.X)
	sizeLabels.Y.Text = tostring(spec.size.Y)
	sizeLabels.Z.Text = tostring(spec.size.Z)
	for _, s in swatches do
		local stroke = s.b:FindFirstChildOfClass("UIStroke")
		if stroke then
			local on = sel.customColor and s.c == sel.color
			stroke.Transparency = on and 0 or 0.7
			stroke.Thickness = on and 3 or 1
			stroke.Color = on and Theme.Accent or Color3.new(0, 0, 0)
		end
	end
	Lib.setButtonColor(defaultColorBtn, sel.customColor and Theme.Panel2 or Theme.Accent2)
	refreshTiles()
end

local function makeTile(kind: string, def, order: number)
	local b = Lib.button("", {
		Size = UDim2.fromOffset(94, 108),
		BackgroundColor3 = Theme.Panel2,
		LayoutOrder = order,
		Parent = grid,
	}, function()
		if State.isUnlocked(kind, def.id) then
			State.selectBlock(kind, def.id)
		else
			HUD.toast("«" .. def.name .. "» продаётся в магазине за " .. Util.formatNumber(def.price), "warning")
			HUD.openModal("shop")
		end
	end)
	b:SetAttribute("Kind", kind)
	b:SetAttribute("Id", def.id)
	local vpHolder = new("Frame", {
		Size = UDim2.new(1, -8, 0, 70),
		Position = UDim2.fromOffset(4, 4),
		BackgroundTransparency = 1,
		Parent = b,
	})
	local spec = previewSpec(kind, def.id)
	local vp = Lib.viewport(function()
		return BlockFactory.build(spec, CFrame.identity, { preview = true })
	end)
	vp.Parent = vpHolder
	Lib.label(def.name, 13, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 2, 1, -32),
		Size = UDim2.new(1, -4, 0, 28),
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = b,
	})
	local lock = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		Parent = b,
	}, {
		Lib.corner(12),
		Lib.label("🔒", 22, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 28) }),
		Lib.label(Util.formatNumber(def.price), 15, {
			FontFace = Theme.FontHeavy,
			TextColor3 = Theme.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 48),
			Size = UDim2.new(1, 0, 0, 20),
		}),
	})
	tiles[tileKey(kind, def.id)] = { frame = b, lock = lock }
end

local function stepper(axis: string, title: string, order: number): Frame
	local f = new("Frame", { Size = UDim2.fromOffset(96, 36), BackgroundTransparency = 1, LayoutOrder = order, Parent = sizeRow })
	Lib.label(title, 14, { TextColor3 = Theme.Sub, Size = UDim2.fromOffset(20, 36), TextYAlignment = Enum.TextYAlignment.Center, Parent = f })
	local function change(d: number)
		local s = State.sel.size
		local v = { X = s.X, Y = s.Y, Z = s.Z }
		v[axis] = math.clamp(v[axis] + d, 1, Config.MaxBlockSize)
		State.sel.size = Vector3.new(v.X, v.Y, v.Z)
		State.changed:Fire("sel", State.sel)
	end
	Lib.button("−", { Position = UDim2.fromOffset(18, 4), Size = UDim2.fromOffset(24, 28), TextSize = 18, Parent = f }, function()
		change(-1)
	end)
	sizeLabels[axis] = Lib.label("2", 18, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.fromOffset(26, 36),
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = f,
	})
	Lib.button("+", { Position = UDim2.fromOffset(68, 4), Size = UDim2.fromOffset(24, 28), TextSize = 18, Parent = f }, function()
		change(1)
	end)
	return f
end

local function buildPalette(parent: Instance, order: number)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(22, 22), CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, c in Config.Palette do
		local b = new("TextButton", {
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = c,
			LayoutOrder = i,
			Parent = holder,
		}, { Lib.corner(6), new("UIStroke", { Thickness = 1, Transparency = 0.7 }) })
		b.Activated:Connect(function()
			State.sel.color = c
			State.sel.customColor = true
			State.changed:Fire("sel", State.sel)
		end)
		table.insert(swatches, { b = b, c = c })
	end
end

function BuildPanel.init()
	local gui = HUD.gui()
	panel = Lib.panel({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 20),
		Size = UDim2.fromOffset(336, 610),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	local inner = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel }, {
		Lib.padding(12),
		Lib.list(Enum.FillDirection.Vertical, 8),
	})
	-- вкладки
	local tabs = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = 1, Parent = inner }, {
		Lib.list(Enum.FillDirection.Horizontal, 8),
	})
	for i, t in { { "mat", "Материалы" }, { "item", "Особые" } } do
		tabButtons[t[1]] = Lib.button(t[2], { Size = UDim2.new(0.5, -4, 1, 0), TextSize = 17, LayoutOrder = i, Parent = tabs }, function()
			tab = t[1]
			refreshTiles()
		end)
	end
	grid = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 236),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = inner,
	}, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(94, 108), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})
	for i, m in Blocks.Materials do
		makeTile("mat", m, i)
	end
	for i, it in Blocks.Items do
		makeTile("item", it, 100 + i)
	end
	-- название и характеристики
	nameLabel = Lib.label("", 20, { FontFace = Theme.FontHeavy, LayoutOrder = 3, Parent = inner })
	statsLabel = Lib.label("", 14, { TextColor3 = Theme.Sub, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 18), Parent = inner })
	-- формы
	shapeRow = new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 5, Parent = inner }, {
		Lib.list(Enum.FillDirection.Horizontal, 6),
	})
	for _, s in Blocks.Shapes do
		local b = Lib.button(SHAPE_ICONS[s.id], { Size = UDim2.fromOffset(56, 44), TextSize = 22, LayoutOrder = s.id, Parent = shapeRow }, function()
			State.sel.shape = s.id
			State.changed:Fire("sel", State.sel)
		end)
		b:SetAttribute("Tip", s.name)
		shapeButtons[s.id] = b
	end
	-- размер
	sizeRow = new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 6, Parent = inner }, {
		Lib.list(Enum.FillDirection.Horizontal, 8),
	})
	stepper("X", "Ш", 1)
	stepper("Y", "В", 2)
	stepper("Z", "Д", 3)
	-- поворот
	local rotRow = new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 7, Parent = inner }, {
		Lib.list(Enum.FillDirection.Horizontal, 6),
	})
	Lib.button("⟳ Повернуть  R", { Size = UDim2.new(0.5, -3, 1, 0), TextSize = 15, LayoutOrder = 1, Parent = rotRow }, function()
		State.sel.rot = Grid.rotate(State.sel.rot, "Y")
		State.changed:Fire("sel", State.sel)
	end)
	Lib.button("⤾ Наклонить  T", { Size = UDim2.new(0.5, -3, 1, 0), TextSize = 15, LayoutOrder = 2, Parent = rotRow }, function()
		State.sel.rot = Grid.rotate(State.sel.rot, "X")
		State.changed:Fire("sel", State.sel)
	end)
	-- цвет
	local colorHeader = new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = 8, Parent = inner })
	Lib.label("Цвет", 16, { FontFace = Theme.FontHeavy, Size = UDim2.new(0.4, 0, 1, 0), Parent = colorHeader })
	defaultColorBtn = Lib.button("Как у материала", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(160, 28),
		TextSize = 14,
		Parent = colorHeader,
	}, function()
		State.sel.customColor = false
		State.selectBlock(State.sel.kind, State.sel.id)
	end)
	buildPalette(inner, 9)

	-- маленькая панель для покраски
	paintPanel = Lib.panel({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 20),
		Size = UDim2.fromOffset(336, 130),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	local pinner = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = paintPanel }, {
		Lib.padding(12),
		Lib.list(Enum.FillDirection.Vertical, 8),
	})
	Lib.label("🎨 Выбери цвет и кликай по блокам", 16, { FontFace = Theme.FontHeavy, LayoutOrder = 1, Parent = pinner })
	buildPalette(pinner, 2)

	State.changed:Connect(function(key)
		if key == "sel" or key == "unlocked" then
			refreshSelection()
		elseif key == "tool" or key == "modal" or key == "siege" or key == "launched" then
			BuildPanel.updateVisibility()
		end
	end)
	refreshSelection()
end

function BuildPanel.updateVisibility()
	local busy = State.inSiege() or State.launched
	panel.Visible = State.tool == "build" and not busy
	paintPanel.Visible = State.tool == "paint" and not busy
end

return BuildPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- Основной интерфейс: золото, меню справа, панель инструментов, подсказки, уведомления,
-- красная рамка при уроне, белая вспышка.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)

local new = Lib.new
local HUD = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local modals: { [string]: { shade: GuiObject, onOpen: (() -> ())?, onClose: (() -> ())? } } = {}
local toastHolder: Frame
local hotbarButtons: { [string]: TextButton } = {}
local menuButtons: { [string]: TextButton } = {}
local hintLabel: TextLabel
local goldLabel: TextLabel
local blocksLabel: TextLabel
local vignette: Frame
local flashFrame: Frame
local hotbar: Frame
local launchBar: Frame

HUD.onTool = State.newSignal()      -- (tool)
HUD.onUndo = State.newSignal()

function HUD.gui(): ScreenGui
	return gui
end

-- ОКНА ------------------------------------------------------------------------------
function HUD.registerModal(name: string, shade: GuiObject, onOpen: (() -> ())?, onClose: (() -> ())?)
	modals[name] = { shade = shade, onOpen = onOpen, onClose = onClose }
end

function HUD.openModal(name: string)
	if State.modal == name then
		HUD.closeModal()
		return
	end
	if State.modal then
		HUD.closeModal()
	end
	local m = modals[name]
	if not m then
		return
	end
	State.set("modal", name)
	if m.onOpen then
		m.onOpen()
	end
	Lib.showModal(m.shade, true)
end

function HUD.closeModal()
	local name = State.modal
	if not name then
		return
	end
	local m = modals[name]
	State.set("modal", nil)
	if m then
		Lib.showModal(m.shade, false)
		if m.onClose then
			m.onClose()
		end
	end
end

-- УВЕДОМЛЕНИЯ -----------------------------------------------------------------------
local KIND_COLORS = {
	info = Theme.Info,
	success = Theme.Good,
	warning = Theme.Accent,
	error = Theme.Bad,
	gold = Theme.Gold,
}

function HUD.toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local color = KIND_COLORS[kind or "info"] or Theme.Info
	local t = Lib.panel({
		Size = UDim2.new(0, 0, 0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.12,
		LayoutOrder = -math.floor(os.clock() * 1000),
		Parent = toastHolder,
	})
	new("Frame", {
		Size = UDim2.new(0, 5, 1, -14),
		Position = UDim2.fromOffset(8, 7),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = t,
	}, { Lib.corner(3) })
	local l = Lib.label(text, 18, {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Position = UDim2.fromOffset(22, 0),
		TextWrapped = false,
		Parent = t,
	})
	new("UIPadding", { PaddingRight = UDim.new(0, 36), Parent = t })
	local scale = new("UIScale", { Scale = 0.7, Parent = t })
	Lib.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if kind == "error" then
		SoundPlayer.play("Error")
	end
	task.delay(3.6, function()
		Lib.tween(t, 0.35, { BackgroundTransparency = 1 })
		Lib.tween(l, 0.35, { TextTransparency = 1 })
		task.wait(0.4)
		t:Destroy()
	end)
	local children = toastHolder:GetChildren()
	local count = 0
	for _, c in children do
		if c:IsA("Frame") then
			count += 1
		end
	end
	if count > 5 then
		local oldest, order = nil, -math.huge
		for _, c in children do
			if c:IsA("Frame") and c.LayoutOrder > order then
				oldest, order = c, c.LayoutOrder
			end
		end
		if oldest then
			oldest:Destroy()
		end
	end
end

-- ЭФФЕКТЫ ЭКРАНА --------------------------------------------------------------------
function HUD.flash(color: Color3, strength: number, time: number)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - math.clamp(strength, 0, 1)
	Lib.tween(flashFrame, time, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

function HUD.damage(amount: number)
	local a = math.clamp(amount / 40, 0.25, 1)
	for _, edge in vignette:GetChildren() do
		if edge:IsA("Frame") then
			edge.BackgroundTransparency = 1 - a * 0.85
			Lib.tween(edge, 0.9, { BackgroundTransparency = 1 })
		end
	end
end

function HUD.setHint(text: string)
	if hintLabel then
		hintLabel.Text = text
		hintLabel.Visible = text ~= ""
	end
end

function HUD.setHotbarVisible(v: boolean)
	hotbar.Visible = v
end

function HUD.setLaunchBar(v: boolean)
	launchBar.Visible = v
end

-- ПОСТРОЕНИЕ ------------------------------------------------------------------------
local TOOLS = {
	{ key = "build", icon = "🔨", name = "Строить", hotkey = "1" },
	{ key = "delete", icon = "🗑", name = "Удалить", hotkey = "2" },
	{ key = "paint", icon = "🎨", name = "Красить", hotkey = "3" },
	{ key = "pick", icon = "💧", name = "Пипетка", hotkey = "4" },
}

local MENU = {
	{ key = "shop", icon = "🛒", name = "Магазин", color = Color3.fromRGB(64, 170, 90) },
	{ key = "siege", icon = "💣", name = "Осада", color = Color3.fromRGB(214, 64, 52) },
	{ key = "launch", icon = "🚀", name = "Испытать", color = Color3.fromRGB(64, 120, 220) },
	{ key = "saves", icon = "💾", name = "Сохранить", color = Color3.fromRGB(120, 90, 210) },
	{ key = "settings", icon = "⚙", name = "Настройки", color = Color3.fromRGB(70, 78, 100) },
}

HUD.onMenu = State.newSignal() -- (key)

local function buildTopLeft()
	local holder = new("Frame", {
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.fromOffset(420, 52),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Horizontal, 10) })
	local goldPill = Lib.panel({ Size = UDim2.fromOffset(170, 48), BackgroundColor3 = Theme.Bg, LayoutOrder = 1, Parent = holder })
	local coin = Lib.coin(30)
	coin.Position = UDim2.fromOffset(10, 9)
	coin.Parent = goldPill
	goldLabel = Lib.label("0", 26, {
		FontFace = Theme.FontHeavy,
		Position = UDim2.fromOffset(48, 0),
		Size = UDim2.new(1, -56, 1, 0),
		TextColor3 = Theme.Gold,
		Parent = goldPill,
	})
	local blocksPill = Lib.panel({ Size = UDim2.fromOffset(170, 48), BackgroundColor3 = Theme.Bg, LayoutOrder = 2, Parent = holder })
	Lib.label("🧱", 24, { Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(32, 48), Parent = blocksPill })
	blocksLabel = Lib.label("0 / " .. Config.MaxBlocks, 20, {
		FontFace = Theme.FontHeavy,
		Position = UDim2.fromOffset(46, 0),
		Size = UDim2.new(1, -52, 1, 0),
		Parent = blocksPill,
	})
end

function HUD.setGold(amount: number, animate: boolean?)
	local old = tonumber((string.gsub(goldLabel.Text, "%s", ""))) or 0
	goldLabel.Text = Util.formatNumber(amount)
	if animate and amount > old then
		local plus = Lib.label("+" .. Util.formatNumber(amount - old), 22, {
			FontFace = Theme.FontHeavy,
			TextColor3 = Theme.Gold,
			Position = UDim2.fromOffset(60, 112),
			Size = UDim2.fromOffset(160, 30),
			Parent = gui,
		})
		new("UIStroke", { Thickness = 2, Color = Color3.fromRGB(80, 50, 0), Parent = plus })
		Lib.tween(plus, 1.2, { Position = UDim2.fromOffset(60, 80), TextTransparency = 1 })
		task.delay(1.3, function()
			plus:Destroy()
		end)
		SoundPlayer.play("Coin")
	end
end

function HUD.setBlocks(n: number)
	blocksLabel.Text = string.format("%d / %d", n, Config.MaxBlocks)
	blocksLabel.TextColor3 = n >= Config.MaxBlocks and Theme.Bad or Theme.Text
end

local function buildMenu()
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(96, 5 * 104),
		BackgroundTransparency = 1,
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Right) })
	for i, m in MENU do
		local b = Lib.button("", {
			Size = UDim2.fromOffset(92, 92),
			BackgroundColor3 = m.color,
			LayoutOrder = i,
			Parent = holder,
		}, function()
			HUD.onMenu:Fire(m.key)
		end)
		new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 180)),
			Rotation = 90,
			Parent = b,
		})
		Lib.label(m.icon, 38, {
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 46),
			Parent = b,
		})
		local l = Lib.label(m.name, 16, {
			FontFace = Theme.FontHeavy,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 1, -30),
			Size = UDim2.new(1, 0, 0, 22),
			Parent = b,
		})
		new("UIStroke", { Thickness = 1.5, Color = Color3.new(0, 0, 0), Transparency = 0.5, Parent = l })
		menuButtons[m.key] = b
	end
end

function HUD.menuButton(key: string): TextButton?
	return menuButtons[key]
end

local function buildHotbar()
	hotbar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(5 * 84 + 4 * 8 + 24, 100),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local bar = Lib.panel({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.2,
		Parent = hotbar,
	})
	local row = new("Frame", {
		Size = UDim2.new(1, -24, 1, -16),
		Position = UDim2.fromOffset(12, 8),
		BackgroundTransparency = 1,
		Parent = bar,
	}, { Lib.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	for i, t in TOOLS do
		local b = Lib.button("", { Size = UDim2.fromOffset(84, 84), LayoutOrder = i, Parent = row }, function()
			HUD.onTool:Fire(if State.tool == t.key then nil else t.key)
		end)
		Lib.label(t.icon, 32, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 40), Parent = b })
		Lib.label(t.name, 14, { FontFace = Theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -28), Size = UDim2.new(1, 0, 0, 20), Parent = b })
		Lib.label(t.hotkey, 13, { TextColor3 = Theme.Sub, Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(20, 16), Parent = b })
		hotbarButtons[t.key] = b
	end
	local undo = Lib.button("", { Size = UDim2.fromOffset(84, 84), LayoutOrder = 10, BackgroundColor3 = Theme.Panel3, Parent = row }, function()
		HUD.onUndo:Fire()
	end)
	Lib.label("↶", 34, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 42), Parent = undo })
	Lib.label("Отмена", 14, { FontFace = Theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -28), Size = UDim2.new(1, 0, 0, 20), Parent = undo })
	Lib.label("Z", 13, { TextColor3 = Theme.Sub, Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(20, 16), Parent = undo })

	hintLabel = Lib.label("", 17, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -124),
		Size = UDim2.fromOffset(900, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.fromRGB(235, 240, 255),
		Parent = gui,
	})
	new("UIStroke", { Thickness = 2, Transparency = 0.35, Parent = hintLabel })
end

function HUD.setTool(tool: string?)
	for key, b in hotbarButtons do
		local active = key == tool
		Lib.setButtonColor(b, active and Theme.Accent2 or Theme.Panel2)
		local stroke = b:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = active and Theme.Accent or Theme.Stroke
			stroke.Transparency = active and 0 or 0.82
			stroke.Thickness = active and 3 or 1.5
		end
	end
end

local function buildOverlays()
	vignette = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50, Parent = gui })
	local edges = {
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.25), UDim2.fromScale(0, 0.75), 270 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.2, 1), UDim2.fromScale(0.8, 0), 180 },
	}
	for _, e in edges do
		new("Frame", {
			Size = e[1],
			Position = e[2],
			BackgroundColor3 = Color3.fromRGB(200, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = vignette,
		}, {
			new("UIGradient", {
				Rotation = e[3],
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			}),
		})
	end
	flashFrame = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 60,
		Parent = gui,
	})
	toastHolder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(700, 300),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = gui,
	}, { Lib.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
end

local function buildLaunchBar()
	launchBar = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(620, 96),
		BackgroundColor3 = Theme.Bg,
		Visible = false,
		Parent = gui,
	})
	Lib.label("🚀 ИСПЫТАНИЕ", 24, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(20, 10), Size = UDim2.fromOffset(360, 30), TextColor3 = Theme.Info, Parent = launchBar })
	Lib.label("Сядь в кресло водителя: W/S — газ, A/D — поворот. Двигатели работают на W.", 15, {
		TextColor3 = Theme.Sub, Position = UDim2.fromOffset(20, 44), Size = UDim2.fromOffset(420, 44), Parent = launchBar,
	})
	local stop = Lib.button("■  СТОП", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(140, 60),
		BackgroundColor3 = Theme.Bad,
		TextSize = 22,
		Parent = launchBar,
	})
	stop.Activated:Connect(function()
		HUD.onMenu:Fire("launchStop")
	end)
end

function HUD.init()
	gui = new("ScreenGui", {
		Name = "BuildSurviveUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1500, vp.Y / 900), 0.5, 1.25)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	buildTopLeft()
	buildMenu()
	buildHotbar()
	buildLaunchBar()
	buildOverlays()
	HUD.setTool(nil)

	-- урон по игроку → красная рамка
	local function watch(char: Model)
		local hum = char:WaitForChild("Humanoid") :: Humanoid
		local last = hum.Health
		hum.HealthChanged:Connect(function(h)
			if h < last - 0.5 then
				HUD.damage(last - h)
			end
			last = h
		end)
	end
	player.CharacterAdded:Connect(watch)
	if player.Character then
		task.spawn(watch, player.Character)
	end

	-- Esc закрывает окно
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Escape and State.modal then
			HUD.closeModal()
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Lib</string>
            <string name="Source"><![CDATA[-- Маленькая библиотека для интерфейса: создание элементов, кнопки с анимацией, окна.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Theme)
local SoundPlayer = require(script.Parent.Parent.SoundPlayer)

local Lib = {}

-- Создать экземпляр со свойствами и детьми. Parent ставится последним.
function Lib.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local new = Lib.new

function Lib.corner(r: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r or 14) })
end

function Lib.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.86,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.padding(all: number, top: number?): UIPadding
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingBottom = UDim.new(0, top or all),
	})
end

function Lib.gradient(c0: Color3, c1: Color3, rotation: number?): UIGradient
	return new("UIGradient", { Color = ColorSequence.new(c0, c1), Rotation = rotation or 90 })
end

function Lib.list(dir: Enum.FillDirection?, pad: number?, halign: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 8),
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.tween(obj: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function Lib.label(text: string, size: number, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = {
		Text = text,
		TextSize = size,
		FontFace = Theme.Font,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size + 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return new("TextLabel", p)
end

function Lib.panel(props: { [string]: any }?): Frame
	local p: { [string]: any } = {
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		BorderSizePixel = 0,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return new("Frame", p, { Lib.corner(14), Lib.stroke() })
end

-- Кнопка с наведением, нажатием и звуком
function Lib.button(text: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local p: { [string]: any } = {
		Text = text,
		TextSize = 18,
		FontFace = Theme.FontHeavy,
		TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Panel2,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(140, 44),
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local b = new("TextButton", p, { Lib.corner(12), Lib.stroke(nil, 1.5, 0.82) })
	local scale = new("UIScale", { Parent = b })
	local base = b.BackgroundColor3
	b:SetAttribute("BaseColor", base)
	b.MouseEnter:Connect(function()
		local c = b:GetAttribute("BaseColor") or base
		Lib.tween(b, 0.12, { BackgroundColor3 = c:Lerp(Color3.new(1, 1, 1), 0.12) })
		Lib.tween(scale, 0.12, { Scale = 1.04 })
		SoundPlayer.play("Hover")
	end)
	b.MouseLeave:Connect(function()
		Lib.tween(b, 0.15, { BackgroundColor3 = b:GetAttribute("BaseColor") or base })
		Lib.tween(scale, 0.15, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		Lib.tween(scale, 0.06, { Scale = 0.95 })
	end)
	b.MouseButton1Up:Connect(function()
		Lib.tween(scale, 0.1, { Scale = 1.04 })
	end)
	if onClick then
		b.Activated:Connect(function()
			SoundPlayer.play("Click")
			onClick()
		end)
	end
	return b
end

function Lib.setButtonColor(b: GuiObject, color: Color3)
	b:SetAttribute("BaseColor", color)
	Lib.tween(b, 0.15, { BackgroundColor3 = color })
end

-- Модальное окно по центру экрана с заголовком и крестиком
function Lib.modal(parent: Instance, title: string, size: Vector2, onClose: (() -> ())?): (Frame, Frame)
	local shade = new("TextButton", {
		Name = "Shade",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local win = Lib.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.04,
		ZIndex = 21,
		Parent = shade,
	})
	new("UIScale", { Name = "Pop", Parent = win })
	new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Theme.Panel2,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = win,
	}, {
		Lib.corner(14),
		Lib.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 190), 90),
		Lib.label(title, 26, {
			FontFace = Theme.FontHeavy,
			Position = UDim2.fromOffset(22, 0),
			Size = UDim2.new(1, -90, 1, 0),
			ZIndex = 22,
		}),
	})
	local close = Lib.button("✕", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 9),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Theme.Bad,
		TextSize = 20,
		ZIndex = 23,
		Parent = win,
	})
	close.Activated:Connect(function()
		if onClose then
			onClose()
		end
	end)
	local body = new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = win,
	}, { Lib.padding(18) })
	return shade :: any, body
end

function Lib.showModal(shade: GuiObject, visible: boolean)
	local win = shade:FindFirstChild("Window") :: Frame
	local pop = win and win:FindFirstChild("Pop") :: UIScale
	if visible then
		shade.Visible = true
		shade.BackgroundTransparency = 1
		Lib.tween(shade, 0.2, { BackgroundTransparency = 0.45 })
		if pop then
			pop.Scale = 0.85
			Lib.tween(pop, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	else
		Lib.tween(shade, 0.15, { BackgroundTransparency = 1 })
		if pop then
			Lib.tween(pop, 0.15, { Scale = 0.9 })
		end
		task.delay(0.15, function()
			shade.Visible = false
		end)
	end
end

-- Превью блока в ViewportFrame (медленно вращается)
local spinning: { { cam: Camera, model: Model, angle: number, dist: number, center: Vector3 } } = {}
local spinConn: RBXScriptConnection? = nil

function Lib.viewport(build: () -> Instance, props: { [string]: any }?, spin: boolean?): ViewportFrame
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 155, 170),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1.4, -0.6),
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local vp = new("ViewportFrame", p)
	local model = new("Model", { Parent = vp })
	local inst = build()
	inst.Parent = model
	local cam = new("Camera", { FieldOfView = 30, Parent = vp })
	vp.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local dist = size.Magnitude * 1.65 + 1
	local entry = { cam = cam, model = model, angle = math.rad(35), dist = dist, center = cf.Position }
	local function place()
		local a = entry.angle
		local offset = Vector3.new(math.sin(a), 0.55, math.cos(a)).Unit * entry.dist
		cam.CFrame = CFrame.lookAt(entry.center + offset, entry.center)
	end
	place()
	if spin then
		table.insert(spinning, entry)
		if not spinConn then
			spinConn = RunService.RenderStepped:Connect(function(dt)
				for i = #spinning, 1, -1 do
					local e = spinning[i]
					if not e.cam.Parent then
						table.remove(spinning, i)
					else
						e.angle += dt * 0.6
						local off = Vector3.new(math.sin(e.angle), 0.55, math.cos(e.angle)).Unit * e.dist
						e.cam.CFrame = CFrame.lookAt(e.center + off, e.center)
					end
				end
			end)
		end
	end
	return vp
end

-- Монетка (рисуется рамками, без картинок)
function Lib.coin(size: number): Frame
	return new("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
	}, {
		Lib.corner(size),
		new("UIStroke", { Color = Color3.fromRGB(190, 120, 20), Thickness = math.max(1.5, size / 12) }),
		new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 170, 30)),
			Rotation = 45,
		}),
		new("TextLabel", {
			Text = "$",
			TextSize = size * 0.62,
			FontFace = Theme.FontHeavy,
			TextColor3 = Color3.fromRGB(160, 96, 10),
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
		}),
	})
end

return Lib
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">SavesUI</string>
            <string name="Source"><![CDATA[-- Окно сохранений: 3 слота и очистка участка.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)
local Examples = require(Shared.Examples)

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)
local HUD = require(script.Parent.HUD)

local new = Lib.new
local SavesUI = {}

local infoLabels: { TextLabel } = {}
local note: TextLabel
local clearBtn: TextButton
local confirmClear = false

local function refresh()
	for i = 1, Config.SaveSlots do
		local info = State.slots[i]
		if info then
			infoLabels[i].Text = string.format("%d %s • %s", info.count, Util.plural(info.count, "блок", "блока", "блоков"), os.date("%d.%m %H:%M", info.time))
			infoLabels[i].TextColor3 = Theme.Text
		else
			infoLabels[i].Text = "Пусто"
			infoLabels[i].TextColor3 = Theme.Muted
		end
	end
	note.Text = State.saveEnabled and "Постройка на участке сохраняется автоматически, когда ты выходишь из игры."
		or "⚠ Сохранения выключены: опубликуй игру и включи Game Settings → Security → Enable Studio Access to API Services."
	note.TextColor3 = State.saveEnabled and Theme.Sub or Theme.Accent
	confirmClear = false
	clearBtn.Text = "🧹 Очистить участок"
end

local function call(name: string, ...: any)
	local args = { ... }
	task.spawn(function()
		local ok, msg = Net.func(name):InvokeServer(table.unpack(args))
		if msg then
			HUD.toast(msg, ok and "success" or "error")
		end
	end)
end

function SavesUI.init()
	local shade, body = Lib.modal(HUD.gui(), "💾 СОХРАНЕНИЯ", Vector2.new(660, 640), function()
		HUD.closeModal()
	end)
	local holder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body }, { Lib.list(Enum.FillDirection.Vertical, 10) })
	for i = 1, Config.SaveSlots do
		local row = Lib.panel({ Size = UDim2.new(1, 0, 0, 72), BackgroundColor3 = Theme.Panel2, LayoutOrder = i, Parent = holder })
		Lib.label("Слот " .. i, 20, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(16, 10), Size = UDim2.fromOffset(200, 26), Parent = row })
		infoLabels[i] = Lib.label("Пусто", 15, { Position = UDim2.fromOffset(16, 38), Size = UDim2.fromOffset(280, 22), Parent = row })
		Lib.button("Сохранить", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -150, 0.5, 0),
			Size = UDim2.fromOffset(130, 44),
			BackgroundColor3 = Theme.Good,
			TextSize = 17,
			Parent = row,
		}, function()
			call("SaveSlot", i)
		end)
		Lib.button("Загрузить", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(130, 44),
			BackgroundColor3 = Theme.Info,
			TextSize = 17,
			Parent = row,
		}, function()
			call("LoadSlot", i)
		end)
	end
	clearBtn = Lib.button("🧹 Очистить участок", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = Color3.fromRGB(120, 40, 40),
		LayoutOrder = 10,
		Parent = holder,
	}, function()
		if not confirmClear then
			confirmClear = true
			clearBtn.Text = "Точно? Нажми ещё раз (отменить можно Ctrl+Z)"
			return
		end
		confirmClear = false
		clearBtn.Text = "🧹 Очистить участок"
		call("Clear")
	end)
	note = Lib.label("", 14, { LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 40), Parent = holder })
	-- готовые примеры
	Lib.label("Примеры построек", 18, { FontFace = Theme.FontHeavy, LayoutOrder = 12, Parent = holder })
	local exRow = new("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundTransparency = 1, LayoutOrder = 13, Parent = holder }, {
		Lib.list(Enum.FillDirection.Horizontal, 8),
	})
	local icons = { "🏠", "🛡", "🤖", "🚜" }
	for i, ex in Examples do
		local b = Lib.button(icons[i] .. " " .. ex.name, {
			Size = UDim2.new(0.25, -6, 1, 0),
			TextSize = 14,
			TextWrapped = true,
			BackgroundColor3 = Theme.Panel3,
			LayoutOrder = i,
			Parent = exRow,
		}, function()
			call("LoadExample", i)
		end)
		b:SetAttribute("Tip", ex.desc)
	end
	HUD.registerModal("saves", shade, refresh)
	State.changed:Connect(function(key)
		if (key == "slots" or key == "saveEnabled") and State.modal == "saves" then
			refresh()
		end
	end)
end

return SavesUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SettingsUI</string>
            <string name="Source"><![CDATA[-- Окно настроек: громкость, качество графики, тряска камеры, сетка.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local State = require(Client.State)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)
local HUD = require(script.Parent.HUD)

local new = Lib.new
local SettingsUI = {}

SettingsUI.onChanged = State.newSignal()

local refreshers: { () -> () } = {}

local function save()
	SettingsUI.onChanged:Fire(State.settings)
	task.spawn(function()
		Net.func("SetSettings"):InvokeServer(State.settings)
	end)
end

local function row(parent: Instance, title: string, order: number): Frame
	local r = Lib.panel({ Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Theme.Panel2, LayoutOrder = order, Parent = parent })
	Lib.label(title, 18, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(220, 60), TextYAlignment = Enum.TextYAlignment.Center, Parent = r })
	return r
end

local function volumeRow(parent: Instance, title: string, key: string, order: number)
	local r = row(parent, title, order)
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(300, 36),
		BackgroundTransparency = 1,
		Parent = r,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6) })
	local buttons = {}
	for i = 0, 5 do
		local v = i / 5
		buttons[i] = Lib.button(i == 0 and "🔇" or tostring(i * 20), { Size = UDim2.fromOffset(44, 36), TextSize = 14, LayoutOrder = i, Parent = holder }, function()
			State.settings[key] = v
			save()
			for _, f in refreshers do
				f()
			end
		end)
	end
	table.insert(refreshers, function()
		for i, b in buttons do
			Lib.setButtonColor(b, math.abs((State.settings[key] or 0) - i / 5) < 0.05 and Theme.Accent2 or Theme.Panel3)
		end
	end)
end

local function choiceRow(parent: Instance, title: string, key: string, options: { { any } }, order: number)
	local r = row(parent, title, order)
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(330, 36),
		BackgroundTransparency = 1,
		Parent = r,
	}, { Lib.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
	local buttons = {}
	for i, o in options do
		buttons[i] = Lib.button(o[2], { Size = UDim2.fromOffset(104, 36), TextSize = 15, LayoutOrder = i, Parent = holder }, function()
			State.settings[key] = o[1]
			save()
			for _, f in refreshers do
				f()
			end
		end)
	end
	table.insert(refreshers, function()
		for i, b in buttons do
			Lib.setButtonColor(b, State.settings[key] == options[i][1] and Theme.Accent2 or Theme.Panel3)
		end
	end)
end

function SettingsUI.init()
	local shade, body = Lib.modal(HUD.gui(), "⚙ НАСТРОЙКИ", Vector2.new(640, 520), function()
		HUD.closeModal()
	end)
	local holder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body }, { Lib.list(Enum.FillDirection.Vertical, 10) })
	volumeRow(holder, "🎵 Музыка", "Music", 1)
	volumeRow(holder, "🔊 Звуки", "Sfx", 2)
	choiceRow(holder, "✨ Графика", "Graphics", { { 1, "Низкая" }, { 2, "Средняя" }, { 3, "Ультра" } }, 3)
	choiceRow(holder, "📳 Тряска камеры", "CameraShake", { { true, "Вкл" }, { false, "Выкл" } }, 4)
	choiceRow(holder, "▦ Сетка на участке", "ShowGrid", { { true, "Вкл" }, { false, "Выкл" } }, 5)
	Lib.label("Совет: на слабом телефоне выбери «Низкая» — исчезнут тени и размытие, взрывы станут проще.", 14, {
		TextColor3 = Theme.Sub,
		LayoutOrder = 6,
		Size = UDim2.new(1, 0, 0, 40),
		Parent = holder,
	})
	HUD.registerModal("settings", shade, function()
		for _, f in refreshers do
			f()
		end
	end)
end

return SettingsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[-- Окно магазина: материалы и особые блоки с 3D-превью, прочностью и ценой.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local BlockFactory = require(Shared.BlockFactory)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)
local HUD = require(script.Parent.HUD)

local new = Lib.new
local ShopUI = {}

local cards: { { kind: string, def: any, button: TextButton, frame: Frame } } = {}
local list: ScrollingFrame
local tab = "mat"
local tabButtons: { [string]: TextButton } = {}
local goldLabel: TextLabel

local function stars(value: number, max: number): string
	local n = math.clamp(math.ceil(value / max * 5), 1, 5)
	return string.rep("★", n) .. string.rep("☆", 5 - n)
end

local function refresh()
	goldLabel.Text = Util.formatNumber(State.gold)
	for k, b in tabButtons do
		Lib.setButtonColor(b, k == tab and Theme.Accent2 or Theme.Panel2)
	end
	for _, c in cards do
		c.frame.Visible = c.kind == tab
		local owned = State.isUnlocked(c.kind, c.def.id)
		if c.def.price <= 0 then
			c.button.Text = "БЕСПЛАТНО"
			Lib.setButtonColor(c.button, Theme.Panel3)
		elseif owned then
			c.button.Text = "✔ КУПЛЕНО"
			Lib.setButtonColor(c.button, Theme.Panel3)
		else
			c.button.Text = Util.formatNumber(c.def.price)
			Lib.setButtonColor(c.button, State.gold >= c.def.price and Theme.Good or Color3.fromRGB(90, 70, 50))
		end
	end
end

local function makeCard(kind: string, def, order: number)
	local frame = Lib.panel({
		Size = UDim2.fromOffset(196, 268),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = order,
		Parent = list,
	})
	local vpBox = new("Frame", {
		Size = UDim2.new(1, -16, 0, 110),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Panel2,
		Parent = frame,
	}, { Lib.corner(10), Lib.gradient(Color3.fromRGB(70, 80, 110), Color3.fromRGB(28, 32, 46), 90) })
	local spec = kind == "item" and { mat = 0, shape = 1, item = def.id, size = def.size, rot = 1, color = def.color }
		or { mat = def.id, shape = 1, item = 0, size = Vector3.new(2, 2, 2), rot = 1, color = def.color }
	local vp = Lib.viewport(function()
		return BlockFactory.build(spec, CFrame.identity, { preview = true })
	end, nil, true)
	vp.Parent = vpBox
	Lib.label(def.name, 19, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(10, 122), Size = UDim2.new(1, -20, 0, 24), Parent = frame })
	Lib.label(def.desc or "", 13, {
		TextColor3 = Theme.Sub,
		Position = UDim2.fromOffset(10, 148),
		Size = UDim2.new(1, -20, 0, 34),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
	local statText = string.format("Прочность %s\nЗащита от взрыва %s", stars(def.hp, 2800), stars((def.blast or 0.3) * 100, 90))
	if (def.nuke or 0) >= 0.85 then
		statText ..= "\n☢ Защита от радиации"
	end
	Lib.label(statText, 13, {
		TextColor3 = Theme.Accent,
		Position = UDim2.fromOffset(10, 184),
		Size = UDim2.new(1, -20, 0, 36),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
	local button = Lib.button("", {
		Position = UDim2.new(0, 10, 1, -44),
		Size = UDim2.new(1, -20, 0, 36),
		TextSize = 17,
		Parent = frame,
	})
	button.Activated:Connect(function()
		if def.price <= 0 or State.isUnlocked(kind, def.id) then
			State.selectBlock(kind, def.id)
			HUD.closeModal()
			return
		end
		local ok, msg = Net.func("Buy"):InvokeServer(kind, def.id)
		if ok then
			SoundPlayer.play("Purchase")
			HUD.toast(msg or "Куплено", "success")
			State.selectBlock(kind, def.id)
		elseif msg then
			HUD.toast(msg, "error")
		end
	end)
	table.insert(cards, { kind = kind, def = def, button = button, frame = frame })
end

function ShopUI.init()
	local shade, body = Lib.modal(HUD.gui(), "🛒 МАГАЗИН БЛОКОВ", Vector2.new(900, 640), function()
		HUD.closeModal()
	end)
	local top = new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = body })
	for i, t in { { "mat", "Материалы" }, { "item", "Особые блоки" } } do
		tabButtons[t[1]] = Lib.button(t[2], {
			Position = UDim2.fromOffset((i - 1) * 190, 0),
			Size = UDim2.fromOffset(180, 42),
			Parent = top,
		}, function()
			tab = t[1]
			refresh()
		end)
	end
	local goldPill = Lib.panel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(190, 42),
		BackgroundColor3 = Theme.Panel2,
		Parent = top,
	})
	local coin = Lib.coin(26)
	coin.Position = UDim2.fromOffset(10, 8)
	coin.Parent = goldPill
	goldLabel = Lib.label("0", 22, { FontFace = Theme.FontHeavy, TextColor3 = Theme.Gold, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -52, 1, 0), Parent = goldPill })

	list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = body,
	}, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 268), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})
	for i, m in Blocks.Materials do
		makeCard("mat", m, i)
	end
	for i, it in Blocks.Items do
		makeCard("item", it, 100 + i)
	end
	HUD.registerModal("shop", shade, refresh)
	State.changed:Connect(function(key)
		if key == "gold" or key == "unlocked" then
			if State.modal == "shop" then
				refresh()
			end
		end
	end)
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">SiegeUI</string>
            <string name="Source"><![CDATA[-- Осада в интерфейсе: меню выбора режима, панель волны, полигон, предупреждения, итоги.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local Client = script.Parent.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local Theme = require(script.Parent.Theme)
local Lib = require(script.Parent.Lib)
local HUD = require(script.Parent.HUD)

local new = Lib.new
local SiegeUI = {}

local player = Players.LocalPlayer
local mode = "survival"
local difficulty = 2
local modeCards: { [string]: TextButton } = {}
local diffButtons: { TextButton } = {}
local recordLabel: TextLabel

local waveBar: Frame
local waveTitle: TextLabel
local waveSub: TextLabel
local waveFill: Frame
local bigText: TextLabel
local bigSub: TextLabel
local rangePanel: Frame
local weaponButtons: { [string]: TextButton } = {}
local targetBtn: TextButton
local warnBanner: Frame
local warnText: TextLabel
local resultBody: Frame

local waveEndsAt = 0
local waveDuration = 1
local warnUntil = 0

local function waveColor(i: number): Color3
	local t = (i - 1) / (#Weapons.List - 1)
	return Color3.fromRGB(80, 200, 110):Lerp(Color3.fromRGB(255, 190, 50), math.min(1, t * 2)):Lerp(Color3.fromRGB(235, 50, 50), math.max(0, t * 2 - 1))
end

-- МЕНЮ ------------------------------------------------------------------------------
local function refreshMenu()
	for k, b in modeCards do
		local on = k == mode
		local stroke = b:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = on and Theme.Accent or Theme.Stroke
			stroke.Transparency = on and 0 or 0.85
			stroke.Thickness = on and 3 or 1.5
		end
		Lib.setButtonColor(b, on and Theme.Panel3 or Theme.Panel2)
	end
	for i, b in diffButtons do
		local d = Config.Difficulties[i]
		Lib.setButtonColor(b, i == difficulty and d.color or Theme.Panel2)
		b.Visible = mode == "survival"
	end
	recordLabel.Text = string.format("Твой рекорд: волна %d  •  Пережито ядерок: %d", State.bestWave, State.stats.Nukes or 0)
end

local function buildMenu()
	local shade, body = Lib.modal(HUD.gui(), "💣 ОСАДА", Vector2.new(940, 620), function()
		HUD.closeModal()
	end)
	local left = new("Frame", { Size = UDim2.new(0.52, -10, 1, 0), BackgroundTransparency = 1, Parent = body }, { Lib.list(Enum.FillDirection.Vertical, 12) })
	local cardsInfo = {
		{ "survival", "🛡 ВЫЖИВАНИЕ", "Волна за волной: пули, мины, ракеты... На 11-й волне — ядерная бомба, на 12-й — орбитальный лазер. Чем дольше живёшь — тем больше золота." },
		{ "range", "🎯 ПОЛИГОН", "Выбирай любое оружие и стреляй по своей постройке сам. Проверь, выдержит ли бункер ядерный удар. Без награды." },
	}
	for i, c in cardsInfo do
		local b = Lib.button("", { Size = UDim2.new(1, 0, 0, 132), LayoutOrder = i, Parent = left }, function()
			mode = c[1]
			refreshMenu()
		end)
		Lib.label(c[2], 24, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 30), Parent = b })
		Lib.label(c[3], 15, {
			TextColor3 = Theme.Sub,
			Position = UDim2.fromOffset(16, 46),
			Size = UDim2.new(1, -32, 0, 80),
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = b,
		})
		modeCards[c[1]] = b
	end
	Lib.label("Сложность", 18, { FontFace = Theme.FontHeavy, LayoutOrder = 3, Parent = left })
	local diffRow = new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 4, Parent = left }, {
		Lib.list(Enum.FillDirection.Horizontal, 8),
	})
	for i, d in Config.Difficulties do
		diffButtons[i] = Lib.button(d.name, { Size = UDim2.new(0.25, -6, 1, 0), TextSize = 15, LayoutOrder = i, Parent = diffRow }, function()
			difficulty = i
			refreshMenu()
		end)
	end
	recordLabel = Lib.label("", 15, { TextColor3 = Theme.Sub, LayoutOrder = 5, Parent = left })
	local start = Lib.button("НАЧАТЬ ОСАДУ", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Theme.Bad,
		TextSize = 26,
		LayoutOrder = 6,
		Parent = left,
	})
	new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 170, 170)), Rotation = 90, Parent = start })
	start.Activated:Connect(function()
		SoundPlayer.play("Click")
		local ok, msg = Net.func("StartSiege"):InvokeServer(mode, difficulty)
		if ok then
			HUD.closeModal()
		elseif msg then
			HUD.toast(msg, "error")
		end
	end)

	-- список оружия
	local right = Lib.panel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.48, -10, 1, 0),
		BackgroundColor3 = Theme.Panel,
		Parent = body,
	})
	Lib.label("Что прилетит", 18, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Parent = right })
	local rows = new("Frame", { Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 1, -46), BackgroundTransparency = 1, Parent = right }, {
		Lib.list(Enum.FillDirection.Vertical, 3),
	})
	for i, w in Weapons.List do
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Panel2, BackgroundTransparency = 0.3, LayoutOrder = i, Parent = rows }, { Lib.corner(8) })
		new("Frame", { Size = UDim2.new(0, 5, 1, -10), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = waveColor(i), BorderSizePixel = 0, Parent = row }, { Lib.corner(3) })
		Lib.label(w.icon, 20, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(28, 38), TextYAlignment = Enum.TextYAlignment.Center, Parent = row })
		Lib.label(w.name, 16, { FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -140, 1, 0), TextYAlignment = Enum.TextYAlignment.Center, Parent = row })
		Lib.label("волна " .. w.wave, 14, {
			TextColor3 = waveColor(i),
			TextXAlignment = Enum.TextXAlignment.Right,
			Position = UDim2.new(1, -96, 0, 0),
			Size = UDim2.fromOffset(86, 38),
			TextYAlignment = Enum.TextYAlignment.Center,
			Parent = row,
		})
	end
	HUD.registerModal("siege", shade, refreshMenu)
end

-- ПАНЕЛЬ ВОЛНЫ --------------------------------------------------------------------------
local function buildWaveBar()
	local gui = HUD.gui()
	waveBar = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(520, 92),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	waveTitle = Lib.label("ВОЛНА 1", 30, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 34),
		Parent = waveBar,
	})
	waveSub = Lib.label("", 16, {
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Accent,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = waveBar,
	})
	local track = new("Frame", {
		Position = UDim2.new(0, 20, 1, -22),
		Size = UDim2.new(1, -40, 0, 10),
		BackgroundColor3 = Theme.Panel2,
		BorderSizePixel = 0,
		Parent = waveBar,
	}, { Lib.corner(5) })
	waveFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track }, {
		Lib.corner(5),
		Lib.gradient(Theme.Accent, Theme.Accent2, 0),
	})
	local giveUp = Lib.button("Сдаться", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 10, 0.5, 0),
		Size = UDim2.fromOffset(110, 44),
		BackgroundColor3 = Theme.Panel3,
		TextSize = 16,
		Parent = waveBar,
	})
	giveUp.Activated:Connect(function()
		Net.func("StopSiege"):InvokeServer()
	end)

	bigText = Lib.label("", 64, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(900, 80),
		Visible = false,
		Parent = gui,
	})
	new("UIStroke", { Thickness = 4, Color = Color3.fromRGB(40, 10, 0), Parent = bigText })
	bigSub = Lib.label("", 26, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromOffset(900, 40),
		TextColor3 = Theme.Accent,
		Visible = false,
		Parent = gui,
	})
	new("UIStroke", { Thickness = 3, Color = Color3.fromRGB(20, 10, 0), Parent = bigSub })

	warnBanner = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 166),
		Size = UDim2.fromOffset(760, 64),
		BackgroundColor3 = Color3.fromRGB(150, 16, 16),
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = gui,
	})
	warnText = Lib.label("", 26, {
		FontFace = Theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = warnBanner,
	})
end

local bigToken = 0
local function showBig(text: string, sub: string?, color: Color3?, time: number?)
	bigToken += 1
	local token = bigToken
	bigText.Text = text
	bigText.TextColor3 = color or Theme.Text
	bigText.Visible = true
	bigText.TextTransparency = 0
	bigSub.Text = sub or ""
	bigSub.Visible = sub ~= nil
	bigSub.TextTransparency = 0
	local scale = bigText:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = bigText })
	scale.Scale = 1.5
	Lib.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(time or 1.6, function()
		if token ~= bigToken then
			return
		end
		Lib.tween(bigText, 0.4, { TextTransparency = 1 })
		Lib.tween(bigSub, 0.4, { TextTransparency = 1 })
		task.wait(0.45)
		if token == bigToken then
			bigText.Visible = false
			bigSub.Visible = false
		end
	end)
end

function SiegeUI.warn(text: string, duration: number)
	warnText.Text = text
	warnBanner.Visible = true
	warnUntil = os.clock() + duration
end

-- ПОЛИГОН ---------------------------------------------------------------------------
local function refreshRange()
	for key, b in weaponButtons do
		Lib.setButtonColor(b, (State.rangeTarget == "click" and State.rangeWeapon == key) and Theme.Accent2 or Theme.Panel2)
	end
	targetBtn.Text = State.rangeTarget == "me" and "🎯 Цель: я" or "👆 Цель: клик"
end

local function fireRange(key: string, aim: Vector3?)
	task.spawn(function()
		local ok, msg = Net.func("FireRange"):InvokeServer(key, aim)
		if not ok and msg then
			HUD.toast(msg, "warning")
		end
	end)
end

local function buildRange()
	rangePanel = Lib.panel({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(880, 168),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = HUD.gui(),
	})
	local gridFrame = new("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -200, 1, -24), BackgroundTransparency = 1, Parent = rangePanel }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(106, 66), CellPadding = UDim2.fromOffset(6, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, w in Weapons.List do
		local b = Lib.button("", { LayoutOrder = i, Parent = gridFrame }, function()
			if State.rangeTarget == "me" then
				fireRange(w.key, nil)
			else
				State.rangeWeapon = w.key
				refreshRange()
			end
		end)
		Lib.label(w.icon, 22, { TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 26), TextColor3 = waveColor(i), Parent = b })
		Lib.label(w.name, 12, {
			FontFace = Theme.FontHeavy,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 30),
			Size = UDim2.new(1, -4, 0, 32),
			TextYAlignment = Enum.TextYAlignment.Center,
			Parent = b,
		})
		weaponButtons[w.key] = b
	end
	local side = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, 172, 1, -24), BackgroundTransparency = 1, Parent = rangePanel }, {
		Lib.list(Enum.FillDirection.Vertical, 8),
	})
	targetBtn = Lib.button("", { Size = UDim2.new(1, 0, 0, 40), TextSize = 16, LayoutOrder = 1, Parent = side }, function()
		State.rangeTarget = State.rangeTarget == "me" and "click" or "me"
		if State.rangeTarget == "click" then
			HUD.toast("Выбери оружие и кликни по постройке", "info")
		end
		refreshRange()
	end)
	Lib.button("↺ Восстановить", { Size = UDim2.new(1, 0, 0, 40), TextSize = 16, BackgroundColor3 = Theme.Info, LayoutOrder = 2, Parent = side }, function()
		task.spawn(function()
			local ok, msg = Net.func("Restore"):InvokeServer()
			if ok and msg then
				HUD.toast(msg, "success")
			end
		end)
	end)
	Lib.button("✕ Выйти", { Size = UDim2.new(1, 0, 0, 40), TextSize = 16, BackgroundColor3 = Theme.Bad, LayoutOrder = 3, Parent = side }, function()
		task.spawn(function()
			Net.func("StopSiege"):InvokeServer()
		end)
	end)
	refreshRange()

	-- выстрел кликом по миру
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not State.inSiege() or State.siege.mode ~= "range" or State.rangeTarget ~= "click" then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local ray
		if input.UserInputType == Enum.UserInputType.Touch then
			ray = workspace.CurrentCamera:ScreenPointToRay(input.Position.X, input.Position.Y)
		else
			local m = UserInputService:GetMouseLocation()
			ray = workspace.CurrentCamera:ViewportPointToRay(m.X, m.Y)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Instance }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
		if hit then
			fireRange(State.rangeWeapon, hit.Position)
		end
	end)
end

-- ИТОГИ -----------------------------------------------------------------------------
local function buildResults()
	local shade, body = Lib.modal(HUD.gui(), "ОСАДА ОКОНЧЕНА", Vector2.new(560, 460), function()
		HUD.closeModal()
	end)
	resultBody = body
	HUD.registerModal("results", shade)
end

local REASONS = {
	died = "Тебя уничтожили",
	fled = "Ты покинул остров",
	stop = "Ты сдался",
}

local function showResults(r)
	for _, c in resultBody:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	local holder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = resultBody }, { Lib.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center) })
	Lib.label(REASONS[r.reason] or "", 20, { TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Parent = holder })
	if r.record then
		local badge = Lib.label("🏆 НОВЫЙ РЕКОРД!", 30, {
			FontFace = Theme.FontHeavy,
			TextColor3 = Theme.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = 2,
			Parent = holder,
		})
		new("UIStroke", { Thickness = 2, Color = Color3.fromRGB(80, 50, 0), Parent = badge })
	end
	local statsGrid = new("Frame", { Size = UDim2.new(1, 0, 0, 200), BackgroundTransparency = 1, LayoutOrder = 3, Parent = holder }, {
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 94), CellPadding = UDim2.fromOffset(12, 12) }),
	})
	local stats = {
		{ "Волн пережито", tostring(r.waves), Theme.Accent },
		{ "Заработано", "+" .. Util.formatNumber(r.gold), Theme.Gold },
		{ "Разрушено блоков", Util.formatNumber(r.blocksLost), Theme.Bad },
		{ "Время", Util.formatTime(r.time), Theme.Info },
	}
	for _, s in stats do
		local card = Lib.panel({ BackgroundColor3 = Theme.Panel2, Parent = statsGrid })
		Lib.label(s[1], 15, { TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 20), Parent = card })
		Lib.label(s[2], 34, { FontFace = Theme.FontHeavy, TextColor3 = s[3], TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 40), Parent = card })
	end
	Lib.label("Постройка сейчас восстановится. Улучши её в магазине и попробуй снова!", 15, {
		TextColor3 = Theme.Sub,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 4,
		Parent = holder,
	})
	Lib.button("OK", { Size = UDim2.fromOffset(200, 50), BackgroundColor3 = Theme.Good, TextSize = 22, LayoutOrder = 5, Parent = holder }, function()
		HUD.closeModal()
	end)
	HUD.openModal("results")
	SoundPlayer.play(r.waves >= 5 and "WaveClear" or "Defeat")
end

-- СОБЫТИЯ ---------------------------------------------------------------------------
local function onState(s)
	State.set("siege", s)
	local active = s.active
	local survival = active and s.mode == "survival"
	waveBar.Visible = survival
	rangePanel.Visible = active and s.mode == "range"
	HUD.setHotbarVisible(not active and not State.launched)
	if not active then
		warnBanner.Visible = false
		return
	end
	if s.phase == "countdown" then
		showBig(tostring(s.n), "Приготовься! Спрячься в своей постройке", Theme.Accent, 0.9)
		SoundPlayer.play("Warning")
		waveTitle.Text = "ПОДГОТОВКА"
		waveSub.Text = Config.Difficulties[s.difficulty].name .. " сложность"
		waveFill.Size = UDim2.fromScale(0, 1)
	elseif s.phase == "wave" then
		local w = Weapons.ByKey[s.headline]
		waveTitle.Text = "ВОЛНА " .. s.wave
		waveSub.Text = (s.newWeapon and "Новое: " or "") .. (w and (w.icon .. " " .. w.name) or "")
		waveEndsAt = os.clock() + s.duration
		waveDuration = s.duration
		local sub = s.newWeapon and ("Новое оружие: " .. w.name) or (w and w.name or nil)
		showBig("ВОЛНА " .. s.wave, sub, s.wave >= 10 and Theme.Bad or Theme.Text, 1.8)
		SoundPlayer.play("WaveStart")
	elseif s.phase == "cleared" then
		showBig("ВОЛНА ПРОЙДЕНА", "+" .. Util.formatNumber(s.reward) .. " золота", Theme.Good, 2.2)
		SoundPlayer.play("WaveClear")
		waveFill.Size = UDim2.fromScale(1, 1)
	elseif s.phase == "range" then
		HUD.toast("Полигон: стреляй по своей постройке. «Восстановить» — вернуть всё как было", "info")
	end
end

function SiegeUI.init()
	buildMenu()
	buildWaveBar()
	buildRange()
	buildResults()
	Net.event("SiegeState").OnClientEvent:Connect(onState)
	Net.event("SiegeResult").OnClientEvent:Connect(showResults)
	Net.event("Warning").OnClientEvent:Connect(function(data)
		if data.plot ~= player:GetAttribute("Plot") then
			return
		end
		if data.kind == "nuke" then
			SiegeUI.warn("☢ ЯДЕРНЫЙ УДАР! СПРЯЧЬСЯ ЗА ТОЛСТЫЕ СТЕНЫ!", data.t)
			SoundPlayer.play("Siren")
		end
	end)
	Net.event("LaserState").OnClientEvent:Connect(function(data)
		if data.phase == "charge" then
			local plotIndex = player:GetAttribute("Plot")
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if plotIndex and root and (root.Position - data.p).Magnitude < 160 then
				SiegeUI.warn("☼ ОРБИТАЛЬНЫЙ ЛАЗЕР НАВОДИТСЯ НА ТЕБЯ — БЕГИ ПОД КРЫШУ!", data.t + 1)
				SoundPlayer.play("Alarm")
			end
		end
	end)
	-- полоска времени волны и мигание предупреждения
	game:GetService("RunService").RenderStepped:Connect(function()
		if waveBar.Visible and State.siege and State.siege.phase == "wave" then
			local left = waveEndsAt - os.clock()
			waveFill.Size = UDim2.fromScale(math.clamp(1 - left / waveDuration, 0, 1), 1)
		end
		if warnBanner.Visible then
			local left = warnUntil - os.clock()
			if left <= 0 then
				warnBanner.Visible = false
			else
				warnBanner.BackgroundTransparency = 0.05 + (math.sin(os.clock() * 10) + 1) * 0.2
			end
		end
	end)
end

return SiegeUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[-- Цвета и шрифты интерфейса.
local Theme = {}

local FAMILY = "rbxasset://fonts/families/BuilderSans.json"
Theme.Font = Font.new(FAMILY, Enum.FontWeight.Bold)
Theme.FontHeavy = Font.new(FAMILY, Enum.FontWeight.Heavy)
Theme.FontMedium = Font.new(FAMILY, Enum.FontWeight.Medium)

Theme.Bg = Color3.fromRGB(12, 15, 24)
Theme.Panel = Color3.fromRGB(22, 27, 40)
Theme.Panel2 = Color3.fromRGB(32, 38, 56)
Theme.Panel3 = Color3.fromRGB(44, 52, 74)
Theme.Stroke = Color3.fromRGB(255, 255, 255)

Theme.Text = Color3.fromRGB(242, 245, 252)
Theme.Sub = Color3.fromRGB(150, 160, 186)
Theme.Muted = Color3.fromRGB(96, 104, 128)

Theme.Accent = Color3.fromRGB(255, 186, 48)
Theme.Accent2 = Color3.fromRGB(255, 122, 40)
Theme.Good = Color3.fromRGB(72, 214, 126)
Theme.Bad = Color3.fromRGB(240, 70, 70)
Theme.Info = Color3.fromRGB(86, 168, 255)
Theme.Purple = Color3.fromRGB(160, 110, 255)
Theme.Gold = Color3.fromRGB(255, 206, 64)

Theme.PanelTransparency = 0.08
Theme.Radius = UDim.new(0, 14)

return Theme
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Мир на клиенте: настройки графики, музыка (спокойная при стройке, боевая при осаде),
-- шум ветра, мигание огней на вражеских базах.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local Client = script.Parent
local State = require(Client.State)
local SoundPlayer = require(Client.SoundPlayer)
local CameraShake = require(Client.CameraShake)
local Fx = require(Client.Fx)

local World = {}

function World.applySettings()
	local s = State.settings
	SoundPlayer.setVolumes(s.Sfx or 1, (s.Music or 0.5) * 0.9)
	CameraShake.enabled = s.CameraShake ~= false
	Fx.applyQuality()
end

local function updateMusic()
	if State.inSiege() then
		SoundPlayer.playlist(Sounds.SiegePlaylist)
	else
		SoundPlayer.playlist(Sounds.BuildPlaylist)
	end
end

function World.init()
	World.applySettings()
	updateMusic()
	SoundPlayer.play("Wind", { loop = true })
	State.changed:Connect(function(key)
		if key == "settings" then
			World.applySettings()
		elseif key == "siege" then
			updateMusic()
		end
	end)
	-- красные огни на антеннах вражеских баз мигают
	local lights = {}
	local map = workspace:WaitForChild("Map", 10)
	local forts = map and map:FindFirstChild("EnemyForts")
	if forts then
		for _, d in forts:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "AntennaLight" then
				table.insert(lights, d)
			end
		end
	end
	RunService.Heartbeat:Connect(function()
		local on = math.floor(os.clock() * 1.25) % 2 == 0
		for _, l in lights do
			l.Transparency = on and 0 or 0.85
			local pl = l:FindFirstChildOfClass("PointLight")
			if pl then
				pl.Enabled = on
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="26">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">BlockFactory</string>
          <string name="Source"><![CDATA[-- Создаёт блок (деталь Roblox) по спецификации. Используется и сервером (настоящие блоки),
-- и клиентом (полупрозрачный «призрак» под курсором, иконки в магазине).
local Blocks = require(script.Parent.Blocks)

local BlockFactory = {}

export type BuildOptions = {
	ghost: boolean?,      -- призрак: без света, без столкновений
	preview: boolean?,    -- иконка в интерфейсе
	plotColor: Color3?,
}

local SMOOTH = Enum.SurfaceType.Smooth

local function newPart(className: string): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = SMOOTH
	p.BottomSurface = SMOOTH
	return p
end

-- Декоративная деталь, приваренная к блоку. Не мешает лучам и столкновениям.
local function decor(parent: BasePart, cf: CFrame, size: Vector3, props: { [string]: any }): BasePart
	local d = newPart(props.className or "Part")
	d.Name = "Decor"
	d.Size = size
	d.CFrame = parent.CFrame * cf
	d.CanCollide = false
	d.CanQuery = false
	d.CanTouch = false
	d.Massless = true
	d.Anchored = false
	d.Material = props.Material or Enum.Material.SmoothPlastic
	d.Color = props.Color or Color3.new(1, 1, 1)
	if props.Shape then
		(d :: Part).Shape = props.Shape
	end
	d.Transparency = props.Transparency or 0
	d.Parent = parent
	local w = Instance.new("WeldConstraint")
	w.Part0 = parent
	w.Part1 = d
	w.Parent = d
	return d
end

local function faceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.LightInfluence = 1
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = bg and 0 or 1
	t.BackgroundColor3 = bg or Color3.new()
	t.Text = text
	t.TextScaled = true
	t.TextColor3 = color
	t.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
	t.Parent = g
	g.Parent = part
end

-- Добавить «особые» части: свет, огонь двигателя, надписи...
local function decorate(part: BasePart, def, spec, opts: BuildOptions)
	local key = def.key
	local s = part.Size
	local ghost = opts.ghost
	if key == "Wheel" then
		decor(part, CFrame.new(), Vector3.new(s.X + 0.1, s.Y * 0.45, s.Z * 0.45),
			{ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(190, 192, 198) })
	elseif key == "Thruster" then
		decor(part, CFrame.new(-s.X / 2 - 0.15, 0, 0), Vector3.new(0.3, s.Y * 0.8, s.Z * 0.8),
			{ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 140, 40) })
		decor(part, CFrame.new(s.X / 2 + 0.1, 0, 0), Vector3.new(0.2, s.Y * 1.1, s.Z * 1.1),
			{ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(60, 62, 70) })
		if not ghost and not opts.preview then
			local att = Instance.new("Attachment")
			att.Name = "Exhaust"
			att.Position = Vector3.new(-s.X / 2 - 0.3, 0, 0)
			att.Parent = part
			local fire = Instance.new("ParticleEmitter")
			fire.Name = "Flame"
			fire.Texture = "rbxasset://textures/particles/fire_main.dds"
			fire.EmissionDirection = Enum.NormalId.Left
			fire.Speed = NumberRange.new(18, 26)
			fire.Lifetime = NumberRange.new(0.15, 0.3)
			fire.Rate = 90
			fire.SpreadAngle = Vector2.new(6, 6)
			fire.LightEmission = 1
			fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.2) })
			fire.Color = ColorSequence.new(Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 90, 30))
			fire.Enabled = false
			fire.Parent = att
		end
	elseif key == "Balloon" then
		decor(part, CFrame.new(0, -s.Y / 2 - 1.4, 0), Vector3.new(0.08, 3, 0.08),
			{ Material = Enum.Material.Fabric, Color = Color3.fromRGB(230, 230, 230) })
	elseif key == "Door" then
		decor(part, CFrame.new(s.X / 2 - 0.6, 0, -s.Z / 2 - 0.1), Vector3.new(0.3, 0.3, 0.25),
			{ Material = Enum.Material.Metal, Color = Color3.fromRGB(220, 190, 90) })
		decor(part, CFrame.new(s.X / 2 - 0.6, 0, s.Z / 2 + 0.1), Vector3.new(0.3, 0.3, 0.25),
			{ Material = Enum.Material.Metal, Color = Color3.fromRGB(220, 190, 90) })
	elseif key == "Lamp" then
		if not ghost and not opts.preview then
			local light = Instance.new("PointLight")
			light.Range = 20
			light.Brightness = 2
			light.Shadows = true
			light.Color = part.Color
			light.Parent = part
		end
	elseif key == "Flag" then
		decor(part, CFrame.new(0, s.Y / 2 - 1.4, -1.6), Vector3.new(0.12, 2.4, 3.2),
			{ Material = Enum.Material.Fabric, Color = opts.plotColor or Color3.fromRGB(226, 64, 64) })
		decor(part, CFrame.new(0, s.Y / 2 + 0.25, 0), Vector3.new(0.6, 0.6, 0.6),
			{ Shape = Enum.PartType.Ball, Material = Enum.Material.Metal, Color = Color3.fromRGB(240, 200, 70) })
	elseif key == "TNT" then
		decor(part, CFrame.new(0, s.Y * 0.28, 0), Vector3.new(s.X + 0.05, 0.25, s.Z + 0.05),
			{ Color = Color3.fromRGB(30, 30, 30) })
		decor(part, CFrame.new(0, -s.Y * 0.28, 0), Vector3.new(s.X + 0.05, 0.25, s.Z + 0.05),
			{ Color = Color3.fromRGB(30, 30, 30) })
		decor(part, CFrame.new(0, s.Y / 2 + 0.3, 0), Vector3.new(0.12, 0.6, 0.12),
			{ Color = Color3.fromRGB(70, 60, 50), Material = Enum.Material.Fabric })
		if not ghost then
			faceText(part, Enum.NormalId.Front, "TNT", Color3.new(1, 1, 1))
			faceText(part, Enum.NormalId.Back, "TNT", Color3.new(1, 1, 1))
		end
	elseif key == "Medkit" then
		for _, cf in { CFrame.new(0, 0, -s.Z / 2 - 0.03), CFrame.new(0, s.Y / 2 + 0.03, 0) * CFrame.Angles(math.pi / 2, 0, 0) } do
			decor(part, cf, Vector3.new(s.X * 0.6, s.Y * 0.18, 0.06), { Material = Enum.Material.Neon, Color = Color3.fromRGB(230, 40, 40) })
			decor(part, cf, Vector3.new(s.X * 0.18, s.Y * 0.6, 0.06), { Material = Enum.Material.Neon, Color = Color3.fromRGB(230, 40, 40) })
		end
	elseif key == "AATurret" then
		decor(part, CFrame.new(0, s.Y / 2 + 0.5, 0), Vector3.new(1.8, 1, 1.8),
			{ Material = Enum.Material.Metal, Color = Color3.fromRGB(56, 66, 56) })
		for _, x in { -0.45, 0.45 } do
			decor(part, CFrame.new(x, s.Y / 2 + 1.5, -0.6) * CFrame.Angles(math.rad(50), 0, 0) * CFrame.Angles(0, math.pi / 2, 0),
				Vector3.new(2.6, 0.32, 0.32), { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(40, 42, 44) })
		end
		decor(part, CFrame.new(0, s.Y / 2 + 1.1, 0.7), Vector3.new(0.9, 0.5, 0.2),
			{ Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 70, 50) })
	elseif key == "Shield" then
		decor(part, CFrame.new(0, s.Y / 2 + 0.3, 0), Vector3.new(1.8, 1.8, 1.8),
			{ Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = Color3.fromRGB(90, 200, 255) })
		decor(part, CFrame.new(0, s.Y / 2, 0) * CFrame.Angles(0, 0, math.pi / 2), Vector3.new(0.3, 2.8, 2.8),
			{ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(180, 190, 205) })
		if not ghost and not opts.preview then
			local light = Instance.new("PointLight")
			light.Range = 10
			light.Brightness = 1.5
			light.Color = Color3.fromRGB(90, 200, 255)
			light.Parent = part
		end
	end
end

-- Построить блок на месте cf. spec: { mat, shape, item, size, color }
function BlockFactory.build(spec, cf: CFrame, opts: BuildOptions?): BasePart
	local o: BuildOptions = opts or {}
	local def = Blocks.def(spec)
	local part: BasePart
	if spec.item and spec.item > 0 then
		local className = def.class or "Part"
		part = newPart(className)
		if def.shape == "Cylinder" then
			(part :: Part).Shape = Enum.PartType.Cylinder
		elseif def.shape == "Ball" then
			(part :: Part).Shape = Enum.PartType.Ball
		end
		if className == "VehicleSeat" then
			local seat = part :: VehicleSeat
			seat.MaxSpeed = 0
			seat.Torque = 0
			seat.TurnSpeed = 0
		end
	else
		local shape = spec.shape or 1
		if shape == 2 then
			part = newPart("WedgePart")
		elseif shape == 3 then
			part = newPart("CornerWedgePart")
		else
			part = newPart("Part")
			if shape == 4 then
				(part :: Part).Shape = Enum.PartType.Cylinder
			elseif shape == 5 then
				(part :: Part).Shape = Enum.PartType.Ball
			end
		end
	end
	part.Name = "Block"
	part.Size = spec.size
	part.CFrame = cf
	part.Material = def.material
	part.Color = spec.color or def.color
	part.Transparency = def.transparency or 0
	part.Reflectance = def.reflectance or 0
	if not o.ghost and not o.preview then
		local friction = (def.key == "Wheel") and 1.3 or 0.5
		part.CustomPhysicalProperties = PhysicalProperties.new(def.density or 1, friction, 0.15)
	end
	decorate(part, def, spec, o)
	if o.ghost then
		for _, d in part:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.CastShadow = false
			end
		end
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
	end
	return part
end

-- Все детали блока (сам блок + декор) — чтобы, например, сделать их прозрачными
function BlockFactory.allParts(block: BasePart): { BasePart }
	local list = { block }
	for _, d in block:GetChildren() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

return BlockFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Blocks</string>
          <string name="Source"><![CDATA[-- Каталог всего, из чего можно строить: материалы, формы и особые блоки.
--
-- Поля материала:
--   hp        прочность блока 2×2×2 (больше блок — больше прочность)
--   price     цена в магазине (0 = есть сразу)
--   blast     сколько урона от взрыва блок задерживает для того, что за ним (0..0.95)
--   nuke      то же для ядерного удара и радиации
--   bulletMul / explMul / laserMul — множители урона, который получает сам блок
--   regen     восстановление прочности в секунду (доля от максимума)
--   density   плотность для испытаний (меньше 1 — плавает в воде)
local Blocks = {}

Blocks.Shapes = {
	{ id = 1, key = "Block", name = "Блок", volume = 1 },
	{ id = 2, key = "Wedge", name = "Клин", volume = 0.5 },
	{ id = 3, key = "CornerWedge", name = "Угол", volume = 1 / 3 },
	{ id = 4, key = "Cylinder", name = "Цилиндр", volume = 0.785 },
	{ id = 5, key = "Ball", name = "Шар", volume = 0.524 },
}

local M = Enum.Material

Blocks.Materials = {
	{ id = 1, key = "Wood", name = "Дерево", material = M.WoodPlanks, color = Color3.fromRGB(161, 115, 72),
		hp = 100, price = 0, blast = 0.35, nuke = 0.2, density = 0.5, desc = "Дешёвое и лёгкое. Плавает в воде." },
	{ id = 2, key = "Plastic", name = "Пластик", material = M.SmoothPlastic, color = Color3.fromRGB(232, 232, 236),
		hp = 70, price = 0, blast = 0.25, nuke = 0.15, density = 0.7, desc = "Красится в любой цвет. Для декора." },
	{ id = 3, key = "Brick", name = "Кирпич", material = M.Brick, color = Color3.fromRGB(168, 84, 62),
		hp = 220, price = 120, blast = 0.5, nuke = 0.35, density = 1.9, desc = "Классика для первого бункера." },
	{ id = 4, key = "Stone", name = "Камень", material = M.Cobblestone, color = Color3.fromRGB(128, 128, 124),
		hp = 320, price = 250, blast = 0.55, nuke = 0.4, density = 2.4, desc = "Крепкий булыжник." },
	{ id = 5, key = "Concrete", name = "Бетон", material = M.Concrete, color = Color3.fromRGB(162, 162, 157),
		hp = 420, price = 400, blast = 0.62, nuke = 0.5, density = 2.4, desc = "Основа любого бункера." },
	{ id = 6, key = "Glass", name = "Стекло", material = M.Glass, color = Color3.fromRGB(170, 214, 235), transparency = 0.45, reflectance = 0.15,
		hp = 50, price = 60, blast = 0.1, nuke = 0.05, density = 2.4, desc = "Красиво, но хрупко." },
	{ id = 7, key = "Ice", name = "Лёд", material = M.Ice, color = Color3.fromRGB(176, 222, 255), transparency = 0.15,
		hp = 90, price = 150, blast = 0.3, nuke = 0.2, density = 0.9, desc = "Скользкий. Плавает." },
	{ id = 8, key = "Neon", name = "Неон", material = M.Neon, color = Color3.fromRGB(0, 255, 210),
		hp = 80, price = 200, blast = 0.2, nuke = 0.1, density = 1, desc = "Светится. Для красоты." },
	{ id = 9, key = "Sandbag", name = "Мешки с песком", material = M.Fabric, color = Color3.fromRGB(196, 172, 124),
		hp = 260, price = 300, blast = 0.55, nuke = 0.35, bulletMul = 0.25, density = 1.6, desc = "Пули почти не берут." },
	{ id = 10, key = "Rubber", name = "Резина", material = M.Rubber, color = Color3.fromRGB(44, 44, 48),
		hp = 240, price = 450, blast = 0.45, nuke = 0.3, explMul = 0.55, density = 1.2, desc = "Гасит ударную волну." },
	{ id = 11, key = "Metal", name = "Металл", material = M.DiamondPlate, color = Color3.fromRGB(152, 157, 162),
		hp = 650, price = 800, blast = 0.7, nuke = 0.55, density = 7.8, desc = "Рифлёный стальной лист." },
	{ id = 12, key = "ArmorGlass", name = "Бронестекло", material = M.Glass, color = Color3.fromRGB(120, 184, 255), transparency = 0.3, reflectance = 0.25,
		hp = 700, price = 1800, blast = 0.7, nuke = 0.4, bulletMul = 0.4, density = 2.6, desc = "Видно всё, а пули — нет." },
	{ id = 13, key = "Steel", name = "Броня", material = M.Metal, color = Color3.fromRGB(88, 94, 102),
		hp = 1000, price = 1500, blast = 0.78, nuke = 0.6, density = 7.8, desc = "Танковая броня." },
	{ id = 14, key = "Lead", name = "Свинец", material = M.CorrodedMetal, color = Color3.fromRGB(96, 102, 124),
		hp = 800, price = 2600, blast = 0.7, nuke = 0.9, density = 11, desc = "Лучшая защита от радиации." },
	{ id = 15, key = "Titanium", name = "Титан", material = M.Metal, color = Color3.fromRGB(206, 210, 220), reflectance = 0.1,
		hp = 1800, price = 4000, blast = 0.85, nuke = 0.7, density = 4.5, desc = "Лёгкий и сверхпрочный." },
	{ id = 16, key = "Obsidian", name = "Обсидиан", material = M.Basalt, color = Color3.fromRGB(44, 26, 60),
		hp = 2800, price = 7000, blast = 0.9, nuke = 0.8, density = 2.6, desc = "Почти неразрушим." },
	{ id = 17, key = "Gold", name = "Золото", material = M.Foil, color = Color3.fromRGB(255, 204, 64), reflectance = 0.35,
		hp = 500, price = 10000, blast = 0.6, nuke = 0.7, laserMul = 0.25, density = 19, desc = "Отражает орбитальный лазер." },
	{ id = 18, key = "Crystal", name = "Энергокристалл", material = M.Glass, color = Color3.fromRGB(80, 255, 240), transparency = 0.12, reflectance = 0.3,
		hp = 1500, price = 12000, blast = 0.82, nuke = 0.75, regen = 0.03, density = 1, desc = "Сам восстанавливает прочность." },
}

-- Особые блоки. Их размер фиксирован (кроме тех, где resizable = true).
Blocks.Items = {
	{ id = 1, key = "Seat", name = "Сиденье", class = "Seat", size = Vector3.new(2, 1, 2), material = M.WoodPlanks,
		color = Color3.fromRGB(140, 96, 60), hp = 150, price = 0, density = 0.6, desc = "На нём можно сидеть." },
	{ id = 2, key = "DriverSeat", name = "Кресло водителя", class = "VehicleSeat", size = Vector3.new(2, 1, 2), material = M.SmoothPlastic,
		color = Color3.fromRGB(46, 48, 54), hp = 200, price = 250, density = 0.8, desc = "Управляет колёсами и двигателями (WASD)." },
	{ id = 3, key = "Wheel", name = "Колесо", shape = "Cylinder", size = Vector3.new(2, 4, 4), material = M.Rubber,
		color = Color3.fromRGB(30, 30, 32), hp = 300, price = 200, density = 1, desc = "Крутится от кресла водителя." },
	{ id = 4, key = "Thruster", name = "Реактивный двигатель", shape = "Cylinder", size = Vector3.new(3, 2, 2), material = M.Metal,
		color = Color3.fromRGB(110, 114, 122), hp = 300, price = 600, density = 1, desc = "Толкает постройку вперёд (W)." },
	{ id = 5, key = "Balloon", name = "Воздушный шар", shape = "Ball", size = Vector3.new(4, 4, 4), material = M.SmoothPlastic,
		color = Color3.fromRGB(235, 64, 52), hp = 40, price = 300, density = 0.1, desc = "Поднимает постройку в воздух." },
	{ id = 6, key = "Door", name = "Дверь", size = Vector3.new(4, 7, 1), resizable = true, material = M.WoodPlanks,
		color = Color3.fromRGB(120, 82, 50), hp = 400, price = 150, density = 0.6, desc = "Открывается кнопкой E." },
	{ id = 7, key = "Lamp", name = "Лампа", size = Vector3.new(1, 1, 1), resizable = true, material = M.Neon,
		color = Color3.fromRGB(255, 226, 160), hp = 50, price = 50, density = 1, desc = "Светит в бункере." },
	{ id = 8, key = "Flag", name = "Флаг", size = Vector3.new(1, 8, 1), material = M.Metal,
		color = Color3.fromRGB(200, 200, 205), hp = 60, price = 50, density = 1, desc = "Флаг цвета твоего участка." },
	{ id = 9, key = "TNT", name = "Динамит", size = Vector3.new(2, 2, 2), material = M.SmoothPlastic,
		color = Color3.fromRGB(200, 40, 36), hp = 30, price = 100, density = 1, desc = "Взрывается, если его разрушить!" },
	{ id = 10, key = "Medkit", name = "Аптечка", size = Vector3.new(2, 2, 2), material = M.SmoothPlastic,
		color = Color3.fromRGB(240, 240, 240), hp = 200, price = 1200, density = 1, desc = "Лечит всех рядом (10 стадов)." },
	{ id = 11, key = "AATurret", name = "Турель ПВО", size = Vector3.new(3, 2, 3), material = M.Metal,
		color = Color3.fromRGB(70, 82, 70), hp = 900, price = 3500, density = 3, desc = "Сбивает ракеты и снаряды на подлёте." },
	{ id = 12, key = "Shield", name = "Генератор щита", size = Vector3.new(3, 3, 3), material = M.Metal,
		color = Color3.fromRGB(60, 70, 96), hp = 800, price = 6000, density = 3, desc = "Купол радиусом 18, держит 2500 урона." },
}

Blocks.ShieldRadius = 18
Blocks.ShieldHp = 2500
Blocks.ShieldRecharge = 18
Blocks.AARange = 85
Blocks.AACooldown = 1.1
Blocks.MedkitRange = 10

Blocks.MaterialById = {}
Blocks.MaterialByKey = {}
for _, m in Blocks.Materials do
	Blocks.MaterialById[m.id] = m
	Blocks.MaterialByKey[m.key] = m
	m.blast = m.blast or 0.3
	m.nuke = m.nuke or 0.2
	m.bulletMul = m.bulletMul or 1
	m.explMul = m.explMul or 1
	m.laserMul = m.laserMul or 1
	m.transparency = m.transparency or 0
	m.reflectance = m.reflectance or 0
end

Blocks.ItemById = {}
Blocks.ItemByKey = {}
for _, it in Blocks.Items do
	Blocks.ItemById[it.id] = it
	Blocks.ItemByKey[it.key] = it
	it.blast = it.blast or 0.5
	it.nuke = it.nuke or 0.4
	it.bulletMul = 1
	it.explMul = 1
	it.laserMul = 1
end

Blocks.ShapeById = {}
for _, s in Blocks.Shapes do
	Blocks.ShapeById[s.id] = s
end

-- Ключ для разблокировки в магазине: "m:Brick" или "i:Wheel"
function Blocks.unlockKey(kind: string, id: number): string
	if kind == "item" then
		return "i:" .. Blocks.ItemById[id].key
	end
	return "m:" .. Blocks.MaterialById[id].key
end

-- Описание блока (материал или особый) по спецификации
function Blocks.def(spec)
	if spec.item and spec.item > 0 then
		return Blocks.ItemById[spec.item]
	end
	return Blocks.MaterialById[spec.mat]
end

local function clampInt(v, lo, hi)
	v = math.floor((tonumber(v) or lo) + 0.5)
	return math.clamp(v, lo, hi)
end

-- Приводит размер к допустимому: целые стады, ограничения формы (шар — одинаковый по всем осям,
-- цилиндр — круглый), фиксированный размер у особых блоков.
function Blocks.normalizeSize(shapeId: number, itemId: number, size: Vector3, maxSize: number): Vector3
	if itemId and itemId > 0 then
		local it = Blocks.ItemById[itemId]
		if not it.resizable then
			return it.size
		end
		return Vector3.new(clampInt(size.X, 1, maxSize), clampInt(size.Y, 1, maxSize), clampInt(size.Z, 1, maxSize))
	end
	local x, y, z = clampInt(size.X, 1, maxSize), clampInt(size.Y, 1, maxSize), clampInt(size.Z, 1, maxSize)
	if shapeId == 5 then
		local d = math.max(x, y, z)
		return Vector3.new(d, d, d)
	elseif shapeId == 4 then
		local d = math.max(y, z)
		return Vector3.new(x, d, d)
	end
	return Vector3.new(x, y, z)
end

-- Максимальная прочность конкретного блока
function Blocks.maxHp(spec, size: Vector3): number
	local d = Blocks.def(spec)
	local volume = size.X * size.Y * size.Z
	if not (spec.item and spec.item > 0) then
		volume *= Blocks.ShapeById[spec.shape or 1].volume
	end
	local k = math.clamp(volume / 8, 0.25, 8)
	return math.floor(d.hp * k + 0.5)
end

return Blocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Общие настройки игры. Всё, что можно поменять без программирования, — здесь.
local Config = {}

Config.GameName = "BUILD & SURVIVE"
Config.GameNameRu = "Построй и выживи"
Config.Version = "1.0"

-- Строительство
Config.PlotSize = Vector3.new(64, 96, 64) -- ширина, высота, длина зоны строительства (в стадах)
Config.MaxBlocks = 1500                   -- лимит блоков на одном участке
Config.MaxBlockSize = 16                  -- максимальный размер блока по одной оси
Config.DefaultBlockSize = Vector3.new(2, 2, 2)
Config.UndoDepth = 60
Config.PlaceCooldown = 0.045              -- антиспам на сервере (сек)
Config.HoldRepeat = 0.09                  -- зажатая кнопка мыши: пауза между блоками (сек)

-- Экономика
Config.StartGold = 500
Config.DailyBonus = 150
Config.GoldPerWave = 15                   -- золото за волну = GoldPerWave * номер волны * множитель сложности

-- Сохранения
Config.DataStoreName = "BuildSurvive_v1"
Config.AutosaveInterval = 120
Config.SaveSlots = 3

-- Разрушения
Config.DebrisLimit = 160                  -- сколько обломков может лететь одновременно
Config.DebrisLifetime = 5
Config.CharredColor = Color3.fromRGB(28, 22, 18)

-- Осада
Config.Siege = {
	CountdownTime = 4,
	BreakBetweenWaves = 4,
	LeavePlotGrace = 4,          -- сколько секунд можно стоять вне участка
	RangeCooldown = 0.35,        -- полигон: пауза между выстрелами
	RangeHeavyCooldown = 6,      -- полигон: пауза после ядерки/лазера/баллистики
	MaxProjectiles = 140,
}

Config.Difficulties = {
	{ key = "Easy", name = "Лёгкая", damage = 0.6, rate = 0.75, gold = 0.6, color = Color3.fromRGB(90, 200, 120) },
	{ key = "Normal", name = "Нормальная", damage = 1.0, rate = 1.0, gold = 1.0, color = Color3.fromRGB(255, 196, 64) },
	{ key = "Hard", name = "Хардкор", damage = 1.4, rate = 1.3, gold = 1.6, color = Color3.fromRGB(255, 120, 50) },
	{ key = "Apocalypse", name = "Апокалипсис", damage = 2.0, rate = 1.7, gold = 2.5, color = Color3.fromRGB(235, 60, 60) },
}

-- Испытания (запуск постройки)
Config.Launch = {
	WheelSpeed = 22,       -- рад/с
	WheelTorque = 60000,
	ThrusterForce = 9000,
	BalloonLift = 30,      -- сколько единиц массы поднимает один шар (деревянный блок 2×2×2 весит 4)
}

-- Цвета палитры (покраска)
Config.Palette = {
	Color3.fromRGB(245, 245, 245), Color3.fromRGB(190, 190, 195), Color3.fromRGB(120, 122, 128), Color3.fromRGB(60, 62, 68), Color3.fromRGB(22, 23, 26),
	Color3.fromRGB(235, 64, 52), Color3.fromRGB(176, 32, 40), Color3.fromRGB(255, 136, 40), Color3.fromRGB(255, 196, 40), Color3.fromRGB(255, 236, 120),
	Color3.fromRGB(130, 210, 70), Color3.fromRGB(52, 150, 70), Color3.fromRGB(26, 90, 56), Color3.fromRGB(64, 200, 190), Color3.fromRGB(40, 140, 220),
	Color3.fromRGB(30, 70, 170), Color3.fromRGB(120, 80, 220), Color3.fromRGB(190, 70, 210), Color3.fromRGB(255, 120, 190), Color3.fromRGB(255, 205, 170),
	Color3.fromRGB(196, 140, 90), Color3.fromRGB(140, 92, 56), Color3.fromRGB(92, 60, 38), Color3.fromRGB(210, 190, 140), Color3.fromRGB(108, 120, 80),
}

-- Цвета команд/участков (как в Build a Boat — у каждого участка свой цвет)
Config.PlotColors = {
	{ name = "Красный", color = Color3.fromRGB(226, 64, 64) },
	{ name = "Синий", color = Color3.fromRGB(56, 128, 236) },
	{ name = "Зелёный", color = Color3.fromRGB(64, 196, 96) },
	{ name = "Жёлтый", color = Color3.fromRGB(246, 200, 50) },
	{ name = "Фиолетовый", color = Color3.fromRGB(160, 84, 230) },
	{ name = "Оранжевый", color = Color3.fromRGB(250, 132, 40) },
}

-- Графика по умолчанию (игрок может поменять в настройках)
Config.DefaultSettings = {
	Music = 0.5,
	Sfx = 1,
	Graphics = 3, -- 1 низкая, 2 средняя, 3 ультра
	CameraShake = true,
	ShowGrid = true,
}

return Config
]]></string>
