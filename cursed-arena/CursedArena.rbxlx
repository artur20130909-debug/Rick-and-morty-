<Item class="StarterPlayer" referent="RBX0000006C"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">60</float><float name="CameraMinZoomDistance">4</float><float name="CharacterWalkSpeed">20</float><float name="CharacterJumpHeight">7.5</float><bool name="CharacterUseJumpPower">false</bool><bool name="EnableMouseLockOption">true</bool><bool name="LoadCharacterAppearance">false</bool><float name="HealthDisplayDistance">0</float><float name="NameDisplayDistance">70</float><bool name="AutoJumpEnabled">false</bool></Properties><Item class="StarterCharacterScripts" referent="RBX0000006D"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX0000006E"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Пустой Animate: отключает стандартные анимации Roblox (персонажей анимирует Client/Animator).
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX0000006F"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Пустой Health: отключает стандартную регенерацию (своя — в Server/Combat).
]]></ProtectedString></Properties></Item>
