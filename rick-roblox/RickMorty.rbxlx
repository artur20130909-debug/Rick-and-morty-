	Sb("Shoe", 0.9, 0.4, 0.4, -0.4, 2.0, 0.2, "#E8E8E8")
	local _7 = sb
	local fmat = B.model(FURN, "DoorMat")
	B.part(fmat, "Mat", Vector3.new(4, 0.06, 2.6), CFrame.new(32, y + 0.03, 2), "#7A3E2E", Enum.Material.Fabric)
	local clock = B.model(FURN, "WallClock")
	B.outline(clock)
	local wc = B.cyl(clock, "Face", 0.2, 2.0, CFrame.new(35.55, y + 8.3, 16), "#FFFFFF")
	B.cyl(clock, "Rim", 0.15, 2.3, CFrame.new(35.6, y + 8.3, 16), "#2B2B33")
	B.part(clock, "Hand", Vector3.new(0.05, 0.75, 0.08), CFrame.new(35.43, y + 8.6, 16), "#111111")
	B.part(clock, "Hand", Vector3.new(0.05, 0.08, 0.6), CFrame.new(35.43, y + 8.3, 16.25) * CFrame.Angles(math.rad(-30), 0, 0), "#111111")
	local _8 = wc
	-- столовая: сервант и растение
	local cb, Cb = item("ChinaCabinet", CFrame.new(24.6, y, 38.7))
	Cb("Body", 4.2, 3.2, 1.8, 0, 1.6, 0, "#7E4F2E")
	Cb("Glass", 4.0, 3.6, 1.4, 0, 5.0, 0.1, "#BFE6FF", Enum.Material.Glass, { Transparency = 0.6 })
	Cb("Crown", 4.4, 0.3, 1.9, 0, 6.95, 0, "#6B4226")
	for i = 0, 2 do Cb.ball("Plate", 0.9, -1.3 + i * 1.3, 4.2, 0.4, "#F3F3F3") end
	local _9 = cb
	plant("DiningPlant", CFrame.new(34.8, y, 38.6), 1.2)
	picture("Painting2", CFrame.new(31, y + 6.5, 39.55), 3.0, 2.2, drawLandscape)
	ceilingLamp("Foyer", 32, y + 11, 8, 2.2)
	ceilingLamp("Dining", 29, y + 11, 30)
end

function Rooms.build(ctx, root)
	B, C = ctx.Build, ctx.Config
	FURN = B.folder(root, "Furniture")
	LIGHTS = B.folder(root, "Lights")
	MARK = B.folder(root, "Markers")
	mortyRoom()
	hallAndBath()
	kitchen()
	living()
end

return Rooms
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX00000023"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">0.5</float><float name="CameraMinZoomDistance">0.5</float><float name="CharacterWalkSpeed">12</float><float name="CharacterJumpHeight">4</float><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX00000022"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000021"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Запуск клиента: подключаем модули и передаём управление App (меню → глава 1).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = ReplicatedStorage:WaitForChild("Client")

local ctx = {
	Build = require(Shared:WaitForChild("Build")),
	Config = require(Shared:WaitForChild("Config")),
}
local names = { "Util", "Settings", "Audio", "Gui", "Hud", "Prompts", "Cine", "Controls", "World", "Outline",
	"Portal", "Menu", "Breakfast", "Phone", "Story", "App" }
for _, n in ipairs(names) do
	ctx[n] = require(Client:WaitForChild(n))
end

-- порядок важен: настройки → звук → интерфейс → камера и управление
for _, n in ipairs({ "Settings", "Audio", "Gui", "Hud", "Prompts", "Cine", "Controls", "Portal", "Menu", "Breakfast", "Phone" }) do
	local ok, err = pcall(function() ctx[n].init(ctx) end)
	if not ok then warn("[RM] init " .. n .. ": " .. tostring(err)) end
end

ctx.App.start(ctx)
]]></ProtectedString></Properties></Item></Item></Item>
