<Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item>
<Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><token name="LightingStyle">0</token><bool name="PrioritizeLightingQuality">true</bool><bool name="GlobalShadows">true</bool><float name="Brightness">2.2</float><float name="ClockTime">14.5</float><Color3 name="Ambient"><R>0.27</R><G>0.27</G><B>0.33</B></Color3><Color3 name="OutdoorAmbient"><R>0.49</R><G>0.49</G><B>0.55</B></Color3><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX0000000C"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000005"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Интерфейс игрока: Страх и доход, таймер дня/ночи, события, сообщения, объявления на весь сервер,
-- лавка (сети, приманки, клетки, Robux), панель приманок, «несёшь монстра», скример, тревога «крадут»,
-- админ-панель. Всё рисуется кодом; размеры подстраиваются под экран телефона.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local UI = {}
local player = Players.LocalPlayer
local state = RS:WaitForChild("State")
local Action = Net.event("Action")

local C = {
	bg = Color3.fromRGB(20, 16, 30), bg2 = Color3.fromRGB(36, 28, 56), accent = Color3.fromRGB(140, 90, 255),
	gold = Color3.fromRGB(255, 214, 74), text = Color3.new(1, 1, 1), dim = Color3.fromRGB(185, 175, 205),
	red = Color3.fromRGB(255, 80, 90), green = Color3.fromRGB(110, 255, 130), night = Color3.fromRGB(110, 140, 255),
}
local LEFT = Enum.TextXAlignment.Left
local RIGHT = Enum.TextXAlignment.Right

local gui, scareGui
local refs = {}
local scales = {}
local shopTab = "nets"
local shopData = nil

---------------------------------------------------------------- помощники
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function corner(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o) end

local function stroke(o, color, th, tr)
	return make("UIStroke", { Color = color or C.accent, Thickness = th or 2, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

local function label(parent, props)
	local t = make("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextColor3 = C.text, TextScaled = true, Text = "", RichText = true }, parent)
	for k, v in pairs(props or {}) do t[k] = v end
	return t
end

local function panel(parent, props)
	local f = make("Frame", { BackgroundColor3 = C.bg, BackgroundTransparency = 0.12, BorderSizePixel = 0 }, parent)
	for k, v in pairs(props or {}) do f[k] = v end
	corner(f, 14)
	stroke(f, C.accent, 2, 0.2)
	return f
end

function UI.sound(key, volume)
	local id = Config.Sounds[key]
	if not id or id == "" then return end
	if tonumber(id) then id = "rbxassetid://" .. id end
	local s = make("Sound", { SoundId = id, Volume = volume or 0.6 }, SoundService)
	s:Play()
	task.delay(8, function() s:Destroy() end)
end

local function button(parent, text, color, props, onClick)
	local b = make("TextButton", { BackgroundColor3 = color or C.accent, Font = Enum.Font.GothamBlack, TextColor3 = C.text,
		TextScaled = true, Text = text, AutoButtonColor = true, BorderSizePixel = 0, RichText = true }, parent)
	corner(b, 10)
	stroke(b, Color3.new(0, 0, 0), 2, 0.55)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5) }, b)
	for k, v in pairs(props or {}) do b[k] = v end
	if onClick then
		b.Activated:Connect(function()
			UI.sound("Click", 0.4)
			onClick()
		end)
	end
	return b
end

-- масштаб под размер экрана (телефоны меньше)
local function addScale(o)
	local s = make("UIScale", { Scale = 1 }, o)
	table.insert(scales, s)
	return s
end

local function updateScales()
	local cam = workspace.CurrentCamera
	local h = cam and cam.ViewportSize.Y or 720
	local w = cam and cam.ViewportSize.X or 1280
	local k = math.clamp(math.min(h / 760, w / 1100), 0.55, 1.2)
	for _, s in ipairs(scales) do s.Scale = k end
end

local function myBase()
	local idx = player:GetAttribute("BaseIndex")
	local bases = workspace:FindFirstChild("Bases")
	return idx and bases and bases:FindFirstChild("Base_" .. idx) or nil
end

local function now() return workspace:GetServerTimeNow() end

---------------------------------------------------------------- сообщения
function UI.toast(text, color)
	local list = refs.toasts
	if not list then return end
	local items = {}
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then table.insert(items, c) end
	end
	if #items >= 5 then items[1]:Destroy() end
	local f = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, BorderSizePixel = 0, LayoutOrder = math.floor(os.clock() * 100) }, list)
	corner(f, 8)
	local t = label(f, { Size = UDim2.new(1, -16, 1, -6), Position = UDim2.new(0, 8, 0, 3), Text = text, TextColor3 = color or C.text, Font = Enum.Font.GothamBold })
	task.delay(3.6, function()
		if not f.Parent then return end
		TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		f:Destroy()
	end)
end

local announceQueue = {}
local announcing = false
local function runAnnounce()
	if announcing then return end
	announcing = true
	task.spawn(function()
		while #announceQueue > 0 do
			local a = table.remove(announceQueue, 1)
			local l = refs.announce
			l.Text = a.text
			l.TextColor3 = a.color or C.gold
			l.TextTransparency = 1
			l.TextStrokeTransparency = 1
			l.Visible = true
			TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 0, TextStrokeTransparency = 0 }):Play()
			task.wait(#announceQueue > 0 and 3 or 4.5)
			TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.wait(0.45)
			l.Visible = false
		end
		announcing = false
	end)
end

function UI.announce(text, color)
	table.insert(announceQueue, { text = text, color = color })
	if #announceQueue > 4 then table.remove(announceQueue, 1) end
	UI.sound("Whoosh", 0.5)
	runAnnounce()
end

-- летящая цифра у денег
local function cashFloat(amount)
	local m = refs.money
	if not m then return end
	local t = label(m, { Size = UDim2.new(0, 160, 0, 30), Position = UDim2.new(1, 10, 0, 10),
		Text = (amount >= 0 and "+" or "") .. Util.num(amount) .. " 💀", TextColor3 = amount >= 0 and C.green or C.red, TextXAlignment = LEFT, TextStrokeTransparency = 0.3 })
	TweenService:Create(t, TweenInfo.new(1.2), { Position = UDim2.new(1, 10, 0, -20), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.3, function() t:Destroy() end)
end

---------------------------------------------------------------- скример и тревога
local function jumpscare(key, rarityKey)
	local f = refs.scare
	local def = Config.MonsterIndex[key]
	local r = Config.RarityIndex[rarityKey or "common"] or Config.Rarities[1]
	refs.scareName.Text = def and string.upper(def.name) or "БУ!"
	refs.scareName.TextColor3 = r.color
	f.BackgroundTransparency = 0.05
	f.Visible = true
	refs.scareScale.Scale = 0.5
	TweenService:Create(refs.scareScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1.15 }):Play()
	UI.sound("Jumpscare", 1)
	UI.sound("Scream", 0.9)
	-- тряска камеры
	task.spawn(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		for _ = 1, 14 do
			if hum then hum.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 1.6 end
			task.wait(0.03)
		end
		if hum then hum.CameraOffset = Vector3.new() end
	end)
	task.delay(0.55, function()
		TweenService:Create(f, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(refs.scareScale, TweenInfo.new(0.5), { Scale = 0.01 }):Play()
		task.wait(0.5)
		f.Visible = false
	end)
	UI.toast("😱 Тебя напугал монстр! Ты уронил добычу", C.red)
end

local function stolenAlert(name, thief)
	local l = refs.alert
	l.Text = "⚠ ВОР! " .. thief .. " утащил " .. name .. "!\nДогони и жми F — «Отобрать»"
	l.Visible = true
	for i = 1, 3 do
		task.delay((i - 1) * 0.35, function() UI.sound("Alarm", 0.8) end)
	end
	task.spawn(function()
		for i = 1, 10 do
			l.TextColor3 = (i % 2 == 0) and C.red or Color3.new(1, 1, 1)
			task.wait(0.3)
		end
		l.Visible = false
	end)
end

local function offlinePopup(earned, away)
	local f = panel(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 420, 0, 200), ZIndex = 20 })
	addScale(f)
	updateScales()
	local mins = math.floor(away / 60)
	local txt = mins >= 60 and (math.floor(mins / 60) .. " ч " .. (mins % 60) .. " мин") or (mins .. " мин")
	label(f, { Size = UDim2.new(1, -30, 0, 36), Position = UDim2.new(0, 15, 0, 14), Text = "🌙 Пока тебя не было (" .. txt .. ")", ZIndex = 21 })
	label(f, { Size = UDim2.new(1, -30, 0, 50), Position = UDim2.new(0, 15, 0, 56), Text = "монстры напугали людей на <font color=\"#ffd64a\">+" .. Util.num(earned) .. " 💀</font>", Font = Enum.Font.GothamBold, ZIndex = 21 })
	button(f, "Забрать!", C.accent, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 200, 0, 50), ZIndex = 21 }, function()
		f:Destroy()
	end)
	UI.sound("Cash", 0.7)
end

---------------------------------------------------------------- лавка
local function clearContent()
	for _, c in ipairs(refs.shopList:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local function row(order, title, desc, btnText, btnColor, onClick)
	local f = make("Frame", { Size = UDim2.new(1, -10, 0, 70), BackgroundColor3 = C.bg2, BorderSizePixel = 0, LayoutOrder = order }, refs.shopList)
	corner(f, 12)
	label(f, { Size = UDim2.new(1, -190, 0, 32), Position = UDim2.new(0, 12, 0, 6), Text = title, TextXAlignment = LEFT })
	label(f, { Size = UDim2.new(1, -190, 0, 22), Position = UDim2.new(0, 12, 0, 40), Text = desc or "", TextXAlignment = LEFT, TextColor3 = C.dim, Font = Enum.Font.GothamBold })
	local b = button(f, btnText, btnColor or C.accent, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 165, 0, 48) }, onClick)
	if not onClick then b.AutoButtonColor = false end
	return f, b
end

local function buy(what, key)
	Action:FireServer("buy", what, key)
	task.delay(0.35, function() UI.refreshShop(true) end)
end

local function promptProduct(kind, def)
	if not def.id or def.id == 0 then
		UI.toast("Товар ещё не настроен: впиши его ID в Config (см. README)", C.red)
		return
	end
	if kind == "product" then
		MarketplaceService:PromptProductPurchase(player, def.id)
	else
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	end
end

local function rarityListUpTo(net)
	local names = {}
	for _, r in ipairs(Config.Rarities) do
		if r.net == net then table.insert(names, r.name) end
	end
	return table.concat(names, ", ")
end

local function renderShop()
	if not refs.shop.Visible then return end
	clearContent()
	local fear = player:GetAttribute("Fear") or 0
	local d = shopData or {}
	for name, b in pairs(refs.tabs) do
		b.BackgroundColor3 = (name == shopTab) and C.accent or C.bg2
	end
	if shopTab == "nets" then
		local net = player:GetAttribute("Net") or 1
		for i, n in ipairs(Config.Nets) do
			local desc = "Открывает: " .. rarityListUpTo(n.level)
			if n.level <= net then
				row(i, "🕸 " .. n.name, desc, "✓ Есть", Color3.fromRGB(60, 120, 70))
			elseif n.level == net + 1 then
				local can = fear >= n.price
				row(i, "🕸 " .. n.name, desc, Util.num(n.price) .. " 💀", can and C.accent or Color3.fromRGB(90, 70, 110), function() buy("net") end)
			else
				row(i, "🔒 " .. n.name, desc, Util.num(n.price) .. " 💀", Color3.fromRGB(60, 55, 70))
			end
		end
	elseif shopTab == "baits" then
		for i, b in ipairs(Config.Baits) do
			local left = d.left and d.left[b.key] or 0
			local have = player:GetAttribute("Bait_" .. b.key) or 0
			local extra = ""
			if b.gold then extra = ", золотые ×" .. b.gold end
			if b.blood then extra = ", кровавые мутации" end
			local desc = "Удача ×" .. b.luck .. extra .. " · в наличии: " .. left .. " · у тебя: " .. have
			if left > 0 then
				row(i, b.icon .. " " .. b.name, desc, Util.num(b.price) .. " 💀", fear >= b.price and C.accent or Color3.fromRGB(90, 70, 110), function() buy("bait", b.key) end)
			else
				row(i, b.icon .. " " .. b.name, desc, "Нет в наличии", Color3.fromRGB(60, 55, 70))
			end
		end
	elseif shopTab == "cages" then
		local cages = player:GetAttribute("Cages") or Config.StartCages
		local max = player:GetAttribute("MaxCages") or Config.MaxCages
		local nextPrice = Config.CagePrices[cages + 1]
		if cages < max and nextPrice then
			row(1, "🧺 Новая клетка", "Сейчас клеток: " .. cages .. " из " .. max, Util.num(nextPrice) .. " 💀", fear >= nextPrice and C.accent or Color3.fromRGB(90, 70, 110), function() buy("cage") end)
		else
			row(1, "🧺 Клетки", "Сейчас клеток: " .. cages .. " из " .. max, "Максимум", Color3.fromRGB(60, 55, 70))
		end
		row(2, "💡 Совет", "Клетку можно купить и прямо на базе (замок на пустой клетке)", "OK", C.bg)
	elseif shopTab == "robux" then
		local l = Config.Products.ServerLuck
		row(1, "🍀 " .. l.name, l.minutes .. " минут удача ×2 у всех игроков", "R$ " .. l.robux, Color3.fromRGB(40, 160, 80), function() promptProduct("product", l) end)
		local i = 2
		for _, key in ipairs({ "DoubleFear", "ExtraCages" }) do
			local p = Config.Passes[key]
			if player:GetAttribute("Pass" .. key) then
				row(i, "⭐ " .. p.name, "Уже куплено", "✓ Есть", Color3.fromRGB(60, 120, 70))
			else
				row(i, "⭐ " .. p.name, "Геймпасс навсегда", "R$ " .. p.robux, Color3.fromRGB(40, 160, 80), function() promptProduct("pass", p) end)
			end
			i = i + 1
		end
	end
end

function UI.refreshShop(fetch)
	if fetch then
		local ok, res = pcall(function() return Net.func("GetShop"):InvokeServer() end)
		if ok and type(res) == "table" then shopData = res end
	end
	renderShop()
end

function UI.openShop(tab)
	if tab then shopTab = tab end
	refs.shop.Visible = true
	UI.refreshShop(true)
end

local function buildShop()
	local shop = panel(gui, { Name = "Shop", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0, 600, 0, 440), Visible = false, ZIndex = 5 })
	addScale(shop)
	refs.shop = shop
	label(shop, { Size = UDim2.new(0, 330, 0, 40), Position = UDim2.new(0, 16, 0, 10), Text = "🛒 ЛАВКА ЛОВЦА", TextXAlignment = LEFT, TextColor3 = C.gold })
	refs.restock = label(shop, { Size = UDim2.new(0, 190, 0, 22), Position = UDim2.new(1, -250, 0, 20), Text = "", TextXAlignment = RIGHT, TextColor3 = C.dim, Font = Enum.Font.GothamBold })
	button(shop, "✕", C.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 44, 0, 44) }, function()
		shop.Visible = false
	end)
	refs.tabs = {}
	local tabs = { { "nets", "🕸 Сети" }, { "baits", "🍖 Приманки" }, { "cages", "🧺 Клетки" }, { "robux", "💎 Robux" } }
	for i, t in ipairs(tabs) do
		refs.tabs[t[1]] = button(shop, t[2], C.bg2, { Position = UDim2.new((i - 1) / 4, 12, 0, 62), Size = UDim2.new(0.25, -16, 0, 42) }, function()
			shopTab = t[1]
			renderShop()
		end)
	end
	local list = make("ScrollingFrame", { Position = UDim2.new(0, 12, 0, 114), Size = UDim2.new(1, -24, 1, -126), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, shop)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	refs.shopList = list
	-- перерисовка при смене денег/предметов
	for _, a in ipairs({ "Fear", "Net", "Cages", "MaxCages", "PassDoubleFear", "PassExtraCages" }) do
		player:GetAttributeChangedSignal(a):Connect(function()
			if shop.Visible and a ~= "Fear" then renderShop() end
		end)
	end
end

---------------------------------------------------------------- админ
local function buildAdmin()
	local f = panel(gui, { Name = "Admin", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -180, 0.5, 0), Size = UDim2.new(0, 220, 0, 470), Visible = false, ZIndex = 6 })
	addScale(f)
	label(f, { Size = UDim2.new(1, -20, 0, 28), Position = UDim2.new(0, 10, 0, 6), Text = "⚙ АДМИН", TextColor3 = C.gold })
	local holder = make("Frame", { Position = UDim2.new(0, 10, 0, 40), Size = UDim2.new(1, -20, 1, -50), BackgroundTransparency = 1 }, f)
	make("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	local cmds = {
		{ "☀ День", "day" }, { "🌙 Ночь", "night" }, { "🩸 Кровавая луна", "bloodmoon" }, { "👾 Глитч-ночь", "glitch" },
		{ "🌫 Туман", "fog" }, { "Спавн: Легендарный", "spawn legendary" }, { "Спавн: Мифический", "spawn mythic" },
		{ "Спавн: Секретный", "spawn secret" }, { "+10K Страха", "fear 10000" }, { "🍀 Удача ×2", "luck" }, { "🛒 Обновить лавку", "restock" },
	}
	for i, c in ipairs(cmds) do
		button(holder, c[1], C.bg2, { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = i }, function()
			Action:FireServer("admin", c[2])
		end)
	end
	refs.admin = f
end

---------------------------------------------------------------- основной HUD
local function buildHud()
	gui = make("ScreenGui", { Name = "HUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

	-- деньги
	local money = panel(gui, { Name = "Money", Position = UDim2.new(0, 12, 0, 10), Size = UDim2.new(0, 270, 0, 128) })
	addScale(money)
	refs.money = money
	refs.fear = label(money, { Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -28, 0, 42), Text = "💀 0", TextXAlignment = LEFT, TextColor3 = C.gold })
	refs.income = label(money, { Position = UDim2.new(0, 14, 0, 48), Size = UDim2.new(1, -28, 0, 22), Text = "", TextXAlignment = LEFT, TextColor3 = C.green, Font = Enum.Font.GothamBold })
	refs.stats = label(money, { Position = UDim2.new(0, 14, 0, 72), Size = UDim2.new(1, -28, 0, 20), Text = "", TextXAlignment = LEFT, TextColor3 = C.dim, Font = Enum.Font.GothamBold })
	refs.lock = label(money, { Position = UDim2.new(0, 14, 0, 96), Size = UDim2.new(1, -28, 0, 20), Text = "", TextXAlignment = LEFT, TextColor3 = C.dim, Font = Enum.Font.GothamBold })

	-- верх: фаза, событие, удача, сообщения
	local top = make("Frame", { Name = "Top", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(0, 480, 0, 300), BackgroundTransparency = 1 }, gui)
	addScale(top)
	local pill = panel(top, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 290, 0, 52) })
	pill:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 26)
	refs.pill = pill
	refs.phase = label(pill, { Size = UDim2.new(1, -24, 1, -12), Position = UDim2.new(0, 12, 0, 6), Text = "☀ ДЕНЬ" })
	refs.event = label(top, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 58), Size = UDim2.new(1, 0, 0, 24), Text = "", Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.3 })
	refs.luck = label(top, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 84), Size = UDim2.new(1, 0, 0, 22), Text = "", TextColor3 = C.green, Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.3 })
	local toasts = make("Frame", { Position = UDim2.new(0, 40, 0, 112), Size = UDim2.new(1, -80, 0, 180), BackgroundTransparency = 1 }, top)
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, toasts)
	refs.toasts = toasts

	-- объявление на весь сервер
	local ann = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(0, 900, 0, 64), BackgroundTransparency = 1 }, gui)
	addScale(ann)
	refs.announce = label(ann, { Size = UDim2.fromScale(1, 1), Visible = false, TextStrokeTransparency = 0, TextStrokeColor3 = Color3.new(0, 0, 0) })

	-- тревога «крадут»
	local al = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.new(0, 760, 0, 90), BackgroundTransparency = 1 }, gui)
	addScale(al)
	refs.alert = label(al, { Size = UDim2.fromScale(1, 1), Visible = false, TextColor3 = C.red, TextStrokeTransparency = 0 })

	-- кнопки справа
	local right = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.45, 0), Size = UDim2.new(0, 160, 0, 200), BackgroundTransparency = 1 }, gui)
	addScale(right)
	make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, right)
	button(right, "🛒 Лавка", C.accent, { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 1 }, function()
		if refs.shop.Visible then refs.shop.Visible = false else UI.openShop() end
	end)
	button(right, "🍀 Удача ×2", Color3.fromRGB(40, 160, 80), { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 2 }, function()
		promptProduct("product", Config.Products.ServerLuck)
	end)
	refs.adminBtn = button(right, "⚙ Админ", C.bg2, { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3, Visible = false }, function()
		refs.admin.Visible = not refs.admin.Visible
	end)

	-- низ: «несёшь» и приманки
	local bottom = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, 700, 0, 140), BackgroundTransparency = 1 }, gui)
	addScale(bottom)
	local carry = panel(bottom, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 620, 0, 46), Visible = false })
	refs.carry = carry
	refs.carryText = label(carry, { Size = UDim2.new(1, -20, 1, -10), Position = UDim2.new(0, 10, 0, 5), Text = "" })
	local bar = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, 0, 0, 74), BackgroundTransparency = 1 }, bottom)
	make("UIListLayout", { Padding = UDim.new(0, 10), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, bar)
	refs.baits = {}
	for i, b in ipairs(Config.Baits) do
		local btn = button(bar, b.icon, C.bg2, { Size = UDim2.new(0, 130, 1, 0), LayoutOrder = i, Visible = false }, function()
			Action:FireServer("useBait", b.key)
		end)
		refs.baits[b.key] = btn
	end
	refs.hint = label(bottom, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -80), Size = UDim2.new(1, 0, 0, 26), Text = "", Font = Enum.Font.GothamBold, TextColor3 = C.gold, TextStrokeTransparency = 0.3 })

	buildShop()
	buildAdmin()

	-- скример (поверх всего, включая верхнюю панель Roblox)
	scareGui = make("ScreenGui", { Name = "Scare", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20 }, player.PlayerGui)
	local sf = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(40, 0, 0), BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0 }, scareGui)
	refs.scare = sf
	local face = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromScale(0.7, 0.7), BackgroundTransparency = 1 }, sf)
	make("UIAspectRatioConstraint", { AspectRatio = 1.3 }, face)
	refs.scareScale = make("UIScale", { Scale = 1 }, face)
	for _, x in ipairs({ 0.3, 0.7 }) do
		local eye = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.35), Size = UDim2.fromScale(0.22, 0.29), BackgroundColor3 = Color3.fromRGB(255, 250, 220), BorderSizePixel = 0 }, face)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, eye)
		local pupil = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromScale(0.35, 0.35), BackgroundColor3 = Color3.fromRGB(200, 0, 0), BorderSizePixel = 0 }, eye)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, pupil)
	end
	label(face, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromScale(0.75, 0.22), Text = "▼▼▼▼▼▼▼", TextColor3 = Color3.fromRGB(245, 245, 235) })
	refs.scareName = label(face, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.9), Size = UDim2.fromScale(1, 0.12), Text = "", TextStrokeTransparency = 0 })

	updateScales()
	local cam = workspace.CurrentCamera
	if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales) end
end

---------------------------------------------------------------- обновление каждые 0.2 с
local function refresh()
	local t = now()
	local fear = player:GetAttribute("Fear") or 0
	refs.fear.Text = "💀 " .. Util.num(fear)
	local inc = player:GetAttribute("Income") or 0
	refs.income.Text = "+" .. Util.num(inc) .. " 💀/с" .. (player:GetAttribute("PassDoubleFear") and "  (×2)" or "")
	local base = myBase()
	local used = 0
	if base then
		for _, sm in ipairs(base.Slots:GetChildren()) do
			if sm:FindFirstChild("Monster") then used = used + 1 end
		end
	end
	refs.stats.Text = "🕸 Сеть " .. (player:GetAttribute("Net") or 1) .. "   🧺 " .. used .. "/" .. (player:GetAttribute("Cages") or 0)
	if base and base:GetAttribute("Locked") then
		refs.lock.Text = "🔒 База заперта · " .. Util.time((base:GetAttribute("LockEnds") or 0) - t)
		refs.lock.TextColor3 = C.green
	else
		refs.lock.Text = "🔓 Открыта — запри у входа"
		refs.lock.TextColor3 = C.dim
	end

	-- фаза
	local phase = state:GetAttribute("Phase")
	local left = (state:GetAttribute("PhaseEnds") or 0) - t
	local ev = Config.EventIndex[state:GetAttribute("Event") or ""]
	local pillStroke = refs.pill:FindFirstChildOfClass("UIStroke")
	if phase == "night" then
		refs.phase.Text = "🌙 НОЧЬ " .. Util.time(left)
		pillStroke.Color = ev and ev.color or C.night
		if ev then
			refs.event.Text = ev.name .. " · " .. ev.text
			refs.event.TextColor3 = ev.color
		else
			refs.event.Text = "Редкие монстры вышли на охоту"
			refs.event.TextColor3 = C.night
		end
	else
		refs.phase.Text = "☀ ДЕНЬ " .. Util.time(left)
		pillStroke.Color = C.gold
		refs.event.Text = "Днём только обычные, необычные и редкие"
		refs.event.TextColor3 = C.dim
	end
	local luckEnds = state:GetAttribute("LuckEnds") or 0
	if (state:GetAttribute("ServerLuck") or 1) > 1 and luckEnds > t then
		refs.luck.Text = "🍀 Удача сервера ×" .. state:GetAttribute("ServerLuck") .. " · " .. Util.time(luckEnds - t)
	else
		refs.luck.Text = ""
	end

	-- несёшь монстра
	local carrying = player:GetAttribute("Carrying") or ""
	refs.carry.Visible = carrying ~= ""
	if carrying ~= "" then
		local r = Config.RarityIndex[player:GetAttribute("CarryRarity") or ""] or Config.Rarities[1]
		refs.carryText.Text = "🎒 " .. carrying .. " — беги на свою базу 🏠"
		refs.carryText.TextColor3 = r.color
	end

	-- приманки
	for _, b in ipairs(Config.Baits) do
		local n = player:GetAttribute("Bait_" .. b.key) or 0
		local btn = refs.baits[b.key]
		btn.Visible = n > 0
		btn.Text = b.icon .. " ×" .. n
	end

	-- подсказка новичку
	local caught = player:GetAttribute("Caught") or 0
	if carrying ~= "" then
		refs.hint.Text = ""
	elseif caught == 0 then
		refs.hint.Text = "Подойди к монстру и держи E, чтобы поймать"
	elseif caught < 3 and (player:GetAttribute("Net") or 1) < 2 then
		refs.hint.Text = "Копи Страх и купи сеть получше в Лавке у костра 🔥"
	else
		refs.hint.Text = ""
	end

	if refs.shop.Visible then
		local ra = state:GetAttribute("RestockAt") or 0
		refs.restock.Text = "Обновление: " .. Util.time(ra - t)
	end
	refs.adminBtn.Visible = player:GetAttribute("IsAdmin") == true
end

---------------------------------------------------------------- запуск
function UI.init()
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
	buildHud()
	Net.event("Toast").OnClientEvent:Connect(function(text, color) UI.toast(text, color) end)
	Net.event("Announce").OnClientEvent:Connect(function(text, color) UI.announce(text, color) end)
	Net.event("Fx").OnClientEvent:Connect(function(kind, a, b)
		if kind == "openShop" then UI.openShop()
		elseif kind == "scare" then jumpscare(a, b)
		elseif kind == "stolen" then stolenAlert(a, b)
		elseif kind == "tackled" then
			UI.toast("😤 " .. tostring(b) .. " отобрал у тебя " .. tostring(a) .. "!", C.red)
			UI.sound("Alarm", 0.6)
		elseif kind == "caught" then
			local r = Config.RarityIndex[b or ""] or Config.Rarities[1]
			UI.toast("Поймал: " .. tostring(a) .. "! Неси на базу", r.color)
			UI.sound("Catch", 0.7)
		elseif kind == "delivered" then
			local r = Config.RarityIndex[b or ""] or Config.Rarities[1]
			UI.toast("🧺 " .. tostring(a) .. " теперь в твоей клетке!", r.color)
			UI.sound("Cash", 0.7)
		elseif kind == "cash" then
			cashFloat(tonumber(a) or 0)
			if (tonumber(a) or 0) > 0 then UI.sound("Cash", 0.5) end
		elseif kind == "offline" then offlinePopup(tonumber(a) or 0, tonumber(b) or 0)
		end
	end)
	task.spawn(function()
		while true do
			local ok, err = pcall(refresh)
			if not ok then warn("[CN] UI: " .. tostring(err)) end
			task.wait(0.2)
		end
	end)
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Visuals</string><ProtectedString name="Source"><![CDATA[-- Что клиент делает с миром у себя: освещение дня/ночи и событий, показ подсказок только тем,
-- кому они нужны (свою клетку нельзя «украсть», чужую — «продать»), проход хозяина через
-- запертую дверь своей базы, покачивание монстров в клетках, метка «ТВОЯ БАЗА», таймер замков.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Util = require(Shared.Util)

local Visuals = {}
local player = Players.LocalPlayer
local state = RS:WaitForChild("State")

---------------------------------------------------------------- освещение
local atmo, cc, bloom
local clock = Instance.new("NumberValue")
clock.Value = 14.5

local PRESETS = {
	day = {
		clock = 14.5, light = { Brightness = 2.2, Ambient = Color3.fromRGB(70, 70, 85), OutdoorAmbient = Color3.fromRGB(125, 125, 140),
			FogStart = 200, FogEnd = 900, FogColor = Color3.fromRGB(170, 180, 200), ExposureCompensation = 0 },
		atmo = { Density = 0.25, Color = Color3.fromRGB(200, 190, 215), Decay = Color3.fromRGB(110, 100, 130), Haze = 1 },
		cc = { TintColor = Color3.fromRGB(255, 250, 245), Saturation = 0.05, Contrast = 0.05, Brightness = 0 },
	},
	night = {
		clock = 24.2, light = { Brightness = 0.6, Ambient = Color3.fromRGB(22, 22, 38), OutdoorAmbient = Color3.fromRGB(45, 48, 80),
			FogStart = 30, FogEnd = 280, FogColor = Color3.fromRGB(12, 12, 26), ExposureCompensation = 0.2 },
		atmo = { Density = 0.42, Color = Color3.fromRGB(40, 42, 75), Decay = Color3.fromRGB(20, 20, 45), Haze = 2 },
		cc = { TintColor = Color3.fromRGB(205, 210, 255), Saturation = -0.15, Contrast = 0.1, Brightness = 0 },
	},
}
local function variant(base, light, atmoP, ccP)
	local p = { clock = base.clock, light = {}, atmo = {}, cc = {} }
	for k, v in pairs(base.light) do p.light[k] = v end
	for k, v in pairs(base.atmo) do p.atmo[k] = v end
	for k, v in pairs(base.cc) do p.cc[k] = v end
	for k, v in pairs(light or {}) do p.light[k] = v end
	for k, v in pairs(atmoP or {}) do p.atmo[k] = v end
	for k, v in pairs(ccP or {}) do p.cc[k] = v end
	return p
end
PRESETS.bloodmoon = variant(PRESETS.night, { OutdoorAmbient = Color3.fromRGB(90, 25, 30), FogColor = Color3.fromRGB(45, 0, 6) },
	{ Color = Color3.fromRGB(95, 15, 20), Decay = Color3.fromRGB(60, 5, 10) }, { TintColor = Color3.fromRGB(255, 165, 165), Saturation = 0.1 })
PRESETS.glitch = variant(PRESETS.night, { OutdoorAmbient = Color3.fromRGB(60, 30, 95), FogColor = Color3.fromRGB(25, 5, 40) },
	{ Color = Color3.fromRGB(70, 25, 110) }, { TintColor = Color3.fromRGB(225, 185, 255), Saturation = 0.35 })
PRESETS.fog = variant(PRESETS.night, { FogStart = 4, FogEnd = 95, FogColor = Color3.fromRGB(40, 44, 55) }, { Density = 0.65 }, {})

local current = nil
local function applyLighting(instant)
	local phase = state:GetAttribute("Phase") or "day"
	local key = phase
	if phase == "night" then
		local ev = state:GetAttribute("Event") or ""
		if PRESETS[ev] then key = ev end
	end
	if key == current then return end
	current = key
	local p = PRESETS[key]
	local info = TweenInfo.new(instant and 0 or 4, Enum.EasingStyle.Sine)
	-- время суток крутим через число, чтобы закат шёл вперёд, а не назад
	local target = p.clock
	if target < clock.Value and phase == "night" then target = target + 24 end
	if phase == "day" and clock.Value > 24 then clock.Value = clock.Value - 24 end
	if phase == "day" and clock.Value > target then clock.Value = clock.Value - 24 end
	TweenService:Create(clock, info, { Value = target }):Play()
	TweenService:Create(Lighting, info, p.light):Play()
	TweenService:Create(atmo, info, p.atmo):Play()
	TweenService:Create(cc, info, p.cc):Play()
end

local function setupLighting()
	atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Parent = Lighting
	cc = Lighting:FindFirstChild("CN_Color") or Instance.new("ColorCorrectionEffect")
	cc.Name = "CN_Color"
	cc.Parent = Lighting
	bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
	clock.Changed:Connect(function(v) Lighting.ClockTime = v % 24 end)
	applyLighting(true)
	state:GetAttributeChangedSignal("Phase"):Connect(function() applyLighting(false) end)
	state:GetAttributeChangedSignal("Event"):Connect(function() applyLighting(false) end)
end

---------------------------------------------------------------- подсказки только для своих
local origDist = setmetatable({}, { __mode = "k" })

local function baseOf(inst)
	local a = inst.Parent
	while a and a ~= workspace do
		if a:IsA("Model") and a:GetAttribute("OwnerId") ~= nil then return a end
		a = a.Parent
	end
	return nil
end

local function filterPrompt(p)
	local mode = p:GetAttribute("For")
	if not mode then return end
	if origDist[p] == nil then origDist[p] = p.MaxActivationDistance end
	local me = player.UserId
	local show
	if mode == "notself" then
		show = p:GetAttribute("UserId") ~= me
	else
		local base = baseOf(p)
		local owner = base and base:GetAttribute("OwnerId") or 0
		if mode == "owner" then show = owner == me else show = owner ~= 0 and owner ~= me end
	end
	p.MaxActivationDistance = show and origDist[p] or 0
end

local function filterIn(root)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ProximityPrompt") then filterPrompt(d) end
	end
end

local function setupPrompts()
	filterIn(workspace)
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			task.defer(function() if d.Parent then filterPrompt(d) end end)
		end
	end)
	local bases = workspace:WaitForChild("Bases")
	local function hookBase(b)
		b:GetAttributeChangedSignal("OwnerId"):Connect(function() filterIn(b) end)
	end
	for _, b in ipairs(bases:GetChildren()) do hookBase(b) end
	bases.ChildAdded:Connect(hookBase)
end

---------------------------------------------------------------- своя база: дверь и метка
local hookedDoor = nil
local function myBase()
	local idx = player:GetAttribute("BaseIndex")
	local bases = workspace:FindFirstChild("Bases")
	return idx and bases and bases:FindFirstChild("Base_" .. idx) or nil
end

local function hookMyBase()
	local b = myBase()
	if not b then return end
	local door = b:FindFirstChild("Door")
	if door and door ~= hookedDoor then
		hookedDoor = door
		door.CanCollide = false
		door:GetPropertyChangedSignal("CanCollide"):Connect(function()
			if door.CanCollide then door.CanCollide = false end
		end)
	end
	filterIn(b)
end

---------------------------------------------------------------- монстры в клетках
local bobbing = {}
local function addBob(m)
	if not m:IsA("Model") then return end
	bobbing[m] = { cf = m:GetPivot(), phase = math.random() * 6, glitch = m:GetAttribute("Mutation") == "glitch" }
end

local function setupBob()
	for _, m in ipairs(CollectionService:GetTagged("CageMonster")) do addBob(m) end
	CollectionService:GetInstanceAddedSignal("CageMonster"):Connect(function(m)
		task.defer(function() if m.Parent then addBob(m) end end)
	end)
	CollectionService:GetInstanceRemovedSignal("CageMonster"):Connect(function(m) bobbing[m] = nil end)
	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local camPos = cam.CFrame.Position
		local t = os.clock()
		for m, b in pairs(bobbing) do
			local root = m.PrimaryPart
			if not m.Parent or not root then
				bobbing[m] = nil
			elseif (b.cf.Position - camPos).Magnitude < 160 then
				local y = math.sin(t * 2 + b.phase) * 0.3 + 0.3
				local cf = b.cf * CFrame.new(0, y, 0) * CFrame.Angles(0, math.sin(t * 0.8 + b.phase) * 0.3, 0)
				if b.glitch and math.random() < 0.1 then cf = cf * CFrame.new(math.random() * 0.8 - 0.4, 0, math.random() * 0.8 - 0.4) end
				root.CFrame = cf
			end
		end
	end)
end

---------------------------------------------------------------- метка базы и таймер замков
local function update()
	local b = myBase()
	local carrying = (player:GetAttribute("Carrying") or "") ~= ""
	if b then
		local hm = b.Top:FindFirstChild("HomeMarker")
		if hm then hm.Enabled = carrying end
	end
	local bases = workspace:FindFirstChild("Bases")
	if not bases then return end
	local t = workspace:GetServerTimeNow()
	for _, base in ipairs(bases:GetChildren()) do
		local door = base:FindFirstChild("Door")
		local g = door and door:FindFirstChild("LockGui")
		if g and base:GetAttribute("Locked") then
			g.Text.Text = "🔒 " .. Util.time((base:GetAttribute("LockEnds") or 0) - t)
		end
	end
end

function Visuals.init()
	setupLighting()
	setupPrompts()
	setupBob()
	hookMyBase()
	player:GetAttributeChangedSignal("BaseIndex"):Connect(hookMyBase)
	task.spawn(function()
		while true do
			local ok, err = pcall(update)
			if not ok then warn("[CN] Visuals: " .. tostring(err)) end
			task.wait(0.25)
		end
	end)
end

return Visuals
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[-- Помощники постройки (сервер и клиент): детали, клинья, цилиндры, стены с проёмами,
-- свет, подсказки ProximityPrompt, надписи, текстуры. Все детали по умолчанию закреплены (Anchored).
local B = {}

local function apply(o, props)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then o[k] = v end
		end
	end
end
B.apply = apply

-- цвет: Color3, "#RRGGBB" или r, g, b (0..255)
function B.color(r, g, b)
	if typeof(r) == "Color3" then return r end
	if type(r) == "string" then return Color3.fromHex(r) end
	return Color3.fromRGB(r, g, b)
end

-- ID ассета из Config: "" -> "", "123" -> "rbxassetid://123", "rbxasset://..." -> как есть
function B.asset(id)
	if id == nil or id == "" then return "" end
	if tonumber(id) then return "rbxassetid://" .. tostring(id) end
	return tostring(id)
end

-- материал по имени с запасным вариантом (новые материалы вроде Carpet, Plaster, RoofShingles,
-- CeramicTiles, Leather, Rubber, Cardboard, ClayRoofTiles есть не во всех версиях)
function B.mat(name, fallback)
	local ok, m = pcall(function() return Enum.Material[name] end)
	if ok and m then return m end
	return fallback or Enum.Material.SmoothPlastic
end

function B.make(class, props, parent)
	local o = Instance.new(class)
	apply(o, props)
	o.Parent = parent or (props and props.Parent)
	return o
end

function B.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name or "Model"
	m.Parent = parent
	return m
end

function B.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name or "Folder"
	f.Parent = parent
	return f
end

local function basePart(class, parent, name, size, cf, color, material, props)
	local p = Instance.new(class)
	p.Name = name or class
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	if color then p.Color = B.color(color) end
	p.Material = material or Enum.Material.SmoothPlastic
	apply(p, props)
	p.Parent = parent
	return p
end

-- прямоугольная деталь: size — Vector3, cf — CFrame центра
function B.part(parent, name, size, cf, color, material, props)
	return basePart("Part", parent, name, size, cf, color, material, props)
end

-- клин: наклонная грань идёт от верхнего заднего (+Z) ребра к нижнему переднему (−Z)
function B.wedge(parent, name, size, cf, color, material, props)
	return basePart("WedgePart", parent, name, size, cf, color, material, props)
end

function B.cornerWedge(parent, name, size, cf, color, material, props)
	return basePart("CornerWedgePart", parent, name, size, cf, color, material, props)
end

-- цилиндр: ось вдоль X у cf; length — длина, d — диаметр
function B.cyl(parent, name, length, d, cf, color, material, props)
	local p = basePart("Part", parent, name, Vector3.new(length, d, d), cf, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- вертикальный цилиндр (ось вверх) с центром в cf
function B.vcyl(parent, name, height, d, cf, color, material, props)
	return B.cyl(parent, name, height, d, cf * CFrame.Angles(0, 0, math.rad(90)), color, material, props)
end

function B.ball(parent, name, d, cf, color, material, props)
	local p = basePart("Part", parent, name, Vector3.new(d, d, d), cf, color, material, props)
	p.Shape = Enum.PartType.Ball
	return p
end

-- невидимая служебная деталь (зоны, точки появления, якоря)
function B.marker(parent, name, size, cf, props)
	local p = basePart("Part", parent, name, size or Vector3.new(1, 1, 1), cf, nil, nil, props)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	apply(p, props)
	return p
end

-- Стена от точки a до точки b (обе — низ стены на полу), высота h, толщина th.
-- openings: { { at = расстояние от a до центра проёма, w = ширина, y0 = низ проёма, y1 = верх проёма }, ... }
-- Собирает стену из кусков вокруг проёмов (двери, окна). Возвращает Model.
-- Совет: внешние стены не тоньше 1 стада, иначе свет «протекает» сквозь них.
function B.wall(parent, name, a, b, h, th, color, material, openings, props)
	local m = B.model(parent, name)
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local len = flat.Magnitude
	if len < 0.01 then return m end
	local frame = CFrame.fromMatrix(a, flat.Unit, Vector3.yAxis)
	local function seg(x0, x1, y0, y1)
		if x1 - x0 < 0.02 or y1 - y0 < 0.02 then return end
		B.part(m, "Wall", Vector3.new(x1 - x0, y1 - y0, th), frame * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), color, material, props)
	end
	local list = {}
	for _, o in ipairs(openings or {}) do table.insert(list, o) end
	table.sort(list, function(p, q) return p.at < q.at end)
	local cursor = 0
	for _, o in ipairs(list) do
		local x0, x1 = o.at - o.w / 2, o.at + o.w / 2
		if x0 > cursor then seg(cursor, x0, 0, h) end
		if (o.y0 or 0) > 0 then seg(math.max(x0, cursor), x1, 0, o.y0) end
		if (o.y1 or h) < h then seg(math.max(x0, cursor), x1, o.y1, h) end
		cursor = math.max(cursor, x1)
	end
	seg(cursor, len, 0, h)
	return m
end

-- источник света: class = "PointLight" | "SpotLight" | "SurfaceLight"; тени включены по умолчанию
function B.light(parent, class, props)
	local l = Instance.new(class)
	l.Shadows = true
	apply(l, props)
	l.Parent = parent
	return l
end

-- подсказка взаимодействия (клавиша E по умолчанию)
function B.prompt(parent, name, action, object, props)
	local p = Instance.new("ProximityPrompt")
	p.Name = name or "Prompt"
	p.ActionText = action or ""
	p.ObjectText = object or ""
	p.MaxActivationDistance = 8
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	apply(p, props)
	p.Parent = parent
	return p
end

-- надпись на грани детали (вывески, таблички, экраны)
function B.sign(part, face, text, props, guiProps)
	local g = Instance.new("SurfaceGui")
	g.Name = "Sign"
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.LightInfluence = 1
	apply(g, guiProps)
	g.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text or ""
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.new(1, 1, 1)
	apply(l, props)
	l.Parent = g
	return g, l
end

-- повторяющаяся текстура (обои, плитка); id из Config.Images; пустой id — ничего не делаем
function B.texture(part, face, id, studsU, studsV, props)
	local url = B.asset(id)
	if url == "" then return nil end
	local t = Instance.new("Texture")
	t.Texture = url
	t.Face = face or Enum.NormalId.Front
	t.StudsPerTileU = studsU or 4
	t.StudsPerTileV = studsV or 4
	apply(t, props)
	t.Parent = part
	return t
end

-- одиночная картинка (плакат, лицо)
function B.decal(part, face, id, props)
	local url = B.asset(id)
	if url == "" then return nil end
	local d = Instance.new("Decal")
	d.Texture = url
	d.Face = face or Enum.NormalId.Front
	apply(d, props)
	d.Parent = part
	return d
end

function B.weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
	return w
end

function B.attrs(inst, t)
	for k, v in pairs(t) do inst:SetAttribute(k, v) end
	return inst
end

-- CFrame: позиция + поворот вокруг вертикали в градусах
function B.at(x, y, z, yawDeg)
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yawDeg or 0), 0)
end

return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Все настройки игры в одном месте: время дня и ночи, редкости, монстры, мутации,
-- события, магазин, цены и товары за Robux. Меняй цифры здесь — код подхватит сам.
local Config = {}

Config.GameName = "Catch a Nightmare"
Config.DataStoreName = "CatchNightmare_v1"

---------------------------------------------------------------- время
Config.DaySeconds = 240        -- день
Config.NightSeconds = 180      -- ночь
Config.RestockSeconds = 300    -- обновление лавки

---------------------------------------------------------------- старт
Config.StartFear = 50
Config.StartCages = 4
Config.MaxCages = 10           -- без геймпасса
Config.PassCages = 2           -- геймпасс «+2 клетки»
Config.OfflineRate = 0.5       -- доля дохода, пока игрока нет
Config.OfflineCapSeconds = 3 * 3600

-- цена N-й клетки (первые Config.StartCages бесплатные)
Config.CagePrices = { [5] = 300, [6] = 1000, [7] = 3000, [8] = 9000, [9] = 25000, [10] = 70000, [11] = 150000, [12] = 300000 }

-- сети: уровень сети решает, каких монстров можно поймать
Config.Nets = {
	{ level = 1, name = "Сачок", price = 0, speed = 1.0 },
	{ level = 2, name = "Крепкая сеть", price = 500, speed = 0.9 },
	{ level = 3, name = "Стальная сеть", price = 5000, speed = 0.8 },
	{ level = 4, name = "Неоновая сеть", price = 50000, speed = 0.7 },
	{ level = 5, name = "Сеть Пустоты", price = 500000, speed = 0.6 },
}

---------------------------------------------------------------- редкости
-- chance — «1 к N». Ролл идёт от самой редкой: шанс = удача / N, первая удачная побеждает.
-- hold — сколько секунд держать E, net — нужный уровень сети, scare — шанс напугать за секунду рядом.
-- nightOnly — днём такие не появляются.
Config.Rarities = {
	{ key = "common", name = "Обычный", color = Color3.fromRGB(190, 190, 190), chance = 1, hold = 0.4, net = 1, scare = 0.04, speed = 7 },
	{ key = "uncommon", name = "Необычный", color = Color3.fromRGB(90, 214, 90), chance = 4, hold = 0.6, net = 1, scare = 0.06, speed = 8 },
	{ key = "rare", name = "Редкий", color = Color3.fromRGB(64, 170, 255), chance = 12, hold = 1.0, net = 2, scare = 0.1, speed = 9 },
	{ key = "epic", name = "Эпический", color = Color3.fromRGB(184, 92, 255), chance = 50, hold = 1.5, net = 3, scare = 0.16, speed = 10, nightOnly = true },
	{ key = "legendary", name = "Легендарный", color = Color3.fromRGB(255, 180, 0), chance = 300, hold = 2.0, net = 4, scare = 0.22, speed = 11, nightOnly = true },
	{ key = "mythic", name = "Мифический", color = Color3.fromRGB(255, 60, 110), chance = 3000, hold = 2.5, net = 5, scare = 0.3, speed = 12, nightOnly = true },
	{ key = "secret", name = "Секретный", color = Color3.fromRGB(255, 255, 255), chance = 60000, hold = 3.0, net = 5, scare = 0.4, speed = 13, nightOnly = true },
}
Config.RarityIndex = {}
for i, r in ipairs(Config.Rarities) do
	r.tier = i
	Config.RarityIndex[r.key] = r
end
Config.AnnounceTier = 5        -- с этой редкости поимку видит весь сервер (5 = легендарный)
Config.StealAnnounceTier = 4   -- с этой редкости весь сервер видит кражу

---------------------------------------------------------------- монстры
-- income — «Страх» в секунду. sell = income * Config.SellMul. size — высота модели (для подписи и переноски).
Config.SellMul = 40
Config.Monsters = {
	{ key = "slipper", name = "Тапок-Кусака", rarity = "common", income = 1, size = 2.5 },
	{ key = "dustbun", name = "Пыльный Бубу", rarity = "common", income = 2, size = 3 },
	{ key = "fridge", name = "Холодильник Валера", rarity = "uncommon", income = 6, size = 6 },
	{ key = "sock", name = "Носок-Призрак", rarity = "uncommon", income = 8, size = 5 },
	{ key = "wardrobe", name = "Шкаф с Глазами", rarity = "rare", income = 25, size = 7 },
	{ key = "lamp", name = "Лампа-Шептун", rarity = "rare", income = 32, size = 6 },
	{ key = "grandma", name = "Бабушка Wi-Fi", rarity = "epic", income = 110, size = 6 },
	{ key = "matryoshka", name = "Матрёшка-Паук", rarity = "epic", income = 140, size = 5 },
	{ key = "cat404", name = "Кот 404", rarity = "legendary", income = 600, size = 5 },
	{ key = "pizzademon", name = "Пицца-Демон", rarity = "legendary", income = 750, size = 6 },
	{ key = "moonhead", name = "Луноголовый", rarity = "mythic", income = 4000, size = 9 },
	{ key = "nobody", name = "Тот-Кого-Нет", rarity = "secret", income = 30000, size = 9 },
}
Config.MonsterIndex = {}
Config.MonstersByRarity = {}
for _, m in ipairs(Config.Monsters) do
	Config.MonsterIndex[m.key] = m
	local list = Config.MonstersByRarity[m.rarity]
	if not list then
		list = {}
		Config.MonstersByRarity[m.rarity] = list
	end
	table.insert(list, m)
end

---------------------------------------------------------------- мутации
-- chance — «1 к N» при появлении; mul — множитель дохода
Config.Mutations = {
	{ key = "gold", name = "Золотой", mul = 2, chance = 25, color = Color3.fromRGB(255, 205, 60) },
	{ key = "blood", name = "Кровавый", mul = 3, chance = 0, color = Color3.fromRGB(190, 10, 30) },   -- только в Кровавую луну
	{ key = "glitch", name = "Глитч", mul = 5, chance = 250, color = Color3.fromRGB(170, 60, 255) },
}
Config.MutationIndex = {}
for _, m in ipairs(Config.Mutations) do Config.MutationIndex[m.key] = m end

---------------------------------------------------------------- события ночи
-- выпадают в начале ночи: weight — вес (из 100), остальное — обычная ночь
Config.Events = {
	{ key = "bloodmoon", name = "КРОВАВАЯ ЛУНА", text = "удача ×3, кровавые мутации", weight = 18, luck = 3, color = Color3.fromRGB(255, 50, 50) },
	{ key = "glitch", name = "ГЛИТЧ-НОЧЬ", text = "глитч-мутации ×25", weight = 10, luck = 1.5, color = Color3.fromRGB(180, 80, 255) },
	{ key = "fog", name = "ТУМАН", text = "монстров больше, но их почти не видно", weight = 15, luck = 1.2, color = Color3.fromRGB(170, 180, 200) },
}
Config.EventIndex = {}
for _, e in ipairs(Config.Events) do Config.EventIndex[e.key] = e end
Config.BloodMutationChance = 3    -- в Кровавую луну «1 к 3» станет кровавым
Config.GlitchNightMul = 25        -- в Глитч-ночь глитч в 25 раз чаще

---------------------------------------------------------------- дикие монстры
Config.Wild = {
	DayInterval = 7, DayMax = 8,         -- днём редко и только до «Редкого»
	NightInterval = 2.4, NightMax = 22,
	FogBonus = 6,                        -- в туман можно на столько больше монстров
	LifeMin = 80, LifeMax = 140,         -- через сколько секунд монстр убегает
	ScareRange = 10, ScareCooldown = 6, StunSeconds = 1.3,
	ReserveSeconds = 12,                 -- монстр из приманки — только для хозяина приманки
	FirstCatchHelp = true,               -- новичку у базы появляется лёгкий монстр
}

---------------------------------------------------------------- переноска и кража
Config.CarrySpeed = 12          -- скорость с монстром на голове (обычная — 16)
Config.CarryRareSpeed = 10      -- с эпическим и выше
Config.TackleHold = 0.5         -- держать E, чтобы отобрать монстра у игрока
Config.TackleImmunity = 3       -- после отбора столько секунд нельзя отобрать снова
Config.StealHold = 1.8          -- держать E, чтобы утащить монстра из чужой клетки
Config.SellHold = 1.0
Config.LockSeconds = 60         -- замок базы

---------------------------------------------------------------- лавка
-- приманки: luck — множитель удачи, gold — во сколько раз чаще золотые, inStock — шанс появиться в лавке
Config.Baits = {
	{ key = "bait", name = "Приманка", price = 100, luck = 1.5, inStock = 1, min = 3, max = 8, icon = "🍖" },
	{ key = "golden", name = "Золотая приманка", price = 2500, luck = 4, gold = 5, inStock = 0.6, min = 1, max = 3, icon = "✨" },
	{ key = "blood", name = "Кровавая приманка", price = 25000, luck = 12, blood = true, inStock = 0.2, min = 1, max = 1, icon = "🩸" },
	{ key = "void", name = "Приманка Пустоты", price = 250000, luck = 40, inStock = 0.05, min = 1, max = 1, icon = "🕳" },
}
Config.BaitIndex = {}
for _, b in ipairs(Config.Baits) do Config.BaitIndex[b.key] = b end
Config.BaitDelay = 3            -- через сколько секунд из приманки вылезает монстр

---------------------------------------------------------------- Robux
-- Впиши ID из Creator Hub (Monetization). 0 — товар выключен.
Config.Products = {
	ServerLuck = { id = 0, name = "Удача ×2 для всего сервера", minutes = 15, robux = 49 },
}
Config.Passes = {
	DoubleFear = { id = 0, name = "×2 Страха навсегда", robux = 199 },
	ExtraCages = { id = 0, name = "+2 клетки", robux = 149 },
}

-- админы (UserId) для команд /night, /bloodmoon ... В Studio и у владельца игры работают всегда.
Config.Admins = {}

---------------------------------------------------------------- звуки
-- Встроенные звуки Roblox (rbxasset://) работают сразу. Свои — впиши цифры ID.
Config.Sounds = {
	Catch = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/button.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
	Scream = "rbxasset://sounds/uuhhh.mp3",
	Alarm = "rbxasset://sounds/clickfast.wav",
	Cash = "rbxasset://sounds/electronicpingshort.wav",
	NightStart = "",
	DayStart = "",
	Jumpscare = "",
}

---------------------------------------------------------------- карта
Config.Map = {
	BaseCount = 8,
	BaseRadius = 262,      -- центры баз от центра карты
	BaseSize = 64,         -- квадрат базы
	WallHeight = 14,
	SafeRadius = 32,       -- поляна с костром: монстры не подходят
	ForestMin = 44, ForestMax = 192,
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Monsters</string><ProtectedString name="Source"><![CDATA[-- Модели монстров из простых деталей. Monsters.build(key, mutation) -> Model, Root.
-- Root — невидимая закреплённая деталь у ног монстра (перед — сторона −Z). Остальные детали
-- приварены к Root, без столкновений и без массы: монстра можно двигать одним Root.CFrame
-- и носить на голове. Подпись над монстром — Monsters.label(model, text...).
local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local Monsters = {}

local hex = Color3.fromHex
local rad = math.rad
local EYE_WHITE = Color3.fromRGB(245, 245, 245)
local BLACK = Color3.fromRGB(10, 10, 10)

-- конструктор деталей вокруг корня
local function ctx(m, root)
	local c = {}
	local function finish(p, off, color, mat, props)
		p.CFrame = root.CFrame * off
		p.Color = color
		p.Material = mat or Enum.Material.SmoothPlastic
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if props then
			for k, v in pairs(props) do p[k] = v end
		end
		p.Parent = m
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		return p
	end
	-- брусок: размер, позиция, цвет, материал, поворот (CFrame), свойства
	function c.box(sx, sy, sz, x, y, z, color, mat, rot, props)
		local p = Instance.new("Part")
		p.Size = Vector3.new(sx, sy, sz)
		return finish(p, CFrame.new(x, y, z) * (rot or CFrame.new()), color, mat, props)
	end
	function c.ball(d, x, y, z, color, mat, props)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(d, d, d)
		return finish(p, CFrame.new(x, y, z), color, mat, props)
	end
	-- вертикальный цилиндр
	function c.vcyl(h, d, x, y, z, color, mat, props)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(h, d, d)
		return finish(p, CFrame.new(x, y, z) * CFrame.Angles(0, 0, rad(90)), color, mat, props)
	end
	-- плоский цилиндр, смотрящий вперёд (−Z): пуговицы, пепперони
	function c.disc(d, th, x, y, z, color, mat, props)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(th, d, d)
		return finish(p, CFrame.new(x, y, z) * CFrame.Angles(0, rad(90), 0), color, mat, props)
	end
	function c.wedge(sx, sy, sz, x, y, z, color, mat, rot, props)
		local p = Instance.new("WedgePart")
		p.Size = Vector3.new(sx, sy, sz)
		return finish(p, CFrame.new(x, y, z) * (rot or CFrame.new()), color, mat, props)
	end
	-- глаз: белок + зрачок впереди; detail = без мутационной перекраски
	function c.eye(x, y, z, d, pupil, white)
		local e = c.ball(d, x, y, z, white or EYE_WHITE, Enum.Material.SmoothPlastic)
		e:SetAttribute("NoTint", true)
		local p = c.ball(d * 0.5, x, y, z - d * 0.32, pupil or BLACK, Enum.Material.SmoothPlastic)
		p:SetAttribute("NoTint", true)
		return e, p
	end
	function c.light(y, color, range, brightness)
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, y, 0)
		a.Parent = root
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = range or 10
		l.Brightness = brightness or 1
		l.Shadows = false
		l.Parent = a
		return l
	end
	return c
end

