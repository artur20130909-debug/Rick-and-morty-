<Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">PhoneConfig</string><ProtectedString name="Source"><![CDATA[-- Настройки игры «Мой iPhone Duo». Этот модуль читают и сервер, и клиент.
local Config = {}

Config.ToolName = "iPhone Duo"

-- Как телефон лежит в руке. Если в руке он стоит криво — поменяй цифры:
-- Y — выше/ниже, X — левее/правее.
Config.Grip = CFrame.new(0, -0.45, 0)

-- Батарея (в процентах)
Config.Battery = {
	Start = 100,
	IdleDrain = 0.05, -- в секунду, когда телефон просто в руке
	FlashlightDrain = 0.35, -- дополнительно, пока горит фонарик
	MusicDrain = 0.25, -- дополнительно, пока играет музыка
	ChargeRate = 6, -- в секунду на зарядной станции
	ChargeRadius = 7, -- в стадах от центра зарядки
}

-- Турбо-бег
Config.Turbo = { Speed = 42, Duration = 8, Cooldown = 20, Cost = 8 }

-- Цвета корпуса (меняются в приложении «Цвет», видят все игроки)
Config.Colors = {
	{ Name = "Натуральный титан", Color = Color3.fromRGB(190, 184, 172) },
	{ Name = "Космический чёрный", Color = Color3.fromRGB(45, 45, 50) },
	{ Name = "Небесно-голубой", Color = Color3.fromRGB(120, 170, 220) },
	{ Name = "Розовое золото", Color = Color3.fromRGB(232, 178, 160) },
	{ Name = "Мятный", Color = Color3.fromRGB(150, 215, 185) },
	{ Name = "Фиолетовый", Color = Color3.fromRGB(150, 110, 200) },
	{ Name = "Красный (PRODUCT)", Color = Color3.fromRGB(200, 40, 50) },
	{ Name = "Золотой", Color = Color3.fromRGB(230, 195, 110) },
}

-- Обои экрана (только у тебя)
Config.Wallpapers = {
	{ Name = "Закат", A = Color3.fromRGB(255, 120, 90), B = Color3.fromRGB(120, 60, 200) },
	{ Name = "Океан", A = Color3.fromRGB(40, 180, 230), B = Color3.fromRGB(20, 40, 120) },
	{ Name = "Лес", A = Color3.fromRGB(120, 210, 120), B = Color3.fromRGB(20, 80, 60) },
	{ Name = "Ночь", A = Color3.fromRGB(60, 60, 90), B = Color3.fromRGB(10, 10, 20) },
	{ Name = "Конфета", A = Color3.fromRGB(255, 160, 210), B = Color3.fromRGB(150, 200, 255) },
}

-- Места для приложения «Карта». Позиции совпадают с картой из MapBuilder.
Config.Locations = {
	{ Name = "Спавн", Icon = "🏠", Position = Vector3.new(0, 4, 0) },
	{ Name = "Магазин Duo", Icon = "🛍️", Position = Vector3.new(0, 4, -70) },
	{ Name = "Крыша башни", Icon = "🗼", Position = Vector3.new(74, 64, 34) },
	{ Name = "Пляж", Icon = "🏖️", Position = Vector3.new(-90, 4, 60) },
	{ Name = "Парк", Icon = "🌳", Position = Vector3.new(70, 4, -40) },
}

-- Зарядные станции (позиции центра)
Config.Chargers = {
	Vector3.new(14, 0.6, 10),
	Vector3.new(-14, 0.6, -54),
	Vector3.new(86, 61.2, 46),
}

-- Музыка. Roblox часто закрывает звуки авторов, поэтому, если трек молчит,
-- найди другой в Toolbox → Audio и впиши его цифры сюда или прямо в приложение.
Config.Music = {
	{ Name = "Relaxed Scene", Id = "1848354536" },
	{ Name = "Time To Relax", Id = "9044702906" },
	{ Name = "Трек 3", Id = "1837849285" },
}
Config.MusicVolume = 0.5

-- Встроенные звуки Roblox (работают всегда)
Config.Sounds = {
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Ring = "rbxasset://sounds/electronicpingshort.wav",
	Shutter = "rbxasset://sounds/swoosh.wav",
	Notify = "rbxasset://sounds/electronicpingshort.wav",
}

-- Сутки в игре: сколько реальных минут длится один игровой день
Config.DayLengthMinutes = 10

-- Сообщения
Config.MessageMaxLength = 120
Config.MessageCooldown = 2
Config.CallCooldown = 6

-- Мини-игра «Тап-тап»
Config.TapGameSeconds = 15

return Config
]]></ProtectedString></Properties></Item></Item>
<Item class="ServerStorage" referent="RBX00000005"><Properties><string name="Name">ServerStorage</string></Properties></Item>
<Item class="ServerScriptService" referent="RBX00000008"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Строит карту при запуске: спавн, магазин Duo, башня, пляж, парк, зарядные станции.
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("PhoneConfig"))

local Map = {}

local function make(className, props)
	local inst = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
Map.make = make

local function block(parent, name, size, cf, color, material, extra)
	local p = make("Part", {
		Name = name,
		Size = size,
		CFrame = cf,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Anchored = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Parent = parent,
	})
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
	return p
end
Map.block = block

local function sign(part, face, text, textColor, bgColor)
	local gui = make("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
		Parent = part,
	})
	make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = bgColor or Color3.new(1, 1, 1),
		BackgroundTransparency = bgColor and 0 or 1,
		Text = text,
		TextScaled = true,
		Font = Enum.Font.GothamBold,
		TextColor3 = textColor or Color3.new(0, 0, 0),
		Parent = gui,
	})
	return gui
end
Map.sign = sign

local function tree(parent, pos, scale)
	scale = scale or 1
	local trunkH = 8 * scale
	block(parent, "Trunk", Vector3.new(1.6 * scale, trunkH, 1.6 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)),
		Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	local leaves = block(parent, "Leaves", Vector3.new(9, 9, 9) * scale, CFrame.new(pos + Vector3.new(0, trunkH + 3 * scale, 0)),
		Color3.fromRGB(70, 160, 70), Enum.Material.Grass)
	leaves.Shape = Enum.PartType.Ball
end

-- Большая статуя телефона у магазина
local function phoneStatue(parent, cf)
	local model = make("Model", { Name = "DuoStatue", Parent = parent })
	local w, h, t = 8, 16, 1
	local body = Color3.fromRGB(190, 184, 172)
	block(model, "LeftBody", Vector3.new(w, h, t), cf * CFrame.new(-w / 2 - 0.25, 0, 0), body, Enum.Material.Metal)
	block(model, "RightBody", Vector3.new(w, h, t), cf * CFrame.new(w / 2 + 0.25, 0, 0), body, Enum.Material.Metal)
	local hinge = block(model, "Hinge", Vector3.new(h, 0.8, 0.8), cf * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(120, 120, 125), Enum.Material.Metal)
	hinge.Shape = Enum.PartType.Cylinder
	for i, side in ipairs({ -1, 1 }) do
		local scr = block(model, "Screen" .. i, Vector3.new(w - 0.6, h - 0.8, 0.1),
			cf * CFrame.new(side * (w / 2 + 0.25), 0, t / 2 + 0.05), Color3.fromRGB(20, 20, 30), Enum.Material.Neon)
		local gui = make("SurfaceGui", { Face = Enum.NormalId.Back, LightInfluence = 0,
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 30, Parent = scr })
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = gui })
		make("UIGradient", { Rotation = 90, Color = ColorSequence.new(
			i == 1 and Color3.fromRGB(255, 120, 90) or Color3.fromRGB(40, 180, 230),
			i == 1 and Color3.fromRGB(120, 60, 200) or Color3.fromRGB(20, 40, 120)), Parent = bg })
		make("TextLabel", { Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.12), BackgroundTransparency = 1,
			Text = i == 1 and "iPhone" or "Duo", TextScaled = true, Font = Enum.Font.GothamBlack,
			TextColor3 = Color3.new(1, 1, 1), Parent = bg })
		make("TextLabel", { Size = UDim2.fromScale(1, 0.1), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 1,
			Text = i == 1 and "Два экрана." or "Один телефон.", TextScaled = true, Font = Enum.Font.Gotham,
			TextColor3 = Color3.new(1, 1, 1), Parent = bg })
	end
	-- Камеры сзади
	local bump = block(model, "CameraBump", Vector3.new(3, 3, 0.4), cf * CFrame.new(-w / 2 - 0.25 - 1.5, h / 2 - 2.5, -t / 2 - 0.2),
		Color3.fromRGB(60, 60, 65), Enum.Material.Glass)
	for _, dy in ipairs({ 0.7, -0.7 }) do
		local lens = block(model, "Lens", Vector3.new(0.3, 1.1, 1.1),
			bump.CFrame * CFrame.new(0, dy, -0.3) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(15, 15, 25), Enum.Material.Glass)
		lens.Shape = Enum.PartType.Cylinder
	end
	return model
end

local function charger(parent, pos)
	local pad = block(parent, "Charger", Vector3.new(8, 0.4, 8), CFrame.new(pos), Color3.fromRGB(60, 230, 120), Enum.Material.Neon)
	pad.Shape = Enum.PartType.Cylinder
	pad.Size = Vector3.new(0.4, 9, 9)
	pad.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	local post = block(parent, "ChargerSign", Vector3.new(4, 2, 0.3), CFrame.new(pos + Vector3.new(0, 5, -4.4)),
		Color3.fromRGB(30, 30, 35), Enum.Material.SmoothPlastic)
	sign(post, Enum.NormalId.Back, "⚡ ЗАРЯДКА", Color3.fromRGB(90, 255, 140), Color3.fromRGB(30, 30, 35))
	sign(post, Enum.NormalId.Front, "⚡ ЗАРЯДКА", Color3.fromRGB(90, 255, 140), Color3.fromRGB(30, 30, 35))
	block(parent, "ChargerPole", Vector3.new(0.4, 4, 0.4), CFrame.new(pos + Vector3.new(0, 2, -4.4)), Color3.fromRGB(80, 80, 85), Enum.Material.Metal)
	make("PointLight", { Color = Color3.fromRGB(90, 255, 140), Range = 12, Brightness = 2, Parent = pad })
end

local function store(parent)
	local m = make("Model", { Name = "DuoStore", Parent = parent })
	local c = CFrame.new(0, 0, -80)
	local white = Color3.fromRGB(245, 245, 245)
	block(m, "Floor", Vector3.new(50, 1, 34), c * CFrame.new(0, 0.5, 0), Color3.fromRGB(225, 220, 210), Enum.Material.Marble)
	block(m, "Roof", Vector3.new(52, 1, 36), c * CFrame.new(0, 14.5, 0), white)
	block(m, "BackWall", Vector3.new(50, 14, 1), c * CFrame.new(0, 7.5, -16.5), white)
	block(m, "LeftWall", Vector3.new(1, 14, 34), c * CFrame.new(-24.5, 7.5, 0), white)
	block(m, "RightWall", Vector3.new(1, 14, 34), c * CFrame.new(24.5, 7.5, 0), white)
	-- Стеклянный фасад со входом посередине
	for _, x in ipairs({ -15.5, 15.5 }) do
		block(m, "Glass", Vector3.new(18, 13, 0.4), c * CFrame.new(x, 7.5, 16.8), Color3.fromRGB(180, 220, 255), Enum.Material.Glass,
			{ Transparency = 0.6 })
	end
	block(m, "GlassTop", Vector3.new(13, 4, 0.4), c * CFrame.new(0, 12, 16.8), Color3.fromRGB(180, 220, 255), Enum.Material.Glass,
		{ Transparency = 0.6 })
	local logo = block(m, "Logo", Vector3.new(20, 3, 0.4), c * CFrame.new(0, 17, 17), Color3.fromRGB(30, 30, 35))
	sign(logo, Enum.NormalId.Back, "  DUO STORE", Color3.new(1, 1, 1), Color3.fromRGB(30, 30, 35))
	block(m, "LogoPole", Vector3.new(1, 2.5, 0.4), c * CFrame.new(0, 15.3, 17), Color3.fromRGB(30, 30, 35))
	-- Столы с витринными телефонами
	local colors = Config.Colors
	local idx = 1
	for row = -1, 1, 2 do
		for col = -1, 1 do
			local tcf = c * CFrame.new(col * 13, 0, row * 6)
			block(m, "Table", Vector3.new(9, 0.4, 4), tcf * CFrame.new(0, 3.2, 0), Color3.fromRGB(205, 170, 120), Enum.Material.Wood)
			for _, lx in ipairs({ -4, 4 }) do
				block(m, "Leg", Vector3.new(0.4, 2.2, 3.4), tcf * CFrame.new(lx, 1.9, 0), Color3.fromRGB(230, 230, 230))
			end
			for k = -1, 1 do
				local col3 = colors[((idx - 1) % #colors) + 1].Color
				idx = idx + 1
				local base = tcf * CFrame.new(k * 2.6, 3.5, 0) * CFrame.Angles(math.rad(-80), 0, 0)
				block(m, "DemoL", Vector3.new(0.8, 1.6, 0.1), base * CFrame.new(-0.42, 0, 0), col3, Enum.Material.Metal)
				block(m, "DemoR", Vector3.new(0.8, 1.6, 0.1), base * CFrame.new(0.42, 0, 0), col3, Enum.Material.Metal)
				block(m, "DemoScreen", Vector3.new(1.55, 1.5, 0.02), base * CFrame.new(0, 0, 0.06), Color3.fromRGB(80, 140, 255), Enum.Material.Neon)
			end
		end
	end
	make("PointLight", { Range = 40, Brightness = 1.2, Parent = m:FindFirstChild("Roof") })
	return m
end

local function tower(parent)
	local m = make("Model", { Name = "Tower", Parent = parent })
	local base = Vector3.new(80, 0, 40)
	local h = 60
	block(m, "Core", Vector3.new(10, h, 10), CFrame.new(base + Vector3.new(0, h / 2, 0)), Color3.fromRGB(200, 200, 210), Enum.Material.Concrete)
	-- Круглая площадка наверху; с северной стороны (откуда приходит лестница) перил нет
	local top = block(m, "Top", Vector3.new(1, 26, 26), CFrame.new(base + Vector3.new(0, h + 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(90, 90, 100), Enum.Material.DiamondPlate)
	top.Shape = Enum.PartType.Cylinder
	for _, d in ipairs({ { 0, 12 }, { 12, 0 }, { -12, 0 } }) do
		local sx = d[1] == 0 and 16 or 0.5
		local sz = d[1] == 0 and 0.5 or 16
		block(m, "Rail", Vector3.new(sx, 3, sz), CFrame.new(base + Vector3.new(d[1], h + 2.5, d[2])), Color3.fromRGB(180, 220, 255),
			Enum.Material.Glass, { Transparency = 0.5 })
	end
	-- Спиральная лестница
	local steps = 60
	for i = 0, steps - 1 do
		local a = i / steps * math.pi * 6
		local y = (i + 1) * (h / steps)
		block(m, "Step", Vector3.new(4, 1, 6), CFrame.new(base + Vector3.new(0, y, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -16),
			Color3.fromRGB(150, 150, 160), Enum.Material.Metal)
	end
	local beacon = block(m, "Beacon", Vector3.new(2, 2, 2), CFrame.new(base + Vector3.new(0, h + 8, 0)), Color3.fromRGB(255, 80, 80), Enum.Material.Neon)
	beacon.Shape = Enum.PartType.Ball
	block(m, "Antenna", Vector3.new(0.4, 6, 0.4), CFrame.new(base + Vector3.new(0, h + 4, 0)), Color3.fromRGB(120, 120, 125), Enum.Material.Metal)
	make("PointLight", { Color = Color3.fromRGB(255, 80, 80), Range = 30, Brightness = 3, Parent = beacon })
	local s = block(m, "TowerSign", Vector3.new(10, 3, 0.4), CFrame.new(base + Vector3.new(0, 8, -5.2)), Color3.fromRGB(30, 30, 35))
	sign(s, Enum.NormalId.Front, "📶 ВЫШКА 5G", Color3.fromRGB(255, 220, 90), Color3.fromRGB(30, 30, 35))
end

local function beach(parent)
	local m = make("Model", { Name = "Beach", Parent = parent })
	block(m, "Sand", Vector3.new(70, 1, 60), CFrame.new(-100, 0.2, 70), Color3.fromRGB(235, 215, 160), Enum.Material.Sand)
	block(m, "Water", Vector3.new(60, 1, 60), CFrame.new(-150, 0.1, 70), Color3.fromRGB(60, 150, 220), Enum.Material.Glass,
		{ Transparency = 0.35, CanCollide = false })
	for i, x in ipairs({ -95, -110, -85 }) do
		local z = 55 + i * 9
		block(m, "Towel", Vector3.new(3, 0.1, 6), CFrame.new(x, 0.75, z), i % 2 == 0 and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(80, 170, 255),
			Enum.Material.Fabric)
		block(m, "UmbrellaPole", Vector3.new(0.3, 7, 0.3), CFrame.new(x + 2.5, 4, z), Color3.fromRGB(240, 240, 240))
		local top = block(m, "Umbrella", Vector3.new(1, 8, 8), CFrame.new(x + 2.5, 7.6, z) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(255, 200, 60), Enum.Material.Fabric)
		top.Shape = Enum.PartType.Cylinder
	end
	for _, p in ipairs({ Vector3.new(-120, 0.7, 45), Vector3.new(-78, 0.7, 95) }) do
		tree(m, p, 0.9)
	end
end

local function park(parent)
	local m = make("Model", { Name = "Park", Parent = parent })
	local rng = Random.new(7)
	for _ = 1, 14 do
		tree(m, Vector3.new(rng:NextNumber(40, 110), 0.5, rng:NextNumber(-80, -10)), rng:NextNumber(0.8, 1.3))
	end
	for i = 0, 2 do
		local cf = CFrame.new(60 + i * 10, 0, -35)
		block(m, "BenchSeat", Vector3.new(6, 0.4, 2), cf * CFrame.new(0, 1.8, 0), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
		block(m, "BenchBack", Vector3.new(6, 2, 0.3), cf * CFrame.new(0, 3, 0.9), Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
		block(m, "BenchLegs", Vector3.new(5.6, 1.6, 1.6), cf * CFrame.new(0, 0.8, 0), Color3.fromRGB(60, 60, 60), Enum.Material.Metal,
			{ Transparency = 0 })
	end
end

local function roads(parent)
	local gray = Color3.fromRGB(70, 70, 75)
	block(parent, "Road1", Vector3.new(12, 0.2, 180), CFrame.new(0, 0.6, -10), gray, Enum.Material.Asphalt)
	block(parent, "Road2", Vector3.new(200, 0.2, 12), CFrame.new(-10, 0.6, 30), gray, Enum.Material.Asphalt)
	block(parent, "SpawnPlaza", Vector3.new(36, 0.3, 36), CFrame.new(0, 0.65, 0), Color3.fromRGB(215, 215, 220), Enum.Material.Slate)
end

function Map.build()
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 12
	Lighting.Brightness = 2
	Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 140)
	Lighting.Ambient = Color3.fromRGB(60, 60, 70)

	local world = make("Folder", { Name = "DuoWorld", Parent = workspace })
	block(world, "Ground", Vector3.new(600, 1, 600), CFrame.new(0, 0, 0), Color3.fromRGB(100, 180, 90), Enum.Material.Grass)
	roads(world)

	local spawn = make("SpawnLocation", {
		Name = "Spawn",
		Size = Vector3.new(10, 1, 10),
		CFrame = CFrame.new(0, 1, 0),
		Anchored = true,
		Color = Color3.fromRGB(80, 140, 255),
		Material = Enum.Material.Neon,
		Duration = 0,
		Parent = world,
	})
	local welcome = block(world, "Welcome", Vector3.new(18, 5, 0.5), CFrame.new(0, 7, -14), Color3.fromRGB(30, 30, 35))
	sign(welcome, Enum.NormalId.Back, "📱 МОЙ iPHONE DUO\nОн уже у тебя в инвентаре!", Color3.new(1, 1, 1), Color3.fromRGB(30, 30, 35))
	block(world, "WelcomePole", Vector3.new(0.6, 5, 0.6), CFrame.new(0, 2.5, -14), Color3.fromRGB(80, 80, 85), Enum.Material.Metal)

	store(world)
	phoneStatue(world, CFrame.new(-34, 8.6, -50) * CFrame.Angles(0, math.rad(25), 0))
	tower(world)
	beach(world)
	park(world)
	for _, pos in ipairs(Config.Chargers) do
		charger(world, pos)
	end
	return spawn
end

return Map
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000007"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Сервер игры «Мой iPhone Duo»: строит карту, собирает телефон и кладёт его каждому игроку в инвентарь,
-- считает батарею и выполняет действия приложений (фонарик, музыка, чат, звонки, карта, турбо, цвет).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage:WaitForChild("PhoneConfig"))
local Map = require(script.Parent:WaitForChild("MapBuilder"))
local make = Map.make

Map.build()

-- Каналы связи с клиентом
local remotes = make("Folder", { Name = "PhoneRemotes", Parent = ReplicatedStorage })
local actionEvent = make("RemoteEvent", { Name = "PhoneAction", Parent = remotes })
local notifyEvent = make("RemoteEvent", { Name = "PhoneNotify", Parent = remotes })

local function now()
	return workspace:GetServerTimeNow()
end

----------------------------------------------------------------------------------------------------
-- Модель телефона: две половинки, петля посередине, два экрана, двойная камера и вспышка.
----------------------------------------------------------------------------------------------------
local HALF_W, HALF_H, THICK, GAP = 0.8, 1.6, 0.1, 0.06

local function phonePart(name, size, color, material, parent)
	return make("Part", {
		Name = name,
		Size = size,
		Color = color,
		Material = material or Enum.Material.Metal,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Massless = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Parent = parent,
	})
end

local function screenGui(part, name)
	local gui = make("SurfaceGui", {
		Name = name,
		Face = Enum.NormalId.Back, -- задняя грань детали смотрит на игрока, который держит телефон
		LightInfluence = 0,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 160,
		Parent = part,
	})
	local bg = make("Frame", { Name = "Bg", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Parent = gui })
	make("UIGradient", { Name = "Wallpaper", Rotation = 90, Color = ColorSequence.new(Config.Wallpapers[1].A, Config.Wallpapers[1].B), Parent = bg })
	return gui, bg
end

local function buildPhoneTool()
	local tool = make("Tool", {
		Name = Config.ToolName,
		ToolTip = "Твой телефон с двумя экранами",
		CanBeDropped = false,
		RequiresHandle = true,
		Grip = Config.Grip,
	})
	local bodyColor = Config.Colors[1].Color
	local handle = phonePart("Handle", Vector3.new(HALF_W, HALF_H, THICK), bodyColor, Enum.Material.Metal, tool)
	handle.CFrame = CFrame.new()
	local base = handle.CFrame
	local rightX = HALF_W + GAP

	local right = phonePart("RightBody", Vector3.new(HALF_W, HALF_H, THICK), bodyColor, Enum.Material.Metal, tool)
	right.CFrame = base * CFrame.new(rightX, 0, 0)

	local hinge = phonePart("Hinge", Vector3.new(HALF_H, 0.09, 0.09), Color3.fromRGB(120, 120, 128), Enum.Material.Metal, tool)
	hinge.Shape = Enum.PartType.Cylinder
	hinge.CFrame = base * CFrame.new(rightX / 2, 0, 0) * CFrame.Angles(0, 0, math.rad(90))

	-- Экраны (на стороне +Z, к игроку)
	local leftScreen = phonePart("LeftScreen", Vector3.new(HALF_W - 0.06, HALF_H - 0.08, 0.01), Color3.fromRGB(10, 10, 14), Enum.Material.Glass, tool)
	leftScreen.CFrame = base * CFrame.new(0, 0, THICK / 2 + 0.006)
	local rightScreen = phonePart("RightScreen", Vector3.new(HALF_W - 0.06, HALF_H - 0.08, 0.01), Color3.fromRGB(10, 10, 14), Enum.Material.Glass, tool)
	rightScreen.CFrame = base * CFrame.new(rightX, 0, THICK / 2 + 0.006)

	local _, lbg = screenGui(leftScreen, "Display")
	make("TextLabel", { Name = "Clock", Size = UDim2.fromScale(1, 0.22), Position = UDim2.fromScale(0, 0.12), BackgroundTransparency = 1,
		Text = "12:00", TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), Parent = lbg })
	make("TextLabel", { Name = "Label", Size = UDim2.fromScale(1, 0.08), Position = UDim2.fromScale(0, 0.36), BackgroundTransparency = 1,
		Text = "iPhone Duo", TextScaled = true, Font = Enum.Font.Gotham, TextColor3 = Color3.new(1, 1, 1), Parent = lbg })
	make("TextLabel", { Name = "Battery", Size = UDim2.fromScale(0.9, 0.07), Position = UDim2.fromScale(0.05, 0.02), BackgroundTransparency = 1,
		Text = "100%", TextScaled = true, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.new(1, 1, 1), Parent = lbg })

	local _, rbg = screenGui(rightScreen, "Display")
	make("TextLabel", { Name = "AppIcon", Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.25), BackgroundTransparency = 1,
		Text = "📱", TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), Parent = rbg })
	make("TextLabel", { Name = "AppName", Size = UDim2.fromScale(1, 0.09), Position = UDim2.fromScale(0, 0.6), BackgroundTransparency = 1,
		Text = "Главный экран", TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1), Parent = rbg })

	-- Задняя сторона левой половинки: двойная камера и вспышка
	local bump = phonePart("CameraBump", Vector3.new(0.36, 0.36, 0.03), Color3.fromRGB(40, 40, 45), Enum.Material.Glass, tool)
	bump.CFrame = base * CFrame.new(-0.14, 0.55, -THICK / 2 - 0.015)
	for i, dy in ipairs({ 0.08, -0.08 }) do
		local lens = phonePart("Lens" .. i, Vector3.new(0.03, 0.13, 0.13), Color3.fromRGB(10, 10, 20), Enum.Material.Glass, tool)
		lens.Shape = Enum.PartType.Cylinder
		lens.CFrame = bump.CFrame * CFrame.new(-0.06, dy, -0.02) * CFrame.Angles(0, math.rad(90), 0)
	end
	local flash = phonePart("Flash", Vector3.new(0.06, 0.06, 0.02), Color3.fromRGB(255, 240, 200), Enum.Material.SmoothPlastic, tool)
	flash.CFrame = bump.CFrame * CFrame.new(0.1, 0.08, -0.02)
	make("SpotLight", { Name = "Torch", Face = Enum.NormalId.Front, Angle = 70, Range = 45, Brightness = 6,
		Color = Color3.fromRGB(255, 245, 225), Shadows = true, Enabled = false, Parent = flash })

	-- Звуки из телефона (их слышат все рядом)
	make("Sound", { Name = "Music", Volume = Config.MusicVolume, Looped = true, RollOffMaxDistance = 80, Parent = handle })
	make("Sound", { Name = "Ring", SoundId = Config.Sounds.Ring, Volume = 0.8, PlaybackSpeed = 1.2, RollOffMaxDistance = 60, Parent = handle })
	make("Sound", { Name = "Shutter", SoundId = Config.Sounds.Shutter, Volume = 0.7, PlaybackSpeed = 1.6, RollOffMaxDistance = 40, Parent = handle })

	-- Всё приваривается к ручке
	for _, p in ipairs(tool:GetChildren()) do
		if p:IsA("BasePart") and p ~= handle then
			make("WeldConstraint", { Part0 = handle, Part1 = p, Parent = p })
		end
	end
	return tool
end

local template = buildPhoneTool()
template.Parent = ServerStorage

----------------------------------------------------------------------------------------------------
-- Состояние игроков
----------------------------------------------------------------------------------------------------
local state = {} -- [player] = { flashlight, music, lastMsg, lastCall, lastTp, turboUntil }

local function getPhone(player)
	local char = player.Character
	local tool = char and char:FindFirstChild(Config.ToolName)
	if tool and tool:IsA("Tool") then
		return tool, true
	end
	local bp = player:FindFirstChildOfClass("Backpack")
	tool = bp and bp:FindFirstChild(Config.ToolName)
	if tool and tool:IsA("Tool") then
		return tool, false
	end
	return nil, false
end

local function notify(player, kind, data)
	notifyEvent:FireClient(player, kind, data or {})
end

local function applyColor(tool, index)
	local entry = Config.Colors[index] or Config.Colors[1]
	for _, name in ipairs({ "Handle", "RightBody" }) do
		local p = tool:FindFirstChild(name)
		if p then
			p.Color = entry.Color
		end
	end
	local hinge = tool:FindFirstChild("Hinge")
	if hinge then
		hinge.Color = entry.Color:Lerp(Color3.new(0, 0, 0), 0.3)
	end
end

local function setFlashlight(player, on)
	local st = state[player]
	if not st then
		return
	end
	st.flashlight = on and true or false
	local tool = getPhone(player)
	local flash = tool and tool:FindFirstChild("Flash")
	if flash then
		flash.Material = st.flashlight and Enum.Material.Neon or Enum.Material.SmoothPlastic
		local torch = flash:FindFirstChild("Torch")
		if torch then
			torch.Enabled = st.flashlight
		end
	end
	player:SetAttribute("Flashlight", st.flashlight)
end

local function stopMusic(player)
	local st = state[player]
	if st then
		st.music = false
	end
	local tool = getPhone(player)
	local snd = tool and tool.Handle:FindFirstChild("Music")
	if snd then
		snd:Stop()
	end
	player:SetAttribute("MusicId", "")
end

local function playMusic(player, id)
	local tool = getPhone(player)
	local snd = tool and tool.Handle:FindFirstChild("Music")
	if not snd then
		return
	end
	snd:Stop()
	snd.SoundId = "rbxassetid://" .. id
	snd:Play()
	state[player].music = true
	player:SetAttribute("MusicId", id)
	task.delay(4, function()
		if snd.Parent and snd.SoundId == "rbxassetid://" .. id and not snd.IsLoaded then
			notify(player, "toast", { text = "Трек " .. id .. " не загрузился. Возможно, Roblox закрыл этот звук — попробуй другой ID." })
		end
	end)
end

local function setScreen(player, icon, name)
	local tool = getPhone(player)
	local scr = tool and tool:FindFirstChild("RightScreen")
	local bg = scr and scr:FindFirstChild("Display") and scr.Display:FindFirstChild("Bg")
	if bg then
		bg.AppIcon.Text = icon
		bg.AppName.Text = name
	end
end

local function givePhone(player)
	local tool = getPhone(player)
	if not tool then
		tool = template:Clone()
		tool.Parent = player:WaitForChild("Backpack")
	end
	applyColor(tool, player:GetAttribute("PhoneColor") or 1)
	-- после возрождения фонарик и музыка выключены
	local st = state[player]
	if st then
		st.flashlight = false
		st.music = false
	end
	player:SetAttribute("Flashlight", false)
	player:SetAttribute("MusicId", "")
end

local function onPlayerAdded(player)
	state[player] = { flashlight = false, music = false, lastMsg = 0, lastCall = 0, lastTp = 0, turboUntil = 0 }
	player:SetAttribute("Battery", Config.Battery.Start)
	player:SetAttribute("Charging", false)
	player:SetAttribute("PhoneColor", 1)
	player:SetAttribute("TurboReadyAt", 0)
	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("Humanoid")
		task.wait(0.1)
		givePhone(player)
	end)
	if player.Character then
		givePhone(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayerAdded(p)
end

Players.PlayerRemoving:Connect(function(player)
	state[player] = nil
end)

----------------------------------------------------------------------------------------------------
-- Действия приложений
----------------------------------------------------------------------------------------------------
local function hasPower(player)
	if (player:GetAttribute("Battery") or 0) <= 0 then
		notify(player, "toast", { text = "🔋 Телефон разряжен! Встань на зелёную зарядку ⚡" })
		return false
	end
	return true
end

local function spendBattery(player, amount)
	local b = player:GetAttribute("Battery") or 0
	player:SetAttribute("Battery", math.max(0, b - amount))
end

local function filterFor(text, fromId, toId)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, fromId)
	end)
	if not ok then
		return nil
	end
	local ok2, filtered = pcall(function()
		return result:GetChatForUserAsync(toId)
	end)
	if not ok2 then
		return nil
	end
	return filtered
end

local handlers = {}

function handlers.flashlight(player, on)
	if on and not hasPower(player) then
		return
	end
	setFlashlight(player, on == true)
end

function handlers.music(player, id)
	if id == nil or id == "" then
		stopMusic(player)
		return
	end
	id = tostring(id):gsub("%D", "")
	if #id < 3 or #id > 20 then
		notify(player, "toast", { text = "Это не похоже на ID звука. Нужны только цифры." })
		return
	end
	if not hasPower(player) then
		return
	end
	playMusic(player, id)
end

function handlers.photo(player)
	if not hasPower(player) then
		return
	end
	local tool = getPhone(player)
	if tool then
		tool.Handle.Shutter:Play()
		local flash = tool:FindFirstChild("Flash")
		local torch = flash and flash:FindFirstChild("Torch")
		if torch and not torch.Enabled then
			torch.Enabled = true
			task.delay(0.12, function()
				if torch.Parent and not (state[player] and state[player].flashlight) then
					torch.Enabled = false
				end
			end)
		end
	end
	spendBattery(player, 0.5)
end

function handlers.screen(player, icon, name)
	if type(icon) ~= "string" or type(name) ~= "string" then
		return
	end
	setScreen(player, icon:sub(1, 32), name:sub(1, 64))
end

function handlers.color(player, index)
	index = tonumber(index)
	if not index or not Config.Colors[index] then
		return
	end
	player:SetAttribute("PhoneColor", index)
	local tool = getPhone(player)
	if tool then
		applyColor(tool, index)
	end
end

function handlers.teleport(player, index)
	index = tonumber(index)
	local loc = index and Config.Locations[index]
	local st = state[player]
	if not loc or not st or now() - st.lastTp < 2 then
		return
	end
	if not hasPower(player) then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	st.lastTp = now()
	local _, yaw = root.CFrame:ToOrientation()
	char:PivotTo(CFrame.new(loc.Position) * CFrame.Angles(0, yaw, 0))
	spendBattery(player, 2)
	notify(player, "toast", { text = loc.Icon .. " Ты в месте «" .. loc.Name .. "»" })
end

function handlers.turbo(player)
	local st = state[player]
	if not st then
		return
	end
	if now() < (player:GetAttribute("TurboReadyAt") or 0) then
		return
	end
	if (player:GetAttribute("Battery") or 0) < Config.Turbo.Cost then
		notify(player, "toast", { text = "🔋 Для турбо нужно хотя бы " .. Config.Turbo.Cost .. "% заряда" })
		return
	end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return
	end
	spendBattery(player, Config.Turbo.Cost)
	player:SetAttribute("TurboReadyAt", now() + Config.Turbo.Cooldown)
	local token = now()
	st.turboUntil = token
	hum.WalkSpeed = Config.Turbo.Speed
	notify(player, "toast", { text = "🚀 Турбо на " .. Config.Turbo.Duration .. " секунд!" })
	task.delay(Config.Turbo.Duration, function()
		if hum.Parent and st.turboUntil == token then
			hum.WalkSpeed = 16
		end
	end)
end

function handlers.message(player, text)
	local st = state[player]
	if not st or type(text) ~= "string" then
		return
	end
	text = text:gsub("[%c]", " ")
	text = text:sub(1, Config.MessageMaxLength)
	if text:match("^%s*$") or now() - st.lastMsg < Config.MessageCooldown then
		return
	end
	if not hasPower(player) then
		return
	end
	st.lastMsg = now()
	for _, other in ipairs(Players:GetPlayers()) do
		local filtered = filterFor(text, player.UserId, other.UserId)
		if filtered then
			notify(other, "message", { from = player.DisplayName, fromId = player.UserId, text = filtered })
		end
	end
end

function handlers.call(player, targetId)
	local st = state[player]
	local target = Players:GetPlayerByUserId(tonumber(targetId) or 0)
	if not st or not target or target == player then
		return
	end
	if now() - st.lastCall < Config.CallCooldown then
		notify(player, "toast", { text = "Подожди пару секунд перед новым звонком" })
		return
	end
	if not hasPower(player) then
		return
	end
	st.lastCall = now()
	spendBattery(player, 1)
	notify(target, "call", { from = player.DisplayName, fromId = player.UserId })
	notify(player, "toast", { text = "📞 Звоним " .. target.DisplayName .. "…" })
	local tool = getPhone(target)
	if tool then
		local ring = tool.Handle.Ring
		task.spawn(function()
			for _ = 1, 4 do
				if not ring.Parent then
					break
				end
				ring:Play()
				task.wait(0.6)
			end
		end)
	end
end

function handlers.callAnswer(player, callerId, accepted)
	local caller = Players:GetPlayerByUserId(tonumber(callerId) or 0)
	if not caller then
		return
	end
	notify(caller, "callResult", { name = player.DisplayName, accepted = accepted == true })
end

actionEvent.OnServerEvent:Connect(function(player, action, ...)
	local fn = type(action) == "string" and handlers[action]
	if fn then
		local ok, err = pcall(fn, player, ...)
		if not ok then
			warn("[iPhone Duo] ошибка в действии " .. action .. ": " .. tostring(err))
		end
	end
end)

----------------------------------------------------------------------------------------------------
-- Батарея, зарядки, часы на экране и смена дня и ночи
----------------------------------------------------------------------------------------------------
local function nearCharger(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pos in ipairs(Config.Chargers) do
		local d = root.Position - pos
		if Vector3.new(d.X, 0, d.Z).Magnitude <= Config.Battery.ChargeRadius and math.abs(d.Y) < 6 then
			return true
		end
	end
	return false
end

local function clockText()
	local t = Lighting.ClockTime
	local h = math.floor(t)
	local m = math.floor((t - h) * 60)
	return string.format("%02d:%02d", h, m)
end

local STEP = 0.5
task.spawn(function()
	while true do
		task.wait(STEP)
		-- сутки: 24 игровых часа за Config.DayLengthMinutes реальных минут
		Lighting.ClockTime = (Lighting.ClockTime + 24 * STEP / (Config.DayLengthMinutes * 60)) % 24
		local clock = clockText()
		for _, player in ipairs(Players:GetPlayers()) do
			local st = state[player]
			if st then
				local tool, equipped = getPhone(player)
				local battery = player:GetAttribute("Battery") or 0
				local charging = nearCharger(player)
				if charging then
					battery = math.min(100, battery + Config.Battery.ChargeRate * STEP)
				elseif equipped then
					local drain = Config.Battery.IdleDrain
					if st.flashlight then
						drain = drain + Config.Battery.FlashlightDrain
					end
					if st.music then
						drain = drain + Config.Battery.MusicDrain
					end
					battery = math.max(0, battery - drain * STEP)
				end
				if player:GetAttribute("Charging") ~= charging then
					player:SetAttribute("Charging", charging)
				end
				local wasDead = (player:GetAttribute("Battery") or 0) <= 0
				player:SetAttribute("Battery", battery)
				if battery <= 0 and not wasDead then
					setFlashlight(player, false)
					stopMusic(player)
					notify(player, "toast", { text = "🔋 Телефон сел! Найди зелёную зарядку ⚡ (одна есть у спавна)" })
				end
				if tool then
					local disp = tool.LeftScreen:FindFirstChild("Display")
					local bg = disp and disp:FindFirstChild("Bg")
					if bg then
						bg.Clock.Text = clock
						bg.Battery.Text = (charging and "⚡" or "") .. math.floor(battery) .. "%"
						bg.Visible = battery > 0
					end
					local rdisp = tool.RightScreen:FindFirstChild("Display")
					if rdisp and rdisp:FindFirstChild("Bg") then
						rdisp.Bg.Visible = battery > 0
					end
				end
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX0000000B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000009"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000A"><Properties><string name="Name">PhoneClient</string><ProtectedString name="Source"><![CDATA[-- Интерфейс телефона iPhone Duo. Два экрана: слева — приложения, справа — открытое приложение.
-- Телефон открывается, когда достаёшь его из инвентаря (клавиша 1). Клик по миру — открыть/свернуть.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("PhoneConfig"))
local remotes = ReplicatedStorage:WaitForChild("PhoneRemotes")
local actionEvent = remotes:WaitForChild("PhoneAction")
local notifyEvent = remotes:WaitForChild("PhoneNotify")

local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(20, 20, 26)
local BLUE = Color3.fromRGB(10, 132, 255)
local GREEN = Color3.fromRGB(48, 209, 88)
local RED = Color3.fromRGB(255, 69, 58)
local ORANGE = Color3.fromRGB(255, 159, 10)
local GRAY = Color3.fromRGB(72, 72, 80)

local function make(className, props)
	local inst = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, r)
	local existing = parent:FindFirstChildOfClass("UICorner")
	if existing then
		existing.CornerRadius = UDim.new(0, r or 12)
		return existing
	end
	return make("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = parent })
end

local function label(parent, props)
	local l = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextColor3 = WHITE,
		TextSize = 16,
		TextWrapped = true,
		Parent = parent,
	})
	for k, v in pairs(props) do
		l[k] = v
	end
	return l
end

----------------------------------------------------------------------------------------------------
-- Звуки интерфейса
----------------------------------------------------------------------------------------------------
local gui = make("ScreenGui", {
	Name = "PhoneGui",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5,
	Parent = player:WaitForChild("PlayerGui"),
})

local function sound(id, vol, speed)
	return make("Sound", { SoundId = id, Volume = vol, PlaybackSpeed = speed or 1, Parent = gui })
end
local sClick = sound(Config.Sounds.Click, 0.25, 2)
local sNotify = sound(Config.Sounds.Notify, 0.5, 1.3)
local sShutter = sound(Config.Sounds.Shutter, 0.6, 1.6)
local sRing = sound(Config.Sounds.Ring, 0.6, 1.2)

local settings = { sounds = true, wallpaper = 1 }

local function play(s)
	if settings.sounds then
		s:Play()
	end
end

local function button(parent, text, size, pos, color, onClick)
	local b = make("TextButton", {
		Size = size,
		Position = pos or UDim2.new(),
		BackgroundColor3 = color or GRAY,
		Text = text,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = WHITE,
		TextWrapped = true,
		AutoButtonColor = true,
		Parent = parent,
	})
	corner(b, 12)
	b.Activated:Connect(function()
		play(sClick)
		onClick(b)
	end)
	return b
end

local function column(parent, top)
	local sf = make("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -(top or 0)),
		Position = UDim2.fromOffset(0, top or 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = WHITE,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = sf })
	make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10), Parent = sf })
	return sf
end

local function panel(parent, height, order)
	local f = make("Frame", { Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55, LayoutOrder = order or 0, Parent = parent })
	corner(f, 14)
	return f
end

----------------------------------------------------------------------------------------------------
-- Помощники
----------------------------------------------------------------------------------------------------
local function clockText()
	local t = Lighting.ClockTime
	local h = math.floor(t)
	local m = math.floor((t - h) * 60)
	return string.format("%02d:%02d", h, m)
end

local function battery()
	return player:GetAttribute("Battery") or 100
end

local function nearestPlace()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return "Неизвестно"
	end
	local best, bestD = nil, math.huge
	for _, loc in ipairs(Config.Locations) do
		local d = (root.Position - loc.Position).Magnitude
		if d < bestD then
			best, bestD = loc, d
		end
	end
	if best and bestD < 60 then
		return best.Icon .. " " .. best.Name
	end
	return "🏙️ Где-то в городе"
end

