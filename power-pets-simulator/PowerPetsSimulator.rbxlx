  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ClickController</string>
            <string name="Source"><![CDATA[--[[
	ClickController — клики и тапы.
	Сила начисляется за: большую кнопку «КЛИК!», клик мышью по миру (ПК), тап по экрану (телефон).
	Клиент сам не даёт отправить больше ~14 кликов в секунду, а сервер всё равно проверяет лимит.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Client = script.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)
local Popups = require(UI.Popups)
local Panels = require(UI.Panels)
local HatchAnimation = require(UI.HatchAnimation)

local ClickController = {}

local MIN_INTERVAL = 1 / math.max(1, GameConfig.MaxClicksPerSecond - 1)
local lastClick = 0
local lastFullWarning = 0
local hud = nil

function ClickController.Click(screenPosition)
	if not State.IsLoaded() or HatchAnimation.IsPlaying() then
		return
	end
	local now = os.clock()
	if now - lastClick < MIN_INTERVAL then
		return
	end
	lastClick = now

	local strength = State.Get("Strength", 0)
	local capacity = State.Get("Capacity", 50)
	if strength >= capacity then
		if now - lastFullWarning > 0.6 then
			lastFullWarning = now
			Popups.Show(screenPosition, "Рюкзак полон!", Kit.Colors.Red, 0.8)
			Sounds.Play("Error")
			if hud then
				hud.FlashFull()
			end
		end
		return
	end

	Remotes.Click:FireServer()
	Sounds.Play("Click", 0.92 + math.random() * 0.22)
	local power = math.min(State.Get("ClickPower", 1), capacity - strength)
	Popups.Show(screenPosition, "+" .. Format.Number(power), Kit.Colors.Yellow, 1)
	if hud then
		hud.Punch()
	end
end

function ClickController.Init(hudObject)
	hud = hudObject
	local button = hud.ClickButton

	button.Activated:Connect(function()
		local center = button.AbsolutePosition + button.AbsoluteSize / 2
		local spread = button.AbsoluteSize.X * 0.45
		local position = center + Vector2.new(math.random(-100, 100) / 100 * spread, -button.AbsoluteSize.Y * 0.62)
		ClickController.Click(position)
	end)

	-- ПК: клик мышью по миру (не по интерфейсу).
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Panels.AnyOpen() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			ClickController.Click(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	-- Телефон: короткий тап по экрану (не по кнопкам и не по джойстику).
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or Panels.AnyOpen() then
			return
		end
		local position = positions[1]
		if position then
			ClickController.Click(Vector2.new(position.X, position.Y))
		end
	end)
end

return ClickController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="44">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Power Pets Simulator — главный клиентский скрипт.
	Собирает интерфейс кодом (никаких .rbxm), подключает клики, питомцев, звук и эффекты.
	Клиент ничего не начисляет сам — только отправляет запросы серверу и показывает результат.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Client = script.Parent
local UI = Client:WaitForChild("UI")
ReplicatedStorage:WaitForChild("Shared")

local Sounds = require(Client:WaitForChild("Sounds"))
local State = require(Client:WaitForChild("State"))
local Kit = require(UI:WaitForChild("Kit"))
local Icons = require(UI:WaitForChild("Icons")) -- подключает 3D-иконки к кнопкам Kit
local Panels = require(UI:WaitForChild("Panels"))
local Hud = require(UI:WaitForChild("Hud"))
local Notifications = require(UI:WaitForChild("Notifications"))
local Popups = require(UI:WaitForChild("Popups"))
local PetsPanel = require(UI:WaitForChild("PetsPanel"))
local ShopPanel = require(UI:WaitForChild("ShopPanel"))
local RebirthPanel = require(UI:WaitForChild("RebirthPanel"))
local WorldsPanel = require(UI:WaitForChild("WorldsPanel"))
local HatchAnimation = require(UI:WaitForChild("HatchAnimation"))
local CustomPrompts = require(UI:WaitForChild("CustomPrompts"))
local EggDisplays = require(UI:WaitForChild("EggDisplays"))
local ClickController = require(Client:WaitForChild("ClickController"))
local PetFollow = require(Client:WaitForChild("PetFollow"))
local WorldEffects = require(Client:WaitForChild("WorldEffects"))
local ServerEvents = require(Client:WaitForChild("ServerEvents"))

-- ScreenGui лежат в StarterGui (src/gui). Если их нет — создаём сами.
local function getScreenGui(name, displayOrder, ignoreInset)
	local playerGui = player:WaitForChild("PlayerGui")
	local gui = playerGui:WaitForChild(name, 10)
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = name
		gui.ResetOnSpawn = false
		gui.ScreenInsets = ignoreInset and Enum.ScreenInsets.None or Enum.ScreenInsets.CoreUISafeInsets
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.DisplayOrder = displayOrder
		gui.Parent = playerGui
	end
	return gui
end

-- Стандартная панель предметов Roblox не нужна: у нас нет инструментов.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

assert(Icons, "Icons не загрузились")
State.Init()
Sounds.Init()

local mainGui = getScreenGui("PowerPetsGui", 5, false)
local hatchGui = getScreenGui("HatchGui", 20, true)

local root = Kit.CreateScaledRoot(mainGui, "Root")
Popups.Init(mainGui)
Panels.Init(root)
local hud = Hud.Create(root)
Notifications.Init(root)

PetsPanel.Create()
ShopPanel.Create()
RebirthPanel.Create()
WorldsPanel.Create()

HatchAnimation.Init(hatchGui)
CustomPrompts.Init()
EggDisplays.Init()
ClickController.Init(hud)
PetFollow.Init()
WorldEffects.Init(root)
ServerEvents.Init()

-- Предупреждение, если прогресс не сохраняется (Studio без доступа к API).
local saveWarningShown = false
State.Watch("SaveDisabled", function()
	if State.Get("SaveDisabled", false) == true and not saveWarningShown then
		saveWarningShown = true
		Notifications.Show("Сохранение выключено: включи Studio Access to API Services", "warning")
	end
end)

-- Подсказка новичку.
State.Watch("DataLoaded", function()
	if State.IsLoaded() and State.Get("TotalStrength", 0) == 0 and State.Get("Rebirths", 0) == 0 then
		task.delay(2.5, function()
			Notifications.Show("Жми КЛИК, продавай силу в зелёном круге и открывай яйца!", "info")
		end)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source"><![CDATA[--[[
	PetFollow — питомцы летают за игроками.
	Сервер пишет надетых питомцев в атрибут игрока EquippedPets ("Kitten:0,Fox:1" — 1 = золотой),
	а каждый клиент сам рисует питомцев всех игроков. Так движение плавное и не грузит сервер.
	Все детали двигаются одним вызовом workspace:BulkMoveTo за кадр.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Config.Pets)
local PetBuilder = require(Shared.Modules.PetBuilder)

local PetFollow = {}

local DRAW_DISTANCE = 300
local folder = nil
local entries = {} -- [player] = { Key = "...", Pets = { { Model, Parts, Offsets, CFrame } } }

local function parse(text)
	local list = {}
	for item in string.gmatch(text or "", "[^,]+") do
		local petId, golden = string.match(item, "^([^:]+):?(%d?)$")
		if petId and Pets[petId] then
			table.insert(list, { Id = petId, Golden = golden == "1" })
		end
	end
	return list
end

local function clear(entry)
	for _, pet in ipairs(entry.Pets or {}) do
		pet.Model:Destroy()
	end
	entry.Pets = {}
end

local function rebuild(player)
	local entry = entries[player]
	if not entry then
		return
	end
	local key = player:GetAttribute("EquippedPets") or ""
	if entry.Key == key then
		return
	end
	-- Старые позиции сохраняем, чтобы новые питомцы не «прыгали» из центра мира.
	local previous = {}
	for index, pet in ipairs(entry.Pets or {}) do
		previous[index] = pet.CFrame
	end
	clear(entry)
	entry.Key = key
	for index, item in ipairs(parse(key)) do
		local model = PetBuilder.Build(item.Id, item.Golden)
		if model then
			local parts, offsets = PetBuilder.GetParts(model)
			table.insert(entry.Pets, {
				Model = model,
				Parts = parts,
				Offsets = offsets,
				CFrame = previous[index],
			})
		end
	end
end

local function track(player)
	if entries[player] then
		return
	end
	entries[player] = { Key = nil, Pets = {} }
	rebuild(player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function untrack(player)
	local entry = entries[player]
	if entry then
		clear(entry)
		entries[player] = nil
	end
end

local partBuffer = {}
local cframeBuffer = {}

local function step(deltaTime)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local t = os.clock()
	local alpha = 1 - math.exp(-9 * deltaTime)
	local count = 0

	for player, entry in pairs(entries) do
		local petCount = #entry.Pets
		if petCount > 0 then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local visible = root ~= nil and (root.Position - cameraPosition).Magnitude < DRAW_DISTANCE
			if visible then
				local look = root.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude < 0.01 then
					flat = Vector3.new(0, 0, -1)
				end
				local base = CFrame.lookAt(root.Position, root.Position + flat.Unit)
				local moving = root.AssemblyLinearVelocity.Magnitude > 2

				for index, pet in ipairs(entry.Pets) do
					if pet.Model.Parent ~= folder then
						pet.Model.Parent = folder
					end
					-- Дуга позади игрока: +Z в системе base — это «сзади».
					local offsetX = (index - (petCount + 1) / 2) * 3.6
					local offsetZ = 5 + math.abs(offsetX) * 0.35
					local bob = math.sin(t * 3 + index * 1.7) * 0.35
					if moving then
						bob += math.abs(math.sin(t * 9 + index)) * 0.7
					end
					local target = base * CFrame.new(offsetX, -0.6 + bob, offsetZ)
					if pet.CFrame then
						pet.CFrame = pet.CFrame:Lerp(target, alpha)
					else
						pet.CFrame = target
					end
					for partIndex, part in ipairs(pet.Parts) do
						count += 1
						partBuffer[count] = part
						cframeBuffer[count] = pet.CFrame * pet.Offsets[partIndex]
					end
				end
			else
				for _, pet in ipairs(entry.Pets) do
					if pet.Model.Parent then
						pet.Model.Parent = nil
					end
					pet.CFrame = nil
				end
			end
		end
	end

	-- Обрезаем буферы до текущего размера.
	for index = count + 1, #partBuffer do
		partBuffer[index] = nil
		cframeBuffer[index] = nil
	end
	if count > 0 then
		Workspace:BulkMoveTo(partBuffer, cframeBuffer, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function PetFollow.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace

	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	RunService.RenderStepped:Connect(step)
end

return PetFollow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ServerEvents</string>
            <string name="Source"><![CDATA[--[[
	ServerEvents — реакции на сообщения сервера: уведомления, эффекты (монеты, продажа,
	перерождение, золотой питомец…) и запуск анимации яйца.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Client = script.Parent
local Sounds = require(Client.Sounds)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)
local Popups = require(UI.Popups)
local Notifications = require(UI.Notifications)
local HatchAnimation = require(UI.HatchAnimation)
local PetsPanel = require(UI.PetsPanel)

local ServerEvents = {}

local EFFECTS = {}

function EFFECTS.Coin(payload)
	Sounds.Play("Coin", 0.9 + math.random() * 0.3)
	local text = "+" .. Format.Number(payload.Amount or 0)
	local camera = Workspace.CurrentCamera
	if camera and typeof(payload.Position) == "Vector3" then
		local screen, onScreen = camera:WorldToScreenPoint(payload.Position)
		if onScreen then
			Popups.Show(Vector2.new(screen.X, screen.Y), text, Kit.Colors.Yellow, 1.1, true)
			return
		end
	end
	Popups.Center(text, Kit.Colors.Yellow, 1.2, true)
end

function EFFECTS.Sell(payload)
	Sounds.Play("Sell")
	task.delay(0.12, Sounds.Play, "Coin", 1.2)
	Popups.Center("+" .. Format.Number(payload.Amount or 0), Kit.Colors.Yellow, 2, true)
end

function EFFECTS.Unlock(payload)
	local world = Worlds[payload.World]
	Sounds.Play("Unlock")
	if world then
		Notifications.Show("Открыт новый мир: " .. world.Name .. "!", "success")
	end
end

function EFFECTS.Teleport()
	Sounds.Play("Teleport")
end

function EFFECTS.Rebirth(payload)
	Sounds.Play("Rebirth")
	Popups.Center("ПЕРЕРОЖДЕНИЕ #" .. tostring(payload.Rebirths or ""), Kit.Colors.Purple, 2.2)
end

function EFFECTS.Merge(payload)
	Sounds.Play("Merge")
	Popups.Center("ЗОЛОТОЙ ПИТОМЕЦ!", Kit.Colors.Gold, 1.9)
	if payload.Uid then
		PetsPanel.Select(payload.Uid)
	end
end

function EFFECTS.Purchase()
	Sounds.Play("Purchase")
end

function ServerEvents.Init()
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			Notifications.Show(text, kind)
		end
	end)

	Remotes.Effect.OnClientEvent:Connect(function(kind, payload)
		local handler = EFFECTS[kind]
		if handler then
			handler(type(payload) == "table" and payload or {})
		end
	end)

	Remotes.EggHatched.OnClientEvent:Connect(function(eggId, results)
		HatchAnimation.Play(eggId, results)
	end)
end

return ServerEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Sounds — звуки интерфейса и музыка миров. Настройки — в Shared/Config/Sounds.
	- Сразу работают встроенные звуки (Fallback).
	- Когда сервер найдёт звуки в библиотеке Roblox (ReplicatedStorage.SoundLibrary), клиент проверяет
	  каждый кандидат через ContentProvider:PreloadAsync и подменяет звук первым, который загрузился.
	- Музыка играет по кругу и плавно сменяется при переходе в другой мир.
	Каждый эффект клонируется, поэтому быстрые клики не обрывают друг друга.
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local SoundConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))

local Sounds = {}

local folder = Instance.new("Folder")
folder.Name = "PowerPetsSounds"
folder.Parent = SoundService

local templates = {}
for name, config in pairs(SoundConfig.Effects) do
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = (config.Id and config.Id ~= "") and config.Id or config.Fallback
	sound.Volume = config.Volume or 0.5
	sound.PlaybackSpeed = config.Pitch or 1
	sound.Parent = folder
	templates[name] = sound
end

local lastPlayed = {}

-- pitch — дополнительный множитель высоты (для разнообразия кликов).
function Sounds.Play(name, pitch)
	local template = templates[name]
	if not template or template.SoundId == "" then
		return
	end
	-- Не больше ~25 одинаковых звуков в секунду.
	local now = os.clock()
	if lastPlayed[name] and now - lastPlayed[name] < 0.04 then
		return
	end
	lastPlayed[name] = now

	local sound = template:Clone()
	sound.PlaybackSpeed = template.PlaybackSpeed * (pitch or 1)
	sound.Parent = folder
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	Debris:AddItem(sound, 8)
end

------------------------------------------------------------------ МУЗЫКА
local musicEnabled = true
local musicTracks = {} -- [worldId] = Sound
local currentWorld = nil
local currentTrack = nil

local function fadeTo(sound, volume, duration)
	TweenService:Create(sound, TweenInfo.new(duration or 1.5, Enum.EasingStyle.Sine), { Volume = volume }):Play()
end

local function updateMusic()
	local track = currentWorld and musicTracks[currentWorld] or nil
	if currentTrack and currentTrack ~= track then
		local old = currentTrack
		fadeTo(old, 0, 1.2)
		task.delay(1.3, function()
			if currentTrack ~= old then
				old:Stop()
			end
		end)
	end
	currentTrack = track
	if track then
		if not track.IsPlaying then
			track.Volume = 0
			track:Play()
		end
		fadeTo(track, musicEnabled and (track:GetAttribute("TargetVolume") or 0.3) or 0, 1.5)
	end
end

function Sounds.SetWorld(worldId)
	if worldId ~= currentWorld then
		currentWorld = worldId
		updateMusic()
	end
end

function Sounds.IsMusicEnabled()
	return musicEnabled
end

function Sounds.ToggleMusic()
	musicEnabled = not musicEnabled
	if currentTrack then
		fadeTo(currentTrack, musicEnabled and (currentTrack:GetAttribute("TargetVolume") or 0.3) or 0, 0.5)
	end
	return musicEnabled
end

------------------------------------------------------------------ ПОДБОР ЗВУКОВ ИЗ БИБЛИОТЕКИ
-- Первый кандидат, который реально загрузился (у Creator Store бывают недоступные звуки).
local function firstWorking(candidates)
	for _, id in ipairs(candidates) do
		local probe = Instance.new("Sound")
		probe.SoundId = id
		local status = nil
		local ok = pcall(function()
			ContentProvider:PreloadAsync({ probe }, function(_, fetchStatus)
				status = fetchStatus
			end)
		end)
		probe:Destroy()
		if ok and status == Enum.AssetFetchStatus.Success then
			return id
		end
	end
	return nil
end

local function resolveEntry(value)
	local isMusic = value:GetAttribute("IsMusic") == true
	local started = os.clock()
	while not value:GetAttribute("Ready") and os.clock() - started < 40 do
		task.wait(0.5)
	end
	local candidates = {}
	if value.Value ~= "" then
		table.insert(candidates, value.Value)
	end
	for id in string.gmatch(value:GetAttribute("Candidates") or "", "[^,]+") do
		table.insert(candidates, id)
	end
	local id = firstWorking(candidates)

	if isMusic then
		local worldId = string.gsub(value.Name, "^Music_", "")
		local config = SoundConfig.Music[worldId]
		if not id or not config then
			return
		end
		local track = Instance.new("Sound")
		track.Name = value.Name
		track.SoundId = id
		track.Looped = true
		track.Volume = 0
		track:SetAttribute("TargetVolume", config.Volume or 0.3)
		track.Parent = folder
		musicTracks[worldId] = track
		if currentWorld == worldId then
			updateMusic()
		end
	elseif id and templates[value.Name] then
		templates[value.Name].SoundId = id
	end
end

function Sounds.Init()
	task.spawn(function()
		local library = ReplicatedStorage:WaitForChild("SoundLibrary", 30)
		if not library then
			return
		end
		for _, value in ipairs(library:GetChildren()) do
			if value:IsA("StringValue") then
				task.spawn(resolveEntry, value)
			end
		end
	end)
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	State — то, что клиент знает о своём игроке.
	Числа (сила, монеты, множители…) сервер кладёт в атрибуты игрока — они приходят сами.
	Список питомцев приходит через RemoteEvent InventoryChanged.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("Remotes"))

local State = {}

local player = Players.LocalPlayer
State.Player = player
State.Inventory = {}

local inventoryListeners = {}

local function fireInventory()
	for _, callback in ipairs(inventoryListeners) do
		task.spawn(callback, State.Inventory)
	end
end

function State.Get(name, default)
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

-- Вызывает callback сразу и при каждом изменении любого из атрибутов.
function State.Watch(names, callback)
	if type(names) == "string" then
		names = { names }
	end
	for _, name in ipairs(names) do
		player:GetAttributeChangedSignal(name):Connect(callback)
	end
	task.spawn(callback)
end

function State.OnInventory(callback)
	table.insert(inventoryListeners, callback)
	task.spawn(callback, State.Inventory)
end

function State.IsLoaded()
	return player:GetAttribute("DataLoaded") == true
end

-- Открытые миры: { Forest = true, … }
function State.UnlockedWorlds()
	local result = {}
	local text = State.Get("UnlockedWorlds", "Forest")
	for worldId in string.gmatch(text, "[^,]+") do
		result[worldId] = true
	end
	return result
end

function State.EquippedCount()
	local count = 0
	for _, pet in ipairs(State.Inventory) do
		if pet.Equipped then
			count += 1
		end
	end
	return count
end

function State.FindPet(uid)
	for _, pet in ipairs(State.Inventory) do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end

-- Безопасный вызов RemoteFunction: никогда не кидает ошибку, возвращает ok, сообщение.
function State.Invoke(remote, ...)
	local args = table.pack(...)
	local ok, result, message = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, "Нет связи с сервером"
	end
	return result, message
end

function State.Init()
	Remotes.InventoryChanged.OnClientEvent:Connect(function(list)
		if type(list) == "table" then
			State.Inventory = list
			fireInventory()
		end
	end)
	task.spawn(function()
		local ok, list = pcall(function()
			return Remotes.GetInventory:InvokeServer()
		end)
		if ok and type(list) == "table" and #State.Inventory == 0 then
			State.Inventory = list
			fireInventory()
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="49">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">CustomPrompts</string>
              <string name="Source"><![CDATA[--[[
	CustomPrompts — свой красивый вид кнопок ProximityPrompt (яйца, магазин).
	Сервер ставит подсказке Style = Custom и атрибуты:
		Price (число)  — цена в монетах (покажется с монеткой)
		Icon (строка)  — имя 3D-иконки из IconModels
		Color (Color3) — цвет карточки
		OpensPanel (строка) — открыть окно интерфейса (например, "Shop" у лавки магазина)
	На телефоне карточку можно просто нажать, на ПК — клавиша (E / R), на геймпаде — кнопка.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)

local CustomPrompts = {}

local shown = {} -- [prompt] = BillboardGui

local function keyText(prompt, inputType)
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "ТАП"
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		return (string.gsub(prompt.GamepadKeyCode.Name, "Button", ""))
	end
	return prompt.KeyboardKeyCode.Name
end

local function hide(prompt)
	local gui = shown[prompt]
	if not gui then
		return
	end
	shown[prompt] = nil
	local scale = gui:FindFirstChild("Card") and gui.Card:FindFirstChildOfClass("UIScale")
	if scale then
		local tween = Kit.Tween(scale, 0.12, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween.Completed:Once(function()
			gui:Destroy()
		end)
	else
		gui:Destroy()
	end
end

local function show(prompt, inputType, playerGui)
	hide(prompt)
	local color = prompt:GetAttribute("Color") or Kit.Colors.Green
	local price = prompt:GetAttribute("Price")
	local iconName = prompt:GetAttribute("Icon")

	local gui = Kit.new("BillboardGui", {
		Name = "Prompt_" .. prompt.Name,
		Adornee = prompt.Parent,
		AlwaysOnTop = true,
		Active = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	-- Карточка 250×100 «дизайн-пикселей» масштабируется под экран (UIScale от центра),
	-- а сам BillboardGui берём с запасом, чтобы карточка и её «прыжок» при нажатии не обрезались.
	local targetScale = math.clamp(Kit.Scale * 1.05, 0.65, 1.2)
	gui.Size = UDim2.fromOffset(math.ceil(250 * targetScale * 1.2) + 8, math.ceil(100 * targetScale * 1.2) + 8)
	local card = Kit.new("TextButton", {
		Name = "Card",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(250, 100),
		Parent = gui,
	})
	Kit.Corner(card, UDim.new(0, 22))
	Kit.Stroke(card, 4)
	Kit.Gradient(card, Kit.Lighten(color, 0.3), Kit.Darken(color, 0.2))
	local scale = Kit.new("UIScale", { Scale = 0, Parent = card })
	Kit.Tween(scale, 0.25, { Scale = targetScale }, Enum.EasingStyle.Back)

	-- Кружок с клавишей.
	local key = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = Kit.Colors.Ink,
		Parent = card,
	})
	Kit.Corner(key, UDim.new(0.5, 0))
	Kit.Stroke(key, 3, Color3.new(1, 1, 1))
	Kit.Text({ Text = keyText(prompt, inputType), Size = UDim2.fromScale(0.8, 0.6), Position = UDim2.fromScale(0.1, 0.2), MaxTextSize = 28, Parent = key })

	local textX = 76
	if iconName then
		Icons.Create(card, iconName, { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(1, -66, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 3 })
	end
	Kit.Text({
		Text = prompt.ActionText,
		Size = UDim2.new(1, -textX - 70, 0, 40),
		Position = UDim2.fromOffset(textX, 10),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 32,
		StrokeThickness = 3,
		Parent = card,
	})
	if price then
		Icons.Coin2D(card, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(textX, 56), ZIndex = 2 })
		Kit.Text({
			Text = Format.Number(price),
			Color = Kit.Colors.Yellow,
			Size = UDim2.new(1, -textX - 110, 0, 30),
			Position = UDim2.fromOffset(textX + 34, 55),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 26,
			StrokeThickness = 3,
			Parent = card,
		})
	else
		Kit.Text({
			Text = prompt.ObjectText,
			Size = UDim2.new(1, -textX - 70, 0, 28),
			Position = UDim2.fromOffset(textX, 56),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 22,
			Parent = card,
		})
	end

	-- Нажатие по карточке (телефон и мышь).
	card.Activated:Connect(function()
		scale.Scale = targetScale * 1.15
		Kit.Tween(scale, 0.25, { Scale = targetScale }, Enum.EasingStyle.Back)
		prompt:InputHoldBegin()
		task.wait()
		prompt:InputHoldEnd()
	end)

	shown[prompt] = gui
end

function CustomPrompts.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			show(prompt, inputType, playerGui)
		end
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		hide(prompt)
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		-- Лавка магазина в мире открывает окно магазина.
		local panelName = prompt:GetAttribute("OpensPanel")
		if type(panelName) == "string" then
			Panels.Open(panelName)
		end
		local gui = shown[prompt]
		local scale = gui and gui:FindFirstChild("Card") and gui.Card:FindFirstChildOfClass("UIScale")
		if scale then
			local target = math.clamp(Kit.Scale * 1.05, 0.65, 1.2)
			scale.Scale = target * 1.15
			Kit.Tween(scale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
		end
	end)
end

return CustomPrompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">EggDisplays</string>
              <string name="Source"><![CDATA[--[[
	EggDisplays — табло над яйцами: название, цена и все питомцы яйца в 3D
	с шансом и множителем, подсвеченные цветом редкости. Строится только на клиенте.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared.Config.Eggs)
local Pets = require(Shared.Config.Pets)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local EggDisplays = {}

local displays = {} -- [eggPart] = BillboardGui

local function build(eggPart, playerGui)
	local eggId = eggPart:GetAttribute("EggId")
	local egg = eggId and Eggs[eggId]
	if not egg or displays[eggPart] then
		return
	end

	local gui = Kit.new("BillboardGui", {
		Name = "EggDisplay_" .. eggId,
		Adornee = eggPart,
		Size = UDim2.new(15, 0, 10, 0),
		StudsOffsetWorldSpace = Vector3.new(0, 10.5, 0),
		MaxDistance = 75,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	local board = Kit.new("Frame", {
		Name = "Board",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	Kit.Corner(board, UDim.new(0.07, 0))
	Kit.new("UIStroke", { Color = Kit.Colors.Ink, Thickness = 4, Parent = board })
	Kit.Gradient(board, Color3.fromRGB(60, 45, 105), Color3.fromRGB(30, 22, 58))

	-- Шапка с названием и ценой.
	local title = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(0.94, 0, 0.2, 0),
		Position = UDim2.fromScale(0.03, 0.04),
		Parent = board,
	})
	Kit.Corner(title, UDim.new(0.3, 0))
	Kit.Gradient(title, Kit.Lighten(egg.Color, 0.2), Kit.Darken(egg.Color, 0.2))
	Kit.Text({
		Text = egg.Name,
		Size = UDim2.new(0.57, 0, 0.8, 0),
		Position = UDim2.fromScale(0.03, 0.1),
		XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		Parent = title,
	})
	-- Цена — отдельной тёмной плашкой справа: монета и число не налезают друг на друга.
	local priceChip = Kit.new("Frame", {
		Name = "Price",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(0.985, 0.5),
		Size = UDim2.fromScale(0.37, 0.78),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.25,
		Parent = title,
	})
	Kit.Corner(priceChip, UDim.new(0.5, 0))
	Icons.Coin2D(priceChip, {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromScale(0.3, 0.86),
		Position = UDim2.fromScale(0.03, 0.5),
		ZIndex = 2,
	})
	Kit.Text({
		Text = Format.Number(egg.Price),
		Color = Kit.Colors.Yellow,
		Size = UDim2.fromScale(0.6, 0.8),
		Position = UDim2.fromScale(0.34, 0.1),
		StrokeThickness = 3,
		Parent = priceChip,
	})

	-- Питомцы.
	local row = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.96, 0, 0.7, 0),
		Position = UDim2.fromScale(0.02, 0.27),
		Parent = board,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0.012, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	local chances = Formulas.EggChances(eggId)
	local list = Formulas.EggPetsSorted(eggId)
	local width = (1 - 0.012 * (#list - 1)) / #list
	for index, petId in ipairs(list) do
		local pet = Pets[petId]
		local rarity = Rarities[pet.Rarity]
		local cell = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.new(width, 0, 1, 0),
			LayoutOrder = index,
			Parent = row,
		})
		Kit.Corner(cell, UDim.new(0.12, 0))
		Kit.new("UIStroke", { Color = Kit.Colors.Ink, Thickness = 3, Parent = cell })
		Kit.Gradient(cell, Kit.Lighten(rarity.Color, 0.45), Kit.Darken(rarity.Color, 0.15))
		Icons.Pet(cell, petId, false, {
			Size = UDim2.fromScale(0.92, 0.58),
			Position = UDim2.fromScale(0.04, 0.03),
			ZIndex = 2,
			Outline = 0.1,
			Zoom = 0.86,
		})
		Kit.Text({
			Text = Format.Percent(chances[petId]),
			Size = UDim2.fromScale(0.9, 0.2),
			Position = UDim2.fromScale(0.05, 0.6),
			StrokeThickness = 2.5,
			ZIndex = 3,
			Parent = cell,
		})
		Kit.Text({
			Text = Format.Multiplier(pet.Multiplier),
			Color = Kit.Colors.Yellow,
			Size = UDim2.fromScale(0.9, 0.17),
			Position = UDim2.fromScale(0.05, 0.8),
			StrokeThickness = 2,
			ZIndex = 3,
			Parent = cell,
		})
	end

	displays[eggPart] = gui
end

function EggDisplays.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	for _, eggPart in ipairs(CollectionService:GetTagged("EggStand")) do
		build(eggPart, playerGui)
	end
	CollectionService:GetInstanceAddedSignal("EggStand"):Connect(function(eggPart)
		build(eggPart, playerGui)
	end)
	CollectionService:GetInstanceRemovedSignal("EggStand"):Connect(function(eggPart)
		local gui = displays[eggPart]
		if gui then
			gui:Destroy()
			displays[eggPart] = nil
		end
	end)
end

return EggDisplays
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">HatchAnimation</string>
              <string name="Source"><![CDATA[--[[
	HatchAnimation — открытие яйца по центру экрана:
	3D-яйцо выпрыгивает → трясётся всё сильнее → трескается (скорлупа разлетается) → вспышка →
	лучи цвета редкости и 3D-питомец. Для редких — конфетти.
	Нажатие на экран ускоряет анимацию. Если яйца открываются быстрее, они встают в очередь.
]]

local Debris = game:GetService("Debris")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared.Config.Eggs)
local Pets = require(Shared.Config.Pets)
local Rarities = require(Shared.Config.Rarities)
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Sounds = require(UI.Parent.Sounds)

local HatchAnimation = {}

local gui = nil
local root = nil
local queue = {}
local playing = false

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(100, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 110, 255)),
})

function HatchAnimation.Init(hatchGui)
	gui = hatchGui
	root = Kit.CreateScaledRoot(hatchGui, "Root")
	root.ZIndex = 5
end

-- Осколки скорлупы разлетаются из центра слота.
local function burstShell(slotFrame, egg)
	for i = 1, 12 do
		local size = math.random(16, 30)
		local shard = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.42),
			Size = UDim2.fromOffset(size, size * 0.8),
			BackgroundColor3 = (i % 3 == 0) and egg.SpotColor or egg.Color,
			Rotation = math.random(0, 360),
			ZIndex = 9,
			Parent = slotFrame,
		})
		Kit.Corner(shard, UDim.new(0, 4))
		Kit.Stroke(shard, 2.5)
		local angle = (i / 12) * math.pi * 2 + math.random() * 0.4
		local distance = math.random(130, 210)
		Kit.Tween(shard, 0.7, {
			Position = UDim2.new(0.5, math.cos(angle) * distance, 0.42, math.sin(angle) * distance + 60),
			Rotation = shard.Rotation + math.random(-260, 260),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local stroke = shard:FindFirstChildOfClass("UIStroke")
		if stroke then
			Kit.Tween(stroke, 0.7, { Transparency = 1 })
		end
		Debris:AddItem(shard, 0.8)
	end
end

-- Конфетти для легендарных и мифических.
local function confetti()
	local size = root.AbsoluteSize / math.max(Kit.Scale, 0.01)
	local colors = { Kit.Colors.Yellow, Kit.Colors.Pink, Kit.Colors.Blue, Kit.Colors.Green, Kit.Colors.Purple, Kit.Colors.Orange }
	for _ = 1, 60 do
		local piece = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(math.random(0, math.floor(size.X)), -20),
			Size = UDim2.fromOffset(math.random(10, 18), math.random(6, 10)),
			BackgroundColor3 = colors[math.random(1, #colors)],
			Rotation = math.random(0, 360),
			ZIndex = 30,
			Parent = root,
		})
		local fall = math.random(18, 30) / 10
		Kit.Tween(piece, fall, {
			Position = UDim2.fromOffset(piece.Position.X.Offset + math.random(-120, 120), size.Y + 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		Debris:AddItem(piece, fall + 0.1)
	end
end

local function reveal(slot)
	local result = slot.Result
	local config = Pets[result.Id]
	local rarity = Rarities[config.Rarity]

	-- Лучи.
	local rays = Kit.new("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = slot.Frame,
	})
	slot.Rays = {}
	for index = 1, 12 do
		local ray = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(40, 480),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.3,
			Rotation = index * 15,
			ZIndex = 2,
			Parent = rays,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.05),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
		table.insert(slot.Rays, ray)
	end

	local glow = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(210, 210),
		BackgroundColor3 = rarity.Color,
		BackgroundTransparency = 0.35,
		ZIndex = 3,
		Parent = slot.Frame,
	})
	Kit.Corner(glow, UDim.new(0.5, 0))
	Kit.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.9) }),
		Rotation = 90,
		Parent = glow,
	})

	local petFrame, view = Icons.Pet(slot.Frame, result.Id, false, {
		Size = UDim2.fromOffset(250, 250),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		Animate = "Swing",
	})
	slot.View = view
	local viewScale = Kit.new("UIScale", { Scale = 0.2, Parent = petFrame })
	Kit.Tween(viewScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

	local nameLabel = Kit.Text({
		Text = config.Name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.77),
		Size = UDim2.fromOffset(320, 42),
		MaxTextSize = 38,
		StrokeThickness = 4,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	local rarityPill = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.87),
		Size = UDim2.fromOffset(220, 34),
		BackgroundColor3 = rarity.Color,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	Kit.Corner(rarityPill, UDim.new(0.5, 0))
	Kit.Stroke(rarityPill, 3)
	Kit.Text({
		Text = Format.Upper(rarity.Name),
		Size = UDim2.new(1, -10, 1, -6),
		Position = UDim2.fromOffset(5, 3),
		MaxTextSize = 24,
		StrokeThickness = 2.5,
		ZIndex = 7,
		Parent = rarityPill,
	})
	if config.Rarity == "Mythic" then
		rarityPill.BackgroundColor3 = Color3.new(1, 1, 1)
		slot.Rainbow = Kit.new("UIGradient", { Color = RAINBOW, Parent = rarityPill })
	end
	Kit.Text({
		Text = Format.Multiplier(config.Multiplier) .. " к силе",
		Color = Kit.Colors.Yellow,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.96),
		Size = UDim2.fromOffset(300, 30),
		MaxTextSize = 28,
		StrokeThickness = 3,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	Kit.Pop(nameLabel, 1.4)
	Kit.Pop(rarityPill, 1.6)
	return rarity.Order
end

local function play(eggId, results)
	local egg = Eggs[eggId]
	if not egg or type(results) ~= "table" or #results == 0 then
		return
	end
	ProximityPromptService.Enabled = false

	local skip = false
	local dim = Kit.new("Frame", {
		Name = "Dim",
		BackgroundColor3 = Color3.fromRGB(15, 8, 35),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = gui,
	})
	Kit.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 0.15) }),
		Rotation = 90,
		Parent = dim,
	})
	local skipButton = Kit.new("TextButton", {
		Name = "Skip",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = gui,
	})
	skipButton.Activated:Connect(function()
		skip = true
	end)
	Kit.Tween(dim, 0.25, { BackgroundTransparency = 0.2 })

	local count = #results
	local spacing = math.min(280, (root.AbsoluteSize.X / math.max(Kit.Scale, 0.01) - 40) / count)
	local slots = {}
	for index, result in ipairs(results) do
		local frame = Kit.new("Frame", {
			Name = "Slot" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (index - (count + 1) / 2) * spacing, 0.5, 0),
			Size = UDim2.fromOffset(270, 420),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = root,
		})
		local slotScale = Kit.new("UIScale", { Scale = count > 2 and 0.9 or 1, Parent = frame })
		local eggFrame, eggView = Icons.Create(frame, "Egg", {
			Size = UDim2.fromOffset(220, 250),
			Position = UDim2.fromScale(0.5, 0.42),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Color = egg.Color,
			Color2 = egg.SpotColor,
			ZIndex = 5,
			Outline = 0.12,
		})
		local eggScale = Kit.new("UIScale", { Scale = 0, Parent = eggFrame })
		slots[index] = { Frame = frame, Scale = slotScale, Egg = eggFrame, EggView = eggView, EggScale = eggScale, Result = result }
		Kit.Tween(eggScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	task.wait(0.45)

	-- Тряска.
	local shakeTime = 1.7
	local started = os.clock()
	local nextTick = 0
	while not skip do
		local elapsed = os.clock() - started
		if elapsed >= shakeTime then
			break
		end
		local progress = elapsed / shakeTime
		local angle = math.sin(elapsed * (12 + progress * 34)) * (0.08 + progress * 0.3)
		local hop = math.abs(math.sin(elapsed * 9)) * progress * 0.25
		for _, slot in ipairs(slots) do
			slot.EggView:SetTransform(CFrame.new(0, hop, 0) * CFrame.Angles(0, progress * 0.6, angle))
			slot.EggScale.Scale = 1 + progress * 0.15
		end
		if elapsed >= nextTick then
			Sounds.Play("EggShake", 1 + progress * 0.6)
			nextTick = elapsed + 0.36 - progress * 0.22
		end
		RunService.RenderStepped:Wait()
	end

	-- Трещина, осколки и вспышка.
	Sounds.Play("Hatch")
	for _, slot in ipairs(slots) do
		burstShell(slot.Frame, egg)
		slot.EggView:Destroy()
	end
	local flash = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Parent = gui,
	})
	Kit.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)

	local best = 0
	for _, slot in ipairs(slots) do
		best = math.max(best, reveal(slot))
	end
	if best >= Rarities.Legendary.Order then
		Sounds.Play("Rare")
		confetti()
	elseif best >= Rarities.Epic.Order then
		Sounds.Play("Rare", 1.2)
	else
		Sounds.Play("Reveal")
	end

	-- Показываем результат (нажатие закрывает раньше).
	skip = false
	local shown = os.clock()
	local showTime = best >= Rarities.Legendary.Order and 3.4 or 2.6
	while true do
		local elapsed = os.clock() - shown
		if elapsed >= showTime or (skip and elapsed > 0.5) then
			break
		end
		skip = skip and elapsed > 0.5
		for _, slot in ipairs(slots) do
			for index, ray in ipairs(slot.Rays or {}) do
				ray.Rotation = index * 15 + elapsed * 22
			end
			if slot.Rainbow then
				slot.Rainbow.Offset = Vector2.new(math.sin(elapsed * 3) * 0.5, 0)
			end
		end
		RunService.RenderStepped:Wait()
	end

	-- Исчезновение.
	Kit.Tween(dim, 0.25, { BackgroundTransparency = 1 })
	for _, slot in ipairs(slots) do
		Kit.Tween(slot.Scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	end
	task.wait(0.27)
	for _, slot in ipairs(slots) do
		if slot.View then
			slot.View:Destroy()
		end
		slot.Frame:Destroy()
	end
	dim:Destroy()
	skipButton:Destroy()
	ProximityPromptService.Enabled = true
end

function HatchAnimation.Play(eggId, results)
	table.insert(queue, { eggId, results })
	if playing then
		return
	end
	playing = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(play, item[1], item[2])
			if not ok then
				warn("[HatchAnimation]", err)
				-- Убираем остатки анимации, чтобы затемнение не зависло на экране.
				for _, child in ipairs(gui:GetChildren()) do
					if child ~= root then
						child:Destroy()
					end
				end
				for _, child in ipairs(root:GetChildren()) do
					if not child:IsA("UIScale") then
						child:Destroy()
					end
				end
				ProximityPromptService.Enabled = true
			end
		end
		playing = false
	end)
end

function HatchAnimation.IsPlaying()
	return playing
end

return HatchAnimation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud — постоянный интерфейс:
	- счётчики сверху: сила в рюкзаке (с полоской), монеты, накопленная сила, перерождения;
	- плашка текущего мира;
	- кнопки сбоку: Питомцы, Магазин, Перерождение, Миры;
	- большая кнопка «КЛИК!» внизу по центру (удобно большим пальцем на телефоне);
	- кнопка музыки.
	Все иконки — свои 3D-модели (UI/IconModels), без эмодзи.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Backpacks = require(Shared.Config.Backpacks)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)
local State = require(UI.Parent.State)
local Sounds = require(UI.Parent.Sounds)

local Hud = {}

local WORLD_ICONS = { Forest = "Tree", Desert = "Cactus", Space = "Rocket" }

local function makePill(parent, order, width, iconName, caption, color, iconColor)
	local frame = Kit.new("Frame", {
		Name = caption,
		Size = UDim2.fromOffset(width, 56),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	local body = Kit.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -18, 1, -8),
		Position = UDim2.fromOffset(18, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = frame,
	})
	Kit.Corner(body, UDim.new(0.5, 0))
	Kit.Stroke(body, 3.5)
	Kit.Gradient(body, Kit.Lighten(color, 0.1), Kit.Darken(color, 0.25))
	local gloss = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.72,
		Size = UDim2.new(1, -40, 0.38, 0),
		Position = UDim2.new(0, 30, 0, 3),
		Parent = body,
	})
	Kit.Corner(gloss, UDim.new(0.5, 0))

	-- Круглая подложка с 3D-иконкой, выступает влево за край плашки.
	local badge = Kit.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = frame,
	})
	Kit.Corner(badge, UDim.new(0.5, 0))
	Kit.Stroke(badge, 3.5)
	Kit.Gradient(badge, Color3.fromRGB(255, 255, 255), Kit.Lighten(color, 0.45))
	Icons.Create(badge, iconName, {
		Size = UDim2.fromScale(1.15, 1.15),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 4,
		Color = iconColor,
	})

	Kit.Text({
		Name = "Caption",
		Text = caption,
		Size = UDim2.new(1, -56, 0, 15),
		Position = UDim2.fromOffset(44, 4),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		StrokeThickness = 1.5,
		Parent = body,
	})
	local value = Kit.Text({
		Name = "Value",
		Text = "0",
		Size = UDim2.new(1, -56, 0, 28),
		Position = UDim2.fromOffset(44, 18),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 27,
		StrokeThickness = 2.5,
		Parent = body,
	})
	return frame, value, body
end

-- Прозрачная кнопка поверх элемента (например, нажать на счётчик и открыть окно).
local function makeClickable(guiObject, callback)
	local button = Kit.new("TextButton", {
		Name = "Hit",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = guiObject,
	})
	button.Activated:Connect(function()
		Sounds.Play("Button")
		callback()
	end)
	return button
end

function Hud.Create(root)
	local hud = { MenuButtons = {}, Badges = {} }

	------------------------------------------------------------------ СЧЁТЧИКИ
	local top = Kit.new("Frame", {
		Name = "TopBar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(880, 60),
		Parent = root,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = top,
	})

	local strengthPill, strengthValue, strengthBody = makePill(top, 1, 300, "Dumbbell", "СИЛА В РЮКЗАКЕ", Kit.Colors.Orange)
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -56, 0, 24),
		Position = UDim2.fromOffset(44, 21),
		Color = Kit.Colors.Green,
		ZIndex = 2,
		Parent = strengthBody,
	})
	strengthValue.Parent = bar
	strengthValue.Size = UDim2.new(1, -8, 1, 0)
	strengthValue.Position = UDim2.fromOffset(4, 0)
	strengthValue.TextXAlignment = Enum.TextXAlignment.Center
	strengthValue.ZIndex = 5
	makeClickable(strengthPill, function()
		Panels.Open("Shop")
	end)

	local _, coinsValue = makePill(top, 2, 190, "Coin", "МОНЕТЫ", Kit.Colors.Yellow)
	local _, totalValue = makePill(top, 3, 190, "Star", "ВСЕГО СИЛЫ", Kit.Colors.Purple)
	local rebirthPill, rebirthValue = makePill(top, 4, 150, "Rebirth", "ПЕРЕРОЖД.", Kit.Colors.Blue, Color3.fromRGB(150, 110, 255))
	makeClickable(rebirthPill, function()
		Panels.Open("Rebirth")
	end)

	-- Плашка мира.
	local worldChip = Kit.new("Frame", {
		Name = "WorldChip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromOffset(340, 36),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.25,
		Parent = root,
	})
	Kit.Corner(worldChip, UDim.new(0.5, 0))
	Kit.Stroke(worldChip, 2.5, Color3.fromRGB(255, 255, 255)).Transparency = 0.6
	local worldIconHolder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(0, -6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
		Parent = worldChip,
	})
	local worldLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(1, -56, 1, -8),
		Position = UDim2.fromOffset(44, 4),
		MaxTextSize = 21,
		Parent = worldChip,
	})
	makeClickable(worldChip, function()
		Panels.Open("Worlds")
	end)

	------------------------------------------------------------------ БОКОВОЕ МЕНЮ
	local side = Kit.new("Frame", {
		Name = "SideMenu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 26),
		Size = UDim2.fromOffset(100, 4 * 90 + 3 * 10),
		Parent = root,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = side,
	})
	local menu = {
		{ Name = "Pets", Icon = "Paw", Text = "Питомцы", Color = Kit.Colors.Green },
		{ Name = "Shop", Icon = "ShopBag", Text = "Магазин", Color = Kit.Colors.Yellow },
		{ Name = "Rebirth", Icon = "Rebirth", Text = "Перерожд.", Color = Kit.Colors.Purple, IconColor = Color3.fromRGB(255, 255, 255) },
		{ Name = "Worlds", Icon = "Globe", Text = "Миры", Color = Kit.Colors.Blue },
	}
	for index, item in ipairs(menu) do
		local button = Kit.Button({
			Name = item.Name,
			Size = UDim2.fromOffset(100, 90),
			Color = item.Color,
			Corner = UDim.new(0, 24),
			StrokeThickness = 3.5,
			Depth = 6,
			LayoutOrder = index,
			Parent = side,
			OnClick = function()
				Panels.Toggle(item.Name)
			end,
		})
		Icons.Create(button.Face, item.Icon, {
			Size = UDim2.new(0.86, 0, 0.7, 0),
			Position = UDim2.fromScale(0.5, 0.02),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 5,
			Color = item.IconColor,
			Animate = "Swing",
		})
		Kit.Text({
			Text = item.Text,
			Size = UDim2.new(1, -8, 0.26, 0),
			Position = UDim2.new(0, 4, 0.7, 0),
			MaxTextSize = 16,
			ZIndex = 6,
			Parent = button.Face,
		})
		-- Красный кружок «!» — когда есть что сделать.
		local badge = Kit.new("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Kit.Colors.Red,
			Visible = false,
			ZIndex = 9,
			Parent = button,
		})
		Kit.Corner(badge, UDim.new(0.5, 0))
		Kit.Stroke(badge, 2.5)
		Kit.Text({ Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 10, Parent = badge })
		local badgeScale = Kit.new("UIScale", { Parent = badge })
		TweenService:Create(badgeScale, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.2 }):Play()
		hud.MenuButtons[item.Name] = button
		hud.Badges[item.Name] = badge
	end

	------------------------------------------------------------------ МУЗЫКА
	local musicButton = Kit.Button({
		Name = "Music",
		Size = UDim2.fromOffset(58, 62),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 72),
		Color = Kit.Colors.Teal,
		Corner = UDim.new(0.5, 0),
		Parent = root,
	})
	Icons.Create(musicButton.Face, "Note", { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.08), ZIndex = 5, Color = Color3.fromRGB(255, 255, 255) })
	local musicOff = Icons.Glyph(musicButton.Face, "Close", { Size = UDim2.fromScale(0.55, 0.55), ZIndex = 7, Color = Kit.Colors.Red })
	musicOff.Visible = not Sounds.IsMusicEnabled()
	musicButton.Activated:Connect(function()
		local enabled = Sounds.ToggleMusic()
		musicOff.Visible = not enabled
	end)

	------------------------------------------------------------------ КНОПКА КЛИКА
	local ring = Kit.new("Frame", {
		Name = "ClickRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(150, 150),
		BackgroundColor3 = Kit.Colors.Yellow,
		BackgroundTransparency = 0.35,
		ZIndex = 0,
		Parent = root,
	})
	Kit.Corner(ring, UDim.new(0.5, 0))
	TweenService:Create(ring, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, -1), {
		Size = UDim2.fromOffset(196, 196),
		BackgroundTransparency = 1,
	}):Play()

	local clickButton = Kit.Button({
		Name = "ClickButton",
		Size = UDim2.fromOffset(156, 162),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Color = Kit.Colors.Yellow,
		Color2 = Kit.Colors.OrangeDark,
		Corner = UDim.new(0.5, 0),
		StrokeThickness = 5,
		Depth = 8,
		Sound = false,
		Parent = root,
	})
	local clickIconHolder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(0.78, 0.62),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		Parent = clickButton.Face,
	})
	Icons.Create(clickIconHolder, "Dumbbell", { Size = UDim2.fromScale(1, 1), ZIndex = 5, Animate = "Bob" })
	Kit.Text({
		Text = "КЛИК!",
		Size = UDim2.fromScale(0.72, 0.22),
		Position = UDim2.fromScale(0.5, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 34,
		StrokeThickness = 3.5,
		ZIndex = 6,
		Parent = clickButton.Face,
	})

	local powerLabel = Kit.Text({
		Name = "PowerLabel",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -178),
		Size = UDim2.fromOffset(360, 28),
		MaxTextSize = 24,
		StrokeThickness = 3,
		Parent = root,
	})

	local fullLabel = Kit.Text({
		Name = "FullWarning",
		Text = "Рюкзак полон! Беги на продажу",
		Color = Color3.fromRGB(255, 130, 130),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -208),
		Size = UDim2.fromOffset(520, 38),
		MaxTextSize = 32,
		StrokeThickness = 3.5,
		Visible = false,
		Parent = root,
	})

	------------------------------------------------------------------ ОБНОВЛЕНИЕ
	local lastCoins, lastTotal = nil, nil

	State.Watch({ "Strength", "Capacity" }, function()
		local strength, capacity = State.Get("Strength", 0), State.Get("Capacity", 50)
		strengthValue.Text = Format.Number(strength) .. " / " .. Format.Number(capacity)
		local fraction = capacity > 0 and strength / capacity or 0
		local color = Kit.Colors.Green
		if fraction >= 1 then
			color = Kit.Colors.Red
		elseif fraction >= 0.75 then
			color = Kit.Colors.Orange
		end
		setBar(fraction, color)
		fullLabel.Visible = fraction >= 1
	end)

	State.Watch("Coins", function()
		local coins = State.Get("Coins", 0)
		coinsValue.Text = Format.Number(coins)
		if lastCoins and coins > lastCoins then
			Kit.Pop(coinsValue, 1.25)
		end
		lastCoins = coins
	end)

	State.Watch("TotalStrength", function()
		local total = State.Get("TotalStrength", 0)
		totalValue.Text = Format.Number(total)
		if lastTotal and total > lastTotal then
			Kit.Pop(totalValue, 1.12)
		end
		lastTotal = total
	end)

	State.Watch("Rebirths", function()
		rebirthValue.Text = Format.Number(State.Get("Rebirths", 0))
	end)

	State.Watch({ "ClickPower" }, function()
		powerLabel.Text = "+" .. Format.Number(State.Get("ClickPower", 1)) .. " силы за клик"
	end)

	local shownWorldIcon = nil
	State.Watch("World", function()
		local worldId = State.Get("World", "Forest")
		local world = Worlds[worldId] or Worlds.Forest
		worldLabel.Text = string.format("%s  •  продажа ×%s", Format.Upper(world.Name), Format.Number(world.SellMultiplier))
		worldLabel.TextColor3 = Kit.Lighten(world.Color, 0.35)
		if shownWorldIcon ~= worldId then
			shownWorldIcon = worldId
			worldIconHolder:ClearAllChildren()
			Icons.Create(worldIconHolder, WORLD_ICONS[worldId] or "Globe", { Size = UDim2.fromScale(1, 1), ZIndex = 3 })
		end
	end)

	-- Значки «!» на кнопках.
	State.Watch({ "TotalStrength", "Rebirths" }, function()
		hud.Badges.Rebirth.Visible = State.Get("TotalStrength", 0) >= Formulas.RebirthCost(State.Get("Rebirths", 0))
	end)
	State.Watch({ "TotalStrength", "UnlockedWorlds" }, function()
		local unlocked = State.UnlockedWorlds()
		local canUnlock = false
		for _, worldId in ipairs(Worlds.Order) do
			if not unlocked[worldId] then
				canUnlock = State.Get("TotalStrength", 0) >= Worlds[worldId].UnlockStrength
				break
			end
		end
		hud.Badges.Worlds.Visible = canUnlock
	end)
	State.Watch({ "Coins", "BackpackLevel" }, function()
		local nextBackpack = Backpacks[State.Get("BackpackLevel", 1) + 1]
		hud.Badges.Shop.Visible = nextBackpack ~= nil and State.Get("Coins", 0) >= nextBackpack.Price
	end)

	------------------------------------------------------------------ API
	hud.ClickButton = clickButton

	function hud.Punch()
		Kit.Pop(clickIconHolder, 1.2)
	end

	function hud.FlashFull()
		fullLabel.Visible = true
		Kit.Pop(fullLabel, 1.2)
		Kit.Pop(bar, 1.12)
	end

	return hud
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">IconModels</string>
              <string name="Source"><![CDATA[--[[
	IconModels — собственные 3D-иконки игры, собранные из деталей (никаких картинок и эмодзи).
	Каждая иконка — модель с центром в (0, 0, 0), «лицом» к камере (камера смотрит из -Z).

	IconModels.Build(name, options) -> Model
	options.Color / options.Color2 — перекрасить иконку (рюкзаки разных уровней, яйца и т. п.)

	Список иконок: Coin, Star, Dumbbell, Rebirth, Paw, ShopBag, Globe, Backpack, Egg, Lock, Trash,
	Crown, Check, Cross, Exclamation, MoneyBag, Portal, Tree, Cactus, Rocket, Note, Sparkle, Gift.
]]

local IconModels = {}

local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(35, 30, 60)
local GOLD = Color3.fromRGB(255, 200, 45)
local GOLD_LIGHT = Color3.fromRGB(255, 230, 120)
local GOLD_DARK = Color3.fromRGB(225, 150, 20)
local METAL = Color3.fromRGB(110, 115, 135)
local METAL_LIGHT = Color3.fromRGB(190, 195, 210)

local HALF_PI = math.pi / 2

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function lighten(color, amount)
	return color:Lerp(WHITE, amount)
end

local function darken(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

------------------------------------------------------------------ ДЕТАЛИ

-- kind: "Block" | "Ball" | "Cylinder" | "Ellipsoid" | "Wedge"
local function add(model, kind, size, cframe, color, options)
	options = options or {}
	local part
	if kind == "Wedge" then
		part = Instance.new("WedgePart")
	else
		part = Instance.new("Part")
	end
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if kind == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif kind == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	elseif kind == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = options.Material or Enum.Material.SmoothPlastic
	part.Reflectance = options.Reflectance or 0
	part.Transparency = options.Transparency or 0
	if options.NoOutline then
		part:SetAttribute("NoOutline", true)
	end
	part.Parent = model
	return part
end

-- Цилиндр, ось которого смотрит на камеру (монеты, диски).
local function discZ(model, center, diameter, depth, color, options)
	return add(model, "Cylinder", Vector3.new(depth, diameter, diameter), CFrame.new(center) * CFrame.Angles(0, HALF_PI, 0), color, options)
end

-- Вертикальный цилиндр.
local function cylinderY(model, center, height, diameter, color, options)
	return add(model, "Cylinder", Vector3.new(height, diameter, diameter), CFrame.new(center) * CFrame.Angles(0, 0, HALF_PI), color, options)
end

-- Равнобедренный треугольник в плоскости XY системы cframe: основание в начале координат, вершина вверх (+Y).
local function triangle(model, cframe, baseWidth, height, depth, color, options)
	local half = baseWidth / 2
	add(model, "Wedge", Vector3.new(depth, height, half), cframe * CFrame.new(half / 2, height / 2, 0) * CFrame.Angles(0, -HALF_PI, 0), color, options)
	add(model, "Wedge", Vector3.new(depth, height, half), cframe * CFrame.new(-half / 2, height / 2, 0) * CFrame.Angles(0, HALF_PI, 0), color, options)
end

-- Звезда в плоскости XY (лицом к камере).
local function star(model, center, points, outer, inner, depth, color, options)
	add(model, "Cylinder", Vector3.new(depth, inner * 2, inner * 2), center * CFrame.Angles(0, HALF_PI, 0), color, options)
	local baseDistance = inner * math.cos(math.pi / points)
	local halfBase = inner * math.sin(math.pi / points)
	for i = 0, points - 1 do
		local angle = i * (2 * math.pi / points)
		local spike = center * CFrame.Angles(0, 0, -angle) * CFrame.new(0, baseDistance - 0.02, 0)
		triangle(model, spike, halfBase * 2 + 0.04, outer - baseDistance, depth, color, options)
	end
end

-- Дуга из блоков в плоскости XY: от угла a до угла b (радианы, 0 = вверх, по часовой).
local function arc(model, center, radius, thickness, depth, fromAngle, toAngle, segments, color, options)
	local step = (toAngle - fromAngle) / segments
	local chord = 2 * radius * math.sin(math.abs(step) / 2) + thickness * 0.35
	for i = 0, segments - 1 do
		local angle = fromAngle + step * (i + 0.5)
		add(model, "Block", Vector3.new(chord, thickness, depth), center * CFrame.Angles(0, 0, -angle) * CFrame.new(0, radius, 0), color, options)
	end
end

------------------------------------------------------------------ ИКОНКИ

local Builders = {}

function Builders.Coin(model, options)
	local color = options.Color or GOLD
	discZ(model, Vector3.zero, 3, 0.5, darken(color, 0.12), { Reflectance = 0.1 })
	discZ(model, Vector3.new(0, 0, -0.08), 2.55, 0.5, color, { Reflectance = 0.15 })
	discZ(model, Vector3.new(0, 0, -0.14), 2.1, 0.5, lighten(color, 0.25))
	star(model, CFrame.new(0, -0.02, -0.42), 5, 0.78, 0.34, 0.12, darken(color, 0.1))
	add(model, "Ellipsoid", Vector3.new(0.6, 0.3, 0.1), CFrame.new(-0.62, 0.72, -0.43) * CFrame.Angles(0, 0, math.rad(35)), WHITE, { Transparency = 0.25, NoOutline = true })
	return { Yaw = math.rad(-18), Pitch = 0.1 }
end

function Builders.Star(model, options)
	local color = options.Color or GOLD
	star(model, CFrame.new(0, 0, 0), 5, 1.65, 0.72, 0.55, darken(color, 0.08))
	star(model, CFrame.new(0, 0.02, -0.2), 5, 1.2, 0.52, 0.3, lighten(color, 0.2))
	add(model, "Ellipsoid", Vector3.new(0.45, 0.22, 0.08), CFrame.new(-0.28, 0.42, -0.38) * CFrame.Angles(0, 0, math.rad(30)), WHITE, { Transparency = 0.2, NoOutline = true })
	return { Yaw = math.rad(-15), Pitch = 0.05 }
end

function Builders.Sparkle(model, options)
	local color = options.Color or GOLD_LIGHT
	star(model, CFrame.new(0, 0, 0), 4, 1.7, 0.45, 0.4, color, { Material = Enum.Material.Neon })
	star(model, CFrame.new(1.1, 1.1, -0.1), 4, 0.6, 0.16, 0.25, WHITE, { Material = Enum.Material.Neon })
	return { Yaw = 0, Pitch = 0 }
end

function Builders.Dumbbell(model, options)
	local plate = options.Color or rgb(255, 80, 80)
	local cf = CFrame.Angles(0, 0, math.rad(-20))
	add(model, "Cylinder", Vector3.new(3.6, 0.32, 0.32), cf, METAL_LIGHT, { Material = Enum.Material.Metal })
	for _, side in ipairs({ -1, 1 }) do
		add(model, "Cylinder", Vector3.new(0.42, 1.9, 1.9), cf * CFrame.new(side * 0.95, 0, 0), plate)
		add(model, "Cylinder", Vector3.new(0.36, 1.45, 1.45), cf * CFrame.new(side * 1.33, 0, 0), lighten(plate, 0.15))
		add(model, "Cylinder", Vector3.new(0.18, 0.55, 0.55), cf * CFrame.new(side * 1.66, 0, 0), METAL, { Material = Enum.Material.Metal })
		add(model, "Cylinder", Vector3.new(0.44, 0.7, 0.7), cf * CFrame.new(side * 0.95, 0, 0), METAL, { Material = Enum.Material.Metal })
	end
	-- рукоять с насечками
	for i = -2, 2 do
		add(model, "Cylinder", Vector3.new(0.1, 0.38, 0.38), cf * CFrame.new(i * 0.14, 0, 0), METAL, { Material = Enum.Material.Metal })
	end
	return { Yaw = math.rad(-30), Pitch = 0.35 }
end

function Builders.Rebirth(model, options)
	local color = options.Color or rgb(176, 108, 255)
	local light = lighten(color, 0.3)
	local center = CFrame.new()
	for _, offset in ipairs({ 0, math.pi }) do
		arc(model, center, 1.25, 0.42, 0.45, offset + math.rad(15), offset + math.rad(150), 9, color)
		-- наконечник стрелки по касательной
		local tipAngle = offset + math.rad(150)
		local tip = center * CFrame.Angles(0, 0, -tipAngle) * CFrame.new(0, 1.25, 0) * CFrame.Angles(0, 0, -HALF_PI)
		triangle(model, tip, 1.05, 0.7, 0.45, light)
	end
	add(model, "Ball", Vector3.one * 0.7, CFrame.new(0, 0, 0), light, { Material = Enum.Material.Neon })
	return { Yaw = math.rad(-12), Pitch = 0.1 }
end

function Builders.Paw(model, options)
	local pad = options.Color or rgb(255, 130, 175)
	local base = options.Color2 or WHITE
	add(model, "Ellipsoid", Vector3.new(2.2, 1.85, 0.6), CFrame.new(0, -0.5, 0.05), base)
	add(model, "Ellipsoid", Vector3.new(1.6, 1.3, 0.6), CFrame.new(0, -0.55, -0.12), pad)
	local toes = { { -1.05, 0.55, -20 }, { -0.4, 1.1, -6 }, { 0.4, 1.1, 6 }, { 1.05, 0.55, 20 } }
	for _, toe in ipairs(toes) do
		local cf = CFrame.new(toe[1], toe[2], 0.05) * CFrame.Angles(0, 0, math.rad(-toe[3]))
		add(model, "Ellipsoid", Vector3.new(0.8, 0.98, 0.55), cf, base)
		add(model, "Ellipsoid", Vector3.new(0.56, 0.72, 0.55), cf * CFrame.new(0, -0.02, -0.15), pad)
	end
	return { Yaw = math.rad(-12), Pitch = 0.05 }
end

function Builders.ShopBag(model, options)
	local color = options.Color or rgb(255, 160, 50)
	add(model, "Block", Vector3.new(2.3, 2.3, 1.1), CFrame.new(0, -0.35, 0), color)
	add(model, "Block", Vector3.new(2.36, 0.35, 1.16), CFrame.new(0, 0.62, 0), darken(color, 0.15))
	-- ручка
	arc(model, CFrame.new(0, 0.85, -0.1), 0.62, 0.18, 0.18, math.rad(-80), math.rad(80), 8, METAL_LIGHT)
	arc(model, CFrame.new(0, 0.85, 0.3), 0.62, 0.18, 0.18, math.rad(-80), math.rad(80), 8, METAL_LIGHT)
	-- звезда-эмблема
	star(model, CFrame.new(0, -0.4, -0.58), 5, 0.62, 0.27, 0.1, rgb(255, 245, 210))
	return { Yaw = math.rad(-25), Pitch = 0.2 }
end

function Builders.Globe(model, options)
	local ocean = options.Color or rgb(70, 160, 255)
	add(model, "Ball", Vector3.one * 2.8, CFrame.new(), ocean)
	local land = rgb(100, 210, 90)
	local lands = {
		{ Vector3.new(-0.55, 0.5, -1.1), Vector3.new(1.0, 0.8, 0.5) },
		{ Vector3.new(0.6, -0.35, -1.15), Vector3.new(0.9, 1.0, 0.5) },
		{ Vector3.new(-0.3, -0.75, -1.05), Vector3.new(0.6, 0.45, 0.5) },
		{ Vector3.new(0.85, 0.75, -0.8), Vector3.new(0.5, 0.4, 0.5) },
	}
	for _, item in ipairs(lands) do
		local position = item[1].Unit * 1.32
		add(model, "Ellipsoid", item[2], CFrame.lookAt(position, position * 2), land)
	end
	-- кольцо
	local ring = CFrame.Angles(math.rad(70), 0, math.rad(-20))
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2
		local p = ring * Vector3.new(math.cos(angle) * 2.05, 0, math.sin(angle) * 2.05)
		add(model, "Ball", Vector3.one * 0.26, CFrame.new(p), GOLD, { NoOutline = true })
	end
	return { Yaw = math.rad(-20), Pitch = 0.15 }
end

function Builders.Backpack(model, options)
	local color = options.Color or rgb(90, 170, 255)
	local dark = darken(color, 0.22)
	add(model, "Block", Vector3.new(2.1, 2.2, 1.2), CFrame.new(0, -0.3, 0), color)
	add(model, "Ellipsoid", Vector3.new(2.1, 1.2, 1.2), CFrame.new(0, 0.8, 0), color)
	-- клапан
	add(model, "Ellipsoid", Vector3.new(2.0, 1.1, 0.4), CFrame.new(0, 0.62, -0.45), dark)
	-- карман
	add(model, "Block", Vector3.new(1.4, 0.95, 0.35), CFrame.new(0, -0.65, -0.68), lighten(color, 0.15))
	add(model, "Block", Vector3.new(1.42, 0.22, 0.38), CFrame.new(0, -0.24, -0.69), dark)
	add(model, "Ball", Vector3.one * 0.22, CFrame.new(0, -0.35, -0.88), GOLD)
	-- лямки по бокам
	for _, side in ipairs({ -1, 1 }) do
		add(model, "Block", Vector3.new(0.25, 2.2, 0.4), CFrame.new(side * 1.12, -0.2, 0.2), dark)
	end
	-- ручка
	arc(model, CFrame.new(0, 1.25, 0.1), 0.38, 0.15, 0.15, math.rad(-80), math.rad(80), 6, dark)
	return { Yaw = math.rad(-25), Pitch = 0.15 }
end

function Builders.Egg(model, options)
	local color = options.Color or rgb(150, 225, 110)
	local spot = options.Color2 or rgb(80, 165, 60)
	add(model, "Ellipsoid", Vector3.new(2.3, 2.95, 2.3), CFrame.new(), color)
	local spots = { { 25, 10, 0.55 }, { 100, -18, 0.45 }, { 160, 28, 0.5 }, { 220, -5, 0.4 }, { 300, 35, 0.48 }, { 60, 50, 0.35 }, { 260, -40, 0.4 } }
	for _, s in ipairs(spots) do
		local around, elevation = math.rad(s[1] + 90), math.rad(s[2])
		local offset = Vector3.new(math.cos(elevation) * math.cos(around) * 1.15, math.sin(elevation) * 1.47, math.cos(elevation) * math.sin(around) * 1.15)
		add(model, "Ball", Vector3.one * s[3], CFrame.new(offset * 0.94), spot)
	end
	add(model, "Ellipsoid", Vector3.new(0.4, 0.7, 0.2), CFrame.new(-0.5, 0.6, -0.95) * CFrame.Angles(0, 0, math.rad(20)), WHITE, { Transparency = 0.35, NoOutline = true })
	return { Yaw = 0, Pitch = 0.05 }
end

function Builders.Lock(model, options)
	local color = options.Color or GOLD
	arc(model, CFrame.new(0, 0.45, 0), 0.72, 0.3, 0.3, math.rad(-90), math.rad(90), 10, METAL_LIGHT, { Material = Enum.Material.Metal })
	for _, side in ipairs({ -1, 1 }) do
		add(model, "Block", Vector3.new(0.3, 0.55, 0.3), CFrame.new(side * 0.72, 0.25, 0), METAL_LIGHT, { Material = Enum.Material.Metal })
	end
	add(model, "Block", Vector3.new(2.0, 1.6, 0.8), CFrame.new(0, -0.55, 0), color, { Reflectance = 0.1 })
	add(model, "Block", Vector3.new(1.7, 1.3, 0.1), CFrame.new(0, -0.55, -0.42), lighten(color, 0.2))
	discZ(model, Vector3.new(0, -0.38, -0.5), 0.42, 0.1, INK)
	triangle(model, CFrame.new(0, -0.95, -0.5), 0.36, 0.55, 0.1, INK)
	return { Yaw = math.rad(-18), Pitch = 0.1 }
end

function Builders.Trash(model, options)
	local color = options.Color or rgb(255, 90, 90)
	cylinderY(model, Vector3.new(0, -0.3, 0), 2.2, 1.9, color)
	for i = 0, 3 do
		local angle = math.rad(-60 + i * 40)
		add(model, "Block", Vector3.new(0.14, 1.7, 0.1), CFrame.new(math.sin(angle) * 0.96, -0.3, -math.cos(angle) * 0.96) * CFrame.Angles(0, -angle, 0), darken(color, 0.25))
	end
	cylinderY(model, Vector3.new(0, 0.92, 0), 0.25, 2.2, darken(color, 0.15))
	add(model, "Block", Vector3.new(0.8, 0.2, 0.3), CFrame.new(0, 1.18, 0), METAL_LIGHT)
	return { Yaw = math.rad(-15), Pitch = 0.45 }
end

function Builders.Crown(model, options)
	local color = options.Color or GOLD
	cylinderY(model, Vector3.new(0, -0.5, 0), 0.75, 2.6, color, { Reflectance = 0.15 })
	cylinderY(model, Vector3.new(0, -0.82, 0), 0.22, 2.7, GOLD_DARK)
	for i = 0, 4 do
		local angle = i / 5 * math.pi * 2
		local position = Vector3.new(math.sin(angle) * 1.15, 0.15, -math.cos(angle) * 1.15)
		add(model, "Block", Vector3.new(0.75, 0.75, 0.3), CFrame.new(position) * CFrame.Angles(0, -angle, math.rad(45)), color, { Reflectance = 0.15 })
		add(model, "Ball", Vector3.one * 0.35, CFrame.new(position + Vector3.new(0, 0.6, 0)), GOLD_LIGHT)
	end
	local gems = { rgb(255, 60, 100), rgb(80, 200, 255), rgb(120, 255, 140) }
	for i, gem in ipairs(gems) do
		local angle = math.rad(-40 + (i - 1) * 40)
		add(model, "Ball", Vector3.one * 0.4, CFrame.new(math.sin(angle) * 1.3, -0.5, -math.cos(angle) * 1.3), gem, { Material = Enum.Material.Neon })
	end
	return { Yaw = 0, Pitch = 0.55 }
end

function Builders.Check(model, options)
	local color = options.Color or rgb(90, 220, 90)
	add(model, "Block", Vector3.new(0.6, 1.3, 0.5), CFrame.new(-0.55, -0.15, 0) * CFrame.Angles(0, 0, math.rad(40)), color)
	add(model, "Block", Vector3.new(0.6, 2.5, 0.5), CFrame.new(0.42, 0.35, 0) * CFrame.Angles(0, 0, math.rad(-35)), color)
	return { Yaw = math.rad(-12), Pitch = 0 }
end

function Builders.Cross(model, options)
	local color = options.Color or rgb(255, 80, 80)
	add(model, "Block", Vector3.new(0.6, 2.4, 0.5), CFrame.Angles(0, 0, math.rad(45)), color)
	add(model, "Block", Vector3.new(0.6, 2.4, 0.5), CFrame.Angles(0, 0, math.rad(-45)), color)
	return { Yaw = math.rad(-12), Pitch = 0 }
end

function Builders.Exclamation(model, options)
	local color = options.Color or rgb(255, 170, 40)
	add(model, "Ellipsoid", Vector3.new(0.75, 1.9, 0.6), CFrame.new(0, 0.4, 0), color)
	add(model, "Ball", Vector3.one * 0.7, CFrame.new(0, -1.15, 0), color)
	return { Yaw = math.rad(-12), Pitch = 0 }
end

function Builders.MoneyBag(model, options)
	local color = options.Color or rgb(120, 200, 90)
	add(model, "Ellipsoid", Vector3.new(2.4, 2.3, 2.2), CFrame.new(0, -0.35, 0), color)
	cylinderY(model, Vector3.new(0, 0.85, 0), 0.4, 0.7, darken(color, 0.1))
	cylinderY(model, Vector3.new(0, 0.92, 0), 0.18, 0.85, GOLD)
	for i = 0, 2 do
		local angle = math.rad(-40 + i * 40)
		add(model, "Ellipsoid", Vector3.new(0.45, 0.6, 0.35), CFrame.new(math.sin(angle) * 0.35, 1.25, -math.cos(angle) * 0.2) * CFrame.Angles(0, 0, -angle), color)
	end
	-- монета на мешке
	discZ(model, Vector3.new(0, -0.4, -1.1), 1.0, 0.18, GOLD)
	star(model, CFrame.new(0, -0.41, -1.21), 5, 0.32, 0.14, 0.06, GOLD_DARK)
	return { Yaw = math.rad(-15), Pitch = 0.1 }
end

function Builders.Portal(model, options)
	local color = options.Color or rgb(170, 110, 255)
	arc(model, CFrame.new(), 1.45, 0.38, 0.45, 0, math.pi * 2, 20, darken(color, 0.25))
	discZ(model, Vector3.new(0, 0, 0.05), 2.5, 0.2, color, { Material = Enum.Material.Neon, Transparency = 0.1 })
	arc(model, CFrame.new(0, 0, -0.15), 0.8, 0.14, 0.1, 0, math.rad(260), 10, WHITE, { Material = Enum.Material.Neon, NoOutline = true })
	return { Yaw = math.rad(-15), Pitch = 0 }
end

function Builders.Tree(model, options)
	local leaves = options.Color or rgb(90, 190, 80)
	cylinderY(model, Vector3.new(0, -1.0, 0), 1.3, 0.55, rgb(140, 95, 60))
	add(model, "Ball", Vector3.one * 1.9, CFrame.new(0, 0.05, 0), leaves)
	add(model, "Ball", Vector3.one * 1.35, CFrame.new(-0.75, -0.2, -0.2), darken(leaves, 0.08))
	add(model, "Ball", Vector3.one * 1.35, CFrame.new(0.75, -0.15, -0.15), lighten(leaves, 0.08))
	add(model, "Ball", Vector3.one * 1.2, CFrame.new(0.1, 0.85, -0.1), lighten(leaves, 0.15))
	add(model, "Ball", Vector3.one * 0.3, CFrame.new(-0.5, 0.3, -0.92), rgb(255, 80, 90))
	add(model, "Ball", Vector3.one * 0.3, CFrame.new(0.45, 0.65, -0.75), rgb(255, 80, 90))
	return { Yaw = math.rad(-10), Pitch = 0.1 }
end

function Builders.Cactus(model, options)
	local color = options.Color or rgb(90, 180, 80)
	cylinderY(model, Vector3.new(0, -0.1, 0), 2.6, 0.8, color)
	add(model, "Ball", Vector3.one * 0.8, CFrame.new(0, 1.2, 0), color)
	for _, item in ipairs({ { -1, -0.1, 0.8 }, { 1, 0.3, 0.6 } }) do
		local side, y, h = item[1], item[2], item[3]
		add(model, "Cylinder", Vector3.new(0.6, 0.5, 0.5), CFrame.new(side * 0.55, y, 0), color)
		cylinderY(model, Vector3.new(side * 0.8, y + h / 2, 0), h, 0.5, color)
		add(model, "Ball", Vector3.one * 0.5, CFrame.new(side * 0.8, y + h, 0), color)
	end
	add(model, "Ball", Vector3.one * 0.45, CFrame.new(0, 1.62, 0), rgb(255, 100, 170))
	-- горшок-песок
	cylinderY(model, Vector3.new(0, -1.45, 0), 0.4, 1.8, rgb(240, 200, 130))
	return { Yaw = math.rad(-15), Pitch = 0.15 }
end

function Builders.Rocket(model, options)
	local body = options.Color or rgb(240, 240, 250)
	local red = rgb(255, 80, 90)
	local tilt = CFrame.Angles(0, 0, math.rad(-35))
	add(model, "Cylinder", Vector3.new(2.2, 1.1, 1.1), tilt * CFrame.Angles(0, 0, HALF_PI), body)
	add(model, "Ellipsoid", Vector3.new(1.1, 1.3, 1.1), tilt * CFrame.new(0, 1.3, 0), red)
	add(model, "Ball", Vector3.one * 0.55, tilt * CFrame.new(0, 0.35, -0.45), rgb(110, 220, 255), { Material = Enum.Material.Neon })
	for i = 0, 2 do
		local angle = i / 3 * math.pi * 2
		add(model, "Block", Vector3.new(0.12, 0.8, 0.6), tilt * CFrame.new(0, -0.95, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 0.7), red)
	end
	add(model, "Ellipsoid", Vector3.new(0.7, 1.0, 0.7), tilt * CFrame.new(0, -1.55, 0), rgb(255, 170, 50), { Material = Enum.Material.Neon })
	add(model, "Ellipsoid", Vector3.new(0.4, 0.6, 0.4), tilt * CFrame.new(0, -1.85, 0), rgb(255, 240, 150), { Material = Enum.Material.Neon, NoOutline = true })
	return { Yaw = math.rad(-20), Pitch = 0.1 }
end

function Builders.Note(model, options)
	local color = options.Color or rgb(120, 200, 255)
	add(model, "Ellipsoid", Vector3.new(0.9, 0.7, 0.5), CFrame.new(-0.75, -0.95, 0) * CFrame.Angles(0, 0, math.rad(20)), color)
	add(model, "Ellipsoid", Vector3.new(0.9, 0.7, 0.5), CFrame.new(0.85, -0.6, 0) * CFrame.Angles(0, 0, math.rad(20)), color)
	add(model, "Block", Vector3.new(0.18, 1.9, 0.18), CFrame.new(-0.4, 0.05, 0), color)
	add(model, "Block", Vector3.new(0.18, 1.9, 0.18), CFrame.new(1.2, 0.4, 0), color)
	add(model, "Block", Vector3.new(1.8, 0.4, 0.2), CFrame.new(0.4, 1.0, 0) * CFrame.Angles(0, 0, math.rad(12)), color)
	return { Yaw = math.rad(-12), Pitch = 0 }
end

function Builders.Gift(model, options)
	local color = options.Color or rgb(255, 90, 140)
	local ribbon = options.Color2 or GOLD
	add(model, "Block", Vector3.new(2.2, 1.7, 2.2), CFrame.new(0, -0.4, 0), color)
	add(model, "Block", Vector3.new(2.4, 0.5, 2.4), CFrame.new(0, 0.6, 0), lighten(color, 0.1))
	add(model, "Block", Vector3.new(0.45, 2.25, 2.45), CFrame.new(0, -0.15, 0), ribbon)
	add(model, "Block", Vector3.new(2.45, 2.25, 0.45), CFrame.new(0, -0.15, 0), ribbon)
	for _, side in ipairs({ -1, 1 }) do
		add(model, "Ellipsoid", Vector3.new(0.9, 0.6, 0.35), CFrame.new(side * 0.45, 1.05, 0) * CFrame.Angles(0, 0, side * math.rad(-30)), ribbon)
	end
	return { Yaw = math.rad(-30), Pitch = 0.3 }
end

-- Список имён (для проверок).
IconModels.Names = {}
for name in pairs(Builders) do
	table.insert(IconModels.Names, name)
end
table.sort(IconModels.Names)

function IconModels.Build(name, options)
	options = options or {}
	local builder = Builders[name]
	if not builder then
		warn("[IconModels] Нет иконки", name)
		builder = Builders.Star
	end
	local model = Instance.new("Model")
	model.Name = "Icon_" .. tostring(name)
	local root = add(model, "Block", Vector3.new(0.1, 0.1, 0.1), CFrame.identity, WHITE, { Transparency = 1, NoOutline = true })
	root.Name = "Root"
	model.PrimaryPart = root
	local view = builder(model, options) or {}
	return model, view
end

return IconModels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons — собственные иконки игры.
	Icons.Create(parent, name, props)    — 3D-иконка (см. IconModels) в ViewportFrame
	Icons.Pet(parent, petId, golden, props) — 3D-портрет питомца
	Icons.Coin2D(parent, props)          — плоская монетка из рамок (дёшево, для «+N» и цен)
	Icons.Glyph(parent, kind, props)     — плоские значки из рамок: "Close", "Plus", "Check", "Arrow"
	props: Size, Position, AnchorPoint, ZIndex, Animate ("Swing"|"Spin"|"Bob"), Outline (false — без контура),
	       Color, Color2, Zoom, LayoutOrder, Name
	Возвращает ViewportFrame и объект Viewport3D.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetBuilder = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("PetBuilder"))

local UI = script.Parent
local Kit = require(UI.Kit)
local IconModels = require(UI.IconModels)
local Viewport3D = require(UI.Viewport3D)

local Icons = {}

local DEFAULT_OUTLINE = 0.16

function Icons.Create(parent, name, props)
	props = props or {}
	local view = Viewport3D.new(parent, props)
	local model, settings = IconModels.Build(name, props)
	view:SetModel(model, {
		Outline = props.Outline ~= false and (props.Outline or DEFAULT_OUTLINE) or nil,
		Yaw = props.Yaw or settings.Yaw,
		Pitch = props.Pitch or settings.Pitch,
		Zoom = props.Zoom,
	})
	return view.Frame, view
end

function Icons.Pet(parent, petId, golden, props)
	props = props or {}
	local view = Viewport3D.new(parent, props)
	local model = PetBuilder.Build(petId, golden)
	if model then
		view:SetModel(model, {
			Outline = props.Outline ~= false and (props.Outline or 0.12) or nil,
			Yaw = props.Yaw or math.rad(-20),
			Pitch = props.Pitch or 0.15,
			Zoom = props.Zoom,
		})
	end
	return view.Frame, view
end

function Icons.Coin2D(parent, props)
	props = props or {}
	local coin = Kit.new("Frame", {
		Name = props.Name or "Coin",
		Size = props.Size or UDim2.fromOffset(28, 28),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = parent,
	})
	Kit.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = coin })
	Kit.Corner(coin, UDim.new(0.5, 0))
	Kit.Gradient(coin, Color3.fromRGB(255, 226, 90), Color3.fromRGB(235, 150, 20))
	Kit.new("UIStroke", { Color = Kit.Colors.Ink, Thickness = props.StrokeThickness or 2, Parent = coin })
	local inner = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		BackgroundColor3 = Color3.fromRGB(255, 205, 50),
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = coin,
	})
	Kit.Corner(inner, UDim.new(0.5, 0))
	Kit.new("UIStroke", { Color = Color3.fromRGB(215, 140, 20), Thickness = 1.5, Parent = inner })
	local shine = Kit.new("Frame", {
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.28, 0.18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.25,
		Rotation = -30,
		ZIndex = (props.ZIndex or 1) + 2,
		Parent = coin,
	})
	Kit.Corner(shine, UDim.new(0.5, 0))
	return coin
end

-- Плоские значки из полосок.
function Icons.Glyph(parent, kind, props)
	props = props or {}
	local holder = Kit.new("Frame", {
		Name = props.Name or kind,
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromOffset(24, 24),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	local color = props.Color or Kit.Colors.White
	local function bar(rotation, length, offsetX, offsetY)
		local item = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5 + (offsetX or 0), 0, 0.5 + (offsetY or 0), 0),
			Size = UDim2.fromScale(length, 0.22),
			Rotation = rotation,
			BackgroundColor3 = color,
			ZIndex = holder.ZIndex,
			Parent = holder,
		})
		Kit.Corner(item, UDim.new(0.5, 0))
		Kit.new("UIStroke", { Color = Kit.Colors.Ink, Thickness = 2, Parent = item })
		return item
	end
	if kind == "Close" then
		bar(45, 1)
		bar(-45, 1)
	elseif kind == "Plus" then
		bar(0, 1)
		bar(90, 1)
	elseif kind == "Check" then
		bar(45, 0.5, -0.17, 0.12)
		bar(-50, 0.85, 0.12, -0.02)
	elseif kind == "Arrow" then
		bar(0, 0.8, -0.05)
		bar(40, 0.5, 0.2, -0.12)
		bar(-40, 0.5, 0.2, 0.12)
	end
	return holder
end

-- Кнопки Kit умеют показывать иконки слева от текста.
Kit.SetIconFactory(Icons)

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Kit — мультяшный набор для интерфейса: цвета, шрифт, кнопки, надписи, масштабирование.

	Весь интерфейс рисуется в «дизайн-пикселях» на холсте 1000×560 и масштабируется под экран
	через UIScale, поэтому на телефоне кнопки остаются крупными, а на мониторе — не гигантскими.
]]

local TweenService = game:GetService("TweenService")

local Sounds = require(script.Parent.Parent:WaitForChild("Sounds"))

local Kit = {}

Kit.DesignSize = Vector2.new(1000, 560)
Kit.Scale = 1

Kit.Colors = {
	Ink = Color3.fromRGB(32, 26, 58),
	White = Color3.fromRGB(255, 255, 255),
	Panel = Color3.fromRGB(255, 250, 240),
	PanelDark = Color3.fromRGB(240, 229, 210),
	PanelDeep = Color3.fromRGB(226, 210, 186),
	Green = Color3.fromRGB(100, 225, 95),
	GreenDark = Color3.fromRGB(40, 165, 60),
	Blue = Color3.fromRGB(75, 180, 255),
	BlueDark = Color3.fromRGB(35, 110, 225),
	Yellow = Color3.fromRGB(255, 220, 65),
	YellowDark = Color3.fromRGB(255, 160, 25),
	Orange = Color3.fromRGB(255, 160, 50),
	OrangeDark = Color3.fromRGB(235, 100, 20),
	Purple = Color3.fromRGB(180, 112, 255),
	PurpleDark = Color3.fromRGB(110, 55, 215),
	Red = Color3.fromRGB(255, 88, 88),
	RedDark = Color3.fromRGB(200, 40, 55),
	Pink = Color3.fromRGB(255, 115, 185),
	Teal = Color3.fromRGB(60, 215, 200),
	Grey = Color3.fromRGB(184, 188, 204),
	GreyDark = Color3.fromRGB(120, 124, 145),
	Gold = Color3.fromRGB(255, 205, 50),
}

local function makeFont(weight)
	local ok, font = pcall(function()
		return Font.new(Font.fromEnum(Enum.Font.Nunito).Family, weight)
	end)
	if ok then
		return font
	end
	return Font.fromEnum(Enum.Font.GothamBold)
end

Kit.Font = makeFont(Enum.FontWeight.Heavy)
Kit.FontBold = makeFont(Enum.FontWeight.Bold)

-- Создаёт объект: Kit.new("Frame", { Size = …, Parent = … }, { дети })
function Kit.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.Darken(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount or 0.2)
end

function Kit.Lighten(color, amount)
	return color:Lerp(Color3.new(1, 1, 1), amount or 0.2)
end

function Kit.Tween(instance, duration, props, style, direction, repeatCount, reverses)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out, repeatCount or 0, reverses or false),
		props
	)
	tween:Play()
	return tween
end

function Kit.Corner(parent, radius)
	return Kit.new("UICorner", { CornerRadius = radius or UDim.new(0, 14), Parent = parent })
end

function Kit.Stroke(parent, thickness, color)
	return Kit.new("UIStroke", {
		Color = color or Kit.Colors.Ink,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Kit.Gradient(parent, top, bottom, rotation)
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom or Kit.Darken(top, 0.2)),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

--[[ Надпись с обводкой.
	props: Text, Size, Position, AnchorPoint, Color, Font, Scaled (true), TextSize, MaxTextSize,
	       XAlign, YAlign, Stroke (false — без обводки), StrokeColor, StrokeThickness, ZIndex, Name, Parent, RichText
]]
function Kit.Text(props)
	local label = Kit.new("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		FontFace = props.Font or Kit.Font,
		Text = props.Text or "",
		TextColor3 = props.Color or Kit.Colors.White,
		TextScaled = props.Scaled ~= false,
		TextSize = props.TextSize or 24,
		TextWrapped = true,
		RichText = props.RichText == true,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	if props.Stroke ~= false then
		Kit.new("UIStroke", {
			Color = props.StrokeColor or Kit.Colors.Ink,
			Thickness = props.StrokeThickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	if props.MaxTextSize then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, MinTextSize = 6, Parent = label })
	end
	return label
end

local iconFactory = nil -- задаётся из Icons, чтобы не было кругового require
function Kit.SetIconFactory(factory)
	iconFactory = factory
end

--[[ Мультяшная объёмная кнопка: «лицо» с градиентом и бликом стоит на тёмном «основании»,
	при нажатии опускается вниз.
	props: Size, Position, AnchorPoint, Color, Color2, Text, MaxTextSize, Corner, StrokeThickness, Depth,
	       Icon (имя 3D-иконки или "Coin"), IconColor, IconScale, ZIndex, Name, LayoutOrder, Parent, OnClick,
	       Sound ("Button" по умолчанию, false — без звука)
	Возвращает button (принимает нажатия), label, gradient.
]]
function Kit.Button(props)
	local zIndex = props.ZIndex or 1
	local depth = props.Depth or 5
	local corner = props.Corner or UDim.new(0, 14)
	local color = props.Color or Kit.Colors.Green
	local button = Kit.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = zIndex,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	local scale = Kit.new("UIScale", { Parent = button })

	local base = Kit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Kit.Darken(props.Color2 or color, 0.35),
		Size = UDim2.new(1, 0, 1, -depth),
		Position = UDim2.fromOffset(0, depth),
		ZIndex = zIndex,
		Parent = button,
	})
	Kit.Corner(base, corner)
	Kit.Stroke(base, props.StrokeThickness or 3)

	local face = Kit.new("Frame", {
		Name = "Face",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 1, -depth),
		ZIndex = zIndex + 1,
		Parent = button,
	})
	Kit.Corner(face, corner)
	Kit.Stroke(face, props.StrokeThickness or 3)
	local gradient = Kit.Gradient(face, Kit.Lighten(color, 0.12), props.Color2 or Kit.Darken(color, 0.18))

	local shine = Kit.new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.72,
		Size = UDim2.new(1, -12, 0.42, -4),
		Position = UDim2.new(0, 6, 0, 4),
		ZIndex = zIndex + 1,
		Parent = face,
	})
	Kit.Corner(shine, corner)

	local labelX, labelWidth = 7, -14
	if props.Icon then
		local iconSize = props.IconScale or 0.78
		local holder = Kit.new("Frame", {
			Name = "IconHolder",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 6, 0.5, 0),
			Size = UDim2.new(iconSize, 0, iconSize, 0),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			ZIndex = zIndex + 2,
			Parent = face,
		})
		if props.Icon == "Coin" then
			if iconFactory then
				iconFactory.Coin2D(holder, { Size = UDim2.fromScale(1, 1), ZIndex = zIndex + 2 })
			end
		elseif iconFactory then
			iconFactory.Create(holder, props.Icon, { Size = UDim2.fromScale(1, 1), ZIndex = zIndex + 2, Color = props.IconColor })
		end
		local height = 1
		if props.Size and props.Size.Y.Offset > 0 then
			height = props.Size.Y.Offset - depth
		end
		labelX = math.floor(height * iconSize) + 10
		labelWidth = -labelX - 8
	end

	local label = Kit.Text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, labelWidth, 1, -8),
		Position = UDim2.new(0, labelX, 0, 4),
		MaxTextSize = props.MaxTextSize or 30,
		StrokeThickness = props.TextStroke or 2.5,
		ZIndex = zIndex + 3,
		Parent = face,
	})
	label:SetAttribute("IconX", labelX)

	local function press(down)
		face.Position = UDim2.fromOffset(0, down and math.floor(depth * 0.7) or 0)
	end
	button.MouseEnter:Connect(function()
		Kit.Tween(scale, 0.1, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		press(false)
		Kit.Tween(scale, 0.1, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		press(true)
		Kit.Tween(scale, 0.06, { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		press(false)
		Kit.Tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if props.Sound ~= false then
			Sounds.Play(props.Sound or "Button")
		end
		if props.OnClick then
			props.OnClick()
		end
	end)

	return button, label, gradient
end

-- Перекрасить кнопку (лицо и основание).
function Kit.SetButtonColor(gradient, color, color2)
	gradient.Color = ColorSequence.new(Kit.Lighten(color, 0.12), color2 or Kit.Darken(color, 0.18))
	local face = gradient.Parent
	local button = face and face.Parent
	local base = button and button:FindFirstChild("Shadow")
	if base then
		base.BackgroundColor3 = Kit.Darken(color2 or color, 0.35)
	end
end

-- Показать / спрятать иконку кнопки; без иконки надпись занимает всю ширину.
function Kit.SetButtonIcon(button, visible)
	local face = button:FindFirstChild("Face")
	local holder = face and face:FindFirstChild("IconHolder")
	local label = face and face:FindFirstChild("Label")
	if not holder or not label then
		return
	end
	holder.Visible = visible
	local x = visible and (label:GetAttribute("IconX") or 7) or 7
	label.Position = UDim2.new(0, x, 0, 4)
	label.Size = UDim2.new(1, -x - (visible and 8 or 7), 1, -8)
end

-- Полоса прогресса. Возвращает рамку и функцию set(доля 0..1, цвет?).
function Kit.ProgressBar(props)
	local bar = Kit.new("Frame", {
		Name = props.Name or "Bar",
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.2,
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	Kit.Corner(bar, UDim.new(0.5, 0))
	Kit.Stroke(bar, 2)
	local fill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(0, 1),
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = bar,
	})
	Kit.Corner(fill, UDim.new(0.5, 0))
	local gradient = Kit.Gradient(fill, props.Color or Kit.Colors.Green)
	local gloss = Kit.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		Size = UDim2.new(1, -6, 0.35, 0),
		Position = UDim2.new(0, 3, 0.12, 0),
		ZIndex = (props.ZIndex or 1) + 2,
		Parent = fill,
	})
	Kit.Corner(gloss, UDim.new(0.5, 0))
	local function set(fraction, color)
		fraction = math.clamp(fraction, 0, 1)
		Kit.Tween(fill, 0.15, { Size = UDim2.fromScale(fraction, 1) })
		fill.Visible = fraction > 0.001
		if color then
			gradient.Color = ColorSequence.new(Kit.Lighten(color, 0.15), Kit.Darken(color, 0.15))
		end
	end
	return bar, set
end

-- Узор в горошек (для фона окон). Рамка обрезает кружки по краям.
function Kit.Dots(parent, color, transparency, spacing, zIndex)
	local holder = Kit.new("Frame", {
		Name = "Dots",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	spacing = spacing or 64
	for row = 0, 10 do
		for column = 0, 15 do
			local dot = Kit.new("Frame", {
				BackgroundColor3 = color,
				BackgroundTransparency = transparency or 0.85,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(column * spacing + (row % 2) * spacing / 2, row * spacing * 0.85),
				Size = UDim2.fromOffset(12, 12),
				ZIndex = zIndex or 1,
				Parent = holder,
			})
			Kit.Corner(dot, UDim.new(0.5, 0))
		end
	end
	return holder
end

-- Бегущий блик по объекту (для дорогих карточек и золотых питомцев).
function Kit.Shimmer(guiObject, period, zIndex)
	local overlay = Kit.new("Frame", {
		Name = "Shimmer",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex or (guiObject.ZIndex + 1),
		Parent = guiObject,
	})
	local corner = guiObject:FindFirstChildOfClass("UICorner")
	if corner then
		Kit.Corner(overlay, corner.CornerRadius)
	end
	local gradient = Kit.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = 25,
		Offset = Vector2.new(-1, 0),
		Parent = overlay,
	})
	Kit.Tween(gradient, period or 2.5, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1)
	return overlay
end

-- Короткое «подпрыгивание» объекта (через его UIScale).
function Kit.Pop(guiObject, amount)
	local scale = guiObject:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Kit.new("UIScale", { Parent = guiObject })
	end
	scale.Scale = amount or 1.15
	Kit.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Корневая рамка с UIScale: внутри неё всё задаётся в дизайн-пикселях.
function Kit.CreateScaledRoot(screenGui, name)
	local root = Kit.new("Frame", {
		Name = name or "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = screenGui,
	})
	local uiScale = Kit.new("UIScale", { Parent = root })
	local function update()
		local size = screenGui.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local scale = math.clamp(math.min(size.X / Kit.DesignSize.X, size.Y / Kit.DesignSize.Y), 0.45, 1.4)
		uiScale.Scale = scale
		root.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
		Kit.Scale = scale
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
	return root
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications — всплывающие сообщения под счётчиками, с 3D-значком вида сообщения.
	Notifications.Show(текст, вид) — вид: "info" | "success" | "warning" | "error" | "reward"
]]

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Sounds = require(UI.Parent.Sounds)

local Notifications = {}

local container = nil
local order = 0

local KINDS = {
	info = { Color = Kit.Colors.Blue, Icon = "Exclamation", IconColor = Color3.fromRGB(255, 255, 255) },
	success = { Color = Kit.Colors.Green, Icon = "Check", IconColor = Color3.fromRGB(255, 255, 255) },
	warning = { Color = Kit.Colors.Orange, Icon = "Exclamation", IconColor = Color3.fromRGB(255, 240, 120) },
	error = { Color = Kit.Colors.Red, Icon = "Cross", IconColor = Color3.fromRGB(255, 255, 255) },
	reward = { Color = Kit.Colors.Gold, Icon = "Coin" },
}

function Notifications.Init(root)
	container = Kit.new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 116),
		Size = UDim2.fromOffset(580, 260),
		ZIndex = 40,
		Parent = root,
	})
	Kit.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = container,
	})
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	local style = KINDS[kind] or KINDS.info
	order += 1

	-- Не больше 4 сообщений одновременно.
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #toasts - 3 do
		toasts[index]:Destroy()
	end

	local toast = Kit.new("Frame", {
		Name = "Toast",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(560, 52),
		LayoutOrder = order,
		ZIndex = 41,
		Parent = container,
	})
	Kit.Corner(toast, UDim.new(0.5, 0))
	local stroke = Kit.Stroke(toast, 3.5)
	local gradient = Kit.Gradient(toast, Kit.Colors.Panel, Kit.Lighten(style.Color, 0.6))
	local scale = Kit.new("UIScale", { Scale = 0.5, Parent = toast })

	local badge = Kit.new("Frame", {
		BackgroundColor3 = style.Color,
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.new(0, -10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 42,
		Parent = toast,
	})
	Kit.Corner(badge, UDim.new(0.5, 0))
	Kit.Stroke(badge, 3.5)
	local icon = Icons.Create(badge, style.Icon, {
		Size = UDim2.fromScale(0.9, 0.9),
		Position = UDim2.fromScale(0.05, 0.05),
		ZIndex = 43,
		Color = style.IconColor,
	})
	local label = Kit.Text({
		Text = text,
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, -78, 1, -10),
		Position = UDim2.fromOffset(62, 5),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		ZIndex = 42,
		Parent = toast,
	})

	Kit.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	if kind == "error" then
		Sounds.Play("Error")
	end

	task.delay(3.6, function()
		if not toast.Parent then
			return
		end
		Kit.Tween(toast, 0.3, { BackgroundTransparency = 1 })
		Kit.Tween(label, 0.3, { TextTransparency = 1 })
		Kit.Tween(badge, 0.3, { BackgroundTransparency = 1 })
		Kit.Tween(stroke, 0.3, { Transparency = 1 })
		Kit.Tween(scale, 0.3, { Scale = 0.8 })
		icon.Visible = false
		gradient.Enabled = false
		task.wait(0.3)
		toast:Destroy()
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--[[
	Panels — окна (Питомцы, Магазин, Перерождение, Миры).
	Одновременно открыто только одно окно; нажатие мимо окна его закрывает.
	Оформление: тень, градиентный фон в горошек, шапка-лента с 3D-иконкой, круглая кнопка закрытия.
]]

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local Panels = {}

local layer = nil
local dim = nil
local registry = {}
local current = nil

function Panels.Init(root)
	layer = Kit.new("Frame", {
		Name = "PanelLayer",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = root,
	})
	dim = Kit.new("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(20, 12, 40),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 1,
		Parent = layer,
	})
	dim.Activated:Connect(function()
		Panels.Close()
	end)
end

--[[ Создаёт окно. Возвращает таблицу:
	Frame   — окно целиком (его показывают/прячут)
	Header  — шапка (можно добавить свои кнопки)
	Content — место для содержимого
	OnOpen  — функция, которую можно задать: вызывается при каждом открытии
]]
function Panels.Create(name, title, size, color, iconName)
	local holder = Kit.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 2),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 2,
		Parent = layer,
	})
	local scale = Kit.new("UIScale", { Parent = holder })

	local shadow = Kit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Color3.fromRGB(10, 5, 25),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 10),
		ZIndex = 2,
		Parent = holder,
	})
	Kit.Corner(shadow, UDim.new(0, 28))

	local body = Kit.new("Frame", {
		Name = "Body",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = holder,
	})
	Kit.Corner(body, UDim.new(0, 28))
	Kit.Stroke(body, 5)
	Kit.Gradient(body, Kit.Colors.Panel, Kit.Colors.PanelDark)
	local dots = Kit.Dots(body, Kit.Lighten(color, 0.2), 0.82, 64, 3)
	dots.Position = UDim2.fromOffset(14, 14)
	dots.Size = UDim2.new(1, -28, 1, -28)

	-- Шапка-лента.
	local header = Kit.new("Frame", {
		Name = "Header",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 58),
		ZIndex = 5,
		Parent = body,
	})
	Kit.Corner(header, UDim.new(0, 20))
	Kit.Stroke(header, 4)
	Kit.Gradient(header, Kit.Lighten(color, 0.15), Kit.Darken(color, 0.22))
	local gloss = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.75,
		Size = UDim2.new(1, -16, 0.42, 0),
		Position = UDim2.fromOffset(8, 4),
		ZIndex = 5,
		Parent = header,
	})
	Kit.Corner(gloss, UDim.new(0, 14))

	-- Большая иконка, выступающая за край шапки.
	local titleX = 18
	if iconName then
		local iconHolder = Kit.new("Frame", {
			Name = "TitleIcon",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, -14, 0.5, -6),
			Size = UDim2.fromOffset(84, 84),
			ZIndex = 8,
			Parent = header,
		})
		Icons.Create(iconHolder, iconName, { Size = UDim2.fromScale(1, 1), ZIndex = 8, Animate = "Bob" })
		titleX = 78
	end

	Kit.Text({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -titleX - 70, 1, -12),
		Position = UDim2.fromOffset(titleX, 6),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 36,
		StrokeThickness = 3.5,
		ZIndex = 7,
		Parent = header,
	})

	local close = Kit.Button({
		Name = "Close",
		Size = UDim2.fromOffset(54, 58),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 14, 0, 0),
		Color = Kit.Colors.Red,
		Corner = UDim.new(0.5, 0),
		StrokeThickness = 3.5,
		ZIndex = 9,
		Parent = header,
		OnClick = function()
			Panels.Close()
		end,
	})
	Icons.Glyph(close.Face, "Close", { Size = UDim2.fromScale(0.5, 0.5), ZIndex = 13 })

	local content = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 80),
		Size = UDim2.new(1, -36, 1, -96),
		ZIndex = 5,
		Parent = body,
	})

	local panel = {
		Name = name,
		Frame = holder,
		Body = body,
		Header = header,
		Content = content,
		Scale = scale,
		OnOpen = nil,
		OnClose = nil,
	}
	registry[name] = panel
	return panel
end

function Panels.Open(name)
	local panel = registry[name]
	if not panel then
		return
	end
	if current and current ~= panel then
		current.Frame.Visible = false
		if current.OnClose then
			task.spawn(current.OnClose)
		end
	end
	current = panel

	dim.Visible = true
	Kit.Tween(dim, 0.2, { BackgroundTransparency = 0.4 })
	panel.Frame.Visible = true
	panel.Scale.Scale = 0.6
	Kit.Tween(panel.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	if panel.OnOpen then
		task.spawn(panel.OnOpen)
	end
end

function Panels.Close()
	local panel = current
	if not panel then
		return
	end
	current = nil
	if panel.OnClose then
		task.spawn(panel.OnClose)
	end
	local tween = Kit.Tween(panel.Scale, 0.14, { Scale = 0.75 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween.Completed:Once(function()
		if current ~= panel then
			panel.Frame.Visible = false
		end
	end)
	local dimTween = Kit.Tween(dim, 0.15, { BackgroundTransparency = 1 })
	dimTween.Completed:Once(function()
		if not current then
			dim.Visible = false
		end
	end)
end

function Panels.Toggle(name)
	if current and current.Name == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.IsOpen(name)
	return current ~= nil and current.Name == name
end

function Panels.AnyOpen()
	return current ~= nil
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">PetsPanel</string>
              <string name="Source"><![CDATA[--[[
	PetsPanel — инвентарь питомцев.
	Слева сетка карточек с 3D-портретами питомцев (рисуются только видимые — так быстрее),
	справа большое 3D-превью выбранного и кнопки: Экипировать / Снять, В золото (5 одинаковых → 1 золотой),
	Удалить (с подтверждением). В шапке — «Экипировать лучших».
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Pets = require(Shared.Config.Pets)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)
local Sounds = require(UI.Parent.Sounds)

local PetsPanel = {}

local selectedUid = nil
local selectFromOutside = nil

local CARD_SIZE = Vector2.new(92, 112)
local MAX_VIEWS = 45

function PetsPanel.Select(uid)
	selectedUid = uid
	if selectFromOutside then
		selectFromOutside()
	end
end

function PetsPanel.Create()
	local panel = Panels.Create("Pets", "ПИТОМЦЫ", Vector2.new(860, 510), Kit.Colors.Green, "Paw")
	local content = panel.Content

	local busy = false
	local function act(action, uid, quietSuccess)
		if busy then
			return false
		end
		busy = true
		local ok, message = State.Invoke(Remotes.PetAction, action, uid)
		busy = false
		if message and (not ok or not quietSuccess) then
			Notifications.Show(message, ok and "success" or "error")
		end
		return ok
	end

	Kit.Button({
		Name = "EquipBest",
		Text = "Экипировать лучших",
		Size = UDim2.fromOffset(270, 50),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -54, 0.5, 0),
		Color = Kit.Colors.Yellow,
		Icon = "Star",
		MaxTextSize = 20,
		ZIndex = 9,
		Parent = panel.Header,
		OnClick = function()
			task.spawn(act, "EquipBest", nil, false)
		end,
	})

	------------------------------------------------------------------ ИНФО-ПОЛОСА
	local infoBar = Kit.new("Frame", {
		Name = "InfoBar",
		Size = UDim2.new(1, -306, 0, 38),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.1,
		ZIndex = 6,
		Parent = content,
	})
	Kit.Corner(infoBar, UDim.new(0.5, 0))
	local countLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(0.34, 0, 1, -8),
		Position = UDim2.new(0, 14, 0, 4),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		ZIndex = 7,
		Parent = infoBar,
	})
	local slotsHolder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.34, 0, 1, -12),
		Position = UDim2.new(0.34, 0, 0, 6),
		ZIndex = 7,
		Parent = infoBar,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 5),
		Parent = slotsHolder,
	})
	local bonusLabel = Kit.Text({
		Text = "",
		Color = Kit.Colors.Yellow,
		Size = UDim2.new(0.3, -12, 1, -8),
		Position = UDim2.new(0.7, 0, 0, 4),
		XAlign = Enum.TextXAlignment.Right,
		MaxTextSize = 19,
		ZIndex = 7,
		Parent = infoBar,
	})

	------------------------------------------------------------------ СЕТКА
	local grid = Kit.new("ScrollingFrame", {
		Name = "Grid",
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, -306, 1, -46),
		BackgroundColor3 = Kit.Colors.PanelDeep,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.Colors.Ink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 5,
		Parent = content,
	})
	Kit.Corner(grid, UDim.new(0, 18))
	Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 14),
		Parent = grid,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(CARD_SIZE.X, CARD_SIZE.Y),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	local empty = Kit.new("Frame", {
		Name = "Empty",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -306, 1, -46),
		Position = UDim2.fromOffset(0, 46),
		Visible = false,
		ZIndex = 7,
		Parent = content,
	})
	Icons.Create(empty, "Egg", { Size = UDim2.fromOffset(120, 120), Position = UDim2.new(0.5, 0, 0.32, 0), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 8, Animate = "Swing" })
	Kit.Text({
		Text = "Пока пусто! Подойди к яйцу и открой его за монеты",
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Size = UDim2.new(1, -40, 0, 60),
		Position = UDim2.new(0, 20, 0.58, 0),
		MaxTextSize = 24,
		ZIndex = 8,
		Parent = empty,
	})

	------------------------------------------------------------------ ПРАВАЯ ЧАСТЬ
	local details = Kit.new("Frame", {
		Name = "Details",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 294, 1, 0),
		BackgroundColor3 = Kit.Colors.PanelDeep,
		BackgroundTransparency = 0.35,
		ZIndex = 5,
		Parent = content,
	})
	Kit.Corner(details, UDim.new(0, 20))

	local stage = Kit.new("Frame", {
		Name = "Stage",
		Size = UDim2.new(1, -16, 0, 150),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
		Parent = details,
	})
	Kit.Corner(stage, UDim.new(0, 16))
	Kit.Stroke(stage, 3)
	local stageGradient = Kit.Gradient(stage, Color3.new(1, 1, 1), Color3.new(0.8, 0.8, 0.8))
	local previewHolder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = stage })
	local preview = nil

	local nameLabel = Kit.Text({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 162), MaxTextSize = 25, StrokeThickness = 3, ZIndex = 6, Parent = details })
	local rarityPill = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 194),
		Size = UDim2.fromOffset(170, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
		Parent = details,
	})
	Kit.Corner(rarityPill, UDim.new(0.5, 0))
	Kit.Stroke(rarityPill, 2.5)
	local rarityLabel = Kit.Text({ Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), MaxTextSize = 18, ZIndex = 7, Parent = rarityPill })
	local multiplierLabel = Kit.Text({ Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 222), MaxTextSize = 22, Color = Kit.Colors.Yellow, StrokeThickness = 2.5, ZIndex = 6, Parent = details })
	local hint = Kit.Text({
		Text = "Выбери питомца в списке",
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Size = UDim2.new(1, -24, 0, 80),
		Position = UDim2.fromOffset(12, 160),
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = details,
	})

	local deleteArmed = false
	local deleteArmedAt = 0
	local refreshDetails -- объявлена ниже

	local equipButton, equipLabel, equipGradient = Kit.Button({
		Name = "Equip",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 254),
		Color = Kit.Colors.Green,
		Icon = "Check",
		IconScale = 0.66,
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if pet then
				task.spawn(act, pet.Equipped and "Unequip" or "Equip", pet.Uid, true)
			end
		end,
	})
	local equipIconHolder = equipButton.Face:FindFirstChild("IconHolder")
	local unequipIcon = Icons.Create(equipIconHolder, "Cross", { Size = UDim2.fromScale(1, 1), ZIndex = 8 })
	unequipIcon.Visible = false
	local equipIcon = equipIconHolder:FindFirstChildWhichIsA("ViewportFrame")

	local mergeButton, mergeLabel, mergeGradient = Kit.Button({
		Name = "Merge",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 310),
		Color = Kit.Colors.Gold,
		Icon = "Sparkle",
		IconScale = 0.66,
		MaxTextSize = 21,
		ZIndex = 6,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if pet then
				task.spawn(act, "Merge", pet.Uid, false)
			end
		end,
	})

	local deleteButton, deleteLabel, deleteGradient = Kit.Button({
		Name = "Delete",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 366),
		Color = Kit.Colors.Red,
		Icon = "Trash",
		IconScale = 0.66,
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if not pet then
				return
			end
			if not deleteArmed then
				-- Первое нажатие — просим подтвердить.
				deleteArmed = true
				deleteArmedAt = os.clock()
				refreshDetails()
				task.delay(3, function()
					if deleteArmed and os.clock() - deleteArmedAt >= 2.9 then
						deleteArmed = false
						refreshDetails()
					end
				end)
			else
				deleteArmed = false
				task.spawn(act, "Delete", pet.Uid, false)
			end
		end,
	})

	------------------------------------------------------------------ КАРТОЧКИ
	local cards = {} -- [uid] = { Card, Stroke, Scale, Golden, Pet, View }
	local viewCount = 0

	local function highlightSelection()
		for uid, item in pairs(cards) do
			local selected = uid == selectedUid
			item.Stroke.Color = selected and Kit.Colors.White or (item.Golden and Kit.Colors.Gold or Kit.Colors.Ink)
			item.Stroke.Thickness = selected and 5 or (item.Golden and 4.5 or 3)
			item.Scale.Scale = selected and 1.06 or 1
		end
	end

	-- Создаёт 3D-портреты только для карточек в видимой части списка.
	local function updateViews()
		local top = grid.AbsolutePosition.Y - CARD_SIZE.Y * 2
		local bottom = grid.AbsolutePosition.Y + grid.AbsoluteSize.Y + CARD_SIZE.Y * 2
		for _, item in pairs(cards) do
			local y = item.Card.AbsolutePosition.Y
			local visible = y + item.Card.AbsoluteSize.Y >= top and y <= bottom
			if visible and not item.View and viewCount < MAX_VIEWS then
				local _, view = Icons.Pet(item.Card, item.Pet.Id, item.Pet.Golden, {
					Size = UDim2.new(1, -6, 0.7, 0),
					Position = UDim2.fromOffset(3, 4),
					ZIndex = 5,
					Outline = 0.1,
				})
				item.View = view
				viewCount += 1
			elseif not visible and item.View then
				item.View:Destroy()
				item.View = nil
				viewCount -= 1
			end
		end
	end

	local viewsQueued = false
	local function queueUpdateViews()
		if viewsQueued then
			return
		end
		viewsQueued = true
		task.defer(function()
			viewsQueued = false
			updateViews()
		end)
	end
	grid:GetPropertyChangedSignal("CanvasPosition"):Connect(queueUpdateViews)

	local function makeCard(pet, order)
		local config = Pets[pet.Id]
		local rarity = Rarities[config.Rarity]
		local card = Kit.new("TextButton", {
			Name = "Pet" .. pet.Uid,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = order,
			ZIndex = 4,
			Parent = grid,
		})
		Kit.Corner(card, UDim.new(0, 16))
		local stroke = Kit.Stroke(card, pet.Golden and 4.5 or 3, pet.Golden and Kit.Colors.Gold or Kit.Colors.Ink)
		local topColor = pet.Golden and Color3.fromRGB(255, 240, 150) or Kit.Lighten(rarity.Color, 0.45)
		local bottomColor = pet.Golden and Color3.fromRGB(255, 170, 30) or Kit.Darken(rarity.Color, 0.1)
		Kit.Gradient(card, topColor, bottomColor)
		local scale = Kit.new("UIScale", { Parent = card })

		Kit.Text({
			Text = Format.Multiplier(Formulas.PetMultiplier(pet.Id, pet.Golden)),
			Size = UDim2.new(1, -6, 0.24, 0),
			Position = UDim2.new(0, 3, 0.74, 0),
			MaxTextSize = 20,
			StrokeThickness = 2.5,
			ZIndex = 6,
			Parent = card,
		})
		if pet.Equipped then
			local badge = Kit.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -8, 0, 8),
				Size = UDim2.fromOffset(28, 28),
				BackgroundColor3 = Kit.Colors.Green,
				ZIndex = 7,
				Parent = card,
			})
			Kit.Corner(badge, UDim.new(0.5, 0))
			Kit.Stroke(badge, 2.5)
			Icons.Glyph(badge, "Check", { Size = UDim2.fromScale(0.7, 0.7), ZIndex = 8 })
		end
		if pet.Golden then
			Kit.Shimmer(card, 2.4, 6)
			local goldBadge = Kit.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.fromOffset(28, 18),
				BackgroundColor3 = Kit.Colors.Gold,
				ZIndex = 7,
				Parent = card,
			})
			Kit.Corner(goldBadge, UDim.new(0.5, 0))
			Kit.Stroke(goldBadge, 2)
			Kit.Text({ Text = "G", Size = UDim2.fromScale(0.8, 0.9), Position = UDim2.fromScale(0.1, 0.05), ZIndex = 8, Parent = goldBadge })
		end

		card.Activated:Connect(function()
			Sounds.Play("Button")
			selectedUid = pet.Uid
			deleteArmed = false
			highlightSelection()
			refreshDetails()
		end)

		cards[pet.Uid] = { Card = card, Stroke = stroke, Scale = scale, Golden = pet.Golden, Pet = pet, View = nil }
	end

	local function sortedInventory()
		local list = table.clone(State.Inventory)
		table.sort(list, function(a, b)
			if a.Equipped ~= b.Equipped then
				return a.Equipped
			end
			local ma, mb = Formulas.PetMultiplier(a.Id, a.Golden), Formulas.PetMultiplier(b.Id, b.Golden)
			if ma ~= mb then
				return ma > mb
			end
			return a.Uid < b.Uid
		end)
		return list
	end

	local shownKey = nil
	refreshDetails = function()
		local pet = selectedUid and State.FindPet(selectedUid)
		local hasPet = pet ~= nil
		for _, object in ipairs({ equipButton, mergeButton, deleteButton, nameLabel, rarityPill, multiplierLabel, stage }) do
			object.Visible = hasPet
		end
		hint.Visible = not hasPet
		if not pet then
			shownKey = nil
			if preview then
				preview:Destroy()
				preview = nil
			end
			return
		end

		local config = Pets[pet.Id]
		local rarity = Rarities[config.Rarity]
		local key = pet.Id .. (pet.Golden and ":1" or ":0")
		if shownKey ~= key then
			shownKey = key
			if preview then
				preview:Destroy()
			end
			local _, view = Icons.Pet(previewHolder, pet.Id, pet.Golden, { Size = UDim2.fromScale(1, 1), ZIndex = 8, Animate = "Swing" })
			preview = view
		end
		local tint = pet.Golden and Kit.Colors.Gold or rarity.Color
		stageGradient.Color = ColorSequence.new(Kit.Lighten(tint, 0.7), Kit.Lighten(tint, 0.25))

		nameLabel.Text = (pet.Golden and "Золотой " or "") .. config.Name
		nameLabel.TextColor3 = pet.Golden and Kit.Colors.Gold or Kit.Colors.White
		rarityLabel.Text = Format.Upper(rarity.Name)
		rarityPill.BackgroundColor3 = rarity.Color
		multiplierLabel.Text = Format.Multiplier(Formulas.PetMultiplier(pet.Id, pet.Golden)) .. " к силе за клик"

		if pet.Equipped then
			equipLabel.Text = "Снять"
			Kit.SetButtonColor(equipGradient, Kit.Colors.Orange)
		else
			equipLabel.Text = "Экипировать"
			Kit.SetButtonColor(equipGradient, Kit.Colors.Green)
		end
		if equipIcon then
			equipIcon.Visible = not pet.Equipped
		end
		unequipIcon.Visible = pet.Equipped

		local need = GameConfig.GoldenMergeCount
		if pet.Golden then
			mergeLabel.Text = "Уже золотой"
			Kit.SetButtonColor(mergeGradient, Kit.Colors.Grey)
		else
			local same = 0
			for _, other in ipairs(State.Inventory) do
				if other.Id == pet.Id and not other.Golden then
					same += 1
				end
			end
			mergeLabel.Text = string.format("В золото (%d/%d)", math.min(same, need), need)
			Kit.SetButtonColor(mergeGradient, same >= need and Kit.Colors.Gold or Kit.Colors.Grey)
		end

		if deleteArmed then
			deleteLabel.Text = "Точно удалить?"
			Kit.SetButtonColor(deleteGradient, Kit.Colors.RedDark, Color3.fromRGB(140, 20, 30))
		else
			deleteLabel.Text = "Удалить"
			Kit.SetButtonColor(deleteGradient, Kit.Colors.Red)
		end
	end

	local function refreshInfo()
		countLabel.Text = string.format("Питомцы: %d/%d", #State.Inventory, GameConfig.MaxPets)
		bonusLabel.Text = "Бонус " .. Format.Multiplier(State.Get("PetMultiplier", 1))
		local maxEquipped = State.Get("MaxEquipped", GameConfig.BaseEquipSlots)
		local equipped = State.EquippedCount()
		for _, child in ipairs(slotsHolder:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		for index = 1, maxEquipped do
			local slot = Kit.new("Frame", {
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = index <= equipped and Kit.Colors.Green or Kit.Colors.GreyDark,
				LayoutOrder = index,
				ZIndex = 8,
				Parent = slotsHolder,
			})
			Kit.Corner(slot, UDim.new(0.5, 0))
			Kit.Stroke(slot, 2, Color3.new(1, 1, 1))
		end
	end

	local dirty = true
	local function rebuild()
		dirty = false
		for _, item in pairs(cards) do
			if item.View then
				item.View:Destroy()
			end
			item.Card:Destroy()
		end
		cards = {}
		viewCount = 0
		local list = sortedInventory()
		for index, pet in ipairs(list) do
			makeCard(pet, index)
		end
		empty.Visible = #list == 0
		if selectedUid and not State.FindPet(selectedUid) then
			selectedUid = nil
			deleteArmed = false
		end
		if not selectedUid and list[1] then
			selectedUid = list[1].Uid
		end
		highlightSelection()
		refreshDetails()
		refreshInfo()
		task.defer(updateViews)
	end

	State.OnInventory(function()
		if panel.Frame.Visible then
			rebuild()
		else
			dirty = true
			refreshInfo()
		end
	end)
	State.Watch({ "MaxEquipped", "PetMultiplier" }, refreshInfo)

	panel.OnOpen = function()
		if dirty then
			rebuild()
		else
			refreshDetails()
			queueUpdateViews()
		end
	end

	selectFromOutside = function()
		deleteArmed = false
		if panel.Frame.Visible then
			highlightSelection()
			refreshDetails()
		end
	end
end

return PetsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Popups</string>
              <string name="Source"><![CDATA[--[[
	Popups — летящие цифры «+N» при кликах, сборе монет и продаже.
	Слой лежит прямо в ScreenGui (без UIScale), поэтому координаты — обычные пиксели экрана.
	Popups.Show(позиция, текст, цвет, размер, withCoin) — withCoin = true добавляет монетку слева.
]]

local Debris = game:GetService("Debris")

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local Popups = {}

local layer = nil
local active = 0
local MAX_ACTIVE = 40

function Popups.Init(screenGui)
	layer = Kit.new("Frame", {
		Name = "Popups",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = screenGui,
	})
end

-- position — Vector2 в пикселях ScreenGui; sizeMultiplier — размер текста (1 = обычный).
function Popups.Show(position, text, color, sizeMultiplier, withCoin)
	if not layer or active >= MAX_ACTIVE then
		return
	end
	active += 1
	sizeMultiplier = sizeMultiplier or 1
	local textSize = math.floor(36 * Kit.Scale * sizeMultiplier)

	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(position.X, position.Y),
		Size = UDim2.fromOffset(textSize * 8, textSize * 1.5),
		Rotation = math.random(-10, 10),
		ZIndex = 51,
		Parent = layer,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, math.floor(textSize * 0.15)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	local coin = nil
	if withCoin then
		coin = Icons.Coin2D(holder, {
			Size = UDim2.fromOffset(textSize * 1.05, textSize * 1.05),
			ZIndex = 52,
			LayoutOrder = 1,
			StrokeThickness = math.max(1.5, 2.5 * Kit.Scale * sizeMultiplier),
		})
	end
	local label = Kit.Text({
		Text = text,
		Color = color or Kit.Colors.Yellow,
		Scaled = false,
		TextSize = textSize,
		StrokeThickness = math.max(2, math.floor(3.5 * Kit.Scale * sizeMultiplier)),
		Size = UDim2.fromOffset(textSize * 0.62 * utf8.len(text) + 8, textSize * 1.3),
		LayoutOrder = 2,
		ZIndex = 52,
		Parent = holder,
	})
	local stroke = label:FindFirstChildOfClass("UIStroke")
	local scale = Kit.new("UIScale", { Scale = 0.3, Parent = holder })

	Kit.Tween(scale, 0.18, { Scale = 1.12 }, Enum.EasingStyle.Back)
	local rise = 75 * Kit.Scale * (0.8 + sizeMultiplier * 0.4)
	Kit.Tween(holder, 0.95, {
		Position = UDim2.fromOffset(position.X + math.random(-24, 24), position.Y - rise),
		Rotation = holder.Rotation * 0.3,
	}, Enum.EasingStyle.Quint)
	task.delay(0.45, function()
		if label.Parent then
			Kit.Tween(label, 0.5, { TextTransparency = 1 })
			if stroke then
				Kit.Tween(stroke, 0.5, { Transparency = 1 })
			end
			if coin then
				Kit.Tween(scale, 0.5, { Scale = 0.6 })
			end
		end
	end)

	task.delay(1, function()
		active -= 1
	end)
	Debris:AddItem(holder, 1.05)
end

-- Цифра около кнопки (над её центром, со случайным смещением).
function Popups.AtGuiObject(guiObject, text, color, sizeMultiplier, withCoin)
	local center = guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2
	local spread = guiObject.AbsoluteSize.X * 0.5
	local position = center + Vector2.new(math.random(-100, 100) / 100 * spread, -guiObject.AbsoluteSize.Y * 0.6 + math.random(-15, 10))
	Popups.Show(position, text, color, sizeMultiplier, withCoin)
end

-- Крупная надпись по центру экрана.
function Popups.Center(text, color, sizeMultiplier, withCoin)
	if not layer then
		return
	end
	local size = layer.AbsoluteSize
	Popups.Show(Vector2.new(size.X / 2, size.Y * 0.42), text, color, sizeMultiplier or 1.8, withCoin)
end

return Popups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">RebirthPanel</string>
              <string name="Source"><![CDATA[--[[
	RebirthPanel — перерождение: текущий и следующий множитель, прогресс до перерождения,
	что сбросится и что останется. Кнопку нужно нажать дважды (подтверждение).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local RebirthPanel = {}

-- Плашка «что сбросится / останется» с тремя иконками.
local function makeChip(parent, title, color, iconNames, order, position)
	local chip = Kit.new("Frame", {
		Size = UDim2.new(0.5, -8, 0, 104),
		Position = position,
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		ZIndex = 6,
		Parent = parent,
	})
	Kit.Corner(chip, UDim.new(0, 18))
	Kit.Stroke(chip, 3)
	Kit.Gradient(chip, Kit.Lighten(color, 0.55), Kit.Lighten(color, 0.2))
	Kit.Text({ Text = title, Color = Kit.Darken(color, 0.4), Stroke = false, Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 4), MaxTextSize = 20, ZIndex = 7, Parent = chip })
	local row = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -12, 0, 68),
		Position = UDim2.fromOffset(6, 30),
		ZIndex = 7,
		Parent = chip,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 4),
		Parent = row,
	})
	for index, iconName in ipairs(iconNames) do
		local holder = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(68, 68), LayoutOrder = index, ZIndex = 7, Parent = row })
		Icons.Create(holder, iconName, { Size = UDim2.fromScale(1, 1), ZIndex = 8 })
	end
	return chip
end

function RebirthPanel.Create()
	local panel = Panels.Create("Rebirth", "ПЕРЕРОЖДЕНИЕ", Vector2.new(580, 500), Kit.Colors.Purple, "Rebirth")
	local content = panel.Content

	-- Множитель: x1 → x1.5
	local multiplierBox = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 92),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.1,
		ZIndex = 6,
		Parent = content,
	})
	Kit.Corner(multiplierBox, UDim.new(0, 20))
	Icons.Create(multiplierBox, "Rebirth", {
		Size = UDim2.fromOffset(96, 96),
		Position = UDim2.new(0, -6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 8,
		Animate = "Spin",
		Speed = 1.5,
		Color = Color3.fromRGB(200, 150, 255),
	})
	local currentLabel = Kit.Text({ Text = "", Size = UDim2.new(0.3, 0, 0, 54), Position = UDim2.new(0.2, 0, 0, 8), MaxTextSize = 46, StrokeThickness = 3, ZIndex = 7, Parent = multiplierBox })
	Icons.Glyph(multiplierBox, "Arrow", { Size = UDim2.fromOffset(46, 40), Position = UDim2.new(0.56, 0, 0, 36), ZIndex = 8, Color = Kit.Colors.Yellow })
	local nextLabel = Kit.Text({ Text = "", Color = Kit.Colors.Yellow, Size = UDim2.new(0.3, 0, 0, 54), Position = UDim2.new(0.64, 0, 0, 8), MaxTextSize = 46, StrokeThickness = 3, ZIndex = 7, Parent = multiplierBox })
	Kit.Text({
		Text = "постоянный бонус к силе за каждый клик",
		Color = Color3.fromRGB(210, 200, 240),
		Font = Kit.FontBold,
		Size = UDim2.new(0.8, 0, 0, 22),
		Position = UDim2.new(0.18, 0, 0, 62),
		MaxTextSize = 17,
		Stroke = false,
		ZIndex = 7,
		Parent = multiplierBox,
	})

	local requirementLabel = Kit.Text({
		Text = "",
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 100),
		MaxTextSize = 22,
		ZIndex = 6,
		Parent = content,
	})
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -60, 0, 34),
		Position = UDim2.fromOffset(46, 130),
		Color = Kit.Colors.Purple,
		ZIndex = 6,
		Parent = content,
	})
	Icons.Create(content, "Star", { Size = UDim2.fromOffset(54, 54), Position = UDim2.fromOffset(0, 120), ZIndex = 9 })
	local progressLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.fromOffset(5, 0),
		MaxTextSize = 22,
		ZIndex = 10,
		Parent = bar,
	})

	makeChip(content, "Сбросится", Kit.Colors.Red, { "Dumbbell", "Star", "Coin" }, 1, UDim2.fromOffset(0, 176))
	makeChip(content, "Останется", Kit.Colors.Green, { "Paw", "Backpack", "Globe" }, 2, UDim2.new(0.5, 8, 0, 176))

	local armed = false
	local armedAt = 0
	local busy = false
	local refresh -- объявлена ниже

	local _, buttonLabel, buttonGradient = Kit.Button({
		Name = "RebirthButton",
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.new(0, 20, 1, -76),
		Color = Kit.Colors.Purple,
		Icon = "Rebirth",
		IconColor = Color3.fromRGB(255, 255, 255),
		MaxTextSize = 30,
		StrokeThickness = 4,
		Depth = 7,
		ZIndex = 6,
		Parent = content,
		OnClick = function()
			if busy then
				return
			end
			local total = State.Get("TotalStrength", 0)
			local cost = Formulas.RebirthCost(State.Get("Rebirths", 0))
			if total < cost then
				Notifications.Show("Нужно ещё " .. Format.Number(cost - total) .. " накопленной силы", "error")
				return
			end
			if not armed then
				armed = true
				armedAt = os.clock()
				refresh()
				task.delay(3, function()
					if armed and os.clock() - armedAt >= 2.9 then
						armed = false
						refresh()
					end
				end)
				return
			end
			armed = false
			busy = true
			task.spawn(function()
				local ok, message = State.Invoke(Remotes.Rebirth)
				busy = false
				if message then
					Notifications.Show(message, ok and "success" or "error")
				end
				if ok then
					Panels.Close()
				end
				refresh()
			end)
		end,
	})

	refresh = function()
		local rebirths = State.Get("Rebirths", 0)
		local total = State.Get("TotalStrength", 0)
		local cost = Formulas.RebirthCost(rebirths)
		currentLabel.Text = Format.Multiplier(Formulas.RebirthMultiplier(rebirths))
		nextLabel.Text = Format.Multiplier(Formulas.RebirthMultiplier(rebirths + 1))
		requirementLabel.Text = "Нужно " .. Format.Number(cost) .. " накопленной силы"
		local fraction = cost > 0 and total / cost or 1
		setBar(fraction, fraction >= 1 and Kit.Colors.Green or Kit.Colors.Purple)
		progressLabel.Text = Format.Number(math.min(total, cost)) .. " / " .. Format.Number(cost)

		if fraction < 1 then
			armed = false
			buttonLabel.Text = "Копи силу"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Grey)
		elseif armed then
			buttonLabel.Text = "Точно? Нажми ещё раз!"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Orange)
		else
			buttonLabel.Text = "ПЕРЕРОДИТЬСЯ"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Purple)
		end
	end

	State.Watch({ "Rebirths", "TotalStrength" }, refresh)
	panel.OnOpen = function()
		armed = false
		refresh()
	end
end

return RebirthPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--[[
	ShopPanel — магазин.
	Слева вкладки (Рюкзаки / Геймпассы) и кошелёк, справа карточки:
	- рюкзаки: 3D-рюкзак цвета уровня, вместимость с полоской, кнопка с ценой;
	  текущий подсвечен, следующий отмечен лентой «СЛЕДУЮЩИЙ» и бликом, дальние — под замком;
	- геймпасс «+2 слота питомцев»: большая карточка с короной.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Backpacks = require(Shared.Config.Backpacks)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local ShopPanel = {}

local MAX_CAPACITY_LOG = math.log10(Backpacks[#Backpacks].Capacity)

function ShopPanel.Create()
	local panel = Panels.Create("Shop", "МАГАЗИН", Vector2.new(800, 510), Kit.Colors.Yellow, "ShopBag")
	local content = panel.Content

	local busy = false
	local function buy(remote, ...)
		if busy then
			return
		end
		busy = true
		local ok, message = State.Invoke(remote, ...)
		busy = false
		if message then
			Notifications.Show(message, ok and "success" or "error")
		end
	end

	------------------------------------------------------------------ ВКЛАДКИ
	local tabs = Kit.new("Frame", {
		Name = "Tabs",
		BackgroundColor3 = Kit.Colors.PanelDeep,
		BackgroundTransparency = 0.3,
		Size = UDim2.new(0, 150, 1, 0),
		ZIndex = 5,
		Parent = content,
	})
	Kit.Corner(tabs, UDim.new(0, 20))

	local pages = {}
	local tabButtons = {}
	local function selectTab(name)
		for tabName, page in pairs(pages) do
			page.Visible = tabName == name
		end
		for tabName, info in pairs(tabButtons) do
			Kit.SetButtonColor(info.Gradient, tabName == name and info.Color or Kit.Colors.Grey)
		end
	end

	local tabList = {
		{ Name = "Backpacks", Text = "Рюкзаки", Icon = "Backpack", Color = Kit.Colors.Blue },
		{ Name = "Passes", Text = "Геймпассы", Icon = "Crown", Color = Kit.Colors.Purple },
	}
	for index, tab in ipairs(tabList) do
		local button, _, gradient = Kit.Button({
			Name = "Tab" .. tab.Name,
			Size = UDim2.new(1, -16, 0, 104),
			Position = UDim2.fromOffset(8, 8 + (index - 1) * 114),
			Color = tab.Color,
			Corner = UDim.new(0, 18),
			ZIndex = 6,
			Parent = tabs,
			OnClick = function()
				selectTab(tab.Name)
			end,
		})
		Icons.Create(button.Face, tab.Icon, {
			Size = UDim2.fromScale(0.62, 0.62),
			Position = UDim2.fromScale(0.5, 0.04),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 9,
		})
		Kit.Text({ Text = tab.Text, Size = UDim2.new(1, -10, 0.28, 0), Position = UDim2.new(0, 5, 0.66, 0), MaxTextSize = 20, ZIndex = 10, Parent = button.Face })
		tabButtons[tab.Name] = { Gradient = gradient, Color = tab.Color }
	end

	-- Кошелёк.
	local wallet = Kit.new("Frame", {
		Name = "Wallet",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -16, 0, 74),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.15,
		ZIndex = 6,
		Parent = tabs,
	})
	Kit.Corner(wallet, UDim.new(0, 16))
	Kit.Text({ Text = "У тебя", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 6), MaxTextSize = 16, ZIndex = 7, Parent = wallet })
	Icons.Coin2D(wallet, { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(10, 34), ZIndex = 7 })
	local walletValue = Kit.Text({
		Text = "0",
		Color = Kit.Colors.Yellow,
		Size = UDim2.new(1, -50, 0, 30),
		Position = UDim2.fromOffset(44, 33),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		ZIndex = 7,
		Parent = wallet,
	})

	------------------------------------------------------------------ РЮКЗАКИ
	local backpacksPage = Kit.new("ScrollingFrame", {
		Name = "BackpacksPage",
		Position = UDim2.fromOffset(164, 0),
		Size = UDim2.new(1, -164, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.Colors.Ink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 5,
		Parent = content,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 10), Parent = backpacksPage })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(180, 240),
		CellPadding = UDim2.fromOffset(12, 16),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = backpacksPage,
	})
	pages.Backpacks = backpacksPage

	local cards = {}
	for level, backpack in ipairs(Backpacks) do
		local card = Kit.new("Frame", {
			Name = "Backpack" .. level,
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = level,
			ZIndex = 6,
			Parent = backpacksPage,
		})
		Kit.Corner(card, UDim.new(0, 20))
		local stroke = Kit.Stroke(card, 4)
		local gradient = Kit.Gradient(card, Kit.Lighten(backpack.Color, 0.55), Kit.Lighten(backpack.Color, 0.1))

		-- Номер уровня.
		local levelBadge = Kit.new("Frame", {
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.fromOffset(-8, -8),
			BackgroundColor3 = Kit.Colors.Ink,
			ZIndex = 9,
			Parent = card,
		})
		Kit.Corner(levelBadge, UDim.new(0.5, 0))
		Kit.Stroke(levelBadge, 2.5, Color3.new(1, 1, 1))
		Kit.Text({ Text = tostring(level), Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 10, Parent = levelBadge })

		local _, view = Icons.Create(card, "Backpack", {
			Size = UDim2.new(1, -30, 0, 104),
			Position = UDim2.fromOffset(15, 6),
			Color = backpack.Color,
			ZIndex = 7,
		})
		Kit.Text({
			Text = backpack.Name,
			Size = UDim2.new(1, -16, 0, 30),
			Position = UDim2.fromOffset(8, 110),
			MaxTextSize = 19,
			StrokeThickness = 2.5,
			ZIndex = 8,
			Parent = card,
		})
		-- Вместимость.
		local capacityBar, setCapacity = Kit.ProgressBar({
			Size = UDim2.new(1, -24, 0, 22),
			Position = UDim2.fromOffset(12, 144),
			Color = Kit.Colors.Orange,
			ZIndex = 8,
			Parent = card,
		})
		setCapacity(math.log10(backpack.Capacity) / MAX_CAPACITY_LOG, Kit.Colors.Orange)
		Kit.Text({
			Text = Format.Number(backpack.Capacity) .. " силы",
			Size = UDim2.new(1, -10, 1, 0),
			Position = UDim2.fromOffset(5, 0),
			MaxTextSize = 16,
			ZIndex = 12,
			Parent = capacityBar,
		})

		local button, label, buttonGradient = Kit.Button({
			Name = "Buy",
			Size = UDim2.new(1, -20, 0, 52),
			Position = UDim2.new(0, 10, 1, -62),
			Icon = "Coin",
			IconScale = 0.62,
			MaxTextSize = 22,
			ZIndex = 8,
			Parent = card,
			OnClick = function()
				local current = State.Get("BackpackLevel", 1)
				if level == current + 1 then
					task.spawn(buy, Remotes.BuyBackpack, level)
				elseif level > current + 1 then
					Notifications.Show("Сначала купи предыдущий рюкзак", "info")
				end
			end,
		})

		-- Лента «СЛЕДУЮЩИЙ».
		local ribbon = Kit.new("Frame", {
			Name = "Ribbon",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 8, 0, 8),
			Size = UDim2.fromOffset(104, 26),
			BackgroundColor3 = Kit.Colors.Red,
			Rotation = 12,
			Visible = false,
			ZIndex = 11,
			Parent = card,
		})
		Kit.Corner(ribbon, UDim.new(0, 8))
		Kit.Stroke(ribbon, 2.5)
		Kit.Text({ Text = "СЛЕДУЮЩИЙ", Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), MaxTextSize = 15, ZIndex = 12, Parent = ribbon })

		-- Затемнение и замок для недоступных.
		local lockOverlay = Kit.new("Frame", {
			Name = "Locked",
			BackgroundColor3 = Kit.Colors.Ink,
			BackgroundTransparency = 0.55,
			Size = UDim2.new(1, 0, 1, -68),
			Visible = false,
			ZIndex = 9,
			Parent = card,
		})
		Kit.Corner(lockOverlay, UDim.new(0, 20))
		Icons.Create(lockOverlay, "Lock", { Size = UDim2.fromOffset(70, 70), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 10 })

		cards[level] = {
			Card = card,
			Stroke = stroke,
			Gradient = gradient,
			View = view,
			Button = button,
			Label = label,
			ButtonGradient = buttonGradient,
			Ribbon = ribbon,
			Lock = lockOverlay,
			Price = backpack.Price,
			Shimmer = nil,
		}
	end

	------------------------------------------------------------------ ГЕЙМПАССЫ
	local passesPage = Kit.new("Frame", {
		Name = "PassesPage",
		Position = UDim2.fromOffset(164, 0),
		Size = UDim2.new(1, -164, 1, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = content,
	})
	pages.Passes = passesPage

	local passCard = Kit.new("Frame", {
		Name = "PetSlotsPass",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(6, 12),
		Size = UDim2.new(1, -12, 1, -24),
		ZIndex = 6,
		Parent = passesPage,
	})
	Kit.Corner(passCard, UDim.new(0, 26))
	Kit.Stroke(passCard, 5)
	Kit.Gradient(passCard, Color3.fromRGB(200, 150, 255), Color3.fromRGB(110, 60, 220))
	Kit.Dots(passCard, Color3.new(1, 1, 1), 0.85, 56, 6).Size = UDim2.new(1, -24, 1, -24)
	Kit.Shimmer(passCard, 3, 7)

	Icons.Create(passCard, "Crown", {
		Size = UDim2.fromOffset(190, 170),
		Position = UDim2.fromOffset(20, 30),
		ZIndex = 8,
		Animate = "Spin",
		Speed = 0.8,
	})
	Icons.Create(passCard, "Paw", {
		Size = UDim2.fromOffset(90, 90),
		Position = UDim2.fromOffset(150, 150),
		ZIndex = 9,
		Animate = "Bob",
	})
	Kit.Text({
		Text = "+2 СЛОТА ДЛЯ ПИТОМЦЕВ",
		Color = Kit.Colors.Yellow,
		Size = UDim2.new(1, -270, 0, 64),
		Position = UDim2.fromOffset(250, 30),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 34,
		StrokeThickness = 3.5,
		ZIndex = 8,
		Parent = passCard,
	})
	Kit.Text({
		Text = "Надевай " .. GameConfig.GamepassEquipSlots .. " питомцев вместо " .. GameConfig.BaseEquipSlots .. " — больше силы за каждый клик!",
		Size = UDim2.new(1, -270, 0, 70),
		Position = UDim2.fromOffset(250, 100),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		ZIndex = 8,
		Parent = passCard,
	})
	if GameConfig.PetSlotsGamepassId == 0 then
		Kit.Text({
			Text = "Тестовый режим: выдаётся бесплатно",
			Color = Color3.fromRGB(230, 220, 255),
			Font = Kit.FontBold,
			Size = UDim2.new(1, -270, 0, 26),
			Position = UDim2.fromOffset(250, 176),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			ZIndex = 8,
			Parent = passCard,
		})
	end
	local _, passLabel, passGradient = Kit.Button({
		Name = "BuyPass",
		Size = UDim2.new(1, -60, 0, 70),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Color = Kit.Colors.Yellow,
		Icon = "Crown",
		MaxTextSize = 32,
		Depth = 7,
		ZIndex = 9,
		Parent = passCard,
		OnClick = function()
			if State.Get("PetSlotsPass", false) then
				Notifications.Show("Уже куплено", "info")
			else
				task.spawn(buy, Remotes.BuyPetSlots)
			end
		end,
	})

	------------------------------------------------------------------ ОБНОВЛЕНИЕ
	local function refresh()
		local current = State.Get("BackpackLevel", 1)
		local coins = State.Get("Coins", 0)
		walletValue.Text = Format.Number(coins)
		for level, card in pairs(cards) do
			local isNext = level == current + 1
			card.Ribbon.Visible = isNext
			card.Lock.Visible = level > current + 1
			card.Stroke.Color = level == current and Kit.Colors.Blue or (isNext and Kit.Colors.YellowDark or Kit.Colors.Ink)
			card.Stroke.Thickness = (level == current or isNext) and 6 or 4
			card.View.Animate = isNext and "Swing" or nil
			if isNext and not card.Shimmer then
				card.Shimmer = Kit.Shimmer(card.Card, 2.2, 7)
			elseif not isNext and card.Shimmer then
				card.Shimmer:Destroy()
				card.Shimmer = nil
			end
			Kit.SetButtonIcon(card.Button, level > current)
			if level < current then
				card.Label.Text = "КУПЛЕНО"
				Kit.SetButtonColor(card.ButtonGradient, Kit.Colors.Grey)
			elseif level == current then
				card.Label.Text = "НАДЕТ"
				Kit.SetButtonColor(card.ButtonGradient, Kit.Colors.Blue)
			elseif isNext then
				card.Label.Text = Format.Number(card.Price)
				Kit.SetButtonColor(card.ButtonGradient, coins >= card.Price and Kit.Colors.Green or Kit.Colors.Orange)
			else
				card.Label.Text = Format.Number(card.Price)
				Kit.SetButtonColor(card.ButtonGradient, Kit.Colors.Grey)
			end
		end

		if State.Get("PetSlotsPass", false) then
			passLabel.Text = "УЖЕ ТВОЁ"
			Kit.SetButtonColor(passGradient, Kit.Colors.Grey)
		else
			passLabel.Text = GameConfig.PetSlotsGamepassId == 0 and "ПОЛУЧИТЬ" or "КУПИТЬ"
			Kit.SetButtonColor(passGradient, Kit.Colors.Yellow)
		end
	end

	State.Watch({ "BackpackLevel", "Coins", "PetSlotsPass" }, refresh)
	selectTab("Backpacks")
	panel.OnOpen = function()
		-- Прокрутить к следующему рюкзаку.
		local current = State.Get("BackpackLevel", 1)
		local row = math.floor(math.max(0, current - 1) / 3)
		backpacksPage.CanvasPosition = Vector2.new(0, row * 256)
	end
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Viewport3D</string>
              <string name="Source"><![CDATA[--[[
	Viewport3D — 3D-картинка в интерфейсе (ViewportFrame + камера).
	Используется для иконок, питомцев в карточках, яиц и превью.

	local view = Viewport3D.new(parent, { Size = …, Position = …, Animate = "Swing" | "Spin" | "Bob" | nil })
	view:SetModel(model, { Outline = 0.16, Yaw = 0.3, Pitch = 0.15, Zoom = 1 })
	view:SetTransform(cframe) — повернуть модель вручную (например, тряска яйца)

	Контур (Outline) — мультяшная тёмная обводка: позади каждой детали ставится её
	чуть увеличенная тёмная копия. Копии всегда сдвинуты от камеры (вдоль её взгляда),
	поэтому обводка остаётся сзади, даже когда модель крутится на 360°.
]]

local RunService = game:GetService("RunService")

local UI = script.Parent
local Kit = require(UI.Kit)

local Viewport3D = {}
Viewport3D.__index = Viewport3D

local OUTLINE_COLOR = Color3.fromRGB(35, 30, 60)
local active = {}

local function isShown(guiObject)
	local current = guiObject
	while current and not current:IsA("LayerCollector") do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end
	return current ~= nil and current.Enabled
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for view in pairs(active) do
		if view.Animate and view.Model and view.Model.Parent and isShown(view.Frame) then
			local base = view.Base
			local animation
			if view.Animate == "Spin" then
				animation = CFrame.Angles(0, t * (view.Speed or 1.2) + view.Seed, 0)
			elseif view.Animate == "Bob" then
				animation = CFrame.new(0, math.sin(t * 2 + view.Seed) * 0.08 * view.Radius, 0) * CFrame.Angles(0, math.sin(t * 1.1 + view.Seed) * 0.25, 0)
			else
				animation = CFrame.new(0, math.sin(t * 2.2 + view.Seed) * 0.06 * view.Radius, 0) * CFrame.Angles(0, math.sin(t * 1.3 + view.Seed) * 0.6, 0)
			end
			view.Model:PivotTo(base * animation)
			view:_placeOutlines()
		end
	end
end)

--[[ props: Size, Position, AnchorPoint, ZIndex, BackgroundColor3, BackgroundTransparency (1 по умолчанию),
	Corner, FieldOfView, Animate, Speed, Name, LayoutOrder ]]
function Viewport3D.new(parent, props)
	props = props or {}
	local frame = Kit.new("ViewportFrame", {
		Name = props.Name or "View3D",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.BackgroundColor3 or Color3.new(1, 1, 1),
		BackgroundTransparency = props.BackgroundTransparency or 1,
		Ambient = props.Ambient or Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.55, -0.9, 1),
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = parent,
	})
	if props.Corner then
		Kit.Corner(frame, props.Corner)
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = props.FieldOfView or 30
	camera.Parent = frame
	frame.CurrentCamera = camera

	local view = setmetatable({
		Frame = frame,
		Camera = camera,
		Model = nil,
		Base = CFrame.identity,
		Radius = 1,
		Animate = props.Animate,
		Speed = props.Speed,
		Seed = math.random() * 10,
	}, Viewport3D)
	active[view] = true
	return view
end

-- Возвращает пары { копия, оригинал }.
local function addOutline(model, width)
	local pairsList = {}
	local parts = {}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item.Transparency < 0.5 and not item:GetAttribute("NoOutline") then
			table.insert(parts, item)
		end
	end
	for _, part in ipairs(parts) do
		local copy = part:Clone()
		for _, child in ipairs(copy:GetChildren()) do
			if not child:IsA("DataModelMesh") then
				child:Destroy()
			end
		end
		copy.Name = "Outline"
		copy.Color = OUTLINE_COLOR
		copy.Material = Enum.Material.SmoothPlastic
		copy.Reflectance = 0
		copy.Transparency = 0
		copy.Size = part.Size + Vector3.one * width
		copy.CFrame = part.CFrame
		copy.Parent = model
		table.insert(pairsList, { copy, part })
	end
	return pairsList
end

-- Сдвигает копии-обводки за свои детали — от камеры.
function Viewport3D:_placeOutlines()
	if not self.Outlines then
		return
	end
	local push = self.Camera.CFrame.LookVector * (self.OutlineWidth * 0.9)
	for _, pair in ipairs(self.Outlines) do
		pair[1].CFrame = pair[2].CFrame + push
	end
end

-- options: Outline (толщина или nil), Yaw, Pitch (наклон камеры), Zoom (1 = вписать целиком)
function Viewport3D:SetModel(model, options)
	options = options or {}
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	if not model then
		return
	end
	self.Outlines = nil
	if options.Outline and options.Outline > 0 then
		self.Outlines = addOutline(model, options.Outline)
		self.OutlineWidth = options.Outline
	end
	local boxCFrame, size = model:GetBoundingBox()
	local center = boxCFrame.Position
	local radius = math.max(size.X, size.Y, size.Z) * 0.5
	local fov = math.rad(self.Camera.FieldOfView)
	local distance = radius / math.tan(fov / 2) * 1.08 / (options.Zoom or 1)
	local pitch = options.Pitch or 0.12
	self.Camera.CFrame = CFrame.lookAt(center + Vector3.new(0, distance * pitch, -distance), center)
	self.Base = CFrame.Angles(0, options.Yaw or 0, 0)
	self.Radius = radius
	model:PivotTo(self.Base)
	self:_placeOutlines()
	model.Parent = self.Frame
	self.Model = model
end

function Viewport3D:SetTransform(cframe)
	if self.Model then
		self.Model:PivotTo(self.Base * cframe)
		self:_placeOutlines()
	end
end

function Viewport3D:Destroy()
	active[self] = nil
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	self.Frame:Destroy()
end

return Viewport3D
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">WorldsPanel</string>
              <string name="Source"><![CDATA[--[[
	WorldsPanel — список миров: открыт / можно открыть / сколько силы нужно.
	Отсюда можно телепортироваться в любой открытый мир.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local WorldsPanel = {}

function WorldsPanel.Create()
	local panel = Panels.Create("Worlds", "МИРЫ", Vector2.new(700, 500), Kit.Colors.Blue, "Globe")
	local content = panel.Content

	Kit.new("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	local busy = false
	local rows = {}

	for index, worldId in ipairs(Worlds.Order) do
		local world = Worlds[worldId]
		local row = Kit.new("Frame", {
			Name = worldId,
			Size = UDim2.new(1, 0, 0, 122),
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = index,
			ZIndex = 6,
			Parent = content,
		})
		Kit.Corner(row, UDim.new(0, 22))
		local stroke = Kit.Stroke(row, 4)
		Kit.Gradient(row, Kit.Lighten(world.Color, 0.7), Kit.Lighten(world.Color, 0.35), 0)

		local swatch = Kit.new("Frame", {
			Size = UDim2.fromOffset(104, 104),
			Position = UDim2.new(0, 9, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 7,
			Parent = row,
		})
		Kit.Corner(swatch, UDim.new(0, 20))
		Kit.Stroke(swatch, 3.5)
		Kit.Gradient(swatch, Kit.Lighten(world.Color, 0.25), Kit.Darken(world.Color, 0.25))
		local _, view = Icons.Create(swatch, world.Icon, { Size = UDim2.fromScale(1.05, 1.05), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 8 })

		Kit.Text({
			Text = Format.Upper(world.Name),
			Color = Color3.new(1, 1, 1),
			StrokeThickness = 3,
			Size = UDim2.new(1, -330, 0, 34),
			Position = UDim2.fromOffset(124, 8),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 30,
			ZIndex = 7,
			Parent = row,
		})
		Kit.Text({
			Text = world.Description,
			Color = Kit.Colors.Ink,
			Stroke = false,
			Font = Kit.FontBold,
			Size = UDim2.new(1, -330, 0, 40),
			Position = UDim2.fromOffset(124, 42),
			XAlign = Enum.TextXAlignment.Left,
			YAlign = Enum.TextYAlignment.Top,
			MaxTextSize = 17,
			ZIndex = 7,
			Parent = row,
		})
		-- Характеристики мира с монеткой.
		local stats = Kit.new("Frame", {
			BackgroundColor3 = Kit.Colors.Ink,
			BackgroundTransparency = 0.2,
			Size = UDim2.fromOffset(262, 28),
			Position = UDim2.fromOffset(124, 86),
			ZIndex = 7,
			Parent = row,
		})
		Kit.Corner(stats, UDim.new(0.5, 0))
		Icons.Coin2D(stats, { Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(6, 3), ZIndex = 8 })
		Kit.Text({
			Text = string.format("продажа ×%s  •  монета %s", Format.Number(world.SellMultiplier), Format.Number(world.CoinValue)),
			Size = UDim2.new(1, -40, 1, -6),
			Position = UDim2.fromOffset(34, 3),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 16,
			ZIndex = 8,
			Parent = stats,
		})

		local button, label, gradient = Kit.Button({
			Name = "Go",
			Size = UDim2.fromOffset(190, 66),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Icon = "Portal",
			MaxTextSize = 22,
			Depth = 6,
			ZIndex = 7,
			Parent = row,
			OnClick = function()
				if busy then
					return
				end
				if State.Get("World", "Forest") == worldId then
					Panels.Close()
					return
				end
				busy = true
				task.spawn(function()
					local ok, message = State.Invoke(Remotes.Teleport, worldId)
					busy = false
					if ok then
						Panels.Close()
					elseif message then
						Notifications.Show(message, "error")
					end
				end)
			end,
		})
		local iconHolder = button.Face:FindFirstChild("IconHolder")
		local lockIcon = Icons.Create(iconHolder, "Lock", { Size = UDim2.fromScale(1, 1), ZIndex = 9 })
		rows[worldId] = {
			Button = button,
			Label = label,
			Gradient = gradient,
			Stroke = stroke,
			View = view,
			PortalIcon = iconHolder:FindFirstChildWhichIsA("ViewportFrame"),
			LockIcon = lockIcon,
		}
	end

	local function refresh()
		local unlocked = State.UnlockedWorlds()
		local total = State.Get("TotalStrength", 0)
		local currentWorld = State.Get("World", "Forest")
		for _, worldId in ipairs(Worlds.Order) do
			local world = Worlds[worldId]
			local row = rows[worldId]
			local locked = not unlocked[worldId] and total < world.UnlockStrength
			row.LockIcon.Visible = locked
			if row.PortalIcon then
				row.PortalIcon.Visible = not locked
			end
			row.Stroke.Color = worldId == currentWorld and Kit.Colors.Yellow or Kit.Colors.Ink
			row.Stroke.Thickness = worldId == currentWorld and 6 or 4
			row.View.Animate = worldId == currentWorld and "Swing" or nil
			Kit.SetButtonIcon(row.Button, worldId ~= currentWorld)
			if worldId == currentWorld then
				row.Label.Text = "Ты здесь"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			elseif unlocked[worldId] then
				row.Label.Text = "Телепорт"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Blue)
			elseif not locked then
				row.Label.Text = "Открыть!"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Green)
			else
				row.Label.Text = Format.Number(world.UnlockStrength) .. " силы"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			end
		end
	end

	State.Watch({ "UnlockedWorlds", "TotalStrength", "World" }, refresh)
end

return WorldsPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">WorldEffects</string>
            <string name="Source"><![CDATA[--[[
	WorldEffects — атмосфера миров (только у этого игрока):
	- освещение, дымка, небо, гравитация;
	- пост-эффекты («шейдеры» Roblox): Bloom, ColorCorrection, SunRays, DepthOfField;
	- объёмные облака (Terrain.Clouds) и цвет воды;
	- частицы вокруг камеры: светлячки в лесу, песок в пустыне, звёздная пыль в космосе;
	- крупная надпись с 3D-иконкой при входе в мир и смена музыки;
	- анимации декора: монеты крутятся, детали с тегами Spin/Bob вращаются и покачиваются;
	- таблички порталов показывают, сколько силы ещё нужно именно этому игроку.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)

local Client = script.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local WorldEffects = {}

local atmosphere, sky, clouds = nil, nil, nil
local effects = {}
local ambientPart, ambientEmitter = nil, nil
local banner, bannerScale, bannerText, bannerIcon = nil, nil, nil, nil
local currentWorld = nil

local function getOrCreate(parent, className, name)
	local item = parent:FindFirstChild(name)
	if not item or not item:IsA(className) then
		item = Instance.new(className)
		item.Name = name
		item.Parent = parent
	end
	return item
end

------------------------------------------------------------------ ЧАСТИЦЫ ВОКРУГ КАМЕРЫ
local PARTICLES = {
	Fireflies = {
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(180, 255, 120)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.25), NumberSequenceKeypoint.new(1, 0) }),
		Rate = 14,
		Lifetime = NumberRange.new(4, 7),
		Speed = NumberRange.new(0.3, 1.2),
		LightEmission = 1,
		Acceleration = Vector3.new(0, 0.3, 0),
	},
	Sand = {
		Color = ColorSequence.new(Color3.fromRGB(255, 225, 170), Color3.fromRGB(230, 190, 120)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.35) }),
		Rate = 30,
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(4, 8),
		LightEmission = 0.2,
		Acceleration = Vector3.new(6, -0.5, 2),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.55), NumberSequenceKeypoint.new(1, 1) }),
	},
	Stardust = {
		Color = ColorSequence.new(Color3.fromRGB(200, 220, 255), Color3.fromRGB(230, 160, 255)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 0) }),
		Rate = 22,
		Lifetime = NumberRange.new(3, 6),
		Speed = NumberRange.new(0.2, 0.8),
		LightEmission = 1,
		Acceleration = Vector3.new(0, 0.1, 0),
	},
}

local function setParticles(kind)
	local preset = PARTICLES[kind]
	if not preset then
		ambientEmitter.Enabled = false
		return
	end
	ambientEmitter.Enabled = true
	ambientEmitter.Color = preset.Color
	ambientEmitter.Size = preset.Size
	ambientEmitter.Rate = preset.Rate
	ambientEmitter.Lifetime = preset.Lifetime
	ambientEmitter.Speed = preset.Speed
	ambientEmitter.LightEmission = preset.LightEmission
	ambientEmitter.Acceleration = preset.Acceleration
	ambientEmitter.Transparency = preset.Transparency or NumberSequence.new(0.1)
end

------------------------------------------------------------------ МИР
local function tweenOrSet(instance, goal, duration)
	if duration <= 0 then
		for key, value in pairs(goal) do
			instance[key] = value
		end
	else
		Kit.Tween(instance, duration, goal, Enum.EasingStyle.Sine)
	end
end

local function applyWorld(worldId, instant)
	local world = Worlds[worldId]
	if not world then
		return
	end
	local settings = world.Lighting
	local duration = instant and 0 or 1.4

	tweenOrSet(Lighting, {
		ClockTime = settings.ClockTime,
		Brightness = settings.Brightness,
		Ambient = settings.Ambient,
		OutdoorAmbient = settings.OutdoorAmbient,
		ShadowSoftness = settings.ShadowSoftness or 0.2,
		ExposureCompensation = settings.ExposureCompensation or 0,
	}, duration)
	tweenOrSet(atmosphere, settings.Atmosphere, duration)
	if settings.Bloom then
		tweenOrSet(effects.Bloom, settings.Bloom, duration)
	end
	if settings.ColorCorrection then
		tweenOrSet(effects.ColorCorrection, settings.ColorCorrection, duration)
	end
	if settings.SunRays then
		tweenOrSet(effects.SunRays, settings.SunRays, duration)
	end
	if settings.DepthOfField then
		tweenOrSet(effects.DepthOfField, settings.DepthOfField, duration)
	end
	if settings.Clouds and clouds then
		clouds.Enabled = settings.Clouds.Enabled
		tweenOrSet(clouds, { Cover = settings.Clouds.Cover, Density = settings.Clouds.Density, Color = settings.Clouds.Color }, duration)
	end
	if settings.Water then
		local terrain = Workspace.Terrain
		terrain.WaterColor = settings.Water.Color
		terrain.WaterTransparency = settings.Water.Transparency
		terrain.WaterReflectance = settings.Water.Reflectance
		terrain.WaterWaveSize = settings.Water.WaveSize
		terrain.WaterWaveSpeed = settings.Water.WaveSpeed
	end
	sky.StarCount = settings.StarCount or 3000
	sky.CelestialBodiesShown = worldId ~= "Space"
	setParticles(settings.Particles)
	Workspace.Gravity = world.Gravity or 196.2
	Sounds.SetWorld(worldId)
end

local function showBanner(worldId)
	local world = Worlds[worldId]
	if not world or not banner then
		return
	end
	banner.Visible = true
	bannerText.Text = Format.Upper(world.Name)
	bannerText.TextColor3 = Kit.Lighten(world.Color, 0.3)
	bannerText.TextTransparency = 0
	local stroke = bannerText:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	if bannerIcon then
		bannerIcon:Destroy()
	end
	bannerIcon = Icons.Create(banner, world.Icon, {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.new(0.5, 0, 0, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 31,
		Animate = "Spin",
	})
	bannerScale.Scale = 0.3
	Kit.Tween(bannerScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local shownName = bannerText.Text
	task.delay(2.2, function()
		if bannerText.Text ~= shownName then
			return
		end
		Kit.Tween(bannerText, 0.5, { TextTransparency = 1 })
		if stroke then
			Kit.Tween(stroke, 0.5, { Transparency = 1 })
		end
		Kit.Tween(bannerScale, 0.5, { Scale = 0.6 })
		task.delay(0.5, function()
			if bannerText.Text == shownName then
				banner.Visible = false
			end
		end)
	end)
end

------------------------------------------------------------------ АНИМАЦИИ ДЕКОРА
local animated = {} -- [part] = { Base = CFrame, Kind = "Coin" | "Spin" | "Bob", Speed, Seed }

-- Деталь или целая модель (модель вращается вокруг своего центра через PivotTo).
local function track(item, kind)
	if animated[item] or not (item:IsA("BasePart") or item:IsA("Model")) then
		return
	end
	local pivot = item:GetPivot()
	animated[item] = {
		Base = pivot,
		Kind = kind,
		IsModel = item:IsA("Model"),
		Speed = item:GetAttribute("SpinSpeed") or 1,
		Amplitude = item:GetAttribute("BobHeight") or 1.5,
		Seed = (pivot.Position.X + pivot.Position.Z) * 0.37,
	}
end

local function animate()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local t = os.clock()

	if ambientPart then
		ambientPart.CFrame = CFrame.new(cameraPosition + camera.CFrame.LookVector * 18)
	end

	for item, info in pairs(animated) do
		if not item.Parent then
			animated[item] = nil
		else
			local base = info.Base
			if (base.Position - cameraPosition).Magnitude < 320 then
				local target
				if info.Kind == "Coin" then
					local position = base.Position
					target = CFrame.new(position + Vector3.new(0, math.sin(t * 2 + info.Seed) * 0.45, 0)) * CFrame.Angles(0, t * 2.5 + info.Seed, 0)
				elseif info.Kind == "Spin" then
					target = base * CFrame.Angles(0, t * info.Speed, 0)
				else
					target = base + Vector3.new(0, math.sin(t * info.Speed + info.Seed) * info.Amplitude, 0)
				end
				if info.IsModel then
					item:PivotTo(target)
				else
					item.CFrame = target
				end
			end
		end
	end
end

local function watchTag(tag, kind)
	for _, part in ipairs(CollectionService:GetTagged(tag)) do
		track(part, kind)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(part)
		track(part, kind)
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(part)
		animated[part] = nil
	end)
end

------------------------------------------------------------------ ПОРТАЛЫ
local portals = {}

local function updatePortal(model)
	if model:GetAttribute("IsBack") then
		return
	end
	local status = model:FindFirstChild("Status", true)
	local targetId = model:GetAttribute("TargetWorld")
	local world = Worlds[targetId]
	if not status or not world then
		return
	end
	local total = State.Get("TotalStrength", 0)
	if State.UnlockedWorlds()[targetId] then
		status.Text = "Открыто — заходи!"
		status.TextColor3 = Color3.fromRGB(140, 255, 150)
	elseif total >= world.UnlockStrength then
		status.Text = "Можно открыть — заходи!"
		status.TextColor3 = Color3.fromRGB(255, 230, 100)
	else
		status.Text = string.format("Закрыто: %s / %s силы", Format.Number(total), Format.Number(world.UnlockStrength))
		status.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

local updateQueued = false
local function updateAllPortals()
	if updateQueued then
		return
	end
	updateQueued = true
	task.delay(0.3, function()
		updateQueued = false
		for model in pairs(portals) do
			if model.Parent then
				updatePortal(model)
			else
				portals[model] = nil
			end
		end
	end)
end

local function addPortal(model)
	portals[model] = true
	updatePortal(model)
	-- При StreamingEnabled табличка может подгрузиться позже самого портала.
	model.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Status" then
			updatePortal(model)
		end
	end)
end

------------------------------------------------------------------ ЗАПУСК
function WorldEffects.Init(root)
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or getOrCreate(Lighting, "Atmosphere", "Atmosphere")
	sky = Lighting:FindFirstChildOfClass("Sky") or getOrCreate(Lighting, "Sky", "Sky")
	effects.Bloom = getOrCreate(Lighting, "BloomEffect", "PowerPetsBloom")
	effects.ColorCorrection = getOrCreate(Lighting, "ColorCorrectionEffect", "PowerPetsColor")
	effects.SunRays = getOrCreate(Lighting, "SunRaysEffect", "PowerPetsSunRays")
	effects.DepthOfField = getOrCreate(Lighting, "DepthOfFieldEffect", "PowerPetsDepth")
	pcall(function()
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.PrioritizeLightingQuality = true
	end)
	pcall(function()
		clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or getOrCreate(Workspace.Terrain, "Clouds", "Clouds")
	end)

	-- Невидимая деталь у камеры, из которой летят частицы.
	ambientPart = Instance.new("Part")
	ambientPart.Name = "AmbientParticles"
	ambientPart.Anchored = true
	ambientPart.CanCollide = false
	ambientPart.CanQuery = false
	ambientPart.CanTouch = false
	ambientPart.Transparency = 1
	ambientPart.Size = Vector3.new(70, 24, 70)
	ambientPart.Parent = Workspace
	ambientEmitter = Instance.new("ParticleEmitter")
	ambientEmitter.SpreadAngle = Vector2.new(180, 180)
	ambientEmitter.Parent = ambientPart

	banner = Kit.new("Frame", {
		Name = "WorldBanner",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(700, 90),
		Visible = false,
		ZIndex = 30,
		Parent = root,
	})
	bannerScale = Kit.new("UIScale", { Parent = banner })
	bannerText = Kit.Text({
		Name = "Title",
		Text = "",
		Size = UDim2.fromScale(1, 1),
		MaxTextSize = 84,
		StrokeThickness = 6,
		ZIndex = 31,
		Parent = banner,
	})

	State.Watch("World", function()
		local worldId = State.Get("World", "Forest")
		if worldId == currentWorld then
			return
		end
		local first = currentWorld == nil
		currentWorld = worldId
		applyWorld(worldId, first)
		if State.IsLoaded() or not first then
			showBanner(worldId)
		end
	end)
	-- Приветственная надпись, когда данные загрузились.
	State.Watch("DataLoaded", function()
		if State.IsLoaded() then
			showBanner(State.Get("World", "Forest"))
		end
	end)

	watchTag("Coin", "Coin")
	watchTag("Spin", "Spin")
	watchTag("Bob", "Bob")
	RunService.RenderStepped:Connect(animate)

	for _, portal in ipairs(CollectionService:GetTagged("Portal")) do
		addPortal(portal)
	end
	CollectionService:GetInstanceAddedSignal("Portal"):Connect(addPortal)
	CollectionService:GetInstanceRemovedSignal("Portal"):Connect(function(model)
		portals[model] = nil
	end)
	State.Watch({ "TotalStrength", "UnlockedWorlds" }, updateAllPortals)
end

return WorldEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
