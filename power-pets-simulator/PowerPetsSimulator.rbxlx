        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format — красивые числа для интерфейса: 1500 -> "1.5K", 2300000 -> "2.3M".
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- Убирает лишние нули после точки: "1.50" -> "1.5", "2.00" -> "2".
local function trimZeros(text)
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

local function threeDigits(value)
	if value >= 100 then
		return string.format("%.0f", value)
	elseif value >= 10 then
		return trimZeros(string.format("%.1f", value))
	end
	return trimZeros(string.format("%.2f", value))
end

-- Сокращённое число: 999 -> "999", 1234 -> "1.23K", 12.5 -> "12.5".
function Format.Number(value)
	value = tonumber(value) or 0
	if value ~= value or value == math.huge or value == -math.huge then
		return "∞"
	end

	local sign = ""
	if value < 0 then
		sign = "-"
		value = -value
	end

	if value < 1000 then
		if value == math.floor(value) then
			return sign .. string.format("%d", value)
		end
		return sign .. trimZeros(string.format("%.1f", value))
	end

	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end

	local text = threeDigits(value)
	-- 999.95K округляется до "1000" — переносим на следующий суффикс.
	if tonumber(text) and tonumber(text) >= 1000 and index < #SUFFIXES then
		value /= 1000
		index += 1
		text = threeDigits(value)
	end
	return sign .. text .. SUFFIXES[index]
end

-- Полное число с пробелами между разрядами: 1234567 -> "1 234 567".
function Format.Full(value)
	value = math.floor(tonumber(value) or 0)
	local text = tostring(math.abs(value))
	local result = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1 ")))
	result = string.gsub(result, "^ ", "")
	if value < 0 then
		result = "-" .. result
	end
	return result
end

-- Множитель: 2 -> "x2", 1.25 -> "x1.25".
function Format.Multiplier(value)
	value = tonumber(value) or 1
	if value >= 1000 then
		return "x" .. Format.Number(value)
	end
	return "x" .. trimZeros(string.format("%.2f", value))
end

-- Проценты: 60 -> "60%", 4.5 -> "4.5%", 0.25 -> "0.25%".
function Format.Percent(value)
	value = tonumber(value) or 0
	if value == math.floor(value) then
		return string.format("%d%%", value)
	elseif value >= 1 then
		return trimZeros(string.format("%.1f", value)) .. "%"
	end
	return trimZeros(string.format("%.2f", value)) .. "%"
end

-- Заглавные буквы с кириллицей: string.upper в Roblox меняет только латиницу.
function Format.Upper(text)
	local out = {}
	for _, code in utf8.codes(text) do
		if code >= 0x430 and code <= 0x44F then
			code -= 0x20
		elseif code == 0x451 then
			code = 0x401
		elseif code >= 97 and code <= 122 then
			code -= 32
		end
		table.insert(out, utf8.char(code))
	end
	return table.concat(out)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Formulas</string>
            <string name="Source"><![CDATA[--[[
	Formulas — вся математика игры в одном месте.
	Сервер считает по этим формулам, клиент — только чтобы показать подсказки в интерфейсе.
]]

local Config = script.Parent.Parent:WaitForChild("Config")
local GameConfig = require(Config.GameConfig)
local Pets = require(Config.Pets)
local Eggs = require(Config.Eggs)
local Rarities = require(Config.Rarities)
local Worlds = require(Config.Worlds)
local Backpacks = require(Config.Backpacks)

local Formulas = {}

-- Округление до сотых, чтобы дробная сила не копила ошибки вида 0.30000000004.
function Formulas.Round(value)
	if math.abs(value) >= 1e12 then
		return math.floor(value)
	end
	return math.floor(value * 100 + 0.5) / 100
end

-- Множитель одного питомца (золотой — в GoldenMultiplier раз больше).
function Formulas.PetMultiplier(petId, golden)
	local pet = Pets[petId]
	if not pet then
		return 1
	end
	local multiplier = pet.Multiplier
	if golden then
		multiplier *= GameConfig.GoldenMultiplier
	end
	return multiplier
end

-- Общий множитель от надетых питомцев.
-- Бонусы складываются: x1.2 и x1.5 вместе дают x1.7 (1 + 0.2 + 0.5).
function Formulas.TotalPetMultiplier(petList)
	local total = 1
	for _, pet in ipairs(petList) do
		if pet.Equipped then
			total += Formulas.PetMultiplier(pet.Id, pet.Golden) - 1
		end
	end
	return Formulas.Round(total)
end

-- Постоянный множитель от перерождений: +50% за каждое.
function Formulas.RebirthMultiplier(rebirths)
	return 1 + (rebirths or 0) * GameConfig.RebirthBonus
end

-- Сила за один клик.
function Formulas.ClickPower(petMultiplier, rebirths)
	return Formulas.Round(GameConfig.BaseClickPower * petMultiplier * Formulas.RebirthMultiplier(rebirths))
end

-- Сколько накопленной силы нужно для следующего перерождения.
function Formulas.RebirthCost(rebirths)
	return math.floor(GameConfig.RebirthBaseCost * GameConfig.RebirthCostGrowth ^ (rebirths or 0))
end

-- Сколько монет дадут за силу на точке продажи мира.
function Formulas.SellValue(strength, worldId)
	local world = Worlds[worldId]
	local multiplier = world and world.SellMultiplier or 1
	return math.floor(strength * multiplier + 1e-6)
end

function Formulas.BackpackCapacity(level)
	local backpack = Backpacks[level] or Backpacks[1]
	return backpack.Capacity
end

-- Шансы яйца: возвращает { [petId] = процент }, питомцев по редкостям и сумму весов.
local chanceCache = {}
function Formulas.EggChances(eggId)
	local cached = chanceCache[eggId]
	if cached then
		return cached.Chances, cached.ByRarity, cached.Total
	end

	local egg = Eggs[eggId]
	local byRarity, total = {}, 0
	for _, petId in ipairs(egg.Pets) do
		local rarity = Pets[petId].Rarity
		if not byRarity[rarity] then
			byRarity[rarity] = {}
			total += Rarities[rarity].Chance
		end
		table.insert(byRarity[rarity], petId)
	end

	local chances = {}
	for rarity, list in pairs(byRarity) do
		for _, petId in ipairs(list) do
			chances[petId] = Rarities[rarity].Chance / total / #list * 100
		end
	end

	chanceCache[eggId] = { Chances = chances, ByRarity = byRarity, Total = total }
	return chances, byRarity, total
end

-- Случайный питомец из яйца. Сначала выбирается редкость по шансам, потом питомец внутри неё.
function Formulas.RollEgg(eggId, rng)
	local _, byRarity, total = Formulas.EggChances(eggId)
	local roll = rng:NextNumber() * total
	local lastList
	for _, rarity in ipairs(Rarities.Order) do
		local list = byRarity[rarity]
		if list then
			lastList = list
			roll -= Rarities[rarity].Chance
			if roll <= 0 then
				return list[rng:NextInteger(1, #list)]
			end
		end
	end
	-- Сюда попадаем только из-за погрешности дробей.
	return lastList[rng:NextInteger(1, #lastList)]
end

-- Питомцы яйца, отсортированные от частых к редким (для табличек и интерфейса).
function Formulas.EggPetsSorted(eggId)
	local list = table.clone(Eggs[eggId].Pets)
	table.sort(list, function(a, b)
		local ra, rb = Rarities[Pets[a].Rarity].Order, Rarities[Pets[b].Rarity].Order
		if ra ~= rb then
			return ra < rb
		end
		return Pets[a].Multiplier < Pets[b].Multiplier
	end)
	return list
end

return Formulas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">PetBuilder</string>
            <string name="Source"><![CDATA[--[[
	PetBuilder — собирает 3D-модель питомца из простых деталей по описанию Look из конфига Pets.
	Никаких мешей и картинок: всё из шаров, цилиндров и блоков, поэтому легко добавлять новых питомцев.

	PetBuilder.Build(petId, golden) -> Model
		Центр модели (Model.PrimaryPart "Root") находится в точке (0, 0, 0), мордочка смотрит в -Z.
		Все детали закреплены (Anchored) и не сталкиваются ни с чем — модель двигают через PivotTo / BulkMoveTo.
]]

local Config = script.Parent.Parent:WaitForChild("Config")
local Pets = require(Config.Pets)
local Rarities = require(Config.Rarities)

local PetBuilder = {}

local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(25, 20, 35)
local BLUSH = Color3.fromRGB(255, 130, 160)
local GOLD = Color3.fromRGB(255, 196, 40)
local GOLD_LIGHT = Color3.fromRGB(255, 232, 130)

-- Чем реже питомец, тем он чуть крупнее.
local RARITY_SCALE = {
	Common = 1,
	Rare = 1.05,
	Epic = 1.12,
	Legendary = 1.22,
	Mythic = 1.35,
}

local SIDES = { -1, 1 }

local function vertical(position)
	-- Цилиндр в Roblox вытянут по оси X; поворот делает его вертикальным.
	return CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
end

function PetBuilder.Build(petId, golden)
	local config = Pets[petId]
	if not config then
		warn("[PetBuilder] Нет питомца с ID", petId)
		return nil
	end

	local look = config.Look or {}
	local R = (look.Size or 1) * (RARITY_SCALE[config.Rarity] or 1)
	local main = look.Color or Color3.fromRGB(200, 200, 200)
	local accent = look.Accent or main:Lerp(WHITE, 0.55)
	local dark = main:Lerp(INK, 0.35)
	local shape = look.Shape or "Ball"

	local model = Instance.new("Model")
	model.Name = petId
	local roles = {}

	-- Создаёт деталь. kind: "Block" | "Ball" | "Cylinder" | "Ellipsoid".
	-- role: "Body" и "Accent" перекрашиваются у золотых питомцев, "Detail" — нет.
	local function add(kind, size, cframe, color, role, options)
		options = options or {}
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Massless = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		if kind == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif kind == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif kind == "Ellipsoid" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		part.Size = size
		part.CFrame = cframe
		part.Color = color
		part.Material = options.Material or (role == "Body" and look.Material) or Enum.Material.SmoothPlastic
		part.Transparency = options.Transparency or 0
		part.Name = options.Name or role or "Part"
		part.Parent = model
		roles[part] = role or "Detail"
		return part
	end

	-- Вектор в «единицах питомца» (масштаб R).
	local function v(x, y, z)
		return Vector3.new(x, y, z) * R
	end

	-- Цилиндр от точки a до точки b.
	local function cylinderBetween(a, b, diameter, color, role, options)
		local length = (b - a).Magnitude
		local cframe = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
		return add("Cylinder", Vector3.new(length, diameter, diameter), cframe, color, role, options)
	end

	local root = add("Block", Vector3.new(0.2, 0.2, 0.2), CFrame.identity, WHITE, "Root", { Transparency = 1, Name = "Root" })
	model.PrimaryPart = root

	-- Голова: центр и радиус, к ним крепятся глаза, уши и рога.
	local head = { Center = Vector3.zero, Radius = R }
	local tailAnchor = v(0, -0.15, 0.95)
	local hasFace = true
	local bodyOptions = { Transparency = look.Transparency }

	------------------------------------------------------------------ ТЕЛО
	if shape == "Ball" then
		add("Ball", v(2, 2, 2), CFrame.identity, main, "Body", bodyOptions)
		if look.Belly ~= false then
			add("Ellipsoid", v(1.3, 1.0, 0.5), CFrame.new(v(0, -0.4, -0.72)), accent, "Accent")
		end
	elseif shape == "Blob" then
		add("Ellipsoid", v(2.3, 1.9, 2.3), CFrame.identity, main, "Body", bodyOptions)
		add("Ellipsoid", v(1.7, 0.8, 1.7), CFrame.new(v(0, -0.7, 0)), main:Lerp(accent, 0.4), "Accent", bodyOptions)
		head = { Center = v(0, 0.05, 0), Radius = R * 1.08 }
		tailAnchor = v(0, -0.1, 1.05)
	elseif shape == "Long" then
		add("Ellipsoid", v(1.6, 1.35, 2.8), CFrame.new(v(0, -0.15, 0.55)), main, "Body", bodyOptions)
		add("Ball", v(1.7, 1.7, 1.7), CFrame.new(v(0, 0.2, -0.75)), main, "Body", bodyOptions)
		add("Ellipsoid", v(1.05, 0.55, 2.0), CFrame.new(v(0, -0.55, 0.45)), accent, "Accent")
		head = { Center = v(0, 0.2, -0.75), Radius = R * 0.85 }
		tailAnchor = v(0, -0.1, 1.85)
	elseif shape == "Box" then
		add("Block", v(1.9, 1.7, 1.6), CFrame.identity, main, "Body")
		add("Block", v(1.5, 0.85, 0.12), CFrame.new(v(0, 0.15, -0.8)), INK, "Detail")
		add("Block", v(0.9, 0.35, 0.1), CFrame.new(v(0, -0.5, -0.81)), accent, "Accent")
		for _, side in ipairs(SIDES) do
			add("Cylinder", v(0.3, 0.6, 0.6), CFrame.new(v(side * 1.05, 0.1, 0)), accent, "Accent")
		end
		tailAnchor = v(0, -0.3, 0.85)
	elseif shape == "Disc" then
		hasFace = false
		add("Cylinder", v(0.5, 3, 3), vertical(v(0, -0.25, 0)), main, "Body")
		add("Cylinder", v(0.25, 2.2, 2.2), vertical(v(0, -0.6, 0)), dark, "Body")
		add("Ellipsoid", v(1.6, 1.2, 1.6), CFrame.new(v(0, 0.25, 0)), accent, "Detail", {
			Transparency = 0.45,
			Material = Enum.Material.Glass,
		})
		-- Пилот внутри купола.
		add("Ball", v(0.8, 0.8, 0.8), CFrame.new(v(0, 0.2, 0)), Color3.fromRGB(130, 236, 120), "Detail")
		for _, side in ipairs(SIDES) do
			add("Ball", v(0.22, 0.22, 0.22), CFrame.new(v(side * 0.16, 0.28, -0.32)), INK, "Detail")
		end
		for i = 1, 8 do
			local angle = (i / 8) * math.pi * 2
			local color = (i % 2 == 0) and Color3.fromRGB(255, 230, 80) or Color3.fromRGB(255, 90, 200)
			add("Ball", v(0.3, 0.3, 0.3), CFrame.new(v(math.cos(angle) * 1.35, -0.25, math.sin(angle) * 1.35)), color, "Detail", {
				Material = Enum.Material.Neon,
			})
		end
	elseif shape == "Gem" then
		add("Block", v(1.8, 1.9, 1.5), CFrame.identity, main, "Body")
		for _, side in ipairs(SIDES) do
			add("Block", v(0.6, 1.1, 0.6), CFrame.new(v(side * 1.2, -0.3, 0)) * CFrame.Angles(0, 0, side * math.rad(-12)), main, "Body")
		end
		local shards = {
			{ v(0, 1.15, 0.1), 0, 0.6 },
			{ v(-0.55, 1.0, 0.2), -25, 0.45 },
			{ v(0.55, 1.0, 0.2), 25, 0.45 },
			{ v(-1.0, 0.75, 0.15), -45, 0.35 },
			{ v(1.0, 0.75, 0.15), 45, 0.35 },
		}
		for _, shard in ipairs(shards) do
			local height = shard[3] * 2.2
			add("Block", Vector3.new(shard[3], height, shard[3]) * R, CFrame.new(shard[1]) * CFrame.Angles(0, math.rad(45), math.rad(-shard[2])), accent, "Accent", {
				Material = Enum.Material.Neon,
				Transparency = 0.1,
			})
		end
		head = { Center = v(0, 0.1, 0.05), Radius = R * 0.92 }
	elseif shape == "Hole" then
		add("Ball", v(2, 2, 2), CFrame.identity, main, "Body")
	end

	------------------------------------------------------------------ ЛИЦО
	local function addFace()
		local c, r = head.Center, head.Radius
		local eyeColor = look.EyeColor or INK
		local eyeMaterial = look.EyeGlow and Enum.Material.Neon or nil
		local style = look.EyeStyle or (shape == "Box" and "Led") or "Ball"

		for _, side in ipairs(SIDES) do
			if style == "Led" then
				add("Block", Vector3.new(0.36, 0.24, 0.08) * r, CFrame.new(c + Vector3.new(side * 0.36, 0.17, -0.88) * r), eyeColor, "Detail", {
					Material = Enum.Material.Neon,
				})
			elseif style == "Alien" then
				local position = c + Vector3.new(side * 0.4, 0.12, -0.84) * r
				add("Ellipsoid", Vector3.new(0.44, 0.66, 0.3) * r, CFrame.new(position) * CFrame.Angles(0, 0, side * math.rad(-28)), INK, "Detail")
				add("Ball", Vector3.one * 0.13 * r, CFrame.new(position + Vector3.new(-0.06, 0.12, -0.13) * r), WHITE, "Detail")
			else
				local big = style == "Big"
				local size = big and 0.5 or 0.36
				local depth = big and -0.92 or -0.86
				if big then
					add("Ball", Vector3.one * 0.66 * r, CFrame.new(c + Vector3.new(side * 0.38, 0.14, -0.78) * r), look.EyeRing or WHITE, "Detail")
				end
				local position = c + Vector3.new(side * 0.37, 0.14, depth) * r
				add("Ball", Vector3.one * size * r, CFrame.new(position), eyeColor, "Detail", { Material = eyeMaterial })
				if not look.EyeGlow then
					add("Ball", Vector3.one * 0.12 * r, CFrame.new(position + Vector3.new(-0.06, 0.08, -size * 0.45) * r), WHITE, "Detail")
				end
			end
		end

		-- Румянец.
		if look.Blush ~= false and style ~= "Led" then
			for _, side in ipairs(SIDES) do
				local position = c + Vector3.new(side * 0.6, -0.18, -0.76) * r
				local normal = (position - c).Unit
				add("Ellipsoid", Vector3.new(0.3, 0.17, 0.08) * r, CFrame.lookAt(position, position + normal), BLUSH, "Detail", {
					Transparency = 0.2,
				})
			end
		end

		-- Мордочка и нос.
		if look.Snout then
			add("Ellipsoid", Vector3.new(0.8, 0.55, 0.6) * r, CFrame.new(c + Vector3.new(0, -0.28, -0.86) * r), accent, "Accent")
			if look.Nose then
				add("Ball", Vector3.one * 0.2 * r, CFrame.new(c + Vector3.new(0, -0.14, -1.13) * r), look.Nose, "Detail")
			end
		elseif look.Nose then
			add("Ball", Vector3.one * 0.17 * r, CFrame.new(c + Vector3.new(0, -0.08, -0.99) * r), look.Nose, "Detail")
		end

		if look.Beak then
			add("Ellipsoid", Vector3.new(0.36, 0.28, 0.5) * r, CFrame.new(c + Vector3.new(0, -0.12, -1.0) * r) * CFrame.Angles(math.rad(15), 0, 0), look.Beak, "Detail")
		end

		-- Маска енота.
		if look.Mask then
			add("Ellipsoid", Vector3.new(1.35, 0.42, 0.5) * r, CFrame.new(c + Vector3.new(0, 0.14, -0.72) * r), look.Mask, "Detail")
		end
	end

	if hasFace then
		addFace()
	end

	------------------------------------------------------------------ УШИ
	local c, r = head.Center, head.Radius
	local earColor = look.EarColor or main
	local earScale = look.EarScale or 1
	if look.Ears == "Pointy" or look.Ears == "Tiny" then
		local size = (look.Ears == "Tiny" and 0.36 or 0.62) * earScale
		for _, side in ipairs(SIDES) do
			local base = c + Vector3.new(side * 0.52, 0.82 + size * 0.15, 0.02) * r
			local tilt = CFrame.Angles(0, 0, side * math.rad(-18)) * CFrame.Angles(0, 0, math.rad(45))
			add("Block", Vector3.new(size, size, 0.22) * r, CFrame.new(base) * tilt, earColor, "Body")
			if look.Ears == "Pointy" then
				add("Block", Vector3.new(size * 0.6, size * 0.6, 0.1) * r, CFrame.new(base + Vector3.new(0, -0.03, -0.12) * r) * tilt, accent, "Accent")
			end
		end
	elseif look.Ears == "Round" then
		for _, side in ipairs(SIDES) do
			local base = c + Vector3.new(side * 0.62, 0.72, 0) * r
			add("Ball", Vector3.one * 0.56 * earScale * r, CFrame.new(base), earColor, "Body")
			add("Ball", Vector3.one * 0.32 * earScale * r, CFrame.new(base + Vector3.new(0, 0, -0.14 * earScale) * r), accent, "Accent")
		end
	elseif look.Ears == "Long" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(c + Vector3.new(side * 0.38, 1.3, 0.05) * r) * CFrame.Angles(0, 0, side * math.rad(-10))
			add("Ellipsoid", Vector3.new(0.34, 1.3, 0.22) * r, cframe, earColor, "Body")
			add("Ellipsoid", Vector3.new(0.18, 1.0, 0.06) * r, cframe * CFrame.new(Vector3.new(0, 0, -0.1) * r), accent, "Accent")
		end
	elseif look.Ears == "Floppy" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(c + Vector3.new(side * 0.92, 0.12, 0) * r) * CFrame.Angles(0, 0, side * math.rad(15))
			add("Ellipsoid", Vector3.new(0.36, 0.95, 0.55) * r, cframe, earColor, "Body")
		end
	end

	------------------------------------------------------------------ ХВОСТ
	local tailColor = look.TailColor or main
	local ta = tailAnchor
	if look.Tail == "Thin" then
		local a = ta
		local b = ta + v(0, 0.55, 0.65)
		cylinderBetween(a, b, 0.22 * R, tailColor, "Body")
		add("Ball", Vector3.one * 0.26 * R, CFrame.new(b), look.TailTip or tailColor, "Body")
	elseif look.Tail == "Fluffy" then
		local cframe = CFrame.new(ta + v(0, 0.35, 0.45)) * CFrame.Angles(math.rad(-40), 0, 0)
		add("Ellipsoid", v(0.6, 0.6, 1.3), cframe, tailColor, "Body")
		add("Ball", Vector3.one * 0.48 * R, cframe * CFrame.new(v(0, 0, 0.55)), look.TailTip or accent, "Accent")
	elseif look.Tail == "Puff" then
		add("Ball", Vector3.one * 0.55 * R, CFrame.new(ta + v(0, 0, 0.1)), tailColor, "Accent")
	elseif look.Tail == "Stinger" then
		local points = { v(0, -0.1, 1.05), v(0, 0.45, 1.4), v(0, 1.05, 1.35), v(0, 1.4, 0.95) }
		for i, point in ipairs(points) do
			add("Ball", Vector3.one * (0.5 - i * 0.05) * R, CFrame.new(point), main, "Body")
		end
		add("Ellipsoid", v(0.18, 0.18, 0.55), CFrame.new(v(0, 1.3, 0.6)) * CFrame.Angles(math.rad(35), 0, 0), INK, "Detail")
	elseif look.Tail == "Fins" then
		for _, side in ipairs(SIDES) do
			add("Ellipsoid", v(1.1, 0.14, 0.6), CFrame.new(ta + v(side * 0.55, 0.15, 0.25)) * CFrame.Angles(0, side * math.rad(-30), 0), accent, "Accent")
			add("Ellipsoid", v(0.9, 0.12, 0.45), CFrame.new(v(side * 0.95, -0.35, -0.05)) * CFrame.Angles(0, 0, side * math.rad(-25)), accent, "Accent")
		end
		-- Звёздочки на спине кита.
		for i = 1, 5 do
			add("Ball", Vector3.one * 0.14 * R, CFrame.new(v((i - 3) * 0.22, 0.52 - math.abs(i - 3) * 0.04, 0.35 + (i % 2) * 0.35)), WHITE, "Detail", {
				Material = Enum.Material.Neon,
			})
		end
	elseif look.Tail == "Flame" then
		local flameColors = { look.Accent or Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 90, 30) }
		for i = 1, 3 do
			add("Ellipsoid", Vector3.new(0.9 - i * 0.2, 0.9 - i * 0.2, 1.1) * R, CFrame.new(ta + v(0, 0.12 * i, 0.35 + i * 0.45)), flameColors[i], "Detail", {
				Material = Enum.Material.Neon,
				Transparency = 0.15 + i * 0.12,
			})
		end
	end

	------------------------------------------------------------------ КРЫЛЬЯ
	local wingColor = look.WingColor or accent
	if look.Wings == "Feather" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(v(side * 1.0, 0.15, 0.3)) * CFrame.Angles(0, 0, side * math.rad(-40))
			add("Ellipsoid", v(0.2, 0.9, 1.0), cframe, wingColor, "Accent")
			add("Ellipsoid", v(0.16, 0.6, 0.8), cframe * CFrame.new(v(0, 0.5, 0.15)), wingColor:Lerp(WHITE, 0.25), "Accent")
		end
	elseif look.Wings == "Bat" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(v(side * 1.1, 0.35, 0.35)) * CFrame.Angles(0, 0, side * math.rad(-50))
			add("Ellipsoid", v(0.12, 1.1, 1.2), cframe, wingColor, "Accent")
			add("Ellipsoid", v(0.1, 0.7, 0.5), cframe * CFrame.new(v(0, 0.55, -0.35)), wingColor:Lerp(INK, 0.2), "Accent")
		end
	elseif look.Wings == "Bug" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(v(side * 0.7, 0.62, 0.45)) * CFrame.Angles(0, 0, side * math.rad(-28))
			add("Ellipsoid", v(0.08, 0.7, 1.1), cframe, Color3.fromRGB(220, 250, 255), "Detail", { Transparency = 0.4 })
		end
	end

	------------------------------------------------------------------ УКРАШЕНИЯ
	if look.Horn then
		add("Ellipsoid", Vector3.new(0.24, 1.0, 0.24) * r, CFrame.new(c + Vector3.new(0, 1.12, -0.42) * r) * CFrame.Angles(math.rad(-25), 0, 0), look.Horn, "Detail", {
			Material = Enum.Material.Neon,
		})
	end

	if look.Horns == "Dragon" then
		for _, side in ipairs(SIDES) do
			local cframe = CFrame.new(c + Vector3.new(side * 0.45, 0.98, 0.15) * r) * CFrame.Angles(math.rad(30), 0, side * math.rad(-15))
			add("Ellipsoid", Vector3.new(0.22, 0.85, 0.22) * r, cframe, look.HornColor or accent, "Detail")
		end
	elseif look.Horns == "Antlers" then
		local hornColor = look.HornColor or Color3.fromRGB(170, 120, 80)
		local hornMaterial = look.Glow and Enum.Material.Neon or nil
		for _, side in ipairs(SIDES) do
			local base = c + Vector3.new(side * 0.4, 0.8, 0) * r
			local top = c + Vector3.new(side * 0.95, 1.65, 0.1) * r
			local middle = base:Lerp(top, 0.5)
			cylinderBetween(base, top, 0.13 * r, hornColor, "Detail", { Material = hornMaterial })
			cylinderBetween(middle, c + Vector3.new(side * 0.35, 1.55, -0.1) * r, 0.11 * r, hornColor, "Detail", { Material = hornMaterial })
			cylinderBetween(top, c + Vector3.new(side * 1.3, 1.85, 0) * r, 0.1 * r, hornColor, "Detail", { Material = hornMaterial })
		end
	end

	if look.Antenna then
		local antennaColor = look.AntennaColor or accent
		local count = look.Antenna
		for i = 1, count do
			local offsetX = count == 1 and 0 or (i == 1 and -0.38 or 0.38)
			local base = c + Vector3.new(offsetX, 0.85, 0) * r
			local tip = c + Vector3.new(offsetX * 1.6, 1.6, -0.05) * r
			cylinderBetween(base, tip, 0.08 * r, INK, "Detail")
			add("Ball", Vector3.one * 0.3 * r, CFrame.new(tip), antennaColor, "Detail", { Material = Enum.Material.Neon })
		end
	end

	if look.Halo then
		for i = 1, 14 do
			local angle = (i / 14) * math.pi * 2
			add("Ball", Vector3.one * 0.2 * r, CFrame.new(c + Vector3.new(math.cos(angle) * 0.62, 1.5, math.sin(angle) * 0.62) * r), Color3.fromRGB(255, 225, 90), "Detail", {
				Material = Enum.Material.Neon,
			})
		end
	end

	if look.Crown then
		local crownY = look.Headdress and 1.15 or 0.98
		add("Cylinder", Vector3.new(0.32, 1.05, 1.05) * r, vertical(c + Vector3.new(0, crownY, 0.05) * r), GOLD, "Detail", { Material = Enum.Material.Metal })
		for i = 1, 5 do
			local angle = (i / 5) * math.pi * 2
			local position = c + Vector3.new(math.cos(angle) * 0.42, crownY + 0.25, 0.05 + math.sin(angle) * 0.42) * r
			add("Block", Vector3.new(0.22, 0.22, 0.22) * r, CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)), GOLD, "Detail", { Material = Enum.Material.Metal })
		end
		add("Ball", Vector3.one * 0.18 * r, CFrame.new(c + Vector3.new(0, crownY, -0.5) * r), Color3.fromRGB(255, 60, 90), "Detail", { Material = Enum.Material.Neon })
	end

	if look.Headdress then
		-- Платок-немес: капюшон сзади и полосы по бокам.
		add("Ellipsoid", Vector3.new(2.2, 1.7, 2.0) * r, CFrame.new(c + Vector3.new(0, 0.3, 0.2) * r), look.Headdress, "Detail")
		for _, side in ipairs(SIDES) do
			add("Block", Vector3.new(0.45, 1.25, 0.3) * r, CFrame.new(c + Vector3.new(side * 0.88, -0.45, -0.25) * r), look.Headdress, "Detail")
			add("Block", Vector3.new(0.47, 0.18, 0.32) * r, CFrame.new(c + Vector3.new(side * 0.88, -0.2, -0.25) * r), GOLD, "Detail")
			add("Block", Vector3.new(0.47, 0.18, 0.32) * r, CFrame.new(c + Vector3.new(side * 0.88, -0.7, -0.25) * r), GOLD, "Detail")
		end
		add("Block", Vector3.new(1.9, 0.16, 0.3) * r, CFrame.new(c + Vector3.new(0, 0.62, -0.62) * r) * CFrame.Angles(math.rad(-25), 0, 0), GOLD, "Detail")
	end

	if look.Spikes then
		for i = 1, 14 do
			local around = math.rad(-110 + (i - 1) % 7 * (220 / 6))
			local elevation = math.rad(i <= 7 and 20 or 55)
			local direction = Vector3.new(math.sin(around) * math.cos(elevation), math.sin(elevation), math.cos(around) * math.cos(elevation))
			local position = c + direction * 0.95 * r
			add("Ellipsoid", Vector3.new(0.24, 0.24, 0.75) * r, CFrame.lookAt(position, position + direction), look.Spikes, "Body")
		end
	end

	if look.Bandage then
		local bands = { -0.55, -0.05, 0.45 }
		for i, y in ipairs(bands) do
			local diameter = 2 * math.sqrt(math.max(0, 1 - y * y)) + 0.06
			add("Cylinder", Vector3.new(0.18, diameter, diameter) * r, vertical(c + Vector3.new(0, y, 0) * r) * CFrame.Angles(0, 0, math.rad(i * 7 - 14)), accent, "Accent")
		end
	end

	if look.Hump then
		add("Ball", Vector3.one * 0.95 * R, CFrame.new(v(0, 0.8, 0.4)), main, "Body")
	end

	if look.Claws then
		for _, side in ipairs(SIDES) do
			local base = v(side * 0.85, -0.35, -0.75)
			add("Ellipsoid", v(0.5, 0.32, 0.65), CFrame.new(base) * CFrame.Angles(0, side * math.rad(-20), 0), main, "Body")
			add("Ellipsoid", v(0.18, 0.18, 0.4), CFrame.new(base + v(side * -0.12, 0.08, -0.4)) * CFrame.Angles(0, side * math.rad(25), 0), accent, "Accent")
		end
	end

	if look.Mane then
		local points = { v(0, 0.98, 0.05), v(0, 0.85, 0.45), v(0, 0.55, 0.8), v(0, 0.15, 0.98), v(0, -0.25, 0.95) }
		for i, point in ipairs(points) do
			local color = look.Mane[(i - 1) % #look.Mane + 1]
			add("Ball", Vector3.one * 0.5 * R, CFrame.new(point), color, "Detail")
		end
	end

	if look.Helmet then
		add("Ball", Vector3.one * 2.6 * r, CFrame.new(c), Color3.fromRGB(200, 240, 255), "Detail", {
			Transparency = 0.7,
			Material = Enum.Material.Glass,
		})
		add("Cylinder", Vector3.new(0.3, 2.0, 2.0) * r, vertical(c + Vector3.new(0, -1.0, 0) * r), Color3.fromRGB(220, 225, 240), "Detail", {
			Material = Enum.Material.Metal,
		})
	end

	if look.Ring then
		local tilt = CFrame.Angles(0, math.rad(20), math.rad(12))
		add("Cylinder", Vector3.new(0.06, 3.4, 3.4) * R, vertical(Vector3.zero) * tilt, look.Ring, "Detail", {
			Material = Enum.Material.Neon,
			Transparency = 0.25,
		})
		if look.Ring2 then
			add("Cylinder", Vector3.new(0.05, 2.6, 2.6) * R, vertical(Vector3.zero) * CFrame.Angles(0, math.rad(-15), math.rad(-20)), look.Ring2, "Detail", {
				Material = Enum.Material.Neon,
				Transparency = 0.3,
			})
		end
	end

	------------------------------------------------------------------ ЗОЛОТО И СВЕЧЕНИЕ
	if golden then
		for part, role in pairs(roles) do
			if role == "Body" then
				part.Color = GOLD
				part.Material = Enum.Material.SmoothPlastic
				part.Reflectance = 0.25
			elseif role == "Accent" then
				part.Color = GOLD_LIGHT
				part.Reflectance = 0.15
			end
		end
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = GOLD
		sparkles.Parent = root
	end

	if look.Glow or golden or config.Rarity == "Legendary" or config.Rarity == "Mythic" then
		local light = Instance.new("PointLight")
		light.Color = golden and GOLD or (look.GlowColor or Rarities[config.Rarity].Color)
		light.Range = 8 * R
		light.Brightness = 1.2
		light.Shadows = false
		light.Parent = root
	end

	return model
end

-- Список деталей модели и их смещения относительно центра (для быстрого движения через BulkMoveTo).
function PetBuilder.GetParts(model)
	local parts, offsets = {}, {}
	local pivot = model:GetPivot()
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			table.insert(offsets, pivot:ToObjectSpace(descendant.CFrame))
		end
	end
	return parts, offsets
end

return PetBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--[[
	Remotes — все RemoteEvent / RemoteFunction игры.
	Сервер создаёт их в ReplicatedStorage.Remotes, клиент ждёт их появления.

	Клиент → сервер (клиент только просит, всё решает сервер):
		Click            RemoteEvent     клик / тап
		GetInventory     RemoteFunction  список питомцев при входе
		PetAction        RemoteFunction  ("Equip" | "Unequip" | "Delete" | "Merge" | "EquipBest", uid)
		BuyBackpack      RemoteFunction  (level)
		BuyPetSlots      RemoteFunction  геймпасс «+2 слота»
		Rebirth          RemoteFunction  перерождение
		Teleport         RemoteFunction  (worldId) — телепорт / открытие мира из меню
	Сервер → клиент:
		InventoryChanged RemoteEvent     (список питомцев)
		EggHatched       RemoteEvent     (eggId, результаты) — запуск анимации
		Notify           RemoteEvent     (текст, вид) — всплывающее сообщение
		Effect           RemoteEvent     (вид, данные) — звуки и эффекты (монета, продажа, …)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DEFINITIONS = {
	Click = "RemoteEvent",
	GetInventory = "RemoteFunction",
	PetAction = "RemoteFunction",
	BuyBackpack = "RemoteFunction",
	BuyPetSlots = "RemoteFunction",
	Rebirth = "RemoteFunction",
	Teleport = "RemoteFunction",
	InventoryChanged = "RemoteEvent",
	EggHatched = "RemoteEvent",
	Notify = "RemoteEvent",
	Effect = "RemoteEvent",
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local isNew = folder == nil
	if isNew then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
	end
	for name, className in pairs(DEFINITIONS) do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
	if isNew then
		folder.Parent = ReplicatedStorage
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for name in pairs(DEFINITIONS) do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Power Pets Simulator — главный серверный скрипт.
	Строит миры, запускает сервисы, загружает и сохраняет игроков.
	Вся логика валют, яиц и питомцев выполняется только здесь, на сервере.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
require(Shared.Modules.Remotes) -- создаёт RemoteEvent / RemoteFunction

local Modules = script.Parent:WaitForChild("Modules")
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local WorldBuilder = require(Modules.WorldBuilder)
local WorldService = require(Modules.WorldService)
local ClickService = require(Modules.ClickService)
local PetService = require(Modules.PetService)
local EggService = require(Modules.EggService)
local ShopService = require(Modules.ShopService)
local RebirthService = require(Modules.RebirthService)
local SoundLibrary = require(Modules.SoundLibrary)

SoundLibrary.Init()
local worldRefs = WorldBuilder.Build()

DataService.Init()
WorldService.Init(worldRefs)
EggService.Init(worldRefs)
ClickService.Init()
PetService.Init()
ShopService.Init()
RebirthService.Init()

local function onPlayerAdded(player)
	PlayerState.Setup(player)
	WorldService.PlayerAdded(player)

	local data = DataService.Load(player)
	if not data or not player.Parent then
		return
	end

	ShopService.PlayerLoaded(player)
	PlayerState.SyncPets(player)
	-- Клиент покажет предупреждение, если прогресс не сохраняется.
	player:SetAttribute("SaveDisabled", not DataService.CanSave(player))
	player:SetAttribute("DataLoaded", true)
	WorldService.OnDataLoaded(player)
end

local function onPlayerRemoving(player)
	ClickService.PlayerRemoving(player)
	PetService.PlayerRemoving(player)
	WorldService.PlayerRemoving(player)
	DataService.Release(player)
	PlayerState.Remove(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- Сохранение при выключении сервера.
game:BindToClose(function()
	DataService.SaveAll()
end)

-- Автосохранение.
task.spawn(function()
	while true do
		task.wait(GameConfig.AutosaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			if DataService.Get(player) then
				task.spawn(DataService.Save, player)
				task.wait(0.2) -- немного разносим запросы во времени
			end
		end
	end
end)

print("[Power Pets Simulator] Сервер запущен")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ClickService</string>
            <string name="Source"><![CDATA[--[[
	ClickService — клики. Клиент только сообщает «я кликнул», сервер сам считает силу.
	Защита от автокликеров: не больше GameConfig.MaxClicksPerSecond кликов в секунду,
	лишние клики просто не засчитываются.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Backpacks = require(Shared.Config.Backpacks)
local Formulas = require(Shared.Modules.Formulas)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local RateLimiter = require(Modules.RateLimiter)

local ClickService = {}

local clickLimiter = RateLimiter.new(GameConfig.MaxClicksPerSecond, math.max(3, math.floor(GameConfig.MaxClicksPerSecond / 3)))
local fullWarnedAt = {} -- [player] = когда последний раз предупреждали о полном рюкзаке

function ClickService.Click(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if not clickLimiter:Allow(player) then
		return
	end

	local capacity = Backpacks[data.BackpackLevel].Capacity
	if data.Strength >= capacity then
		local now = os.clock()
		if (fullWarnedAt[player] or 0) + 5 < now then
			fullWarnedAt[player] = now
			PlayerState.Notify(player, "Рюкзак полон! Продай силу в зелёном круге продажи", "warning")
		end
		return
	end

	local power = PlayerState.GetClickPower(player)
	local newStrength = math.min(capacity, Formulas.Round(data.Strength + power))
	local gained = newStrength - data.Strength
	data.Strength = newStrength
	data.TotalStrength = Formulas.Round(data.TotalStrength + gained)
	data.Stats.Clicks += 1
	PlayerState.SyncStats(player)
end

function ClickService.PlayerRemoving(player)
	clickLimiter:Remove(player)
	fullWarnedAt[player] = nil
end

function ClickService.Init()
	Remotes.Click.OnServerEvent:Connect(ClickService.Click)
end

return ClickService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService — загрузка и сохранение прогресса через DataStoreService.

	Что сохраняется: сила, накопленная сила, монеты, перерождения, рюкзак, питомцы,
	открытые миры, текущий мир, тестовый геймпасс и немного статистики.

	- Загрузка с повторными попытками. Если хранилище недоступно (место не опубликовано
	  или в Studio выключен доступ к API), игра работает, но прогресс не сохраняется.
	- Если данные не удалось прочитать из-за ошибки, мы НЕ сохраняем поверх них,
	  чтобы не стереть настоящий прогресс игрока.
	- Автосейв (из Main.server.lua), сохранение при выходе и при выключении сервера.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Pets = require(Shared.Config.Pets)
local Worlds = require(Shared.Config.Worlds)
local Backpacks = require(Shared.Config.Backpacks)

local DataService = {}

local TEMPLATE = {
	Version = 1,
	Strength = 0, -- сила в рюкзаке (продаётся за монеты)
	TotalStrength = 0, -- сила, накопленная с последнего перерождения (лидерборд, порталы)
	Coins = 0,
	Rebirths = 0,
	BackpackLevel = 1,
	Pets = {}, -- { { Uid = 1, Id = "Kitten", Golden = false, Equipped = true }, ... }
	NextPetUid = 1,
	UnlockedWorlds = { [GameConfig.StartWorld] = true },
	CurrentWorld = GameConfig.StartWorld,
	PetSlotsPass = false, -- тестовый геймпасс (когда PetSlotsGamepassId = 0)
	Stats = {
		Clicks = 0,
		EggsOpened = 0,
	},
}

local store = nil
local storeEnabled = true
local profiles = {} -- [player] = { Data = {...}, CanSave = bool, Saving = bool }

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in pairs(value) do
		copy[key] = deepCopy(item)
	end
	return copy
end

-- Дополняет сохранение недостающими полями из шаблона и чинит неверные типы.
local function reconcile(data)
	if type(data) ~= "table" then
		return deepCopy(TEMPLATE)
	end
	for key, default in pairs(TEMPLATE) do
		if data[key] == nil or type(data[key]) ~= type(default) then
			data[key] = deepCopy(default)
		elseif type(default) == "table" and key ~= "Pets" and key ~= "UnlockedWorlds" then
			for subKey, subDefault in pairs(default) do
				if type(data[key][subKey]) ~= type(subDefault) then
					data[key][subKey] = deepCopy(subDefault)
				end
			end
		end
	end

	-- Числа не должны быть отрицательными или NaN.
	for _, key in ipairs({ "Strength", "TotalStrength", "Coins", "Rebirths" }) do
		local number = data[key]
		if number ~= number or number < 0 then
			data[key] = 0
		end
	end
	data.Rebirths = math.floor(data.Rebirths)
	data.BackpackLevel = math.clamp(math.floor(data.BackpackLevel), 1, #Backpacks)
	data.Strength = math.min(data.Strength, Backpacks[data.BackpackLevel].Capacity)

	-- Питомцы: выкидываем тех, кого больше нет в конфиге, чиним номера.
	local cleanPets, usedUids, maxUid = {}, {}, 0
	for _, pet in ipairs(data.Pets) do
		if type(pet) == "table" and type(pet.Id) == "string" and Pets[pet.Id] and #cleanPets < GameConfig.MaxPets then
			local uid = tonumber(pet.Uid)
			if not uid or usedUids[uid] then
				uid = nil
			end
			table.insert(cleanPets, {
				Uid = uid,
				Id = pet.Id,
				Golden = pet.Golden == true,
				Equipped = pet.Equipped == true,
			})
			if uid then
				usedUids[uid] = true
				maxUid = math.max(maxUid, uid)
			end
		end
	end
	for _, pet in ipairs(cleanPets) do
		if not pet.Uid then
			maxUid += 1
			pet.Uid = maxUid
		end
	end
	data.Pets = cleanPets
	data.NextPetUid = math.max(math.floor(tonumber(data.NextPetUid) or 1), maxUid + 1)

	-- Миры: только существующие, стартовый всегда открыт.
	local unlocked = { [GameConfig.StartWorld] = true }
	for worldId, isOpen in pairs(data.UnlockedWorlds) do
		if Worlds[worldId] and worldId ~= "Order" and isOpen == true then
			unlocked[worldId] = true
		end
	end
	data.UnlockedWorlds = unlocked
	if not unlocked[data.CurrentWorld] then
		data.CurrentWorld = GameConfig.StartWorld
	end

	data.Version = TEMPLATE.Version
	return data
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

-- Ошибки, после которых пробовать снова бессмысленно (Studio без доступа к API и т. п.).
local function isFatalError(message)
	message = tostring(message)
	return string.find(message, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(message, "publish", 1, true) ~= nil
		or string.find(message, "403", 1, true) ~= nil
end

function DataService.Init()
	if game.PlaceId == 0 then
		storeEnabled = false
		warn("[DataService] Место не опубликовано — сохранение отключено. Опубликуй игру и включи API Services, чтобы проверить сохранения.")
		return
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeEnabled = false
		warn("[DataService] DataStore недоступен:", result)
	end
end

-- Загружает данные игрока. Возвращает таблицу данных или nil, если игрок уже вышел.
function DataService.Load(player)
	local raw = nil
	local canSave = false

	if storeEnabled and store then
		local attempts = 4
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if ok then
				raw = result
				canSave = true
				break
			end
			warn(string.format("[DataService] Не удалось загрузить %s (попытка %d): %s", player.Name, attempt, tostring(result)))
			if isFatalError(result) then
				storeEnabled = false
				warn("[DataService] Сохранение отключено. В Studio: Game Settings → Security → Enable Studio Access to API Services.")
				break
			end
			if attempt < attempts then
				task.wait(attempt * 1.5)
			end
		end
	end

	if not player.Parent then
		return nil
	end

	local data = reconcile(raw)
	profiles[player] = {
		Data = data,
		CanSave = canSave,
		Saving = false,
	}
	return data
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.Data or nil
end

function DataService.CanSave(player)
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave and storeEnabled
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not profile.CanSave or not storeEnabled or not store then
		return false
	end

	-- Не пишем одновременно два сохранения одного игрока.
	while profile.Saving do
		task.wait(0.1)
	end
	profile.Saving = true

	local snapshot = deepCopy(profile.Data)
	snapshot.LastSaved = os.time()
	local success = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function()
				return snapshot
			end)
		end)
		if ok then
			success = true
			break
		end
		warn(string.format("[DataService] Не удалось сохранить %s (попытка %d): %s", player.Name, attempt, tostring(err)))
		if attempt < 3 then
			task.wait(attempt)
		end
	end

	profile.Saving = false
	return success
end

-- Сохраняет и забывает игрока (при выходе).
function DataService.Release(player)
	if profiles[player] then
		DataService.Save(player)
		profiles[player] = nil
	end
end

-- Сохраняет всех сразу (при выключении сервера).
function DataService.SaveAll()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			DataService.Save(player)
			pending -= 1
		end)
	end
	local started = os.clock()
	local limit = RunService:IsStudio() and 5 or 25
	while pending > 0 and os.clock() - started < limit do
		task.wait(0.1)
	end
end

function DataService.ForEachLoaded(callback)
	for player, profile in pairs(profiles) do
		callback(player, profile.Data)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EggService</string>
            <string name="Source"><![CDATA[--[[
	EggService — открытие яиц. Подставки строит WorldBuilder, здесь к ним добавляются
	кнопки ProximityPrompt «Открыть ×1» и «Открыть ×3».

	Всё решает сервер: проверка мира, расстояния, денег и места в инвентаре,
	списание монет, выбор питомца по шансам. Клиенту отправляется только результат
	(RemoteEvent EggHatched) — он показывает анимацию.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Eggs = require(Shared.Config.Eggs)
local Worlds = require(Shared.Config.Worlds)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local PetService = require(Modules.PetService)

local EggService = {}

local rng = Random.new()
local lastOpen = {} -- [player] = время последнего открытия
local eggParts = {} -- [eggId] = деталь яйца

function EggService.Open(player, eggId, count)
	local data = DataService.Get(player)
	local egg = Eggs[eggId]
	if not data or not egg or eggId == "Order" then
		return
	end
	count = math.clamp(math.floor(tonumber(count) or 1), 1, GameConfig.MultiOpenCount)

	local now = os.clock()
	if (lastOpen[player] or 0) + GameConfig.EggOpenCooldown > now then
		return
	end
	lastOpen[player] = now

	if not data.UnlockedWorlds[egg.World] then
		PlayerState.Notify(player, "Сначала открой мир «" .. Worlds[egg.World].Name .. "»", "error")
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local eggPart = eggParts[eggId]
	if not root or not eggPart or (root.Position - eggPart.Position).Magnitude > GameConfig.EggOpenDistance then
		PlayerState.Notify(player, "Подойди ближе к яйцу", "error")
		return
	end

	local price = egg.Price * count
	if data.Coins < price then
		PlayerState.Notify(
			player,
			string.format("Не хватает монет: нужно %s, у тебя %s", Format.Number(price), Format.Number(data.Coins)),
			"error"
		)
		return
	end
	if #data.Pets + count > GameConfig.MaxPets then
		PlayerState.Notify(player, string.format("Инвентарь полон (%d/%d). Удали ненужных питомцев", #data.Pets, GameConfig.MaxPets), "error")
		return
	end

	data.Coins -= price
	local results = {}
	for _ = 1, count do
		local petId = Formulas.RollEgg(eggId, rng)
		local pet = PetService.AddPet(player, petId, false)
		if pet then
			PetService.TryAutoEquip(player, pet)
			table.insert(results, { Uid = pet.Uid, Id = petId })
		end
	end
	data.Stats.EggsOpened += count

	PlayerState.SyncPets(player)
	Remotes.EggHatched:FireClient(player, eggId, results)
end

local function addPrompt(eggPart, eggId, count, offsetX, key, gamepadKey)
	local egg = Eggs[eggId]
	local attachment = Instance.new("Attachment")
	attachment.Name = "Prompt" .. count
	attachment.Position = Vector3.new(offsetX, -1.2, -1.5)
	attachment.Parent = eggPart

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Open" .. count
	prompt.ActionText = "Открыть ×" .. count
	prompt.ObjectText = egg.Name .. " • " .. Format.Number(egg.Price * count)
	-- Свой вид кнопки рисует клиент (client/UI/CustomPrompts).
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Price", egg.Price * count)
	prompt:SetAttribute("Icon", "Egg")
	prompt:SetAttribute("Color", count == 1 and Color3.fromRGB(100, 225, 95) or Color3.fromRGB(255, 170, 50))
	prompt.KeyboardKeyCode = key
	prompt.GamepadKeyCode = gamepadKey
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.Parent = attachment

	prompt.Triggered:Connect(function(player)
		EggService.Open(player, eggId, count)
	end)
end

function EggService.PlayerRemoving(player)
	lastOpen[player] = nil
end

function EggService.Init(worldRefs)
	for _, info in pairs(worldRefs) do
		for eggId, eggPart in pairs(info.EggStands) do
			eggParts[eggId] = eggPart
			addPrompt(eggPart, eggId, 1, -3.4, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
			addPrompt(eggPart, eggId, GameConfig.MultiOpenCount, 3.4, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
		end
	end
	Players.PlayerRemoving:Connect(EggService.PlayerRemoving)
end

return EggService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService — инвентарь питомцев: надеть, снять, удалить, «надеть лучших»,
	слияние 5 одинаковых в одного золотого. Всё проверяется на сервере.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Pets = require(Shared.Config.Pets)
local Formulas = require(Shared.Modules.Formulas)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local RateLimiter = require(Modules.RateLimiter)

local PetService = {}

local actionLimiter = RateLimiter.new(8, 10)

local function findPet(data, uid)
	for index, pet in ipairs(data.Pets) do
		if pet.Uid == uid then
			return pet, index
		end
	end
	return nil, nil
end

local function countEquipped(data)
	local count = 0
	for _, pet in ipairs(data.Pets) do
		if pet.Equipped then
			count += 1
		end
	end
	return count
end

local function petName(pet)
	local config = Pets[pet.Id]
	return (pet.Golden and "Золотой " or "") .. config.Name
end

-- Добавляет питомца в инвентарь (без синхронизации — её делает вызывающий код).
function PetService.AddPet(player, petId, golden)
	local data = DataService.Get(player)
	if not data or not Pets[petId] then
		return nil
	end
	local pet = {
		Uid = data.NextPetUid,
		Id = petId,
		Golden = golden == true,
		Equipped = false,
	}
	data.NextPetUid += 1
	table.insert(data.Pets, pet)
	return pet
end

-- Надевает питомца, если есть свободный слот (используется при вылуплении).
function PetService.TryAutoEquip(player, pet)
	local data = DataService.Get(player)
	if data and countEquipped(data) < PlayerState.MaxEquipped(player, data) then
		pet.Equipped = true
		return true
	end
	return false
end

function PetService.Equip(player, uid)
	local data = DataService.Get(player)
	local pet = findPet(data, uid)
	if not pet then
		return false, "Питомец не найден"
	end
	if pet.Equipped then
		return true
	end
	local maxEquipped = PlayerState.MaxEquipped(player, data)
	if countEquipped(data) >= maxEquipped then
		return false, string.format("Все слоты заняты (%d/%d). Сними кого-нибудь или купи +2 слота в магазине", maxEquipped, maxEquipped)
	end
	pet.Equipped = true
	PlayerState.SyncPets(player)
	return true, "Надет: " .. petName(pet)
end

function PetService.Unequip(player, uid)
	local data = DataService.Get(player)
	local pet = findPet(data, uid)
	if not pet then
		return false, "Питомец не найден"
	end
	pet.Equipped = false
	PlayerState.SyncPets(player)
	return true, "Снят: " .. petName(pet)
end

function PetService.Delete(player, uid)
	local data = DataService.Get(player)
	local pet, index = findPet(data, uid)
	if not pet then
		return false, "Питомец не найден"
	end
	table.remove(data.Pets, index)
	PlayerState.SyncPets(player)
	return true, "Удалён: " .. petName(pet)
end

function PetService.EquipBest(player)
	local data = DataService.Get(player)
	local sorted = table.clone(data.Pets)
	table.sort(sorted, function(a, b)
		local ma, mb = Formulas.PetMultiplier(a.Id, a.Golden), Formulas.PetMultiplier(b.Id, b.Golden)
		if ma ~= mb then
			return ma > mb
		end
		return a.Uid < b.Uid
	end)
	for _, pet in ipairs(data.Pets) do
		pet.Equipped = false
	end
	local maxEquipped = PlayerState.MaxEquipped(player, data)
	for index = 1, math.min(maxEquipped, #sorted) do
		sorted[index].Equipped = true
	end
	PlayerState.SyncPets(player)
	if #sorted == 0 then
		return false, "У тебя пока нет питомцев — открой яйцо!"
	end
	return true, "Надеты лучшие питомцы"
end

-- 5 одинаковых обычных питомцев -> 1 золотой (множитель ×2).
function PetService.Merge(player, uid)
	local data = DataService.Get(player)
	local pet = findPet(data, uid)
	if not pet then
		return false, "Питомец не найден"
	end
	if pet.Golden then
		return false, "Этот питомец уже золотой"
	end

	local candidates = {}
	for _, other in ipairs(data.Pets) do
		if other.Id == pet.Id and not other.Golden then
			table.insert(candidates, other)
		end
	end
	local need = GameConfig.GoldenMergeCount
	if #candidates < need then
		return false, string.format("Нужно %d одинаковых: у тебя %d из %d", need, #candidates, need)
	end

	-- Сначала забираем ненадетых, выбранного питомца — в любом случае.
	table.sort(candidates, function(a, b)
		if (a == pet) ~= (b == pet) then
			return a == pet
		end
		if a.Equipped ~= b.Equipped then
			return not a.Equipped
		end
		return a.Uid < b.Uid
	end)
	local used = {}
	local wasEquipped = false
	for index = 1, need do
		used[candidates[index]] = true
		wasEquipped = wasEquipped or candidates[index].Equipped
	end
	local remaining = {}
	for _, other in ipairs(data.Pets) do
		if not used[other] then
			table.insert(remaining, other)
		end
	end
	data.Pets = remaining

	local golden = PetService.AddPet(player, pet.Id, true)
	if wasEquipped then
		golden.Equipped = true
	else
		PetService.TryAutoEquip(player, golden)
	end
	PlayerState.SyncPets(player)
	PlayerState.Effect(player, "Merge", { PetId = pet.Id, Uid = golden.Uid })
	return true, "Получен " .. petName(golden) .. "!"
end

local ACTIONS = {
	Equip = PetService.Equip,
	Unequip = PetService.Unequip,
	Delete = PetService.Delete,
	Merge = PetService.Merge,
	EquipBest = PetService.EquipBest,
}

function PetService.PlayerRemoving(player)
	actionLimiter:Remove(player)
end

function PetService.Init()
	Remotes.PetAction.OnServerInvoke = function(player, action, uid)
		if not DataService.Get(player) then
			return false, "Данные ещё загружаются…"
		end
		if not actionLimiter:Allow(player) then
			return false, "Не так быстро!"
		end
		local handler = type(action) == "string" and ACTIONS[action]
		if not handler then
			return false, "Неизвестное действие"
		end
		if action ~= "EquipBest" and type(uid) ~= "number" then
			return false, "Неверный питомец"
		end
		return handler(player, uid)
	end

	Remotes.GetInventory.OnServerInvoke = function(player)
		local started = os.clock()
		while not DataService.Get(player) and player.Parent and os.clock() - started < 30 do
			task.wait(0.25)
		end
		return PlayerState.InventorySnapshot(player)
	end
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PlayerState</string>
            <string name="Source"><![CDATA[--[[
	PlayerState — связывает данные игрока с тем, что видят клиенты:
	- leaderstats (Сила, Перерождения) для таблицы лидеров;
	- атрибуты игрока (Strength, Coins, ClickPower, EquippedPets, …) — их читает интерфейс
	  и все клиенты (чтобы рисовать чужих питомцев);
	- список питомцев (RemoteEvent InventoryChanged);
	- уведомления и эффекты.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Worlds = require(Shared.Config.Worlds)
local Backpacks = require(Shared.Config.Backpacks)
local Formulas = require(Shared.Modules.Formulas)
local Remotes = require(Shared.Modules.Remotes)

local DataService = require(script.Parent.DataService)

local PlayerState = {}

local petMultipliers = {} -- [player] = общий множитель питомцев
local ownsGamepass = {} -- [player] = true, если куплен настоящий геймпасс

function PlayerState.Setup(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local strength = Instance.new("IntValue")
	strength.Name = "Сила"
	strength.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Перерождения"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

function PlayerState.SetOwnsGamepass(player, owns)
	ownsGamepass[player] = owns == true
end

function PlayerState.HasPetSlots(player, data)
	if GameConfig.PetSlotsGamepassId == 0 then
		return data.PetSlotsPass == true
	end
	return ownsGamepass[player] == true
end

function PlayerState.MaxEquipped(player, data)
	data = data or DataService.Get(player)
	if data and PlayerState.HasPetSlots(player, data) then
		return GameConfig.GamepassEquipSlots
	end
	return GameConfig.BaseEquipSlots
end

function PlayerState.GetClickPower(player)
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	return Formulas.ClickPower(petMultipliers[player] or 1, data.Rebirths)
end

local function unlockedList(data)
	local list = {}
	for _, worldId in ipairs(Worlds.Order) do
		if data.UnlockedWorlds[worldId] then
			table.insert(list, worldId)
		end
	end
	return table.concat(list, ",")
end

-- Обновляет числа: атрибуты и leaderstats. Вызывается после любого изменения валют.
function PlayerState.SyncStats(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local backpack = Backpacks[data.BackpackLevel]

	player:SetAttribute("Strength", data.Strength)
	player:SetAttribute("Capacity", backpack.Capacity)
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("TotalStrength", data.TotalStrength)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("BackpackLevel", data.BackpackLevel)
	player:SetAttribute("World", data.CurrentWorld)
	player:SetAttribute("UnlockedWorlds", unlockedList(data))
	player:SetAttribute("RebirthMultiplier", Formulas.RebirthMultiplier(data.Rebirths))
	player:SetAttribute("PetMultiplier", petMultipliers[player] or 1)
	player:SetAttribute("ClickPower", PlayerState.GetClickPower(player))
	player:SetAttribute("PetSlotsPass", PlayerState.HasPetSlots(player, data))
	player:SetAttribute("MaxEquipped", PlayerState.MaxEquipped(player, data))

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local strength = leaderstats:FindFirstChild("Сила")
		local rebirths = leaderstats:FindFirstChild("Перерождения")
		if strength then
			strength.Value = math.floor(data.TotalStrength)
		end
		if rebirths then
			rebirths.Value = data.Rebirths
		end
	end
end

function PlayerState.InventorySnapshot(player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local list = table.create(#data.Pets)
	for index, pet in ipairs(data.Pets) do
		list[index] = {
			Uid = pet.Uid,
			Id = pet.Id,
			Golden = pet.Golden,
			Equipped = pet.Equipped,
		}
	end
	return list
end

-- Пересчитывает всё, что связано с питомцами, и отправляет инвентарь клиенту.
function PlayerState.SyncPets(player)
	local data = DataService.Get(player)
	if not data then
		return
	end

	-- Если слотов стало меньше (например, геймпасс пропал) — снимаем лишних.
	local maxEquipped = PlayerState.MaxEquipped(player, data)
	local equipped = 0
	local parts = {}
	for _, pet in ipairs(data.Pets) do
		if pet.Equipped then
			equipped += 1
			if equipped > maxEquipped then
				pet.Equipped = false
			else
				table.insert(parts, pet.Id .. ":" .. (pet.Golden and "1" or "0"))
			end
		end
	end

	petMultipliers[player] = Formulas.TotalPetMultiplier(data.Pets)
	player:SetAttribute("EquippedPets", table.concat(parts, ","))
	player:SetAttribute("PetCount", #data.Pets)

	Remotes.InventoryChanged:FireClient(player, PlayerState.InventorySnapshot(player))
	PlayerState.SyncStats(player)
end

function PlayerState.Notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function PlayerState.Effect(player, kind, payload)
	Remotes.Effect:FireClient(player, kind, payload or {})
end

function PlayerState.Remove(player)
	petMultipliers[player] = nil
	ownsGamepass[player] = nil
end

return PlayerState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--[[
	RateLimiter — «ведро с жетонами» для защиты от спама запросами.
	rate  — сколько действий в секунду разрешено в среднем
	burst — сколько можно сделать подряд после паузы
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(rate, burst)
	return setmetatable({
		Rate = rate,
		Burst = burst or rate,
		Buckets = {},
	}, RateLimiter)
end

function RateLimiter:Allow(player)
	local now = os.clock()
	local bucket = self.Buckets[player]
	if not bucket then
		bucket = { Tokens = self.Burst, Time = now }
		self.Buckets[player] = bucket
	end
	bucket.Tokens = math.min(self.Burst, bucket.Tokens + (now - bucket.Time) * self.Rate)
	bucket.Time = now
	if bucket.Tokens >= 1 then
		bucket.Tokens -= 1
		return true
	end
	return false
end

function RateLimiter:Remove(player)
	self.Buckets[player] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--[[
	RebirthService — перерождение.
	Сбрасывает силу, накопленную силу и монеты, навсегда даёт +50% к силе за клик.
	Питомцы, рюкзак и открытые миры остаются.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local RateLimiter = require(Modules.RateLimiter)

local RebirthService = {}

local rebirthLimiter = RateLimiter.new(1, 2)

function RebirthService.Rebirth(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Данные ещё загружаются…"
	end
	local cost = Formulas.RebirthCost(data.Rebirths)
	if data.TotalStrength < cost then
		return false, string.format("Нужно ещё %s накопленной силы", Format.Number(cost - data.TotalStrength))
	end

	data.Rebirths += 1
	data.Strength = 0
	data.TotalStrength = 0
	data.Coins = 0
	PlayerState.SyncPets(player)
	PlayerState.Effect(player, "Rebirth", { Rebirths = data.Rebirths })
	return true, string.format("Перерождение #%d! Бонус к силе теперь %s", data.Rebirths, Format.Multiplier(Formulas.RebirthMultiplier(data.Rebirths)))
end

function RebirthService.Init()
	Remotes.Rebirth.OnServerInvoke = function(player)
		if not rebirthLimiter:Allow(player) then
			return false, "Не так быстро!"
		end
		return RebirthService.Rebirth(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		rebirthLimiter:Remove(player)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService — магазин: рюкзаки за монеты и геймпасс «+2 слота питомцев».

	Геймпасс: если GameConfig.PetSlotsGamepassId = 0, это заглушка — кнопка выдаёт слоты
	бесплатно (флаг PetSlotsPass сохраняется в данных). Когда впишешь настоящий ID,
	заработает покупка за Robux через MarketplaceService, а тестовый флаг перестанет учитываться.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Backpacks = require(Shared.Config.Backpacks)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local RateLimiter = require(Modules.RateLimiter)

local ShopService = {}

local shopLimiter = RateLimiter.new(4, 6)

function ShopService.BuyBackpack(player, level)
	local data = DataService.Get(player)
	if not data then
		return false, "Данные ещё загружаются…"
	end
	if type(level) ~= "number" then
		return false, "Неверный рюкзак"
	end
	level = math.floor(level)
	if level <= data.BackpackLevel then
		return false, "Этот рюкзак уже есть"
	end
	if level ~= data.BackpackLevel + 1 then
		return false, "Сначала купи предыдущий рюкзак"
	end
	local backpack = Backpacks[level]
	if not backpack then
		return false, "Это самый большой рюкзак"
	end
	if data.Coins < backpack.Price then
		return false, string.format("Не хватает монет: нужно %s", Format.Number(backpack.Price))
	end
	data.Coins -= backpack.Price
	data.BackpackLevel = level
	PlayerState.SyncStats(player)
	PlayerState.Effect(player, "Purchase", { Kind = "Backpack", Level = level })
	return true, string.format("Куплен «%s»: вмещает %s силы", backpack.Name, Format.Number(backpack.Capacity))
end

local function grantPetSlots(player)
	PlayerState.SyncPets(player)
	PlayerState.Effect(player, "Purchase", { Kind = "PetSlots" })
end

function ShopService.BuyPetSlots(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Данные ещё загружаются…"
	end
	if PlayerState.HasPetSlots(player, data) then
		return false, "Уже куплено"
	end

	local gamepassId = GameConfig.PetSlotsGamepassId
	if gamepassId == 0 then
		data.PetSlotsPass = true
		grantPetSlots(player)
		return true, "Тестовый геймпасс: теперь можно надеть " .. GameConfig.GamepassEquipSlots .. " питомцев!"
	end

	MarketplaceService:PromptGamePassPurchase(player, gamepassId)
	return true, nil
end

-- Проверка настоящего геймпасса при входе.
function ShopService.PlayerLoaded(player)
	local gamepassId = GameConfig.PetSlotsGamepassId
	if gamepassId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)
	PlayerState.SetOwnsGamepass(player, ok and owns)
end

function ShopService.PlayerRemoving(player)
	shopLimiter:Remove(player)
end

function ShopService.Init()
	Remotes.BuyBackpack.OnServerInvoke = function(player, level)
		if not shopLimiter:Allow(player) then
			return false, "Не так быстро!"
		end
		return ShopService.BuyBackpack(player, level)
	end

	Remotes.BuyPetSlots.OnServerInvoke = function(player)
		if not shopLimiter:Allow(player) then
			return false, "Не так быстро!"
		end
		return ShopService.BuyPetSlots(player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamepassId, purchased)
		if purchased and gamepassId == GameConfig.PetSlotsGamepassId and gamepassId ~= 0 then
			PlayerState.SetOwnsGamepass(player, true)
			grantPetSlots(player)
			PlayerState.Notify(player, "Спасибо за покупку! Теперь можно надеть " .. GameConfig.GamepassEquipSlots .. " питомцев", "success")
		end
	end)

	Players.PlayerRemoving:Connect(ShopService.PlayerRemoving)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">SoundLibrary</string>
            <string name="Source"><![CDATA[--[[
	SoundLibrary — подбирает звуки и музыку из библиотеки Roblox (Creator Store).
	Для каждого звука из Config/Sounds без ручного Id сервер ищет несколько кандидатов
	через AssetService:SearchAudioAsync и кладёт их в ReplicatedStorage.SoundLibrary
	(атрибут Candidates = "id1,id2,..."). Клиент проверяет, какой загружается, и берёт первый рабочий.
	Если поиск недоступен, клиент использует встроенные звуки (Fallback).
]]

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))

local SoundLibrary = {}

local MAX_CANDIDATES = 6

-- Чем «надёжнее» звук, тем выше он в списке: одобренные Roblox и звуки от самой Roblox.
local function score(item)
	local value = 0
	if item.IsEndorsed then
		value += 2
	end
	local creator = item.Creator
	if type(creator) == "table" then
		if creator.Name == "Roblox" or creator.Id == 1 then
			value += 3
		end
		if creator.HasVerifiedBadge or creator.IsVerified then
			value += 1
		end
	end
	return value
end

local function search(entry, isMusic)
	local ok, result = pcall(function()
		local params = Instance.new("AudioSearchParams")
		params.SearchKeyword = entry.Search
		params.AudioSubType = isMusic and Enum.AudioSubType.Music or Enum.AudioSubType.SoundEffect
		if entry.MaxDuration then
			params.MaxDuration = entry.MaxDuration
		end
		if entry.MinDuration then
			params.MinDuration = entry.MinDuration
		end
		local pages = AssetService:SearchAudioAsync(params)
		return pages:GetCurrentPage()
	end)
	if not ok or type(result) ~= "table" then
		return {}, tostring(result)
	end
	local items = {}
	for index, item in ipairs(result) do
		local id = type(item) == "table" and tonumber(item.Id or item.AssetId)
		if id then
			table.insert(items, { Id = id, Score = score(item), Index = index })
		end
	end
	table.sort(items, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Index < b.Index
	end)
	local ids = {}
	for index = 1, math.min(MAX_CANDIDATES, #items) do
		table.insert(ids, "rbxassetid://" .. items[index].Id)
	end
	return ids
end

function SoundLibrary.Init()
	local folder = Instance.new("Folder")
	folder.Name = "SoundLibrary"

	local function addEntry(name, entry, isMusic)
		local value = Instance.new("StringValue")
		value.Name = name
		value.Value = entry.Id or ""
		value:SetAttribute("IsMusic", isMusic)
		value:SetAttribute("Candidates", "")
		value.Parent = folder
		return value
	end

	local jobs = {}
	for name, entry in pairs(SoundConfig.Effects) do
		table.insert(jobs, { Value = addEntry(name, entry, false), Entry = entry, IsMusic = false })
	end
	for worldId, entry in pairs(SoundConfig.Music) do
		table.insert(jobs, { Value = addEntry("Music_" .. worldId, entry, true), Entry = entry, IsMusic = true })
	end
	folder.Parent = ReplicatedStorage

	-- Поиск идёт в фоне и не задерживает запуск игры.
	task.spawn(function()
		local failures = 0
		for _, job in ipairs(jobs) do
			if (job.Entry.Id or "") == "" and job.Entry.Search then
				local ids, err = search(job.Entry, job.IsMusic)
				if #ids > 0 then
					job.Value:SetAttribute("Candidates", table.concat(ids, ","))
				else
					failures += 1
					if failures == 1 and err then
						warn("[SoundLibrary] Поиск звуков недоступен, будут встроенные звуки:", err)
					end
				end
				task.wait(0.2)
			end
			job.Value:SetAttribute("Ready", true)
		end
		folder:SetAttribute("Ready", true)
	end)
end

return SoundLibrary
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="30">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Build</string>
              <string name="Source"><![CDATA[--[[
	Build — помощники для строительства миров: детали, надписи, рельеф (Terrain),
	поиск высоты земли и расстановка декора без наложений.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Modules.Format)

local Build = {}

Build.HALF = 130 -- половина стороны игровой зоны: невидимые стены стоят на ±HALF
Build.VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- делает цилиндр вертикальным
Build.WHITE = Color3.new(1, 1, 1)
Build.INK = Color3.fromRGB(32, 26, 58)
Build.FONT = Font.new(Font.fromEnum(Enum.Font.Nunito).Family, Enum.FontWeight.Heavy)
Build.Format = Format

-- Главные точки каждого мира (относительно центра мира).
Build.LAYOUT = {
	Spawn = Vector3.new(0, 0, 70),
	Fountain = Vector3.new(-24, 0, 72),
	ShopStall = Vector3.new(26, 0, 74),
	WelcomeArch = Vector3.new(0, 0, 50),
	NextPortal = Vector3.new(0, 0, -112),
	BackPortal = Vector3.new(0, 0, 118),
	Sell = Vector3.new(-45, 0, 35),
	EggPlaza = Vector3.new(40, 0, 20),
}

-- Зоны, где нельзя ставить декор. Coins = true — монеты там появляться могут (тропинки).
Build.RESERVED = {
	{ Kind = "Rect", MinX = -10, MaxX = 10, MinZ = -128, MaxZ = 128, Coins = true },
	{ Kind = "Rect", MinX = -52, MaxX = 0, MinZ = 29, MaxZ = 41, Coins = true },
	{ Kind = "Rect", MinX = 0, MaxX = 44, MinZ = 14, MaxZ = 26, Coins = true },
	{ Kind = "Circle", X = 0, Z = 70, R = 38 },
	{ Kind = "Circle", X = -46, Z = 42, R = 22 },
	{ Kind = "Circle", X = 40, Z = 20, R = 25 },
	{ Kind = "Circle", X = 0, Z = -112, R = 18 },
	{ Kind = "Circle", X = 0, Z = 118, R = 16 },
}

------------------------------------------------------------------ ДЕТАЛИ

function Build.part(parent, props)
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "ClassName" and key ~= "Mesh" and key ~= "Tags" then
			part[key] = value
		end
	end
	if props.Mesh then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = props.Mesh
		mesh.Parent = part
	end
	part.Parent = parent
	return part
end

function Build.folder(name, parent)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function Build.model(name, parent)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.cylinderBetween(parent, a, b, diameter, color, material)
	local length = (b - a).Magnitude
	return Build.part(parent, {
		Name = "Cylinder",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, diameter, diameter),
		CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

-- Вертикальный цилиндр (диск), position — его центр.
function Build.disc(parent, position, diameter, height, color, props)
	local data = {
		Name = "Disc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(position) * Build.VERTICAL,
		Color = color,
	}
	for key, value in pairs(props or {}) do
		data[key] = value
	end
	return Build.part(parent, data)
end

-- Двускатная крыша: конёк вдоль оси X системы cframe (cframe — центр основания крыши).
function Build.roof(parent, cframe, width, depth, height, color, material)
	for _, side in ipairs({ -1, 1 }) do
		Build.part(parent, {
			ClassName = "WedgePart",
			Name = "Roof",
			Size = Vector3.new(width, height, depth / 2),
			CFrame = cframe * CFrame.new(0, height / 2, side * depth / 4) * CFrame.Angles(0, side == 1 and math.pi or 0, 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		})
	end
end

function Build.light(part, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1
	light.Shadows = false
	light.Parent = part
	return light
end

------------------------------------------------------------------ НАДПИСИ

function Build.billboard(adornee, sizeStuds, offset, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Billboard"
	gui.Size = UDim2.new(sizeStuds.X, 0, sizeStuds.Y, 0)
	gui.StudsOffsetWorldSpace = offset
	gui.MaxDistance = maxDistance or 150
	gui.LightInfluence = 0
	gui.Parent = adornee
	return gui
end

function Build.line(parent, text, color, heightScale, order, name)
	local label = Instance.new("TextLabel")
	label.Name = name or ("Line" .. order)
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, heightScale)
	label.FontFace = Build.FONT
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.LayoutOrder = order
	local stroke = Instance.new("UIStroke")
	stroke.Color = Build.INK
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = parent
	return label
end

function Build.list(parent, padding)
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(padding or 0, 0)
	list.Parent = parent
	return list
end

-- Надпись на грани детали (вывески).
function Build.sign(part, face, text, textColor, backgroundColor)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	gui.Parent = part
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = backgroundColor or Build.INK
	frame.BackgroundTransparency = backgroundColor and 0 or 1
	frame.Parent = gui
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.8)
	label.Position = UDim2.fromScale(0.04, 0.1)
	label.FontFace = Build.FONT
	label.Text = text
	label.TextColor3 = textColor or Build.WHITE
	label.TextScaled = true
	label.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = Build.INK
	stroke.Thickness = 6
	stroke.Parent = label
	return gui
end

------------------------------------------------------------------ РЕЛЬЕФ (TERRAIN)

function Build.terrainBlock(cframe, size, material)
	Workspace.Terrain:FillBlock(cframe, size, material)
end

function Build.terrainBall(center, radius, material)
	Workspace.Terrain:FillBall(center, radius, material)
end

function Build.terrainCylinder(cframe, height, radius, material)
	Workspace.Terrain:FillCylinder(cframe, height, radius, material)
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = false

-- Высота земли (Terrain) в точке мира; nil, если там пусто. Второе значение — материал.
function Build.groundAt(position, fallbackY)
	groundParams.FilterDescendantsInstances = { Workspace.Terrain }
	local origin = Vector3.new(position.X, position.Y + 120, position.Z)
	local result = Workspace:Raycast(origin, Vector3.new(0, -260, 0), groundParams)
	if result then
		return result.Position.Y, result.Material
	end
	return fallbackY, nil
end

------------------------------------------------------------------ РАССТАНОВКА

function Build.isFree(ctx, x, z, radius, forCoin)
	local half = Build.HALF
	if math.abs(x) > half - 4 - radius or math.abs(z) > half - 4 - radius then
		return false
	end
	for _, zone in ipairs(Build.RESERVED) do
		if not (forCoin and zone.Coins) then
			if zone.Kind == "Rect" then
				if x + radius > zone.MinX and x - radius < zone.MaxX and z + radius > zone.MinZ and z - radius < zone.MaxZ then
					return false
				end
			else
				local dx, dz = x - zone.X, z - zone.Z
				if dx * dx + dz * dz < (zone.R + radius) ^ 2 then
					return false
				end
			end
		end
	end
	for _, obstacle in ipairs(ctx.Obstacles) do
		local dx, dz = x - obstacle.X, z - obstacle.Z
		if dx * dx + dz * dz < (obstacle.R + radius) ^ 2 then
			return false
		end
	end
	return true
end

function Build.addObstacle(ctx, x, z, radius)
	table.insert(ctx.Obstacles, { X = x, Z = z, R = radius })
end

-- Ставит count объектов в свободные места игровой зоны. place(позиция на земле) -> радиус.
function Build.scatter(ctx, count, radius, place)
	local placed = 0
	local half = Build.HALF
	for _ = 1, count * 15 do
		if placed >= count then
			break
		end
		local x = ctx.Rng:NextNumber(-half, half)
		local z = ctx.Rng:NextNumber(-half, half)
		if Build.isFree(ctx, x, z, radius, false) then
			local groundY, material = Build.groundAt(ctx.Origin + Vector3.new(x, 0, z), ctx.Origin.Y)
			if material ~= Enum.Material.Water then
				local actualRadius = place(Vector3.new(ctx.Origin.X + x, groundY, ctx.Origin.Z + z)) or radius
				Build.addObstacle(ctx, x, z, actualRadius)
				placed += 1
			end
		end
	end
	return placed
end

-- Случайная точка за стенами (декор по краям мира).
function Build.borderPoint(rng, inner, outer)
	for _ = 1, 100 do
		local x = rng:NextNumber(-outer, outer)
		local z = rng:NextNumber(-outer, outer)
		if math.max(math.abs(x), math.abs(z)) >= inner then
			return x, z
		end
	end
	return inner, inner
end

return Build
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Props</string>
              <string name="Source"><![CDATA[--[[
	Props — декор для миров, собранный из деталей.
	Каждая функция получает parent, позицию на земле, генератор случайных чисел (rng)
	и цвета, и возвращает радиус занятого места (чтобы декор не налезал друг на друга).
]]

local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)

local Props = {}

local part = Build.part
local VERTICAL = Build.VERTICAL
local WHITE = Build.WHITE

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

local function vary(color, rng, amount)
	amount = amount or 0.08
	local shift = rng:NextNumber(-amount, amount)
	if shift > 0 then
		return color:Lerp(WHITE, shift)
	end
	return color:Lerp(Color3.new(0, 0, 0), -shift)
end

------------------------------------------------------------------ ЛЕС

-- Пышное дерево из нескольких крон.
function Props.oak(parent, position, rng, palette, scale)
	scale = scale or 1
	local height = rng:NextNumber(8, 12) * scale
	local width = rng:NextNumber(1.8, 2.4) * scale
	local trunkColor = palette.Trunk
	part(parent, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, width, width),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2 - 0.5, 0)) * VERTICAL,
		Color = trunkColor,
		Material = Enum.Material.Wood,
	})
	-- корни
	for i = 1, 3 do
		local angle = i / 3 * math.pi * 2 + rng:NextNumber(0, 1)
		Build.cylinderBetween(
			parent,
			position + Vector3.new(0, 1.6 * scale, 0),
			position + Vector3.new(math.cos(angle) * 2.2 * scale, -0.2, math.sin(angle) * 2.2 * scale),
			0.8 * scale,
			trunkColor,
			Enum.Material.Wood
		)
	end
	-- ветка
	local branchAngle = rng:NextNumber(0, math.pi * 2)
	Build.cylinderBetween(
		parent,
		position + Vector3.new(0, height * 0.6, 0),
		position + Vector3.new(math.cos(branchAngle) * 3 * scale, height * 0.82, math.sin(branchAngle) * 3 * scale),
		0.7 * scale,
		trunkColor,
		Enum.Material.Wood
	)
	local leaves = pick(rng, palette.Leaves)
	local size = rng:NextNumber(8, 11) * scale
	local top = position + Vector3.new(0, height, 0)
	local clusters = {
		{ Vector3.new(0, size * 0.25, 0), 1 },
		{ Vector3.new(size * 0.38, size * 0.05, size * 0.1), 0.72 },
		{ Vector3.new(-size * 0.35, 0, -size * 0.18), 0.7 },
		{ Vector3.new(0.1 * size, size * 0.55, -0.15 * size), 0.62 },
		{ Vector3.new(-0.15 * size, -0.05 * size, size * 0.35), 0.6 },
	}
	for index, cluster in ipairs(clusters) do
		local color = index % 2 == 0 and leaves:Lerp(WHITE, 0.08) or leaves:Lerp(Color3.new(0, 0, 0), 0.04 * index)
		part(parent, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * cluster[2],
			CFrame = CFrame.new(top + cluster[1]),
			Color = color,
			Material = Enum.Material.Grass,
		})
	end
	-- яблочки
	if rng:NextNumber() < 0.5 then
		for _ = 1, 4 do
			local direction = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 0.6), rng:NextNumber(-1, 1)).Unit
			part(parent, {
				Name = "Fruit",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.8 * scale,
				CFrame = CFrame.new(top + Vector3.new(0, size * 0.2, 0) + direction * size * 0.48),
				Color = rgb(255, 70, 80),
				CanCollide = false,
			})
		end
	end
	return size * 0.5
end

-- Ёлка из сплюснутых ярусов.
function Props.pine(parent, position, rng, palette, scale)
	scale = scale or 1
	local trunkHeight = 4 * scale
	part(parent, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight + 2, 1.6 * scale, 1.6 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * VERTICAL,
		Color = palette.Trunk:Lerp(Color3.new(0, 0, 0), 0.15),
		Material = Enum.Material.Wood,
	})
	local green = palette.Pine or rgb(40, 130, 80)
	local tiers = { { 11, 4.2 }, { 8.6, 3.8 }, { 6.2, 3.4 }, { 3.8, 3 } }
	local y = trunkHeight
	local spin = rng:NextNumber(0, math.pi)
	for index, tier in ipairs(tiers) do
		local width = tier[1] * scale
		local height = tier[2] * scale
		part(parent, {
			Name = "PineTier",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position + Vector3.new(0, y + height * 0.35, 0)) * CFrame.Angles(0, spin + index, 0),
			Color = green:Lerp(WHITE, index * 0.05),
			Material = Enum.Material.Grass,
			Mesh = Enum.MeshType.Sphere,
		})
		y += height * 0.62
	end
	part(parent, {
		Name = "PineTop",
		Size = Vector3.new(1.6, 2.6, 1.6) * scale,
		CFrame = CFrame.new(position + Vector3.new(0, y + 1.1 * scale, 0)),
		Color = green:Lerp(WHITE, 0.25),
		Material = Enum.Material.Grass,
		Mesh = Enum.MeshType.Sphere,
	})
	return 5.5 * scale
end

-- Берёзка: белый ствол с полосками.
function Props.birch(parent, position, rng, palette, scale)
	scale = scale or 1
	local height = rng:NextNumber(10, 13) * scale
	part(parent, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 1.3 * scale, 1.3 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * VERTICAL,
		Color = rgb(245, 242, 235),
		Material = Enum.Material.SmoothPlastic,
	})
	for i = 1, 5 do
		part(parent, {
			Name = "Stripe",
			Size = Vector3.new(0.5, 0.35, 1.36) * scale,
			CFrame = CFrame.new(position + Vector3.new(0, i * height / 6, 0)) * CFrame.Angles(0, i * 1.3, 0) * CFrame.new(0.45 * scale, 0, 0),
			Color = rgb(40, 40, 45),
			CanCollide = false,
		})
	end
	local leaves = palette.Birch or rgb(150, 220, 90)
	for i = 1, 3 do
		local size = rng:NextNumber(5, 7) * scale
		part(parent, {
			Name = "Leaves",
			Size = Vector3.new(size, size * 1.3, size),
			CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-1.5, 1.5) * scale, height - 1 + i * 1.6 * scale, rng:NextNumber(-1.5, 1.5) * scale)),
			Color = leaves:Lerp(WHITE, i * 0.05),
			Material = Enum.Material.Grass,
			Mesh = Enum.MeshType.Sphere,
		})
	end
	return 3.5 * scale
end

function Props.bush(parent, position, rng, palette)
	local size = rng:NextNumber(3.5, 5.5)
	local color = pick(rng, palette.Leaves)
	for i = 1, 3 do
		local offset = Vector3.new(rng:NextNumber(-1, 1) * size * 0.35, 0, rng:NextNumber(-1, 1) * size * 0.35)
		part(parent, {
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * (1 - i * 0.15),
			CFrame = CFrame.new(position + offset + Vector3.new(0, size * 0.22, 0)),
			Color = color:Lerp(WHITE, i * 0.05),
			Material = Enum.Material.Grass,
		})
	end
	if rng:NextNumber() < 0.6 then
		local berry = pick(rng, { rgb(255, 70, 90), rgb(120, 90, 255), rgb(255, 160, 40) })
		for _ = 1, 5 do
			local angle = rng:NextNumber(0, math.pi * 2)
			part(parent, {
				Name = "Berry",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.55,
				CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * size * 0.45, size * rng:NextNumber(0.3, 0.6), math.sin(angle) * size * 0.45)),
				Color = berry,
				CanCollide = false,
			})
		end
	end
	return size * 0.6
end

-- Полянка цветов.
function Props.flowers(parent, position, rng, palette, count)
	local color = pick(rng, palette.Flowers)
	for _ = 1, count or 7 do
		local offset = Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		local height = rng:NextNumber(0.9, 1.6)
		local base = position + offset
		part(parent, {
			Name = "Stem",
			Size = Vector3.new(0.15, height, 0.15),
			CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)),
			Color = rgb(70, 150, 60),
			CanCollide = false,
			CastShadow = false,
		})
		part(parent, {
			Name = "Petals",
			Size = Vector3.new(1.1, 0.4, 1.1),
			CFrame = CFrame.new(base + Vector3.new(0, height, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Color = vary(color, rng),
			Mesh = Enum.MeshType.Sphere,
			CanCollide = false,
			CastShadow = false,
		})
		part(parent, {
			Name = "Center",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.45,
			CFrame = CFrame.new(base + Vector3.new(0, height + 0.15, 0)),
			Color = rgb(255, 225, 80),
			CanCollide = false,
			CastShadow = false,
		})
	end
	return 3
end

function Props.rock(parent, position, rng, color, mossColor)
	local size = Vector3.new(rng:NextNumber(3, 6), rng:NextNumber(2, 3.5), rng:NextNumber(3, 5))
	local rotation = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	part(parent, {
		Name = "Rock",
		Size = size,
		CFrame = CFrame.new(position + Vector3.new(0, size.Y * 0.3, 0)) * rotation,
		Color = vary(color, rng),
		Material = Enum.Material.Slate,
		Mesh = Enum.MeshType.Sphere,
	})
	if mossColor then
		part(parent, {
			Name = "Moss",
			Size = Vector3.new(size.X * 0.8, size.Y * 0.35, size.Z * 0.8),
			CFrame = CFrame.new(position + Vector3.new(0, size.Y * 0.72, 0)) * rotation,
			Color = mossColor,
			Material = Enum.Material.Grass,
			Mesh = Enum.MeshType.Sphere,
			CanCollide = false,
		})
	end
	-- маленький камешек рядом
	part(parent, {
		Name = "Pebble",
		Size = size * 0.4,
		CFrame = CFrame.new(position + Vector3.new(size.X * 0.55, size.Y * 0.1, size.Z * 0.2)) * rotation,
		Color = vary(color, rng),
		Material = Enum.Material.Slate,
		Mesh = Enum.MeshType.Sphere,
	})
	return math.max(size.X, size.Z) * 0.6
end

function Props.mushroom(parent, position, rng, scale)
	scale = scale or 1
	local height = rng:NextNumber(3, 5.5) * scale
	local capSize = rng:NextNumber(4.5, 6.5) * scale
	part(parent, {
		Name = "Stem",
		Size = Vector3.new(1.6, height, 1.6) * Vector3.new(scale, 1, scale),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)),
		Color = rgb(250, 242, 225),
		Mesh = Enum.MeshType.Sphere,
	})
	local capColor = rng:NextNumber() < 0.65 and rgb(240, 60, 70) or pick(rng, { rgb(255, 160, 40), rgb(170, 110, 255) })
	local capCenter = position + Vector3.new(0, height, 0)
	part(parent, {
		Name = "Cap",
		Size = Vector3.new(capSize, capSize * 0.55, capSize),
		CFrame = CFrame.new(capCenter),
		Color = capColor,
		Mesh = Enum.MeshType.Sphere,
	})
	for i = 1, 6 do
		local angle = (i / 6) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local radius = capSize * rng:NextNumber(0.18, 0.32)
		part(parent, {
			Name = "Dot",
			Size = Vector3.new(capSize * 0.17, capSize * 0.08, capSize * 0.17),
			CFrame = CFrame.new(capCenter + Vector3.new(math.cos(angle) * radius, capSize * 0.22, math.sin(angle) * radius)),
			Color = WHITE,
			Mesh = Enum.MeshType.Sphere,
			CanCollide = false,
		})
	end
	return capSize * 0.5
end

function Props.log(parent, position, rng, palette)
	local length = rng:NextNumber(6, 9)
	local yaw = rng:NextNumber(0, math.pi)
	local cframe = CFrame.new(position + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, yaw, 0)
	part(parent, {
		Name = "Log",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, 2, 2),
		CFrame = cframe,
		Color = palette.Trunk,
		Material = Enum.Material.Wood,
	})
	for _, side in ipairs({ -1, 1 }) do
		part(parent, {
			Name = "LogEnd",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 1.7, 1.7),
			CFrame = cframe * CFrame.new(side * length / 2, 0, 0),
			Color = rgb(225, 185, 130),
			Material = Enum.Material.WoodPlanks,
		})
	end
	part(parent, {
		Name = "LogMoss",
		Size = Vector3.new(length * 0.5, 0.5, 1.6),
		CFrame = cframe * CFrame.new(rng:NextNumber(-1, 1), 0.9, 0),
		Color = rgb(90, 170, 70),
		Material = Enum.Material.Grass,
		Mesh = Enum.MeshType.Sphere,
		CanCollide = false,
	})
	return length * 0.5
end

-- Фонарь на столбе (светится тёплым светом).
function Props.lantern(parent, position, color, height)
	height = height or 7
	part(parent, {
		Name = "LanternPost",
		Size = Vector3.new(0.6, height, 0.6),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)),
		Color = rgb(60, 50, 70),
		Material = Enum.Material.Metal,
	})
	part(parent, {
		Name = "LanternArm",
		Size = Vector3.new(1.8, 0.35, 0.35),
		CFrame = CFrame.new(position + Vector3.new(0.7, height - 0.3, 0)),
		Color = rgb(60, 50, 70),
		Material = Enum.Material.Metal,
	})
	local glass = part(parent, {
		Name = "LanternLight",
		Size = Vector3.new(1.1, 1.4, 1.1),
		CFrame = CFrame.new(position + Vector3.new(1.4, height - 1.2, 0)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	part(parent, {
		Name = "LanternCap",
		Size = Vector3.new(1.5, 0.4, 1.5),
		CFrame = CFrame.new(position + Vector3.new(1.4, height - 0.35, 0)),
		Color = rgb(60, 50, 70),
		Material = Enum.Material.Metal,
	})
	Build.light(glass, color, 18, 1.4)
	return 1.5
end

-- Заборчик между двумя точками.
function Props.fence(parent, from, to, color)
	local direction = to - from
	local length = direction.Magnitude
	local posts = math.max(1, math.floor(length / 5))
	for i = 0, posts do
		local point = from + direction * (i / posts)
		part(parent, {
			Name = "FencePost",
			Size = Vector3.new(0.7, 3, 0.7),
			CFrame = CFrame.new(point + Vector3.new(0, 1.5, 0)),
			Color = color,
			Material = Enum.Material.WoodPlanks,
		})
	end
	for _, y in ipairs({ 1.2, 2.3 }) do
		Build.cylinderBetween(parent, from + Vector3.new(0, y, 0), to + Vector3.new(0, y, 0), 0.35, color:Lerp(WHITE, 0.1), Enum.Material.WoodPlanks)
	end
end

function Props.bench(parent, position, yaw, color)
	local base = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	part(parent, { Name = "BenchSeat", Size = Vector3.new(5, 0.4, 1.6), CFrame = base * CFrame.new(0, 1.4, 0), Color = color, Material = Enum.Material.WoodPlanks })
	part(parent, { Name = "BenchBack", Size = Vector3.new(5, 1.2, 0.3), CFrame = base * CFrame.new(0, 2.3, 0.7), Color = color, Material = Enum.Material.WoodPlanks })
	for _, side in ipairs({ -1, 1 }) do
		part(parent, { Name = "BenchLeg", Size = Vector3.new(0.3, 1.4, 1.4), CFrame = base * CFrame.new(side * 2.1, 0.7, 0), Color = Color3.fromRGB(60, 50, 70), Material = Enum.Material.Metal })
	end
	return 3
end

-- Ветряная мельница с крутящимися лопастями (тег Spin крутит модель на клиенте).
function Props.windmill(parent, position, yaw, palette)
	local base = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	part(parent, { Name = "MillTower", Size = Vector3.new(9, 16, 9), CFrame = base * CFrame.new(0, 8, 0), Color = rgb(245, 235, 215), Material = Enum.Material.Brick })
	Build.roof(parent, base * CFrame.new(0, 16, 0), 10, 10, 5, rgb(200, 70, 60), Enum.Material.WoodPlanks)
	part(parent, { Name = "MillDoor", Size = Vector3.new(3, 5, 0.3), CFrame = base * CFrame.new(0, 2.5, -4.55), Color = palette.Trunk, Material = Enum.Material.WoodPlanks })
	part(parent, { Name = "MillWindow", Size = Vector3.new(2, 2, 0.3), CFrame = base * CFrame.new(0, 11, -4.55), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
	local blades = Build.model("MillBlades", parent)
	local hub = base * CFrame.new(0, 14, -5.6)
	part(blades, { Name = "Hub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 2, 2), CFrame = hub * CFrame.Angles(0, math.pi / 2, 0), Color = rgb(90, 70, 50), Material = Enum.Material.Wood })
	for i = 0, 3 do
		local arm = hub * CFrame.Angles(0, 0, i * math.pi / 2)
		part(blades, { Name = "BladeArm", Size = Vector3.new(0.5, 10, 0.4), CFrame = arm * CFrame.new(0, 5.5, 0), Color = rgb(120, 90, 60), Material = Enum.Material.Wood })
		part(blades, { Name = "BladeSail", Size = Vector3.new(2.6, 7, 0.2), CFrame = arm * CFrame.new(1.5, 6.5, 0.1), Color = rgb(250, 245, 235), Material = Enum.Material.Fabric })
	end
	-- Ось вращения лопастей — «вперёд» от мельницы.
	blades.WorldPivot = hub * CFrame.Angles(math.pi / 2, 0, 0)
	blades:SetAttribute("SpinSpeed", 0.8)
	CollectionService:AddTag(blades, "Spin")
	return 7
end

------------------------------------------------------------------ ПУСТЫНЯ

function Props.cactus(parent, position, rng, palette)
	local height = rng:NextNumber(6, 10)
	local width = 1.8
	local base = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local color = vary(palette.Cactus, rng, 0.06)
	part(parent, { Name = "Cactus", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, width, width), CFrame = base * CFrame.new(0, height / 2, 0) * VERTICAL, Color = color })
	part(parent, { Name = "Cactus", Shape = Enum.PartType.Ball, Size = Vector3.one * width, CFrame = base * CFrame.new(0, height, 0), Color = color })
	-- полоски-рёбра
	for i = 0, 3 do
		part(parent, {
			Name = "CactusRib",
			Size = Vector3.new(0.18, height - 0.5, 0.18),
			CFrame = base * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, height / 2, -width / 2),
			Color = color:Lerp(Color3.new(0, 0, 0), 0.15),
			CanCollide = false,
		})
	end
	for _, side in ipairs({ -1, 1 }) do
		if rng:NextNumber() < 0.75 then
			local armY = rng:NextNumber(height * 0.35, height * 0.6)
			local armHeight = rng:NextNumber(2, 3.5)
			part(parent, { Name = "Arm", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 1.2, 1.2), CFrame = base * CFrame.new(side * 1.5, armY, 0), Color = color })
			part(parent, { Name = "Arm", Shape = Enum.PartType.Cylinder, Size = Vector3.new(armHeight, 1.2, 1.2), CFrame = base * CFrame.new(side * 2.6, armY + armHeight / 2, 0) * VERTICAL, Color = color })
			part(parent, { Name = "Arm", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, CFrame = base * CFrame.new(side * 2.6, armY + armHeight, 0), Color = color })
		end
	end
	if rng:NextNumber() < 0.45 then
		part(parent, { Name = "CactusFlower", Shape = Enum.PartType.Ball, Size = Vector3.one * 1, CFrame = base * CFrame.new(0, height + 0.8, 0), Color = pick(rng, { rgb(255, 100, 160), rgb(255, 220, 70) }), CanCollide = false })
	end
	return 3
end

function Props.palm(parent, position, rng, palette)
	local yaw = rng:NextNumber(0, math.pi * 2)
	local direction = Vector3.new(math.cos(yaw), 0, math.sin(yaw))
	local lean = rng:NextNumber(0.4, 0.9)
	local previous = position
	for i = 1, 6 do
		local nextPoint = position + Vector3.new(0, i * 2.3, 0) + direction * (lean * i * i * 0.12)
		Build.cylinderBetween(parent, previous, nextPoint, 1.5 - i * 0.08, i % 2 == 0 and palette.PalmTrunk or palette.PalmTrunk:Lerp(WHITE, 0.12), Enum.Material.Wood)
		previous = nextPoint
	end
	for k = 1, 8 do
		local angle = (k / 8) * math.pi * 2
		local leafDirection = Vector3.new(math.cos(angle), -0.3, math.sin(angle)).Unit
		local center = previous + leafDirection * 3.2
		part(parent, {
			Name = "PalmLeaf",
			Size = Vector3.new(2, 0.35, 7),
			CFrame = CFrame.lookAt(center, center + leafDirection),
			Color = k % 2 == 0 and palette.PalmLeaves or palette.PalmLeaves:Lerp(WHITE, 0.12),
			Mesh = Enum.MeshType.Sphere,
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	for k = 1, 3 do
		local angle = (k / 3) * math.pi * 2
		part(parent, { Name = "Coconut", Shape = Enum.PartType.Ball, Size = Vector3.one * 1, CFrame = CFrame.new(previous + Vector3.new(math.cos(angle) * 0.75, -0.8, math.sin(angle) * 0.75)), Color = rgb(110, 70, 40) })
	end
	return 2.5
end

function Props.pyramid(parent, position, baseSize, layers, palette)
	local layerHeight = baseSize / layers * 0.62
	for i = 0, layers - 1 do
		local size = baseSize * (1 - i / layers)
		part(parent, {
			Name = "Pyramid",
			Size = Vector3.new(size, layerHeight, size),
			CFrame = CFrame.new(position + Vector3.new(0, layerHeight * (i + 0.5), 0)),
			Color = palette.Sandstone[i % 2 + 1],
			Material = Enum.Material.Sandstone,
		})
	end
	-- золотая верхушка
	part(parent, {
		Name = "PyramidTop",
		Size = Vector3.new(baseSize / layers, layerHeight * 1.2, baseSize / layers),
		CFrame = CFrame.new(position + Vector3.new(0, layerHeight * (layers + 0.5), 0)),
		Color = Color3.fromRGB(255, 205, 60),
		Material = Enum.Material.Metal,
		Reflectance = 0.25,
	})
	return baseSize * 0.72
end

function Props.obelisk(parent, position, height, palette)
	part(parent, { Name = "ObeliskBase", Size = Vector3.new(5, 1.5, 5), CFrame = CFrame.new(position + Vector3.new(0, 0.75, 0)), Color = palette.Sandstone[2], Material = Enum.Material.Sandstone })
	part(parent, { Name = "Obelisk", Size = Vector3.new(2.6, height, 2.6), CFrame = CFrame.new(position + Vector3.new(0, 1.5 + height / 2, 0)), Color = palette.Sandstone[1], Material = Enum.Material.Sandstone })
	part(parent, { Name = "ObeliskTip", Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(position + Vector3.new(0, 1.5 + height + 0.6, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = Color3.fromRGB(255, 205, 60), Material = Enum.Material.Metal })
	for i = 1, 4 do
		part(parent, {
			Name = "Glyph",
			Size = Vector3.new(1, 1, 0.1),
			CFrame = CFrame.new(position + Vector3.new(0, 2 + i * height / 5.5, -1.32)),
			Color = Color3.fromRGB(60, 110, 220),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	return 3
end

function Props.column(parent, position, rng, palette, broken)
	local height = broken and rng:NextNumber(4, 7) or 12
	part(parent, { Name = "ColumnBase", Size = Vector3.new(4, 1, 4), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)), Color = palette.Sandstone[2], Material = Enum.Material.Sandstone })
	part(parent, { Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 2.6, 2.6), CFrame = CFrame.new(position + Vector3.new(0, 1 + height / 2, 0)) * VERTICAL, Color = palette.Sandstone[1], Material = Enum.Material.Sandstone })
	if not broken then
		part(parent, { Name = "ColumnTop", Size = Vector3.new(4, 1, 4), CFrame = CFrame.new(position + Vector3.new(0, 1.5 + height, 0)), Color = palette.Sandstone[2], Material = Enum.Material.Sandstone })
	end
	return 2.5
end

function Props.torch(parent, position)
	part(parent, { Name = "TorchPole", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, 0.6, 0.6), CFrame = CFrame.new(position + Vector3.new(0, 3, 0)) * VERTICAL, Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
	local bowl = part(parent, { Name = "TorchBowl", Size = Vector3.new(1.6, 0.9, 1.6), CFrame = CFrame.new(position + Vector3.new(0, 6.2, 0)), Color = Color3.fromRGB(80, 60, 50), Material = Enum.Material.Metal, Mesh = Enum.MeshType.Sphere })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 150, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 230, 90)
	fire.Parent = bowl
	Build.light(bowl, Color3.fromRGB(255, 170, 70), 18, 1.6)
	return 1.2
end

function Props.vase(parent, position, rng)
	local color = pick(rng, { Color3.fromRGB(200, 110, 70), Color3.fromRGB(80, 140, 200), Color3.fromRGB(220, 170, 90) })
	part(parent, { Name = "Vase", Size = Vector3.new(2.2, 2.6, 2.2), CFrame = CFrame.new(position + Vector3.new(0, 1.2, 0)), Color = color, Mesh = Enum.MeshType.Sphere })
	part(parent, { Name = "VaseNeck", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 1.1, 1.1), CFrame = CFrame.new(position + Vector3.new(0, 2.6, 0)) * VERTICAL, Color = color })
	part(parent, { Name = "VaseStripe", Size = Vector3.new(2.25, 0.3, 2.25), CFrame = CFrame.new(position + Vector3.new(0, 1.5, 0)), Color = Color3.fromRGB(255, 220, 120), Mesh = Enum.MeshType.Sphere, CanCollide = false })
	return 1.5
end

function Props.bones(parent, position, rng)
	local yaw = rng:NextNumber(0, math.pi)
	local base = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, yaw, 0)
	part(parent, { Name = "Skull", Size = Vector3.new(2.2, 1.8, 2.4), CFrame = base, Color = Color3.fromRGB(245, 240, 225), Mesh = Enum.MeshType.Sphere })
	for i = 1, 4 do
		part(parent, { Name = "Rib", Size = Vector3.new(0.35, 0.35, 3.2), CFrame = base * CFrame.new(-2 - i * 0.9, -0.2, 0) * CFrame.Angles(0, 0, math.rad(15)), Color = Color3.fromRGB(240, 235, 220), CanCollide = false })
	end
	return 3
end

------------------------------------------------------------------ КОСМОС

function Props.crystals(parent, position, rng, colors, withLight)
	local color = pick(rng, colors)
	local count = rng:NextInteger(3, 6)
	local tallest
	for _ = 1, count do
		local height = rng:NextNumber(3, 9)
		local width = height * 0.3
		local crystal = part(parent, {
			Name = "Crystal",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-1.8, 1.8), 0, rng:NextNumber(-1.8, 1.8)))
				* CFrame.Angles(math.rad(rng:NextNumber(-25, 25)), rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-25, 25)))
				* CFrame.new(0, height * 0.4, 0),
			Color = color,
			Material = Enum.Material.Glass,
			Transparency = 0.15,
			Reflectance = 0.2,
		})
		-- светящаяся сердцевина
		part(parent, {
			Name = "CrystalCore",
			Size = Vector3.new(width * 0.45, height * 0.85, width * 0.45),
			CFrame = crystal.CFrame,
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		if not tallest or crystal.Size.Y > tallest.Size.Y then
			tallest = crystal
		end
	end
	if withLight and tallest then
		Build.light(tallest, color, 16, 1.6)
	end
	return 3.5
end

function Props.alienPlant(parent, position, rng)
	local color = pick(rng, { Color3.fromRGB(110, 255, 200), Color3.fromRGB(255, 120, 230), Color3.fromRGB(150, 140, 255) })
	for i = 1, rng:NextInteger(3, 5) do
		local angle = i * 2.1
		local height = rng:NextNumber(2.5, 5)
		local tip = position + Vector3.new(math.cos(angle) * 1.2, height, math.sin(angle) * 1.2)
		Build.cylinderBetween(parent, position, tip, 0.3, Color3.fromRGB(60, 50, 110))
		local bulb = part(parent, { Name = "Bulb", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(0.8, 1.3), CFrame = CFrame.new(tip), Color = color, Material = Enum.Material.Neon, CanCollide = false })
		if i == 1 then
			Build.light(bulb, color, 10, 1)
		end
	end
	return 2
end

function Props.dome(parent, position, size)
	part(parent, { Name = "DomeRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, size + 1, size + 1), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * VERTICAL, Color = Color3.fromRGB(200, 205, 225), Material = Enum.Material.Metal })
	part(parent, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.one * size, CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0)), Color = Color3.fromRGB(160, 220, 255), Material = Enum.Material.Glass, Transparency = 0.45, Reflectance = 0.3 })
	local plant = part(parent, { Name = "DomeGarden", Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.4, CFrame = CFrame.new(position + Vector3.new(0, size * 0.1, 0)), Color = Color3.fromRGB(90, 220, 120), Material = Enum.Material.Grass })
	Build.light(plant, Color3.fromRGB(160, 255, 200), size, 1)
	part(parent, { Name = "DomeDoor", Size = Vector3.new(3, 3.5, 1.5), CFrame = CFrame.new(position + Vector3.new(0, 1.75, -size / 2)), Color = Color3.fromRGB(200, 205, 225), Material = Enum.Material.Metal })
	return size * 0.55
end

function Props.satellite(parent, position, yaw)
	local base = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
	part(parent, { Name = "DishStand", Size = Vector3.new(1.5, 6, 1.5), CFrame = base * CFrame.new(0, 3, 0), Color = Color3.fromRGB(180, 185, 205), Material = Enum.Material.Metal })
	local dish = base * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-50), 0, 0)
	part(parent, { Name = "Dish", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 9, 9), CFrame = dish * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(235, 238, 248), Material = Enum.Material.Metal })
	local tip = part(parent, { Name = "DishTip", Shape = Enum.PartType.Ball, Size = Vector3.one * 1, CFrame = dish * CFrame.new(0, 3, 0), Color = Color3.fromRGB(255, 80, 80), Material = Enum.Material.Neon })
	Build.cylinderBetween(parent, (dish * CFrame.new(0, 0.3, 0)).Position, tip.Position, 0.25, Color3.fromRGB(120, 125, 145))
	return 5
end

function Props.antenna(parent, position)
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		Build.cylinderBetween(parent, position + Vector3.new(math.cos(angle) * 2.5, 0, math.sin(angle) * 2.5), position + Vector3.new(0, 18, 0), 0.4, Color3.fromRGB(200, 205, 225), Enum.Material.Metal)
	end
	for y = 4, 16, 4 do
		part(parent, { Name = "AntennaRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 5 - y * 0.25, 5 - y * 0.25), CFrame = CFrame.new(position + Vector3.new(0, y, 0)) * VERTICAL, Color = Color3.fromRGB(150, 155, 180), Material = Enum.Material.Metal, CanCollide = false })
	end
	local beacon = part(parent, { Name = "Beacon", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.4, CFrame = CFrame.new(position + Vector3.new(0, 18.6, 0)), Color = Color3.fromRGB(255, 60, 90), Material = Enum.Material.Neon })
	Build.light(beacon, Color3.fromRGB(255, 80, 100), 22, 2)
	return 3
end

function Props.rocket(parent, position)
	local body = Color3.fromRGB(240, 240, 250)
	local red = Color3.fromRGB(240, 70, 80)
	Build.disc(parent, position + Vector3.new(0, 0.3, 0), 12, 0.6, Color3.fromRGB(60, 55, 90), { Material = Enum.Material.Metal, Name = "LaunchPad" })
	part(parent, { Name = "RocketBody", Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 5.5, 5.5), CFrame = CFrame.new(position + Vector3.new(0, 10, 0)) * VERTICAL, Color = body })
	part(parent, { Name = "RocketStripe", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 5.7, 5.7), CFrame = CFrame.new(position + Vector3.new(0, 7, 0)) * VERTICAL, Color = red })
	part(parent, { Name = "RocketNose", Size = Vector3.new(5.5, 7, 5.5), CFrame = CFrame.new(position + Vector3.new(0, 18, 0)), Color = red, Mesh = Enum.MeshType.Sphere })
	local window = part(parent, { Name = "RocketWindow", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(position + Vector3.new(0, 13, -2.4)), Color = Color3.fromRGB(110, 230, 255), Material = Enum.Material.Neon })
	Build.light(window, Color3.fromRGB(110, 230, 255), 10, 1)
	for i = 1, 3 do
		local angle = (i / 3) * math.pi * 2
		part(parent, { Name = "RocketFin", Size = Vector3.new(0.6, 6, 3.2), CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 3.2), Color = red })
	end
	local flame = part(parent, { Name = "RocketFlame", Size = Vector3.new(3.2, 3.6, 3.2), CFrame = CFrame.new(position + Vector3.new(0, 1.8, 0)), Color = Color3.fromRGB(255, 160, 40), Material = Enum.Material.Neon, Mesh = Enum.MeshType.Sphere, CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = 5
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(120, 200, 255)
	fire.Parent = flame
	return 7
end

-- Летающий астероид (покачивается на клиенте).
function Props.asteroid(parent, position, rng, color)
	local size = rng:NextNumber(4, 12)
	local rock = part(parent, {
		Name = "Asteroid",
		Size = Vector3.new(size, size * rng:NextNumber(0.7, 1), size * rng:NextNumber(0.8, 1.1)),
		CFrame = CFrame.new(position) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0),
		Color = vary(color, rng, 0.1),
		Material = Enum.Material.Slate,
		Mesh = Enum.MeshType.Sphere,
		CanCollide = false,
	})
	rock:SetAttribute("SpinSpeed", rng:NextNumber(0.4, 1))
	rock:SetAttribute("BobHeight", rng:NextNumber(1, 3))
	CollectionService:AddTag(rock, "Bob")
	return size
end

return Props
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Structures</string>
              <string name="Source"><![CDATA[--[[
	Structures — главные постройки каждого мира:
	точка появления, фонтан, лавка магазина, приветственная арка,
	домик продажи, подставки для яиц и порталы.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Eggs = require(Shared.Config.Eggs)
local Worlds = require(Shared.Config.Worlds)

local Build = require(script.Parent.Build)

local Structures = {}

local part = Build.part
local VERTICAL = Build.VERTICAL
local WHITE = Build.WHITE
local Format = Build.Format

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

------------------------------------------------------------------ ТОЧКА ПОЯВЛЕНИЯ
function Structures.spawn(ctx, isStart)
	local position = ctx.Origin + Build.LAYOUT.Spawn
	local model = Build.model("Spawn", ctx.Folder)
	local accent = ctx.Config.Color
	Build.disc(model, position + Vector3.new(0, 0.25, 0), 16, 0.5, ctx.Palette.Stone or rgb(200, 200, 210), { Name = "SpawnBase", Material = Enum.Material.Slate })
	Build.disc(model, position + Vector3.new(0, 0.4, 0), 13, 0.5, accent, { Name = "SpawnRing", Material = Enum.Material.Neon })
	if isStart then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "SpawnLocation"
		spawn.Anchored = true
		spawn.Shape = Enum.PartType.Cylinder
		spawn.Size = Vector3.new(0.8, 11, 11)
		spawn.CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0)) * VERTICAL
		spawn.Color = accent:Lerp(WHITE, 0.4)
		spawn.Material = Enum.Material.SmoothPlastic
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = model
	else
		Build.disc(model, position + Vector3.new(0, 0.6, 0), 11, 0.8, accent:Lerp(WHITE, 0.4), { Name = "SpawnPad" })
	end
	-- Светящиеся столбики по кругу.
	for i = 0, 5 do
		local angle = i / 6 * math.pi * 2
		local point = position + Vector3.new(math.cos(angle) * 9.5, 0, math.sin(angle) * 9.5)
		part(model, { Name = "SpawnPost", Size = Vector3.new(0.8, 2.4, 0.8), CFrame = CFrame.new(point + Vector3.new(0, 1.2, 0)), Color = ctx.Palette.Stone or rgb(200, 200, 210), Material = Enum.Material.Slate })
		local glow = part(model, { Name = "SpawnGlow", Shape = Enum.PartType.Ball, Size = Vector3.one * 1, CFrame = CFrame.new(point + Vector3.new(0, 2.7, 0)), Color = accent, Material = Enum.Material.Neon })
		if i % 2 == 0 then
			Build.light(glow, accent, 12, 1)
		end
	end
	return CFrame.new(position + Vector3.new(0, 4, 0))
end

------------------------------------------------------------------ ФОНТАН
function Structures.fountain(ctx)
	local position = ctx.Origin + Build.LAYOUT.Fountain
	local model = Build.model("Fountain", ctx.Folder)
	local stone = ctx.Palette.Stone or rgb(205, 205, 215)
	local water = ctx.Palette.FountainWater or rgb(80, 190, 255)
	Build.disc(model, position + Vector3.new(0, 0.8, 0), 16, 1.6, stone, { Name = "Basin", Material = Enum.Material.Slate })
	Build.disc(model, position + Vector3.new(0, 1.65, 0), 14, 0.3, water, { Name = "Water", Material = Enum.Material.Glass, Transparency = 0.25, Reflectance = 0.3, CanCollide = false })
	Build.disc(model, position + Vector3.new(0, 3, 0), 2, 4, stone, { Name = "Pillar", Material = Enum.Material.Slate })
	Build.disc(model, position + Vector3.new(0, 5.2, 0), 7, 0.8, stone, { Name = "Bowl", Material = Enum.Material.Slate })
	Build.disc(model, position + Vector3.new(0, 5.65, 0), 6, 0.2, water, { Name = "BowlWater", Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false })
	local jet = part(model, { Name = "Jet", Size = Vector3.new(1.2, 3, 1.2), CFrame = CFrame.new(position + Vector3.new(0, 7.2, 0)), Color = water, Material = Enum.Material.Neon, Transparency = 0.35, Mesh = Enum.MeshType.Sphere, CanCollide = false })
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(rgb(200, 240, 255), water)
	spray.LightEmission = 0.5
	spray.Rate = 40
	spray.Lifetime = NumberRange.new(1, 1.5)
	spray.Speed = NumberRange.new(8, 11)
	spray.SpreadAngle = Vector2.new(18, 18)
	spray.Acceleration = Vector3.new(0, -22, 0)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.2) })
	spray.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Parent = jet
	Build.light(jet, water, 14, 1)
	return position
end

------------------------------------------------------------------ ЛАВКА МАГАЗИНА
function Structures.shopStall(ctx)
	local position = ctx.Origin + Build.LAYOUT.ShopStall
	local model = Build.model("ShopStall", ctx.Folder)
	-- Лавка смотрит на точку появления.
	local base = CFrame.lookAt(position, ctx.Origin + Build.LAYOUT.Spawn * Vector3.new(1, 0, 1))
	local wood = ctx.Palette.Wood or rgb(170, 110, 60)
	local awningA = ctx.Palette.AwningA or rgb(255, 205, 60)
	local awningB = WHITE

	part(model, { Name = "Floor", Size = Vector3.new(14, 0.8, 9), CFrame = base * CFrame.new(0, 0.4, 0), Color = wood:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.WoodPlanks })
	local counter = part(model, { Name = "Counter", Size = Vector3.new(12, 3.4, 2.4), CFrame = base * CFrame.new(0, 2.5, -2.8), Color = wood, Material = Enum.Material.WoodPlanks })
	part(model, { Name = "CounterTop", Size = Vector3.new(12.6, 0.5, 3), CFrame = base * CFrame.new(0, 4.4, -2.8), Color = wood:Lerp(WHITE, 0.15), Material = Enum.Material.WoodPlanks })
	for _, x in ipairs({ -6, 6 }) do
		for _, z in ipairs({ -3.8, 3.8 }) do
			part(model, { Name = "Post", Size = Vector3.new(0.8, 10, 0.8), CFrame = base * CFrame.new(x, 5.4, z), Color = wood, Material = Enum.Material.Wood })
		end
	end
	-- Полосатый навес.
	for i = 0, 6 do
		part(model, {
			Name = "Awning",
			Size = Vector3.new(2, 0.5, 10),
			CFrame = base * CFrame.new(-6 + i * 2, 10.6, 0) * CFrame.Angles(math.rad(-14), 0, 0),
			Color = i % 2 == 0 and awningA or awningB,
		})
	end
	-- Вывеска.
	local signBoard = part(model, { Name = "SignBoard", Size = Vector3.new(10, 2.6, 0.5), CFrame = base * CFrame.new(0, 12.8, -4.2), Color = ctx.Palette.SignColor or rgb(255, 150, 50) })
	Build.sign(signBoard, Enum.NormalId.Front, "МАГАЗИН", WHITE, nil)
	-- Товары на прилавке: рюкзаки разных цветов.
	local colors = { rgb(90, 170, 255), rgb(255, 120, 80), rgb(120, 220, 110) }
	for i, color in ipairs(colors) do
		local at = base * CFrame.new(-4 + (i - 1) * 4, 5.9, -2.8)
		part(model, { Name = "BagBody", Size = Vector3.new(1.8, 2.2, 1.2), CFrame = at, Color = color })
		part(model, { Name = "BagTop", Size = Vector3.new(1.8, 1, 1.2), CFrame = at * CFrame.new(0, 1.1, 0), Color = color, Mesh = Enum.MeshType.Sphere })
		part(model, { Name = "BagPocket", Size = Vector3.new(1.2, 0.8, 0.3), CFrame = at * CFrame.new(0, -0.4, -0.65), Color = color:Lerp(WHITE, 0.25) })
	end
	local lamp = part(model, { Name = "StallLamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, CFrame = base * CFrame.new(0, 9.4, -1), Color = rgb(255, 230, 150), Material = Enum.Material.Neon })
	Build.light(lamp, rgb(255, 220, 150), 16, 1.2)

	-- Кнопка «Магазин»: клиент сам откроет окно магазина.
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptPoint"
	attachment.Position = Vector3.new(0, 1.5, -1.8)
	attachment.Parent = counter
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenShop"
	prompt.ActionText = "Магазин"
	prompt.ObjectText = "Рюкзаки и бонусы"
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Icon", "ShopBag")
	prompt:SetAttribute("Color", awningA)
	prompt:SetAttribute("OpensPanel", "Shop")
	prompt.Parent = attachment
	return position
end

------------------------------------------------------------------ АРКА
function Structures.welcomeArch(ctx, title)
	local position = ctx.Origin + Build.LAYOUT.WelcomeArch
	local model = Build.model("WelcomeArch", ctx.Folder)
	local base = CFrame.new(position)
	local pillar = ctx.Palette.ArchColor or rgb(150, 100, 60)
	for _, side in ipairs({ -1, 1 }) do
		part(model, { Name = "ArchPillar", Size = Vector3.new(2.4, 14, 2.4), CFrame = base * CFrame.new(side * 9, 7, 0), Color = pillar, Material = Enum.Material.Wood })
		local ball = part(model, { Name = "ArchLamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = base * CFrame.new(side * 9, 15, 0), Color = ctx.Config.Color, Material = Enum.Material.Neon })
		Build.light(ball, ctx.Config.Color, 16, 1.2)
	end
	local beam = part(model, { Name = "ArchBeam", Size = Vector3.new(22, 3.6, 1.6), CFrame = base * CFrame.new(0, 12.6, 0), Color = ctx.Palette.SignColor or rgb(255, 150, 50) })
	-- Надпись с двух сторон.
	Build.sign(beam, Enum.NormalId.Front, title, WHITE, nil)
	Build.sign(beam, Enum.NormalId.Back, title, WHITE, nil)
	-- Гирлянда
	for i = 0, 10 do
		local x = -9 + i * 1.8
		local sag = math.sin(i / 10 * math.pi) * 1.4
		part(model, {
			Name = "Garland",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			CFrame = base * CFrame.new(x, 10.4 - sag, -0.9),
			Color = (i % 3 == 0) and rgb(255, 90, 90) or ((i % 3 == 1) and rgb(255, 220, 80) or rgb(110, 200, 255)),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
end

------------------------------------------------------------------ ДОМИК ПРОДАЖИ
function Structures.sellShop(ctx)
	local center = ctx.Origin + Build.LAYOUT.Sell
	local model = Build.model("SellZone", ctx.Folder)
	local wood = ctx.Palette.Wood or rgb(170, 110, 60)

	-- Круг продажи: светящийся диск с кольцом.
	Build.disc(model, center + Vector3.new(0, 0.15, 0), GameConfig.SellRadius * 2 + 4, 0.3, rgb(30, 110, 50), { Name = "SellRing", Material = Enum.Material.Slate })
	local pad = Build.disc(model, center + Vector3.new(0, 0.3, 0), GameConfig.SellRadius * 2, 0.3, rgb(90, 255, 120), {
		Name = "SellPad",
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	})
	Build.disc(model, center + Vector3.new(0, 0.35, 0), GameConfig.SellRadius * 1.2, 0.3, rgb(220, 255, 220), { Name = "SellPadInner", Material = Enum.Material.Neon, Transparency = 0.2, CanCollide = false })

	-- Кольцо из летающих монет (крутится на клиенте).
	local coinRing = Build.model("CoinRing", model)
	for i = 0, 9 do
		local angle = i / 10 * math.pi * 2
		part(coinRing, {
			Name = "RingCoin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 2.2, 2.2),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * 7, 4.5, math.sin(angle) * 7)) * CFrame.Angles(0, -angle, 0),
			Color = rgb(255, 205, 40),
			Reflectance = 0.25,
			CanCollide = false,
		})
	end
	coinRing.WorldPivot = CFrame.new(center + Vector3.new(0, 4.5, 0))
	coinRing:SetAttribute("SpinSpeed", 0.9)
	CollectionService:AddTag(coinRing, "Spin")

	-- Домик-банк позади круга.
	local house = CFrame.new(center + Vector3.new(0, 0, 16))
	part(model, { Name = "BankFloor", Size = Vector3.new(18, 1, 11), CFrame = house * CFrame.new(0, 0.5, 0), Color = rgb(200, 200, 210), Material = Enum.Material.Slate })
	part(model, { Name = "BankWalls", Size = Vector3.new(16, 9, 9), CFrame = house * CFrame.new(0, 5.5, 0.5), Color = ctx.Palette.BankWalls or rgb(255, 240, 210), Material = Enum.Material.Plaster })
	Build.roof(model, house * CFrame.new(0, 10, 0.5), 18, 11, 5, ctx.Palette.Roof or rgb(80, 170, 90), Enum.Material.WoodPlanks)
	part(model, { Name = "BankDoor", Size = Vector3.new(4, 6, 0.4), CFrame = house * CFrame.new(0, 4, -4.1), Color = wood, Material = Enum.Material.WoodPlanks })
	part(model, { Name = "DoorKnob", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, CFrame = house * CFrame.new(1.3, 4, -4.35), Color = rgb(255, 205, 60) })
	for _, side in ipairs({ -1, 1 }) do
		local window = part(model, { Name = "BankWindow", Size = Vector3.new(3, 3, 0.3), CFrame = house * CFrame.new(side * 5, 5.5, -4.05), Color = rgb(255, 225, 140), Material = Enum.Material.Neon })
		Build.light(window, rgb(255, 220, 150), 10, 0.8)
		part(model, { Name = "WindowFrame", Size = Vector3.new(3.6, 0.4, 0.5), CFrame = house * CFrame.new(side * 5, 3.8, -4.1), Color = wood, Material = Enum.Material.WoodPlanks })
	end
	local signBoard = part(model, { Name = "BankSign", Size = Vector3.new(12, 2.8, 0.5), CFrame = house * CFrame.new(0, 9.4, -4.4), Color = rgb(60, 190, 80) })
	Build.sign(signBoard, Enum.NormalId.Front, "ПРОДАЖА", WHITE, nil)
	-- Мешки и горки монет у входа.
	for _, offset in ipairs({ Vector3.new(-6, 0, -5.5), Vector3.new(6, 0, -5.5) }) do
		local at = house.Position + offset
		part(model, { Name = "MoneyBag", Size = Vector3.new(2.6, 2.6, 2.4), CFrame = CFrame.new(at + Vector3.new(0, 1.3, 0)), Color = rgb(190, 160, 110), Mesh = Enum.MeshType.Sphere })
		part(model, { Name = "BagTie", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 1.2, 1.2), CFrame = CFrame.new(at + Vector3.new(0, 2.7, 0)) * VERTICAL, Color = rgb(255, 205, 60) })
		for k = 0, 4 do
			part(model, { Name = "CoinPile", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.6, 1.6), CFrame = CFrame.new(at + Vector3.new(2, 0.2 + k * 0.32, 1)) * VERTICAL, Color = rgb(255, 205, 40), Reflectance = 0.2 })
		end
	end

	local gui = Build.billboard(pad, Vector2.new(16, 5), Vector3.new(0, 8.5, 0), 160)
	Build.list(gui)
	Build.line(gui, "ПРОДАЖА СИЛЫ", rgb(130, 255, 150), 0.55, 1)
	Build.line(gui, "Встань в круг: 1 сила = " .. ctx.Config.SellMultiplier .. " монет", WHITE, 0.4, 2)

	pad:SetAttribute("SellMultiplier", ctx.Config.SellMultiplier)
	CollectionService:AddTag(pad, "SellPad")
	return { Position = center, Radius = GameConfig.SellRadius }
end

------------------------------------------------------------------ ЯЙЦА
function Structures.eggStand(ctx, eggId)
	local egg = Eggs[eggId]
	local position = ctx.Origin + Vector3.new(egg.Position.X, 0, egg.Position.Z)
	local model = Build.model(eggId, ctx.Folder)
	local stone = ctx.Palette.Stone or rgb(205, 205, 215)

	Build.disc(model, position + Vector3.new(0, 0.5, 0), 12, 1, stone, { Name = "PedestalBase", Material = Enum.Material.Slate })
	Build.disc(model, position + Vector3.new(0, 1.4, 0), 10, 1, ctx.Palette.Stand, { Name = "Pedestal" })
	Build.disc(model, position + Vector3.new(0, 1.2, 0), 10.6, 0.4, egg.Color, { Name = "Trim", Material = Enum.Material.Neon })
	Build.disc(model, position + Vector3.new(0, 2.05, 0), 8, 0.3, egg.Color:Lerp(WHITE, 0.4), { Name = "Top", Material = Enum.Material.Neon, Transparency = 0.3 })

	-- Яйцо со пятнышками — отдельная модель, клиент её плавно покачивает (тег Bob).
	local eggModel = Build.model("EggModel", model)
	local eggPart = part(eggModel, {
		Name = "Egg",
		Size = Vector3.new(4.6, 5.8, 4.6),
		CFrame = CFrame.new(position + Vector3.new(0, 2.2 + 3.2, 0)),
		Color = egg.Color,
		Mesh = Enum.MeshType.Sphere,
	})
	local spots = { { 20, 10 }, { 95, -15 }, { 160, 25 }, { 230, -5 }, { 300, 30 }, { 60, 45 }, { 200, 50 }, { 330, -30 } }
	for _, spot in ipairs(spots) do
		local around, elevation = math.rad(spot[1]), math.rad(spot[2])
		local offset = Vector3.new(math.cos(elevation) * math.cos(around) * 2.3, math.sin(elevation) * 2.9, math.cos(elevation) * math.sin(around) * 2.3)
		part(eggModel, {
			Name = "Spot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.2,
			CFrame = CFrame.new(eggPart.Position + offset * 0.93),
			Color = egg.SpotColor,
			CanCollide = false,
		})
	end
	eggModel.PrimaryPart = eggPart
	Build.light(eggPart, egg.Color, 14, 1.2)

	-- Блёстки вокруг яйца.
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(egg.Color:Lerp(WHITE, 0.5), WHITE)
	sparkles.LightEmission = 1
	sparkles.Rate = 6
	sparkles.Lifetime = NumberRange.new(1.2, 2)
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Parent = eggPart

	-- Таблички с питомцами рисует клиент (client/UI/EggDisplays).
	eggPart:SetAttribute("EggId", eggId)
	eggModel:SetAttribute("BobHeight", 0.5)
	eggModel:SetAttribute("SpinSpeed", 1.6)
	CollectionService:AddTag(eggModel, "Bob")
	CollectionService:AddTag(eggPart, "EggStand")
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	return eggPart
end

------------------------------------------------------------------ ПОРТАЛЫ
function Structures.portal(ctx, localPosition, targetWorldId, isBack)
	local target = Worlds[targetWorldId]
	local position = ctx.Origin + localPosition
	-- Портал смотрит лицом к центру мира.
	local base = CFrame.lookAt(position, Vector3.new(ctx.Origin.X, position.Y, ctx.Origin.Z))
	local model = Build.model((isBack and "BackPortal_" or "Portal_") .. targetWorldId, ctx.Folder)
	local frameColor = ctx.Palette.PortalFrame
	local glow = target.Color

	part(model, { Name = "Step", Size = Vector3.new(26, 1.2, 8), CFrame = base * CFrame.new(0, 0.6, 0), Color = frameColor:Lerp(Build.INK, 0.25), Material = Enum.Material.Slate })
	part(model, { Name = "Step2", Size = Vector3.new(22, 0.8, 6), CFrame = base * CFrame.new(0, 1.4, 0), Color = frameColor, Material = Enum.Material.Slate })
	for _, side in ipairs({ -1, 1 }) do
		part(model, { Name = "Pillar", Size = Vector3.new(3.4, 20, 3.4), CFrame = base * CFrame.new(side * 10, 11.6, 0), Color = frameColor, Material = Enum.Material.Slate })
		part(model, { Name = "PillarCap", Size = Vector3.new(4.4, 1.4, 4.4), CFrame = base * CFrame.new(side * 10, 22.2, 0), Color = frameColor:Lerp(WHITE, 0.15), Material = Enum.Material.Slate })
		for k = 1, 3 do
			part(model, { Name = "Rune", Size = Vector3.new(0.2, 1.6, 1.6), CFrame = base * CFrame.new(side * 10 - side * 1.75, 4 + k * 4.5, 0) * CFrame.Angles(math.rad(45), 0, 0), Color = glow, Material = Enum.Material.Neon })
		end
		local gem = part(model, { Name = "Gem", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = base * CFrame.new(side * 10, 23.8, 0), Color = glow, Material = Enum.Material.Neon })
		Build.light(gem, glow, 16, 1.4)
	end
	local top = part(model, { Name = "Top", Size = Vector3.new(25, 3, 4), CFrame = base * CFrame.new(0, 24.5, 0), Color = frameColor, Material = Enum.Material.Slate })

	-- Вихрь: светящийся диск и вращающееся кольцо.
	local swirl = part(model, {
		Name = "Swirl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 15, 15),
		CFrame = base * CFrame.new(0, 11.5, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = glow,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
	})
	Build.light(swirl, glow, 24, 2)
	local ring = Build.model("PortalRing", model)
	local ringCenter = base * CFrame.new(0, 11.5, -0.6)
	for i = 0, 15 do
		local angle = i / 16 * math.pi * 2
		part(ring, {
			Name = "RingSegment",
			Size = Vector3.new(2.6, 0.7, 0.6),
			CFrame = ringCenter * CFrame.Angles(0, 0, angle) * CFrame.new(0, 7.8, 0),
			Color = (i % 2 == 0) and glow or glow:Lerp(WHITE, 0.5),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	ring.WorldPivot = ringCenter * CFrame.Angles(math.pi / 2, 0, 0)
	ring:SetAttribute("SpinSpeed", 1.2)
	CollectionService:AddTag(ring, "Spin")

	local particles = Instance.new("ParticleEmitter")
	particles.Color = ColorSequence.new(glow, WHITE)
	particles.LightEmission = 1
	particles.Rate = 30
	particles.Lifetime = NumberRange.new(1, 2)
	particles.Speed = NumberRange.new(1, 3)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	particles.Parent = swirl

	local touch = part(model, {
		Name = "Touch",
		Size = Vector3.new(15, 17, 3),
		CFrame = base * CFrame.new(0, 11, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})

	local gui = Build.billboard(top, Vector2.new(20, 6.5), Vector3.new(0, 5.5, 0), 240)
	Build.list(gui)
	local title = isBack and ("Назад: " .. target.Name) or Format.Upper(target.Name)
	Build.line(gui, title, target.Color:Lerp(WHITE, 0.35), 0.55, 1, "Title")
	local status = isBack and "Открыто" or ("Нужно " .. Format.Number(target.UnlockStrength) .. " силы")
	Build.line(gui, status, WHITE, 0.4, 2, "Status")

	model:SetAttribute("TargetWorld", targetWorldId)
	model:SetAttribute("IsBack", isBack)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	CollectionService:AddTag(model, "Portal")
	return { Touch = touch, TargetWorld = targetWorldId }
end

return Structures
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Themes</string>
              <string name="Source"><![CDATA[--[[
	Themes — рельеф и декор каждого мира.
	Рельеф делается настоящим Terrain: трава (с травинками), вода с волнами, песок, камень,
	дорожки из земли и брусчатки, холмы, горы, озеро, оазис, летающий остров и кратеры.
	Декор — детали из Props.
]]

local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local Themes = {}

local M = Enum.Material
local HALF = Build.HALF

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

------------------------------------------------------------------ ОБЩЕЕ

-- Плоская земля: верх ровно на высоте центра мира.
local function groundPlate(ctx, size, material)
	Build.terrainBlock(CFrame.new(ctx.Origin + Vector3.new(0, -8, 0)), Vector3.new(size, 16, size), material)
end

-- Дорожки и площадки: заменяем верхний слой земли другим материалом.
local function paths(ctx, pathMaterial, plazaMaterial)
	local o = ctx.Origin
	local function strip(center, size, material)
		Build.terrainBlock(CFrame.new(o + center + Vector3.new(0, -2, 0)), size, material)
	end
	strip(Vector3.new(0, 0, 0), Vector3.new(10, 4, 236), pathMaterial)
	strip(Vector3.new(-24, 0, 35), Vector3.new(48, 4, 8), pathMaterial)
	strip(Vector3.new(21, 0, 20), Vector3.new(42, 4, 8), pathMaterial)
	local function plaza(center, radius)
		Build.terrainCylinder(CFrame.new(o + center + Vector3.new(0, -2, 0)), 4, radius, plazaMaterial)
	end
	plaza(Build.LAYOUT.Spawn, 32)
	plaza(Build.LAYOUT.EggPlaza, 23)
	plaza(Build.LAYOUT.Sell + Vector3.new(0, 0, 6), 18)
	plaza(Build.LAYOUT.NextPortal, 15)
	plaza(Build.LAYOUT.BackPortal, 15)
end

-- Водоём: песчаный берег, яма и вода.
local function pond(ctx, localCenter, radius, shoreMaterial)
	local center = ctx.Origin + localCenter
	Build.terrainCylinder(CFrame.new(center + Vector3.new(0, -2, 0)), 4, radius + 5, shoreMaterial)
	Build.terrainCylinder(CFrame.new(center + Vector3.new(0, -4, 0)), 8, radius, M.Air)
	Build.terrainCylinder(CFrame.new(center + Vector3.new(0, -5, 0)), 6, radius, M.Water)
	Build.terrainCylinder(CFrame.new(center + Vector3.new(0, -9, 0)), 2, radius, shoreMaterial)
	Build.addObstacle(ctx, localCenter.X, localCenter.Z, radius + 4)
end

local function placeAt(ctx, x, z)
	local y = Build.groundAt(ctx.Origin + Vector3.new(x, 0, z), ctx.Origin.Y)
	return Vector3.new(ctx.Origin.X + x, y, ctx.Origin.Z + z)
end

------------------------------------------------------------------ ЛЕС
function Themes.Forest(ctx)
	local rng, palette, decor, o = ctx.Rng, ctx.Palette, ctx.Decor, ctx.Origin

	groundPlate(ctx, 900, M.Grass)
	paths(ctx, M.Ground, M.Cobblestone)
	pond(ctx, Vector3.new(-72, 0, -58), 17, M.Sand)

	-- Пологие холмы внутри зоны.
	for _ = 1, 7 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if Build.isFree(ctx, x, z, 12, false) then
			local radius = rng:NextNumber(10, 15)
			Build.terrainBall(o + Vector3.new(x, -radius + rng:NextNumber(2.5, 5), z), radius, M.Grass)
			Build.addObstacle(ctx, x, z, radius * 0.5)
		end
	end
	-- Холмы и горы вокруг.
	for _ = 1, 26 do
		local x, z = Build.borderPoint(rng, HALF + 25, HALF + 150)
		local radius = rng:NextNumber(25, 50)
		Build.terrainBall(o + Vector3.new(x, -radius * 0.45, z), radius, M.Grass)
	end
	for i = 1, 12 do
		local angle = i / 12 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local distance = rng:NextNumber(300, 360)
		local radius = rng:NextNumber(55, 85)
		local center = o + Vector3.new(math.cos(angle) * distance, -radius * 0.25, math.sin(angle) * distance)
		Build.terrainBall(center, radius, M.Rock)
		Build.terrainBall(center + Vector3.new(0, radius * 0.62, 0), radius * 0.45, M.Snow)
	end

	-- Водопад: скальная гряда из «валунов» Terrain с травяными шапками,
	-- вода падает в ущелье между двумя выступами (плоская стенка только в глубине ущелья).
	local cliff = o + Vector3.new(-95, 0, -168)
	Build.terrainBlock(CFrame.new(cliff + Vector3.new(0, 20, -4)), Vector3.new(26, 48, 26), M.Rock)
	for _, boulder in ipairs({
		{ Vector3.new(-24, 16, 0), 22 }, { Vector3.new(24, 14, 2), 21 },
		{ Vector3.new(-44, 6, -6), 18 }, { Vector3.new(44, 4, -4), 17 },
		{ Vector3.new(-10, 22, -22), 22 }, { Vector3.new(14, 20, -24), 21 },
	}) do
		Build.terrainBall(cliff + boulder[1], boulder[2], M.Rock)
	end
	for _, cap in ipairs({
		{ Vector3.new(-24, 34, -2), 11 }, { Vector3.new(24, 32, 0), 10 },
		{ Vector3.new(-10, 40, -20), 12 }, { Vector3.new(14, 38, -22), 11 }, { Vector3.new(0, 42, -8), 10 },
	}) do
		Build.terrainBall(cliff + cap[1], cap[2], M.Grass)
	end
	Build.terrainCylinder(CFrame.new(cliff + Vector3.new(0, -3, 22)), 6, 16, M.Water)
	local fall = Build.part(decor, {
		Name = "Waterfall",
		Size = Vector3.new(9, 44, 1.5),
		CFrame = CFrame.new(cliff + Vector3.new(0, 22, 11.5)),
		Color = rgb(150, 220, 255),
		Material = M.Glass,
		Transparency = 0.25,
		Reflectance = 0.2,
		CanCollide = false,
	})
	local foam = Instance.new("ParticleEmitter")
	foam.Color = ColorSequence.new(rgb(255, 255, 255), rgb(190, 235, 255))
	foam.Rate = 60
	foam.Lifetime = NumberRange.new(1, 2)
	foam.Speed = NumberRange.new(4, 8)
	foam.SpreadAngle = Vector2.new(20, 20)
	foam.Acceleration = Vector3.new(0, -30, 0)
	foam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 2.5) })
	foam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	foam.EmissionDirection = Enum.NormalId.Front
	foam.Parent = fall

	-- Лилии на озере.
	for _ = 1, 7 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(3, 14)
		local at = o + Vector3.new(-72 + math.cos(angle) * distance, -1.85, -58 + math.sin(angle) * distance)
		Build.disc(decor, at, rng:NextNumber(2, 3.2), 0.15, rgb(80, 180, 70), { Name = "LilyPad", CanCollide = false })
		if rng:NextNumber() < 0.5 then
			Build.part(decor, { Name = "Lily", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7, CFrame = CFrame.new(at + Vector3.new(0.4, 0.3, 0)), Color = rgb(255, 150, 200), CanCollide = false })
		end
	end

	-- Мельница — ориентир.
	local millAt = placeAt(ctx, 92, 92)
	Props.windmill(decor, millAt, math.rad(-135), palette)
	Build.addObstacle(ctx, 92, 92, 10)

	-- Фонари и заборчики вдоль главной тропинки.
	for z = -96, 104, 25 do
		Props.lantern(decor, o + Vector3.new(-8.5, 0, z), rgb(255, 210, 130))
	end
	Props.fence(decor, o + Vector3.new(7, 0, 0), o + Vector3.new(7, 0, 12), palette.Wood or rgb(170, 110, 60))
	Props.fence(decor, o + Vector3.new(7, 0, 28), o + Vector3.new(7, 0, 42), palette.Wood or rgb(170, 110, 60))
	Props.fence(decor, o + Vector3.new(-7, 0, -40), o + Vector3.new(-7, 0, -90), palette.Wood or rgb(170, 110, 60))
	Props.bench(decor, o + Vector3.new(-14, 0, -20), math.rad(90), palette.Wood or rgb(170, 110, 60))
	Props.bench(decor, o + Vector3.new(14, 0, -60), math.rad(-90), palette.Wood or rgb(170, 110, 60))

	-- Деревья, кусты, грибы, цветы, камни.
	Build.scatter(ctx, 14, 5.5, function(position)
		return Props.oak(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 7, 4, function(position)
		return Props.birch(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 7, 5.5, function(position)
		return Props.pine(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 10, 3, function(position)
		return Props.mushroom(decor, position, rng)
	end)
	Build.scatter(ctx, 18, 3, function(position)
		return Props.bush(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 9, 3, function(position)
		return Props.rock(decor, position, rng, palette.Rock, rgb(100, 180, 80))
	end)
	Build.scatter(ctx, 5, 4.5, function(position)
		return Props.log(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 8, 3, function(position)
		Build.terrainBall(position + Vector3.new(0, -1, 0), rng:NextNumber(3, 5), M.Rock)
		return 5
	end)
	-- Цветы не мешают монетам, поэтому их не записываем в препятствия.
	for _ = 1, 24 do
		local x, z = rng:NextNumber(-HALF, HALF), rng:NextNumber(-HALF, HALF)
		if Build.isFree(ctx, x, z, 3, false) then
			Props.flowers(decor, placeAt(ctx, x, z), rng, palette, rng:NextInteger(5, 9))
		end
	end

	-- Густой лес по краям (кроме места перед водопадом — его должно быть видно).
	for _ = 1, 48 do
		local x, z = Build.borderPoint(rng, HALF + 6, HALF + 70)
		local position = placeAt(ctx, x, z)
		local blocksWaterfall = math.abs(x + 95) < 38 and z > -178 and z < -118
		if blocksWaterfall then
			continue
		elseif rng:NextNumber() < 0.65 then
			Props.pine(decor, position, rng, palette, rng:NextNumber(1.1, 1.7))
		else
			Props.oak(decor, position, rng, palette, rng:NextNumber(1.1, 1.5))
		end
	end
end

------------------------------------------------------------------ ПУСТЫНЯ
function Themes.Desert(ctx)
	local rng, palette, decor, o = ctx.Rng, ctx.Palette, ctx.Decor, ctx.Origin

	groundPlate(ctx, 900, M.Sand)
	paths(ctx, M.Sandstone, M.Limestone)

	-- Оазис: трава вокруг воды и пальмы.
	local oasis = Vector3.new(70, 0, -60)
	Build.terrainCylinder(CFrame.new(o + oasis + Vector3.new(0, -2, 0)), 4, 26, M.LeafyGrass)
	pond(ctx, oasis, 14, M.LeafyGrass)
	for k = 1, 6 do
		local angle = (k / 6) * math.pi * 2 + 0.3
		Props.palm(decor, placeAt(ctx, oasis.X + math.cos(angle) * 20, oasis.Z + math.sin(angle) * 20), rng, palette)
	end
	Build.addObstacle(ctx, oasis.X, oasis.Z, 25)

	-- Дюны внутри и вокруг.
	for _ = 1, 6 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if Build.isFree(ctx, x, z, 14, false) then
			local radius = rng:NextNumber(12, 18)
			Build.terrainBall(o + Vector3.new(x, -radius + rng:NextNumber(3, 5.5), z), radius, M.Sand)
			Build.addObstacle(ctx, x, z, radius * 0.5)
		end
	end
	for _ = 1, 30 do
		local x, z = Build.borderPoint(rng, HALF + 20, HALF + 190)
		local radius = rng:NextNumber(30, 60)
		Build.terrainBall(o + Vector3.new(x, -radius * 0.55, z), radius, M.Sand)
	end
	-- Столовые горы из песчаника.
	local mesas = { Vector3.new(-230, 0, -40), Vector3.new(-170, 0, 210), Vector3.new(230, 0, 120), Vector3.new(260, 0, -220), Vector3.new(-60, 0, 300) }
	for _, mesa in ipairs(mesas) do
		local width = rng:NextNumber(50, 80)
		local height = rng:NextNumber(26, 40)
		Build.terrainBlock(CFrame.new(o + mesa + Vector3.new(0, height / 2 - 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), Vector3.new(width, height, width * 0.7), M.Sandstone)
		Build.terrainBlock(CFrame.new(o + mesa + Vector3.new(0, height + 4, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), Vector3.new(width * 0.6, 12, width * 0.45), M.Sandstone)
	end

	-- Пирамиды.
	Props.pyramid(decor, o + Vector3.new(-80, 0, -78), 30, 8, palette)
	Build.addObstacle(ctx, -80, -78, 22)
	Props.pyramid(decor, o + Vector3.new(-120, 0, -260), 120, 15, palette)
	Props.pyramid(decor, o + Vector3.new(80, 0, -300), 90, 12, palette)
	Props.pyramid(decor, o + Vector3.new(270, 0, -100), 100, 13, palette)

	-- Факелы и обелиски вдоль тропинки.
	for z = -96, 104, 25 do
		Props.torch(decor, o + Vector3.new(-8.5, 0, z))
	end
	Props.obelisk(decor, o + Vector3.new(14, 0, -90), 14, palette)
	Props.obelisk(decor, o + Vector3.new(-14, 0, -90), 14, palette)
	Props.obelisk(decor, o + Vector3.new(20, 0, 46), 10, palette)

	Build.scatter(ctx, 20, 3, function(position)
		return Props.cactus(decor, position, rng, palette)
	end)
	Build.scatter(ctx, 7, 3, function(position)
		return Props.column(decor, position, rng, palette, rng:NextNumber() < 0.6)
	end)
	Build.scatter(ctx, 9, 2, function(position)
		return Props.vase(decor, position, rng)
	end)
	Build.scatter(ctx, 5, 3, function(position)
		return Props.bones(decor, position, rng)
	end)
	Build.scatter(ctx, 10, 3, function(position)
		return Props.rock(decor, position, rng, palette.Rock)
	end)
	Build.scatter(ctx, 6, 3, function(position)
		Build.terrainBall(position + Vector3.new(0, -1, 0), rng:NextNumber(3, 5), M.Sandstone)
		return 5
	end)
	for _ = 1, 26 do
		local x, z = Build.borderPoint(rng, HALF + 5, HALF + 40)
		Props.cactus(decor, placeAt(ctx, x, z), rng, palette)
	end
end

------------------------------------------------------------------ КОСМОС
function Themes.Space(ctx)
	local rng, palette, decor, o = ctx.Rng, ctx.Palette, ctx.Decor, ctx.Origin

	-- Летающий остров: плоская верхушка и «морковка» камня снизу.
	Build.terrainCylinder(CFrame.new(o + Vector3.new(0, -4, 0)), 8, 190, M.Basalt)
	local layers = { { 175, -12 }, { 150, -22 }, { 120, -32 }, { 90, -42 }, { 60, -52 }, { 34, -62 }, { 14, -72 } }
	for _, layer in ipairs(layers) do
		Build.terrainCylinder(CFrame.new(o + Vector3.new(0, layer[2], 0)), 12, layer[1], M.Rock)
	end
	for _ = 1, 16 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(20, 130)
		local radius = rng:NextNumber(18, 34)
		Build.terrainBall(o + Vector3.new(math.cos(angle) * distance, -radius - rng:NextNumber(6, 30), math.sin(angle) * distance), radius, M.Slate)
	end
	-- Светящиеся жилы под островом.
	for _ = 1, 10 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(40, 150)
		Build.terrainBall(o + Vector3.new(math.cos(angle) * distance, -rng:NextNumber(10, 30), math.sin(angle) * distance), rng:NextNumber(5, 9), M.CrackedLava)
	end

	paths(ctx, M.Pavement, M.Glacier)

	-- Лунная пыль пятнами.
	for _ = 1, 10 do
		local x, z = rng:NextNumber(-120, 120), rng:NextNumber(-120, 120)
		if Build.isFree(ctx, x, z, 10, true) then
			Build.terrainCylinder(CFrame.new(o + Vector3.new(x, -1, z)), 2, rng:NextNumber(8, 14), M.Snow)
		end
	end
	-- Кратеры.
	Build.scatter(ctx, 11, 10, function(position)
		local radius = rng:NextNumber(7, 11)
		Build.terrainBall(position + Vector3.new(0, radius * 0.55, 0), radius, M.Air)
		if rng:NextNumber() < 0.5 then
			Build.terrainBall(position + Vector3.new(0, -radius * 0.3, 0), radius * 0.35, M.CrackedLava)
		end
		return radius + 2
	end)

	-- Неоновые полосы вдоль главной дорожки.
	for _, side in ipairs({ -1, 1 }) do
		Build.part(decor, {
			Name = "PathLight",
			Size = Vector3.new(0.6, 0.3, 230),
			CFrame = CFrame.new(o + Vector3.new(side * 5.6, 0.15, 0)),
			Color = palette.Lamp,
			Material = M.Neon,
			CanCollide = false,
		})
	end
	for z = -96, 104, 25 do
		Props.lantern(decor, o + Vector3.new(-8.5, 0, z), palette.Lamp, 8)
	end

	-- База: ракета, купола, антенна, тарелки.
	Props.rocket(decor, o + Vector3.new(-44, 0, 96))
	Props.dome(decor, o + Vector3.new(72, 0, 92), 18)
	Build.addObstacle(ctx, 72, 92, 12)
	Props.dome(decor, o + Vector3.new(98, 0, 64), 12)
	Build.addObstacle(ctx, 98, 64, 8)
	Props.antenna(decor, o + Vector3.new(-96, 0, 96))
	Build.addObstacle(ctx, -96, 96, 4)
	Props.satellite(decor, o + Vector3.new(-100, 0, -30), math.rad(40))
	Build.addObstacle(ctx, -100, -30, 6)
	Props.satellite(decor, o + Vector3.new(100, 0, -100), math.rad(-130))
	Build.addObstacle(ctx, 100, -100, 6)

	local lightCount = 0
	Build.scatter(ctx, 16, 3.5, function(position)
		lightCount += 1
		return Props.crystals(decor, position, rng, palette.Crystals, lightCount % 2 == 0)
	end)
	Build.scatter(ctx, 12, 2.5, function(position)
		return Props.alienPlant(decor, position, rng)
	end)
	Build.scatter(ctx, 8, 3, function(position)
		return Props.rock(decor, position, rng, palette.Rock)
	end)

	-- Кристаллы по краю острова.
	for _ = 1, 34 do
		local x, z = Build.borderPoint(rng, HALF + 5, HALF + 55)
		if x * x + z * z < 182 * 182 then
			Props.crystals(decor, placeAt(ctx, x, z), rng, palette.Crystals, false)
		end
	end

	-- Летающие астероиды.
	for _ = 1, 28 do
		local position = o + Vector3.new(rng:NextNumber(-240, 240), rng:NextNumber(30, 95), rng:NextNumber(-240, 240))
		Props.asteroid(decor, position, rng, palette.Rock)
	end

	-- Планеты на небе.
	local planets = {
		{ Vector3.new(-380, 140, -420), 220, true },
		{ Vector3.new(420, 90, -260), 120, false },
		{ Vector3.new(180, 220, 460), 160, true },
	}
	for i, planet in ipairs(planets) do
		local color = palette.Planets[(i - 1) % #palette.Planets + 1]
		local center = o + planet[1]
		Build.part(decor, { Name = "Planet", Shape = Enum.PartType.Ball, Size = Vector3.one * planet[2], CFrame = CFrame.new(center), Color = color, CanCollide = false, CastShadow = false })
		Build.part(decor, { Name = "PlanetGlow", Shape = Enum.PartType.Ball, Size = Vector3.one * planet[2] * 1.08, CFrame = CFrame.new(center), Color = color, Material = M.Neon, Transparency = 0.85, CanCollide = false, CastShadow = false })
		if planet[3] then
			Build.part(decor, {
				Name = "PlanetRing",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1, planet[2] * 1.8, planet[2] * 1.8),
				CFrame = CFrame.new(center) * Build.VERTICAL * CFrame.Angles(0, math.rad(18), math.rad(10)),
				Color = color:Lerp(Build.WHITE, 0.4),
				Material = M.Neon,
				Transparency = 0.45,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

return Themes
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder — строит все миры при запуске сервера (никаких .rbxm-файлов).
	Рельеф — настоящий Terrain (трава, вода, песок, камень), постройки и декор — из деталей.

	Модули в папке World/:
		Build      — помощники (детали, надписи, Terrain, поиск высоты, расстановка декора)
		Props      — декор (деревья, кусты, камни, кактусы, кристаллы, ракета, мельница …)
		Structures — постройки (точка появления, фонтан, магазин, арка, продажа, яйца, порталы)
		Themes     — рельеф и декор каждого мира (Forest / Desert / Space)

	WorldBuilder.Build() -> { [worldId] = информация о мире } (см. конец buildWorld)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Worlds = require(Shared.Config.Worlds)
local Eggs = require(Shared.Config.Eggs)

local World = script.Parent:WaitForChild("World")
local Build = require(World.Build)
local Structures = require(World.Structures)
local Themes = require(World.Themes)

local WorldBuilder = {}

local HALF = Build.HALF

-- Цвета материалов рельефа (общие для всех миров, поэтому в каждом мире свои материалы).
local TERRAIN_COLORS = {
	[Enum.Material.Grass] = Color3.fromRGB(96, 196, 70),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(80, 200, 90),
	[Enum.Material.Ground] = Color3.fromRGB(176, 128, 80),
	[Enum.Material.Cobblestone] = Color3.fromRGB(190, 182, 168),
	[Enum.Material.Sand] = Color3.fromRGB(245, 212, 150),
	[Enum.Material.Sandstone] = Color3.fromRGB(222, 166, 104),
	[Enum.Material.Limestone] = Color3.fromRGB(238, 222, 190),
	[Enum.Material.Rock] = Color3.fromRGB(128, 122, 140),
	[Enum.Material.Snow] = Color3.fromRGB(235, 240, 255),
	[Enum.Material.Basalt] = Color3.fromRGB(78, 60, 122),
	[Enum.Material.Slate] = Color3.fromRGB(70, 58, 108),
	[Enum.Material.Pavement] = Color3.fromRGB(150, 150, 185),
	[Enum.Material.Glacier] = Color3.fromRGB(150, 210, 255),
	[Enum.Material.CrackedLava] = Color3.fromRGB(255, 110, 200),
}

local function buildWorld(worldId, rootFolder)
	local config = Worlds[worldId]
	local origin = config.Origin
	local palette = config.Palette
	local folder = Build.folder(worldId, rootFolder)

	local ctx = {
		Id = worldId,
		Config = config,
		Origin = origin,
		Palette = palette,
		Folder = folder,
		Map = Build.folder("Map", folder),
		Decor = Build.folder("Decor", folder),
		Rng = Random.new(config.Seed or 1),
		Obstacles = {},
	}

	-- Постройки ставим первыми: декор потом обходит их стороной.
	local spawnCFrame = Structures.spawn(ctx, worldId == GameConfig.StartWorld)
	Structures.fountain(ctx)
	Structures.shopStall(ctx)
	Structures.welcomeArch(ctx, config.ArchTitle or string.upper(config.Name))
	local sell = Structures.sellShop(ctx)

	local eggStands = {}
	for _, eggId in ipairs(Eggs.Order) do
		if Eggs[eggId].World == worldId then
			eggStands[eggId] = Structures.eggStand(ctx, eggId)
		end
	end

	local portals = {}
	local nextWorld = Worlds.Order[config.Order + 1]
	local previousWorld = Worlds.Order[config.Order - 1]
	if nextWorld then
		table.insert(portals, Structures.portal(ctx, Build.LAYOUT.NextPortal, nextWorld, false))
	end
	if previousWorld then
		table.insert(portals, Structures.portal(ctx, Build.LAYOUT.BackPortal, previousWorld, true))
	end

	-- Рельеф и декор мира.
	local theme = Themes[config.Theme]
	if theme then
		theme(ctx)
	end

	-- Невидимые стены по краю игровой зоны.
	local walls = {
		{ Vector3.new(HALF + 1, 75, 0), Vector3.new(2, 150, HALF * 2 + 4) },
		{ Vector3.new(-HALF - 1, 75, 0), Vector3.new(2, 150, HALF * 2 + 4) },
		{ Vector3.new(0, 75, HALF + 1), Vector3.new(HALF * 2 + 4, 150, 2) },
		{ Vector3.new(0, 75, -HALF - 1), Vector3.new(HALF * 2 + 4, 150, 2) },
	}
	for _, wall in ipairs(walls) do
		Build.part(ctx.Map, {
			Name = "Wall",
			Size = wall[2],
			CFrame = CFrame.new(origin + wall[1]),
			Transparency = 1,
			CastShadow = false,
			CanQuery = false,
		})
	end

	local coinsFolder = Build.folder("Coins", folder)

	return {
		Id = worldId,
		Folder = folder,
		Origin = origin,
		-- Игрок появляется над площадкой и смотрит на север (-Z), к центру мира.
		Spawn = spawnCFrame,
		Sell = sell,
		EggStands = eggStands,
		Portals = portals,
		CoinsFolder = coinsFolder,
		-- Случайное свободное место для монеты: (x, z) относительно центра мира и высота земли.
		RandomCoinPoint = function(rng)
			for _ = 1, 40 do
				local x = rng:NextNumber(-HALF + 8, HALF - 8)
				local z = rng:NextNumber(-HALF + 8, HALF - 8)
				if Build.isFree(ctx, x, z, 2, true) then
					local groundY, material = Build.groundAt(origin + Vector3.new(x, 0, z), origin.Y)
					if material ~= Enum.Material.Water then
						return x, z, groundY
					end
				end
			end
			return rng:NextNumber(-4, 4), rng:NextNumber(-60, 40), origin.Y
		end,
	}
end

function WorldBuilder.Build()
	if GameConfig.RemoveTemplateBaseplate then
		local baseplate = Workspace:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			baseplate:Destroy()
		end
		for _, item in ipairs(Workspace:GetDescendants()) do
			if item:IsA("SpawnLocation") then
				item:Destroy()
			end
		end
	end

	local old = Workspace:FindFirstChild("Worlds")
	if old then
		old:Destroy()
	end

	local terrain = Workspace.Terrain
	terrain:Clear()
	for material, color in pairs(TERRAIN_COLORS) do
		terrain:SetMaterialColor(material, color)
	end

	local rootFolder = Instance.new("Folder")
	rootFolder.Name = "Worlds"
	rootFolder.Parent = Workspace
	local result = {}
	for _, worldId in ipairs(Worlds.Order) do
		result[worldId] = buildWorld(worldId, rootFolder)
	end
	return result
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService — всё, что происходит в мирах:
	- телепорт между мирами и открытие новых миров (порталы и меню «Миры»);
	- продажа силы на точке продажи;
	- монеты на земле: появление, сбор, возрождение;
	- возвращение игрока в его мир после смерти и при входе.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Worlds = require(Shared.Config.Worlds)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Modules = script.Parent
local DataService = require(Modules.DataService)
local PlayerState = require(Modules.PlayerState)
local RateLimiter = require(Modules.RateLimiter)

local WorldService = {}

local worldRefs = nil
local rng = Random.new()
local portalCooldown = {} -- [player] = время последнего касания портала
local teleportLimiter = RateLimiter.new(1, 2)

local function playerFromHit(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local player = Players:GetPlayerFromCharacter(model)
		if player then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				return player
			end
			return nil
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

------------------------------------------------------------------ ТЕЛЕПОРТ И МИРЫ

function WorldService.Teleport(player, worldId)
	local data = DataService.Get(player)
	local info = worldRefs[worldId]
	if not data or not info then
		return
	end
	data.CurrentWorld = worldId
	PlayerState.SyncStats(player)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local target = info.Spawn * CFrame.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
	-- Подгружаем мир вокруг точки появления (при включённом StreamingEnabled), чтобы игрок не провалился.
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 2)
	end)
	if character.Parent then
		character:PivotTo(target)
	end
	PlayerState.Effect(player, "Teleport", { World = worldId })
end

-- Попросить переход в мир: открывает его, если хватает накопленной силы, и телепортирует.
function WorldService.RequestWorld(player, worldId)
	local data = DataService.Get(player)
	local world = Worlds[worldId]
	if not data then
		return false, "Данные ещё загружаются…"
	end
	if type(worldId) ~= "string" or worldId == "Order" or not world then
		return false, "Такого мира нет"
	end

	if not data.UnlockedWorlds[worldId] then
		local previous = Worlds.Order[world.Order - 1]
		if previous and not data.UnlockedWorlds[previous] then
			return false, "Сначала открой мир «" .. Worlds[previous].Name .. "»"
		end
		if data.TotalStrength < world.UnlockStrength then
			return false,
				string.format(
					"Мир «%s» закрыт: нужно %s накопленной силы (у тебя %s)",
					world.Name,
					Format.Number(world.UnlockStrength),
					Format.Number(data.TotalStrength)
				)
		end
		data.UnlockedWorlds[worldId] = true
		PlayerState.Effect(player, "Unlock", { World = worldId })
	end

	WorldService.Teleport(player, worldId)
	return true, world.Name
end

local function onPortalTouched(hit, targetWorld)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	local now = os.clock()
	if (portalCooldown[player] or 0) + 2 > now then
		return
	end
	portalCooldown[player] = now
	local ok, message = WorldService.RequestWorld(player, targetWorld)
	if not ok and message then
		PlayerState.Notify(player, message, "warning")
	end
end

------------------------------------------------------------------ ПРОДАЖА

function WorldService.Sell(player, worldId)
	local data = DataService.Get(player)
	if not data or data.Strength < 1 then
		return
	end
	local sold = data.Strength
	local coins = Formulas.SellValue(sold, worldId)
	data.Strength = 0
	data.Coins += coins
	PlayerState.SyncStats(player)
	PlayerState.Effect(player, "Sell", { Amount = coins, Strength = sold })
end

-- Раз в 0.25 секунды проверяем, кто стоит в круге продажи.
local function sellLoop()
	while true do
		task.wait(0.25)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if data and root and data.Strength >= 1 then
				for worldId, info in pairs(worldRefs) do
					local offset = root.Position - info.Sell.Position
					if Vector2.new(offset.X, offset.Z).Magnitude <= info.Sell.Radius and math.abs(offset.Y) < 10 then
						WorldService.Sell(player, worldId)
						break
					end
				end
			end
		end
	end
end

------------------------------------------------------------------ МОНЕТЫ

local function spawnCoin(worldId)
	local info = worldRefs[worldId]
	local config = Worlds[worldId]
	local x, z, groundY = info.RandomCoinPoint(rng)
	local big = rng:NextNumber() < GameConfig.BigCoinChance
	local value = config.CoinValue * (big and GameConfig.BigCoinMultiplier or 1)
	local diameter = big and 4.4 or 2.8

	local coin = Instance.new("Part")
	coin.Name = big and "BigCoin" or "Coin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.5, diameter, diameter)
	coin.CFrame = CFrame.new(Vector3.new(info.Origin.X + x, (groundY or info.Origin.Y) + diameter / 2 + 1, info.Origin.Z + z))
		* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	coin.Anchored = true
	coin.CanCollide = false
	coin.CanQuery = false
	coin.CastShadow = false
	coin.Color = config.Palette.Coin
	coin.Material = Enum.Material.SmoothPlastic
	coin.Reflectance = 0.25
	coin:SetAttribute("Value", value)

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(Color3.new(1, 1, 1), config.Palette.Coin)
	sparkle.LightEmission = 1
	sparkle.Rate = big and 5 or 2
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Speed = NumberRange.new(0.5, 1)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Parent = coin

	local light = Instance.new("PointLight")
	light.Color = config.Palette.Coin
	light.Range = big and 9 or 6
	light.Brightness = 0.8
	light.Parent = coin

	local collected = false
	coin.Touched:Connect(function(hit)
		if collected then
			return
		end
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local data = DataService.Get(player)
		if not data then
			return
		end
		collected = true
		data.Coins += value
		PlayerState.SyncStats(player)
		PlayerState.Effect(player, "Coin", { Amount = value, Position = coin.Position })
		coin:Destroy()
		task.delay(GameConfig.CoinRespawnTime + rng:NextNumber(0, 4), spawnCoin, worldId)
	end)

	CollectionService:AddTag(coin, "Coin")
	coin.Parent = info.CoinsFolder
end

------------------------------------------------------------------ ИГРОКИ

function WorldService.PlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		local data = DataService.Get(player)
		if not data or data.CurrentWorld == GameConfig.StartWorld then
			return
		end
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and character.Parent then
			task.wait(0.1)
			WorldService.Teleport(player, data.CurrentWorld)
		end
	end)
end

-- Данные загрузились: если игрок вышел из игры в другом мире — возвращаем его туда.
function WorldService.OnDataLoaded(player)
	local data = DataService.Get(player)
	if data and data.CurrentWorld ~= GameConfig.StartWorld and player.Character then
		WorldService.Teleport(player, data.CurrentWorld)
	end
end

function WorldService.PlayerRemoving(player)
	portalCooldown[player] = nil
	teleportLimiter:Remove(player)
end

function WorldService.Init(refs)
	worldRefs = refs

	for worldId, info in pairs(worldRefs) do
		for _, portal in ipairs(info.Portals) do
			portal.Touch.Touched:Connect(function(hit)
				onPortalTouched(hit, portal.TargetWorld)
			end)
		end
		for _ = 1, Worlds[worldId].CoinCount do
			spawnCoin(worldId)
		end
	end

	Remotes.Teleport.OnServerInvoke = function(player, worldId)
		if not teleportLimiter:Allow(player) then
			return false, "Не так быстро!"
		end
		return WorldService.RequestWorld(player, worldId)
	end

	task.spawn(sellLoop)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="37">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="38">
      <Properties>
        <string name="Name">HatchGui</string>
        <int name="DisplayOrder">20</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ScreenInsets">0</token>
        <token name="ZIndexBehavior">1</token>
      </Properties>
    </Item>
    <Item class="ScreenGui" referent="39">
      <Properties>
        <string name="Name">PowerPetsGui</string>
        <int name="DisplayOrder">5</int>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ScreenInsets">2</token>
        <token name="ZIndexBehavior">1</token>
