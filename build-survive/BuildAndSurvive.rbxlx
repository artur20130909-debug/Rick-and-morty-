		radius = 150, blockDamage = 12000, playerDamage = 300, aa = 0, warn = true,
		visual = "Nuke", launchSound = "Siren", fx = "Nuke", shake = 4, heavy = true,
	},
	{
		key = "Laser", name = "Орбитальный лазер", icon = "☼", wave = 12, weight = 0,
		desc = "Луч из космоса прожигает крышу слой за слоем и ползёт за тобой. Золото его отражает.",
		origin = "Orbit", motion = "Beam", chargeTime = 3, duration = 5.5, beamRadius = 5, trackSpeed = 7,
		radius = 5, blockDamage = 1100, playerDamage = 75, aa = 0,
		visual = "Laser", launchSound = "LaserCharge", loopSound = "LaserLoop", fx = "Laser", shake = 1.2, heavy = true,
	},
}

Weapons.ByKey = {}
for i, w in Weapons.List do
	w.index = i
	w.aa = w.aa or 0
	w.shake = w.shake or 0
	Weapons.ByKey[w.key] = w
end

-- Сколько стоит «перезарядка» в режиме Полигон
function Weapons.cooldown(w): number
	if w.heavy then
		return 6
	end
	return 0.35
end

-- Положение снаряда с постоянным ускорением (для клиента и сервера одинаково)
function Weapons.ballistic(p0: Vector3, v0: Vector3, g: number, t: number): Vector3
	return p0 + v0 * t + Vector3.new(0, -0.5 * g * t * t, 0)
end

-- Начальная скорость, чтобы попасть из p0 в p1 за время t при гравитации g
function Weapons.solveBallistic(p0: Vector3, p1: Vector3, g: number, t: number): Vector3
	local d = p1 - p0
	return Vector3.new(d.X / t, d.Y / t + 0.5 * g * t, d.Z / t)
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="38">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="39">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- BUILD & SURVIVE — сервер. Здесь всё соединяется вместе.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Server = script.Parent:WaitForChild("Server")
local TerrainGen = require(Server.TerrainGen)
local Data = require(Server.Data)
local Plots = require(Server.Plots)
local Building = require(Server.Building)
local Shop = require(Server.Shop)
local Specials = require(Server.Specials)
local Damage = require(Server.Damage)
local Projectiles = require(Server.Projectiles)
local Siege = require(Server.Siege)
local Launch = require(Server.Launch)
local Lobby = require(Server.Lobby)

-- Мир --------------------------------------------------------------------------------
task.spawn(TerrainGen.build)
Plots.init()
Damage.init()
Specials.init()
Lobby.init()

-- То, сквозь что пролетают снаряды: вышки, вражеские базы, обломки, купола щитов
do
	local exclude: { Instance } = { Damage.debrisFolder() }
	local map = workspace:FindFirstChild("Map")
	local forts = map and map:FindFirstChild("EnemyForts")
	if forts then
		table.insert(exclude, forts)
	end
	for _, plot in Plots.list do
		local towers = plot.model:FindFirstChild("Towers")
		if towers then
			table.insert(exclude, towers)
		end
		table.insert(exclude, plot.effects)
	end
	Projectiles.setExclude(exclude)
	Damage.setExclude(exclude)
end

RunService.Heartbeat:Connect(function(dt)
	Projectiles.step(math.min(dt, 0.1))
end)

-- Игроки -----------------------------------------------------------------------------
local function setCollisionGroup(char: Model)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Players"
		end
	end
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = "Players"
		end
	end)
end

local function onPlayerAdded(player: Player)
	-- участок выдаём сразу (без ожидания сохранений), чтобы игрок появился на нём
	local plot = Plots.assign(player)
	player.CharacterAdded:Connect(setCollisionGroup)
	if player.Character then
		setCollisionGroup(player.Character)
	end
	local profile = Data.load(player)
	if not player.Parent then
		Data.release(player)
		return
	end
	if plot then
		if profile.Auto ~= "" then
			Building.loadString(plot, profile.Auto)
		elseif Data.isNew(player) then
			Building.starter(plot)
		end
		-- если персонаж успел появиться где-то ещё — переносим на свой участок
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and root and not Plots.isOnIsland(plot, root.Position) then
			char:PivotTo(plot.spawn.CFrame + Vector3.new(0, 4, 0))
		end
	end
	local bonus = Data.tryDaily(player)
	Data.sync(player)
	task.delay(2, function()
		if not player.Parent then
			return
		end
		if not plot then
			Building.notify(player, "Все участки заняты — можно смотреть, как строят другие", "warning")
		else
			Building.notify(player, "Твой участок: " .. plot.colorName .. ". Строй и выживай!", "info")
		end
		if bonus > 0 then
			Building.notify(player, "Ежедневный бонус: +" .. bonus .. " золота", "success")
		end
		if not Data.saveEnabled(player) then
			Building.notify(player, "Сохранения выключены (в Studio: Game Settings → Security → API Services)", "warning")
		end
	end)
end

local function onPlayerRemoving(player: Player)
	local plot = Plots.of(player)
	local profile = Data.get(player)
	if plot and profile then
		-- сохраняем целую постройку, а не руины после осады
		profile.Auto = Siege.snapshotOf(plot) or Launch.snapshotOf(plot) or Building.serialize(plot)
		Siege.finish(plot, "left")
		Launch.stop(player, true)
	end
	Data.save(player)
	if plot then
		Building.clear(plot)
		plot.siege = nil
		plot.launched = false
		Plots.release(player)
	end
	Building.forget(player)
	Data.release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		local plot = Plots.of(player)
		local profile = Data.get(player)
		if plot and profile then
			profile.Auto = Siege.snapshotOf(plot) or Launch.snapshotOf(plot) or Building.serialize(plot)
		end
	end
	Data.saveAll()
end)

-- Автосохранение
task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in Players:GetPlayers() do
			local plot = Plots.of(player)
			local profile = Data.get(player)
			if plot and profile and not plot.siege and not plot.launched then
				profile.Auto = Building.serialize(plot)
			end
			task.spawn(Data.save, player)
		end
	end
end)

-- Удалённые вызовы -------------------------------------------------------------------
local function bind(name: string, handler: (Player, ...any) -> (boolean, string?))
	Net.func(name).OnServerInvoke = function(player: Player, ...)
		local ok, a, b = pcall(handler, player, ...)
		if not ok then
			warn("[" .. name .. "]", a)
			return false, "Ошибка сервера"
		end
		return a, b
	end
end

bind("Place", Building.place)
bind("Delete", Building.delete)
bind("Paint", Building.paint)
bind("Undo", Building.undo)
bind("Clear", Building.clearRequest)
bind("SaveSlot", Building.saveSlot)
bind("LoadSlot", Building.loadSlot)
bind("LoadExample", Building.loadExample)
bind("Buy", Shop.buy)
bind("StartSiege", Siege.start)
bind("StopSiege", Siege.stop)
bind("FireRange", Siege.fireRange)
bind("Restore", Siege.restore)
bind("Launch", Launch.start)
bind("StopLaunch", function(player)
	return Launch.stop(player)
end)
bind("GetData", function(player)
	Data.sync(player)
	return true, nil
end)
bind("SetSettings", function(player, settings)
	local profile = Data.get(player)
	if not profile or typeof(settings) ~= "table" then
		return false, nil
	end
	for k, default in Config.DefaultSettings do
		local v = settings[k]
		if v ~= nil and typeof(v) == typeof(default) then
			profile.Settings[k] = v
		end
	end
	return true, nil
end)

print("[BUILD & SURVIVE] сервер запущен")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="40">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Attacks</string>
          <string name="Source"><![CDATA[-- Как стреляет каждое оружие: откуда, куда целится, сколько снарядов.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)
local Projectiles = require(script.Parent.Projectiles)
local Damage = require(script.Parent.Damage)
local Data = require(script.Parent.Data)

local Attacks = {}

type Plot = Plots.Plot

-- Контекст атаки (его создаёт Siege)
export type Ctx = {
	plot: Plot,
	player: Player?,
	mul: number,
	ended: boolean,
	nukes: number,
}

local rng = Random.new()
local laserId = 0

local function rand(t: { Vector3 }): Vector3
	return t[rng:NextInteger(1, #t)]
end

local function spreadDir(dir: Vector3, deg: number): Vector3
	if deg <= 0 then
		return dir.Unit
	end
	local cf = CFrame.lookAt(Vector3.zero, dir)
		* CFrame.Angles(0, 0, rng:NextNumber(0, math.pi * 2))
		* CFrame.Angles(rng:NextNumber(0, math.rad(deg)), 0, 0)
	return cf.LookVector
end

local function ownerRoot(ctx: Ctx): BasePart?
	local _, _, root = Plots.ownerCharacter(ctx.plot)
	return root
end

-- Выбрать цель: игрок (чаще) или случайный блок постройки
local function pickTarget(ctx: Ctx, aim: Vector3?, playerChance: number?): (Vector3, Player?)
	if aim then
		return aim, nil
	end
	local root = ownerRoot(ctx)
	if root and rng:NextNumber() < (playerChance or 0.65) then
		return root.Position, ctx.player
	end
	local blocks = ctx.plot.blocks:GetChildren()
	if #blocks > 0 then
		local b = blocks[rng:NextInteger(1, #blocks)] :: BasePart
		return b.Position, nil
	end
	if root then
		return root.Position, ctx.player
	end
	return ctx.plot.cf * Vector3.new(rng:NextNumber(-24, 24), 2, rng:NextNumber(-24, 24)), nil
end

-- Упреждение для быстрых снарядов
local function lead(target: Vector3, targetPlayer: Player?, from: Vector3, speed: number): Vector3
	if not targetPlayer or speed <= 0 then
		return target
	end
	local char = targetPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return target
	end
	local t = (target - from).Magnitude / speed
	return target + root.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * t * 0.7
end

local function nearestTower(ctx: Ctx, target: Vector3): Vector3
	-- чаще стреляет ближайшая вышка, иногда — случайная
	if rng:NextNumber() < 0.35 then
		return rand(ctx.plot.towers)
	end
	local best, bestD = ctx.plot.towers[1], math.huge
	for _, t in ctx.plot.towers do
		local d = (t - target).Magnitude
		if d < bestD then
			best, bestD = t, d
		end
	end
	return best
end

local function warnMarker(ctx: Ctx, kind: string, pos: Vector3, radius: number, eta: number)
	Net.event("Warning"):FireAllClients({ kind = kind, p = pos, r = radius, t = eta, plot = ctx.plot.index })
end

-- ОРУЖИЕ --------------------------------------------------------------------------
local fire = {}

local function bulletBurst(ctx: Ctx, w, aim: Vector3?)
	local target, tp = pickTarget(ctx, aim, 0.8)
	local muzzle = nearestTower(ctx, target)
	local n = w.burst or 1
	for _ = 1, n do
		if ctx.ended then
			return
		end
		local root = tp and ownerRoot(ctx)
		local t = (root and not aim) and root.Position or target
		local aimAt = lead(t, tp, muzzle, w.speed)
		Projectiles.spawn(ctx.plot, w, muzzle, spreadDir(aimAt - muzzle, w.spread or 0) * w.speed, { mul = ctx.mul, lifetime = 3 })
		if n > 1 then
			task.wait(w.burstGap or 0.1)
		end
	end
end

fire.Bullet = bulletBurst
fire.Minigun = bulletBurst

function fire.Shotgun(ctx: Ctx, w, aim: Vector3?)
	local target, tp = pickTarget(ctx, aim, 0.85)
	local muzzle = nearestTower(ctx, target)
	local aimAt = lead(target, tp, muzzle, w.speed)
	for _ = 1, (w.pellets or 8) do
		Projectiles.spawn(ctx.plot, w, muzzle, spreadDir(aimAt - muzzle, w.spread) * w.speed * rng:NextNumber(0.9, 1.1), { mul = ctx.mul, lifetime = 3 })
	end
end

function fire.Grenade(ctx: Ctx, w, aim: Vector3?)
	local target = pickTarget(ctx, aim, 0.7)
	local muzzle = nearestTower(ctx, target)
	target += Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
	local t = math.clamp((target - muzzle).Magnitude / 55, 1.2, 2.6)
	Projectiles.spawn(ctx.plot, w, muzzle, Weapons.solveBallistic(muzzle, target, w.gravity, t), { mul = ctx.mul, targetPos = target })
end

function fire.Mortar(ctx: Ctx, w, aim: Vector3?)
	local target = pickTarget(ctx, aim, 0.6)
	target += Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
	local origin = rand(ctx.plot.layout.mortars)
	local t = w.flightTime
	warnMarker(ctx, "marker", target, w.radius, t)
	Projectiles.spawn(ctx.plot, w, origin, Weapons.solveBallistic(origin, target, w.gravity, t), { mul = ctx.mul, targetPos = target, lifetime = t + 3 })
end

function fire.RPG(ctx: Ctx, w, aim: Vector3?)
	local target, tp = pickTarget(ctx, aim, 0.6)
	local origin = rand(ctx.plot.layout.rails)
	local aimAt = lead(target, tp, origin, w.speed)
	Projectiles.spawn(ctx.plot, w, origin, spreadDir(aimAt - origin, 0.6) * w.speed, { mul = ctx.mul, targetPos = aimAt, lifetime = 8 })
end

function fire.Homing(ctx: Ctx, w, aim: Vector3?)
	local target, tp = pickTarget(ctx, aim, 0.9)
	local origin = rand(ctx.plot.layout.silos)
	local away = (target - origin) * Vector3.new(1, 0, 1)
	local vel = Vector3.new(0, w.speed * 0.9, 0) + (away.Magnitude > 0 and away.Unit * w.speed * 0.25 or Vector3.zero)
	Projectiles.spawn(ctx.plot, w, origin, vel, { mul = ctx.mul, target = tp, targetPos = target })
end

function fire.Cruise(ctx: Ctx, w, aim: Vector3?)
	local target, tp = pickTarget(ctx, aim, 0.5)
	local origin = rand(ctx.plot.layout.rails)
	local flat = (target - origin) * Vector3.new(1, 0, 1)
	Projectiles.spawn(ctx.plot, w, origin, (flat.Unit + Vector3.new(0, 0.2, 0)).Unit * w.speed, { mul = ctx.mul, target = tp, targetPos = target })
end

function fire.Cluster(ctx: Ctx, w, aim: Vector3?)
	local target = pickTarget(ctx, aim, 0.5)
	local fortPos = ctx.plot.layout.fortCf.Position
	local dir = ((target - fortPos) * Vector3.new(1, 0, 1)).Unit
	local altitude = target.Y + 170
	local speed = 140
	local drop = (altitude - (target.Y + w.splitHeight))
	local fallTime = math.sqrt(2 * drop / w.gravity)
	local release = Vector3.new(target.X, altitude, target.Z) - dir * speed * fallTime
	local start = release - dir * 520
	local finish = release + dir * 760
	local releaseDelay = 520 / speed
	Net.event("Bomber"):FireAllClients({ s = start, e = finish, v = speed, t = workspace:GetServerTimeNow(), drop = releaseDelay })
	task.delay(releaseDelay, function()
		if ctx.ended then
			return
		end
		Projectiles.spawn(ctx.plot, w, release, dir * speed, {
			mul = ctx.mul, targetPos = target, splitY = target.Y + w.splitHeight, g = w.gravity, lifetime = 10,
		})
	end)
end

function fire.Ballistic(ctx: Ctx, w, aim: Vector3?)
	local target = pickTarget(ctx, aim, 0.6)
	target += Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
	local start = target + Vector3.new(rng:NextNumber(-40, 40), w.dropHeight, rng:NextNumber(-40, 40))
	local eta = (target - start).Magnitude / w.speed
	warnMarker(ctx, "marker", target, w.radius, eta)
	Projectiles.spawn(ctx.plot, w, start, (target - start).Unit * w.speed, { mul = ctx.mul, targetPos = target, lifetime = eta + 3 })
end

function fire.Nuke(ctx: Ctx, w, aim: Vector3?)
	local target = aim
	if not target then
		local root = ownerRoot(ctx)
		target = root and root.Position or ctx.plot.cf.Position
	end
	local floorY = ctx.plot.cf.Position.Y
	local ground = Vector3.new(target.X, floorY, target.Z)
	local start = ground + Vector3.new(0, w.dropHeight, 0)
	local eta = (w.dropHeight - w.burstHeight) / w.speed
	warnMarker(ctx, "nuke", ground, w.radius, eta)
	ctx.nukes += 1
	Projectiles.spawn(ctx.plot, w, start, Vector3.new(0, -w.speed, 0), {
		mul = ctx.mul,
		targetPos = ground,
		burstY = floorY + w.burstHeight,
		lifetime = eta + 5,
		onDetonate = function()
			-- если игрок пережил ядерный взрыв — это рекорд в статистику
			task.wait(2.5)
			local player = ctx.player
			local root = ownerRoot(ctx)
			if player and root and not ctx.ended then
				local profile = Data.get(player)
				if profile then
					profile.Stats.Nukes = (profile.Stats.Nukes or 0) + 1
				end
				Net.event("Notify"):FireClient(player, "☢ Ты пережил ядерный удар!", "success")
			end
		end,
	})
end

function fire.Laser(ctx: Ctx, w, aim: Vector3?)
	laserId += 1
	local id = laserId
	local plot = ctx.plot
	local function playerXZ(): Vector3?
		local root = ownerRoot(ctx)
		return root and Vector3.new(root.Position.X, 0, root.Position.Z)
	end
	local start = aim or playerXZ() or plot.cf.Position
	local pos = Vector3.new(start.X, 0, start.Z)
	local floorY = plot.cf.Position.Y
	Net.event("LaserState"):FireAllClients({ id = id, phase = "charge", p = Vector3.new(pos.X, floorY, pos.Z), t = w.chargeTime, r = w.beamRadius })
	local t = 0
	local dt = 0.1
	while t < w.chargeTime do
		if ctx.ended then
			Net.event("LaserState"):FireAllClients({ id = id, phase = "end" })
			return
		end
		if not aim then
			local p = playerXZ()
			if p then
				local d = p - pos
				local step = math.min(d.Magnitude, 22 * dt)
				if d.Magnitude > 0.01 then
					pos += d.Unit * step
				end
			end
		end
		Net.unreliable("LaserTick"):FireAllClients(id, pos.X, pos.Z, nil)
		task.wait(dt)
		t += dt
	end
	Net.event("LaserState"):FireAllClients({ id = id, phase = "fire", p = Vector3.new(pos.X, floorY, pos.Z), t = w.duration, r = w.beamRadius })
	t = 0
	while t < w.duration and not ctx.ended do
		if not aim then
			local p = playerXZ()
			if p then
				local d = p - pos
				local step = math.min(d.Magnitude, w.trackSpeed * dt)
				if d.Magnitude > 0.01 then
					pos += d.Unit * step
				end
			end
		end
		local hitY = Damage.laserTick(plot, pos.X, pos.Z, w.beamRadius, w.blockDamage, w.playerDamage, dt, ctx.mul)
		Net.unreliable("LaserTick"):FireAllClients(id, pos.X, pos.Z, hitY)
		task.wait(dt)
		t += dt
	end
	Net.event("LaserState"):FireAllClients({ id = id, phase = "end" })
end

-- Выстрелить оружием key. aim — точка (полигон), иначе цель выбирается сама.
function Attacks.fire(ctx: Ctx, key: string, aim: Vector3?)
	local w = Weapons.ByKey[key]
	local f = fire[key]
	if not w or not f then
		return
	end
	task.spawn(f, ctx, w, aim)
end

return Attacks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Building</string>
          <string name="Source"><![CDATA[-- Строительство на сервере: проверка каждого запроса клиента, создание блоков,
-- отмена действий, сохранение и загрузка построек.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)
local Grid = require(Shared.Grid)
local BlockFactory = require(Shared.BlockFactory)
local Serializer = require(Shared.Serializer)
local Util = require(Shared.Util)
local Net = require(Shared.Net)
local Examples = require(Shared.Examples)

local Plots = require(script.Parent.Plots)
local Data = require(script.Parent.Data)

local Building = {}

type Spec = Serializer.Spec
type Plot = Plots.Plot

local lastAction: { [Player]: number } = {}

local function notify(player: Player, text: string, kind: string?)
	Net.event("Notify"):FireClient(player, text, kind or "info")
end
Building.notify = notify

-- Можно ли сейчас менять постройку на участке?
function Building.canEdit(plot: Plot): (boolean, string?)
	if plot.siege then
		return false, "Во время осады строить нельзя"
	end
	if plot.launched then
		return false, "Сначала останови испытание"
	end
	return true, nil
end

function Building.specOf(block: BasePart): Spec
	return {
		mat = block:GetAttribute("Mat") or 1,
		shape = block:GetAttribute("Shape") or 1,
		item = block:GetAttribute("Item") or 0,
		pos = block:GetAttribute("Local") or Vector3.zero,
		size = block:GetAttribute("BlockSize") or block.Size,
		rot = block:GetAttribute("Rot") or 1,
		color = block:GetAttribute("BaseColor") or block.Color,
	}
end

-- Создать блок на участке (без проверок — их делает вызывающий код)
function Building.create(plot: Plot, spec: Spec): BasePart
	local cf = Grid.worldCFrame(plot.cf, spec.pos, spec.rot)
	local part = BlockFactory.build(spec, cf, { plotColor = plot.color })
	local maxHp = Blocks.maxHp(spec, spec.size)
	part:SetAttribute("Mat", spec.mat)
	part:SetAttribute("Shape", spec.shape)
	part:SetAttribute("Item", spec.item)
	part:SetAttribute("Rot", spec.rot)
	part:SetAttribute("Local", spec.pos)
	part:SetAttribute("BlockSize", spec.size)
	part:SetAttribute("BaseColor", spec.color)
	part:SetAttribute("Hp", maxHp)
	part:SetAttribute("MaxHp", maxHp)
	local def = Blocks.def(spec)
	if spec.item > 0 and def.key == "Door" then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "DoorPrompt"
		prompt.ActionText = "Открыть"
		prompt.ObjectText = "Дверь"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = part
	end
	part.Parent = plot.blocks
	return part
end

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Include

function Building.overlaps(plot: Plot, spec: Spec, ignore: BasePart?): boolean
	overlapParams.FilterDescendantsInstances = { plot.blocks }
	local cf = Grid.worldCFrame(plot.cf, spec.pos, spec.rot)
	local hits = workspace:GetPartBoundsInBox(cf, spec.size - Vector3.new(0.12, 0.12, 0.12), overlapParams)
	for _, h in hits do
		if h ~= ignore and h.Name == "Block" then
			return true
		end
	end
	return false
end

-- Превратить запрос клиента в проверенную спецификацию
local function validate(player: Player, req: any): (Spec?, string?)
	if typeof(req) ~= "table" then
		return nil, "Неверный запрос"
	end
	if typeof(req.pos) ~= "Vector3" or typeof(req.size) ~= "Vector3" or typeof(req.color) ~= "Color3" then
		return nil, "Неверный запрос"
	end
	local pos: Vector3 = req.pos
	if not (Util.isFiniteNumber(pos.X) and Util.isFiniteNumber(pos.Y) and Util.isFiniteNumber(pos.Z)) then
		return nil, "Неверный запрос"
	end
	local item = math.floor(tonumber(req.item) or 0)
	local mat = math.floor(tonumber(req.mat) or 1)
	local shape = math.floor(tonumber(req.shape) or 1)
	local rot = math.floor(tonumber(req.rot) or 1)
	if rot < 1 or rot > 24 then
		rot = 1
	end
	if item > 0 then
		local it = Blocks.ItemById[item]
		if not it then
			return nil, "Нет такого блока"
		end
		if it.price > 0 and not Data.isUnlocked(player, "i:" .. it.key) then
			return nil, "Сначала купи «" .. it.name .. "» в магазине"
		end
		mat, shape = 0, 1
	else
		local m = Blocks.MaterialById[mat]
		if not m then
			return nil, "Нет такого материала"
		end
		if m.price > 0 and not Data.isUnlocked(player, "m:" .. m.key) then
			return nil, "Сначала купи «" .. m.name .. "» в магазине"
		end
		if not Blocks.ShapeById[shape] then
			shape = 1
		end
		item = 0
	end
	local size = Blocks.normalizeSize(shape, item, req.size, Config.MaxBlockSize)
	return {
		mat = mat, shape = shape, item = item,
		pos = pos, size = size, rot = rot, color = req.color,
	}, nil
end

local function pushUndo(plot: Plot, action: any)
	table.insert(plot.undo, action)
	if #plot.undo > Config.UndoDepth then
		table.remove(plot.undo, 1)
	end
end

local function cooldownOk(player: Player): boolean
	local now = os.clock()
	if now - (lastAction[player] or 0) < Config.PlaceCooldown then
		return false
	end
	lastAction[player] = now
	return true
end

function Building.count(plot: Plot): number
	return #plot.blocks:GetChildren()
end

function Building.place(player: Player, req: any): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, "У тебя нет участка"
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	if not cooldownOk(player) then
		return false, nil
	end
	local spec, err = validate(player, req)
	if not spec then
		return false, err
	end
	local e = Grid.extents(spec.size, spec.rot)
	if not Grid.isAligned(spec.pos, e) then
		return false, "Блок не попал в сетку"
	end
	if not Grid.inBounds(spec.pos, e) then
		return false, "Строить можно только внутри рамки участка"
	end
	if Building.count(plot) >= Config.MaxBlocks then
		return false, "Достигнут лимит: " .. Config.MaxBlocks .. " блоков"
	end
	if Building.overlaps(plot, spec) then
		return false, "Здесь уже есть блок"
	end
	local part = Building.create(plot, spec)
	pushUndo(plot, { type = "place", block = part })
	local profile = Data.get(player)
	if profile then
		profile.Stats.Blocks = (profile.Stats.Blocks or 0) + 1
	end
	return true, nil
end

local function ownBlock(player: Player, block: any): (Plot?, BasePart?)
	local plot = Plots.of(player)
	if not plot or typeof(block) ~= "Instance" or not block:IsA("BasePart") or block.Parent ~= plot.blocks then
		return nil, nil
	end
	return plot, block :: BasePart
end

function Building.delete(player: Player, block: any): (boolean, string?)
	local plot, part = ownBlock(player, block)
	if not plot or not part then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	if not cooldownOk(player) then
		return false, nil
	end
	pushUndo(plot, { type = "delete", spec = Building.specOf(part) })
	part:Destroy()
	return true, nil
end

function Building.paint(player: Player, block: any, color: any): (boolean, string?)
	local plot, part = ownBlock(player, block)
	if not plot or not part or typeof(color) ~= "Color3" then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	local old = part:GetAttribute("BaseColor") or part.Color
	if old == color then
		return true, nil
	end
	pushUndo(plot, { type = "paint", block = part, color = old })
	part.Color = color
	part:SetAttribute("BaseColor", color)
	local light = part:FindFirstChildOfClass("PointLight")
	if light and part:GetAttribute("Item") == Blocks.ItemByKey.Lamp.id then
		light.Color = color
	end
	return true, nil
end

function Building.serialize(plot: Plot): string
	local specs = {}
	for _, child in plot.blocks:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(specs, Building.specOf(child))
		end
	end
	return Serializer.encode(specs)
end

function Building.clear(plot: Plot)
	plot.blocks:ClearAllChildren()
end

-- Построить из строки (сохранение, снимок до осады). Неверные блоки пропускаются.
function Building.loadString(plot: Plot, str: string?): number
	local specs = Serializer.decode(str)
	local n = 0
	for _, spec in specs do
		if n >= Config.MaxBlocks then
			break
		end
		local okDef = (spec.item > 0 and Blocks.ItemById[spec.item]) or (spec.item == 0 and Blocks.MaterialById[spec.mat])
		if okDef and spec.rot >= 1 and spec.rot <= 24 then
			spec.shape = Blocks.ShapeById[spec.shape] and spec.shape or 1
			spec.size = Blocks.normalizeSize(spec.shape, spec.item, spec.size, Config.MaxBlockSize)
			local e = Grid.extents(spec.size, spec.rot)
			if Grid.inBounds(spec.pos, e) and Grid.isAligned(spec.pos, e) then
				Building.create(plot, spec)
				n += 1
			end
		end
	end
	return n
end

-- Заменить постройку целиком (снимок / слот). withUndo — можно будет отменить.
function Building.restore(plot: Plot, str: string?, withUndo: boolean?)
	if withUndo then
		pushUndo(plot, { type = "clear", data = Building.serialize(plot) })
	end
	Building.clear(plot)
	Building.loadString(plot, str)
end

function Building.undo(player: Player): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	local action = table.remove(plot.undo)
	if not action then
		return false, "Нечего отменять"
	end
	if action.type == "place" then
		if action.block and action.block.Parent == plot.blocks then
			action.block:Destroy()
		end
	elseif action.type == "delete" then
		if not Building.overlaps(plot, action.spec) and Building.count(plot) < Config.MaxBlocks then
			Building.create(plot, action.spec)
		end
	elseif action.type == "paint" then
		local b = action.block
		if b and b.Parent == plot.blocks then
			b.Color = action.color
			b:SetAttribute("BaseColor", action.color)
		end
	elseif action.type == "clear" then
		Building.clear(plot)
		Building.loadString(plot, action.data)
	end
	return true, nil
end

function Building.clearRequest(player: Player): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	if Building.count(plot) == 0 then
		return false, "Участок и так пустой"
	end
	pushUndo(plot, { type = "clear", data = Building.serialize(plot) })
	Building.clear(plot)
	return true, nil
end

function Building.saveSlot(player: Player, slot: any): (boolean, string?)
	local plot = Plots.of(player)
	slot = tonumber(slot)
	if not plot or not slot or slot < 1 or slot > Config.SaveSlots then
		return false, nil
	end
	slot = math.floor(slot)
	local str = Building.serialize(plot)
	Data.setSlot(player, slot, str)
	task.spawn(Data.save, player)
	Data.sync(player)
	local n = Building.count(plot)
	return true, string.format("Сохранено в слот %d: %d %s", slot, n, Util.plural(n, "блок", "блока", "блоков"))
end

function Building.loadSlot(player: Player, slot: any): (boolean, string?)
	local plot = Plots.of(player)
	slot = tonumber(slot)
	if not plot or not slot then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	local str = Data.getSlot(player, math.floor(slot))
	if not str or str == "" then
		return false, "Слот пустой"
	end
	Building.restore(plot, str, true)
	return true, "Постройка загружена (отменить — Ctrl+Z)"
end

-- Стартовый домик для нового игрока
function Building.starter(plot: Plot)
	Building.loadString(plot, Examples[1].data)
end

function Building.loadExample(player: Player, index: any): (boolean, string?)
	local plot = Plots.of(player)
	local ex = Examples[tonumber(index) or 0]
	if not plot or not ex then
		return false, nil
	end
	local can, why = Building.canEdit(plot)
	if not can then
		return false, why
	end
	Building.restore(plot, ex.data, true)
	return true, "Загружен пример: " .. ex.name .. " (отменить — Ctrl+Z)"
end

function Building.forget(player: Player)
	lastAction[player] = nil
end

return Building
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Damage</string>
          <string name="Source"><![CDATA[-- Урон: взрывы, пули, лазер. Прочность блоков, обломки, укрытия игроков.
--
-- Главная идея: стены защищают. Каждый блок между взрывом и игроком гасит часть урона —
-- тем больше, чем прочнее материал (поле blast/nuke) и чем толще блок.
local PhysicsService = game:GetService("PhysicsService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)
local BlockFactory = require(Shared.BlockFactory)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)
local Specials = require(script.Parent.Specials)

local Damage = {}

type Plot = Plots.Plot

export type ExplosionOpts = {
	radius: number,
	blockDamage: number,
	playerDamage: number,
	kind: string, -- "explosion" | "nuke"
	mul: number?,
}

local ITEM_TNT = Blocks.ItemByKey.TNT.id

local debrisFolder: Folder
local debrisCount = 0
local rng = Random.new()

local blockParams = RaycastParams.new()
blockParams.FilterType = Enum.RaycastFilterType.Include

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

function Damage.init()
	local existing = workspace:FindFirstChild("Debris")
	if existing then
		debrisFolder = existing :: Folder
	else
		local f = Instance.new("Folder")
		f.Name = "Debris"
		f.Parent = workspace
		debrisFolder = f
	end
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Debris")
		PhysicsService:RegisterCollisionGroup("Players")
	end)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Players", false)
end

function Damage.debrisFolder(): Folder
	return debrisFolder
end

function Damage.defOf(block: BasePart)
	local item = block:GetAttribute("Item") or 0
	if item > 0 then
		return Blocks.ItemById[item]
	end
	return Blocks.MaterialById[block:GetAttribute("Mat") or 1] or Blocks.MaterialById[1]
end

local function plotOf(block: Instance): Plot?
	local folder = block.Parent
	local model = folder and folder.Parent
	local idx = model and model:GetAttribute("PlotIndex")
	return idx and Plots.list[idx] or nil
end

-- Насколько блок «толстый» вдоль направления dir (стады)
local function thickness(block: BasePart, dir: Vector3): number
	local cf = block.CFrame
	local s = block.Size
	return math.clamp(
		math.abs(dir:Dot(cf.RightVector)) * s.X + math.abs(dir:Dot(cf.UpVector)) * s.Y + math.abs(dir:Dot(cf.LookVector)) * s.Z,
		0.5,
		24
	)
end

local function resistOf(def, kind: string): number
	if kind == "nuke" then
		return def.nuke or 0.3
	end
	return def.blast or 0.3
end

-- Какая доля урона дойдёт от точки from до точки to сквозь блоки участка (1 = вся, 0 = ничего)
function Damage.cover(plot: Plot, from: Vector3, to: Vector3, kind: string): number
	blockParams.FilterDescendantsInstances = { plot.blocks }
	local factor = 1
	local origin = from
	for _ = 1, 8 do
		local delta = to - origin
		local dist = delta.Magnitude
		if dist < 0.1 then
			break
		end
		local unit = delta / dist
		local result = workspace:Raycast(origin, delta, blockParams)
		if not result then
			break
		end
		local block = result.Instance
		if block:IsA("BasePart") and block.Name == "Block" then
			local def = Damage.defOf(block)
			local layer = (1 - resistOf(def, kind)) ^ (thickness(block, unit) / 2)
			factor *= layer
			if factor < 0.01 then
				return 0
			end
		end
		origin = result.Position + unit * 0.05
	end
	return factor
end

local function falloff(x: number, kind: string): number
	if x >= 1 then
		return 0
	end
	if kind == "nuke" then
		return 1 - 0.7 * x * x
	end
	return (1 - x) ^ 0.75
end

local function charColor(block: BasePart)
	local hp, maxHp = tonumber(block:GetAttribute("Hp")) or 1, tonumber(block:GetAttribute("MaxHp")) or 1
	local base = block:GetAttribute("BaseColor") or block.Color
	block.Color = base:Lerp(Config.CharredColor, math.clamp(1 - hp / maxHp, 0, 1) * 0.75)
end

local function makeDebris(block: BasePart, from: Vector3?, kind: string)
	debrisCount += 1
	for _, d in block:GetDescendants() do
		if d:IsA("ProximityPrompt") or d:IsA("Weld") and d.Name == "SeatWeld" then
			d:Destroy()
		end
	end
	local parts = BlockFactory.allParts(block)
	for _, p in parts do
		p.CanQuery = false
		p.CanTouch = false
		p.CollisionGroup = "Debris"
	end
	block.Parent = debrisFolder
	block.Anchored = false
	local dir = from and (block.Position - from) or Vector3.yAxis
	if dir.Magnitude < 0.05 then
		dir = Vector3.yAxis
	end
	dir = dir.Unit
	local speed = (kind == "nuke" and 230) or (kind == "bullet" and 10) or (kind == "laser" and 6) or 75
	speed *= rng:NextNumber(0.6, 1.2)
	block.AssemblyLinearVelocity = dir * speed + Vector3.new(0, speed * 0.35, 0)
	block.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
	task.delay(Config.DebrisLifetime - 1.2, function()
		for _, p in parts do
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(1.1), { Transparency = 1 }):Play()
			end
		end
	end)
	task.delay(Config.DebrisLifetime, function()
		debrisCount -= 1
		block:Destroy()
	end)
end

-- Блок разрушен
function Damage.destroyBlock(block: BasePart, from: Vector3?, kind: string)
	local plot = plotOf(block)
	local pos = block.Position
	local isTnt = block:GetAttribute("Item") == ITEM_TNT
	if plot and plot.siege then
		plot.siege.blocksLost += 1
	end
	if debrisCount < Config.DebrisLimit then
		makeDebris(block, from, kind)
	else
		block:Destroy()
	end
	if isTnt and plot then
		task.delay(0.12, function()
			Net.event("Detonate"):FireAllClients({ w = "TNT", p = pos })
			Damage.explode(plot, pos, { radius = 12, blockDamage = 600, playerDamage = 70, kind = "explosion" })
		end)
	end
end

-- Нанести урон блоку. Возвращает true, если блок разрушен.
function Damage.damageBlock(block: BasePart, amount: number, kind: string, from: Vector3?): boolean
	if not block.Parent or block.Name ~= "Block" then
		return false
	end
	local def = Damage.defOf(block)
	if kind == "bullet" then
		amount *= def.bulletMul or 1
	elseif kind == "laser" then
		amount *= def.laserMul or 1
	else
		amount *= def.explMul or 1
	end
	local hp = (tonumber(block:GetAttribute("Hp")) or 1) - amount
	if hp <= 0 then
		Damage.destroyBlock(block, from, kind)
		return true
	end
	block:SetAttribute("Hp", hp)
	charColor(block)
	return false
end

-- Персонаж по детали (если деталь — часть игрока)
function Damage.humanoidOf(inst: Instance): Humanoid?
	local model = inst:FindFirstAncestorOfClass("Model")
	while model do
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			return hum
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- Взрыв в точке pos
function Damage.explode(plot: Plot, pos: Vector3, o: ExplosionOpts)
	local R = o.radius
	local kind = o.kind
	local mul = o.mul or 1

	-- 1. Щиты принимают часть удара на себя
	local protecting = {}
	for _, s in Specials.activeShields(plot) do
		local d = (pos - s.center).Magnitude
		if d > s.radius - 0.5 and d < s.radius + R then
			local share = o.blockDamage * mul * 0.35 * (1 - math.clamp((d - s.radius) / R, 0, 1))
			if Specials.hitShield(s, share, pos) then
				table.insert(protecting, s)
			end
		end
	end
	local function shielded(p: Vector3): boolean
		for _, s in protecting do
			if (p - s.center).Magnitude <= s.radius then
				return true
			end
		end
		return false
	end

	-- 2. Игроки (считаем до разрушения стен — стены успевают закрыть)
	for _, c in Plots.charactersOnIsland(plot) do
		local d = (c.root.Position - pos).Magnitude
		if d < R then
			local head = c.char:FindFirstChild("Head") :: BasePart?
			local cover = Damage.cover(plot, pos, c.root.Position, kind)
			if head then
				cover = math.max(cover, Damage.cover(plot, pos, head.Position, kind))
			end
			local dmg = o.playerDamage * mul * falloff(d / R, kind) * cover
			if shielded(c.root.Position) then
				dmg *= 0.1
			end
			if dmg >= 0.5 then
				c.hum:TakeDamage(dmg)
			end
		end
	end

	-- 3. Блоки
	overlap.FilterDescendantsInstances = { plot.blocks }
	blockParams.FilterDescendantsInstances = { plot.blocks }
	local parts = workspace:GetPartBoundsInRadius(pos, R, overlap)
	local broken = {}
	for _, b in parts do
		if b.Name == "Block" and b.Parent == plot.blocks then
			local half = (b.Size.X + b.Size.Y + b.Size.Z) / 6
			local d = math.max(0, (b.Position - pos).Magnitude - half)
			local f = falloff(d / R, kind)
			if f > 0 then
				local occl = 1
				local toBlock = b.Position - pos
				if toBlock.Magnitude > half + 0.5 then
					local hit = workspace:Raycast(pos, toBlock, blockParams)
					if hit and hit.Instance ~= b and hit.Instance.Name == "Block" then
						occl = 1 - resistOf(Damage.defOf(hit.Instance :: BasePart), kind) * 0.9
					end
				end
				local dmg = o.blockDamage * mul * f * occl
				if shielded(b.Position) then
					dmg *= 0.1
				end
				local bp, bc = b.Position, b.Color
				if Damage.damageBlock(b, dmg, kind, pos) and #broken < 24 then
					table.insert(broken, { bp, bc })
				end
			end
		end
	end
	if #broken > 0 then
		Net.event("BlocksBroken"):FireAllClients(broken, kind)
	end
end

-- Попадание пули
function Damage.bullet(plot: Plot, inst: Instance, pos: Vector3, blockDamage: number, playerDamage: number)
	local hum = Damage.humanoidOf(inst)
	if hum then
		local root = hum.RootPart
		if root and Plots.isOnIsland(plot, root.Position) then
			hum:TakeDamage(playerDamage)
		end
		return
	end
	if inst:IsA("BasePart") and inst.Name == "Block" and inst.Parent == plot.blocks then
		Damage.damageBlock(inst, blockDamage, "bullet", pos)
	end
end

local laserParams = RaycastParams.new()
laserParams.FilterType = Enum.RaycastFilterType.Exclude

function Damage.setExclude(list: { Instance })
	laserParams.FilterDescendantsInstances = list
end

-- Один «тик» орбитального лазера в точке (x, z). Возвращает высоту, где луч упёрся.
function Damage.laserTick(plot: Plot, x: number, z: number, beamRadius: number, blockDps: number, playerDps: number, dt: number, mul: number): number
	local topY = plot.cf.Position.Y + Config.PlotSize.Y + 200
	local result = workspace:Raycast(Vector3.new(x, topY, z), Vector3.new(0, -topY - 60, 0), laserParams)
	local hitY = result and result.Position.Y or 0
	-- купол щита
	for _, s in Specials.activeShields(plot) do
		local dx, dz = x - s.center.X, z - s.center.Z
		local h2 = dx * dx + dz * dz
		if h2 < s.radius * s.radius then
			local domeY = s.center.Y + math.sqrt(s.radius * s.radius - h2)
			if domeY > hitY then
				Specials.hitShield(s, blockDps * dt * 0.5 * mul, Vector3.new(x, domeY, z))
				if s.active then
					return domeY
				end
			end
		end
	end
	if result then
		local hum = Damage.humanoidOf(result.Instance)
		if hum then
			hum:TakeDamage(playerDps * dt * mul)
		end
		local hitPos = result.Position
		overlap.FilterDescendantsInstances = { plot.blocks }
		local parts = workspace:GetPartBoundsInRadius(hitPos, beamRadius, overlap)
		for _, b in parts do
			if b.Name == "Block" and b.Parent == plot.blocks then
				local top = b.Position.Y + b.Size.Magnitude * 0.3
				if top >= hitY - 2.5 then
					local hd = Vector2.new(b.Position.X - x, b.Position.Z - z).Magnitude
					local f = 1 - math.clamp(hd / (beamRadius + 2), 0, 0.7)
					Damage.damageBlock(b, blockDps * dt * mul * f, "laser", hitPos + Vector3.new(0, 4, 0))
				end
			end
		end
	end
	-- игроки рядом с пятном луча (не под крышей)
	for _, c in Plots.charactersOnIsland(plot) do
		local p = c.root.Position
		local hd = Vector2.new(p.X - x, p.Z - z).Magnitude
		if hd < beamRadius * 0.9 and p.Y > hitY - 3.5 then
			c.hum:TakeDamage(playerDps * dt * mul * 0.6)
		end
	end
	return hitY
end

return Damage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[-- Профили игроков: золото, купленные блоки, рекорды, слоты сохранений.
-- Если DataStore недоступен (Studio без доступа к API), игра работает, но ничего не сохраняет.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Serializer = require(Shared.Serializer)

local Data = {}

export type Profile = {
	Gold: number,
	Unlocked: { [string]: boolean },
	BestWave: number,
	Slots: { [string]: string },
	SlotInfo: { [string]: { count: number, time: number } },
	Auto: string,
	Settings: { [string]: any },
	Stats: { [string]: number },
	LastDaily: number,
}

local profiles: { [Player]: Profile } = {}
local newPlayers: { [Player]: boolean } = {}
local canSave: { [Player]: boolean } = {}
local store: DataStore? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Data] DataStore недоступен:", result)
	end
end

local function defaultProfile(): Profile
	return {
		Gold = Config.StartGold,
		Unlocked = {},
		BestWave = 0,
		Slots = {},
		SlotInfo = {},
		Auto = "",
		Settings = table.clone(Config.DefaultSettings),
		Stats = { Sieges = 0, Waves = 0, Nukes = 0, Blocks = 0 },
		LastDaily = 0,
	}
end

-- Добавить в старый профиль поля, которых в нём ещё нет
local function reconcile(data: any): Profile
	local base = defaultProfile()
	if typeof(data) ~= "table" then
		return base
	end
	for k, v in base do
		if data[k] == nil or typeof(data[k]) ~= typeof(v) then
			data[k] = v
		end
	end
	for k, v in Config.DefaultSettings do
		if data.Settings[k] == nil then
			data.Settings[k] = v
		end
	end
	return data
end

local function updateLeaderstats(player: Player, p: Profile)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local gold = ls:FindFirstChild("Золото") :: IntValue?
		local best = ls:FindFirstChild("Рекорд") :: IntValue?
		if gold then
			gold.Value = p.Gold
		end
		if best then
			best.Value = p.BestWave
		end
	end
	player:SetAttribute("Gold", p.Gold)
	player:SetAttribute("BestWave", p.BestWave)
end

function Data.load(player: Player): Profile
	local key = "u" .. player.UserId
	local loaded: any = nil
	local ok = false
	if store then
		for attempt = 1, 3 do
			local success, result = pcall(function()
				return (store :: DataStore):GetAsync(key)
			end)
			if success then
				ok = true
				loaded = result
				break
			end
			warn("[Data] попытка " .. attempt .. ":", result)
			if string.find(tostring(result), "Studio", 1, true) then
				break
			end
			task.wait(1.5)
		end
	end
	local profile = reconcile(loaded)
	profiles[player] = profile
	newPlayers[player] = loaded == nil
	canSave[player] = ok

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local gold = Instance.new("IntValue")
	gold.Name = "Золото"
	gold.Parent = ls
	local best = Instance.new("IntValue")
	best.Name = "Рекорд"
	best.Parent = ls
	ls.Parent = player
	updateLeaderstats(player, profile)
	return profile
end

function Data.saveEnabled(player: Player): boolean
	return canSave[player] == true
end

function Data.save(player: Player): boolean
	local profile = profiles[player]
	if not (profile and canSave[player] and store) then
		return false
	end
	local key = "u" .. player.UserId
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key, function()
			return profile
		end)
	end)
	if not ok then
		warn("[Data] не удалось сохранить:", err)
	end
	return ok
end

function Data.get(player: Player): Profile?
	return profiles[player]
end

function Data.isNew(player: Player): boolean
	return newPlayers[player] == true
end

function Data.release(player: Player)
	newPlayers[player] = nil
	profiles[player] = nil
	canSave[player] = nil
end

-- Отправить клиенту всё, что ему нужно знать о профиле
function Data.sync(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	local slots = {}
	for i = 1, Config.SaveSlots do
		local info = p.SlotInfo[tostring(i)]
		slots[i] = info and { count = info.count, time = info.time } or false
	end
	Net.event("Data"):FireClient(player, {
		gold = p.Gold,
		unlocked = p.Unlocked,
		bestWave = p.BestWave,
		slots = slots,
		settings = p.Settings,
		stats = p.Stats,
		saveEnabled = canSave[player] == true,
	})
	updateLeaderstats(player, p)
end

function Data.addGold(player: Player, amount: number)
	local p = profiles[player]
	if not p then
		return
	end
	p.Gold = math.max(0, math.floor(p.Gold + amount))
	Data.sync(player)
end

function Data.isUnlocked(player: Player, key: string): boolean
	local p = profiles[player]
	return p ~= nil and p.Unlocked[key] == true
end

function Data.unlock(player: Player, key: string)
	local p = profiles[player]
	if p then
		p.Unlocked[key] = true
	end
end

function Data.setSlot(player: Player, slot: number, str: string)
	local p = profiles[player]
	if not p then
		return
	end
	p.Slots[tostring(slot)] = str
	p.SlotInfo[tostring(slot)] = { count = Serializer.count(str), time = os.time() }
end

function Data.getSlot(player: Player, slot: number): string?
	local p = profiles[player]
	return p and p.Slots[tostring(slot)]
end

-- Ежедневный бонус: раз в 20 часов
function Data.tryDaily(player: Player): number
	local p = profiles[player]
	if not p then
		return 0
	end
	local now = os.time()
	if now - p.LastDaily >= 20 * 3600 then
		p.LastDaily = now
		p.Gold += Config.DailyBonus
		return Config.DailyBonus
	end
	return 0
end

-- Сохранить всех (при выключении сервера). Ждёт до 25 секунд.
function Data.saveAll()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			Data.save(player)
			pending -= 1
		end)
	end
	local started = os.clock()
	while pending > 0 and os.clock() - started < 25 do
		task.wait(0.1)
	end
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Launch</string>
          <string name="Source"><![CDATA[-- Испытание постройки: блоки свариваются, становятся физическими,
-- колёса крутятся от кресла водителя, двигатели толкают, шары поднимают.
-- Так можно построить машину, танк, катер, самолёт или робота на колёсах.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)
local Building = require(script.Parent.Building)

local Launch = {}

type Plot = Plots.Plot

type Wheel = { part: BasePart, hinge: HingeConstraint }
type Run = {
	plot: Plot,
	player: Player,
	snapshot: string,
	wheels: { Wheel },
	thrusters: { { part: BasePart, force: VectorForce, flame: ParticleEmitter? } },
	conn: RBXScriptConnection?,
	dirSign: number,
	wrongTime: number,
	flipped: boolean,
}

local runs: { [number]: Run } = {}

local ITEM_WHEEL = Blocks.ItemByKey.Wheel.id
local ITEM_THRUSTER = Blocks.ItemByKey.Thruster.id
local ITEM_BALLOON = Blocks.ItemByKey.Balloon.id

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local function isItem(b: Instance, id: number): boolean
	return b:GetAttribute("Item") == id
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

function Launch.isRunning(plot: Plot): boolean
	return runs[plot.index] ~= nil
end

function Launch.snapshotOf(plot: Plot): string?
	local r = runs[plot.index]
	return r and r.snapshot or nil
end

local function drive(run: Run, dt: number)
	-- кресло водителя, в котором кто-то сидит
	local seat: VehicleSeat? = nil
	for _, b in run.plot.blocks:GetChildren() do
		if b:IsA("VehicleSeat") and b.Occupant then
			seat = b
			break
		end
	end
	local throttle, steer = 0, 0
	if seat then
		throttle, steer = seat.ThrottleFloat, seat.SteerFloat
	end
	local speed = Config.Launch.WheelSpeed
	for _, w in run.wheels do
		if w.part.Parent and seat then
			local right = seat.CFrame.RightVector
			local side = ((w.part.Position - seat.Position):Dot(right) >= 0) and 1 or -1
			local axisSign = (w.part.CFrame.RightVector:Dot(right) >= 0) and 1 or -1
			local d = math.clamp(throttle - steer * side, -1, 1)
			w.hinge.AngularVelocity = -speed * d * axisSign * run.dirSign
		else
			w.hinge.AngularVelocity = 0
		end
	end
	-- автоматическая проверка направления: если на «газ» едем назад — переворачиваем знак
	if seat and math.abs(throttle) > 0.5 and #run.wheels > 0 and not run.flipped then
		local v = seat.AssemblyLinearVelocity:Dot(seat.CFrame.LookVector) * throttle
		if v < -2 then
			run.wrongTime += dt
			if run.wrongTime > 0.6 then
				run.dirSign = -run.dirSign
				run.flipped = true
			end
		else
			run.wrongTime = 0
		end
	end
	local on = throttle > 0.1
	for _, t in run.thrusters do
		t.force.Enabled = on and t.part.Parent ~= nil
		if t.flame then
			t.flame.Enabled = on
		end
	end
end

function Launch.start(player: Player): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, "У тебя нет участка"
	end
	if plot.siege then
		return false, "Сначала закончи осаду"
	end
	if runs[plot.index] then
		return false, "Испытание уже идёт"
	end
	local list = plot.blocks:GetChildren()
	if #list == 0 then
		return false, "Сначала построй что-нибудь"
	end
	local run: Run = {
		plot = plot,
		player = player,
		snapshot = Building.serialize(plot),
		wheels = {},
		thrusters = {},
		conn = nil,
		dirSign = 1,
		wrongTime = 0,
		flipped = false,
	}
	runs[plot.index] = run
	plot.launched = true

	overlap.FilterDescendantsInstances = { plot.blocks }
	local pairsDone: { [string]: boolean } = {}
	local ids: { [Instance]: number } = {}
	for i, b in list do
		ids[b] = i
	end
	local function key(a: Instance, b: Instance): string
		local x, y = ids[a] or 0, ids[b] or 0
		return x < y and (x .. "|" .. y) or (y .. "|" .. x)
	end

	-- 1. Свариваем соприкасающиеся блоки (колёса — отдельно)
	for _, b in list do
		if b:IsA("BasePart") and not isItem(b, ITEM_WHEEL) then
			local near = workspace:GetPartBoundsInBox(b.CFrame, b.Size + Vector3.new(0.3, 0.3, 0.3), overlap)
			for _, n in near do
				if n ~= b and n.Name == "Block" and not isItem(n, ITEM_WHEEL) then
					local k = key(b, n)
					if not pairsDone[k] then
						pairsDone[k] = true
						weld(b, n)
					end
				end
			end
		end
	end

	-- 2. Колёса на шарнирах
	for _, b in list do
		if b:IsA("BasePart") and isItem(b, ITEM_WHEEL) then
			local attached = false
			for _, side in { 1, -1 } do
				local face = b.CFrame * CFrame.new(side * (b.Size.X / 2 + 0.3), 0, 0)
				local near = workspace:GetPartBoundsInBox(face, Vector3.new(0.5, b.Size.Y * 0.5, b.Size.Z * 0.5), overlap)
				for _, n in near do
					if n ~= b and n.Name == "Block" and not isItem(n, ITEM_WHEEL) then
						local pivot = b.CFrame * CFrame.new(side * b.Size.X / 2, 0, 0)
						local a0 = Instance.new("Attachment")
						a0.CFrame = n.CFrame:ToObjectSpace(pivot)
						a0.Parent = n
						local a1 = Instance.new("Attachment")
						a1.CFrame = CFrame.new(side * b.Size.X / 2, 0, 0)
						a1.Parent = b
						local hinge = Instance.new("HingeConstraint")
						hinge.Attachment0 = a0
						hinge.Attachment1 = a1
						hinge.ActuatorType = Enum.ActuatorType.Motor
						hinge.MotorMaxTorque = Config.Launch.WheelTorque
						hinge.MotorMaxAcceleration = 60
						hinge.AngularVelocity = 0
						hinge.Parent = b
						table.insert(run.wheels, { part = b, hinge = hinge })
						attached = true
						break
					end
				end
				if attached then
					break
				end
			end
			if not attached then
				-- колесо ни к чему не прикреплено сбоку — просто привариваем к соседу
				local near = workspace:GetPartBoundsInBox(b.CFrame, b.Size + Vector3.new(0.3, 0.3, 0.3), overlap)
				for _, n in near do
					if n ~= b and n.Name == "Block" then
						weld(b, n)
						break
					end
				end
			end
		end
	end

	-- 3. Двигатели и воздушные шары
	local g = workspace.Gravity
	for _, b in list do
		if b:IsA("BasePart") and isItem(b, ITEM_THRUSTER) then
			local att = Instance.new("Attachment")
			att.Name = "ThrustAttachment"
			att.Parent = b
			local f = Instance.new("VectorForce")
			f.Attachment0 = att
			f.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
			f.Force = Vector3.new(Config.Launch.ThrusterForce, 0, 0)
			f.ApplyAtCenterOfMass = true
			f.Enabled = false
			f.Parent = b
			local exhaust = b:FindFirstChild("Exhaust")
			local flame = exhaust and exhaust:FindFirstChild("Flame") :: ParticleEmitter?
			table.insert(run.thrusters, { part = b, force = f, flame = flame })
		elseif b:IsA("BasePart") and isItem(b, ITEM_BALLOON) then
			local att = Instance.new("Attachment")
			att.Parent = b
			local f = Instance.new("VectorForce")
			f.Attachment0 = att
			f.RelativeTo = Enum.ActuatorRelativeTo.World
			f.Force = Vector3.new(0, Config.Launch.BalloonLift * g, 0)
			f.ApplyAtCenterOfMass = true
			f.Parent = b
		end
	end

	-- 4. Отпускаем физику
	for _, b in list do
		if b:IsA("BasePart") then
			b.Anchored = false
		end
	end
	for _, b in list do
		if b:IsA("BasePart") and b.Parent and b:CanSetNetworkOwnership() then
			pcall(function()
				b:SetNetworkOwner(player)
			end)
		end
	end

	run.conn = RunService.Heartbeat:Connect(function(dt)
		drive(run, dt)
	end)
	Net.event("LaunchState"):FireClient(player, { active = true, wheels = #run.wheels, thrusters = #run.thrusters })
	return true, nil
end

function Launch.stop(player: Player, silent: boolean?): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, nil
	end
	local run = runs[plot.index]
	if not run then
		return false, nil
	end
	runs[plot.index] = nil
	if run.conn then
		run.conn:Disconnect()
	end
	-- выкинуть всех из кресел, чтобы персонажей не утянуло
	for _, b in plot.blocks:GetChildren() do
		if b:IsA("Seat") or b:IsA("VehicleSeat") then
			local occupant = (b :: any).Occupant :: Humanoid?
			if occupant then
				occupant.Sit = false
				occupant.Jump = true
			end
		end
	end
	plot.launched = false
	if not silent then
		Building.restore(plot, run.snapshot)
		Net.event("LaunchState"):FireClient(player, { active = false })
	end
	return true, nil
end

return Launch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[-- Лобби: таблица рекордов сервера.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Util = require(Shared.Util)

local Lobby = {}

local function rowsFrame(): Frame?
	local map = workspace:FindFirstChild("Map")
	local lobby = map and map:FindFirstChild("Lobby")
	local board = lobby and lobby:FindFirstChild("Leaderboard")
	local gui = board and board:FindFirstChild("SurfaceGui")
	return gui and gui:FindFirstChild("Rows") :: Frame?
end

function Lobby.refresh()
	local rows = rowsFrame()
	if not rows then
		return
	end
	local list = {}
	for _, p in Players:GetPlayers() do
		table.insert(list, { name = p.DisplayName, wave = p:GetAttribute("BestWave") or 0, gold = p:GetAttribute("Gold") or 0 })
	end
	table.sort(list, function(a, b)
		if a.wave ~= b.wave then
			return a.wave > b.wave
		end
		return a.gold > b.gold
	end)
	rows:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = rows
	if #list == 0 then
		return
	end
	for i = 1, math.min(8, #list) do
		local e = list[i]
		local row = Instance.new("TextLabel")
		row.Size = UDim2.fromScale(1, 0.11)
		row.BackgroundTransparency = i % 2 == 0 and 1 or 0.85
		row.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		row.BorderSizePixel = 0
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
		row.TextColor3 = i == 1 and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(230, 236, 250)
		row.Text = string.format("  %d. %s — волна %d • %s зол.", i, e.name, e.wave, Util.formatNumber(e.gold))
		row.LayoutOrder = i
		row.Parent = rows
	end
end

function Lobby.init()
	task.spawn(function()
		while true do
			Lobby.refresh()
			task.wait(8)
		end
	end)
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Plots</string>
          <string name="Source"><![CDATA[-- Участки для строительства: кто где строит, табличка с именем, место появления.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MapLayout = require(Shared.MapLayout)

local Plots = {}

export type Plot = {
	index: number,
	model: Model,
	cf: CFrame,
	color: Color3,
	colorName: string,
	blocks: Folder,
	effects: Folder,
	base: BasePart,
	spawn: SpawnLocation,
	sign: BasePart?,
	towers: { Vector3 },
	layout: any,
	owner: Player?,
	-- состояние режимов (заполняют Siege и Launch)
	siege: any,
	launched: boolean,
	undo: { any },
}

Plots.list = {} :: { Plot }
local byOwner: { [Player]: Plot } = {}

function Plots.init()
	local folder = workspace:WaitForChild("Plots")
	for _, entry in MapLayout.Plots do
		local model = folder:WaitForChild("Plot" .. entry.index) :: Model
		local colorInfo = Config.PlotColors[entry.index]
		local plot: Plot = {
			index = entry.index,
			model = model,
			cf = entry.cf,
			color = colorInfo.color,
			colorName = colorInfo.name,
			blocks = model:WaitForChild("Blocks") :: Folder,
			effects = model:WaitForChild("Effects") :: Folder,
			base = model:WaitForChild("Base") :: BasePart,
			spawn = model:WaitForChild("Spawn") :: SpawnLocation,
			sign = model:FindFirstChild("Sign") :: BasePart?,
			towers = entry.towers,
			layout = entry,
			owner = nil,
			siege = nil,
			launched = false,
			undo = {},
		}
		model:SetAttribute("PlotIndex", entry.index)
		model:SetAttribute("Owner", 0)
		Plots.list[entry.index] = plot
		Plots.setSign(plot, nil)
	end
end

function Plots.setSign(plot: Plot, owner: Player?)
	local sign = plot.sign
	if not sign then
		return
	end
	local gui = sign:FindFirstChild("SurfaceGui")
	local label = gui and gui:FindFirstChild("Owner") :: TextLabel?
	if label then
		label.Text = owner and owner.DisplayName or "Свободный участок"
	end
end

function Plots.assign(player: Player): Plot?
	if byOwner[player] then
		return byOwner[player]
	end
	for _, plot in Plots.list do
		if not plot.owner then
			plot.owner = player
			plot.undo = {}
			byOwner[player] = plot
			plot.model:SetAttribute("Owner", player.UserId)
			player:SetAttribute("Plot", plot.index)
			player.RespawnLocation = plot.spawn
			Plots.setSign(plot, player)
			return plot
		end
	end
	return nil
end

function Plots.release(player: Player)
	local plot = byOwner[player]
	if not plot then
		return
	end
	byOwner[player] = nil
	plot.owner = nil
	plot.undo = {}
	plot.model:SetAttribute("Owner", 0)
	Plots.setSign(plot, nil)
end

function Plots.of(player: Player): Plot?
	return byOwner[player]
end

-- Позиция внутри острова участка? (для урона и правил осады)
function Plots.isOnIsland(plot: Plot, pos: Vector3, radius: number?): boolean
	local l = plot.cf:PointToObjectSpace(pos)
	local r = radius or 82
	return l.X * l.X + l.Z * l.Z <= r * r and l.Y > -30 and l.Y < Config.PlotSize.Y + 60
end

-- Позиция внутри зоны строительства (с запасом margin)?
function Plots.isInBuildZone(plot: Plot, pos: Vector3, margin: number?): boolean
	local m = margin or 0
	local l = plot.cf:PointToObjectSpace(pos)
	local hx, hz = Config.PlotSize.X / 2 + m, Config.PlotSize.Z / 2 + m
	return math.abs(l.X) <= hx and math.abs(l.Z) <= hz and l.Y > -10 and l.Y < Config.PlotSize.Y + 40
end

function Plots.ownerCharacter(plot: Plot): (Model?, Humanoid?, BasePart?)
	local owner = plot.owner
	local char = owner and owner.Character
	if not char then
		return nil, nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hum and root and hum.Health > 0 then
		return char, hum, root
	end
	return nil, nil, nil
end

-- Все живые персонажи на острове участка
function Plots.charactersOnIsland(plot: Plot): { { char: Model, hum: Humanoid, root: BasePart, player: Player } }
	local out = {}
	for _, player in Players:GetPlayers() do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if char and hum and root and hum.Health > 0 and Plots.isOnIsland(plot, root.Position) then
			table.insert(out, { char = char, hum = hum, root = root, player = player })
		end
	end
	return out
end

return Plots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[-- Снаряды на сервере: полёт, наведение, попадания, перехват ПВО, щиты.
-- Сервер считает «честную» траекторию лучами, а клиенты рисуют красивую картинку сами
-- (получают старт снаряда и поправки для управляемых ракет).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Blocks = require(Shared.Blocks)
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)
local Specials = require(script.Parent.Specials)
local Damage = require(script.Parent.Damage)

local Projectiles = {}

type Plot = Plots.Plot

export type Proj = {
	id: number,
	w: any,
	plot: Plot,
	pos: Vector3,
	vel: Vector3,
	g: number,
	age: number,
	lifetime: number,
	target: Player?,
	targetPos: Vector3,
	mul: number,
	rolled: { [BasePart]: boolean },
	splitY: number?,
	burstY: number?,
	bomblet: boolean?,
	onDetonate: ((Vector3) -> ())?,
}

local active: { [number]: Proj } = {}
local count = 0
local nextId = 0
local syncTimer = 0
local rng = Random.new()

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.IgnoreWater = false

function Projectiles.setExclude(list: { Instance })
	params.FilterDescendantsInstances = list
end

function Projectiles.count(): number
	return count
end

local function remove(p: Proj)
	if active[p.id] then
		active[p.id] = nil
		count -= 1
	end
end

-- Создать снаряд. opts: target, targetPos, mul, lifetime, splitY, burstY, bomblet
function Projectiles.spawn(plot: Plot, w, pos: Vector3, vel: Vector3, opts: any): Proj?
	if count >= Config.Siege.MaxProjectiles then
		return nil
	end
	nextId += 1
	local p: Proj = {
		id = nextId,
		w = w,
		plot = plot,
		pos = pos,
		vel = vel,
		g = opts.g or w.gravity or 0,
		age = 0,
		lifetime = opts.lifetime or w.lifetime or 16,
		target = opts.target,
		targetPos = opts.targetPos or pos,
		mul = opts.mul or 1,
		rolled = {},
		splitY = opts.splitY,
		burstY = opts.burstY,
		bomblet = opts.bomblet,
		onDetonate = opts.onDetonate,
	}
	active[p.id] = p
	count += 1
	local target = p.target
	Net.event("ProjectileSpawn"):FireAllClients({
		id = p.id,
		w = w.key,
		p = pos,
		v = vel,
		g = p.g,
		t = workspace:GetServerTimeNow(),
		b = p.bomblet,
		tp = p.targetPos,
		u = target and target.UserId or nil,
	})
	return p
end

-- Повернуть вектор скорости к нужному направлению не больше чем на maxAngle радиан
local function turnToward(v: Vector3, desired: Vector3, maxAngle: number): Vector3
	if v.Magnitude < 1e-3 then
		return desired
	end
	local a, b = v.Unit, desired.Unit
	local ang = math.acos(math.clamp(a:Dot(b), -1, 1))
	if ang <= maxAngle or ang < 1e-4 then
		return desired
	end
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-5 then
		axis = Vector3.yAxis:Cross(a)
		if axis.Magnitude < 1e-5 then
			axis = Vector3.xAxis
		end
	end
	return CFrame.fromAxisAngle(axis.Unit, maxAngle):VectorToWorldSpace(a) * desired.Magnitude
end

-- Пересечение отрезка o + d*t (t от 0 до 1) со сферой
local function segmentSphere(o: Vector3, d: Vector3, c: Vector3, r: number): number?
	local m = o - c
	local a = d:Dot(d)
	local b = 2 * m:Dot(d)
	local cc = m:Dot(m) - r * r
	local disc = b * b - 4 * a * cc
	if disc < 0 or a < 1e-8 then
		return nil
	end
	local t = (-b - math.sqrt(disc)) / (2 * a)
	if t >= 0 and t <= 1 then
		return t
	end
	return nil
end

local function kindOf(w): string
	return w.key == "Nuke" and "nuke" or "explosion"
end

local function detonate(p: Proj, pos: Vector3, normal: Vector3?, info: any)
	remove(p)
	local w = p.w
	info = info or {}
	if w.radius > 0 then
		Net.event("Detonate"):FireAllClients({
			id = p.id, w = p.bomblet and "Bomblet" or w.key, p = pos, n = normal,
			water = info.water, aa = info.intercepted, air = info.air,
		})
		local mul = p.mul * (info.intercepted and 0.15 or 1)
		Damage.explode(p.plot, pos, {
			radius = w.radius * (info.intercepted and 0.6 or 1),
			blockDamage = w.blockDamage,
			playerDamage = w.playerDamage,
			kind = kindOf(w),
			mul = mul,
		})
		if p.onDetonate then
			task.spawn(p.onDetonate, pos)
		end
	else
		Net.event("Impact"):FireAllClients({ id = p.id, p = pos, n = normal, water = info.water, shield = info.shield })
		if info.inst then
			Damage.bullet(p.plot, info.inst, pos, w.blockDamage * p.mul, w.playerDamage * p.mul)
		end
	end
end

local function fizzle(p: Proj)
	remove(p)
	Net.event("Detonate"):FireAllClients({ id = p.id, silent = true })
end

-- Кассетная бомба раскрывается
local function split(p: Proj, pos: Vector3)
	remove(p)
	Net.event("Detonate"):FireAllClients({ id = p.id, w = "ClusterOpen", p = pos })
	local w = p.w
	local g = p.g
	local vy = p.vel.Y
	local targetY = p.targetPos.Y
	local fall = math.max(0.5, (vy + math.sqrt(math.max(0, vy * vy + 2 * g * (pos.Y - targetY)))) / g)
	for i = 1, (w.bomblets or 10) do
		local a = (i / w.bomblets) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local r = rng:NextNumber(3, w.splitSpread or 20)
		local landing = p.targetPos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local flat = (landing - pos) * Vector3.new(1, 0, 1)
		local vel = Vector3.new(flat.X / fall, vy * rng:NextNumber(0.6, 1), flat.Z / fall)
		Projectiles.spawn(p.plot, w, pos, vel, { g = g, targetPos = landing, mul = p.mul, bomblet = true, lifetime = 8 })
	end
end

local function stepOne(p: Proj, dt: number)
	local w = p.w
	p.age += dt
	if p.age > p.lifetime or p.pos.Y < -60 then
		fizzle(p)
		return
	end
	local motion = w.motion
	if p.target and (motion == "Homing" or motion == "Cruise") then
		local char = p.target.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			p.targetPos = root.Position
		end
	end
	if motion == "Homing" then
		if p.age > 0.7 then
			p.vel = turnToward(p.vel, (p.targetPos - p.pos).Unit * w.speed, w.turnRate * dt)
		end
	elseif motion == "Cruise" then
		local flat = Vector3.new(p.targetPos.X - p.pos.X, 0, p.targetPos.Z - p.pos.Z)
		if flat.Magnitude > 70 then
			local cruiseY = p.targetPos.Y + (w.cruiseHeight or 18)
			local desired = flat.Unit * w.speed + Vector3.new(0, math.clamp((cruiseY - p.pos.Y) * 3, -80, 80), 0)
			p.vel = turnToward(p.vel, desired.Unit * w.speed, 2.2 * dt)
		else
			p.vel = turnToward(p.vel, (p.targetPos - p.pos).Unit * w.speed, 5 * dt)
		end
	elseif p.g > 0 then
		p.vel += Vector3.new(0, -p.g * dt, 0)
	end
	local newPos = p.pos + p.vel * dt

	if p.burstY and newPos.Y <= p.burstY then
		detonate(p, newPos, nil, { air = true })
		return
	end
	if p.splitY and newPos.Y <= p.splitY then
		split(p, newPos)
		return
	end

	local seg = newPos - p.pos
	-- щиты
	local hitT = 2
	local shield = nil
	for _, s in Specials.activeShields(p.plot) do
		if (p.pos - s.center).Magnitude > s.radius then
			local t = segmentSphere(p.pos, seg, s.center, s.radius)
			if t and t < hitT then
				hitT = t
				shield = s
			end
		end
	end
	local result = workspace:Raycast(p.pos, seg, params)
	if result then
		local t = (result.Position - p.pos).Magnitude / math.max(seg.Magnitude, 1e-4)
		if not shield or t < hitT then
			local water = result.Material == Enum.Material.Water
			detonate(p, result.Position, result.Normal, { inst = result.Instance, water = water })
			return
		end
	end
	if shield then
		local at = p.pos + seg * hitT
		local normal = (at - shield.center).Unit
		if w.radius > 0 then
			detonate(p, at + normal * 0.5, normal, { shield = true })
		else
			Specials.hitShield(shield, w.blockDamage * p.mul, at)
			detonate(p, at, normal, { shield = true })
		end
		return
	end

	-- турели ПВО
	if w.aa > 0 and not p.bomblet then
		for _, turret in Specials.aaTurrets(p.plot) do
			if not p.rolled[turret] and (turret.Position - newPos).Magnitude < Blocks.AARange and Specials.aaReady(turret) then
				p.rolled[turret] = true
				Specials.aaFired(turret)
				Net.event("AAShot"):FireAllClients({ from = turret.Position + Vector3.new(0, 2.5, 0), to = newPos })
				if rng:NextNumber() < w.aa then
					detonate(p, newPos, nil, { intercepted = true, air = true })
					return
				end
				break
			end
		end
	elseif w.aa > 0 and p.bomblet and rng:NextNumber() < 0.02 then
		-- кассетные бомбочки тоже иногда сбивают
		for _, turret in Specials.aaTurrets(p.plot) do
			if (turret.Position - newPos).Magnitude < Blocks.AARange and Specials.aaReady(turret) then
				Specials.aaFired(turret)
				Net.event("AAShot"):FireAllClients({ from = turret.Position + Vector3.new(0, 2.5, 0), to = newPos })
				detonate(p, newPos, nil, { intercepted = true, air = true })
				return
			end
		end
	end
	p.pos = newPos
end

function Projectiles.step(dt: number)
	-- копия списка: во время шага появляются новые снаряды (кассетные бомбы)
	local list = {}
	for _, p in active do
		table.insert(list, p)
	end
	for _, p in list do
		-- быстрые снаряды считаем короткими шагами, чтобы не пролетали сквозь тонкие стены
		local speed = p.vel.Magnitude
		local steps = math.clamp(math.ceil(speed * dt / 12), 1, 6)
		local sub = dt / steps
		for _ = 1, steps do
			if not active[p.id] then
				break
			end
			stepOne(p, sub)
		end
	end
	syncTimer += dt
	if syncTimer >= 0.12 then
		syncTimer = 0
		local batch = {}
		for _, p in active do
			local m = p.w.motion
			if m == "Homing" or m == "Cruise" then
				table.insert(batch, { p.id, p.pos, p.vel })
				if #batch >= 16 then
					Net.unreliable("ProjectileSync"):FireAllClients(batch)
					batch = {}
				end
			end
		end
		if #batch > 0 then
			Net.unreliable("ProjectileSync"):FireAllClients(batch)
		end
	end
end

-- Убрать все снаряды участка (конец осады)
function Projectiles.clearPlot(plot: Plot)
	for _, p in active do
		if p.plot == plot then
			fizzle(p)
		end
	end
end

Projectiles.Weapons = Weapons

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Магазин: покупка материалов и особых блоков за золото.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Util = require(Shared.Util)

local Data = require(script.Parent.Data)

local Shop = {}

function Shop.buy(player: Player, kind: any, id: any): (boolean, string?)
	id = tonumber(id)
	if not id or (kind ~= "mat" and kind ~= "item") then
		return false, nil
	end
	local def = (kind == "item") and Blocks.ItemById[id] or Blocks.MaterialById[id]
	if not def then
		return false, nil
	end
	local profile = Data.get(player)
	if not profile then
		return false, nil
	end
	local key = (kind == "item" and "i:" or "m:") .. def.key
	if def.price <= 0 or profile.Unlocked[key] then
		return false, "Уже есть"
	end
	if profile.Gold < def.price then
		return false, "Не хватает золота: нужно ещё " .. Util.formatNumber(def.price - profile.Gold)
	end
	profile.Gold -= def.price
	profile.Unlocked[key] = true
	Data.sync(player)
	task.spawn(Data.save, player)
	return true, "Куплено: " .. def.name
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Siege</string>
          <string name="Source"><![CDATA[-- Осада: режимы «Выживание» (волны, от пули до ядерки и лазера) и «Полигон» (стреляешь сам).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)
local Building = require(script.Parent.Building)
local Data = require(script.Parent.Data)
local Specials = require(script.Parent.Specials)
local Projectiles = require(script.Parent.Projectiles)
local Attacks = require(script.Parent.Attacks)

local Siege = {}

type Plot = Plots.Plot

export type State = {
	mode: string,
	plot: Plot,
	player: Player,
	difficulty: number,
	diff: any,
	ctx: Attacks.Ctx,
	snapshot: string,
	wave: number,
	cleared: number,
	gold: number,
	blocksLost: number,
	startTime: number,
	ended: boolean,
	newRecord: boolean,
	diedConn: RBXScriptConnection?,
	lastShot: number,
	heavyReady: number,
}

local rng = Random.new()

local function send(state: State, payload: { [string]: any })
	payload.active = not state.ended
	payload.mode = state.mode
	payload.difficulty = state.difficulty
	payload.plot = state.plot.index
	Net.event("SiegeState"):FireClient(state.player, payload)
end

local function pickWeapon(wave: number): string
	local total = 0
	local pool = {}
	for _, w in Weapons.List do
		if w.weight > 0 and w.wave <= wave then
			local weight = w.weight * ((w.wave >= wave - 1) and 1.6 or 1)
			total += weight
			table.insert(pool, { w.key, weight })
		end
	end
	local r = rng:NextNumber() * total
	for _, e in pool do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return "Bullet"
end

-- Главное оружие волны: на волнах 1–12 — новое оружие, дальше — тяжёлая артиллерия
local function headlineFor(wave: number): string
	if wave <= #Weapons.List then
		return Weapons.List[wave].key
	end
	if wave % 4 == 0 then
		return "Nuke"
	elseif wave % 3 == 0 then
		return "Laser"
	elseif wave % 2 == 0 then
		return "Ballistic"
	end
	return "Cruise"
end

function Siege.finish(plot: Plot, reason: string)
	local state: State? = plot.siege
	if not state or state.ended then
		return
	end
	state.ended = true
	state.ctx.ended = true
	if state.diedConn then
		state.diedConn:Disconnect()
	end
	Projectiles.clearPlot(plot)
	Specials.stopShields(plot)
	local player = state.player
	if state.mode == "survival" and reason ~= "left" then
		local profile = Data.get(player)
		if profile then
			profile.Stats.Sieges = (profile.Stats.Sieges or 0) + 1
		end
		Net.event("SiegeResult"):FireClient(player, {
			waves = state.cleared,
			gold = state.gold,
			blocksLost = state.blocksLost,
			time = os.clock() - state.startTime,
			best = profile and profile.BestWave or 0,
			record = state.newRecord,
			reason = reason,
			difficulty = state.difficulty,
		})
		task.spawn(Data.save, player)
	end
	if reason ~= "left" then
		send(state, { phase = "ended" })
	end
	plot.model:SetAttribute("Siege", nil)
	local snapshot = state.snapshot
	task.delay((reason == "left") and 0 or 3, function()
		if plot.siege == state then
			plot.siege = nil
		end
		if reason ~= "left" and plot.owner == player then
			Building.restore(plot, snapshot)
			Building.notify(player, "Постройка восстановлена", "info")
		end
	end)
end

local function runSurvival(state: State)
	local ctx = state.ctx
	local plot = state.plot
	for i = Config.Siege.CountdownTime, 1, -1 do
		if state.ended then
			return
		end
		send(state, { phase = "countdown", n = i })
		task.wait(1)
	end
	local outside = 0
	while not state.ended do
		state.wave += 1
		local wave = state.wave
		local headline = headlineFor(wave)
		local duration = 18 + math.min(wave, 15) * 1.4
		if headline == "Nuke" then
			duration = math.max(duration, 20)
		elseif headline == "Laser" then
			duration = math.max(duration, 16)
		end
		ctx.mul = state.diff.damage * (1 + math.max(0, wave - #Weapons.List) * 0.06)
		send(state, {
			phase = "wave", wave = wave, duration = duration, headline = headline,
			newWeapon = (wave <= #Weapons.List) and Weapons.List[wave].key or nil,
		})
		Attacks.fire(ctx, headline)
		local waveEnd = os.clock() + duration
		local interval = math.max(0.75, 3.1 - wave * 0.13) / state.diff.rate
		local nextAttack = os.clock() + 1.5
		local heavy = Weapons.ByKey[headline].heavy
		while os.clock() < waveEnd and not state.ended do
			if os.clock() >= nextAttack then
				Attacks.fire(ctx, pickWeapon(wave))
				nextAttack = os.clock() + interval * rng:NextNumber(0.7, 1.3) * (heavy and 1.5 or 1)
			end
			-- игрок убежал с острова?
			local _, _, root = Plots.ownerCharacter(plot)
			if root and not Plots.isOnIsland(plot, root.Position, 92) then
				outside += 0.1
				if outside >= Config.Siege.LeavePlotGrace then
					Siege.finish(plot, "fled")
					return
				end
				if math.abs(outside - 0.1) < 0.01 then
					Building.notify(state.player, "Вернись на свой остров, иначе осада закончится!", "warning")
				end
			else
				outside = 0
			end
			task.wait(0.1)
		end
		if state.ended then
			return
		end
		-- волна пережита
		state.cleared = wave
		local reward = math.floor(Config.GoldPerWave * wave * state.diff.gold + 0.5)
		state.gold += reward
		Data.addGold(state.player, reward)
		local profile = Data.get(state.player)
		if profile then
			profile.Stats.Waves = (profile.Stats.Waves or 0) + 1
			if wave > profile.BestWave then
				profile.BestWave = wave
				state.newRecord = true
				Data.sync(state.player)
			end
		end
		send(state, { phase = "cleared", wave = wave, reward = reward })
		task.wait(Config.Siege.BreakBetweenWaves)
	end
end

function Siege.start(player: Player, mode: any, difficulty: any): (boolean, string?)
	local plot = Plots.of(player)
	if not plot then
		return false, "У тебя нет участка"
	end
	if plot.siege then
		return false, "Осада уже идёт"
	end
	if plot.launched then
		return false, "Сначала останови испытание"
	end
	if mode ~= "survival" and mode ~= "range" then
		return false, nil
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (char and hum and root and hum.Health > 0) then
		return false, "Подожди, пока персонаж появится"
	end
	if not Plots.isOnIsland(plot, root.Position, 90) then
		char:PivotTo(plot.spawn.CFrame + Vector3.new(0, 4, 0))
	end
	local di = math.clamp(math.floor(tonumber(difficulty) or 2), 1, #Config.Difficulties)
	if mode == "range" then
		di = 2
	end
	local diff = Config.Difficulties[di]
	local state: State = {
		mode = mode,
		plot = plot,
		player = player,
		difficulty = di,
		diff = diff,
		ctx = { plot = plot, player = player, mul = diff.damage, ended = false, nukes = 0 },
		snapshot = Building.serialize(plot),
		wave = 0,
		cleared = 0,
		gold = 0,
		blocksLost = 0,
		startTime = os.clock(),
		ended = false,
		newRecord = false,
		diedConn = nil,
		lastShot = 0,
		heavyReady = 0,
	}
	plot.siege = state
	plot.model:SetAttribute("Siege", mode)
	Specials.startShields(plot)
	if mode == "survival" then
		state.diedConn = hum.Died:Connect(function()
			Siege.finish(plot, "died")
		end)
		task.spawn(runSurvival, state)
	else
		send(state, { phase = "range" })
	end
	return true, nil
end

function Siege.stop(player: Player): (boolean, string?)
	local plot = Plots.of(player)
	if not plot or not plot.siege then
		return false, nil
	end
	Siege.finish(plot, "stop")
	return true, nil
end

-- Полигон: выстрел выбранным оружием (aim — точка на участке или nil = по игроку)
function Siege.fireRange(player: Player, key: any, aim: any): (boolean, string?)
	local plot = Plots.of(player)
	local state: State? = plot and plot.siege
	if not plot or not state or state.mode ~= "range" or state.ended then
		return false, "Сначала включи полигон"
	end
	local w = typeof(key) == "string" and Weapons.ByKey[key]
	if not w then
		return false, nil
	end
	local now = os.clock()
	if now - state.lastShot < Config.Siege.RangeCooldown then
		return false, nil
	end
	if w.heavy and now < state.heavyReady then
		return false, string.format("Перезарядка тяжёлого оружия: %.0f с", state.heavyReady - now)
	end
	if typeof(aim) ~= "Vector3" or not Plots.isOnIsland(plot, aim, 90) then
		aim = nil
	end
	state.lastShot = now
	if w.heavy then
		state.heavyReady = now + Config.Siege.RangeHeavyCooldown
	end
	Attacks.fire(state.ctx, w.key, aim)
	return true, nil
end

-- Полигон: вернуть постройку как была до начала
function Siege.restore(player: Player): (boolean, string?)
	local plot = Plots.of(player)
	local state: State? = plot and plot.siege
	if not plot or not state or state.mode ~= "range" or state.ended then
		return false, nil
	end
	Projectiles.clearPlot(plot)
	Building.restore(plot, state.snapshot)
	Specials.startShields(plot)
	return true, "Постройка восстановлена"
end

-- Что сохранить, если игрок выходит посреди осады (не руины, а целую постройку)
function Siege.snapshotOf(plot: Plot): string?
	local state: State? = plot.siege
	return state and state.snapshot or nil
end

return Siege
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Specials</string>
          <string name="Source"><![CDATA[-- Особые блоки: двери, аптечки, энергокристаллы, генераторы щита и турели ПВО.
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Blocks = require(Shared.Blocks)
local Net = require(Shared.Net)

local Plots = require(script.Parent.Plots)

local Specials = {}

type Plot = Plots.Plot

export type Shield = {
	block: BasePart,
	center: Vector3,
	radius: number,
	hp: number,
	maxHp: number,
	active: boolean,
	downUntil: number,
	dome: BasePart?,
	plot: Plot,
}

local shields: { [number]: { Shield } } = {}
local aaReady: { [BasePart]: number } = {}

local ITEM_DOOR = Blocks.ItemByKey.Door.id
local ITEM_MEDKIT = Blocks.ItemByKey.Medkit.id
local ITEM_SHIELD = Blocks.ItemByKey.Shield.id
local ITEM_AA = Blocks.ItemByKey.AATurret.id
local MAT_CRYSTAL = Blocks.MaterialByKey.Crystal.id

-- ДВЕРИ ---------------------------------------------------------------------------
local function toggleDoor(door: BasePart)
	local open = not door:GetAttribute("Open")
	door:SetAttribute("Open", open)
	door.CanCollide = not open
	door.Transparency = open and 0.75 or 0
	local prompt = door:FindFirstChild("DoorPrompt") :: ProximityPrompt?
	if prompt then
		prompt.ActionText = open and "Закрыть" or "Открыть"
	end
end

-- ЩИТЫ ----------------------------------------------------------------------------
local function makeDome(s: Shield): BasePart
	local dome = Instance.new("Part")
	dome.Name = "ShieldDome"
	dome.Shape = Enum.PartType.Ball
	dome.Size = Vector3.one * s.radius * 2
	dome.CFrame = CFrame.new(s.center)
	dome.Anchored = true
	dome.CanCollide = false
	dome.CanQuery = false
	dome.CanTouch = false
	dome.CastShadow = false
	dome.Material = Enum.Material.ForceField
	dome.Color = Color3.fromRGB(80, 190, 255)
	dome.Transparency = 0
	dome.Parent = s.plot.effects
	return dome
end

-- Включить щиты на время осады
function Specials.startShields(plot: Plot)
	Specials.stopShields(plot)
	local list = {}
	for _, b in plot.blocks:GetChildren() do
		if b:IsA("BasePart") and b:GetAttribute("Item") == ITEM_SHIELD then
			local s: Shield = {
				block = b,
				center = b.Position,
				radius = Blocks.ShieldRadius,
				hp = Blocks.ShieldHp,
				maxHp = Blocks.ShieldHp,
				active = true,
				downUntil = 0,
				dome = nil,
				plot = plot,
			}
			s.dome = makeDome(s)
			table.insert(list, s)
		end
	end
	shields[plot.index] = list
end

function Specials.stopShields(plot: Plot)
	local list = shields[plot.index]
	if list then
		for _, s in list do
			if s.dome then
				s.dome:Destroy()
			end
		end
	end
	shields[plot.index] = nil
end

function Specials.activeShields(plot: Plot): { Shield }
	local out = {}
	local list = shields[plot.index]
	if list then
		for _, s in list do
			if s.active and s.block.Parent == plot.blocks then
				table.insert(out, s)
			end
		end
	end
	return out
end

local function setShieldActive(s: Shield, active: boolean)
	s.active = active
	if s.dome then
		TweenService:Create(s.dome, TweenInfo.new(0.4), { Transparency = active and 0 or 1 }):Play()
	end
	Net.event("ShieldState"):FireAllClients({ p = s.center, r = s.radius, up = active })
end

-- Щит принял удар; возвращает true, если выдержал
function Specials.hitShield(s: Shield, amount: number, at: Vector3): boolean
	if not s.active then
		return false
	end
	s.hp -= amount
	Net.event("ShieldState"):FireAllClients({ p = s.center, r = s.radius, hit = at, hp = math.max(0, s.hp) / s.maxHp })
	if s.hp <= 0 then
		s.hp = 0
		s.downUntil = os.clock() + Blocks.ShieldRecharge
		setShieldActive(s, false)
		return false
	end
	return true
end

-- Какой активный щит накрывает точку?
function Specials.shieldCovering(plot: Plot, pos: Vector3): Shield?
	for _, s in Specials.activeShields(plot) do
		if (pos - s.center).Magnitude <= s.radius then
			return s
		end
	end
	return nil
end

-- ПВО -----------------------------------------------------------------------------
function Specials.aaTurrets(plot: Plot): { BasePart }
	local out = {}
	for _, b in plot.blocks:GetChildren() do
		if b:IsA("BasePart") and b:GetAttribute("Item") == ITEM_AA then
			table.insert(out, b)
		end
	end
	return out
end

function Specials.aaReady(turret: BasePart): boolean
	return os.clock() >= (aaReady[turret] or 0)
end

function Specials.aaFired(turret: BasePart)
	aaReady[turret] = os.clock() + Blocks.AACooldown
end

-- ЦИКЛЫ ---------------------------------------------------------------------------
function Specials.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, _player: Player)
		if prompt.Name == "DoorPrompt" then
			local door = prompt.Parent
			if door and door:IsA("BasePart") and door:GetAttribute("Item") == ITEM_DOOR then
				toggleDoor(door)
			end
		end
	end)

	-- аптечки: лечат каждые полсекунды
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, plot in Plots.list do
				local medkits = {}
				for _, b in plot.blocks:GetChildren() do
					if b:IsA("BasePart") and b:GetAttribute("Item") == ITEM_MEDKIT then
						table.insert(medkits, b)
					end
				end
				if #medkits > 0 then
					for _, c in Plots.charactersOnIsland(plot) do
						for _, m in medkits do
							if (c.root.Position - m.Position).Magnitude <= Blocks.MedkitRange then
								c.hum.Health = math.min(c.hum.MaxHealth, c.hum.Health + 3)
								break
							end
						end
					end
				end
			end
		end
	end)

	-- энергокристаллы восстанавливаются, щиты перезаряжаются
	task.spawn(function()
		local regen = Blocks.MaterialByKey.Crystal.regen
		while true do
			task.wait(1)
			for _, plot in Plots.list do
				if plot.siege then
					for _, b in plot.blocks:GetChildren() do
						if b:IsA("BasePart") and b:GetAttribute("Mat") == MAT_CRYSTAL and (b:GetAttribute("Item") or 0) == 0 then
							local hp, maxHp = b:GetAttribute("Hp") or 0, b:GetAttribute("MaxHp") or 1
							if hp < maxHp then
								hp = math.min(maxHp, hp + maxHp * regen)
								b:SetAttribute("Hp", hp)
								local base = b:GetAttribute("BaseColor") or b.Color
								b.Color = base:Lerp(Color3.fromRGB(28, 22, 18), (1 - hp / maxHp) * 0.7)
							end
						end
					end
				end
				local list = shields[plot.index]
				if list then
					for _, s in list do
						if s.block.Parent ~= plot.blocks then
							if s.dome then
								s.dome:Destroy()
								s.dome = nil
							end
							s.active = false
						elseif not s.active and s.downUntil > 0 and os.clock() >= s.downUntil then
							s.hp = s.maxHp
							s.downUntil = 0
							setShieldActive(s, true)
						end
					end
				end
			end
		end
	end)
end

return Specials
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">TerrainGen</string>
          <string name="Source"><![CDATA[-- Рельеф: море, острова, пляжи, горы на горизонте и облака.
-- Строится при запуске сервера, если в месте ещё нет рельефа.
-- Чтобы «запечь» рельеф в файл и видеть его в Studio без запуска, выполни в Command Bar:
--   require(game.ServerScriptService.Server.TerrainGen).build(true)
-- и сохрани место (Ctrl+S).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MapLayout = require(Shared.MapLayout)

local TerrainGen = {}

local MATERIAL_COLORS: { [Enum.Material]: Color3 } = {
	[Enum.Material.Grass] = Color3.fromRGB(86, 128, 58),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(78, 120, 52),
	[Enum.Material.Sand] = Color3.fromRGB(214, 196, 150),
	[Enum.Material.Ground] = Color3.fromRGB(110, 92, 70),
	[Enum.Material.Rock] = Color3.fromRGB(120, 118, 112),
	[Enum.Material.Snow] = Color3.fromRGB(236, 242, 250),
	[Enum.Material.Mud] = Color3.fromRGB(80, 64, 50),
}

local function hasTerrain(terrain: Terrain): boolean
	if terrain:GetAttribute("Generated") then
		return true
	end
	-- в центре карты под водой должен быть песок или вода
	local region = Region3.new(Vector3.new(-8, -8, -8), Vector3.new(8, 0, 8)):ExpandToGrid(4)
	local materials = terrain:ReadVoxels(region, 4)
	local size = materials.Size
	for x = 1, size.X do
		for y = 1, size.Y do
			for z = 1, size.Z do
				if materials[x][y][z] ~= Enum.Material.Air then
					return true
				end
			end
		end
	end
	return false
end

function TerrainGen.build(force: boolean?)
	local terrain = workspace.Terrain
	if not force and hasTerrain(terrain) then
		return
	end
	local started = os.clock()
	if force then
		terrain:Clear()
	end
	for material, color in MATERIAL_COLORS do
		terrain:SetMaterialColor(material, color)
	end
	for i, op in MapLayout.Terrain do
		local kind = op[1]
		if kind == "Cylinder" then
			terrain:FillCylinder(CFrame.new(op[2]), op[3], op[4], op[5])
		elseif kind == "Ball" then
			terrain:FillBall(op[2], op[3], op[4])
		elseif kind == "Block" then
			terrain:FillBlock(CFrame.new(op[2]), op[3], op[4])
		end
		if i % 20 == 0 then
			task.wait()
		end
	end
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.52
		clouds.Density = 0.62
		clouds.Parent = terrain
	end
	terrain:SetAttribute("Generated", true)
	print(string.format("[TerrainGen] рельеф построен за %.1f с", os.clock() - started))
end

return TerrainGen
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
