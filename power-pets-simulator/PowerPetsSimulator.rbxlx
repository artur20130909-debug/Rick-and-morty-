  </Item>
  <Item class="StarterPlayer" referent="33">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ClickController</string>
            <string name="Source"><![CDATA[--[[
	ClickController — клики и тапы.
	Сила начисляется за: большую кнопку «КЛИК!», клик мышью по миру (ПК), тап по экрану (телефон).
	Клиент сам не даёт отправить больше ~14 кликов в секунду, а сервер всё равно проверяет лимит.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Client = script.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)
local Popups = require(UI.Popups)
local Panels = require(UI.Panels)
local HatchAnimation = require(UI.HatchAnimation)

local ClickController = {}

local MIN_INTERVAL = 1 / math.max(1, GameConfig.MaxClicksPerSecond - 1)
local lastClick = 0
local lastFullWarning = 0
local hud = nil

function ClickController.Click(screenPosition)
	if not State.IsLoaded() or HatchAnimation.IsPlaying() then
		return
	end
	local now = os.clock()
	if now - lastClick < MIN_INTERVAL then
		return
	end
	lastClick = now

	local strength = State.Get("Strength", 0)
	local capacity = State.Get("Capacity", 50)
	if strength >= capacity then
		if now - lastFullWarning > 0.6 then
			lastFullWarning = now
			Popups.Show(screenPosition, "Рюкзак полон!", Kit.Colors.Red, 0.8)
			Sounds.Play("Error")
			if hud then
				hud.FlashFull()
			end
		end
		return
	end

	Remotes.Click:FireServer()
	Sounds.Play("Click", 0.92 + math.random() * 0.22)
	local power = math.min(State.Get("ClickPower", 1), capacity - strength)
	Popups.Show(screenPosition, "+" .. Format.Number(power), Kit.Colors.Yellow, 1)
	if hud then
		hud.Punch()
	end
end

function ClickController.Init(hudObject)
	hud = hudObject
	local button = hud.ClickButton

	button.Activated:Connect(function()
		local center = button.AbsolutePosition + button.AbsoluteSize / 2
		local spread = button.AbsoluteSize.X * 0.45
		local position = center + Vector2.new(math.random(-100, 100) / 100 * spread, -button.AbsoluteSize.Y * 0.62)
		ClickController.Click(position)
	end)

	-- ПК: клик мышью по миру (не по интерфейсу).
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Panels.AnyOpen() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			ClickController.Click(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	-- Телефон: короткий тап по экрану (не по кнопкам и не по джойстику).
	UserInputService.TouchTap:Connect(function(positions, processed)
		if processed or Panels.AnyOpen() then
			return
		end
		local position = positions[1]
		if position then
			ClickController.Click(Vector2.new(position.X, position.Y))
		end
	end)
end

return ClickController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="37">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Power Pets Simulator — главный клиентский скрипт.
	Собирает интерфейс кодом (никаких .rbxm), подключает клики, питомцев и эффекты.
	Клиент ничего не начисляет сам — только отправляет запросы серверу и показывает результат.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Client = script.Parent
local UI = Client:WaitForChild("UI")
ReplicatedStorage:WaitForChild("Shared")

local Sounds = require(Client:WaitForChild("Sounds"))
local State = require(Client:WaitForChild("State"))
local Kit = require(UI:WaitForChild("Kit"))
local Panels = require(UI:WaitForChild("Panels"))
local Hud = require(UI:WaitForChild("Hud"))
local Notifications = require(UI:WaitForChild("Notifications"))
local Popups = require(UI:WaitForChild("Popups"))
local PetsPanel = require(UI:WaitForChild("PetsPanel"))
local ShopPanel = require(UI:WaitForChild("ShopPanel"))
local RebirthPanel = require(UI:WaitForChild("RebirthPanel"))
local WorldsPanel = require(UI:WaitForChild("WorldsPanel"))
local HatchAnimation = require(UI:WaitForChild("HatchAnimation"))
local ClickController = require(Client:WaitForChild("ClickController"))
local PetFollow = require(Client:WaitForChild("PetFollow"))
local WorldEffects = require(Client:WaitForChild("WorldEffects"))
local ServerEvents = require(Client:WaitForChild("ServerEvents"))

-- ScreenGui лежат в StarterGui (src/gui). Если их нет — создаём сами.
local function getScreenGui(name, displayOrder, ignoreInset)
	local playerGui = player:WaitForChild("PlayerGui")
	local gui = playerGui:WaitForChild(name, 10)
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = name
		gui.ResetOnSpawn = false
		gui.ScreenInsets = ignoreInset and Enum.ScreenInsets.None or Enum.ScreenInsets.CoreUISafeInsets
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.DisplayOrder = displayOrder
		gui.Parent = playerGui
	end
	return gui
end

-- Стандартная панель предметов Roblox не нужна: у нас нет инструментов.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

State.Init()

local mainGui = getScreenGui("PowerPetsGui", 5, false)
local hatchGui = getScreenGui("HatchGui", 20, true)

local root = Kit.CreateScaledRoot(mainGui, "Root")
Popups.Init(mainGui)
Panels.Init(root)
local hud = Hud.Create(root)
Notifications.Init(root)

PetsPanel.Create()
ShopPanel.Create()
RebirthPanel.Create()
WorldsPanel.Create()

HatchAnimation.Init(hatchGui)
ClickController.Init(hud)
PetFollow.Init()
WorldEffects.Init(root)
ServerEvents.Init()

-- Предупреждение, если прогресс не сохраняется (Studio без доступа к API).
local saveWarningShown = false
State.Watch("SaveDisabled", function()
	if State.Get("SaveDisabled", false) == true and not saveWarningShown then
		saveWarningShown = true
		Notifications.Show("⚠️ Сохранение выключено: включи Studio Access to API Services", "warning")
	end
end)

-- Подсказка новичку.
State.Watch("DataLoaded", function()
	if State.IsLoaded() and State.Get("TotalStrength", 0) == 0 and State.Get("Rebirths", 0) == 0 then
		task.delay(2.5, function()
			Notifications.Show("Жми 💪 КЛИК, продавай силу в 💰 круге и открывай 🥚 яйца!", "info")
		end)
	end
end)

Sounds.Play("Button", 0.8)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source"><![CDATA[--[[
	PetFollow — питомцы летают за игроками.
	Сервер пишет надетых питомцев в атрибут игрока EquippedPets ("Kitten:0,Fox:1" — 1 = золотой),
	а каждый клиент сам рисует питомцев всех игроков. Так движение плавное и не грузит сервер.
	Все детали двигаются одним вызовом workspace:BulkMoveTo за кадр.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Pets = require(Shared.Config.Pets)
local PetBuilder = require(Shared.Modules.PetBuilder)

local PetFollow = {}

local DRAW_DISTANCE = 300
local folder = nil
local entries = {} -- [player] = { Key = "...", Pets = { { Model, Parts, Offsets, CFrame } } }

local function parse(text)
	local list = {}
	for item in string.gmatch(text or "", "[^,]+") do
		local petId, golden = string.match(item, "^([^:]+):?(%d?)$")
		if petId and Pets[petId] then
			table.insert(list, { Id = petId, Golden = golden == "1" })
		end
	end
	return list
end

local function clear(entry)
	for _, pet in ipairs(entry.Pets or {}) do
		pet.Model:Destroy()
	end
	entry.Pets = {}
end

local function rebuild(player)
	local entry = entries[player]
	if not entry then
		return
	end
	local key = player:GetAttribute("EquippedPets") or ""
	if entry.Key == key then
		return
	end
	-- Старые позиции сохраняем, чтобы новые питомцы не «прыгали» из центра мира.
	local previous = {}
	for index, pet in ipairs(entry.Pets or {}) do
		previous[index] = pet.CFrame
	end
	clear(entry)
	entry.Key = key
	for index, item in ipairs(parse(key)) do
		local model = PetBuilder.Build(item.Id, item.Golden)
		if model then
			local parts, offsets = PetBuilder.GetParts(model)
			table.insert(entry.Pets, {
				Model = model,
				Parts = parts,
				Offsets = offsets,
				CFrame = previous[index],
			})
		end
	end
end

local function track(player)
	if entries[player] then
		return
	end
	entries[player] = { Key = nil, Pets = {} }
	rebuild(player)
	player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function untrack(player)
	local entry = entries[player]
	if entry then
		clear(entry)
		entries[player] = nil
	end
end

local partBuffer = {}
local cframeBuffer = {}

local function step(deltaTime)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local t = os.clock()
	local alpha = 1 - math.exp(-9 * deltaTime)
	local count = 0

	for player, entry in pairs(entries) do
		local petCount = #entry.Pets
		if petCount > 0 then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local visible = root ~= nil and (root.Position - cameraPosition).Magnitude < DRAW_DISTANCE
			if visible then
				local look = root.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude < 0.01 then
					flat = Vector3.new(0, 0, -1)
				end
				local base = CFrame.lookAt(root.Position, root.Position + flat.Unit)
				local moving = root.AssemblyLinearVelocity.Magnitude > 2

				for index, pet in ipairs(entry.Pets) do
					if pet.Model.Parent ~= folder then
						pet.Model.Parent = folder
					end
					-- Дуга позади игрока: +Z в системе base — это «сзади».
					local offsetX = (index - (petCount + 1) / 2) * 3.6
					local offsetZ = 5 + math.abs(offsetX) * 0.35
					local bob = math.sin(t * 3 + index * 1.7) * 0.35
					if moving then
						bob += math.abs(math.sin(t * 9 + index)) * 0.7
					end
					local target = base * CFrame.new(offsetX, -0.6 + bob, offsetZ)
					if pet.CFrame then
						pet.CFrame = pet.CFrame:Lerp(target, alpha)
					else
						pet.CFrame = target
					end
					for partIndex, part in ipairs(pet.Parts) do
						count += 1
						partBuffer[count] = part
						cframeBuffer[count] = pet.CFrame * pet.Offsets[partIndex]
					end
				end
			else
				for _, pet in ipairs(entry.Pets) do
					if pet.Model.Parent then
						pet.Model.Parent = nil
					end
					pet.CFrame = nil
				end
			end
		end
	end

	-- Обрезаем буферы до текущего размера.
	for index = count + 1, #partBuffer do
		partBuffer[index] = nil
		cframeBuffer[index] = nil
	end
	if count > 0 then
		Workspace:BulkMoveTo(partBuffer, cframeBuffer, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function PetFollow.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPets"
	folder.Parent = Workspace

	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	RunService.RenderStepped:Connect(step)
end

return PetFollow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ServerEvents</string>
            <string name="Source"><![CDATA[--[[
	ServerEvents — реакции на сообщения сервера: уведомления, эффекты (монеты, продажа,
	перерождение, золотой питомец…) и запуск анимации яйца.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local Client = script.Parent
local Sounds = require(Client.Sounds)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)
local Popups = require(UI.Popups)
local Notifications = require(UI.Notifications)
local HatchAnimation = require(UI.HatchAnimation)
local PetsPanel = require(UI.PetsPanel)

local ServerEvents = {}

local EFFECTS = {}

function EFFECTS.Coin(payload)
	Sounds.Play("Coin", 0.9 + math.random() * 0.3)
	local text = "+" .. Format.Number(payload.Amount or 0) .. " 🪙"
	local camera = Workspace.CurrentCamera
	if camera and typeof(payload.Position) == "Vector3" then
		local screen, onScreen = camera:WorldToScreenPoint(payload.Position)
		if onScreen then
			Popups.Show(Vector2.new(screen.X, screen.Y), text, Kit.Colors.Yellow, 1.1)
			return
		end
	end
	Popups.Center(text, Kit.Colors.Yellow, 1.2)
end

function EFFECTS.Sell(payload)
	Sounds.Play("Sell")
	task.delay(0.12, Sounds.Play, "Coin", 1.2)
	Popups.Center("+" .. Format.Number(payload.Amount or 0) .. " 🪙", Kit.Colors.Yellow, 1.9)
end

function EFFECTS.Unlock(payload)
	local world = Worlds[payload.World]
	Sounds.Play("Unlock")
	if world then
		Notifications.Show("🌍 Открыт новый мир: " .. world.Icon .. " " .. world.Name .. "!", "success")
	end
end

function EFFECTS.Teleport()
	Sounds.Play("Teleport")
end

function EFFECTS.Rebirth(payload)
	Sounds.Play("Rebirth")
	Popups.Center("🔁 ПЕРЕРОЖДЕНИЕ #" .. tostring(payload.Rebirths or ""), Kit.Colors.Purple, 2.2)
end

function EFFECTS.Merge(payload)
	Sounds.Play("Merge")
	Popups.Center("✨ ЗОЛОТОЙ ПИТОМЕЦ!", Kit.Colors.Gold, 1.9)
	if payload.Uid then
		PetsPanel.Select(payload.Uid)
	end
end

function EFFECTS.Purchase()
	Sounds.Play("Unlock", 1.15)
end

function ServerEvents.Init()
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			Notifications.Show(text, kind)
		end
	end)

	Remotes.Effect.OnClientEvent:Connect(function(kind, payload)
		local handler = EFFECTS[kind]
		if handler then
			handler(type(payload) == "table" and payload or {})
		end
	end)

	Remotes.EggHatched.OnClientEvent:Connect(function(eggId, results)
		HatchAnimation.Play(eggId, results)
	end)
end

return ServerEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	Sounds — проигрывает звуки интерфейса. Список звуков — в Shared/Config/Sounds.
	Каждый звук клонируется, поэтому быстрые клики не обрывают друг друга.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Sounds"))

local Sounds = {}

local folder = Instance.new("Folder")
folder.Name = "PowerPetsSounds"
folder.Parent = SoundService

local templates = {}
for name, config in pairs(SoundConfig) do
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = config.Id
	sound.Volume = config.Volume or 0.5
	sound.PlaybackSpeed = config.Pitch or 1
	sound.Parent = folder
	templates[name] = sound
end

local lastPlayed = {}

-- pitch — дополнительный множитель высоты (для разнообразия кликов).
function Sounds.Play(name, pitch)
	local template = templates[name]
	if not template then
		return
	end
	-- Не больше ~25 одинаковых звуков в секунду.
	local now = os.clock()
	if lastPlayed[name] and now - lastPlayed[name] < 0.04 then
		return
	end
	lastPlayed[name] = now

	local sound = template:Clone()
	sound.PlaybackSpeed = template.PlaybackSpeed * (pitch or 1)
	sound.Parent = folder
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	Debris:AddItem(sound, 8)
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	State — то, что клиент знает о своём игроке.
	Числа (сила, монеты, множители…) сервер кладёт в атрибуты игрока — они приходят сами.
	Список питомцев приходит через RemoteEvent InventoryChanged.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("Remotes"))

local State = {}

local player = Players.LocalPlayer
State.Player = player
State.Inventory = {}

local inventoryListeners = {}

local function fireInventory()
	for _, callback in ipairs(inventoryListeners) do
		task.spawn(callback, State.Inventory)
	end
end

function State.Get(name, default)
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

-- Вызывает callback сразу и при каждом изменении любого из атрибутов.
function State.Watch(names, callback)
	if type(names) == "string" then
		names = { names }
	end
	for _, name in ipairs(names) do
		player:GetAttributeChangedSignal(name):Connect(callback)
	end
	task.spawn(callback)
end

function State.OnInventory(callback)
	table.insert(inventoryListeners, callback)
	task.spawn(callback, State.Inventory)
end

function State.IsLoaded()
	return player:GetAttribute("DataLoaded") == true
end

-- Открытые миры: { Forest = true, … }
function State.UnlockedWorlds()
	local result = {}
	local text = State.Get("UnlockedWorlds", "Forest")
	for worldId in string.gmatch(text, "[^,]+") do
		result[worldId] = true
	end
	return result
end

function State.EquippedCount()
	local count = 0
	for _, pet in ipairs(State.Inventory) do
		if pet.Equipped then
			count += 1
		end
	end
	return count
end

function State.FindPet(uid)
	for _, pet in ipairs(State.Inventory) do
		if pet.Uid == uid then
			return pet
		end
	end
	return nil
end

-- Безопасный вызов RemoteFunction: никогда не кидает ошибку, возвращает ok, сообщение.
function State.Invoke(remote, ...)
	local args = table.pack(...)
	local ok, result, message = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, "Нет связи с сервером"
	end
	return result, message
end

function State.Init()
	Remotes.InventoryChanged.OnClientEvent:Connect(function(list)
		if type(list) == "table" then
			State.Inventory = list
			fireInventory()
		end
	end)
	task.spawn(function()
		local ok, list = pcall(function()
			return Remotes.GetInventory:InvokeServer()
		end)
		if ok and type(list) == "table" and #State.Inventory == 0 then
			State.Inventory = list
			fireInventory()
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">HatchAnimation</string>
              <string name="Source"><![CDATA[--[[
	HatchAnimation — открытие яйца по центру экрана:
	яйцо выпрыгивает → трясётся всё сильнее → вспышка → лучи цвета редкости и 3D-питомец.
	Нажатие на экран ускоряет анимацию. Если яйца открываются быстрее, они встают в очередь.
]]

local Debris = game:GetService("Debris")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Eggs = require(Shared.Config.Eggs)
local Pets = require(Shared.Config.Pets)
local Rarities = require(Shared.Config.Rarities)
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local PetViewport = require(UI.PetViewport)
local Sounds = require(UI.Parent.Sounds)

local HatchAnimation = {}

local gui = nil
local root = nil
local queue = {}
local playing = false

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(100, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 110, 255)),
})

function HatchAnimation.Init(hatchGui)
	gui = hatchGui
	root = Kit.CreateScaledRoot(hatchGui, "Root")
	root.ZIndex = 5
end

local function makeEgg(parent, egg)
	local holder = Kit.new("Frame", {
		Name = "Egg",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(150, 190),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local scale = Kit.new("UIScale", { Scale = 0, Parent = holder })
	local shell = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
		Parent = holder,
	})
	Kit.Corner(shell, UDim.new(0.5, 0))
	Kit.Stroke(shell, 5)
	Kit.Gradient(shell, Kit.Lighten(egg.Color, 0.3), Kit.Darken(egg.Color, 0.15))

	local spots = {
		{ 0.3, 0.3, 0.24 },
		{ 0.68, 0.4, 0.18 },
		{ 0.42, 0.64, 0.22 },
		{ 0.7, 0.74, 0.14 },
		{ 0.24, 0.52, 0.12 },
	}
	for _, spot in ipairs(spots) do
		local dot = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(spot[1], spot[2]),
			Size = UDim2.fromScale(spot[3], spot[3] * 150 / 190),
			BackgroundColor3 = egg.SpotColor,
			ZIndex = 6,
			Parent = shell,
		})
		Kit.Corner(dot, UDim.new(0.5, 0))
	end
	local shine = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.32, 0.2),
		Size = UDim2.fromScale(0.2, 0.14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		Rotation = -30,
		ZIndex = 7,
		Parent = shell,
	})
	Kit.Corner(shine, UDim.new(0.5, 0))
	return holder, scale
end

local function reveal(slot)
	local result = slot.Result
	local config = Pets[result.Id]
	local rarity = Rarities[config.Rarity]

	-- Лучи.
	local rays = Kit.new("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = slot.Frame,
	})
	slot.Rays = {}
	for index = 1, 10 do
		local ray = Kit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(36, 440),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.35,
			Rotation = index * 18,
			ZIndex = 2,
			Parent = rays,
		})
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
		table.insert(slot.Rays, ray)
	end

	local glow = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(190, 190),
		BackgroundColor3 = rarity.Color,
		BackgroundTransparency = 0.45,
		ZIndex = 3,
		Parent = slot.Frame,
	})
	Kit.Corner(glow, UDim.new(0.5, 0))

	local view = PetViewport.new(slot.Frame, {
		Size = UDim2.fromOffset(230, 230),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 4,
	})
	view:SetPet(result.Id, false)
	slot.View = view
	local viewScale = Kit.new("UIScale", { Scale = 0.2, Parent = view.Frame })
	Kit.Tween(viewScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)

	local nameLabel = Kit.Text({
		Text = config.Icon .. " " .. config.Name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.76),
		Size = UDim2.fromOffset(300, 38),
		MaxTextSize = 34,
		StrokeThickness = 3,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	local rarityLabel = Kit.Text({
		Text = Format.Upper(rarity.Name),
		Color = rarity.Color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.86),
		Size = UDim2.fromOffset(300, 30),
		MaxTextSize = 28,
		StrokeThickness = 3,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	if config.Rarity == "Mythic" then
		rarityLabel.TextColor3 = Color3.new(1, 1, 1)
		slot.Rainbow = Kit.new("UIGradient", { Color = RAINBOW, Parent = rarityLabel })
	end
	Kit.Text({
		Text = Format.Multiplier(config.Multiplier) .. " к силе",
		Color = Kit.Colors.Yellow,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.95),
		Size = UDim2.fromOffset(300, 28),
		MaxTextSize = 26,
		ZIndex = 6,
		Parent = slot.Frame,
	})
	Kit.Pop(nameLabel, 1.4)
	Kit.Pop(rarityLabel, 1.6)
	return rarity.Order
end

local function play(eggId, results)
	local egg = Eggs[eggId]
	if not egg or type(results) ~= "table" or #results == 0 then
		return
	end
	ProximityPromptService.Enabled = false

	local skip = false
	local dim = Kit.new("Frame", {
		Name = "Dim",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = gui,
	})
	local skipButton = Kit.new("TextButton", {
		Name = "Skip",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = gui,
	})
	skipButton.Activated:Connect(function()
		skip = true
	end)
	Kit.Tween(dim, 0.25, { BackgroundTransparency = 0.35 })

	local count = #results
	local spacing = math.min(270, (root.AbsoluteSize.X / math.max(Kit.Scale, 0.01) - 40) / count)
	local slots = {}
	for index, result in ipairs(results) do
		local frame = Kit.new("Frame", {
			Name = "Slot" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (index - (count + 1) / 2) * spacing, 0.5, 0),
			Size = UDim2.fromOffset(260, 400),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = root,
		})
		local slotScale = Kit.new("UIScale", { Scale = count > 2 and 0.9 or 1, Parent = frame })
		local eggHolder, eggScale = makeEgg(frame, egg)
		slots[index] = { Frame = frame, Scale = slotScale, Egg = eggHolder, EggScale = eggScale, Result = result }
		Kit.Tween(eggScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	task.wait(0.4)

	-- Тряска.
	local shakeTime = 1.6
	local started = os.clock()
	local nextTick = 0
	while not skip do
		local elapsed = os.clock() - started
		if elapsed >= shakeTime then
			break
		end
		local progress = elapsed / shakeTime
		local angle = math.sin(elapsed * (14 + progress * 30)) * (5 + progress * 16)
		for _, slot in ipairs(slots) do
			slot.Egg.Rotation = angle
			slot.EggScale.Scale = 1 + progress * 0.18
		end
		if elapsed >= nextTick then
			Sounds.Play("EggShake", 1 + progress * 0.6)
			nextTick = elapsed + 0.36 - progress * 0.22
		end
		RunService.RenderStepped:Wait()
	end

	-- Вспышка.
	Sounds.Play("Hatch")
	local flash = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Parent = gui,
	})
	Kit.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)

	local best = 0
	for _, slot in ipairs(slots) do
		slot.Egg:Destroy()
		best = math.max(best, reveal(slot))
	end
	if best >= Rarities.Legendary.Order then
		Sounds.Play("Rare")
	elseif best >= Rarities.Epic.Order then
		Sounds.Play("Rare", 1.2)
	end

	-- Показываем результат (нажатие закрывает раньше).
	skip = false
	local shown = os.clock()
	local showTime = best >= Rarities.Legendary.Order and 3.4 or 2.6
	while true do
		local elapsed = os.clock() - shown
		if elapsed >= showTime or (skip and elapsed > 0.5) then
			break
		end
		skip = skip and elapsed > 0.5
		for _, slot in ipairs(slots) do
			for index, ray in ipairs(slot.Rays or {}) do
				ray.Rotation = index * 18 + elapsed * 25
			end
			if slot.Rainbow then
				slot.Rainbow.Offset = Vector2.new(math.sin(elapsed * 3) * 0.5, 0)
			end
		end
		RunService.RenderStepped:Wait()
	end

	-- Исчезновение.
	Kit.Tween(dim, 0.25, { BackgroundTransparency = 1 })
	for _, slot in ipairs(slots) do
		Kit.Tween(slot.Scale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	end
	task.wait(0.27)
	for _, slot in ipairs(slots) do
		if slot.View then
			slot.View:Destroy()
		end
		slot.Frame:Destroy()
	end
	dim:Destroy()
	skipButton:Destroy()
	ProximityPromptService.Enabled = true
end

function HatchAnimation.Play(eggId, results)
	table.insert(queue, { eggId, results })
	if playing then
		return
	end
	playing = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(play, item[1], item[2])
			if not ok then
				warn("[HatchAnimation]", err)
				-- Убираем остатки анимации, чтобы затемнение не зависло на экране.
				for _, child in ipairs(gui:GetChildren()) do
					if child ~= root then
						child:Destroy()
					end
				end
				for _, child in ipairs(root:GetChildren()) do
					if not child:IsA("UIScale") then
						child:Destroy()
					end
				end
				ProximityPromptService.Enabled = true
			end
		end
		playing = false
	end)
end

function HatchAnimation.IsPlaying()
	return playing
end

return HatchAnimation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud — постоянный интерфейс:
	- счётчики сверху: сила в рюкзаке (с полоской), монеты, накопленная сила, перерождения;
	- плашка текущего мира;
	- кнопки сбоку: Питомцы, Магазин, Перерождение, Миры;
	- большая кнопка «КЛИК!» внизу по центру (удобно большим пальцем на телефоне).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Backpacks = require(Shared.Config.Backpacks)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)

local UI = script.Parent
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local State = require(UI.Parent.State)

local Hud = {}

local function makePill(parent, order, width, icon, caption, color)
	local frame = Kit.new("Frame", {
		Name = caption,
		Size = UDim2.fromOffset(width, 58),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.Corner(frame, UDim.new(0.5, 0))
	Kit.Stroke(frame, 3)
	Kit.Gradient(frame, color, Kit.Darken(color, 0.25))

	local iconBg = Kit.new("Frame", {
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.new(0, 5, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		Parent = frame,
	})
	Kit.Corner(iconBg, UDim.new(0.5, 0))
	Kit.Text({
		Text = icon,
		Stroke = false,
		Size = UDim2.fromScale(0.78, 0.78),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = iconBg,
	})
	Kit.Text({
		Name = "Caption",
		Text = caption,
		Size = UDim2.new(1, -72, 0, 16),
		Position = UDim2.fromOffset(58, 4),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		StrokeThickness = 1.5,
		Parent = frame,
	})
	local value = Kit.Text({
		Name = "Value",
		Text = "0",
		Size = UDim2.new(1, -72, 0, 32),
		Position = UDim2.fromOffset(58, 20),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 28,
		StrokeThickness = 2.5,
		Parent = frame,
	})
	return frame, value
end

-- Прозрачная кнопка поверх элемента (например, нажать на счётчик и открыть окно).
local function makeClickable(guiObject, callback)
	local button = Kit.new("TextButton", {
		Name = "Hit",
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = guiObject,
	})
	button.Activated:Connect(callback)
	return button
end

function Hud.Create(root)
	local hud = { MenuButtons = {}, Badges = {} }

	------------------------------------------------------------------ СЧЁТЧИКИ
	local top = Kit.new("Frame", {
		Name = "TopBar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(860, 62),
		Parent = root,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = top,
	})

	local strengthPill, strengthValue = makePill(top, 1, 290, "💪", "СИЛА В РЮКЗАКЕ", Kit.Colors.Orange)
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -72, 0, 26),
		Position = UDim2.fromOffset(58, 24),
		Color = Kit.Colors.Green,
		ZIndex = 2,
		Parent = strengthPill,
	})
	strengthValue.Parent = bar
	strengthValue.Size = UDim2.new(1, -8, 1, 0)
	strengthValue.Position = UDim2.fromOffset(4, 0)
	strengthValue.TextXAlignment = Enum.TextXAlignment.Center
	strengthValue.ZIndex = 4
	makeClickable(strengthPill, function()
		Panels.Open("Shop")
	end)

	local _, coinsValue = makePill(top, 2, 190, "🪙", "МОНЕТЫ", Kit.Colors.Yellow)
	local _, totalValue = makePill(top, 3, 190, "⭐", "ВСЕГО СИЛЫ", Kit.Colors.Purple)
	local rebirthPill, rebirthValue = makePill(top, 4, 150, "🔁", "ПЕРЕРОЖД.", Kit.Colors.Blue)
	makeClickable(rebirthPill, function()
		Panels.Open("Rebirth")
	end)

	-- Плашка мира.
	local worldChip = Kit.new("Frame", {
		Name = "WorldChip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(330, 32),
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.35,
		Parent = root,
	})
	Kit.Corner(worldChip, UDim.new(0.5, 0))
	local worldLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(1, -16, 1, -6),
		Position = UDim2.fromOffset(8, 3),
		MaxTextSize = 22,
		Parent = worldChip,
	})
	makeClickable(worldChip, function()
		Panels.Open("Worlds")
	end)

	------------------------------------------------------------------ БОКОВОЕ МЕНЮ
	local side = Kit.new("Frame", {
		Name = "SideMenu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 24),
		Size = UDim2.fromOffset(96, 4 * 86 + 3 * 10),
		Parent = root,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = side,
	})
	local menu = {
		{ Name = "Pets", Icon = "🐾", Text = "Питомцы", Color = Kit.Colors.Green },
		{ Name = "Shop", Icon = "🛒", Text = "Магазин", Color = Kit.Colors.Yellow },
		{ Name = "Rebirth", Icon = "🔁", Text = "Перерождение", Color = Kit.Colors.Purple },
		{ Name = "Worlds", Icon = "🌍", Text = "Миры", Color = Kit.Colors.Blue },
	}
	for index, item in ipairs(menu) do
		local button = Kit.Button({
			Name = item.Name,
			Size = UDim2.fromOffset(96, 86),
			Color = item.Color,
			Corner = UDim.new(0, 22),
			LayoutOrder = index,
			Parent = side,
			OnClick = function()
				Panels.Toggle(item.Name)
			end,
		})
		Kit.Text({
			Text = item.Icon,
			Stroke = false,
			Size = UDim2.new(1, 0, 0.56, 0),
			Position = UDim2.fromScale(0, 0.06),
			ZIndex = 3,
			Parent = button,
		})
		Kit.Text({
			Text = item.Text,
			Size = UDim2.new(1, -8, 0.26, 0),
			Position = UDim2.new(0, 4, 0.66, 0),
			MaxTextSize = 17,
			ZIndex = 3,
			Parent = button,
		})
		-- Красный кружок «!» — когда есть что сделать.
		local badge = Kit.new("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = Kit.Colors.Red,
			Visible = false,
			ZIndex = 6,
			Parent = button,
		})
		Kit.Corner(badge, UDim.new(0.5, 0))
		Kit.Stroke(badge, 2)
		Kit.Text({ Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 7, Parent = badge })
		hud.MenuButtons[item.Name] = button
		hud.Badges[item.Name] = badge
	end

	------------------------------------------------------------------ КНОПКА КЛИКА
	local ring = Kit.new("Frame", {
		Name = "ClickRing",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -87),
		Size = UDim2.fromOffset(150, 150),
		BackgroundColor3 = Kit.Colors.Yellow,
		BackgroundTransparency = 0.4,
		ZIndex = 0,
		Parent = root,
	})
	Kit.Corner(ring, UDim.new(0.5, 0))
	Kit.new("UIScale", { Parent = ring })
	local ringTweenInfo = TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, -1)
	game:GetService("TweenService"):Create(ring, ringTweenInfo, { Size = UDim2.fromOffset(190, 190), BackgroundTransparency = 1 }):Play()

	local clickButton = Kit.Button({
		Name = "ClickButton",
		Size = UDim2.fromOffset(150, 150),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Color = Kit.Colors.Yellow,
		Color2 = Kit.Colors.Orange,
		Corner = UDim.new(0.5, 0),
		StrokeThickness = 5,
		Sound = false,
		Parent = root,
	})
	local clickIcon = Kit.Text({
		Text = "💪",
		Stroke = false,
		Size = UDim2.fromScale(0.56, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Parent = clickButton,
	})
	Kit.Text({
		Text = "КЛИК!",
		Size = UDim2.fromScale(0.72, 0.22),
		Position = UDim2.fromScale(0.5, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 32,
		StrokeThickness = 3,
		ZIndex = 3,
		Parent = clickButton,
	})

	local powerLabel = Kit.Text({
		Name = "PowerLabel",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.fromOffset(340, 28),
		MaxTextSize = 24,
		Parent = root,
	})

	local fullLabel = Kit.Text({
		Name = "FullWarning",
		Text = "🎒 Рюкзак полон! Беги на 💰 продажу",
		Color = Color3.fromRGB(255, 120, 120),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -200),
		Size = UDim2.fromOffset(520, 36),
		MaxTextSize = 30,
		StrokeThickness = 3,
		Visible = false,
		Parent = root,
	})

	------------------------------------------------------------------ ОБНОВЛЕНИЕ
	local lastCoins, lastTotal = nil, nil

	State.Watch({ "Strength", "Capacity" }, function()
		local strength, capacity = State.Get("Strength", 0), State.Get("Capacity", 50)
		strengthValue.Text = Format.Number(strength) .. " / " .. Format.Number(capacity)
		local fraction = capacity > 0 and strength / capacity or 0
		local color = Kit.Colors.Green
		if fraction >= 1 then
			color = Kit.Colors.Red
		elseif fraction >= 0.75 then
			color = Kit.Colors.Orange
		end
		setBar(fraction, color)
		fullLabel.Visible = fraction >= 1
	end)

	State.Watch("Coins", function()
		local coins = State.Get("Coins", 0)
		coinsValue.Text = Format.Number(coins)
		if lastCoins and coins > lastCoins then
			Kit.Pop(coinsValue, 1.25)
		end
		lastCoins = coins
	end)

	State.Watch("TotalStrength", function()
		local total = State.Get("TotalStrength", 0)
		totalValue.Text = Format.Number(total)
		if lastTotal and total > lastTotal then
			Kit.Pop(totalValue, 1.12)
		end
		lastTotal = total
	end)

	State.Watch("Rebirths", function()
		rebirthValue.Text = Format.Number(State.Get("Rebirths", 0))
	end)

	State.Watch({ "ClickPower" }, function()
		powerLabel.Text = "+" .. Format.Number(State.Get("ClickPower", 1)) .. " силы за клик"
	end)

	State.Watch("World", function()
		local world = Worlds[State.Get("World", "Forest")] or Worlds.Forest
		worldLabel.Text = string.format("%s %s  •  продажа ×%s", world.Icon, Format.Upper(world.Name), Format.Number(world.SellMultiplier))
		worldLabel.TextColor3 = Kit.Lighten(world.Color, 0.35)
	end)

	-- Значки «!» на кнопках.
	State.Watch({ "TotalStrength", "Rebirths" }, function()
		hud.Badges.Rebirth.Visible = State.Get("TotalStrength", 0) >= Formulas.RebirthCost(State.Get("Rebirths", 0))
	end)
	State.Watch({ "TotalStrength", "UnlockedWorlds" }, function()
		local unlocked = State.UnlockedWorlds()
		local canUnlock = false
		for _, worldId in ipairs(Worlds.Order) do
			if not unlocked[worldId] then
				canUnlock = State.Get("TotalStrength", 0) >= Worlds[worldId].UnlockStrength
				break
			end
		end
		hud.Badges.Worlds.Visible = canUnlock
	end)
	State.Watch({ "Coins", "BackpackLevel" }, function()
		local nextBackpack = Backpacks[State.Get("BackpackLevel", 1) + 1]
		hud.Badges.Shop.Visible = nextBackpack ~= nil and State.Get("Coins", 0) >= nextBackpack.Price
	end)

	------------------------------------------------------------------ API
	hud.ClickButton = clickButton

	function hud.Punch()
		Kit.Pop(clickIcon, 1.25)
	end

	function hud.FlashFull()
		fullLabel.Visible = true
		Kit.Pop(fullLabel, 1.2)
		Kit.Pop(bar, 1.12)
	end

	return hud
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Kit — мультяшный набор для интерфейса: цвета, шрифт, кнопки, надписи, масштабирование.

	Весь интерфейс рисуется в «дизайн-пикселях» на холсте 1000×560 и масштабируется под экран
	через UIScale, поэтому на телефоне кнопки остаются крупными, а на мониторе — не гигантскими.
]]

local TweenService = game:GetService("TweenService")

local Sounds = require(script.Parent.Parent:WaitForChild("Sounds"))

local Kit = {}

Kit.DesignSize = Vector2.new(1000, 560)
Kit.Scale = 1

Kit.Colors = {
	Ink = Color3.fromRGB(35, 30, 60),
	White = Color3.fromRGB(255, 255, 255),
	Panel = Color3.fromRGB(255, 249, 236),
	PanelDark = Color3.fromRGB(242, 230, 208),
	Green = Color3.fromRGB(96, 220, 96),
	GreenDark = Color3.fromRGB(40, 165, 60),
	Blue = Color3.fromRGB(70, 175, 255),
	BlueDark = Color3.fromRGB(30, 110, 225),
	Yellow = Color3.fromRGB(255, 218, 60),
	YellowDark = Color3.fromRGB(255, 158, 20),
	Orange = Color3.fromRGB(255, 160, 50),
	OrangeDark = Color3.fromRGB(235, 100, 20),
	Purple = Color3.fromRGB(176, 108, 255),
	PurpleDark = Color3.fromRGB(110, 50, 215),
	Red = Color3.fromRGB(255, 86, 86),
	RedDark = Color3.fromRGB(200, 40, 55),
	Pink = Color3.fromRGB(255, 110, 180),
	Grey = Color3.fromRGB(184, 188, 204),
	GreyDark = Color3.fromRGB(120, 124, 145),
	Gold = Color3.fromRGB(255, 205, 50),
}

local function makeFont(weight)
	local ok, font = pcall(function()
		return Font.new(Font.fromEnum(Enum.Font.Nunito).Family, weight)
	end)
	if ok then
		return font
	end
	return Font.fromEnum(Enum.Font.GothamBold)
end

Kit.Font = makeFont(Enum.FontWeight.Heavy)
Kit.FontBold = makeFont(Enum.FontWeight.Bold)

-- Создаёт объект: Kit.new("Frame", { Size = …, Parent = … }, { дети })
function Kit.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.Darken(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount or 0.2)
end

function Kit.Lighten(color, amount)
	return color:Lerp(Color3.new(1, 1, 1), amount or 0.2)
end

function Kit.Tween(instance, duration, props, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

function Kit.Corner(parent, radius)
	return Kit.new("UICorner", { CornerRadius = radius or UDim.new(0, 14), Parent = parent })
end

function Kit.Stroke(parent, thickness, color)
	return Kit.new("UIStroke", {
		Color = color or Kit.Colors.Ink,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Kit.Gradient(parent, top, bottom, rotation)
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom or Kit.Darken(top, 0.2)),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

--[[ Надпись с обводкой.
	props: Text, Size, Position, AnchorPoint, Color, Font, Scaled (true), TextSize, MaxTextSize,
	       XAlign, YAlign, Stroke (false — без обводки), StrokeColor, StrokeThickness, ZIndex, Name, Parent, RichText
]]
function Kit.Text(props)
	local label = Kit.new("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		FontFace = props.Font or Kit.Font,
		Text = props.Text or "",
		TextColor3 = props.Color or Kit.Colors.White,
		TextScaled = props.Scaled ~= false,
		TextSize = props.TextSize or 24,
		TextWrapped = true,
		RichText = props.RichText == true,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	if props.Stroke ~= false then
		Kit.new("UIStroke", {
			Color = props.StrokeColor or Kit.Colors.Ink,
			Thickness = props.StrokeThickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	if props.MaxTextSize then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, MinTextSize = 6, Parent = label })
	end
	return label
end

--[[ Мультяшная кнопка с градиентом, обводкой и «нажатием».
	props: Size, Position, AnchorPoint, Color, Color2, Text, MaxTextSize, Corner, StrokeThickness,
	       ZIndex, Name, LayoutOrder, Parent, OnClick, Sound ("Button" по умолчанию, false — без звука)
	Возвращает button, label, gradient.
]]
function Kit.Button(props)
	local zIndex = props.ZIndex or 1
	local button = Kit.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = zIndex,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Kit.Corner(button, props.Corner or UDim.new(0, 14))
	Kit.Stroke(button, props.StrokeThickness or 3)
	local color = props.Color or Kit.Colors.Green
	local gradient = Kit.Gradient(button, color, props.Color2 or Kit.Darken(color, 0.22))
	local scale = Kit.new("UIScale", { Parent = button })

	-- Блик сверху.
	local shine = Kit.new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.75,
		Size = UDim2.new(1, -10, 0.4, -4),
		Position = UDim2.new(0, 5, 0, 4),
		ZIndex = zIndex,
		Parent = button,
	})
	Kit.Corner(shine, props.Corner or UDim.new(0, 12))

	local label = Kit.Text({
		Text = props.Text or "",
		Size = UDim2.new(1, -14, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = props.MaxTextSize or 30,
		ZIndex = zIndex + 1,
		Parent = button,
	})

	button.MouseEnter:Connect(function()
		Kit.Tween(scale, 0.1, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Kit.Tween(scale, 0.1, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Kit.Tween(scale, 0.06, { Scale = 0.9 })
	end)
	button.MouseButton1Up:Connect(function()
		Kit.Tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if props.Sound ~= false then
			Sounds.Play(props.Sound or "Button")
		end
		if props.OnClick then
			props.OnClick()
		end
	end)

	return button, label, gradient
end

function Kit.SetButtonColor(gradient, color, color2)
	gradient.Color = ColorSequence.new(color, color2 or Kit.Darken(color, 0.22))
end

-- Полоса прогресса. Возвращает рамку и функцию set(доля 0..1, цвет?).
function Kit.ProgressBar(props)
	local bar = Kit.new("Frame", {
		Name = props.Name or "Bar",
		BackgroundColor3 = Kit.Colors.Ink,
		BackgroundTransparency = 0.25,
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	Kit.Corner(bar, UDim.new(0.5, 0))
	local fill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(0, 1),
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = bar,
	})
	Kit.Corner(fill, UDim.new(0.5, 0))
	local gradient = Kit.Gradient(fill, props.Color or Kit.Colors.Green)
	local function set(fraction, color)
		fraction = math.clamp(fraction, 0, 1)
		Kit.Tween(fill, 0.15, { Size = UDim2.fromScale(fraction, 1) })
		fill.Visible = fraction > 0.001
		if color then
			gradient.Color = ColorSequence.new(color, Kit.Darken(color, 0.2))
		end
	end
	return bar, set
end

-- Короткое «подпрыгивание» объекта (через его UIScale).
function Kit.Pop(guiObject, amount)
	local scale = guiObject:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Kit.new("UIScale", { Parent = guiObject })
	end
	scale.Scale = amount or 1.15
	Kit.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Корневая рамка с UIScale: внутри неё всё задаётся в дизайн-пикселях.
function Kit.CreateScaledRoot(screenGui, name)
	local root = Kit.new("Frame", {
		Name = name or "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = screenGui,
	})
	local uiScale = Kit.new("UIScale", { Parent = root })
	local function update()
		local size = screenGui.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local scale = math.clamp(math.min(size.X / Kit.DesignSize.X, size.Y / Kit.DesignSize.Y), 0.45, 1.4)
		uiScale.Scale = scale
		root.Size = UDim2.fromOffset(size.X / scale, size.Y / scale)
		Kit.Scale = scale
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
	return root
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications — всплывающие сообщения под счётчиками.
	Notifications.Show(текст, вид) — вид: "info" | "success" | "warning" | "error" | "reward"
]]

local UI = script.Parent
local Kit = require(UI.Kit)
local Sounds = require(UI.Parent.Sounds)

local Notifications = {}

local container = nil
local order = 0

local KIND_COLORS = {
	info = Kit.Colors.Blue,
	success = Kit.Colors.Green,
	warning = Kit.Colors.Orange,
	error = Kit.Colors.Red,
	reward = Kit.Colors.Gold,
}

local KIND_ICONS = {
	info = "💬",
	success = "✅",
	warning = "⚠️",
	error = "❌",
	reward = "🎁",
}

function Notifications.Init(root)
	container = Kit.new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 112),
		Size = UDim2.fromOffset(560, 260),
		ZIndex = 40,
		Parent = root,
	})
	Kit.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		Parent = container,
	})
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	kind = KIND_COLORS[kind] and kind or "info"
	order += 1

	-- Не больше 4 сообщений одновременно.
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #toasts - 3 do
		toasts[index]:Destroy()
	end

	local color = KIND_COLORS[kind]
	local toast = Kit.new("Frame", {
		Name = "Toast",
		BackgroundColor3 = Kit.Colors.Panel,
		Size = UDim2.fromOffset(540, 48),
		LayoutOrder = order,
		ZIndex = 41,
		Parent = container,
	})
	Kit.Corner(toast, UDim.new(0, 16))
	local stroke = Kit.Stroke(toast, 3)
	local scale = Kit.new("UIScale", { Scale = 0.6, Parent = toast })

	local badge = Kit.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(4, 4),
		ZIndex = 42,
		Parent = toast,
	})
	Kit.Corner(badge, UDim.new(0.5, 0))
	Kit.Text({
		Text = KIND_ICONS[kind],
		Size = UDim2.fromScale(0.75, 0.75),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Stroke = false,
		ZIndex = 43,
		Parent = badge,
	})
	local label = Kit.Text({
		Text = text,
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, -60, 1, -8),
		Position = UDim2.fromOffset(52, 4),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		ZIndex = 42,
		Parent = toast,
	})

	Kit.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if kind == "error" then
		Sounds.Play("Error")
	end

	task.delay(3.5, function()
		if not toast.Parent then
			return
		end
		Kit.Tween(toast, 0.3, { BackgroundTransparency = 1 })
		Kit.Tween(label, 0.3, { TextTransparency = 1 })
		Kit.Tween(badge, 0.3, { BackgroundTransparency = 1 })
		Kit.Tween(stroke, 0.3, { Transparency = 1 })
		task.wait(0.3)
		toast:Destroy()
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--[[
	Panels — окна (Питомцы, Магазин, Перерождение, Миры).
	Одновременно открыто только одно окно; нажатие мимо окна его закрывает.
]]

local UI = script.Parent
local Kit = require(UI.Kit)

local Panels = {}

local layer = nil
local dim = nil
local registry = {}
local current = nil

function Panels.Init(root)
	layer = Kit.new("Frame", {
		Name = "PanelLayer",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = root,
	})
	dim = Kit.new("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 1,
		Parent = layer,
	})
	dim.Activated:Connect(function()
		Panels.Close()
	end)
end

--[[ Создаёт окно. Возвращает таблицу:
	Frame   — само окно
	Header  — шапка (можно добавить свои кнопки)
	Content — место для содержимого
	OnOpen  — функция, которую можно задать: вызывается при каждом открытии
]]
function Panels.Create(name, title, size, color)
	local frame = Kit.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Kit.Colors.Panel,
		Visible = false,
		ZIndex = 2,
		Parent = layer,
	})
	Kit.Corner(frame, UDim.new(0, 24))
	Kit.Stroke(frame, 4)
	local scale = Kit.new("UIScale", { Parent = frame })

	local header = Kit.new("Frame", {
		Name = "Header",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 56),
		ZIndex = 3,
		Parent = frame,
	})
	Kit.Corner(header, UDim.new(0, 18))
	Kit.Stroke(header, 3)
	Kit.Gradient(header, color, Kit.Darken(color, 0.25))

	Kit.Text({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -90, 1, -10),
		Position = UDim2.fromOffset(16, 5),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 34,
		StrokeThickness = 3,
		ZIndex = 4,
		Parent = header,
	})

	Kit.Button({
		Name = "Close",
		Text = "✕",
		Size = UDim2.fromOffset(46, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Color = Kit.Colors.Red,
		Corner = UDim.new(0.5, 0),
		ZIndex = 5,
		Parent = header,
		OnClick = function()
			Panels.Close()
		end,
	})

	local content = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 74),
		Size = UDim2.new(1, -32, 1, -88),
		ZIndex = 3,
		Parent = frame,
	})

	local panel = {
		Name = name,
		Frame = frame,
		Header = header,
		Content = content,
		Scale = scale,
		OnOpen = nil,
	}
	registry[name] = panel
	return panel
end

function Panels.Open(name)
	local panel = registry[name]
	if not panel then
		return
	end
	if current and current ~= panel then
		current.Frame.Visible = false
	end
	current = panel

	dim.Visible = true
	Kit.Tween(dim, 0.2, { BackgroundTransparency = 0.45 })
	panel.Frame.Visible = true
	panel.Scale.Scale = 0.7
	Kit.Tween(panel.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	if panel.OnOpen then
		task.spawn(panel.OnOpen)
	end
end

function Panels.Close()
	local panel = current
	if not panel then
		return
	end
	current = nil
	local tween = Kit.Tween(panel.Scale, 0.12, { Scale = 0.8 })
	tween.Completed:Once(function()
		if current ~= panel then
			panel.Frame.Visible = false
		end
	end)
	local dimTween = Kit.Tween(dim, 0.15, { BackgroundTransparency = 1 })
	dimTween.Completed:Once(function()
		if not current then
			dim.Visible = false
		end
	end)
end

function Panels.Toggle(name)
	if current and current.Name == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.IsOpen(name)
	return current ~= nil and current.Name == name
end

function Panels.AnyOpen()
	return current ~= nil
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">PetViewport</string>
              <string name="Source"><![CDATA[--[[
	PetViewport — 3D-превью питомца в интерфейсе (ViewportFrame с камерой).
	Питомец плавно покачивается, пока окно видно на экране.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PetBuilder = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("PetBuilder"))

local UI = script.Parent
local Kit = require(UI.Kit)

local PetViewport = {}
PetViewport.__index = PetViewport

local active = {}

-- Виден ли объект на экране (учитывает видимость всех родителей).
local function isShown(guiObject)
	local current = guiObject
	while current and not current:IsA("LayerCollector") do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end
	return current ~= nil and current.Enabled
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for view in pairs(active) do
		if view.Model and view.Model.Parent and isShown(view.Frame) then
			local swing = math.sin(t * 1.3 + view.Seed) * 0.6
			local bob = math.sin(t * 2.2 + view.Seed) * 0.08 * view.Radius
			view.Model:PivotTo(CFrame.new(0, bob, 0) * CFrame.Angles(0, swing, 0))
		end
	end
end)

-- props: Size, Position, AnchorPoint, BackgroundColor3, BackgroundTransparency, ZIndex
function PetViewport.new(parent, props)
	local frame = Kit.new("ViewportFrame", {
		Name = "PetViewport",
		Size = props.Size or UDim2.fromOffset(200, 200),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.BackgroundColor3 or Color3.new(1, 1, 1),
		BackgroundTransparency = props.BackgroundTransparency or 0,
		Ambient = Color3.fromRGB(190, 190, 200),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.6, -1, 1),
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	if props.Corner then
		Kit.Corner(frame, props.Corner)
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = frame
	frame.CurrentCamera = camera

	local view = setmetatable({
		Frame = frame,
		Camera = camera,
		Model = nil,
		Radius = 1,
		Seed = math.random() * 10,
	}, PetViewport)
	active[view] = true
	return view
end

function PetViewport:SetPet(petId, golden)
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	if not petId then
		return
	end
	local model = PetBuilder.Build(petId, golden)
	if not model then
		return
	end
	local boxCFrame, size = model:GetBoundingBox()
	local radius = math.max(size.X, size.Y, size.Z) * 0.5
	local center = boxCFrame.Position
	local distance = radius * 3.4 + 1
	self.Camera.CFrame = CFrame.lookAt(center + Vector3.new(0, radius * 0.35, -distance), center)
	self.Radius = radius
	model.Parent = self.Frame
	self.Model = model
end

function PetViewport:Destroy()
	active[self] = nil
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	self.Frame:Destroy()
end

return PetViewport
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">PetsPanel</string>
              <string name="Source"><![CDATA[--[[
	PetsPanel — инвентарь питомцев.
	Слева сетка карточек, справа 3D-превью выбранного питомца и кнопки:
	Экипировать / Снять, В золото (5 одинаковых → 1 золотой), Удалить (с подтверждением).
	В шапке — «Экипировать лучших».
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Pets = require(Shared.Config.Pets)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local PetViewport = require(UI.PetViewport)
local State = require(UI.Parent.State)
local Sounds = require(UI.Parent.Sounds)

local PetsPanel = {}

local selectedUid = nil
local selectFromOutside = nil

function PetsPanel.Select(uid)
	selectedUid = uid
	if selectFromOutside then
		selectFromOutside()
	end
end

function PetsPanel.Create()
	local panel = Panels.Create("Pets", "🐾 ПИТОМЦЫ", Vector2.new(820, 490), Kit.Colors.Green)
	local content = panel.Content

	local busy = false
	local function act(action, uid, quietSuccess)
		if busy then
			return false
		end
		busy = true
		local ok, message = State.Invoke(Remotes.PetAction, action, uid)
		busy = false
		if message and (not ok or not quietSuccess) then
			Notifications.Show(message, ok and "success" or "error")
		end
		return ok
	end

	Kit.Button({
		Name = "EquipBest",
		Text = "⭐ Экипировать лучших",
		Size = UDim2.fromOffset(250, 42),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -62, 0.5, 0),
		Color = Kit.Colors.Yellow,
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = panel.Header,
		OnClick = function()
			task.spawn(act, "EquipBest", nil, false)
		end,
	})

	local info = Kit.Text({
		Name = "Info",
		Text = "",
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, -300, 0, 26),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		ZIndex = 4,
		Parent = content,
	})

	local grid = Kit.new("ScrollingFrame", {
		Name = "Grid",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, -300, 1, -32),
		BackgroundColor3 = Kit.Colors.PanelDark,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.Colors.Ink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 3,
		Parent = content,
	})
	Kit.Corner(grid, UDim.new(0, 16))
	Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 12),
		Parent = grid,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(86, 98),
		CellPadding = UDim2.fromOffset(7, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	local empty = Kit.Text({
		Name = "Empty",
		Text = "Пока пусто!\nПодойди к яйцу 🥚 и открой его за монеты",
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Size = UDim2.new(1, -320, 0, 90),
		Position = UDim2.fromOffset(10, 150),
		MaxTextSize = 24,
		ZIndex = 6,
		Visible = false,
		Parent = content,
	})

	------------------------------------------------------------------ ПРАВАЯ ЧАСТЬ
	local details = Kit.new("Frame", {
		Name = "Details",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 288, 1, 0),
		BackgroundColor3 = Kit.Colors.PanelDark,
		ZIndex = 3,
		Parent = content,
	})
	Kit.Corner(details, UDim.new(0, 16))

	local view = PetViewport.new(details, {
		Size = UDim2.new(1, -16, 0, 140),
		Position = UDim2.fromOffset(8, 8),
		Corner = UDim.new(0, 14),
		ZIndex = 4,
	})
	local nameLabel = Kit.Text({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 152), MaxTextSize = 26, StrokeThickness = 2.5, ZIndex = 4, Parent = details })
	local rarityLabel = Kit.Text({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 182), MaxTextSize = 20, ZIndex = 4, Parent = details })
	local multiplierLabel = Kit.Text({ Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 204), MaxTextSize = 22, Color = Kit.Colors.Yellow, ZIndex = 4, Parent = details })
	local hint = Kit.Text({
		Text = "Выбери питомца в списке 👈",
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Size = UDim2.new(1, -24, 0, 80),
		Position = UDim2.fromOffset(12, 120),
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = details,
	})

	local deleteArmed = false
	local deleteArmedAt = 0

	local equipButton, equipLabel, equipGradient
	local mergeButton, mergeLabel, mergeGradient
	local deleteButton, deleteLabel, deleteGradient
	local refreshDetails -- объявлена ниже

	equipButton, equipLabel, equipGradient = Kit.Button({
		Name = "Equip",
		Size = UDim2.new(1, -16, 0, 42),
		Position = UDim2.fromOffset(8, 236),
		Color = Kit.Colors.Green,
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if pet then
				task.spawn(act, pet.Equipped and "Unequip" or "Equip", pet.Uid, true)
			end
		end,
	})

	mergeButton, mergeLabel, mergeGradient = Kit.Button({
		Name = "Merge",
		Size = UDim2.new(1, -16, 0, 42),
		Position = UDim2.fromOffset(8, 284),
		Color = Kit.Colors.Gold,
		MaxTextSize = 21,
		ZIndex = 4,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if pet then
				task.spawn(act, "Merge", pet.Uid, false)
			end
		end,
	})

	deleteButton, deleteLabel, deleteGradient = Kit.Button({
		Name = "Delete",
		Size = UDim2.new(1, -16, 0, 42),
		Position = UDim2.fromOffset(8, 332),
		Color = Kit.Colors.Red,
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = details,
		OnClick = function()
			local pet = selectedUid and State.FindPet(selectedUid)
			if not pet then
				return
			end
			if not deleteArmed then
				-- Первое нажатие — просим подтвердить.
				deleteArmed = true
				deleteArmedAt = os.clock()
				refreshDetails()
				task.delay(3, function()
					if deleteArmed and os.clock() - deleteArmedAt >= 2.9 then
						deleteArmed = false
						refreshDetails()
					end
				end)
			else
				deleteArmed = false
				task.spawn(act, "Delete", pet.Uid, false)
			end
		end,
	})

	------------------------------------------------------------------ КАРТОЧКИ
	local cards = {} -- [uid] = { Card, Stroke, Golden }

	local function highlightSelection()
		for uid, item in pairs(cards) do
			local selected = uid == selectedUid
			item.Stroke.Color = selected and Kit.Colors.White or (item.Golden and Kit.Colors.Gold or Kit.Colors.Ink)
			item.Stroke.Thickness = selected and 5 or (item.Golden and 4 or 3)
			item.Scale.Scale = selected and 1.06 or 1
		end
	end

	local function makeCard(pet, order)
		local config = Pets[pet.Id]
		local rarity = Rarities[config.Rarity]
		local card = Kit.new("TextButton", {
			Name = "Pet" .. pet.Uid,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = order,
			ZIndex = 4,
			Parent = grid,
		})
		Kit.Corner(card, UDim.new(0, 14))
		local stroke = Kit.Stroke(card, pet.Golden and 4 or 3, pet.Golden and Kit.Colors.Gold or Kit.Colors.Ink)
		local topColor = pet.Golden and Kit.Colors.Gold or Kit.Lighten(rarity.Color, 0.2)
		Kit.Gradient(card, topColor, Kit.Darken(rarity.Color, 0.25))
		local scale = Kit.new("UIScale", { Parent = card })

		Kit.Text({
			Text = config.Icon,
			Stroke = false,
			Size = UDim2.new(1, 0, 0.58, 0),
			Position = UDim2.fromScale(0, 0.06),
			ZIndex = 5,
			Parent = card,
		})
		Kit.Text({
			Text = Format.Multiplier(Formulas.PetMultiplier(pet.Id, pet.Golden)),
			Size = UDim2.new(1, -6, 0.28, 0),
			Position = UDim2.new(0, 3, 0.68, 0),
			MaxTextSize = 20,
			ZIndex = 5,
			Parent = card,
		})
		if pet.Equipped then
			local badge = Kit.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -8, 0, 8),
				Size = UDim2.fromOffset(26, 26),
				BackgroundColor3 = Kit.Colors.Green,
				ZIndex = 6,
				Parent = card,
			})
			Kit.Corner(badge, UDim.new(0.5, 0))
			Kit.Stroke(badge, 2)
			Kit.Text({ Text = "✔", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 7, Parent = badge })
		end
		if pet.Golden then
			Kit.Text({
				Text = "⭐",
				Stroke = false,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(10, 10),
				Size = UDim2.fromOffset(26, 26),
				ZIndex = 6,
				Parent = card,
			})
		end

		card.Activated:Connect(function()
			Sounds.Play("Button")
			selectedUid = pet.Uid
			deleteArmed = false
			highlightSelection()
			refreshDetails()
		end)

		cards[pet.Uid] = { Card = card, Stroke = stroke, Scale = scale, Golden = pet.Golden }
	end

	local function sortedInventory()
		local list = table.clone(State.Inventory)
		table.sort(list, function(a, b)
			if a.Equipped ~= b.Equipped then
				return a.Equipped
			end
			local ma, mb = Formulas.PetMultiplier(a.Id, a.Golden), Formulas.PetMultiplier(b.Id, b.Golden)
			if ma ~= mb then
				return ma > mb
			end
			return a.Uid < b.Uid
		end)
		return list
	end

	local shownKey = nil
	refreshDetails = function()
		local pet = selectedUid and State.FindPet(selectedUid)
		local hasPet = pet ~= nil
		for _, object in ipairs({ equipButton, mergeButton, deleteButton, nameLabel, rarityLabel, multiplierLabel, view.Frame }) do
			object.Visible = hasPet
		end
		hint.Visible = not hasPet
		if not pet then
			shownKey = nil
			view:SetPet(nil)
			return
		end

		local config = Pets[pet.Id]
		local rarity = Rarities[config.Rarity]
		local key = pet.Id .. (pet.Golden and ":1" or ":0")
		if shownKey ~= key then
			shownKey = key
			view:SetPet(pet.Id, pet.Golden)
		end
		view.Frame.BackgroundColor3 = Kit.Lighten(pet.Golden and Kit.Colors.Gold or rarity.Color, 0.55)

		nameLabel.Text = config.Icon .. " " .. (pet.Golden and "Золотой " or "") .. config.Name
		nameLabel.TextColor3 = pet.Golden and Kit.Colors.Gold or Kit.Colors.White
		rarityLabel.Text = rarity.Name
		rarityLabel.TextColor3 = rarity.Color
		multiplierLabel.Text = Format.Multiplier(Formulas.PetMultiplier(pet.Id, pet.Golden)) .. " к силе за клик"

		if pet.Equipped then
			equipLabel.Text = "Снять"
			Kit.SetButtonColor(equipGradient, Kit.Colors.Orange)
		else
			equipLabel.Text = "Экипировать"
			Kit.SetButtonColor(equipGradient, Kit.Colors.Green)
		end

		local need = GameConfig.GoldenMergeCount
		if pet.Golden then
			mergeLabel.Text = "✨ Уже золотой"
			Kit.SetButtonColor(mergeGradient, Kit.Colors.Grey)
		else
			local same = 0
			for _, other in ipairs(State.Inventory) do
				if other.Id == pet.Id and not other.Golden then
					same += 1
				end
			end
			mergeLabel.Text = string.format("✨ В золото (%d/%d)", math.min(same, need), need)
			Kit.SetButtonColor(mergeGradient, same >= need and Kit.Colors.Gold or Kit.Colors.Grey)
		end

		if deleteArmed then
			deleteLabel.Text = "Точно удалить?"
			Kit.SetButtonColor(deleteGradient, Kit.Colors.RedDark, Color3.fromRGB(140, 20, 30))
		else
			deleteLabel.Text = "🗑 Удалить"
			Kit.SetButtonColor(deleteGradient, Kit.Colors.Red)
		end
	end

	local function refreshInfo()
		info.Text = string.format(
			"Питомцы: %d/%d   •   Надето: %d/%d   •   Бонус: %s",
			#State.Inventory,
			GameConfig.MaxPets,
			State.EquippedCount(),
			State.Get("MaxEquipped", GameConfig.BaseEquipSlots),
			Format.Multiplier(State.Get("PetMultiplier", 1))
		)
	end

	local dirty = true
	local function rebuild()
		dirty = false
		for _, item in pairs(cards) do
			item.Card:Destroy()
		end
		cards = {}
		local list = sortedInventory()
		for index, pet in ipairs(list) do
			makeCard(pet, index)
		end
		empty.Visible = #list == 0
		if selectedUid and not State.FindPet(selectedUid) then
			selectedUid = nil
			deleteArmed = false
		end
		if not selectedUid and list[1] then
			selectedUid = list[1].Uid
		end
		highlightSelection()
		refreshDetails()
		refreshInfo()
	end

	State.OnInventory(function()
		if panel.Frame.Visible then
			rebuild()
		else
			dirty = true
			refreshInfo()
		end
	end)
	State.Watch({ "MaxEquipped", "PetMultiplier" }, refreshInfo)

	panel.OnOpen = function()
		if dirty then
			rebuild()
		else
			refreshDetails()
		end
	end

	selectFromOutside = function()
		deleteArmed = false
		if panel.Frame.Visible then
			highlightSelection()
			refreshDetails()
		end
	end
end

return PetsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Popups</string>
              <string name="Source"><![CDATA[--[[
	Popups — летящие цифры «+N» при кликах, сборе монет и продаже.
	Слой лежит прямо в ScreenGui (без UIScale), поэтому координаты — обычные пиксели экрана.
]]

local Debris = game:GetService("Debris")

local UI = script.Parent
local Kit = require(UI.Kit)

local Popups = {}

local layer = nil
local active = 0
local MAX_ACTIVE = 40

function Popups.Init(screenGui)
	layer = Kit.new("Frame", {
		Name = "Popups",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = screenGui,
	})
end

-- position — Vector2 в пикселях ScreenGui; sizeMultiplier — размер текста (1 = обычный).
function Popups.Show(position, text, color, sizeMultiplier)
	if not layer or active >= MAX_ACTIVE then
		return
	end
	active += 1
	sizeMultiplier = sizeMultiplier or 1
	local textSize = math.floor(34 * Kit.Scale * sizeMultiplier)

	local label = Kit.Text({
		Text = text,
		Color = color or Kit.Colors.Yellow,
		Scaled = false,
		TextSize = textSize,
		StrokeThickness = math.max(2, math.floor(3 * Kit.Scale * sizeMultiplier)),
		Size = UDim2.fromOffset(textSize * 10, textSize * 1.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(position.X, position.Y),
		ZIndex = 51,
		Parent = layer,
	})
	label.Rotation = math.random(-12, 12)
	local stroke = label:FindFirstChildOfClass("UIStroke")
	local scale = Kit.new("UIScale", { Scale = 0.3, Parent = label })

	Kit.Tween(scale, 0.15, { Scale = 1.1 }, Enum.EasingStyle.Back)
	local rise = 70 * Kit.Scale * (0.8 + sizeMultiplier * 0.4)
	Kit.Tween(label, 0.9, {
		Position = UDim2.fromOffset(position.X + math.random(-20, 20), position.Y - rise),
		TextTransparency = 1,
		Rotation = label.Rotation * 0.3,
	}, Enum.EasingStyle.Quint)
	if stroke then
		Kit.Tween(stroke, 0.9, { Transparency = 1 }, Enum.EasingStyle.Quint)
	end

	task.delay(0.95, function()
		active -= 1
	end)
	Debris:AddItem(label, 1)
end

-- Цифра около кнопки (над её центром, со случайным смещением).
function Popups.AtGuiObject(guiObject, text, color, sizeMultiplier)
	local center = guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2
	local spread = guiObject.AbsoluteSize.X * 0.5
	local position = center + Vector2.new(math.random(-100, 100) / 100 * spread, -guiObject.AbsoluteSize.Y * 0.6 + math.random(-15, 10))
	Popups.Show(position, text, color, sizeMultiplier)
end

-- Крупная надпись по центру экрана.
function Popups.Center(text, color, sizeMultiplier)
	if not layer then
		return
	end
	local size = layer.AbsoluteSize
	Popups.Show(Vector2.new(size.X / 2, size.Y * 0.42), text, color, sizeMultiplier or 1.8)
end

return Popups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">RebirthPanel</string>
              <string name="Source"><![CDATA[--[[
	RebirthPanel — перерождение: текущий и следующий множитель, прогресс до перерождения,
	что сбросится и что останется. Кнопку нужно нажать дважды (подтверждение).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local RebirthPanel = {}

function RebirthPanel.Create()
	local panel = Panels.Create("Rebirth", "🔁 ПЕРЕРОЖДЕНИЕ", Vector2.new(540, 440), Kit.Colors.Purple)
	local content = panel.Content

	local multiplierLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 56),
		MaxTextSize = 50,
		StrokeThickness = 3,
		Color = Kit.Colors.Yellow,
		ZIndex = 4,
		Parent = content,
	})
	Kit.Text({
		Text = "постоянный бонус к силе за каждый клик",
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 56),
		MaxTextSize = 19,
		ZIndex = 4,
		Parent = content,
	})

	local requirementLabel = Kit.Text({
		Text = "",
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 90),
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = content,
	})
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -20, 0, 32),
		Position = UDim2.fromOffset(10, 122),
		Color = Kit.Colors.Purple,
		ZIndex = 4,
		Parent = content,
	})
	local progressLabel = Kit.Text({
		Text = "",
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.fromOffset(5, 0),
		MaxTextSize = 22,
		ZIndex = 7,
		Parent = bar,
	})

	local infoBox = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 92),
		Position = UDim2.fromOffset(0, 166),
		BackgroundColor3 = Kit.Colors.PanelDark,
		ZIndex = 4,
		Parent = content,
	})
	Kit.Corner(infoBox, UDim.new(0, 14))
	Kit.Text({
		Text = "Сбросится: 💪 сила, ⭐ накопленная сила, 🪙 монеты",
		Color = Kit.Colors.RedDark,
		Stroke = false,
		Font = Kit.FontBold,
		Size = UDim2.new(1, -20, 0.5, -6),
		Position = UDim2.fromOffset(10, 6),
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = infoBox,
	})
	Kit.Text({
		Text = "Останется: 🐾 питомцы, 🎒 рюкзак, 🌍 миры",
		Color = Kit.Colors.GreenDark,
		Stroke = false,
		Font = Kit.FontBold,
		Size = UDim2.new(1, -20, 0.5, -6),
		Position = UDim2.new(0, 10, 0.5, 0),
		MaxTextSize = 20,
		ZIndex = 5,
		Parent = infoBox,
	})

	local armed = false
	local armedAt = 0
	local busy = false
	local refresh -- объявлена ниже

	local _, buttonLabel, buttonGradient = Kit.Button({
		Name = "RebirthButton",
		Size = UDim2.new(1, -40, 0, 60),
		Position = UDim2.fromOffset(20, 272),
		Color = Kit.Colors.Purple,
		MaxTextSize = 30,
		StrokeThickness = 4,
		ZIndex = 4,
		Parent = content,
		OnClick = function()
			if busy then
				return
			end
			local total = State.Get("TotalStrength", 0)
			local cost = Formulas.RebirthCost(State.Get("Rebirths", 0))
			if total < cost then
				Notifications.Show("Нужно ещё " .. Format.Number(cost - total) .. " ⭐ силы", "error")
				return
			end
			if not armed then
				armed = true
				armedAt = os.clock()
				refresh()
				task.delay(3, function()
					if armed and os.clock() - armedAt >= 2.9 then
						armed = false
						refresh()
					end
				end)
				return
			end
			armed = false
			busy = true
			task.spawn(function()
				local ok, message = State.Invoke(Remotes.Rebirth)
				busy = false
				if message then
					Notifications.Show(message, ok and "success" or "error")
				end
				if ok then
					Panels.Close()
				end
				refresh()
			end)
		end,
	})

	refresh = function()
		local rebirths = State.Get("Rebirths", 0)
		local total = State.Get("TotalStrength", 0)
		local cost = Formulas.RebirthCost(rebirths)
		local current = Formulas.RebirthMultiplier(rebirths)
		local nextMultiplier = Formulas.RebirthMultiplier(rebirths + 1)

		multiplierLabel.Text = Format.Multiplier(current) .. "  ➜  " .. Format.Multiplier(nextMultiplier)
		requirementLabel.Text = "Нужно ⭐ " .. Format.Number(cost) .. " накопленной силы"
		local fraction = cost > 0 and total / cost or 1
		setBar(fraction, fraction >= 1 and Kit.Colors.Green or Kit.Colors.Purple)
		progressLabel.Text = Format.Number(math.min(total, cost)) .. " / " .. Format.Number(cost)

		if fraction < 1 then
			armed = false
			buttonLabel.Text = "🔒 Копи силу"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Grey)
		elseif armed then
			buttonLabel.Text = "Точно? Нажми ещё раз!"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Orange)
		else
			buttonLabel.Text = "🔁 ПЕРЕРОДИТЬСЯ"
			Kit.SetButtonColor(buttonGradient, Kit.Colors.Purple)
		end
	end

	State.Watch({ "Rebirths", "TotalStrength" }, refresh)
	panel.OnOpen = function()
		armed = false
		refresh()
	end
end

return RebirthPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--[[
	ShopPanel — магазин: рюкзаки (по порядку, за монеты) и геймпасс «+2 слота питомцев».
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Backpacks = require(Shared.Config.Backpacks)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local ShopPanel = {}

local function sectionTitle(parent, text, order)
	return Kit.Text({
		Text = text,
		Size = UDim2.new(1, -12, 0, 34),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		StrokeThickness = 2.5,
		LayoutOrder = order,
		ZIndex = 4,
		Parent = parent,
	})
end

local function makeRow(parent, order, icon, title, subtitle)
	local row = Kit.new("Frame", {
		Size = UDim2.new(1, -14, 0, 68),
		BackgroundColor3 = Kit.Colors.White,
		LayoutOrder = order,
		ZIndex = 4,
		Parent = parent,
	})
	Kit.Corner(row, UDim.new(0, 16))
	Kit.Stroke(row, 3)
	Kit.Text({
		Text = icon,
		Stroke = false,
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(0, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 5,
		Parent = row,
	})
	local titleLabel = Kit.Text({
		Text = title,
		Color = Kit.Colors.Ink,
		Stroke = false,
		Size = UDim2.new(1, -260, 0, 28),
		Position = UDim2.fromOffset(68, 7),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		ZIndex = 5,
		Parent = row,
	})
	local subtitleLabel = Kit.Text({
		Text = subtitle,
		Color = Kit.Colors.GreyDark,
		Stroke = false,
		Font = Kit.FontBold,
		Size = UDim2.new(1, -260, 0, 22),
		Position = UDim2.fromOffset(68, 37),
		XAlign = Enum.TextXAlignment.Left,
		MaxTextSize = 18,
		ZIndex = 5,
		Parent = row,
	})
	return row, titleLabel, subtitleLabel
end

function ShopPanel.Create()
	local panel = Panels.Create("Shop", "🛒 МАГАЗИН", Vector2.new(640, 480), Kit.Colors.Yellow)

	local list = Kit.new("ScrollingFrame", {
		Name = "List",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.Colors.Ink,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 3,
		Parent = panel.Content,
	})
	Kit.new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = list,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = list })

	local busy = false
	local function buy(remote, ...)
		if busy then
			return
		end
		busy = true
		local ok, message = State.Invoke(remote, ...)
		busy = false
		if message then
			Notifications.Show(message, ok and "success" or "error")
		end
	end

	------------------------------------------------------------------ РЮКЗАКИ
	sectionTitle(list, "🎒 РЮКЗАКИ — сколько силы помещается", 1)
	local rows = {}
	for level, backpack in ipairs(Backpacks) do
		local row = makeRow(list, 10 + level, backpack.Icon, backpack.Name, "Вместимость: " .. Format.Number(backpack.Capacity) .. " силы")
		local button, label, gradient = Kit.Button({
			Size = UDim2.fromOffset(176, 48),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			MaxTextSize = 22,
			ZIndex = 5,
			Parent = row,
			OnClick = function()
				local current = State.Get("BackpackLevel", 1)
				if level == current + 1 then
					task.spawn(buy, Remotes.BuyBackpack, level)
				elseif level > current + 1 then
					Notifications.Show("Сначала купи предыдущий рюкзак", "info")
				end
			end,
		})
		rows[level] = { Button = button, Label = label, Gradient = gradient, Price = backpack.Price }
	end

	------------------------------------------------------------------ ГЕЙМПАСС
	sectionTitle(list, "⭐ ГЕЙМПАССЫ", 100)
	local passSubtitle = GameConfig.PetSlotsGamepassId == 0 and "Тестовый режим: выдаётся бесплатно"
		or ("Надевай " .. GameConfig.GamepassEquipSlots .. " питомцев вместо " .. GameConfig.BaseEquipSlots)
	local passRow = makeRow(list, 101, "🐾", "+2 слота питомцев", passSubtitle)
	local _, passLabel, passGradient = Kit.Button({
		Size = UDim2.fromOffset(176, 48),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		MaxTextSize = 22,
		ZIndex = 5,
		Parent = passRow,
		OnClick = function()
			if State.Get("PetSlotsPass", false) then
				Notifications.Show("Уже куплено ✔", "info")
			else
				task.spawn(buy, Remotes.BuyPetSlots)
			end
		end,
	})

	------------------------------------------------------------------ ОБНОВЛЕНИЕ
	local function refresh()
		local current = State.Get("BackpackLevel", 1)
		local coins = State.Get("Coins", 0)
		for level, row in pairs(rows) do
			if level < current then
				row.Label.Text = "✔ Было"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			elseif level == current then
				row.Label.Text = "🎒 Надет"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Blue)
			elseif level == current + 1 then
				row.Label.Text = "🪙 " .. Format.Number(row.Price)
				Kit.SetButtonColor(row.Gradient, coins >= row.Price and Kit.Colors.Green or Kit.Colors.Orange)
			else
				row.Label.Text = "🔒 " .. Format.Number(row.Price)
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			end
		end

		if State.Get("PetSlotsPass", false) then
			passLabel.Text = "✔ Куплено"
			Kit.SetButtonColor(passGradient, Kit.Colors.Grey)
		else
			passLabel.Text = GameConfig.PetSlotsGamepassId == 0 and "🎁 Получить" or "💎 Купить"
			Kit.SetButtonColor(passGradient, Kit.Colors.Purple)
		end
	end

	State.Watch({ "BackpackLevel", "Coins", "PetSlotsPass" }, refresh)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">WorldsPanel</string>
              <string name="Source"><![CDATA[--[[
	WorldsPanel — список миров: открыт / можно открыть / сколько силы нужно.
	Отсюда можно телепортироваться в любой открытый мир.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)
local Remotes = require(Shared.Modules.Remotes)

local UI = script.Parent
local Kit = require(UI.Kit)
local Panels = require(UI.Panels)
local Notifications = require(UI.Notifications)
local State = require(UI.Parent.State)

local WorldsPanel = {}

function WorldsPanel.Create()
	local panel = Panels.Create("Worlds", "🌍 МИРЫ", Vector2.new(640, 440), Kit.Colors.Blue)
	local content = panel.Content

	Kit.new("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})

	local busy = false
	local rows = {}

	for index, worldId in ipairs(Worlds.Order) do
		local world = Worlds[worldId]
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 0, 98),
			BackgroundColor3 = Kit.Colors.White,
			LayoutOrder = index,
			ZIndex = 4,
			Parent = content,
		})
		Kit.Corner(row, UDim.new(0, 18))
		Kit.Stroke(row, 3)

		local swatch = Kit.new("Frame", {
			Size = UDim2.fromOffset(80, 80),
			Position = UDim2.new(0, 9, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 5,
			Parent = row,
		})
		Kit.Corner(swatch, UDim.new(0, 16))
		Kit.Stroke(swatch, 3)
		Kit.Gradient(swatch, Kit.Lighten(world.Color, 0.2), Kit.Darken(world.Color, 0.25))
		Kit.Text({
			Text = world.Icon,
			Stroke = false,
			Size = UDim2.fromScale(0.7, 0.7),
			Position = UDim2.fromScale(0.15, 0.15),
			ZIndex = 6,
			Parent = swatch,
		})

		Kit.Text({
			Text = world.Name,
			Color = Kit.Darken(world.Color, 0.3),
			StrokeColor = Kit.Colors.Ink,
			StrokeThickness = 1,
			Size = UDim2.new(1, -290, 0, 30),
			Position = UDim2.fromOffset(100, 6),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 26,
			ZIndex = 5,
			Parent = row,
		})
		Kit.Text({
			Text = world.Description,
			Color = Kit.Colors.GreyDark,
			Stroke = false,
			Font = Kit.FontBold,
			Size = UDim2.new(1, -290, 0, 22),
			Position = UDim2.fromOffset(100, 38),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			ZIndex = 5,
			Parent = row,
		})
		Kit.Text({
			Text = string.format("💰 продажа ×%s   •   🪙 монеты по %s", Format.Number(world.SellMultiplier), Format.Number(world.CoinValue)),
			Color = Kit.Colors.Ink,
			Stroke = false,
			Font = Kit.FontBold,
			Size = UDim2.new(1, -290, 0, 22),
			Position = UDim2.fromOffset(100, 64),
			XAlign = Enum.TextXAlignment.Left,
			MaxTextSize = 17,
			ZIndex = 5,
			Parent = row,
		})

		local _, label, gradient = Kit.Button({
			Size = UDim2.fromOffset(176, 56),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			MaxTextSize = 22,
			ZIndex = 5,
			Parent = row,
			OnClick = function()
				if busy then
					return
				end
				if State.Get("World", "Forest") == worldId then
					Panels.Close()
					return
				end
				busy = true
				task.spawn(function()
					local ok, message = State.Invoke(Remotes.Teleport, worldId)
					busy = false
					if ok then
						Panels.Close()
					elseif message then
						Notifications.Show(message, "error")
					end
				end)
			end,
		})
		rows[worldId] = { Label = label, Gradient = gradient }
	end

	local function refresh()
		local unlocked = State.UnlockedWorlds()
		local total = State.Get("TotalStrength", 0)
		local currentWorld = State.Get("World", "Forest")
		for _, worldId in ipairs(Worlds.Order) do
			local world = Worlds[worldId]
			local row = rows[worldId]
			if worldId == currentWorld then
				row.Label.Text = "📍 Ты здесь"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			elseif unlocked[worldId] then
				row.Label.Text = "✈️ Телепорт"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Blue)
			elseif total >= world.UnlockStrength then
				row.Label.Text = "✨ Открыть!"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Green)
			else
				row.Label.Text = "🔒 " .. Format.Number(world.UnlockStrength) .. " ⭐"
				Kit.SetButtonColor(row.Gradient, Kit.Colors.Grey)
			end
		end
	end

	State.Watch({ "UnlockedWorlds", "TotalStrength", "World" }, refresh)
end

return WorldsPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">WorldEffects</string>
            <string name="Source"><![CDATA[--[[
	WorldEffects — то, что игрок видит в мирах:
	- своё освещение, небо, дымка и гравитация для каждого мира (меняются только у этого игрока);
	- крупная надпись с названием мира при входе;
	- монеты крутятся и покачиваются;
	- таблички порталов показывают, сколько силы ещё нужно именно этому игроку.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Worlds = require(Shared.Config.Worlds)
local Format = require(Shared.Modules.Format)

local Client = script.Parent
local State = require(Client.State)
local UI = Client:WaitForChild("UI")
local Kit = require(UI.Kit)

local WorldEffects = {}

local atmosphere = nil
local sky = nil
local banner = nil
local bannerScale = nil
local currentWorld = nil

------------------------------------------------------------------ ОСВЕЩЕНИЕ

local function applyWorld(worldId, instant)
	local world = Worlds[worldId]
	if not world then
		return
	end
	local settings = world.Lighting
	local duration = instant and 0 or 1.2

	local lightingGoal = {
		ClockTime = settings.ClockTime,
		Brightness = settings.Brightness,
		Ambient = settings.Ambient,
		OutdoorAmbient = settings.OutdoorAmbient,
	}
	local atmosphereGoal = {
		Density = settings.Atmosphere.Density,
		Offset = settings.Atmosphere.Offset,
		Color = settings.Atmosphere.Color,
		Decay = settings.Atmosphere.Decay,
		Glare = settings.Atmosphere.Glare,
		Haze = settings.Atmosphere.Haze,
	}
	if instant then
		for key, value in pairs(lightingGoal) do
			Lighting[key] = value
		end
		for key, value in pairs(atmosphereGoal) do
			atmosphere[key] = value
		end
	else
		Kit.Tween(Lighting, duration, lightingGoal, Enum.EasingStyle.Sine)
		Kit.Tween(atmosphere, duration, atmosphereGoal, Enum.EasingStyle.Sine)
	end
	sky.StarCount = settings.StarCount or 3000
	Workspace.Gravity = world.Gravity or 196.2
end

local function showBanner(worldId)
	local world = Worlds[worldId]
	if not world or not banner then
		return
	end
	banner.Text = world.Icon .. " " .. Format.Upper(world.Name)
	banner.TextColor3 = Kit.Lighten(world.Color, 0.3)
	banner.TextTransparency = 0
	banner.Visible = true
	local stroke = banner:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	bannerScale.Scale = 0.4
	Kit.Tween(bannerScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2, function()
		if banner.Text ~= world.Icon .. " " .. Format.Upper(world.Name) then
			return
		end
		Kit.Tween(banner, 0.5, { TextTransparency = 1 })
		if stroke then
			Kit.Tween(stroke, 0.5, { Transparency = 1 })
		end
	end)
end

------------------------------------------------------------------ МОНЕТЫ

local coins = {} -- [part] = исходный CFrame

local function addCoin(part)
	if part:IsA("BasePart") then
		coins[part] = part.CFrame
	end
end

local function spinCoins()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local t = os.clock()
	for part, base in pairs(coins) do
		if part.Parent then
			local position = base.Position
			if (position - cameraPosition).Magnitude < 260 then
				part.CFrame = CFrame.new(position + Vector3.new(0, math.sin(t * 2 + position.X) * 0.4, 0))
					* CFrame.Angles(0, t * 2.5 + position.Z, 0)
			end
		else
			coins[part] = nil
		end
	end
end

------------------------------------------------------------------ ПОРТАЛЫ

local portals = {}

local function updatePortal(model)
	if model:GetAttribute("IsBack") then
		return
	end
	local status = model:FindFirstChild("Status", true)
	local targetId = model:GetAttribute("TargetWorld")
	local world = Worlds[targetId]
	if not status or not world then
		return
	end
	local total = State.Get("TotalStrength", 0)
	if State.UnlockedWorlds()[targetId] then
		status.Text = "✅ Открыто — заходи!"
		status.TextColor3 = Color3.fromRGB(140, 255, 150)
	elseif total >= world.UnlockStrength then
		status.Text = "✨ Можно открыть — заходи!"
		status.TextColor3 = Color3.fromRGB(255, 230, 100)
	else
		status.Text = string.format("🔒 %s / %s ⭐ силы", Format.Number(total), Format.Number(world.UnlockStrength))
		status.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

local updateQueued = false
local function updateAllPortals()
	if updateQueued then
		return
	end
	updateQueued = true
	task.delay(0.3, function()
		updateQueued = false
		for model in pairs(portals) do
			if model.Parent then
				updatePortal(model)
			else
				portals[model] = nil
			end
		end
	end)
end

local function addPortal(model)
	portals[model] = true
	updatePortal(model)
	-- При StreamingEnabled табличка может подгрузиться позже самого портала.
	model.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Status" then
			updatePortal(model)
		end
	end)
end

------------------------------------------------------------------ ЗАПУСК

function WorldEffects.Init(root)
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end

	banner = Kit.Text({
		Name = "WorldBanner",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(700, 90),
		MaxTextSize = 80,
		StrokeThickness = 5,
		Visible = false,
		ZIndex = 30,
		Parent = root,
	})
	bannerScale = Kit.new("UIScale", { Parent = banner })

	State.Watch("World", function()
		local worldId = State.Get("World", "Forest")
		if worldId == currentWorld then
			return
		end
		local first = currentWorld == nil
		currentWorld = worldId
		applyWorld(worldId, first)
		if State.IsLoaded() or not first then
			showBanner(worldId)
		end
	end)
	-- Приветственная надпись, когда данные загрузились.
	State.Watch("DataLoaded", function()
		if State.IsLoaded() then
			showBanner(State.Get("World", "Forest"))
		end
	end)

	for _, coin in ipairs(CollectionService:GetTagged("Coin")) do
		addCoin(coin)
	end
	CollectionService:GetInstanceAddedSignal("Coin"):Connect(addCoin)
	CollectionService:GetInstanceRemovedSignal("Coin"):Connect(function(part)
		coins[part] = nil
	end)
	RunService.RenderStepped:Connect(spinCoins)

	for _, portal in ipairs(CollectionService:GetTagged("Portal")) do
		addPortal(portal)
	end
	CollectionService:GetInstanceAddedSignal("Portal"):Connect(addPortal)
	CollectionService:GetInstanceRemovedSignal("Portal"):Connect(function(model)
		portals[model] = nil
	end)
	State.Watch({ "TotalStrength", "UnlockedWorlds" }, updateAllPortals)
end

return WorldEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>