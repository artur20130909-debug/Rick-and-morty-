<Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><token name="LightingStyle">0</token><bool name="PrioritizeLightingQuality">true</bool><bool name="GlobalShadows">true</bool><float name="ShadowSoftness">0.22</float><float name="EnvironmentDiffuseScale">0.55</float><float name="EnvironmentSpecularScale">0.25</float><float name="Brightness">3.1</float><float name="ClockTime">7.45</float><float name="GeographicLatitude">30</float><Color3 name="Ambient"><R>0.44</R><G>0.44</G><B>0.49</B></Color3><Color3 name="OutdoorAmbient"><R>0.55</R><G>0.54</G><B>0.59</B></Color3><float name="ExposureCompensation">0.12</float></Properties></Item>
<Item class="Players" referent="RBX00000003"><Properties><string name="Name">Players</string><int name="MaxPlayers">6</int><bool name="CharacterAutoLoads">true</bool></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX00000018"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">App</string><ProtectedString name="Source"><![CDATA[-- Клиент целиком: загрузка → главное меню → глава → снова меню. Пауза (P / кнопка II).
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ContentProvider = game:GetService("ContentProvider")

local App = {}
local ctx
local inStory = false
local paused = false
local wasActive = false

local function coreGui()
	-- прячем лишнее из стандартного интерфейса Roblox (список игроков, рюкзак, чат оставляем)
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false) end)
	-- кнопка «Сброс персонажа» сломала бы сценки — отключаем (повторяем, пока CoreScripts не готовы)
	task.spawn(function()
		for _ = 1, 20 do
			local ok = pcall(function() StarterGui:SetCore("ResetButtonCallback", false) end)
			if ok then break end
			task.wait(0.5)
		end
	end)
end

-- экран загрузки
local function loading()
	local G, Config = ctx.Gui, ctx.Config
	local sg, root = G.screen("Loading", 100)
	local bg = G.frame(root, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 14, 9) })
	local logo = G.logo(root, ctx.Util.upper("Рик и Морти"), 64, UDim2.new(0.5, 0, 0.5, -90))
	local _l = logo
	local dot = G.frame(root, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 40), Size = UDim2.fromOffset(46, 46),
		BackgroundColor3 = Config.Colors.Portal })
	G.corner(dot, UDim.new(0.5, 0))
	local gr = G.gradient(dot, { Config.Colors.PortalLight, Config.Colors.Portal, Config.Colors.PortalDark, Config.Colors.Portal, Config.Colors.PortalLight }, 0)
	local label = G.label(root, "Загрузка…", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 80), Size = UDim2.fromOffset(400, 30),
		FontFace = G.Fonts.BodyBold, TextSize = 20, TextColor3 = Color3.fromRGB(200, 230, 200) })
	local spinning = true
	task.spawn(function()
		while spinning do
			gr.Rotation = (gr.Rotation + 9) % 360
			task.wait(1 / 30)
		end
	end)
	return function()
		spinning = false
		G.tween(bg, 0.6, { BackgroundTransparency = 1 })
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextLabel") then G.tween(d, 0.5, { TextTransparency = 1 }) end
			if d:IsA("Frame") then G.tween(d, 0.5, { BackgroundTransparency = 1 }) end
			if d:IsA("UIStroke") then G.tween(d, 0.5, { Transparency = 1 }) end
		end
		task.delay(0.7, function() sg:Destroy() end)
	end, label
end

local function toMenu()
	local Story, Menu, Hud, Controls, Cine = ctx.Story, ctx.Menu, ctx.Hud, ctx.Controls, ctx.Cine
	inStory = false
	paused = false
	ctx.Util.setPaused(false)
	ctx.Audio.setPaused(false)
	Story.cleanup()
	Hud.gameplay(false)
	Controls.setActive(false)
	Controls.freeze(true)
	ctx.Prompts.setEnabled(false)
	Hud.fadeSet(1)
	-- персонаж ждёт в коридоре (вне кадра меню) и скрыт у себя на экране
	local hide = workspace.House.Markers:FindFirstChild("MenuHide")
	if hide then Controls.place(hide.CFrame, true) end
	Story.hideBody(true)
	Menu.sceneStart()
	Hud.fade(0, 1.2)
	Menu.show(function()
		Menu.enterPortal()
		Menu.hide()
		Menu.sceneStop()
		Cine.release()
		inStory = true
		Story.start(toMenu)
	end)
end
App.toMenu = toMenu

local function togglePause()
	local Menu, Story = ctx.Menu, ctx.Story
	if not inStory or Story.state() == "ending" then return end
	if paused then
		Menu.unpause()
		paused = false
		ctx.Util.setPaused(false)
		ctx.Audio.setPaused(false)
		if wasActive then ctx.Controls.freeze(false) end
		return
	end
	paused = true
	wasActive = Story.state() == "roam"
	ctx.Util.setPaused(true)
	ctx.Audio.setPaused(true)
	ctx.Controls.freeze(true)
	Menu.pause(function()
		paused = false
		ctx.Util.setPaused(false)
		ctx.Audio.setPaused(false)
		if wasActive then ctx.Controls.freeze(false) end
	end, function()
		paused = false
		ctx.Hud.fadeWait(1, 0.5)
		toMenu()
	end)
end

function App.start(c)
	ctx = c
	coreGui()
	local done, label = loading()
	-- ждём, пока сервер построит дом
	local house = workspace:WaitForChild("House", 60)
	while house and not house:GetAttribute("Ready") do task.wait(0.1) end
	label.Text = "Почти готово…"
	-- модули, которым нужен дом
	for _, name in ipairs({ "World", "Outline", "Story" }) do
		local ok, err = pcall(function() c[name].init(c) end)
		if not ok then warn("[RM] init " .. name .. ": " .. tostring(err)) end
	end
	-- подгрузить звуки заранее (не дольше 6 секунд)
	local list = {}
	for _, k in ipairs({ "MusicMenu", "MusicMorning", "SfxAtlas" }) do
		local id = c.Build.asset(c.Config.Sounds[k])
		if id ~= "" then
			local s = Instance.new("Sound")
			s.SoundId = id
			table.insert(list, s)
		end
	end
	if #list > 0 then
		local fin = false
		task.spawn(function() pcall(function() ContentProvider:PreloadAsync(list) end); fin = true end)
		local t0 = os.clock()
		while not fin and os.clock() - t0 < 6 do task.wait(0.1) end
	end
	local char = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 10)
	c.Controls.onPause = togglePause
	c.Hud.pauseButton(togglePause)
	toMenu()
	done()
end

return App
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[-- Звук: музыка с плавной сменой треков, короткие эффекты из общего файла SfxAtlas
-- (кусок файла задаётся PlaybackRegion), 3D-звуки у предметов, петли (будильник, гул, птицы).
-- Если ID пустой — звук просто не играет.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Audio = {}
local Config, Settings, B
local musicGroup, sfxGroup, eq
local current -- текущая музыка { sound, key }
local loops = {}

local function group(name)
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Volume = 1
	g.Parent = SoundService
	return g
end

function Audio.init(ctx)
	Config, Settings, B = ctx.Config, ctx.Settings, ctx.Build
	musicGroup = group("Music")
	sfxGroup = group("Sfx")
	eq = Instance.new("EqualizerSoundEffect")
	eq.Enabled = false
	eq.HighGain = -24
	eq.MidGain = -8
	eq.LowGain = 0
	eq.Parent = musicGroup
	local function applyVol()
		musicGroup.Volume = Settings.get("Music")
		sfxGroup.Volume = Settings.get("Sfx")
	end
	applyVol()
	Settings.Changed:Connect(applyVol)
end

local function asset(id) return B.asset(id) end

-- если атлас ещё не загружен — встроенные звуки Roblox для самого нужного
local FALLBACK = { Click = "UiClick", PhoneTap = "UiClick", AlarmOff = "UiClick" }

-- «приглушить» музыку (пауза, телефон)
function Audio.muffle(on)
	if eq then eq.Enabled = on end
end

-- музыка: key из Config.Sounds (MusicMenu / MusicMorning); fade — секунды
function Audio.music(key, fade, volume)
	fade = fade or 1.5
	if current and current.key == key then return end
	local old = current
	current = nil
	if old then
		local s = old.sound
		local tw = TweenService:Create(s, TweenInfo.new(fade), { Volume = 0 })
		tw:Play()
		tw.Completed:Connect(function() s:Destroy() end)
	end
	if not key then return end
	local id = asset(Config.Sounds[key])
	if id == "" then return end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.SoundGroup = musicGroup
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(fade), { Volume = volume or 0.5 }):Play()
	current = { sound = s, key = key }
end

function Audio.stopMusic(fade) Audio.music(nil, fade) end

-- звук из атласа (или отдельный звук, если в Config.Sounds есть такой ключ)
-- opts: at = Instance (3D), volume, speed, pitchJitter, loop
function Audio.play(name, opts)
	opts = opts or {}
	local s = Instance.new("Sound")
	s.Name = name
	local region = Config.Sfx[name]
	local atlas = asset(Config.Sounds.SfxAtlas)
	local direct = Config.Sounds[name] or Config.Sounds[FALLBACK[name] or ""]
	if region and atlas ~= "" then
		s.SoundId = atlas
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[2])
		if opts.loop then s.LoopRegion = NumberRange.new(region[1], region[2]) end
	elseif direct and direct ~= "" then
		s.SoundId = asset(direct)
	else
		s:Destroy()
		return nil
	end
	s.Volume = opts.volume or 0.7
	local sp = opts.speed or 1
	if opts.pitchJitter then sp = sp * (1 + (math.random() * 2 - 1) * opts.pitchJitter) end
	s.PlaybackSpeed = sp
	s.Looped = opts.loop == true
	s.SoundGroup = sfxGroup
	if opts.at then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = opts.min or 6
		s.RollOffMaxDistance = opts.max or 70
		s.Parent = opts.at
	else
		s.Parent = SoundService
	end
	s:Play()
	if not s.Looped then
		local len = region and (region[2] - region[1]) or 4
		task.delay(len / math.max(sp, 0.1) + 0.5, function() if s.Parent then s:Destroy() end end)
	end
	return s
end

-- петля с именем (чтобы потом остановить): Audio.loop("alarm", "Alarm", {at = part})
function Audio.loop(id, name, opts)
	Audio.stop(id)
	opts = opts or {}
	opts.loop = true
	local s = Audio.play(name, opts)
	if s then loops[id] = s end
	return s
end

function Audio.stop(id, fade)
	local s = loops[id]
	loops[id] = nil
	if not s then return end
	if fade and fade > 0 then
		local tw = TweenService:Create(s, TweenInfo.new(fade), { Volume = 0 })
		tw:Play()
		tw.Completed:Connect(function() s:Destroy() end)
	else
		s:Destroy()
	end
end

function Audio.stopAll()
	for id in pairs(loops) do Audio.stop(id) end
end

-- пауза: петли замирают
function Audio.setPaused(p)
	for _, s in pairs(loops) do
		if p then s:Pause() else s:Resume() end
	end
	Audio.muffle(p)
end

-- отдельный звук по ID (двери и т.п.)
function Audio.oneShot(id, at, volume)
	local url = asset(id)
	if url == "" then return nil end
	local s = Instance.new("Sound")
	s.SoundId = url
	s.Volume = volume or 0.6
	s.SoundGroup = sfxGroup
	s.Parent = at or SoundService
	s:Play()
	task.delay(6, function() if s.Parent then s:Destroy() end end)
	return s
end

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Breakfast</string><ProtectedString name="Source"><![CDATA[-- Завтрак: миска, коробка хлопьев «Хрусти-О», молоко и ложка (только у этого игрока)
-- и их анимации: насыпать хлопья, налить молоко, съесть ложку.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Breakfast = {}
Breakfast.__index = Breakfast
local Config, B, Audio, U, Outline, Cine

function Breakfast.init(ctx)
	Config, B, Audio, U, Outline, Cine = ctx.Config, ctx.Build, ctx.Audio, ctx.Util, ctx.Outline, ctx.Cine
end

local function noCollide(m)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
end

-- «оснастка»: запоминаем положение каждой детали относительно опорной точки модели,
-- потом ставим детали точно (без накопления ошибок, как бывает при частом PivotTo)
local function rig(m, pivot)
	local r = { pivot = pivot, parts = {} }
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then table.insert(r.parts, { p = p, off = pivot:ToObjectSpace(p.CFrame) }) end
	end
	return r
end
local function setRig(r, cf)
	r.pivot = cf
	for _, e in ipairs(r.parts) do e.p.CFrame = cf * e.off end
end

-- плавно двигать оснастку за время t
local function moveModel(r, toCF, t, style)
	local v = Instance.new("CFrameValue")
	v.Value = r.pivot
	v.Changed:Connect(function(cf) setRig(r, cf) end)
	local tw = TweenService:Create(v, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Value = toCF })
	tw:Play()
	tw.Completed:Connect(function() v:Destroy() end)
	return tw
end

function Breakfast.new(markers)
	local self = setmetatable({}, Breakfast)
	local m = Instance.new("Model")
	m.Name = "RM_Breakfast"
	self.model = m
	local bowlCF = markers:WaitForChild("BowlSpot").CFrame
	local boxCF = markers:WaitForChild("BoxSpot").CFrame
	local milkCF = markers:WaitForChild("MilkSpot").CFrame
	self.bowlTop = bowlCF.Position + Vector3.new(0, 0.55, 0)

	-- миска
	local bowl = B.model(m, "Bowl")
	B.outline(bowl)
	B.vcyl(bowl, "Outer", 0.5, 1.5, bowlCF * CFrame.new(0, 0.25, 0), "#FFFFFF")
	B.vcyl(bowl, "Foot", 0.1, 0.9, bowlCF * CFrame.new(0, 0.05, 0), "#E8F0FF")
	B.vcyl(bowl, "Band", 0.12, 1.53, bowlCF * CFrame.new(0, 0.36, 0), "#5A86E0")
	self.cereal = B.vcyl(m, "Cereal", 0.02, 1.26, bowlCF * CFrame.new(0, 0.5, 0), "#E3A646")
	self.milk = B.vcyl(m, "Milk", 0.02, 1.3, bowlCF * CFrame.new(0, 0.49, 0), "#FFFFFF")
	self.cereal.Transparency = 1
	self.milk.Transparency = 1
	self.bits = {}
	for i = 1, 9 do
		local a = i / 9 * math.pi * 2
		local r = (i % 3) * 0.17 + 0.12
		local bit = B.ball(m, "Bit", 0.2, bowlCF * CFrame.new(math.cos(a) * r, 0.52, math.sin(a) * r), (i % 2 == 0) and "#D98A2B" or "#F2C14E")
		bit.Transparency = 1
		table.insert(self.bits, { p = bit, off = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r) })
	end
	self.bowlCF = bowlCF

	-- коробка хлопьев (лицом к Морти: Морти сидит с запада)
	local box = B.model(m, "CerealBox")
	B.outline(box)
	local boxBase = boxCF * CFrame.Angles(0, math.rad(90), 0)
	local body = B.part(box, "Body", Vector3.new(1.2, 1.7, 0.45), boxBase * CFrame.new(0, 0.85, 0), "#E2504A")
	local g = B.surface(body, Enum.NormalId.Front, 120)
	B.rect(g, 0, 0, 1, 1, "#E2504A")
	B.rect(g, 0, 0.62, 1, 0.38, "#F2D85A")
	B.text(g, 0.06, 0.06, 0.88, 0.22, "ХРУСТИ-О", "#FFFFFF", Enum.Font.GothamBlack)
	B.circle(g, 0.22, 0.32, 0.56, 0.32, "#FFFFFF")
	B.circle(g, 0.32, 0.37, 0.36, 0.22, "#F2B33C")
	B.text(g, 0.08, 0.72, 0.84, 0.16, "С МЁДОМ!", "#C23B3B", Enum.Font.GothamBlack)
	box.PrimaryPart = body
	self.box = rig(box, body.CFrame)
	self.boxRest = body.CFrame

	-- молоко (пакет с «домиком»)
	local milk = B.model(m, "MilkCarton")
	B.outline(milk)
	local mbase = milkCF * CFrame.Angles(0, math.rad(90), 0)
	local mbody = B.part(milk, "Body", Vector3.new(0.8, 1.3, 0.8), mbase * CFrame.new(0, 0.65, 0), "#FFFFFF")
	B.wedge(milk, "RoofA", Vector3.new(0.8, 0.35, 0.4), mbase * CFrame.new(0, 1.475, -0.2), "#FFFFFF")
	B.wedge(milk, "RoofB", Vector3.new(0.8, 0.35, 0.4), mbase * CFrame.new(0, 1.475, 0.2) * CFrame.Angles(0, math.rad(180), 0), "#FFFFFF")
	B.part(milk, "Fin", Vector3.new(0.8, 0.15, 0.06), mbase * CFrame.new(0, 1.72, 0), "#F3F3F3")
	local mg = B.surface(mbody, Enum.NormalId.Front, 120)
	B.rect(mg, 0, 0.3, 1, 0.4, "#4A90D0")
	B.text(mg, 0.05, 0.36, 0.9, 0.26, "МОЛОКО", "#FFFFFF", Enum.Font.GothamBlack)
	milk.PrimaryPart = mbody
	self.milkBox = rig(milk, mbody.CFrame)
	self.milkBody = mbody
	self.milkRest = mbody.CFrame

	-- ложка (лежит справа от миски)
	local spoon = B.model(m, "Spoon")
	local sbase = bowlCF * CFrame.new(0.15, 0.06, -1.25) * CFrame.Angles(0, math.rad(90), 0)
	local handle = B.part(spoon, "Handle", Vector3.new(0.9, 0.05, 0.1), sbase, "#C9CFD6", Enum.Material.Metal)
	local head = B.part(spoon, "Head", Vector3.new(0.34, 0.08, 0.26), sbase * CFrame.new(0.55, 0.01, 0), "#C9CFD6", Enum.Material.Metal)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = head
	spoon.PrimaryPart = handle
	self.spoon = rig(spoon, sbase)
	self.spoonRest = sbase
	-- рука, держащая ложку (видна только когда ложка поднята)
	self.hand = B.part(m, "Hand", Vector3.new(0.34, 0.28, 0.5), sbase, Config.Colors.Skin, nil, { Transparency = 1 })
	self.scoop = B.ball(m, "Scoop", 0.2, sbase, "#E3A646", nil, { Transparency = 1 })

	noCollide(m)
	m.Parent = workspace
	Outline.add(bowl)
	Outline.add(box)
	Outline.add(milk)
	self.level = 0      -- хлопья 0..1
	self.milkLevel = 0
	return self
end

local function setFill(part, baseCF, level, maxH)
	local h = math.max(0.02, maxH * level)
	part.Size = Vector3.new(h, part.Size.Y, part.Size.Z)
	part.CFrame = baseCF * CFrame.new(0, 0.46 + h / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	part.Transparency = level <= 0.001 and 1 or 0
end

function Breakfast:updateFill()
	setFill(self.cereal, self.bowlCF, self.level, 0.22)
	setFill(self.milk, self.bowlCF, math.min(self.milkLevel, self.level + 0.05), 0.2)
	self.milk.Transparency = self.milkLevel <= 0.001 and 1 or 0.05
	local top = 0.46 + math.max(0.22 * self.level, 0.2 * math.min(self.milkLevel, self.level + 0.05)) + 0.03
	for i, b in ipairs(self.bits) do
		local show = self.level > (i - 1) / #self.bits * 0.9
		b.p.Transparency = show and 0 or 1
		b.p.CFrame = self.bowlCF * CFrame.new(b.off.X, top, b.off.Z)
	end
end

local function animate(self, t, fn)
	local el = 0
	while el < t do
		local dt = RunService.Heartbeat:Wait()
		if not U.paused then
			el = math.min(t, el + dt)
			fn(el / t)
		end
	end
end

-- насыпать хлопья
function Breakfast:pour()
	local above = CFrame.new(self.bowlTop + Vector3.new(0.15, 1.5, 0.7))
	local tilt = CFrame.fromMatrix(above.Position, Vector3.new(1, 0, 0), Vector3.new(0, -0.55, -0.85).Unit)
	moveModel(self.box, above * (self.boxRest - self.boxRest.Position), 0.5)
	U.wait(0.5)
	moveModel(self.box, tilt, 0.45)
	U.wait(0.4)
	Audio.play("Pour", { volume = 0.8 })
	-- падающие хлопья (настоящие детали, падают на миску)
	local bits = {}
	task.spawn(function()
		for i = 1, 22 do
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Ball
			p.Size = Vector3.new(0.18, 0.18, 0.18)
			p.Color = (i % 2 == 0) and Color3.fromRGB(217, 138, 43) or Color3.fromRGB(242, 193, 78)
			p.Material = Enum.Material.SmoothPlastic
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.CFrame = CFrame.new(self.bowlTop + Vector3.new(math.random(-10, 10) / 60, 0.9, math.random(-10, 10) / 60 + 0.15))
			p.Parent = self.model
			p.AssemblyLinearVelocity = Vector3.new(0, -4, -1)
			table.insert(bits, p)
			task.wait(0.06)
		end
	end)
	animate(self, 1.6, function(a)
		self.level = a
		self:updateFill()
	end)
	moveModel(self.box, above * (self.boxRest - self.boxRest.Position), 0.4)
	U.wait(0.4)
	moveModel(self.box, self.boxRest, 0.5)
	task.delay(1.2, function() for _, p in ipairs(bits) do p:Destroy() end end)
	U.wait(0.5)
end

-- налить молоко
function Breakfast:pourMilk()
	local above = CFrame.new(self.bowlTop + Vector3.new(0.1, 1.4, -0.75))
	local tilt = CFrame.fromMatrix(above.Position, Vector3.new(-1, 0, 0), Vector3.new(0, -0.5, 0.87).Unit)
	moveModel(self.milkBox, above * (self.milkRest - self.milkRest.Position), 0.5)
	U.wait(0.5)
	moveModel(self.milkBox, tilt, 0.45)
	U.wait(0.4)
	Audio.play("Milk", { volume = 0.8 })
	local stream = B.part(self.model, "Stream", Vector3.new(0.09, 1, 0.09), CFrame.new(self.bowlTop), "#FFFFFF", nil,
		{ CanCollide = false, CanQuery = false, CastShadow = false })
	animate(self, 1.7, function(a)
		local spout = self.milkBody.CFrame * Vector3.new(0, 0.9, 0)
		local bottom = self.bowlTop + Vector3.new(0, -0.1, 0)
		local len = (spout - bottom).Magnitude
		stream.Size = Vector3.new(0.09, len, 0.09)
		stream.CFrame = CFrame.lookAt((spout + bottom) / 2, bottom) * CFrame.Angles(math.rad(90), 0, 0)
		stream.Transparency = (a < 0.05 or a > 0.95) and 1 or 0.05
		self.milkLevel = a
		self:updateFill()
	end)
	stream:Destroy()
	moveModel(self.milkBox, above * (self.milkRest - self.milkRest.Position), 0.4)
	U.wait(0.4)
	moveModel(self.milkBox, self.milkRest, 0.5)
	U.wait(0.5)
end

-- одна ложка: из миски ко рту и обратно. eaten — сколько осталось (0..1)
function Breakfast:spoonful(remaining)
	local cam = workspace.CurrentCamera
	local spoon = self.spoon
	local scoop = self.scoop
	local hand = self.hand
	local rest = self.spoonRest
	local dip = CFrame.new(self.bowlTop + Vector3.new(0.05, -0.12, 0.35)) * (rest - rest.Position) * CFrame.Angles(0, 0, math.rad(-22))
	Audio.play("Spoon", { volume = 0.5, pitchJitter = 0.1 })
	local function mouth()
		-- ложка смотрит черпаком к лицу (ручка уходит вправо-вниз)
		return cam.CFrame * CFrame.new(0.1, -0.4, -0.95) * CFrame.Angles(0, math.rad(160), math.rad(14))
	end
	local cur = rest
	local function place(cf, showScoop)
		cur = cf
		setRig(spoon, cf)
		hand.CFrame = cf * CFrame.new(-0.42, 0.05, 0.02)
		hand.Transparency = 0
		scoop.CFrame = cf * CFrame.new(0.55, 0.08, 0)
		scoop.Transparency = showScoop and 0 or 1
	end
	-- в миску (зачерпнуть)
	animate(self, 0.35, function(a)
		place(rest:Lerp(dip, U.smooth(a)), false)
	end)
	animate(self, 0.25, function(a)
		place(dip * CFrame.Angles(0, 0, math.rad(30) * a), a > 0.5)
	end)
	local scooped = cur
	-- ко рту
	animate(self, 0.45, function(a)
		place(scooped:Lerp(mouth(), U.smooth(a)), true)
	end)
	scoop.Transparency = 1
	Audio.play("Crunch" .. tostring(math.random(1, 3)), { volume = 0.9, pitchJitter = 0.06 })
	Cine.shake(0.25, 0.5)
	-- уровень в миске уменьшается
	local fromL, fromM = self.level, self.milkLevel
	animate(self, 0.35, function(a)
		self.level = fromL + (remaining - fromL) * a
		self.milkLevel = fromM + (remaining * 0.9 - fromM) * a
		self:updateFill()
		place(mouth(), false)
	end)
	-- обратно
	local m0 = cur
	animate(self, 0.4, function(a)
		place(m0:Lerp(rest, U.smooth(a)), false)
	end)
	hand.Transparency = 1
end

function Breakfast:destroy()
	if self.model then self.model:Destroy() end
end

return Breakfast
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Cine</string><ProtectedString name="Source"><![CDATA[-- Кинокамера для сценок: ключевые кадры (позиция + поворот + поле зрения) с плавными переходами,
-- «дыхание» (лёгкое покачивание), тряска. Время сценок идёт только когда игра не на паузе.
local RunService = game:GetService("RunService")

local Cine = {}
local U, Settings
Cine.active = false

local state = {
	base = CFrame.new(), fov = 70, breathe = 0, breatheTarget = 0,
	shakeT = 0, shakeDur = 0, shakeP = 0, anim = nil, offset = CFrame.new(),
}

local EASE = {}
function EASE.linear(t) return t end
function EASE.inout(t) return t * t * (3 - 2 * t) end
function EASE.inout2(t) return t * t * t * (t * (t * 6 - 15) + 10) end
function EASE.out(t) return 1 - (1 - t) * (1 - t) * (1 - t) end
EASE["in"] = function(t) return t * t * t end
function EASE.back(t) local c1, c3 = 1.3, 2.3; return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2 end

local function evalAnim(a, t)
	local keys = a.keys
	local n = #keys
	if t <= keys[1].t then return keys[1].cf, keys[1].fov end
	if t >= keys[n].t then return keys[n].cf, keys[n].fov end
	local i = 1
	while i < n and keys[i + 1].t < t do i = i + 1 end
	local k0, k1 = keys[i], keys[i + 1]
	local u = (t - k0.t) / math.max(1e-4, k1.t - k0.t)
	local e = (EASE[k1.ease or "inout"] or EASE.inout)(u)
	local rot = k0.cf:Lerp(k1.cf, e)
	local pos
	if a.spline then
		-- позиция — по сплайну через все ключи (глобальный параметр по времени)
		local pts = a.points
		local seg = (i - 1) + e
		pos = U.catmull(pts, seg / (n - 1))
	else
		pos = k0.cf.Position:Lerp(k1.cf.Position, e)
	end
	local fov = k0.fov + (k1.fov - k0.fov) * e
	return CFrame.new(pos) * (rot - rot.Position), fov
end

local function render(dt)
	if not Cine.active then return end
	local cam = workspace.CurrentCamera
	if not U.paused then
		local a = state.anim
		if a then
			a.t = math.min(a.t + dt * (a.speed or 1), a.total)
			local cf, fov = evalAnim(a, a.t)
			state.base = cf
			state.fov = fov
			if a.t >= a.total then
				state.anim = nil
				a.done:Fire()
			end
		end
		if state.shakeT > 0 then state.shakeT = math.max(0, state.shakeT - dt) end
	end
	state.breathe = U.damp(state.breathe, state.breatheTarget, 2, dt)
	local off = CFrame.new()
	local t = os.clock()
	if state.breathe > 0.001 then
		local b = state.breathe
		off = off * CFrame.new(0, math.sin(t * 1.5) * 0.035 * b, 0)
			* CFrame.Angles(math.sin(t * 0.7) * 0.006 * b + math.noise(t * 0.3, 1) * 0.01 * b, math.noise(t * 0.25, 2) * 0.014 * b, math.sin(t * 0.5) * 0.004 * b)
	end
	if state.shakeT > 0 then
		local p = state.shakeP * (state.shakeT / math.max(0.01, state.shakeDur))
		off = off * CFrame.Angles(math.noise(t * 22, 3) * 0.04 * p, math.noise(t * 22, 4) * 0.04 * p, math.noise(t * 18, 5) * 0.03 * p)
	end
	cam.CFrame = state.base * state.offset * off
	cam.FieldOfView = state.fov
end

function Cine.init(ctx)
	U, Settings = ctx.Util, ctx.Settings
	RunService:BindToRenderStep("RM_Cine", Enum.RenderPriority.Camera.Value + 2, render)
end

-- взять камеру под управление сценки
function Cine.take(cf, fov)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	state.base = cf or cam.CFrame
	state.fov = fov or cam.FieldOfView
	state.offset = CFrame.new()
	state.anim = nil
	Cine.active = true
	render(0)
end

-- отдать камеру игроку (обычная камера Roblox)
function Cine.release()
	Cine.active = false
	state.anim = nil
	state.breatheTarget = 0
	state.breathe = 0
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = Settings.get("Fov")
	local plr = game:GetService("Players").LocalPlayer
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end

function Cine.set(cf, fov)
	state.base = cf
	if fov then state.fov = fov end
	state.anim = nil
end

function Cine.get() return state.base, state.fov end

-- сыграть ключевые кадры: keys = { {t = 0, cf = CFrame, fov = 70}, {t = 1.2, cf = ..., ease = "inout"}, ... }
-- opts.spline — позиция по сплайну; opts.wait = false — не ждать конца
function Cine.play(keys, opts)
	opts = opts or {}
	for _, k in ipairs(keys) do k.fov = k.fov or state.fov end
	local a = { keys = keys, t = 0, total = keys[#keys].t, done = U.signal(), spline = opts.spline, speed = opts.speed }
	if opts.spline then
		a.points = {}
		for i, k in ipairs(keys) do a.points[i] = k.cf.Position end
	end
	if state.anim then state.anim.done:Fire() end
	state.anim = a
	if opts.wait ~= false then a.done.Event:Wait() end
	return a
end

-- плавно перевести камеру из текущего положения
function Cine.move(cf, t, ease, fov)
	return Cine.play({ { t = 0, cf = state.base, fov = state.fov }, { t = t, cf = cf, fov = fov or state.fov, ease = ease or "inout" } })
end
function Cine.moveAsync(cf, t, ease, fov)
	return Cine.play({ { t = 0, cf = state.base, fov = state.fov }, { t = t, cf = cf, fov = fov or state.fov, ease = ease or "inout" } }, { wait = false })
end

function Cine.breathe(amount) state.breatheTarget = amount or 0 end

function Cine.shake(power, dur)
	state.shakeP = math.max(state.shakeP * (state.shakeT > 0 and 1 or 0), power)
	state.shakeDur = dur
	state.shakeT = dur
end

-- дополнительный сдвиг поверх ключей (например, наклон головы)
function Cine.setOffset(cf) state.offset = cf or CFrame.new() end

return Cine
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Управление от первого лица: блокировка/разблокировка движения, бег (Shift), покачивание
-- камеры при ходьбе, шаги по полу, клавиша паузы. Обычное движение — стандартное Roblox
-- (WASD / джойстик на телефоне).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Controls = {}
local U, Config, Settings, Audio
local player = Players.LocalPlayer
local char, hum, root
local playerModule
local active = false     -- идёт обычная игра (не меню и не сценка)
local frozen = true
local sprint = false
local bobPhase, bobAmp, lastStep = 0, 0, 0
local fovBoost = 0
Controls.onPause = nil

local function getControls()
	if playerModule == nil then
		local ps = player:FindFirstChild("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		if pm then
			local ok, m = pcall(require, pm)
			playerModule = ok and m or false
		end
	end
	if playerModule then
		local ok, c = pcall(function() return playerModule:GetControls() end)
		if ok then return c end
	end
	return nil
end

local function onCharacter(c)
	char = c
	hum = c:WaitForChild("Humanoid", 10)
	root = c:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then return end
	hum.WalkSpeed = frozen and 0 or Config.WalkSpeed
	-- стандартные шаги глушим, если есть свои (из атласа)
	if Config.Sounds.SfxAtlas ~= "" then
		task.delay(1, function()
			local run = root:FindFirstChild("Running")
			if run and run:IsA("Sound") then run.Volume = 0 end
		end)
	end
end

function Controls.init(ctx)
	U, Config, Settings, Audio = ctx.Util, ctx.Config, ctx.Settings, ctx.Audio
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then task.spawn(onCharacter, player.Character) end

	-- бег
	ContextActionService:BindAction("RM_Sprint", function(_, state)
		sprint = state == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)
	-- пауза: P или M (Esc занят меню Roblox)
	ContextActionService:BindAction("RM_Pause", function(_, state)
		if state == Enum.UserInputState.Begin and Controls.onPause then Controls.onPause() end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.P, Enum.KeyCode.M, Enum.KeyCode.ButtonStart)

	RunService:BindToRenderStep("RM_Controls", Enum.RenderPriority.Character.Value + 1, function(dt)
		if not hum or not root or not root.Parent then return end
		local moving = false
		local speed = 0
		if active and not frozen then
			local v = root.AssemblyLinearVelocity
			speed = Vector3.new(v.X, 0, v.Z).Magnitude
			moving = speed > 1.5 and hum.FloorMaterial ~= Enum.Material.Air
			local want = (sprint and hum.MoveDirection.Magnitude > 0.1) and Config.RunSpeed or Config.WalkSpeed
			hum.WalkSpeed = U.damp(hum.WalkSpeed, want, 8, dt)
		end
		-- покачивание камеры
		local target = (moving and Settings.get("HeadBob")) and math.clamp(speed / Config.WalkSpeed, 0, 1.6) or 0
		bobAmp = U.damp(bobAmp, target, 7, dt)
		if moving then bobPhase = bobPhase + dt * (5.2 + speed * 0.28) end
		local off = Vector3.new(math.sin(bobPhase) * 0.075, -math.abs(math.cos(bobPhase)) * 0.12 + 0.06, 0) * bobAmp
		hum.CameraOffset = active and off or Vector3.new()
		-- шаги: на каждом «ударе» ноги
		if moving then
			local stepIdx = math.floor(bobPhase / math.pi)
			if stepIdx ~= lastStep then
				lastStep = stepIdx
				local mat = hum.FloorMaterial
				local vol = (mat == Enum.Material.Fabric or mat == Enum.Material.Carpet) and 0.22 or 0.42
				Audio.play("Step" .. tostring(math.random(1, 4)), { volume = vol * (sprint and 1.2 or 1), pitchJitter = 0.08 })
			end
		end
		-- чуть шире обзор на бегу
		local cam = workspace.CurrentCamera
		if active and cam.CameraType ~= Enum.CameraType.Scriptable then
			fovBoost = U.damp(fovBoost, (sprint and moving) and 6 or 0, 5, dt)
			cam.FieldOfView = Settings.get("Fov") + fovBoost
		end
	end)
end

-- обычная игра от первого лица (true) или меню/сценка (false)
function Controls.setActive(on)
	active = on
	if on then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
	else
		player.CameraMode = Enum.CameraMode.Classic
	end
end

-- запретить/разрешить движение персонажа
function Controls.freeze(on)
	frozen = on
	local c = getControls()
	if c then
		if on then c:Disable() else c:Enable() end
	end
	if hum then
		hum.WalkSpeed = on and 0 or Config.WalkSpeed
		hum.JumpHeight = on and 0 or 4
	end
end

-- поставить персонажа (корень) в точку; anchored — закрепить (лёжа, сидя)
function Controls.place(cf, anchored)
	if not root then return end
	root.Anchored = anchored == true
	root.AssemblyLinearVelocity = Vector3.new()
	if char then char:PivotTo(cf) else root.CFrame = cf end
end

function Controls.character() return char, hum, root end

-- позиция глаз персонажа относительно корня (для стыковки сценки с обычной камерой)
function Controls.eyeOffset()
	if char and root then
		local head = char:FindFirstChild("Head")
		if head then return head.Position.Y - root.Position.Y + 0.1 end
	end
	return 1.6
end

function Controls.isActive() return active end

local _uis = UserInputService
return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Gui</string><ProtectedString name="Source"><![CDATA[-- Кирпичики интерфейса: экраны, шрифты, рамки, обводки, градиенты, кнопки «как в мультике», логотип.
-- Вёрстка ведётся в пикселях для экрана 1280×720, а UIScale подгоняет её под любой экран (и телефон).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local G = {}
local Audio, Config

-- шрифты (с запасным вариантом, если семейства нет)
local function font(family, weight, fallback)
	local ok, f = pcall(function() return Font.new("rbxasset://fonts/families/" .. family .. ".json", weight) end)
	if ok and f then return f end
	return Font.fromEnum(fallback)
end
G.Fonts = {}

function G.init(ctx)
	Audio, Config = ctx.Audio, ctx.Config
	G.Fonts.Title = font("Nunito", Enum.FontWeight.Heavy, Enum.Font.GothamBlack)
	G.Fonts.Bold = font("Nunito", Enum.FontWeight.ExtraBold, Enum.Font.GothamBold)
	G.Fonts.Body = font("Montserrat", Enum.FontWeight.SemiBold, Enum.Font.GothamMedium)
	G.Fonts.BodyBold = font("Montserrat", Enum.FontWeight.Bold, Enum.Font.GothamBold)
	G.Fonts.Wide = font("Montserrat", Enum.FontWeight.ExtraBold, Enum.Font.GothamBlack)
	G.Fonts.Mono = Font.fromEnum(Enum.Font.Code)
	G.Fonts.Hand = font("AmaticSC", Enum.FontWeight.Bold, Enum.Font.AmaticSC)
end

function G.playerGui() return Players.LocalPlayer:WaitForChild("PlayerGui") end

-- экран: ScreenGui + корневая рамка 1280×720 по центру с масштабом под экран
function G.screen(name, order)
	local sg = Instance.new("ScreenGui")
	sg.Name = name
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = true
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.DisplayOrder = order or 0
	sg.Parent = G.playerGui()
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromOffset(1280, 720)
	root.BackgroundTransparency = 1
	root.Parent = sg
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function fit()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local s = math.min(vs.X / 1280, vs.Y / 720)
		scale.Scale = math.clamp(s, 0.55, 2)
		-- корень растягиваем на весь экран в «дизайнерских» пикселях
		root.Size = UDim2.fromOffset(vs.X / scale.Scale, vs.Y / scale.Scale)
	end
	fit()
	local cam = workspace.CurrentCamera
	if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end
	return sg, root
end

function G.frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	for k, v in pairs(props or {}) do f[k] = v end
	f.Parent = parent
	return f
end

function G.label(parent, text, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text or ""
	l.TextColor3 = Color3.new(1, 1, 1)
	l.FontFace = G.Fonts.Body or Font.fromEnum(Enum.Font.GothamMedium)
	l.TextSize = 22
	for k, v in pairs(props or {}) do l[k] = v end
	l.Parent = parent
	return l
end

function G.corner(obj, r)
	local c = Instance.new("UICorner")
	if typeof(r) == "UDim" then c.CornerRadius = r else c.CornerRadius = UDim.new(0, r or 12) end
	c.Parent = obj
	return c
end

function G.stroke(obj, color, thickness, transparency, mode)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	if mode then s.ApplyStrokeMode = mode end
	s.Parent = obj
	return s
end

-- градиент: colors = { Color3, ... } равномерно; rotation в градусах
function G.gradient(obj, colors, rotation, transparency)
	local g = Instance.new("UIGradient")
	local kps = {}
	for i, c in ipairs(colors) do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c))
	end
	g.Color = ColorSequence.new(kps)
	g.Rotation = rotation or 90
	if transparency then g.Transparency = transparency end
	g.Parent = obj
	return g
end

function G.pad(obj, l, t, r, b)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, l or 0)
	p.PaddingTop = UDim.new(0, t or l or 0)
	p.PaddingRight = UDim.new(0, r or l or 0)
	p.PaddingBottom = UDim.new(0, b or t or l or 0)
	p.Parent = obj
	return p
end

function G.list(obj, dir, pad, halign, valign)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, pad or 8)
	l.HorizontalAlignment = halign or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = valign or Enum.VerticalAlignment.Top
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = obj
	return l
end

function G.tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Логотип «РИК И МОРТИ»: тень + толстая тёмная обводка + салатовая обводка + голубой градиент
function G.logo(parent, text, size, pos)
	local holder = G.frame(parent, { Name = "Logo", BackgroundTransparency = 1, Size = UDim2.fromOffset(1000, size * 1.25),
		AnchorPoint = Vector2.new(0.5, 0), Position = pos or UDim2.new(0.5, 0, 0, 40) })
	local function layer(name, color, strokeColor, strokeT, offset, z)
		local l = G.label(holder, text, { Name = name, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, offset),
			FontFace = G.Fonts.Title, TextSize = size, TextColor3 = color, ZIndex = z })
		if strokeColor then
			local s = G.stroke(l, strokeColor, strokeT)
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		end
		return l
	end
	layer("Shadow", Config.Colors.UiDark, Config.Colors.UiDark, size * 0.13, size * 0.09, 1)
	local outer = layer("Outer", Config.Colors.UiDark, Config.Colors.UiDark, size * 0.16, 0, 2)
	local mid = layer("Mid", Config.Colors.UiLime, Config.Colors.UiLime, size * 0.085, 0, 3)
	local top = layer("Fill", Color3.new(1, 1, 1), nil, 0, 0, 4)
	G.gradient(top, { Color3.fromRGB(150, 245, 255), Config.Colors.UiCyan, Color3.fromRGB(20, 155, 194) }, 90)
	local _1, _2 = outer, mid
	return holder
end

-- Кнопка в стиле меню «Портал»: салатовая (main), светлая (alt) или прозрачная (ghost)
-- opts: size, style, textSize, onClick, layoutOrder
function G.button(parent, text, opts)
	opts = opts or {}
	local style = opts.style or "main"
	local size = opts.size or Vector2.new(330, 64)
	local holder = G.frame(parent, { Name = opts.name or "Button", BackgroundTransparency = 1, Size = UDim2.fromOffset(size.X, size.Y + 6),
		LayoutOrder = opts.layoutOrder or 0 })
	local shadow = G.frame(holder, { Name = "Shadow", Size = UDim2.fromOffset(size.X, size.Y), Position = UDim2.fromOffset(0, 6),
		BackgroundColor3 = Config.Colors.UiDark })
	G.corner(shadow, UDim.new(0.5, 0))
	local b = Instance.new("TextButton")
	b.Name = "Button"
	b.AutoButtonColor = false
	b.Size = UDim2.fromOffset(size.X, size.Y)
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.FontFace = G.Fonts.Title
	b.TextSize = opts.textSize or 30
	b.TextColor3 = style == "alt" and Color3.fromRGB(27, 46, 68) or Color3.fromRGB(16, 58, 16)
	b.Parent = holder
	G.corner(b, UDim.new(0.5, 0))
	local st = G.stroke(b, Config.Colors.UiDark, 4)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	if style == "main" then
		G.gradient(b, { Color3.fromRGB(217, 255, 122), Color3.fromRGB(143, 224, 58), Color3.fromRGB(91, 189, 34) }, 90)
	elseif style == "alt" then
		G.gradient(b, { Color3.fromRGB(240, 247, 255), Color3.fromRGB(185, 210, 238) }, 90)
	else
		b.BackgroundTransparency = 0.55
		b.BackgroundColor3 = Color3.fromRGB(10, 30, 16)
		b.TextColor3 = Color3.new(1, 1, 1)
		shadow.Visible = false
		st.Color = Config.Colors.UiLime
		st.Thickness = 2
	end
	local scale = Instance.new("UIScale")
	scale.Parent = b
	local glow = G.stroke(holder, Config.Colors.UiLime, 0, 1)
	local _ = glow
	local arrow = G.label(holder, "▶", { Name = "Arrow", Size = UDim2.fromOffset(40, size.Y), Position = UDim2.fromOffset(-52, 0),
		FontFace = G.Fonts.Title, TextSize = 30, TextColor3 = Config.Colors.UiLime, TextTransparency = 1 })
	G.stroke(arrow, Config.Colors.UiDark, 3, 1).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local hovered = false
	local function setHover(on)
		if hovered == on then return end
		hovered = on
		G.tween(scale, 0.18, { Scale = on and 1.07 or 1 }, Enum.EasingStyle.Back)
		G.tween(arrow, 0.18, { TextTransparency = on and 0 or 1, Position = UDim2.fromOffset(on and -50 or -62, 0) })
		local s = arrow:FindFirstChildOfClass("UIStroke")
		if s then G.tween(s, 0.18, { Transparency = on and 0 or 1 }) end
		if on and Audio then Audio.play("Hover", { volume = 0.35 }) end
	end
	b.MouseEnter:Connect(function() setHover(true) end)
	b.MouseLeave:Connect(function() setHover(false) end)
	b.SelectionGained:Connect(function() setHover(true) end)
	b.SelectionLost:Connect(function() setHover(false) end)
	b.MouseButton1Down:Connect(function() G.tween(scale, 0.08, { Scale = 0.96 }) end)
	b.MouseButton1Up:Connect(function() G.tween(scale, 0.12, { Scale = hovered and 1.07 or 1 }, Enum.EasingStyle.Back) end)
	b.Activated:Connect(function()
		if Audio then Audio.play("Click", { volume = 0.6 }) end
		if opts.onClick then opts.onClick() end
	end)
	return holder, b
end

-- Затемнённая подложка для окон (Modal — освобождает мышь в режиме от первого лица)
function G.modal(parent, name)
	local dim = Instance.new("TextButton")
	dim.Name = name or "Modal"
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Modal = true
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.fromRGB(4, 10, 8)
	dim.BackgroundTransparency = 0.35
	dim.BorderSizePixel = 0
	dim.Parent = parent
	return dim
end

-- Панель-окно в стиле меню: тёмно-зелёная, салатовая рамка
function G.panel(parent, w, h, title)
	local p = G.frame(parent, { Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(w, h), BackgroundColor3 = Color3.fromRGB(14, 34, 22), BackgroundTransparency = 0.04 })
	G.corner(p, 26)
	G.stroke(p, Config.Colors.UiLime, 3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	G.gradient(p, { Color3.fromRGB(30, 62, 38), Color3.fromRGB(12, 28, 18) }, 90)
	if title then
		G.label(p, title, { Name = "Title", Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 16), FontFace = G.Fonts.Title,
			TextSize = 40, TextColor3 = Config.Colors.UiLime })
	end
	local sc = Instance.new("UIScale")
	sc.Parent = p
	return p, sc
end

-- плавное появление/исчезание всех потомков-надписей (для заставок)
function G.isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

return G
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Игровой интерфейс: задание, субтитры и мысли Морти, подсказки, прицел, кнопка действия,
-- маркер цели, затемнение, кинорамка, веки (моргание), заставка главы, записка, кнопка паузы.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local Hud = {}
local G, U, Config, Settings, Audio
local root, overRoot
local fadeFrame, barTop, barBot, lidTop, lidBot, blur
local objFrame, objText, subFrame, subName, subText, toastFrame, toastText, cross, actionHolder
local subToken = 0

local SUB_SIZES = { 20, 25, 31 }

function Hud.init(ctx)
	G, U, Config, Settings, Audio = ctx.Gui, ctx.Util, ctx.Config, ctx.Settings, ctx.Audio
	local _, r = G.screen("Hud", 5)
	root = r
	local _, o = G.screen("Overlay", 50)
	overRoot = o

	-- задание (слева сверху)
	objFrame = G.frame(root, { Name = "Objective", Position = UDim2.fromOffset(24, 76), Size = UDim2.fromOffset(420, 70),
		BackgroundColor3 = Color3.fromRGB(10, 22, 14), BackgroundTransparency = 0.3, Visible = false })
	G.corner(objFrame, 14)
	G.stroke(objFrame, Config.Colors.UiLime, 1.5, 0.4).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	G.frame(objFrame, { Name = "Accent", Size = UDim2.new(0, 5, 1, -18), Position = UDim2.fromOffset(10, 9), BackgroundColor3 = Config.Colors.UiLime })
	G.label(objFrame, "ЗАДАНИЕ", { Name = "Head", Position = UDim2.fromOffset(26, 8), Size = UDim2.fromOffset(300, 18),
		FontFace = G.Fonts.Wide, TextSize = 14, TextColor3 = Config.Colors.UiLime, TextXAlignment = Enum.TextXAlignment.Left })
	objText = G.label(objFrame, "", { Name = "Text", Position = UDim2.fromOffset(26, 28), Size = UDim2.new(1, -36, 0, 34),
		FontFace = G.Fonts.BodyBold, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
	local check = G.label(objFrame, "✓", { Name = "Check", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(34, 34), FontFace = G.Fonts.Title, TextSize = 30, TextColor3 = Config.Colors.UiLime, TextTransparency = 1 })
	local _c = check

	-- субтитры (снизу)
	subFrame = G.frame(root, { Name = "Subtitle", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -54),
		Size = UDim2.fromOffset(860, 64), BackgroundColor3 = Color3.fromRGB(6, 10, 8), BackgroundTransparency = 1, Visible = false,
		AutomaticSize = Enum.AutomaticSize.Y })
	G.corner(subFrame, 18)
	G.pad(subFrame, 22, 12, 22, 14)
	local sl = G.list(subFrame, Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center)
	local _sl = sl
	subName = G.label(subFrame, "", { Name = "Name", Size = UDim2.new(1, 0, 0, 20), FontFace = G.Fonts.Wide, TextSize = 16,
		TextColor3 = Config.Colors.UiLime, LayoutOrder = 1 })
	subText = G.label(subFrame, "", { Name = "Text", Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = G.Fonts.Body, TextSize = 25, TextWrapped = true, LayoutOrder = 2 })
	G.stroke(subText, Color3.new(0, 0, 0), 1.2, 0.3).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

	-- всплывающая подсказка (сверху по центру)
	toastFrame = G.frame(root, { Name = "Toast", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(560, 44), BackgroundColor3 = Color3.fromRGB(10, 22, 14), BackgroundTransparency = 0.25, Visible = false })
	G.corner(toastFrame, UDim.new(0.5, 0))
	G.stroke(toastFrame, Config.Colors.UiLime, 1.5, 0.3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	toastText = G.label(toastFrame, "", { Size = UDim2.fromScale(1, 1), FontFace = G.Fonts.BodyBold, TextSize = 19 })

	-- прицел
	cross = G.frame(root, { Name = "Cross", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.25, Visible = false })
	G.corner(cross, UDim.new(0.5, 0))
	G.stroke(cross, Color3.new(0, 0, 0), 1, 0.5)

	-- кнопка действия (снизу по центру)
	actionHolder = G.frame(root, { Name = "Action", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -128),
		Size = UDim2.fromOffset(10, 58), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Visible = false })

	-- оверлей: кинорамка, веки, затемнение
	barTop = G.frame(overRoot, { Name = "BarTop", Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0) })
	barBot = G.frame(overRoot, { Name = "BarBot", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0) })
	local function lid(name, top)
		local f = G.frame(overRoot, { Name = name, Size = UDim2.new(1, 0, 0.62, 0), BackgroundColor3 = Color3.new(0, 0, 0),
			AnchorPoint = Vector2.new(0, top and 0 or 1), Position = UDim2.fromScale(0, top and 0 or 1), Visible = false })
		local edge = G.frame(f, { Name = "Edge", Size = UDim2.new(1, 0, 0.35, 0), BackgroundColor3 = Color3.new(0, 0, 0),
			AnchorPoint = Vector2.new(0, top and 0 or 1), Position = UDim2.fromScale(0, top and 1 or 0) })
		local tr = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		G.gradient(edge, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, top and 90 or -90, tr)
		return f
	end
	lidTop = lid("LidTop", true)
	lidBot = lid("LidBot", false)
	fadeFrame = G.frame(overRoot, { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0, ZIndex = 20 })

	blur = Instance.new("BlurEffect")
	blur.Name = "RM_Blur"
	blur.Size = 0
	blur.Parent = game:GetService("Lighting")

	Settings.Changed:Connect(function(k)
		if k == "Subtitles" then subText.TextSize = SUB_SIZES[Settings.get("Subtitles")] or 25 end
	end)
	subText.TextSize = SUB_SIZES[Settings.get("Subtitles")] or 25
end

---------------------------------------------------------------------------
-- затемнение, рамка, веки, размытие
---------------------------------------------------------------------------
function Hud.fade(alpha, t, color)
	if color then fadeFrame.BackgroundColor3 = color end
	local tw = G.tween(fadeFrame, t or 0.6, { BackgroundTransparency = 1 - alpha }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	return tw
end
function Hud.fadeWait(alpha, t, color)
	local tw = Hud.fade(alpha, t, color)
	U.wait(t or 0.6)
	return tw
end
function Hud.fadeSet(alpha, color)
	if color then fadeFrame.BackgroundColor3 = color end
	fadeFrame.BackgroundTransparency = 1 - alpha
end

function Hud.letterbox(on, t)
	local h = on and 74 or 0
	G.tween(barTop, t or 0.8, { Size = UDim2.new(1, 0, 0, h) }, Enum.EasingStyle.Quint)
	G.tween(barBot, t or 0.8, { Size = UDim2.new(1, 0, 0, h) }, Enum.EasingStyle.Quint)
end

-- веки: open 0 — глаза закрыты, 1 — открыты
function Hud.eyes(open, t, style)
	lidTop.Visible = true
	lidBot.Visible = true
	local y = 0.62 * (1 - open)
	local closedH = 0.62
	local _ = closedH
	G.tween(lidTop, t or 0.5, { Position = UDim2.fromScale(0, -0.62 * open) }, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	G.tween(lidBot, t or 0.5, { Position = UDim2.fromScale(0, 1 + 0.62 * open) }, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local _y = y
	if open >= 1 then
		task.delay((t or 0.5) + 0.05, function()
			if lidTop.Position.Y.Scale <= -0.6 then lidTop.Visible = false; lidBot.Visible = false end
		end)
	end
end
function Hud.eyesSet(open)
	lidTop.Visible = open < 1
	lidBot.Visible = open < 1
	lidTop.Position = UDim2.fromScale(0, -0.62 * open)
	lidBot.Position = UDim2.fromScale(0, 1 + 0.62 * open)
end

function Hud.blur(size, t)
	if t and t > 0 then G.tween(blur, t, { Size = size }) else blur.Size = size end
end

---------------------------------------------------------------------------
-- задание
---------------------------------------------------------------------------
local objToken = 0
function Hud.objective(text)
	objToken = objToken + 1
	local tok = objToken
	if not text then
		G.tween(objFrame, 0.3, { Position = UDim2.fromOffset(-460, 76) })
		task.delay(0.35, function() if objToken == tok then objFrame.Visible = false end end)
		return
	end
	objText.Text = text
	objFrame.Check.TextTransparency = 1
	objFrame.Visible = true
	objFrame.Position = UDim2.fromOffset(-460, 76)
	G.tween(objFrame, 0.55, { Position = UDim2.fromOffset(24, 76) }, Enum.EasingStyle.Back)
	Audio.play("Notify", { volume = 0.35 })
end
function Hud.objectiveDone()
	local tok = objToken
	G.tween(objFrame.Check, 0.25, { TextTransparency = 0 })
	Audio.play("AlarmOff", { volume = 0.3, speed = 1.4 })
	task.delay(1.1, function()
		if objToken == tok then Hud.objective(nil) end
	end)
end

---------------------------------------------------------------------------
-- субтитры: Hud.say(имя, текст, {thought = true, hold = секунды})
---------------------------------------------------------------------------
function Hud.say(name, text, opts)
	opts = opts or {}
	subToken = subToken + 1
	local tok = subToken
	subName.Text = name or ""
	subName.Visible = name ~= nil and name ~= ""
	if opts.thought then
		subText.FontFace = Font.new(G.Fonts.Body.Family, Enum.FontWeight.SemiBold, Enum.FontStyle.Italic)
		subText.TextColor3 = Color3.fromRGB(226, 240, 255)
	else
		subText.FontFace = G.Fonts.Body
		subText.TextColor3 = Color3.new(1, 1, 1)
	end
	subText.Text = text
	subText.MaxVisibleGraphemes = 0
	subFrame.Visible = true
	subFrame.BackgroundTransparency = 1
	G.tween(subFrame, 0.25, { BackgroundTransparency = 0.35 })
	if opts.thought then Audio.play("Thought", { volume = 0.25 }) end
	-- печать по буквам
	local n = utf8.len(text) or #text
	task.spawn(function()
		local shown = 0
		while shown < n and subToken == tok do
			shown = shown + 1
			subText.MaxVisibleGraphemes = shown
			task.wait(opts.speed or 0.028)
		end
		if subToken == tok then subText.MaxVisibleGraphemes = -1 end
	end)
	local hold = opts.hold or (1.6 + n * 0.055)
	task.delay(hold, function()
		if subToken == tok then Hud.hideSay() end
	end)
	return hold
end
function Hud.think(text, opts)
	opts = opts or {}
	opts.thought = true
	return Hud.say("МОРТИ (ДУМАЕТ)", text, opts)
end
-- сказать и подождать, пока прочитают
function Hud.thinkWait(text, extra)
	local hold = Hud.think(text)
	U.wait(hold + (extra or 0.2))
end
function Hud.hideSay()
	subToken = subToken + 1
	local tok = subToken
	G.tween(subFrame, 0.25, { BackgroundTransparency = 1 })
	task.delay(0.26, function() if subToken == tok then subFrame.Visible = false end end)
end

---------------------------------------------------------------------------
-- подсказка-тост
---------------------------------------------------------------------------
local toastToken = 0
function Hud.toast(text, t)
	toastToken = toastToken + 1
	local tok = toastToken
	toastText.Text = text
	toastFrame.Visible = true
	toastFrame.BackgroundTransparency = 1
	toastText.TextTransparency = 1
	G.tween(toastFrame, 0.3, { BackgroundTransparency = 0.25 })
	G.tween(toastText, 0.3, { TextTransparency = 0 })
	task.delay(t or 4, function()
		if toastToken ~= tok then return end
		G.tween(toastFrame, 0.4, { BackgroundTransparency = 1 })
		G.tween(toastText, 0.4, { TextTransparency = 1 })
		task.delay(0.45, function() if toastToken == tok then toastFrame.Visible = false end end)
	end)
end

---------------------------------------------------------------------------
-- прицел
---------------------------------------------------------------------------
function Hud.crosshair(on) cross.Visible = on end
function Hud.crossFocus(on)
	G.tween(cross, 0.15, { Size = on and UDim2.fromOffset(14, 14) or UDim2.fromOffset(6, 6),
		BackgroundTransparency = on and 0.6 or 0.25 })
end

---------------------------------------------------------------------------
-- кнопка действия: ждёт нажатия клавиши (или тапа). keys — { Enum.KeyCode... }
-- Возвращает объект с :wait() и :cancel()
---------------------------------------------------------------------------
local actionId = 0
function Hud.action(text, keys, opts)
	opts = opts or {}
	actionId = actionId + 1
	local id = "RM_Action" .. actionId
	for _, c in ipairs(actionHolder:GetChildren()) do c:Destroy() end
	local pressed = U.signal()
	local done = false
	local btn = Instance.new("TextButton")
	btn.Name = "Btn"
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.Size = UDim2.fromOffset(10, 58)
	btn.AutomaticSize = Enum.AutomaticSize.X
	btn.BackgroundColor3 = Color3.fromRGB(10, 26, 14)
	btn.BackgroundTransparency = 0.15
	btn.Parent = actionHolder
	G.corner(btn, UDim.new(0.5, 0))
	G.stroke(btn, Config.Colors.UiLime, 2.5).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	G.pad(btn, 10, 0, 26, 0)
	G.list(btn, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local keyName = opts.keyLabel or (keys[1] and keys[1].Name) or "E"
	if keyName == "Space" then keyName = "ПРОБЕЛ" end
	if G.isTouch() then keyName = "ТАП" end
	local cap = G.frame(btn, { Name = "Key", Size = UDim2.fromOffset(10, 40), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Config.Colors.UiLime, LayoutOrder = 1 })
	G.corner(cap, 10)
	G.pad(cap, 12, 0, 12, 0)
	G.label(cap, keyName, { Size = UDim2.fromOffset(10, 40), AutomaticSize = Enum.AutomaticSize.X, FontFace = G.Fonts.Title,
		TextSize = 22, TextColor3 = Config.Colors.UiDark })
	G.label(btn, text, { Name = "Text", Size = UDim2.fromOffset(10, 58), AutomaticSize = Enum.AutomaticSize.X, FontFace = G.Fonts.Bold,
		TextSize = 26, LayoutOrder = 2 })
	actionHolder.Visible = true
	local scale = Instance.new("UIScale")
	scale.Parent = actionHolder
	scale.Scale = 0.6
	G.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- лёгкая пульсация
	local pulse = task.spawn(function()
		while not done do
			G.tween(scale, 0.7, { Scale = 1.04 }, Enum.EasingStyle.Sine)
			task.wait(0.7)
			if done then break end
			G.tween(scale, 0.7, { Scale = 1 }, Enum.EasingStyle.Sine)
			task.wait(0.7)
		end
	end)
	local _p = pulse
	local function fire()
		if done or U.paused then return end
		pressed:Fire()
	end
	btn.Activated:Connect(fire)
	ContextActionService:BindAction(id, function(_, state)
		if state == Enum.UserInputState.Begin then fire() end
		return Enum.ContextActionResult.Sink
	end, false, unpack(keys))
	local h = {}
	function h:cancel()
		if done then return end
		done = true
		ContextActionService:UnbindAction(id)
		G.tween(scale, 0.15, { Scale = 0.7 })
		task.delay(0.16, function()
			if btn.Parent then btn:Destroy() end
			if #actionHolder:GetChildren() <= 1 then actionHolder.Visible = false end
		end)
	end
	function h:wait()
		pressed.Event:Wait()
		Audio.play("Click", { volume = 0.4 })
		return true
	end
	-- ждать одно нажатие и убрать кнопку
	function h:once()
		self:wait()
		self:cancel()
	end
	h.pressed = pressed
	return h
end

---------------------------------------------------------------------------
-- маркер цели (ромб над предметом, виден сквозь стены)
---------------------------------------------------------------------------
local marker
function Hud.marker(part)
	if marker then marker:Destroy(); marker = nil end
	if not part then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "RM_Marker"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(80, 70)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.LightInfluence = 0
	bb.Adornee = part
	bb.Parent = G.playerGui()
	local d = G.frame(bb, { Name = "Diamond", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(22, 22),
		Rotation = 45, BackgroundColor3 = Config.Colors.UiLime })
	G.stroke(d, Config.Colors.UiDark, 2.5)
	local dist = G.label(bb, "", { Name = "Dist", Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 24), FontFace = G.Fonts.BodyBold,
		TextSize = 18 })
	G.stroke(dist, Color3.new(0, 0, 0), 1.5).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	marker = bb
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not bb.Parent then conn:Disconnect() return end
		local cam = workspace.CurrentCamera
		local m = (cam.CFrame.Position - part.Position).Magnitude / 3.5
		dist.Text = string.format("%d м", math.floor(m + 0.5))
		local a = math.clamp((m - 1.5) / 3, 0, 1)
		d.BackgroundTransparency = 1 - a
		dist.TextTransparency = 1 - a
	end)
end

---------------------------------------------------------------------------
-- заставка главы на чёрном фоне
---------------------------------------------------------------------------
function Hud.chapterCard(title, sub)
	local f = G.frame(overRoot, { Name = "Card", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 30 })
	local t = G.label(f, title, { Size = UDim2.new(1, 0, 0, 80), Position = UDim2.new(0, 0, 0.5, -70), FontFace = G.Fonts.Title,
		TextSize = 64, TextColor3 = Config.Colors.UiLime, TextTransparency = 1, ZIndex = 31 })
	local s = G.label(f, sub or "", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0.5, 20), FontFace = G.Fonts.Wide,
		TextSize = 26, TextTransparency = 1, ZIndex = 31 })
	G.tween(t, 1.0, { TextTransparency = 0 })
	U.wait(0.6)
	G.tween(s, 1.0, { TextTransparency = 0 })
	U.wait(2.4)
	G.tween(t, 0.8, { TextTransparency = 1 })
	G.tween(s, 0.8, { TextTransparency = 1 })
	U.wait(0.9)
	f:Destroy()
end

---------------------------------------------------------------------------
-- записка от мамы
---------------------------------------------------------------------------
function Hud.note(text)
	local sg, r = G.screen("Note", 40)
	local dim = G.modal(r, "Dim")
	dim.BackgroundTransparency = 1
	G.tween(dim, 0.3, { BackgroundTransparency = 0.45 })
	local paper = G.frame(r, { Name = "Paper", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(520, 440),
		BackgroundColor3 = Color3.fromRGB(255, 247, 194), Rotation = -2 })
	G.corner(paper, 6)
	G.stroke(paper, Color3.fromRGB(190, 170, 110), 2)
	for i = 0, 9 do
		G.frame(paper, { Size = UDim2.new(1, -60, 0, 2), Position = UDim2.fromOffset(30, 96 + i * 32), BackgroundColor3 = Color3.fromRGB(170, 200, 230), BackgroundTransparency = 0.3 })
	end
	G.label(paper, text, { Size = UDim2.new(1, -60, 1, -110), Position = UDim2.fromOffset(30, 54), FontFace = G.Fonts.Hand, TextSize = 40,
		TextColor3 = Color3.fromRGB(40, 70, 150), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.05 })
	G.frame(paper, { Name = "Tape", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(120, 34),
		BackgroundColor3 = Color3.fromRGB(240, 240, 220), BackgroundTransparency = 0.25, Rotation = 4 })
	G.tween(paper, 0.4, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	Audio.play("Paper", { volume = 0.6 })
	local closed = U.signal()
	local holder = G.button(r, "Понятно", { size = Vector2.new(240, 56), textSize = 26, onClick = function() closed:Fire() end })
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0.5, 250)
	local kc = "RM_NoteClose"
	ContextActionService:BindAction(kc, function(_, st)
		if st == Enum.UserInputState.Begin then closed:Fire() end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.E, Enum.KeyCode.Space, Enum.KeyCode.Return)
	closed.Event:Wait()
	ContextActionService:UnbindAction(kc)
	Audio.play("Paper", { volume = 0.4, speed = 1.2 })
	sg:Destroy()
end

---------------------------------------------------------------------------
-- кнопка паузы (справа сверху)
---------------------------------------------------------------------------
function Hud.pauseButton(onClick)
	local b = Instance.new("TextButton")
	b.Name = "PauseBtn"
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -20, 0, 16)
	b.Size = UDim2.fromOffset(52, 44)
	b.BackgroundColor3 = Color3.fromRGB(10, 26, 14)
	b.BackgroundTransparency = 0.25
	b.Text = "II"
	b.FontFace = G.Fonts.Title
	b.TextSize = 24
	b.TextColor3 = Config.Colors.UiLime
	b.Visible = false
	b.Parent = root
	G.corner(b, 12)
	G.stroke(b, Config.Colors.UiLime, 1.5, 0.3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	b.Activated:Connect(onClick)
	Hud.pauseBtn = b
	return b
end

function Hud.gameplay(on)
	Hud.crosshair(on)
	if Hud.pauseBtn then Hud.pauseBtn.Visible = on end
end

function Hud.root() return root end
function Hud.overlay() return overRoot end

local _ui, _pl = UserInputService, Players
return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[-- Главное меню (вариант «Портал»), окно настроек, «Об игре» и меню паузы.
-- Фон меню — ночная комната Морти: Морти спит, посреди комнаты крутится портал.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Menu = {}
local ctx
local G, U, Config, Settings, Audio, Hud, Cine, World, Portal, B
local sg, root
local scene -- { portal, sleeper, conn }

---------------------------------------------------------------------------
-- Сцена меню: спящий Морти и портал
---------------------------------------------------------------------------
local function markers() return workspace.House:WaitForChild("Markers") end

local function buildSleeper(parent)
	local m = Instance.new("Model")
	m.Name = "RM_SleepingMorty"
	local head = markers():WaitForChild("BedHead").CFrame
	local P = B.kit(m, head)
	-- голова на подушке, повёрнута к стене, торчат волосы
	P.ball("Head", 1.25, 0, -0.1, 0.1, Config.Colors.Skin)
	P.ball("Hair", 1.35, -0.12, 0.08, 0.3, Config.Colors.MortyHair)
	P.ball("Tuft", 0.55, 0.15, 0.55, 0.45, Config.Colors.MortyHair)
	-- одеяло, под которым угадывается тело
	local function lump(name, size, x, y, z)
		local p = P.ball(name, 1, x, y, z, "#4A7AE0", Enum.Material.Fabric)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = size
		mesh.Parent = p
		return p
	end
	lump("Shoulders", Vector3.new(2.6, 0.9, 1.6), 0.1, -0.55, -1.2)
	lump("Body", Vector3.new(2.4, 0.8, 3.2), 0.2, -0.6, -2.9)
	lump("Knees", Vector3.new(1.3, 0.9, 1.4), 0.4, -0.45, -4.4)
	for _, p in ipairs(m:GetChildren()) do
		if p:IsA("BasePart") then p.CanCollide = false; p.CanQuery = false end
	end
	B.outline(m)
	m.Parent = parent
	return m
end

function Menu.sceneStart()
	if scene then return end
	scene = {}
	World.apply("night", 0)
	local mk = markers()
	local camCF = mk:WaitForChild("MenuCam").CFrame
	local pcf = mk:WaitForChild("PortalSpot").CFrame
	scene.sleeper = buildSleeper(workspace)
	ctx.Outline.add(scene.sleeper)
	scene.portal = Portal.new(pcf, 7.2, workspace)
	scene.portal:open(1.2)
	Cine.take(camCF, 62)
	Cine.breathe(0.6)
	-- лёгкий «дрейф» камеры
	local t0 = os.clock()
	scene.conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		Cine.setOffset(CFrame.new(math.sin(t * 0.21) * 0.35, math.sin(t * 0.17) * 0.18, 0) * CFrame.Angles(0, math.sin(t * 0.13) * 0.02, 0))
	end)
	Audio.music("MusicMenu", 2, 0.5)
end

function Menu.sceneStop()
	if not scene then return end
	if scene.conn then scene.conn:Disconnect() end
	Cine.setOffset(nil)
	if scene.portal then scene.portal:destroy() end
	if scene.sleeper then scene.sleeper:Destroy() end
	scene = nil
end

-- переход «в портал»: камера влетает в вихрь, вспышка
function Menu.enterPortal()
	if not scene then return end
	local p = scene.portal
	scene.conn:Disconnect()
	scene.conn = nil
	Cine.setOffset(nil)
	Audio.play("Whoosh", { volume = 0.9, speed = 0.85 })
	p:scaleTo(1.8, 1.4, Enum.EasingStyle.Quad)
	local target = p.cf * CFrame.new(0, 0, -0.5)
	local look = CFrame.lookAt(target.Position + p.cf.LookVector * 0.5, p.cf.Position)
	Cine.moveAsync(look, 1.6, "in", 95)
	U.wait(1.1)
	Hud.fadeWait(1, 0.5, Color3.fromRGB(200, 255, 150))
	Audio.stopMusic(1)
	Hud.fade(1, 0.6, Color3.new(0, 0, 0))
	U.wait(0.6)
end

---------------------------------------------------------------------------
-- Главное меню
---------------------------------------------------------------------------
local mainFrame, buttons
function Menu.show(onPlay)
	if mainFrame then mainFrame:Destroy() end
	mainFrame = G.frame(root, { Name = "Main", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	-- невидимая «модальная» кнопка: освобождает курсор, даже если камера до этого была от первого лица
	local free = G.modal(mainFrame, "FreeMouse")
	free.BackgroundTransparency = 1
	free.ZIndex = 0
	-- виньетка по краям, чтобы текст читался
	local vig = G.frame(mainFrame, { Name = "Vignette", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.2 })
	G.gradient(vig, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 90,
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(0.35, 0.9), NumberSequenceKeypoint.new(0.65, 0.9), NumberSequenceKeypoint.new(1, 0.2) }))
	local logo = G.logo(mainFrame, U.upper("Рик и Морти"), 104, UDim2.new(0.5, 0, 0, 34))
	local sub = G.label(mainFrame, Config.Chapter, { Name = "Chapter", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176),
		Size = UDim2.fromOffset(600, 34), FontFace = G.Fonts.Wide, TextSize = 24, TextColor3 = Color3.fromRGB(234, 255, 200) })
	G.stroke(sub, Config.Colors.UiDark, 3).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local list = G.frame(mainFrame, { Name = "Buttons", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -88),
		Size = UDim2.fromOffset(420, 260), BackgroundTransparency = 1 })
	G.list(list, Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	buttons = {}
	local busy = false
	local function play()
		if busy then return end
		busy = true
		G.tween(mainFrame, 0.4, { Position = UDim2.fromOffset(0, 30) })
		for _, d in ipairs(mainFrame:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then G.tween(d, 0.35, { TextTransparency = 1 }) end
			if d:IsA("GuiObject") then G.tween(d, 0.35, { BackgroundTransparency = 1 }) end
			if d:IsA("UIStroke") then G.tween(d, 0.35, { Transparency = 1 }) end
		end
		task.delay(0.4, function()
			mainFrame.Visible = false
			onPlay()
		end)
	end
	local _, b1 = G.button(list, "ИГРАТЬ", { name = "Play", layoutOrder = 1, onClick = play })
	local _, b2 = G.button(list, "НАСТРОЙКИ", { name = "Settings", layoutOrder = 2, onClick = function() Menu.settings() end })
	local _, b3 = G.button(list, "ОБ ИГРЕ", { name = "About", layoutOrder = 3, style = "alt", onClick = function() Menu.about() end })
	buttons = { b1, b2, b3 }
	G.label(mainFrame, "фан-игра для друзей · сериал «Рик и Морти» принадлежит Adult Swim · v" .. Config.Version,
		{ Name = "Footer", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(900, 22),
			FontFace = G.Fonts.Body, TextSize = 15, TextColor3 = Color3.fromRGB(200, 220, 200), TextTransparency = 0.25 })
	-- появление
	logo.Position = UDim2.new(0.5, 0, 0, -160)
	G.tween(logo, 0.9, { Position = UDim2.new(0.5, 0, 0, 34) }, Enum.EasingStyle.Back)
	for i, b in ipairs(buttons) do
		local holder = b.Parent
		local sc = Instance.new("UIScale")
		sc.Scale = 0
		sc.Parent = holder
		task.delay(0.35 + i * 0.12, function() G.tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
	end
	-- «дыхание» логотипа
	task.spawn(function()
		local s = Instance.new("UIScale")
		s.Parent = logo
		while logo.Parent do
			G.tween(s, 1.6, { Scale = 1.025 }, Enum.EasingStyle.Sine)
			task.wait(1.6)
			if not logo.Parent then break end
			G.tween(s, 1.6, { Scale = 1 }, Enum.EasingStyle.Sine)
			task.wait(1.6)
		end
	end)
	-- Enter — играть
	ContextActionService:BindAction("RM_MenuEnter", function(_, st)
		if st == Enum.UserInputState.Begin and mainFrame.Visible and not Menu.modalOpen then play() end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Return, Enum.KeyCode.ButtonA)
	sg.Enabled = true
end

function Menu.hide()
	ContextActionService:UnbindAction("RM_MenuEnter")
	if mainFrame then mainFrame:Destroy(); mainFrame = nil end
end

---------------------------------------------------------------------------
-- Настройки (общие для меню и паузы)
---------------------------------------------------------------------------
Menu.modalOpen = false

local function slider(parent, order, label, key, min, max, fmt)
	local row = G.frame(parent, { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = order })
	G.label(row, label, { Size = UDim2.new(0.42, 0, 1, 0), FontFace = G.Fonts.BodyBold, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Left })
	local track = G.frame(row, { Name = "Track", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.45, 0, 0.5, 0), Size = UDim2.new(0.4, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(6, 18, 10) })
	G.corner(track, UDim.new(0.5, 0))
	G.stroke(track, Config.Colors.UiLime, 1, 0.5)
	local fill = G.frame(track, { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Config.Colors.UiLime })
	G.corner(fill, UDim.new(0.5, 0))
	local knob = G.frame(track, { Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.fromRGB(240, 255, 210) })
	G.corner(knob, UDim.new(0.5, 0))
	G.stroke(knob, Config.Colors.UiDark, 3)
	local value = G.label(row, "", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.13, 0, 1, 0),
		FontFace = G.Fonts.BodyBold, TextSize = 20, TextColor3 = Config.Colors.UiLime, TextXAlignment = Enum.TextXAlignment.Right })
	local function show(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		value.Text = fmt(v)
	end
	show(Settings.get(key))
	local hit = Instance.new("TextButton")
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.new(1, 20, 0, 40)
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Parent = track
	local dragging = false
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		local v = min + (max - min) * a
		if max - min > 5 then v = math.floor(v + 0.5) else v = math.floor(v * 20 + 0.5) / 20 end
		Settings.set(key, v)
		show(v)
	end
	hit.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(io.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
			setFromX(io.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	return row, show
end

local function choice(parent, order, label, key, options)
	local row = G.frame(parent, { Name = key, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = order })
	G.label(row, label, { Size = UDim2.new(0.42, 0, 1, 0), FontFace = G.Fonts.BodyBold, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Left })
	local box = G.frame(row, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.55, 0, 0, 40), BackgroundTransparency = 1 })
	G.list(box, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local btns = {}
	local function refresh()
		local cur = Settings.get(key)
		for _, b in ipairs(btns) do
			local on = b.value == cur
			b.btn.BackgroundColor3 = on and Config.Colors.UiLime or Color3.fromRGB(6, 18, 10)
			b.btn.TextColor3 = on and Config.Colors.UiDark or Color3.fromRGB(220, 235, 220)
		end
	end
	for i, o in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Name = "Opt" .. i
		b.AutoButtonColor = false
		b.Size = UDim2.fromOffset(o.w or 110, 38)
		b.Text = o.text
		b.FontFace = G.Fonts.Bold
		b.TextSize = 19
		b.LayoutOrder = i
		b.Parent = box
		G.corner(b, 10)
		G.stroke(b, Config.Colors.UiLime, 1.5, 0.3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		b.Activated:Connect(function()
			Audio.play("Click", { volume = 0.5 })
			Settings.set(key, o.value)
			refresh()
		end)
		table.insert(btns, { btn = b, value = o.value })
	end
	refresh()
	return row, refresh
end

function Menu.settings(onClose)
	if Menu.modalOpen then return end
	Menu.modalOpen = true
	local layer = G.frame(root, { Name = "SettingsLayer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5 })
	local dim = G.modal(layer, "Dim")
	dim.BackgroundTransparency = 1
	G.tween(dim, 0.25, { BackgroundTransparency = 0.4 })
	local panel, sc = G.panel(layer, 760, 640, "НАСТРОЙКИ")
	sc.Scale = 0.85
	G.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(44, 88)
	body.Size = UDim2.new(1, -88, 1, -184)
	body.CanvasSize = UDim2.fromOffset(0, 0)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollBarThickness = 6
	body.ScrollBarImageColor3 = Config.Colors.UiLime
	body.Parent = panel
	G.list(body, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	local pct = function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end
	local refreshers = {}
	local _, r1 = slider(body, 1, "Музыка", "Music", 0, 1, pct)
	local _, r2 = slider(body, 2, "Звуки", "Sfx", 0, 1, pct)
	local _, r3 = slider(body, 3, "Чувствительность мыши", "Sensitivity", 0.2, 2, function(v) return string.format("%.2f", v) end)
	local _, r4 = slider(body, 4, "Поле зрения", "Fov", 60, 95, function(v) return tostring(math.floor(v)) .. "°" end)
	local onoff = { { text = "Вкл", value = true, w = 90 }, { text = "Выкл", value = false, w = 90 } }
	local _, r5 = choice(body, 5, "Покачивание камеры", "HeadBob", onoff)
	local _, r6 = choice(body, 6, "Контуры предметов", "Outlines", onoff)
	local _, r7 = choice(body, 7, "Эффекты", "Effects", { { text = "Низко", value = 1, w = 100 }, { text = "Средне", value = 2, w = 108 }, { text = "Высоко", value = 3, w = 108 } })
	local _, r8 = choice(body, 8, "Размер субтитров", "Subtitles", { { text = "S", value = 1, w = 60 }, { text = "M", value = 2, w = 60 }, { text = "L", value = 3, w = 60 } })
	local _, r9 = choice(body, 9, "Подсказки и маркер цели", "Hints", onoff)
	refreshers = { function() r1(Settings.get("Music")) end, function() r2(Settings.get("Sfx")) end, function() r3(Settings.get("Sensitivity")) end,
		function() r4(Settings.get("Fov")) end, r5, r6, r7, r8, r9 }
	local foot = G.frame(panel, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -22), Size = UDim2.fromOffset(600, 66), BackgroundTransparency = 1 })
	G.list(foot, Enum.FillDirection.Horizontal, 18, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local closing = false
	local function close()
		if closing then return end
		closing = true
		G.tween(sc, 0.18, { Scale = 0.9 })
		G.tween(dim, 0.18, { BackgroundTransparency = 1 })
		task.delay(0.2, function()
			layer:Destroy()
			Menu.modalOpen = false
			if onClose then onClose() end
		end)
	end
	G.button(foot, "СБРОСИТЬ", { size = Vector2.new(230, 56), textSize = 24, style = "alt", layoutOrder = 1, onClick = function()
		Settings.reset()
		for _, f in ipairs(refreshers) do f() end
	end })
	G.button(foot, "ГОТОВО", { name = "Done", size = Vector2.new(230, 56), textSize = 24, layoutOrder = 2, onClick = close })
	Menu.closeSettings = close
end

function Menu.about()
	if Menu.modalOpen then return end
	Menu.modalOpen = true
	local layer = G.frame(root, { Name = "AboutLayer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5 })
	local dim = G.modal(layer, "Dim")
	dim.BackgroundTransparency = 0.4
	local panel, sc = G.panel(layer, 760, 560, "ОБ ИГРЕ")
	sc.Scale = 0.85
	G.tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local text = table.concat({
		"Фан-игра по мультсериалу «Рик и Морти» — для нас с друзьями.",
		"Глава 1 «Сбой»: обычное утро Морти. Или не совсем обычное…",
		"",
		"УПРАВЛЕНИЕ",
		"WASD — ходить  ·  Shift — бежать  ·  мышь — смотреть",
		"E — действие  ·  F — телефон  ·  P — пауза",
		"На телефоне: джойстик слева, нажимай на подсказки и кнопки.",
		"",
		"Сериал и персонажи принадлежат Adult Swim. Игра не официальная.",
	}, "\n")
	G.label(panel, text, { Position = UDim2.fromOffset(50, 92), Size = UDim2.new(1, -100, 1, -190), FontFace = G.Fonts.Body, TextSize = 21,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.2 })
	local holder = G.button(panel, "ЗАКРЫТЬ", { size = Vector2.new(240, 56), textSize = 24, onClick = function()
		layer:Destroy()
		Menu.modalOpen = false
	end })
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0.5, 0, 1, -22)
end

---------------------------------------------------------------------------
-- Пауза
---------------------------------------------------------------------------
local pauseLayer
function Menu.pause(onResume, onMainMenu)
	if pauseLayer then return end
	pauseLayer = G.frame(root, { Name = "PauseLayer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 4 })
	local dim = G.modal(pauseLayer, "Dim")
	dim.BackgroundTransparency = 1
	G.tween(dim, 0.25, { BackgroundTransparency = 0.35 })
	local title = G.logo(pauseLayer, "ПАУЗА", 80, UDim2.new(0.5, 0, 0, 80))
	local _ = title
	local list = G.frame(pauseLayer, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.fromOffset(420, 260), BackgroundTransparency = 1 })
	G.list(list, Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	G.button(list, "ПРОДОЛЖИТЬ", { name = "Resume", layoutOrder = 1, onClick = function() Menu.unpause(); onResume() end })
	G.button(list, "НАСТРОЙКИ", { name = "Settings", layoutOrder = 2, onClick = function() Menu.settings() end })
	G.button(list, "ГЛАВНОЕ МЕНЮ", { name = "MainMenu", layoutOrder = 3, style = "alt", onClick = function() Menu.unpause(); onMainMenu() end })
	sg.Enabled = true
end
function Menu.unpause()
	if pauseLayer then pauseLayer:Destroy(); pauseLayer = nil end
	if Menu.modalOpen and Menu.closeSettings then Menu.closeSettings() end
end
function Menu.isPaused() return pauseLayer ~= nil end

function Menu.init(c)
	ctx = c
	G, U, Config, Settings, Audio, Hud, Cine, World, Portal, B = c.Gui, c.Util, c.Config, c.Settings, c.Audio, c.Hud, c.Cine, c.World, c.Portal, c.Build
	local s, r = G.screen("Menu", 20)
	sg, root = s, r
end

local _p = Players
return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Outline</string><ProtectedString name="Source"><![CDATA[-- Чёрные контуры «как в мультике». Roblox рисует не больше 31 Highlight одновременно,
-- поэтому несколько раз в секунду выбираем ближайшие к камере предметы (Model с атрибутом
-- Outline) и вешаем на них контуры из общего пула.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Outline = {}
local Config, Settings
local POOL = 27
local pool = {}
local candidates = {}
local enabled = true
local acc = 0
local extra = {} -- локальные предметы сюжета (миска, телефон и т.п.)

local function centerOf(m)
	local ok, cf = pcall(function() return m:GetPivot() end)
	if ok then return cf.Position end
	return nil
end

local function collect()
	candidates = {}
	local house = workspace:FindFirstChild("House")
	if house then
		for _, d in ipairs(house:GetDescendants()) do
			if d:IsA("Model") and d:GetAttribute("Outline") then
				local c = centerOf(d)
				if c then table.insert(candidates, { model = d, pos = c }) end
			end
		end
	end
end

function Outline.init(ctx)
	Config, Settings = ctx.Config, ctx.Settings
	local folder = Instance.new("Folder")
	folder.Name = "RM_Outlines"
	folder.Parent = workspace.CurrentCamera
	for i = 1, POOL do
		local h = Instance.new("Highlight")
		h.Name = "Outline" .. i
		h.FillTransparency = 1
		h.OutlineTransparency = 0.05
		h.OutlineColor = Config.Colors.Outline
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Enabled = false
		h.Parent = folder
		pool[i] = h
	end
	collect()
	enabled = Settings.get("Outlines")
	Settings.Changed:Connect(function(k, v)
		if k == "Outlines" then
			enabled = v
			if not v then for _, h in ipairs(pool) do h.Enabled = false; h.Adornee = nil end end
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 or not enabled then return end
		acc = 0
		local cam = workspace.CurrentCamera
		local cp, look = cam.CFrame.Position, cam.CFrame.LookVector
		local list = {}
		local function consider(m, pos)
			local d = pos - cp
			local dist = d.Magnitude
			if dist > 70 then return end
			local facing = dist < 6 or (d / dist):Dot(look) > 0.15
			if not facing then return end
			table.insert(list, { m = m, s = dist })
		end
		for _, c in ipairs(candidates) do
			if c.model.Parent then consider(c.model, c.pos) end
		end
		for m in pairs(extra) do
			if m.Parent then
				local p = centerOf(m)
				if p then consider(m, p) end
			else
				extra[m] = nil
			end
		end
		table.sort(list, function(a, b) return a.s < b.s end)
		for i, h in ipairs(pool) do
			local item = list[i]
			if item then
				if h.Adornee ~= item.m then h.Adornee = item.m end
				h.Enabled = true
			else
				h.Enabled = false
				h.Adornee = nil
			end
		end
	end)
end

-- добавить локальный предмет (только у этого игрока)
function Outline.add(model) extra[model] = true end
function Outline.remove(model) extra[model] = nil end
function Outline.refresh() collect() end

local _cs = CollectionService
return Outline
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Phone</string><ProtectedString name="Source"><![CDATA[-- Телефон Морти: 3D-телефон в руке перед камерой и его экран (SurfaceGui): блокировка,
-- рабочий стол, «ТикТок» с роликами, лаги и глитч (сбой). Всё нарисовано рамками GUI.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Phone = {}
Phone.__index = Phone
local Config, B, Audio, G, U, Outline

local W, H = 240, 500 -- холст экрана в пикселях

function Phone.init(ctx)
	Config, B, Audio, G, U, Outline = ctx.Config, ctx.Build, ctx.Audio, ctx.Gui, ctx.Util, ctx.Outline
end

local function frame(parent, x, y, w, h, color, props)
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = B.color(color or "#000000")
	f.BorderSizePixel = 0
	if props then for k, v in pairs(props) do f[k] = v end end
	f.Parent = parent
	return f
end
local function text(parent, x, y, w, h, str, size, color, fnt, props)
	local l = Instance.new("TextLabel")
	l.Position = UDim2.fromOffset(x, y)
	l.Size = UDim2.fromOffset(w, h)
	l.BackgroundTransparency = 1
	l.Text = str
	l.TextSize = size
	l.TextColor3 = B.color(color or "#ffffff")
	l.FontFace = fnt or G.Fonts.BodyBold
	l.TextXAlignment = Enum.TextXAlignment.Left
	if props then for k, v in pairs(props) do l[k] = v end end
	l.Parent = parent
	return l
end
local function round(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 8)
	c.Parent = obj
	return c
end

---------------------------------------------------------------------------
-- модель телефона и руки
---------------------------------------------------------------------------
function Phone.new()
	local self = setmetatable({}, Phone)
	local m = Instance.new("Model")
	m.Name = "RM_Phone"
	self.model = m
	local function p(name, size, color, mat, props)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = B.color(color)
		part.Material = mat or Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		if props then for k, v in pairs(props) do part[k] = v end end
		part.Parent = m
		return part
	end
	-- корпус в локальных координатах телефона (центр экрана — 0,0,0; экран смотрит в −Z)
	self.parts = {
		{ p("Body", Vector3.new(0.64, 1.3, 0.075), "#1C1D22"), CFrame.new(0, 0, 0.02) },
		{ p("Edge", Vector3.new(0.66, 1.28, 0.05), "#3A3C44", Enum.Material.Metal), CFrame.new(0, 0, 0.03) },
		{ p("Camera", Vector3.new(0.16, 0.16, 0.03), "#2B2C33"), CFrame.new(-0.18, 0.5, 0.07) },
		{ p("Palm", Vector3.new(0.5, 0.55, 0.22), Config.Colors.Skin), CFrame.new(0.1, -0.52, 0.19) * CFrame.Angles(0, 0, math.rad(-12)) },
		{ p("Thumb", Vector3.new(0.13, 0.36, 0.13), Config.Colors.Skin), CFrame.new(0.33, -0.18, -0.02) * CFrame.Angles(0, 0, math.rad(20)) },
		{ p("Fingers", Vector3.new(0.12, 0.6, 0.14), Config.Colors.Skin), CFrame.new(-0.35, -0.15, 0.05) },
		{ p("Sleeve", Vector3.new(0.6, 0.5, 0.5), Config.Colors.MortyShirt), CFrame.new(0.28, -1.05, 0.42) * CFrame.Angles(math.rad(-25), 0, math.rad(-18)) },
		{ p("Arm", Vector3.new(0.34, 0.8, 0.34), Config.Colors.Skin), CFrame.new(0.18, -0.85, 0.32) * CFrame.Angles(math.rad(-25), 0, math.rad(-14)) },
	}
	local screen = p("Screen", Vector3.new(0.585, 1.22, 0.01), "#000000", Enum.Material.SmoothPlastic)
	table.insert(self.parts, { screen, CFrame.new(0, 0, -0.022) })
	self.screen = screen
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Display"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(W, H)
	sg.LightInfluence = 0
	sg.Brightness = 1.25
	sg.ClipsDescendants = true
	sg.Parent = screen
	self.gui = sg
	self.canvas = frame(sg, 0, 0, W, H, "#000000", { Name = "Canvas", ClipsDescendants = true })
	self.offset = CFrame.new(0.3, -1.6, -1.2)
	self.target = self.offset
	self.alpha = 0
	self.t = 0
	self.shake = 0
	self.anims = {} -- функции анимации экрана (dt, t)
	m.Parent = workspace.CurrentCamera
	-- после камеры сценки (Camera + 2), чтобы телефон не отставал на кадр
	self.bind = "RM_Phone" .. tostring(math.random(1, 1e6))
	RunService:BindToRenderStep(self.bind, Enum.RenderPriority.Camera.Value + 5, function(dt) self:update(dt) end)
	return self
end

local SHOW_CF = CFrame.new(0.26, -0.14, -1.58) * CFrame.Angles(math.rad(10), math.rad(-9), math.rad(3))
local HIDE_CF = CFrame.new(0.35, -1.7, -1.1) * CFrame.Angles(math.rad(-30), math.rad(-8), math.rad(10))

function Phone:update(dt)
	if U.paused then return end
	self.t = self.t + dt
	local cam = workspace.CurrentCamera
	self.offset = self.offset:Lerp(self.target, 1 - math.exp(-7 * dt))
	local sway = CFrame.Angles(math.sin(self.t * 1.3) * 0.012, math.sin(self.t * 0.9) * 0.015, 0) * CFrame.new(0, math.sin(self.t * 1.7) * 0.008, 0)
	if self.shake > 0 then
		self.shake = math.max(0, self.shake - dt)
		local k = self.shake * 2
		sway = sway * CFrame.new(math.noise(self.t * 40, 1) * 0.03 * k, math.noise(self.t * 40, 2) * 0.03 * k, 0) * CFrame.Angles(0, 0, math.noise(self.t * 30, 3) * 0.06 * k)
	end
	local base = cam.CFrame * self.offset * sway
	for _, e in ipairs(self.parts) do
		e[1].CFrame = base * e[2]
	end
	for _, f in ipairs(self.anims) do f(dt, self.t) end
end

function Phone:raise()
	Audio.play("PhoneOut", { volume = 0.7 })
	self.offset = HIDE_CF
	self.target = SHOW_CF
end
function Phone:lower()
	self.target = HIDE_CF
end
function Phone:vibrate(t)
	self.shake = t or 0.6
	Audio.play("Vibrate", { volume = 0.8 })
end
function Phone:clear()
	self.anims = {}
	for _, c in ipairs(self.canvas:GetChildren()) do c:Destroy() end
end
function Phone:destroy()
	if self.bind then RunService:UnbindFromRenderStep(self.bind) end
	Audio.stop("tiktok")
	self.model:Destroy()
end

---------------------------------------------------------------------------
-- экраны
---------------------------------------------------------------------------
local function statusBar(parent, dark)
	local col = dark and "#111111" or "#ffffff"
	text(parent, 16, 6, 60, 18, "7:42", 13, col)
	text(parent, W - 80, 6, 64, 18, "▮▮▮  23%", 12, col, nil, { TextXAlignment = Enum.TextXAlignment.Right })
	local notch = frame(parent, W / 2 - 34, 6, 68, 18, "#000000")
	round(notch, UDim.new(0.5, 0))
end

local function wallpaper(parent)
	local wp = frame(parent, 0, 0, W, H, "#ffffff", { Name = "Wallpaper" })
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(125, 240, 90)), ColorSequenceKeypoint.new(0.45, Color3.fromRGB(42, 158, 58)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 30, 18)) })
	g.Rotation = 90
	g.Parent = wp
	-- «пятна» на обоях
	for i = 1, 5 do
		local c = frame(wp, (i * 53) % 200 - 20, 60 + (i * 97) % 380, 80 + i * 8, 80 + i * 8, "#ffffff", { BackgroundTransparency = 0.88 })
		round(c, UDim.new(0.5, 0))
	end
	return wp
end

function Phone:lockScreen()
	self:clear()
	local root = frame(self.canvas, 0, 0, W, H, "#000000", { Name = "Lock" })
	self.lock = root
	wallpaper(root)
	statusBar(root)
	text(root, 0, 64, W, 70, "7:42", 66, "#ffffff", G.Fonts.Wide, { TextXAlignment = Enum.TextXAlignment.Center })
	text(root, 0, 136, W, 20, "понедельник, 3 ноября", 14, "#ffffff", G.Fonts.Body, { TextXAlignment = Enum.TextXAlignment.Center })
	local function note(y, icon, iconCol, title, body)
		local n = frame(root, 12, y, W - 24, 58, "#ffffff", { BackgroundTransparency = 0.78 })
		round(n, 14)
		local ic = frame(n, 10, 12, 34, 34, iconCol)
		round(ic, 8)
		text(ic, 0, 0, 34, 34, icon, 18, "#ffffff", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
		text(n, 54, 9, W - 90, 16, title, 13, "#ffffff", G.Fonts.BodyBold)
		text(n, 54, 26, W - 90, 26, body, 11, "#ffffff", G.Fonts.Body, { TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
		return n
	end
	note(190, "♪", "#111111", "ТикТок", "3 новых видео для тебя")
	note(256, "М", "#E8A53A", "Мама", "Хорошего дня в школе! ❤")
	text(root, 0, H - 52, W, 18, "проведи вверх", 12, "#ffffff", G.Fonts.Body, { TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.2 })
	frame(root, W / 2 - 50, H - 22, 100, 5, "#ffffff", { BackgroundTransparency = 0.1 })
	Audio.play("Notify", { volume = 0.4 })
end

-- разблокировка и запуск ТикТока
function Phone:openTikTok()
	Audio.play("Swipe", { volume = 0.5 })
	if self.lock then
		TweenService:Create(self.lock, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromOffset(0, -H) }):Play()
	end
	-- рабочий стол
	local home = frame(self.canvas, 0, 0, W, H, "#000000", { Name = "Home", ZIndex = 0 })
	wallpaper(home)
	statusBar(home)
	local apps = {
		{ "ТикТок", "#111111", "♪" }, { "Камера", "#3A3C44", "◉" }, { "Музыка", "#E2504A", "♫" }, { "Карты", "#4A90D0", "➤" },
		{ "Чат", "#3BB273", "✉" }, { "Игры", "#8E5BB5", "★" }, { "Погода", "#F2B33C", "☀" }, { "Фото", "#E07B39", "▣" },
	}
	local tik
	for i, a in ipairs(apps) do
		local cx = ((i - 1) % 4) * 56 + 14
		local cy = math.floor((i - 1) / 4) * 76 + 70
		local ic = frame(home, cx, cy, 46, 46, a[2])
		round(ic, 12)
		text(ic, 0, 0, 46, 46, a[3], 22, "#ffffff", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
		text(home, cx - 6, cy + 50, 58, 14, a[1], 10, "#ffffff", G.Fonts.Body, { TextXAlignment = Enum.TextXAlignment.Center })
		if i == 1 then tik = ic end
	end
	U.wait(0.8)
	-- «нажатие» на ТикТок
	Audio.play("PhoneTap", { volume = 0.6 })
	local ring = frame(home, 14 - 6, 70 - 6, 58, 58, "#ffffff", { BackgroundTransparency = 0.5 })
	round(ring, 16)
	U.wait(0.25)
	-- заставка приложения
	local splash = frame(self.canvas, 0, 0, W, H, "#000000", { Name = "Splash" })
	splash.Size = UDim2.fromOffset(46, 46)
	splash.Position = UDim2.fromOffset(tik.Position.X.Offset, tik.Position.Y.Offset)
	TweenService:Create(splash, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(W, H), Position = UDim2.fromOffset(0, 0) }):Play()
	local logo = frame(splash, 0, 0, W, H, "#000000", { BackgroundTransparency = 1 })
	text(logo, 4, H / 2 - 64, W, 80, "♪", 72, "#25F4EE", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
	text(logo, -4, H / 2 - 60, W, 80, "♪", 72, "#FE2C55", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
	text(logo, 0, H / 2 - 62, W, 80, "♪", 72, "#ffffff", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
	text(logo, 0, H / 2 + 20, W, 30, "ТикТок", 26, "#ffffff", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
	U.wait(1.0)
	home:Destroy()
	if self.lock then self.lock:Destroy(); self.lock = nil end
	self.splash = splash
end

-- интерфейс ленты поверх ролика
local function feedChrome(parent, nick, caption, likes, song)
	text(parent, 0, 28, W, 20, "Подписки    |    Рекомендации", 13, "#ffffff", G.Fonts.BodyBold, { TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.1 })
	local side = frame(parent, W - 50, 200, 44, 240, "#000000", { BackgroundTransparency = 1 })
	local av = frame(side, 4, 0, 36, 36, "#F2D85A")
	round(av, UDim.new(0.5, 0))
	local function icon(y, sym, count)
		text(side, 0, y, 44, 30, sym, 26, "#ffffff", G.Fonts.Title, { TextXAlignment = Enum.TextXAlignment.Center })
		return text(side, 0, y + 28, 44, 14, count, 11, "#ffffff", G.Fonts.BodyBold, { TextXAlignment = Enum.TextXAlignment.Center })
	end
	local likeLabel = icon(52, "♥", likes)
	icon(106, "✎", "1 204")
	icon(160, "➦", "877")
	text(parent, 12, H - 112, W - 70, 18, nick, 15, "#ffffff", G.Fonts.Title)
	local cap = text(parent, 12, H - 92, W - 70, 40, caption, 12, "#ffffff", G.Fonts.Body, { TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	text(parent, 12, H - 48, W - 70, 16, "♫ " .. song, 11, "#ffffff", G.Fonts.Body)
	local barBg = frame(parent, 0, H - 26, W, 3, "#ffffff", { BackgroundTransparency = 0.7 })
	local bar = frame(barBg, 0, 0, 0, 3, "#ffffff")
	-- нижнее меню
	local nav = frame(parent, 0, H - 22, W, 22, "#000000")
	text(nav, 0, 2, W, 18, "Главная   Друзья   ＋   Входящие   Профиль", 10, "#ffffff", G.Fonts.Body, { TextXAlignment = Enum.TextXAlignment.Center })
	return { like = likeLabel, bar = bar, caption = cap }
end

-- ролик 1: кот танцует
function Phone:video1()
	if self.splash then self.splash:Destroy(); self.splash = nil end
	local v = frame(self.canvas, 0, 0, W, H, "#ffffff", { Name = "Video1", ClipsDescendants = true })
	local bg = Instance.new("UIGradient")
	bg.Rotation = 120
	bg.Parent = v
	local floorF = frame(v, 0, 330, W, 170, "#6A4A8A")
	local cat = frame(v, W / 2 - 60, 170, 120, 170, "#000000", { BackgroundTransparency = 1, Name = "Cat" })
	local body = frame(cat, 20, 70, 80, 90, "#F09A3A")
	round(body, 30)
	local head = frame(cat, 15, 0, 90, 80, "#F4A848")
	round(head, UDim.new(0.45, 0))
	local earL = frame(head, 8, -10, 26, 26, "#F4A848", { Rotation = 45 })
	local earR = frame(head, 56, -10, 26, 26, "#F4A848", { Rotation = 45 })
	local _e1, _e2 = earL, earR
	local eyeL = frame(head, 22, 28, 14, 18, "#1B1B22")
	local eyeR = frame(head, 54, 28, 14, 18, "#1B1B22")
	round(eyeL, UDim.new(0.5, 0))
	round(eyeR, UDim.new(0.5, 0))
	frame(head, 40, 50, 10, 6, "#E2504A")
	local glasses = frame(head, 16, 26, 58, 6, "#111111")
	local _g = glasses
	local pawL = frame(cat, -6, 86, 26, 18, "#F4A848")
	local pawR = frame(cat, 100, 86, 26, 18, "#F4A848")
	round(pawL, 8)
	round(pawR, 8)
	local cup = frame(cat, 96, 70, 22, 26, "#FFFFFF")
	round(cup, 4)
	local ui = feedChrome(v, "@кот_борис", "утренний вайб ☕ #котики #утро #понедельник", "48,2 тыс.", "оригинальный звук — кот_борис")
	self.video = v
	self.ui = ui
	self.song = Audio.loop("tiktok", "TikTokSong", { volume = 0.55 })
	local likes = 48200
	table.insert(self.anims, function(dt, t)
		local beat = t * 2.1 * math.pi
		cat.Position = UDim2.fromOffset(W / 2 - 60 + math.sin(beat / 2) * 18, 170 - math.abs(math.sin(beat)) * 22)
		cat.Rotation = math.sin(beat / 2) * 9
		pawL.Position = UDim2.fromOffset(-6, 86 - math.abs(math.sin(beat)) * 30)
		pawR.Position = UDim2.fromOffset(100, 86 - math.abs(math.cos(beat)) * 30)
		local h = (t * 0.08) % 1
		bg.Color = ColorSequence.new(Color3.fromHSV(h, 0.55, 1), Color3.fromHSV((h + 0.25) % 1, 0.65, 0.95))
		floorF.BackgroundColor3 = Color3.fromHSV((h + 0.5) % 1, 0.4, 0.55)
		ui.bar.Size = UDim2.fromOffset((t * 18) % W, 3)
		likes = likes + math.random(0, 3)
		ui.like.Text = string.format("%.1f тыс.", likes / 1000):gsub("%.", ",")
	end)
end

-- пролистать к ролику 2 (портал «своими руками»)
function Phone:swipeToVideo2()
	Audio.play("Swipe", { volume = 0.6 })
	Audio.stop("tiktok", 0.2)
	local old = self.video
	local v = frame(self.canvas, 0, H, W, H, "#0E1418", { Name = "Video2", ClipsDescendants = true })
	-- «гараж»: стена, верстак, лампа
	frame(v, 0, 0, W, 300, "#2A3138")
	frame(v, 0, 300, W, 200, "#1B2126")
	local bench = frame(v, 20, 270, 200, 24, "#6B4A2E")
	local _b = bench
	local lamp = frame(v, 100, 0, 40, 60, "#C9C2A0")
	local _l = lamp
	-- зарождающийся портал
	local por = frame(v, W / 2 - 10, 160, 20, 20, "#7CFF4A")
	round(por, UDim.new(0.5, 0))
	local pg = Instance.new("UIGradient")
	pg.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(230, 255, 170)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 230, 70)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 140, 40)) })
	pg.Parent = por
	local hand = frame(v, -40, 230, 90, 26, "#F1D2B0")
	round(hand, 10)
	local ui = feedChrome(v, "@наука_по_фактам", "Как открыть портал в другое измерение прямо в гараже 😱 #наука #лайфхак", "1,3 млн", "оригинальный звук — наука_по_фактам")
	TweenService:Create(v, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(0, 0) }):Play()
	if old then
		TweenService:Create(old, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(0, -H) }):Play()
		task.delay(0.45, function() old:Destroy() end)
	end
	self.anims = {}
	self.video = v
	self.ui = ui
	self.v2 = { por = por, pg = pg, hand = hand, t = 0, frozen = false }
	local st = self.v2
	table.insert(self.anims, function(dt)
		if st.frozen then return end
		st.t = st.t + dt
		local s = 20 + math.min(st.t, 4) * 22
		por.Size = UDim2.fromOffset(s, s)
		por.Position = UDim2.fromOffset(W / 2 - s / 2, 170 - s / 2)
		pg.Rotation = (pg.Rotation + dt * 160) % 360
		hand.Position = UDim2.fromOffset(-40 + math.sin(st.t * 3) * 10, 230)
		ui.bar.Size = UDim2.fromOffset(math.min(W, st.t * 22), 3)
	end)
	task.delay(0.4, function()
		self.song = Audio.loop("tiktok", "TikTokSong", { volume = 0.5, speed = 0.92 })
	end)
end

-- лаги: ролик замирает, крутится загрузка, звук заикается
function Phone:lag(seconds)
	local st = self.v2
	if not st then return end
	local spinner = frame(self.video, W / 2 - 22, H / 2 - 22, 44, 44, "#ffffff", { BackgroundTransparency = 1, Name = "Spinner" })
	local ring = Instance.new("UIStroke")
	ring.Thickness = 5
	ring.Color = Color3.new(1, 1, 1)
	ring.Parent = spinner
	round(spinner, UDim.new(0.5, 0))
	local sg = Instance.new("UIGradient")
	sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.51, 1), NumberSequenceKeypoint.new(1, 1) })
	sg.Parent = ring
	spinner.Visible = false
	local tEnd = self.t + (seconds or 4)
	local song = self.song
	table.insert(self.anims, function(dt, t)
		if t > tEnd then
			st.frozen = true
			spinner.Visible = true
			sg.Rotation = (sg.Rotation + dt * 400) % 360
			return
		end
		-- рывками: стоп-ход
		local phase = (t * 1.7) % 1
		st.frozen = phase > 0.45
		spinner.Visible = st.frozen
		sg.Rotation = (sg.Rotation + dt * 400) % 360
		if song and song.Parent then
			if st.frozen and song.IsPlaying then song:Pause()
			elseif not st.frozen and not song.IsPlaying then song:Resume() end
		end
		if st.frozen and math.random() < 0.08 then
			self.ui.bar.Size = UDim2.fromOffset(math.max(0, self.ui.bar.Size.X.Offset - 20), 3)
		end
	end)
end

-- глитч: разрывы, цветные полосы, шум, «портал» на весь экран, потом чёрный экран
function Phone:glitch(duration)
	duration = duration or 3
	Audio.stop("tiktok")
	Audio.play("Glitch", { volume = 0.9 })
	local layer = frame(self.canvas, 0, 0, W, H, "#000000", { BackgroundTransparency = 1, Name = "Glitch", ZIndex = 50 })
	local bars = {}
	for i = 1, 16 do
		local b = frame(layer, 0, 0, W, 10, "#000000", { ZIndex = 51 })
		table.insert(bars, b)
	end
	local noise = {}
	for i = 1, 40 do
		table.insert(noise, frame(layer, 0, 0, 8, 8, "#ffffff", { ZIndex = 52 }))
	end
	local flash = frame(layer, 0, 0, W, H, "#7CFF4A", { BackgroundTransparency = 1, ZIndex = 53 })
	local err = text(layer, 0, H / 2 - 20, W, 40, "ОШИБКА ВОСПРОИЗВЕДЕНИЯ", 16, "#ffffff", G.Fonts.Wide, { TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 54, TextTransparency = 1 })
	local swirl = frame(layer, W / 2, H / 2, 0, 0, "#7CFF4A", { ZIndex = 55, AnchorPoint = Vector2.new(0.5, 0.5) })
	round(swirl, UDim.new(0.5, 0))
	local sgr = Instance.new("UIGradient")
	sgr.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(235, 255, 180)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(110, 230, 70)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(30, 140, 40)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(110, 230, 70)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(235, 255, 180)), ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 140, 40)) })
	sgr.Parent = swirl
	local caption = self.ui and self.ui.caption
	local orig = caption and caption.Text or ""
	local glyphs = { "▓", "░", "█", "#", "%", "@", "Ж", "Ψ", "¤", "∆" }
	local t0 = self.t
	self:vibrate(duration)
	table.insert(self.anims, function(dt, t)
		local k = math.clamp((t - t0) / duration, 0, 1)
		for i, b in ipairs(bars) do
			local on = math.random() < 0.25 + k * 0.5
			b.Visible = on
			if on then
				b.Position = UDim2.fromOffset(math.random(-40, 40) * k, math.random(0, H))
				b.Size = UDim2.fromOffset(W + 80, math.random(3, 22))
				local c = math.random(1, 4)
				b.BackgroundColor3 = (c == 1 and Color3.fromRGB(255, 40, 120)) or (c == 2 and Color3.fromRGB(40, 240, 255)) or (c == 3 and Color3.fromRGB(124, 255, 74)) or Color3.new(0, 0, 0)
				b.BackgroundTransparency = 0.2 + math.random() * 0.5
			end
		end
		for _, n in ipairs(noise) do
			n.Visible = math.random() < 0.3 + k * 0.6
			n.Position = UDim2.fromOffset(math.random(0, W), math.random(0, H))
			local s = math.random(2, 10)
			n.Size = UDim2.fromOffset(s * 2, s)
			n.BackgroundColor3 = math.random() < 0.5 and Color3.new(1, 1, 1) or Color3.fromRGB(124, 255, 74)
		end
		flash.BackgroundTransparency = math.random() < 0.12 + k * 0.2 and 0.4 or 1
		err.TextTransparency = (k > 0.3 and math.random() < 0.6) and 0 or 1
		err.Position = UDim2.fromOffset(math.random(-6, 6), H / 2 - 20 + math.random(-4, 4))
		if caption then
			local out = {}
			for _, c in utf8.codes(orig) do
				if math.random() < k * 0.8 then table.insert(out, glyphs[math.random(1, #glyphs)]) else table.insert(out, utf8.char(c)) end
			end
			caption.Text = table.concat(out)
		end
		-- в конце вихрь заполняет экран
		if k > 0.6 then
			local s = (k - 0.6) / 0.4 * (H * 1.6)
			swirl.Size = UDim2.fromOffset(s, s)
			sgr.Rotation = (sgr.Rotation + dt * 520) % 360
		end
	end)
	U.wait(duration)
	-- чёрный экран «нет сигнала»
	self.anims = {}
	self:clear()
	local dead = frame(self.canvas, 0, 0, W, H, "#000000", { Name = "Dead" })
	local nos = text(dead, 0, H / 2 - 30, W, 24, "НЕТ СИГНАЛА", 16, "#7CFF4A", G.Fonts.Wide, { TextXAlignment = Enum.TextXAlignment.Center })
	local dots = {}
	for i = 1, 30 do table.insert(dots, frame(dead, 0, 0, 3, 3, "#ffffff", { BackgroundTransparency = 0.6 })) end
	table.insert(self.anims, function(dt, t)
		nos.TextTransparency = math.random() < 0.15 and 0.8 or 0
		for _, d in ipairs(dots) do d.Position = UDim2.fromOffset(math.random(0, W), math.random(0, H)) end
	end)
end

return Phone
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Portal</string><ProtectedString name="Source"><![CDATA[-- Зелёный портал Рика (меню и переходы). Без картинок: вихрь — вложенные круги с вращающимися
-- полосатыми градиентами на SurfaceGui, светящийся край из шариков Neon, искры, зелёный свет.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Portal = {}
Portal.__index = Portal
local Config, B, Audio

function Portal.init(ctx)
	Config, B, Audio = ctx.Config, ctx.Build, ctx.Audio
end

local function stripes(c1, c2, n)
	local kps = {}
	for i = 0, n do
		local t = i / n
		table.insert(kps, ColorSequenceKeypoint.new(t, (i % 2 == 0) and c1 or c2))
	end
	return ColorSequence.new(kps)
end

-- cf: центр портала, LookVector смотрит на зрителя; d — диаметр
function Portal.new(cf, d, parent)
	local self = setmetatable({}, Portal)
	self.cf = cf
	self.d = d
	self.scale = 0.02
	self.t = 0
	local m = Instance.new("Model")
	m.Name = "RM_Portal"
	self.model = m
	-- задний диск и тёмное кольцо
	self.disc = B.cyl(m, "Disc", 0.08, d, cf * CFrame.new(0, 0, 0.12) * CFrame.Angles(0, math.rad(90), 0), Config.Colors.PortalDark, Enum.Material.Neon, { CastShadow = false, CanCollide = false, CanQuery = false })
	self.rim = B.cyl(m, "Rim", 0.06, d + 0.5, cf * CFrame.new(0, 0, 0.18) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(18, 90, 24), Enum.Material.Neon, { CastShadow = false, CanCollide = false, CanQuery = false })
	-- панель с вихрем (две стороны)
	self.panel = B.part(m, "Swirl", Vector3.new(d, d, 0.04), cf, Color3.new(0, 0, 0), nil, { Transparency = 1, CastShadow = false, CanCollide = false, CanQuery = false })
	self.layers = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local g = Instance.new("SurfaceGui")
		g.Face = face
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = 60
		g.LightInfluence = 0
		g.Brightness = 2.2
		g.ClipsDescendants = true
		g.Parent = self.panel
		local specs = {
			{ s = 1.0, a = Color3.fromRGB(24, 120, 30), b = Color3.fromRGB(46, 168, 44), n = 12, sp = 24 },
			{ s = 0.86, a = Color3.fromRGB(57, 194, 50), b = Color3.fromRGB(110, 226, 74), n = 10, sp = -46 },
			{ s = 0.68, a = Color3.fromRGB(123, 225, 74), b = Color3.fromRGB(184, 245, 106), n = 8, sp = 70 },
			{ s = 0.48, a = Color3.fromRGB(200, 255, 138), b = Color3.fromRGB(150, 240, 80), n = 6, sp = -110 },
			{ s = 0.26, a = Color3.fromRGB(238, 255, 200), b = Color3.fromRGB(210, 255, 150), n = 4, sp = 160 },
		}
		for i, sp in ipairs(specs) do
			local f = Instance.new("Frame")
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(0.5, 0.5)
			f.Size = UDim2.fromScale(sp.s, sp.s)
			f.BackgroundColor3 = Color3.new(1, 1, 1)
			f.BorderSizePixel = 0
			f.ZIndex = i
			f.Parent = g
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			local gr = Instance.new("UIGradient")
			gr.Color = stripes(sp.a, sp.b, sp.n)
			gr.Rotation = i * 37
			gr.Parent = f
			table.insert(self.layers, { g = gr, sp = (face == Enum.NormalId.Back) and -sp.sp or sp.sp })
		end
	end
	-- светящийся край: шарики по окружности
	self.beads = {}
	for i = 1, 22 do
		local bead = B.ball(m, "Bead", 0.42, cf, (i % 3 == 0) and Config.Colors.PortalLight or Config.Colors.Portal, Enum.Material.Neon,
			{ CastShadow = false, CanCollide = false, CanQuery = false })
		table.insert(self.beads, { p = bead, a = (i - 1) / 22 * math.pi * 2, r = 0.5 + (i % 2) * 0.03, s = 0.42 + (i % 4) * 0.08 })
	end
	-- искры
	local emitter = B.part(m, "Sparks", Vector3.new(d * 0.8, d * 0.8, 0.1), cf * CFrame.new(0, 0, -0.1), Color3.new(0, 0, 0),
		nil, { Transparency = 1, CastShadow = false, CanCollide = false, CanQuery = false })
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Config.Colors.PortalLight, Config.Colors.Portal)
	pe.LightEmission = 1
	pe.LightInfluence = 0
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(0.7, 1.5)
	pe.Speed = NumberRange.new(2, 6)
	pe.Drag = 2
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Rate = 34
	pe.EmissionDirection = Enum.NormalId.Front
	pe.Parent = emitter
	self.emitter = pe
	self.sparkPart = emitter
	-- свет
	local lp = B.part(m, "LightPoint", Vector3.new(0.2, 0.2, 0.2), cf * CFrame.new(0, 0, -1.4), Color3.new(0, 0, 0),
		nil, { Transparency = 1, CastShadow = false, CanCollide = false, CanQuery = false })
	self.light = B.light(lp, "PointLight", { Color = Color3.fromRGB(110, 255, 70), Brightness = 3.2, Range = 26, Shadows = true })
	self.lightPart = lp
	m.Parent = parent or workspace
	self:apply()
	self.conn = RunService.RenderStepped:Connect(function(dt) self:update(dt) end)
	return self
end

-- применить масштаб ко всем частям
function Portal:apply()
	local s = math.max(self.scale, 0.01)
	local d = self.d * s
	local cf = self.cf
	self.disc.Size = Vector3.new(0.08, d, d)
	self.disc.CFrame = cf * CFrame.new(0, 0, 0.12) * CFrame.Angles(0, math.rad(90), 0)
	self.rim.Size = Vector3.new(0.06, d + 0.5 * s, d + 0.5 * s)
	self.rim.CFrame = cf * CFrame.new(0, 0, 0.18) * CFrame.Angles(0, math.rad(90), 0)
	self.panel.Size = Vector3.new(d, d, 0.04)
	self.panel.CFrame = cf
	for _, g in ipairs(self.panel:GetChildren()) do
		if g:IsA("SurfaceGui") then g.PixelsPerStud = math.clamp(420 / d, 10, 400) end
	end
	self.sparkPart.Size = Vector3.new(d * 0.8, d * 0.8, 0.1)
	self.sparkPart.CFrame = cf * CFrame.new(0, 0, -0.1)
	self.light.Range = 8 + 18 * math.min(s, 1.5)
	self.lightPart.CFrame = cf * CFrame.new(0, 0, -1.4 * s)
end

function Portal:update(dt)
	self.t = self.t + dt
	for _, l in ipairs(self.layers) do
		l.g.Rotation = (l.g.Rotation + l.sp * dt) % 360
	end
	local s = math.max(self.scale, 0.01)
	local r0 = self.d * s
	for i, b in ipairs(self.beads) do
		b.a = b.a + dt * (1.6 + (i % 3) * 0.4)
		local wob = 1 + math.sin(self.t * 5 + i) * 0.035
		local r = r0 * b.r * wob
		b.p.CFrame = self.cf * CFrame.new(math.cos(b.a) * r, math.sin(b.a) * r, -0.05)
		local bs = b.s * s * (0.8 + 0.4 * math.abs(math.sin(self.t * 3 + i)))
		b.p.Size = Vector3.new(bs, bs, bs)
	end
	self.light.Brightness = 3 + math.sin(self.t * 4) * 0.4
end

-- плавно изменить размер (t секунд)
function Portal:scaleTo(s, t, style)
	local v = Instance.new("NumberValue")
	v.Value = self.scale
	v.Changed:Connect(function(x)
		self.scale = x
		if self.model.Parent then self:apply() end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(t or 0.6, style or Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = s })
	tw:Play()
	tw.Completed:Connect(function() v:Destroy() end)
	return tw
end

function Portal:open(t)
	Audio.play("Whoosh", { at = self.panel, volume = 0.8 })
	self:scaleTo(1, t or 0.9)
	self.hum = Audio.loop("portal_hum_" .. tostring(self), "PortalHum", { at = self.panel, volume = 0.55, min = 4, max = 50 })
end

function Portal:destroy()
	if self.conn then self.conn:Disconnect() end
	if self.hum then Audio.stop("portal_hum_" .. tostring(self), 0.4) end
	if self.model then self.model:Destroy() end
end

return Portal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Prompts</string><ProtectedString name="Source"><![CDATA[-- Свой вид подсказок ProximityPrompt (стиль Custom): тёмная «таблетка» с клавишей и действием.
-- На телефоне подсказку можно нажать пальцем. Пока идёт сценка, подсказки скрыты (Prompts.enabled).
local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")

local Prompts = {}
local G, Config, Hud
local shown = {} -- prompt -> BillboardGui
Prompts.enabled = true

local function keyText(prompt, inputType)
	if inputType == Enum.ProximityPromptInputType.Touch then return "ТАП" end
	if inputType == Enum.ProximityPromptInputType.Gamepad then return prompt.GamepadKeyCode.Name:gsub("Button", "") end
	return prompt.KeyboardKeyCode.Name
end

local function build(prompt, inputType)
	local bb = Instance.new("BillboardGui")
	bb.Name = "RM_Prompt"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(300, 64)
	bb.SizeOffset = Vector2.new(0, 0.6)
	bb.LightInfluence = 0
	bb.MaxDistance = 40
	bb.ResetOnSpawn = false
	bb.Adornee = prompt.Parent
	bb.Active = true
	local btn = Instance.new("TextButton")
	btn.Name = "Pill"
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(0.5, 0.5)
	btn.Size = UDim2.fromOffset(10, 46)
	btn.AutomaticSize = Enum.AutomaticSize.X
	btn.BackgroundColor3 = Color3.fromRGB(10, 26, 14)
	btn.BackgroundTransparency = 0.12
	btn.Parent = bb
	G.corner(btn, UDim.new(0.5, 0))
	G.stroke(btn, Config.Colors.UiLime, 2).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	G.pad(btn, 7, 0, 18, 0)
	G.list(btn, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local cap = G.frame(btn, { Name = "Key", Size = UDim2.fromOffset(34, 32), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Config.Colors.UiLime, LayoutOrder = 1 })
	G.corner(cap, 8)
	G.pad(cap, 8, 0, 8, 0)
	G.label(cap, keyText(prompt, inputType), { Size = UDim2.fromOffset(18, 32), AutomaticSize = Enum.AutomaticSize.X, FontFace = G.Fonts.Title,
		TextSize = 20, TextColor3 = Config.Colors.UiDark })
	local txt = prompt.ActionText
	if prompt.ObjectText ~= "" then txt = txt .. " · " .. prompt.ObjectText end
	local label = G.label(btn, txt, { Name = "Text", Size = UDim2.fromOffset(10, 46), AutomaticSize = Enum.AutomaticSize.X,
		FontFace = G.Fonts.Bold, TextSize = 21, LayoutOrder = 2 })
	-- полоска удержания
	local bar = G.frame(btn, { Name = "Hold", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 2), Size = UDim2.new(0, 0, 0, 3),
		BackgroundColor3 = Config.Colors.UiLime, ZIndex = 3 })
	bar.Visible = prompt.HoldDuration > 0
	local sc = Instance.new("UIScale")
	sc.Scale = 0.5
	sc.Parent = btn
	G.tween(sc, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	-- нажатие пальцем / мышью
	btn.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	btn.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)
	local conns = {}
	table.insert(conns, prompt:GetPropertyChangedSignal("ActionText"):Connect(function()
		label.Text = prompt.ActionText .. (prompt.ObjectText ~= "" and (" · " .. prompt.ObjectText) or "")
	end))
	table.insert(conns, prompt.PromptButtonHoldBegan:Connect(function()
		bar.Size = UDim2.new(0, 0, 0, 3)
		G.tween(bar, prompt.HoldDuration, { Size = UDim2.new(1, 0, 0, 3) }, Enum.EasingStyle.Linear)
	end))
	table.insert(conns, prompt.PromptButtonHoldEnded:Connect(function()
		G.tween(bar, 0.15, { Size = UDim2.new(0, 0, 0, 3) })
	end))
	table.insert(conns, prompt.Triggered:Connect(function()
		G.tween(sc, 0.08, { Scale = 0.9 })
		task.delay(0.09, function() G.tween(sc, 0.15, { Scale = 1 }, Enum.EasingStyle.Back) end)
	end))
	bb.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)
	bb.Parent = G.playerGui()
	return bb
end

function Prompts.init(ctx)
	G, Config, Hud = ctx.Gui, ctx.Config, ctx.Hud
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then return end
		if shown[prompt] then shown[prompt]:Destroy() end
		local bb = build(prompt, inputType)
		bb.Enabled = Prompts.enabled
		shown[prompt] = bb
		Hud.crossFocus(true)
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		local bb = shown[prompt]
		shown[prompt] = nil
		if bb then bb:Destroy() end
		if next(shown) == nil then Hud.crossFocus(false) end
	end)
end

-- скрыть/показать все подсказки (во время сценок); ProximityPromptService.Enabled — только у этого игрока
function Prompts.setEnabled(on)
	Prompts.enabled = on
	ProximityPromptService.Enabled = on
	for _, bb in pairs(shown) do bb.Enabled = on end
end

local _u = UserInputService
return Prompts
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[-- Настройки игрока: громкость, мышь, поле зрения, эффекты, субтитры, подсказки.
-- Хранятся в памяти на время игры; изменение сразу применяется (событие Changed).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Settings = {}
Settings.values = {}

local changed = Instance.new("BindableEvent")
Settings.Changed = changed.Event

local Config

function Settings.init(ctx)
	Config = ctx.Config
	for k, v in pairs(Config.DefaultSettings) do Settings.values[k] = v end
	-- если игрок уже менял настройки в этой сессии — берём их из атрибутов
	local plr = Players.LocalPlayer
	for k in pairs(Config.DefaultSettings) do
		local v = plr:GetAttribute("Set_" .. k)
		if v ~= nil then Settings.values[k] = v end
	end
	Settings.apply()
end

function Settings.get(k) return Settings.values[k] end

function Settings.set(k, v)
	if Settings.values[k] == v then return end
	Settings.values[k] = v
	Players.LocalPlayer:SetAttribute("Set_" .. k, v)
	Settings.apply()
	changed:Fire(k, v)
end

function Settings.reset()
	for k, v in pairs(Config.DefaultSettings) do
		Settings.values[k] = v
		Players.LocalPlayer:SetAttribute("Set_" .. k, v)
		changed:Fire(k, v)
	end
	Settings.apply()
end

-- то, что применяется напрямую (остальное слушают модули через Changed)
function Settings.apply()
	pcall(function() UserInputService.MouseDeltaSensitivity = Settings.values.Sensitivity end)
	local cam = workspace.CurrentCamera
	if cam and cam.CameraType ~= Enum.CameraType.Scriptable then cam.FieldOfView = Settings.values.Fov end
end

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Story</string><ProtectedString name="Source"><![CDATA[-- Сюжет главы 1 «Сбой»: пробуждение (вид от первого лица), будильник, путь на кухню,
-- завтрак, телефон с лагающим ТикТоком, мысль Морти и конец главы.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")

local Story = {}
local ctx
local U, Config, Settings, Audio, Hud, Cine, Controls, World, Prompts, Outline, Breakfast, Phone, G, B
local player = Players.LocalPlayer
local trove
local thread
local state = "idle" -- idle | intro | roam | scene | ending
local hideBody = false
local markers

local function mk(name) return markers:WaitForChild(name) end

-- скрыть своё тело (в сценках камера стоит в голове)
local function setBodyHidden(on)
	hideBody = on
	local char = player.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = on and 1 or 0 end
	end
end

-- подсказка, созданная только у этого игрока
local function localPrompt(part, action, dist)
	local p = B.prompt(part, "RM_StoryPrompt", action, "", { MaxActivationDistance = dist or 7 })
	trove:add(p)
	return p
end

local function waitPrompt(p)
	local done = U.signal()
	local c = p.Triggered:Connect(function() done:Fire() end)
	done.Event:Wait()
	c:Disconnect()
end

---------------------------------------------------------------------------
-- 1. Пробуждение
---------------------------------------------------------------------------
local function lyingCF()
	local head = mk("BedHead").Position
	return CFrame.fromMatrix(Vector3.new(head.X + 0.1, 14.75, head.Z - 1.4), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1))
end

local function intro()
	state = "intro"
	Hud.fadeSet(1, Color3.new(0, 0, 0))
	Hud.eyesSet(0)
	Hud.blur(24)
	Hud.gameplay(false)
	Prompts.setEnabled(false)
	Controls.setActive(false)
	Controls.freeze(true)
	World.apply("morning", 0)
	-- персонаж лежит в кровати
	local _, hum = Controls.character()
	if hum then hum.PlatformStand = true end
	Controls.place(lyingCF(), true)
	setBodyHidden(true)
	local eye = mk("BedHead").Position
	-- голова повёрнута к тумбочке: видно потолок и мигающий будильник
	local lookUp = CFrame.lookAt(eye, eye + Vector3.new(0.92, 0.32, -0.05), Vector3.new(-0.3, 0.15, 1))
	Cine.take(lookUp, 70)
	Cine.breathe(1)
	Audio.music("MusicMorning", 3, 0.35)
	Audio.loop("birds", "Birds", { volume = 0.22 })
	Hud.chapterCard(Config.Chapter, Config.Text.DayCard)
	-- будильник
	local clock = workspace.House.Furniture:WaitForChild("AlarmClock")
	local digits = clock:FindFirstChild("Digits", true)
	Audio.loop("alarm", "Alarm", { at = clock.PrimaryPart, volume = 0.9, min = 5, max = 60 })
	local blinking = true
	trove:add(function() blinking = false end)
	task.spawn(function()
		while blinking and digits do
			digits.TextTransparency = 0
			task.wait(0.4)
			if not blinking then break end
			digits.TextTransparency = 0.85
			task.wait(0.3)
		end
		if digits then digits.TextTransparency = 0 end
	end)
	Hud.say(nil, Config.Text.Alarm, { hold = 2.5 })
	Hud.fade(0, 1.2)
	U.wait(1.4)
	-- моргание
	Audio.play("Blink", { volume = 0.4 })
	Hud.eyes(0.22, 0.9)
	Hud.blur(16, 0.9)
	U.wait(1.1)
	Hud.eyes(0, 0.18)
	U.wait(0.3)
	Hud.eyes(0.55, 0.7)
	Hud.blur(8, 0.7)
	U.wait(0.9)
	Hud.eyes(0.1, 0.15)
	U.wait(0.22)
	Hud.eyes(1, 0.9)
	Hud.blur(0, 1.4)
	U.wait(0.8)
	Hud.thinkWait(Config.Text.Wake1, 0.1)
	Hud.thinkWait(Config.Text.Wake2, 0.1)
	-- встать
	local act = Hud.action(Config.Text.GetUpHint, { Enum.KeyCode.Space, Enum.KeyCode.E, Enum.KeyCode.ButtonA }, { keyLabel = "Space" })
	act:once()
	Hud.hideSay()
	-- сценка подъёма: сесть → развернуться → встать
	Audio.play("Rustle", { volume = 0.7 })
	local stand = mk("StandSpot").CFrame
	local eyeH = Controls.eyeOffset()
	local standEye = stand.Position + Vector3.new(0, eyeH, 0)
	local window = Vector3.new(55, standEye.Y - 0.4, 30.5)
	local sit = mk("BedSit").Position
	Cine.breathe(0.5)
	Cine.play({
		{ t = 0, cf = Cine.get() },
		{ t = 1.1, cf = CFrame.lookAt(sit, sit + Vector3.new(0.1, -0.55, -1)), ease = "inout" },
		{ t = 1.6, cf = CFrame.lookAt(sit + Vector3.new(0.15, -0.05, 0), sit + Vector3.new(0.3, -0.6, -1)), ease = "inout" },
		{ t = 2.5, cf = CFrame.lookAt(sit + Vector3.new(1.4, -0.45, -0.4), sit + Vector3.new(6, -1.2, -2.4)), ease = "inout" },
		{ t = 3.6, cf = CFrame.lookAt(standEye + Vector3.new(-0.5, -0.25, 0.2), window), ease = "inout" },
		{ t = 4.2, cf = CFrame.lookAt(standEye, window), ease = "out" },
	}, { spline = true })
	-- отдаём управление
	if hum then hum.PlatformStand = false end
	Controls.place(CFrame.lookAt(stand.Position, Vector3.new(window.X, stand.Position.Y, window.Z)), false)
	Cine.release()
	workspace.CurrentCamera.CFrame = CFrame.lookAt(standEye, window)
	setBodyHidden(false)
	Controls.setActive(true)
	Controls.freeze(false)
	Hud.gameplay(true)
	Prompts.setEnabled(true)
	Cine.breathe(0)
	state = "roam"
	return clock, function() blinking = false end
end

---------------------------------------------------------------------------
-- 2. Будильник и дорога на кухню
---------------------------------------------------------------------------
local function alarmAndKitchen(clock, stopBlink)
	Hud.objective(Config.Text.AlarmObjective)
	-- из-за двери гаража тихо гудит что-то научное (Рик)
	Audio.loop("garage", "PortalHum", { at = mk("GarageHum"), volume = 0.4, min = 3, max = 28, speed = 0.75 })
	local p = localPrompt(clock.PrimaryPart, "Выключить", 8)
	if Settings.get("Hints") then
		task.delay(12, function()
			if p.Parent then Hud.toast("Будильник на тумбочке у кровати") end
		end)
	end
	waitPrompt(p)
	p:Destroy()
	stopBlink()
	Audio.stop("alarm")
	Audio.play("AlarmOff", { at = clock.PrimaryPart, volume = 0.8 })
	Hud.objectiveDone()
	Hud.thinkWait(Config.Text.AlarmDone, 0.3)
	Hud.think(Config.Text.Hungry)
	U.wait(1.5)
	Hud.objective(Config.Text.BreakfastObjective)
	-- подсказка, если игрок долго не находит кухню
	local goal = mk("KitchenGoal")
	local reached = false
	local t0 = os.clock()
	local hinted = false
	local _, _, root = Controls.character()
	while not reached do
		U.wait(0.25)
		local _, _, r = Controls.character()
		root = r
		if root then
			local d = root.Position - goal.Position
			if Vector3.new(d.X, 0, d.Z).Magnitude < 12 and root.Position.Y < 7 then reached = true end
		end
		if not hinted and not reached and Settings.get("Hints") and os.clock() - t0 > Config.HintDelay then
			hinted = true
			Hud.toast(Config.Text.KitchenHint, 5)
			Hud.marker(goal)
		end
	end
	Hud.marker(nil)
	Hud.objectiveDone()
end

---------------------------------------------------------------------------
-- 3. Завтрак
---------------------------------------------------------------------------
local function breakfast(food)
	U.wait(1.2)
	Hud.objective(Config.Text.SitObjective)
	local chair = workspace.House.Furniture:WaitForChild("ChairMorty")
	local p = localPrompt(chair:WaitForChild("Seat"), "Сесть за стол", 8)
	waitPrompt(p)
	p:Destroy()
	Hud.objectiveDone()
	-- садимся
	state = "scene"
	Prompts.setEnabled(false)
	Controls.freeze(true)
	Controls.setActive(false)
	Hud.gameplay(false)
	local cam = workspace.CurrentCamera
	Cine.take(cam.CFrame, cam.FieldOfView)
	setBodyHidden(true)
	local _, hum = Controls.character()
	Controls.place(mk("SeatMorty").CFrame, true)
	if hum then hum.Sit = true end
	Audio.play("Chair", { volume = 0.7 })
	Cine.move(mk("SeatCam").CFrame, 1.3, "inout", 66)
	Cine.breathe(0.7)
	-- хлопья
	Hud.objective(Config.Text.PourObjective)
	Hud.action("Насыпать хлопья", { Enum.KeyCode.E, Enum.KeyCode.ButtonX }):once()
	Hud.objectiveDone()
	food:pour()
	-- молоко
	Hud.objective(Config.Text.MilkObjective)
	Hud.action("Налить молоко", { Enum.KeyCode.E, Enum.KeyCode.ButtonX }):once()
	Hud.objectiveDone()
	food:pourMilk()
	-- есть
	Hud.objective(Config.Text.EatObjective)
	local total = 5
	for i = 1, total do
		local a = Hud.action(string.format("Есть  %d/%d", i - 1, total), { Enum.KeyCode.E, Enum.KeyCode.ButtonX, Enum.KeyCode.Space })
		a:once()
		food:spoonful(1 - i / total)
		if i == 2 then Hud.think(Config.Text.Yum) end
	end
	Hud.objectiveDone()
	Hud.thinkWait(Config.Text.Full, 0.2)
end

---------------------------------------------------------------------------
-- 4. Телефон
---------------------------------------------------------------------------
local function phoneScene()
	Hud.objective(Config.Text.PhoneObjective)
	Hud.action("Достать телефон", { Enum.KeyCode.F, Enum.KeyCode.E, Enum.KeyCode.ButtonY }, { keyLabel = "F" }):once()
	Hud.objectiveDone()
	local cam = workspace.CurrentCamera
	local base = cam.CFrame
	-- чуть опустить взгляд и приблизить (фокус на телефоне)
	Cine.move(base * CFrame.Angles(math.rad(8), 0, 0), 0.8, "inout", 60)
	local phone = Phone.new()
	trove:add(function() phone:destroy() end)
	Outline.add(phone.model)
	phone:raise()
	Audio.muffle(true)
	U.wait(0.6)
	phone:lockScreen()
	U.wait(1.4)
	Hud.thinkWait(Config.Text.PhoneThink, 0)
	phone:openTikTok()
	phone:video1()
	U.wait(3.6)
	Hud.objective(Config.Text.SwipeObjective)
	Hud.action("Листать", { Enum.KeyCode.E, Enum.KeyCode.Space, Enum.UserInputType.MouseWheel, Enum.KeyCode.ButtonX }, { keyLabel = "E" }):once()
	Hud.objectiveDone()
	phone:swipeToVideo2()
	U.wait(2.2)
	phone:lag(3.2)
	U.wait(1.0)
	Hud.think(Config.Text.Lag1)
	U.wait(3.0)
	Cine.shake(0.6, 2.8)
	phone:glitch(3.0)
	Audio.play("Sting", { volume = 0.7 })
	Cine.shake(0.3, 0.8)
	U.wait(0.6)
	-- главная фраза
	Hud.think(Config.Text.WhatThe, { hold = 3.6, speed = 0.035 })
	Cine.move(cam.CFrame * CFrame.Angles(math.rad(-4), math.rad(2), 0), 1.4, "out", 54)
	U.wait(3.4)
	return phone
end

---------------------------------------------------------------------------
-- 5. Конец главы
---------------------------------------------------------------------------
local function ending(onMenu)
	state = "ending"
	Hud.objective(nil)
	Hud.letterbox(true, 1.2)
	Hud.fadeWait(1, 1.6, Color3.new(0, 0, 0))
	Audio.muffle(false)
	Audio.stopAll()
	Audio.music("MusicMenu", 2, 0.45)
	local sg, root = G.screen("Ending", 60)
	trove:add(sg)
	local t1 = G.label(root, Config.Text.ChapterEnd, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.36, 0), Size = UDim2.fromOffset(900, 70),
		FontFace = G.Fonts.Title, TextSize = 60, TextColor3 = Config.Colors.UiLime, TextTransparency = 1 })
	G.stroke(t1, Config.Colors.UiDark, 4, 1).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local t2 = G.label(root, Config.Text.ToBeContinued, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.48, 0), Size = UDim2.fromOffset(900, 40),
		FontFace = G.Fonts.Wide, TextSize = 30, TextTransparency = 0 })
	t2.MaxVisibleGraphemes = 0
	local t3 = G.label(root, Config.Text.Thanks, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.58, 0), Size = UDim2.fromOffset(900, 30),
		FontFace = G.Fonts.Body, TextSize = 22, TextTransparency = 1, TextColor3 = Color3.fromRGB(210, 230, 210) })
	G.tween(t1, 1.2, { TextTransparency = 0 })
	local s = t1:FindFirstChildOfClass("UIStroke")
	if s then G.tween(s, 1.2, { Transparency = 0 }) end
	U.wait(1.2)
	local n = utf8.len(Config.Text.ToBeContinued) or 20
	for i = 1, n do
		t2.MaxVisibleGraphemes = i
		task.wait(0.06)
	end
	U.wait(0.8)
	G.tween(t3, 1, { TextTransparency = 0 })
	U.wait(1)
	local chosen = U.signal()
	local holder = G.button(root, "В ГЛАВНОЕ МЕНЮ", { name = "ToMenu", size = Vector2.new(380, 64), onClick = function() chosen:Fire() end })
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0.68, 0)
	local modal = G.modal(root, "Free")
	modal.BackgroundTransparency = 1
	modal.ZIndex = 0
	chosen.Event:Wait()
	Hud.letterbox(false, 0.3)
	onMenu()
end

---------------------------------------------------------------------------
-- запуск и сброс
---------------------------------------------------------------------------
function Story.init(c)
	ctx = c
	U, Config, Settings, Audio, Hud, Cine, Controls, World, Prompts, Outline, Breakfast, Phone, G, B =
		c.Util, c.Config, c.Settings, c.Audio, c.Hud, c.Cine, c.Controls, c.World, c.Prompts, c.Outline, c.Breakfast, c.Phone, c.Gui, c.Build
	markers = workspace:WaitForChild("House"):WaitForChild("Markers")
	trove = U.trove()
	-- мысли у предметов (подсказки с атрибутом Thought)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if state ~= "roam" then return end
		local key = prompt:GetAttribute("Thought")
		if not key then return end
		if prompt:GetAttribute("NoteText") then
			Controls.freeze(true)
			Hud.note(Config.Text.Note)
			Controls.freeze(false)
			return
		end
		if prompt:GetAttribute("Locked") then Audio.play("Locked", { at = prompt.Parent, volume = 0.7 }) end
		local text = Config.Text[key]
		if text then Hud.think(text) end
	end)
	-- скрывать тело каждый кадр, пока идёт сценка (Roblox может вернуть прозрачность)
	RunService.RenderStepped:Connect(function()
		if hideBody then
			local char = player.Character
			if char then
				for _, d in ipairs(char:GetDescendants()) do
					if (d:IsA("BasePart") or d:IsA("Decal")) and d.LocalTransparencyModifier < 1 then d.LocalTransparencyModifier = 1 end
				end
			end
		end
	end)
end

-- вся глава; onMenu — вернуться в главное меню
function Story.start(onMenu)
	Story.cleanup()
	thread = task.spawn(function()
		local clock, stopBlink = intro()
		alarmAndKitchen(clock, stopBlink)
		local food = Breakfast.new(markers)
		trove:add(function() food:destroy() end)
		breakfast(food)
		phoneScene()
		ending(onMenu)
	end)
end

-- убрать всё, что создала глава, и вернуть персонажа в исходное состояние
function Story.cleanup()
	if thread and coroutine.status(thread) ~= "dead" and thread ~= coroutine.running() then
		pcall(task.cancel, thread)
	end
	thread = nil
	trove:clean()
	Audio.stop("alarm")
	Audio.stop("tiktok")
	Audio.stop("birds")
	Audio.stop("garage")
	Audio.muffle(false)
	Hud.objective(nil)
	Hud.marker(nil)
	Hud.hideSay()
	Hud.letterbox(false, 0.2)
	setBodyHidden(false)
	local _, hum, root = Controls.character()
	if hum then
		hum.Sit = false
		hum.PlatformStand = false
	end
	if root then root.Anchored = false end
	state = "idle"
end

function Story.state() return state end
function Story.hideBody(on) setBodyHidden(on) end
function Story.inGame() return state == "roam" or state == "scene" or state == "intro" end

return Story
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Общие помощники клиента: математика, сглаживание, твины, «уборщик» (Trove) и пауза.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local U = {}

function U.lerp(a, b, t) return a + (b - a) * t end
function U.clamp01(t) return math.clamp(t, 0, 1) end
function U.smooth(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
function U.smoother(t)
	t = math.clamp(t, 0, 1)
	return t * t * t * (t * (t * 6 - 15) + 10)
end
function U.easeOutBack(t)
	local c1, c3 = 1.4, 2.4
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end
-- экспоненциальное сглаживание, не зависящее от частоты кадров
function U.damp(current, target, speed, dt)
	return current + (target - current) * (1 - math.exp(-speed * dt))
end

-- твин с удобными значениями по умолчанию; возвращает Tween
function U.tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Пауза игры: сюжетные ожидания идут только когда игра не на паузе
U.paused = false
local pauseChanged = Instance.new("BindableEvent")
U.PauseChanged = pauseChanged.Event
function U.setPaused(p)
	if U.paused == p then return end
	U.paused = p
	pauseChanged:Fire(p)
end

-- ожидание в «игровом» времени (замирает на паузе)
function U.wait(t)
	local left = t or 0
	local start = os.clock()
	while left > 0 do
		local dt = RunService.Heartbeat:Wait()
		if not U.paused then left = left - dt end
	end
	return os.clock() - start
end

-- ждать, пока cond() не вернёт true (с проверкой каждый кадр)
function U.waitUntil(cond, timeout)
	local t0 = os.clock()
	while not cond() do
		RunService.Heartbeat:Wait()
		if timeout and os.clock() - t0 > timeout then return false end
	end
	return true
end

-- Trove: собирает объекты и подключения, чтобы потом убрать всё разом
local Trove = {}
Trove.__index = Trove
function U.trove()
	return setmetatable({ items = {} }, Trove)
end
function Trove:add(x)
	table.insert(self.items, x)
	return x
end
function Trove:clean()
	local items = self.items
	self.items = {}
	for i = #items, 1, -1 do
		local x = items[i]
		local t = typeof(x)
		if t == "RBXScriptConnection" then
			x:Disconnect()
		elseif t == "Instance" then
			x:Destroy()
		elseif type(x) == "function" then
			local ok, err = pcall(x)
			if not ok then warn("[RM] уборка: " .. tostring(err)) end
		elseif type(x) == "table" and x.Destroy then
			x:Destroy()
		end
	end
end

-- простой сигнал (на BindableEvent)
function U.signal()
	local be = Instance.new("BindableEvent")
	return {
		Event = be.Event,
		Fire = function(_, ...) be:Fire(...) end,
		Connect = function(_, f) return be.Event:Connect(f) end,
		Wait = function() return be.Event:Wait() end,
		Destroy = function() be:Destroy() end,
	}
end

-- Кривая Катмулла — Рома по точкам (Vector3), t от 0 до 1
function U.catmull(points, t)
	local n = #points
	if n == 1 then return points[1] end
	local seg = (n - 1) * math.clamp(t, 0, 1)
	local i = math.min(math.floor(seg) + 1, n - 1)
	local u = seg - (i - 1)
	local p0 = points[math.max(i - 1, 1)]
	local p1 = points[i]
	local p2 = points[i + 1]
	local p3 = points[math.min(i + 2, n)]
	local u2, u3 = u * u, u * u * u
	return 0.5 * ((2 * p1) + (-p0 + p2) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * u2 + (-p0 + 3 * p1 - 3 * p2 + p3) * u3)
end

-- заглавные буквы и для кириллицы (string.upper её не трогает)
local LOWER = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
local UPPER = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
local map = {}
do
	local lo, up = {}, {}
	for _, c in utf8.codes(LOWER) do table.insert(lo, utf8.char(c)) end
	for _, c in utf8.codes(UPPER) do table.insert(up, utf8.char(c)) end
	for i = 1, #lo do map[lo[i]] = up[i] end
end
function U.upper(s)
	local out = {}
	for _, c in utf8.codes(s) do
		local ch = utf8.char(c)
		table.insert(out, map[ch] or string.upper(ch))
	end
	return table.concat(out)
end

return U
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Свет и атмосфера (стиль «мульт + свет»): пресеты «ночь» (меню) и «утро» (игра),
-- цветокоррекция, свечение, лучи солнца из окон (Beam) с пылинками, включение ламп по комнатам.
-- Качество эффектов берётся из настроек (Effects 1..3).
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local World = {}
local Config, Settings, U
local house
local cc, bloom, rays, atmos, sky
local beamsFolder
local preset = nil

local PRESETS = {
	night = {
		ClockTime = 0.3, Brightness = 1.2, Ambient = Color3.fromRGB(34, 38, 62), OutdoorAmbient = Color3.fromRGB(38, 44, 78),
		EnvironmentDiffuseScale = 0.35, EnvironmentSpecularScale = 0.2, ExposureCompensation = 0.25,
		cc = { Saturation = 0.16, Contrast = 0.14, Brightness = 0.01, TintColor = Color3.fromRGB(214, 224, 255) },
		bloom = { Intensity = 0.9, Size = 30, Threshold = 1.05 },
		rays = { Intensity = 0, Spread = 0.5 },
		atmos = { Density = 0.25, Offset = 0.1, Color = Color3.fromRGB(70, 82, 130), Decay = Color3.fromRGB(30, 34, 60), Glare = 0, Haze = 1.5 },
		lamps = { MortyNight = true },
		beams = false,
	},
	morning = {
		ClockTime = 7.45, Brightness = 3.1, Ambient = Color3.fromRGB(112, 112, 124), OutdoorAmbient = Color3.fromRGB(140, 138, 150),
		EnvironmentDiffuseScale = 0.55, EnvironmentSpecularScale = 0.25, ExposureCompensation = 0.12,
		cc = { Saturation = 0.2, Contrast = 0.07, Brightness = 0.02, TintColor = Color3.fromRGB(255, 247, 234) },
		bloom = { Intensity = 0.45, Size = 24, Threshold = 1.3 },
		rays = { Intensity = 0.045, Spread = 0.55 },
		atmos = { Density = 0.27, Offset = 0.12, Color = Color3.fromRGB(233, 216, 190), Decay = Color3.fromRGB(122, 146, 178), Glare = 0.45, Haze = 1.3 },
		lamps = { Kitchen = true },
		beams = true,
	},
}

local function ensure(class, name)
	local e = Lighting:FindFirstChild(name)
	if not e then
		e = Instance.new(class)
		e.Name = name
		e.Parent = Lighting
	end
	return e
end

function World.init(ctx)
	Config, Settings, U = ctx.Config, ctx.Settings, ctx.Util
	house = workspace:WaitForChild("House")
	cc = ensure("ColorCorrectionEffect", "RM_Color")
	bloom = ensure("BloomEffect", "RM_Bloom")
	rays = ensure("SunRaysEffect", "RM_Rays")
	atmos = ensure("Atmosphere", "RM_Atmosphere")
	sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Name = "RM_Sky"
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.StarCount = 3000
		sky.Parent = Lighting
	end
	pcall(function() Lighting.Technology = Enum.Technology.Future end)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.22
	Lighting.GeographicLatitude = 30
	beamsFolder = Instance.new("Folder")
	beamsFolder.Name = "RM_SunBeams"
	beamsFolder.Parent = workspace
	Settings.Changed:Connect(function(k)
		if k == "Effects" and preset then World.apply(preset, 0) end
	end)
end

-- включить лампы комнат из списка (остальные выключить)
local function setLamps(list)
	local lights = house:FindFirstChild("Lights")
	if not lights then return end
	for _, lamp in ipairs(lights:GetChildren()) do
		local room = lamp:GetAttribute("Room")
		if room then
			local on = list[room] == true
			for _, l in ipairs(lamp:GetChildren()) do
				if l:IsA("Light") then l.Enabled = on end
			end
			if lamp:GetAttribute("Glow") then
				lamp.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
		end
	end
end

-- лучи солнца из окна: сетка ленточных лучей (FaceCamera) от стекла по направлению света
local anchor -- невидимая деталь в начале координат, к ней крепятся точки лучей
local function beamsFor(windowName)
	if not anchor then
		anchor = Instance.new("Part")
		anchor.Name = "RM_BeamAnchor"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.CFrame = CFrame.new()
		anchor.Parent = beamsFolder
	end
	local wins = house:FindFirstChild("Windows")
	local w = wins and wins:FindFirstChild(windowName)
	local glass = w and w:FindFirstChild("Glass")
	if not glass then return end
	local sun = Lighting:GetSunDirection()
	local dir = -sun
	if dir.Y > -0.05 then return end -- солнце слишком низко или за горизонтом
	-- свет должен идти внутрь дома: проверяем по нормали стекла
	local n = glass.CFrame.LookVector
	local outward = (glass.Position - Vector3.new(28, glass.Position.Y, 20)).Unit
	if n:Dot(outward) > 0 then n = -n end -- n — нормаль внутрь дома
	if dir:Dot(n) <= 0.05 then return end
	local floorY = glass.Position.Y > 10 and 12 or 0
	local size = glass.Size
	local q = Settings.get("Effects")
	local cols = q >= 3 and 4 or 2
	local rows = q >= 3 and 3 or 2
	for i = 1, cols do
		for j = 1, rows do
			local lx = (i - 0.5) / cols - 0.5
			local ly = (j - 0.5) / rows - 0.5
			local p = glass.CFrame * Vector3.new(lx * size.X * 0.9, ly * size.Y * 0.9, 0)
			local len = (p.Y - floorY) / -dir.Y
			len = math.min(len, 45)
			local a0 = Instance.new("Attachment")
			a0.Parent = anchor
			a0.WorldPosition = p + dir * 0.6
			local a1 = Instance.new("Attachment")
			a1.Parent = anchor
			a1.WorldPosition = p + dir * len
			local b = Instance.new("Beam")
			b.Attachment0 = a0
			b.Attachment1 = a1
			b.FaceCamera = true
			b.Width0 = size.X / cols * 1.15
			b.Width1 = size.X / cols * 1.3
			b.Color = ColorSequence.new(Color3.fromRGB(255, 232, 186))
			b.LightEmission = 1
			b.LightInfluence = 0
			b.Brightness = 1.4
			b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.86), NumberSequenceKeypoint.new(0.6, 0.93), NumberSequenceKeypoint.new(1, 1) })
			b.Segments = 1
			b.Parent = beamsFolder
			a0.Name = "RM_BeamA"
			a1.Name = "RM_BeamB"
		end
	end
	-- пылинки в луче
	if q >= 2 then
		local mid = glass.Position + dir * 6
		local dust = Instance.new("Part")
		dust.Name = "RM_Dust"
		dust.Anchored = true
		dust.CanCollide = false
		dust.CanQuery = false
		dust.CanTouch = false
		dust.Transparency = 1
		dust.Size = Vector3.new(size.X, size.Y, 10)
		dust.CFrame = CFrame.lookAt(mid, mid + dir)
		dust.Parent = beamsFolder
		local pe = Instance.new("ParticleEmitter")
		pe.Rate = 7
		pe.Lifetime = NumberRange.new(5, 9)
		pe.Speed = NumberRange.new(0.05, 0.25)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new(0.07)
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(0.7, 0.45), NumberSequenceKeypoint.new(1, 1) })
		pe.LightEmission = 1
		pe.LightInfluence = 0
		pe.Color = ColorSequence.new(Color3.fromRGB(255, 240, 210))
		pe.Shape = Enum.ParticleEmitterShape.Box
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		pe.Parent = dust
	end
end

local function clearBeams()
	beamsFolder:ClearAllChildren()
	anchor = nil
end

-- применить пресет: name = "night" | "morning"; t — время перехода
function World.apply(name, t)
	preset = name
	local p = PRESETS[name]
	if not p then return end
	t = t or 0
	local q = Settings.get("Effects")
	local function to(obj, props)
		if t > 0 then
			TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props):Play()
		else
			for k, v in pairs(props) do obj[k] = v end
		end
	end
	Lighting.ClockTime = p.ClockTime
	-- утреннее солнце должно светить в окна на восточной стороне (+X); если в этой версии Roblox
	-- солнце в это время с другой стороны — берём зеркальное время дня (та же высота солнца)
	if p.beams and Lighting:GetSunDirection().X < 0 then Lighting.ClockTime = 24 - p.ClockTime end
	to(Lighting, { Brightness = p.Brightness, Ambient = p.Ambient, OutdoorAmbient = p.OutdoorAmbient,
		EnvironmentDiffuseScale = p.EnvironmentDiffuseScale, EnvironmentSpecularScale = p.EnvironmentSpecularScale,
		ExposureCompensation = p.ExposureCompensation })
	to(cc, p.cc)
	cc.Enabled = true
	bloom.Enabled = q >= 2
	to(bloom, p.bloom)
	rays.Enabled = q >= 3
	to(rays, p.rays)
	for k, v in pairs(p.atmos) do atmos[k] = v end
	if q <= 1 then atmos.Haze = 0 end
	Lighting.GlobalShadows = true
	setLamps(p.lamps)
	clearBeams()
	if p.beams and q >= 2 then
		beamsFor("MortyWindow")
		beamsFor("MortyWindow2")
		beamsFor("KitchenWindow")
	end
end

-- включить/выключить отдельную группу ламп (например, ночник)
function World.lamps(list) setLamps(list) end

local _u = U
return World
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000017"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[-- Помощники постройки (сервер и клиент): детали, клинья, цилиндры, шары, стены с проёмами,
-- свет, подсказки ProximityPrompt, надписи. Все детали по умолчанию закреплены (Anchored)
-- и сделаны из SmoothPlastic — это основа «мультяшного» стиля.
local B = {}

local function apply(o, props)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then o[k] = v end
		end
	end
end
B.apply = apply

-- цвет: Color3, "#RRGGBB" или r, g, b (0..255)
function B.color(r, g, b)
	if typeof(r) == "Color3" then return r end
	if type(r) == "string" then return Color3.fromHex(r) end
	return Color3.fromRGB(r, g, b)
end

-- чуть светлее/темнее (k > 1 — светлее), чтобы большие плоскости не были одного цвета
function B.shade(c, k)
	c = B.color(c)
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

-- ID ассета из Config: "" -> "", "123" -> "rbxassetid://123", "rbxasset://..." -> как есть
function B.asset(id)
	if id == nil or id == "" then return "" end
	if tonumber(id) then return "rbxassetid://" .. tostring(id) end
	return tostring(id)
end

-- материал по имени с запасным вариантом
function B.mat(name, fallback)
	local ok, m = pcall(function() return Enum.Material[name] end)
	if ok and m then return m end
	return fallback or Enum.Material.SmoothPlastic
end

function B.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name or "Model"
	m.Parent = parent
	return m
end

function B.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name or "Folder"
	f.Parent = parent
	return f
end

local function basePart(class, parent, name, size, cf, color, material, props)
	local p = Instance.new(class)
	p.Name = name or class
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	if color then p.Color = B.color(color) end
	p.Material = material or Enum.Material.SmoothPlastic
	apply(p, props)
	p.Parent = parent
	return p
end

-- прямоугольная деталь: size — Vector3, cf — CFrame центра
function B.part(parent, name, size, cf, color, material, props)
	return basePart("Part", parent, name, size, cf, color, material, props)
end

-- клин: вертикальная грань сзади (+Z), скат смотрит вперёд-вверх (−Z)
function B.wedge(parent, name, size, cf, color, material, props)
	return basePart("WedgePart", parent, name, size, cf, color, material, props)
end

-- цилиндр: ось вдоль X у cf; length — длина, d — диаметр
function B.cyl(parent, name, length, d, cf, color, material, props)
	local p = basePart("Part", parent, name, Vector3.new(length, d, d), cf, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- вертикальный цилиндр (ось вверх) с центром в cf
function B.vcyl(parent, name, height, d, cf, color, material, props)
	return B.cyl(parent, name, height, d, cf * CFrame.Angles(0, 0, math.rad(90)), color, material, props)
end

function B.ball(parent, name, d, cf, color, material, props)
	local p = basePart("Part", parent, name, Vector3.new(d, d, d), cf, color, material, props)
	p.Shape = Enum.PartType.Ball
	return p
end

-- невидимая служебная деталь (зоны, точки, якоря)
function B.marker(parent, name, size, cf, props)
	local p = basePart("Part", parent, name, size or Vector3.new(1, 1, 1), cf, nil, nil, props)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	apply(p, props)
	return p
end

-- Конструктор мебели: детали задаются в локальных координатах предмета (центр детали).
-- local P = B.kit(model, cf)
-- P(имя, sx, sy, sz, x, y, z, цвет, материал, свойства[, поворот CFrame])
-- P.cyl(имя, длина, d, x, y, z, цвет, ...)    — ось X; P.vcyl — ось Y; P.ball(имя, d, x, y, z, цвет, ...)
-- P.wedge(имя, sx, sy, sz, x, y, z, цвет, ...)
function B.kit(model, cf)
	local P = {}
	local function at(x, y, z, rot)
		local c = cf * CFrame.new(x, y, z)
		if rot then c = c * rot end
		return c
	end
	P.at = at
	P.cf = cf
	setmetatable(P, {
		__call = function(_, name, sx, sy, sz, x, y, z, color, material, props, rot)
			return B.part(model, name, Vector3.new(sx, sy, sz), at(x, y, z, rot), color, material, props)
		end,
	})
	function P.wedge(name, sx, sy, sz, x, y, z, color, material, props, rot)
		return B.wedge(model, name, Vector3.new(sx, sy, sz), at(x, y, z, rot), color, material, props)
	end
	function P.cyl(name, length, d, x, y, z, color, material, props, rot)
		return B.cyl(model, name, length, d, at(x, y, z, rot), color, material, props)
	end
	function P.vcyl(name, height, d, x, y, z, color, material, props, rot)
		return B.vcyl(model, name, height, d, at(x, y, z, rot), color, material, props)
	end
	function P.ball(name, d, x, y, z, color, material, props, rot)
		return B.ball(model, name, d, at(x, y, z, rot), color, material, props)
	end
	return P
end

-- Стена от точки a до точки b (низ стены), высота h, толщина th.
-- openings: { { at = расстояние от a до центра проёма, w = ширина, y0 = низ, y1 = верх }, ... }
-- Возвращает Model; куски стены называются "Wall".
function B.wall(parent, name, a, b, h, th, color, material, openings, props)
	local m = B.model(parent, name)
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local len = flat.Magnitude
	if len < 0.01 then return m end
	local frame = CFrame.fromMatrix(a, flat.Unit, Vector3.yAxis)
	local function seg(x0, x1, y0, y1)
		if x1 - x0 < 0.02 or y1 - y0 < 0.02 then return end
		B.part(m, "Wall", Vector3.new(x1 - x0, y1 - y0, th), frame * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), color, material, props)
	end
	local list = {}
	for _, o in ipairs(openings or {}) do table.insert(list, o) end
	table.sort(list, function(p, q) return p.at < q.at end)
	local cursor = 0
	for _, o in ipairs(list) do
		local x0, x1 = o.at - o.w / 2, o.at + o.w / 2
		if x0 > cursor then seg(cursor, x0, 0, h) end
		if (o.y0 or 0) > 0 then seg(math.max(x0, cursor), x1, 0, o.y0) end
		if (o.y1 or h) < h then seg(math.max(x0, cursor), x1, o.y1, h) end
		cursor = math.max(cursor, x1)
	end
	seg(cursor, len, 0, h)
	return m
end

-- источник света: class = "PointLight" | "SpotLight" | "SurfaceLight"
function B.light(parent, class, props)
	local l = Instance.new(class)
	l.Shadows = true
	apply(l, props)
	l.Parent = parent
	return l
end

-- подсказка взаимодействия (клавиша E). Стиль Custom — рисуем свою (Client/Prompts).
function B.prompt(parent, name, action, object, props)
	local p = Instance.new("ProximityPrompt")
	p.Name = name or "Prompt"
	p.ActionText = action or ""
	p.ObjectText = object or ""
	p.MaxActivationDistance = 7
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Style = Enum.ProximityPromptStyle.Custom
	apply(p, props)
	p.Parent = parent
	return p
end

-- надпись на грани детали (вывески, плакаты, экраны). Возвращает SurfaceGui и TextLabel.
function B.sign(part, face, text, props, guiProps)
	local g = Instance.new("SurfaceGui")
	g.Name = "Sign"
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 50
	g.LightInfluence = 1
	apply(g, guiProps)
	g.Parent = part
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text or ""
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.new(1, 1, 1)
	apply(l, props)
	l.Parent = g
	return g, l
end

-- пустой SurfaceGui на грани (для рисунков из Frame)
function B.surface(part, face, ppsu, guiProps)
	local g = Instance.new("SurfaceGui")
	g.Name = "Surface"
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = ppsu or 50
	g.LightInfluence = 1
	g.ClipsDescendants = true
	apply(g, guiProps)
	g.Parent = part
	return g
end

-- прямоугольник/круг/текст внутри GUI в долях (x, y, w, h от 0 до 1)
function B.rect(parent, x, y, w, h, color, props)
	local f = Instance.new("Frame")
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.BackgroundColor3 = B.color(color)
	f.BorderSizePixel = 0
	apply(f, props)
	f.Parent = parent
	return f
end
function B.circle(parent, x, y, w, h, color, props)
	local f = B.rect(parent, x, y, w, h, color, props)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	return f
end
function B.text(parent, x, y, w, h, text, color, font, props)
	local l = Instance.new("TextLabel")
	l.Position = UDim2.fromScale(x, y)
	l.Size = UDim2.fromScale(w, h)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextScaled = true
	l.Font = font or Enum.Font.GothamBlack
	l.TextColor3 = B.color(color or "#ffffff")
	apply(l, props)
	l.Parent = parent
	return l
end

function B.weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
	return w
end

function B.attrs(inst, t)
	for k, v in pairs(t) do inst:SetAttribute(k, v) end
	return inst
end

-- предмет обводится контуром (Client/Outline выбирает ближайшие и вешает Highlight)
function B.outline(model)
	model:SetAttribute("Outline", true)
	return model
end

-- CFrame: позиция + поворот вокруг вертикали в градусах
function B.at(x, y, z, yawDeg)
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yawDeg or 0), 0)
end

return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Общие настройки игры: цвета, размеры дома, звуки, тексты сюжета, настройки по умолчанию.
-- Тексты и ID звуков удобно править здесь — остальной код берёт их отсюда.
local Config = {}

Config.Version = "0.1"
Config.Title = "РИК И МОРТИ"
Config.Chapter = "ГЛАВА 1 · СБОЙ"

-- Размеры дома (в стадах). Этаж 1: пол y = 0, этаж 2: пол y = 12, высота стен 11.
Config.House = {
	Floor1 = 0, Floor2 = 12, WallH = 11,
	X0 = 0, X1 = 56, Z0 = 0, Z1 = 40,
}

-- Палитра «как в сериале»: яркие, чуть приглушённые цвета
Config.Colors = {
	Outline = Color3.fromRGB(26, 23, 32),
	Skin = Color3.fromRGB(250, 214, 178),
	MortyShirt = Color3.fromRGB(246, 214, 64),
	MortyPants = Color3.fromRGB(52, 94, 168),
	MortyHair = Color3.fromRGB(104, 62, 32),
	MortyShoes = Color3.fromRGB(235, 235, 235),
	Portal = Color3.fromRGB(120, 255, 70),
	PortalDark = Color3.fromRGB(30, 150, 40),
	PortalLight = Color3.fromRGB(225, 255, 160),
	UiLime = Color3.fromRGB(184, 240, 58),
	UiDark = Color3.fromRGB(11, 42, 18),
	UiCyan = Color3.fromRGB(44, 199, 224),
}

-- Звуки. Пустая строка — тишина (игра не ломается).
-- Музыку и общий файл эффектов загрузи в Studio (см. README, раздел «Звуки»).
Config.Sounds = {
	MusicMenu = "",          -- assets/sounds/MusicMenu.ogg
	MusicMorning = "",       -- assets/sounds/MusicMorning.ogg
	SfxAtlas = "",           -- assets/sounds/SfxAtlas.ogg — все короткие звуки в одном файле
	-- встроенные в Roblox звуки (работают без загрузки)
	Footstep = "rbxasset://sounds/action_footsteps_plastic.mp3",
	UiClick = "rbxasset://sounds/electronicpingshort.wav",
	-- двери (ID из библиотеки Roblox)
	DoorOpen = "7274931838",
	DoorClose = "6814493519",
}

-- Где какой звук лежит в SfxAtlas.ogg: { начало, конец } в секундах.
-- Таблица генерируется вместе с файлом (tools/gen_audio.py → assets/sounds/atlas.txt).
Config.Sfx = {
	Alarm = { 0.0, 1.6 },
	Click = { 2.0, 2.15 },
	Hover = { 2.4, 2.5 },
	Whoosh = { 3.0, 4.6 },
	PortalHum = { 5.0, 9.0 },
	Blink = { 9.5, 10.1 },
	Rustle = { 10.5, 11.9 },
	Step1 = { 12.5, 12.8 }, Step2 = { 13.0, 13.3 }, Step3 = { 13.5, 13.8 }, Step4 = { 14.0, 14.3 },
	AlarmOff = { 14.5, 14.8 },
	Pour = { 15.0, 17.0 },
	Milk = { 17.5, 19.5 },
	Crunch1 = { 20.0, 20.7 }, Crunch2 = { 21.0, 21.7 }, Crunch3 = { 22.0, 22.7 },
	Spoon = { 23.0, 23.4 },
	PhoneOut = { 23.8, 24.4 },
	PhoneTap = { 24.6, 24.75 },
	Swipe = { 25.0, 25.4 },
	TikTokSong = { 25.8, 33.8 },
	Glitch = { 34.2, 37.2 },
	Vibrate = { 37.6, 38.6 },
	Notify = { 39.0, 39.8 },
	Sting = { 40.2, 42.6 },
	Birds = { 43.0, 55.0 },
	Thought = { 55.5, 56.1 },
	Locked = { 56.5, 57.0 },
	Paper = { 57.4, 58.0 },
	Chair = { 58.4, 59.2 },
}

-- Настройки по умолчанию (меню «Настройки»)
Config.DefaultSettings = {
	Music = 0.6,          -- громкость музыки 0..1
	Sfx = 0.85,           -- громкость звуков 0..1
	Sensitivity = 1.0,    -- чувствительность мыши 0.2..2
	Fov = 72,             -- поле зрения 60..95
	HeadBob = true,       -- покачивание камеры при ходьбе
	Outlines = true,      -- чёрные контуры предметов
	Effects = 3,          -- эффекты: 1 низкие, 2 средние, 3 высокие
	Subtitles = 2,        -- размер субтитров: 1 мелкие, 2 средние, 3 крупные
	Hints = true,         -- маркер цели и подсказки
}

-- Тексты сюжета (Морти немного заикается — как в сериале)
Config.Text = {
	DayCard = "Понедельник. 7:30",
	Alarm = "[будильник пищит]",
	Wake1 = "Ммм… уже утро?",
	Wake2 = "Б-блин, опять понедельник…",
	GetUpHint = "Встать",
	AlarmObjective = "Выключи будильник",
	AlarmDone = "Фух. Т-тишина…",
	BreakfastObjective = "Спустись на кухню и позавтракай",
	Hungry = "Живот урчит. Н-надо поесть.",
	KitchenHint = "Кухня на первом этаже — по лестнице вниз",
	SitObjective = "Сядь за стол",
	PourObjective = "Насыпь хлопья",
	MilkObjective = "Налей молоко",
	EatObjective = "Позавтракай",
	Yum = "М-м… хрустят.",
	Full = "Ух, наелся.",
	PhoneObjective = "Достань телефон",
	PhoneThink = "Т-так, что там нового в ТикТоке?",
	SwipeObjective = "Листай ленту",
	Lag1 = "Ну давай, грузись…",
	WhatThe = "Б-блин, ч-что за фигня с телефоном?!",
	ToBeContinued = "ПРОДОЛЖЕНИЕ СЛЕДУЕТ…",
	ChapterEnd = "КОНЕЦ ГЛАВЫ 1",
	Thanks = "Спасибо, что поиграли!",
	-- случайные мысли у предметов
	SummerDoor = "Саммер меня убьёт, если я зайду.",
	ParentsDoor = "Мама с папой уже ушли на работу.",
	GarageDoor = "З-закрыто. Рик опять что-то мастерит…",
	FrontDoor = "Сначала позавтракаю.",
	BackDoor = "Во двор потом.",
	Computer = "П-поиграю после школы.",
	Window = "Хорошая погода. Даже жалко идти в школу.",
	Poster = "Мой любимый плакат.",
	Mirror = "Ну и причёска…",
	Tv = "Нет времени на телек.",
	Fridge = "Хм, тут записка от мамы.",
	Note = "Морти!\nХлопья и молоко на столе.\nНе опоздай в школу!\nЦелую, мама.\n\nP.S. Не буди дедушку.",
	Bed = "Н-не, второй раз я не усну.",
	Backpack = "Рюкзак. Домашку я, конечно, не сделал.",
	Clock = "Будильник. Уже тихий.",
	Toilet = "Не сейчас.",
	PhotoFamily = "Семейное фото. Дедушка тут какой-то странный.",
}

-- Задержки и скорости
Config.WalkSpeed = 12
Config.RunSpeed = 18
Config.HintDelay = 35       -- через сколько секунд без прогресса показать подсказку

return Config
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX00000020"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000019"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Запуск сервера: строим дом Смитов, двери и улицу, настраиваем персонажей (все — Морти).
-- Сюжет, меню и камера работают на клиенте (StarterPlayerScripts/Client).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Server = script.Parent:WaitForChild("Server")

local ctx = {
	Build = require(Shared:WaitForChild("Build")),
	Config = require(Shared:WaitForChild("Config")),
}
ctx.House = require(Server:WaitForChild("House"))
local Rooms = require(Server:WaitForChild("Rooms"))
local Doors = require(Server:WaitForChild("Doors"))
local Exterior = require(Server:WaitForChild("Exterior"))
local Characters = require(Server:WaitForChild("Characters"))

Players.CharacterAutoLoads = true
Characters.init(ctx)

local root = Instance.new("Model")
root.Name = "House"
local ok, err = pcall(function()
	ctx.House.build(ctx, root)
	Rooms.build(ctx, root)
	Doors.build(ctx, root)
	Exterior.build(ctx, root)
end)
if not ok then warn("[RM] ошибка постройки дома: " .. tostring(err)) end

-- точка появления — у кровати Морти (сюжет всё равно переставит персонажа)
local spawn = Instance.new("SpawnLocation")
spawn.Name = "MortySpawn"
spawn.Size = Vector3.new(4, 0.2, 4)
spawn.CFrame = CFrame.new(46.5, 12.1, 33.5)
spawn.Anchored = true
spawn.Transparency = 1
spawn.CanCollide = false
spawn.CanQuery = false
spawn.Neutral = true
spawn.Duration = 0
spawn.Parent = root

root.Parent = workspace
root:SetAttribute("Ready", true)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[-- Персонаж: каждый игрок — Морти (жёлтая футболка, синие штаны, каштановые волосы).
-- Игроки не толкают друг друга (группа столкновений Players).
local Characters = {}

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")

local B, C

local function hair(char)
	local head = char:FindFirstChild("Head")
	if not head or char:FindFirstChild("MortyHair") then return end
	local m = Instance.new("Model")
	m.Name = "MortyHair"
	local col = C.Colors.MortyHair
	local s = head.Size.Y / 1.2
	local function blob(name, size, offset, rot)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(1, 1, 1)
		p.Color = col
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = true
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = size * s
		mesh.Parent = p
		p.CFrame = head.CFrame * CFrame.new(offset * s) * (rot or CFrame.new())
		p.Parent = m
		B.weld(head, p)
		return p
	end
	-- шапка волос (сверху и сзади), чёлка и пара прядей
	blob("Cap", Vector3.new(1.32, 0.78, 1.3), Vector3.new(0, 0.38, 0.08))
	blob("Back", Vector3.new(1.28, 0.9, 0.7), Vector3.new(0, 0.12, 0.38))
	blob("Fringe", Vector3.new(1.1, 0.34, 0.5), Vector3.new(0.05, 0.5, -0.42), CFrame.Angles(math.rad(-20), 0, math.rad(-6)))
	blob("SideL", Vector3.new(0.3, 0.6, 0.7), Vector3.new(-0.6, 0.15, 0.1))
	blob("SideR", Vector3.new(0.3, 0.6, 0.7), Vector3.new(0.6, 0.15, 0.1))
	m.Parent = char
end

local function setGroup(char)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CollisionGroup = "Players" end
	end
	char.DescendantAdded:Connect(function(p)
		if p:IsA("BasePart") then p.CollisionGroup = "Players" end
	end)
end

local function mortify(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = C.Colors.Skin
	desc.LeftArmColor = C.Colors.Skin
	desc.RightArmColor = C.Colors.Skin
	desc.TorsoColor = C.Colors.MortyShirt
	desc.LeftLegColor = C.Colors.MortyPants
	desc.RightLegColor = C.Colors.MortyPants
	desc.HeightScale = 0.92
	desc.WidthScale = 0.95
	desc.DepthScale = 0.95
	desc.HeadScale = 1.12
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	local ok, err = pcall(function() hum:ApplyDescription(desc) end)
	if not ok then warn("[RM] не удалось применить внешность Морти: " .. tostring(err)) end
	-- рукава футболки и кроссовки
	for _, n in ipairs({ "LeftUpperArm", "RightUpperArm", "UpperTorso", "LowerTorso" }) do
		local p = char:FindFirstChild(n)
		if p then p.Color = C.Colors.MortyShirt end
	end
	local lt = char:FindFirstChild("LowerTorso")
	if lt then lt.Color = C.Colors.MortyPants end
	for _, n in ipairs({ "LeftFoot", "RightFoot" }) do
		local p = char:FindFirstChild(n)
		if p then p.Color = C.Colors.MortyShoes end
	end
	hair(char)
	hum.DisplayName = "Морти"
	hum.WalkSpeed = C.WalkSpeed
	hum.UseJumpPower = false
	hum.JumpHeight = 4
end

function Characters.init(ctx)
	B, C = ctx.Build, ctx.Config
	pcall(function() PhysicsService:RegisterCollisionGroup("Players") end)
	pcall(function() PhysicsService:CollisionGroupSetCollidable("Players", "Players", false) end)
	local function onPlayer(plr)
		plr.CharacterAdded:Connect(function(char)
			setGroup(char)
			task.defer(function()
				local ok, err = pcall(mortify, char)
				if not ok then warn("[RM] mortify: " .. tostring(err)) end
			end)
		end)
		if plr.Character then
			setGroup(plr.Character)
			task.defer(mortify, plr.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
end

return Characters
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Doors</string><ProtectedString name="Source"><![CDATA[-- Двери: полотно на петлях, открытие по E (ProximityPrompt), часть дверей заперта.
-- Состояние двери общее для всех игроков (сервер), мысль Морти у запертой двери показывает клиент
-- (атрибут Thought на подсказке).
local Doors = {}

local TweenService = game:GetService("TweenService")

local B, C, House

-- into: в какую сторону по нормали к стене открывается (+1 — к большему x/z), hinge: low/high край проёма
local SPEC = {
	Morty = { into = 1, hinge = "high", color = "#F4EFE6", sign = "МОРТИ", open = 0 },
	Summer = { into = 1, hinge = "low", color = "#F4EFE6", locked = "SummerDoor", sign = "НЕ ВХОДИТЬ!" },
	Parents = { into = -1, hinge = "low", color = "#F4EFE6", locked = "ParentsDoor" },
	Bath = { into = -1, hinge = "high", color = "#F4EFE6", open = 0.35 },
	Mudroom = { into = 1, hinge = "low", color = "#F4EFE6", open = 0 },
	Garage = { into = 1, hinge = "high", color = "#C9C2B4", locked = "GarageDoor", sign = "ГАРАЖ" },
	Front = { into = 1, hinge = "low", color = "#7A4A2E", locked = "FrontDoor", front = true },
	Back = { into = -1, hinge = "high", color = "#7A4A2E", locked = "BackDoor", glass = true },
}

local function buildDoor(id, spec, parent)
	local o = House.opening(id)
	if not o then return nil end
	local y = o.fl == 1 and C.House.Floor1 or C.House.Floor2
	local w, h = o.w, o.y1 - o.y0
	-- локальная система: X — вдоль стены от петли, Z — нормаль стены (+Z — в сторону into)
	local hingeAt = spec.hinge == "high" and (o.c + w / 2) or (o.c - w / 2)
	local dirAlong = spec.hinge == "high" and -1 or 1 -- куда от петли идёт полотно
	local hingePos, alongVec, normalVec
	if o.axis == "z" then
		hingePos = Vector3.new(hingeAt, y, o.at)
		alongVec = Vector3.new(dirAlong, 0, 0)
		normalVec = Vector3.new(0, 0, spec.into)
	else
		hingePos = Vector3.new(o.at, y, hingeAt)
		alongVec = Vector3.new(0, 0, dirAlong)
		normalVec = Vector3.new(spec.into, 0, 0)
	end
	local upVec = Vector3.yAxis
	-- правая тройка: X = along, Y = up, Z = X × Y; если она смотрит не туда — открываем в −Z
	local zVec = alongVec:Cross(upVec)
	local openSign = (zVec:Dot(normalVec) > 0) and 1 or -1
	local hingeCF = CFrame.fromMatrix(hingePos, alongVec, upVec)

	local m = B.model(parent, "Door_" .. id)
	B.attrs(m, { Kind = "Door", Locked = spec.locked ~= nil, Open = false })
	local leaf = B.model(m, "Leaf")
	local lw, lh, th = w - 0.2, h - 0.12, 0.32
	local P = B.kit(leaf, hingeCF * CFrame.new(lw / 2 + 0.05, lh / 2 + 0.02, 0))
	local panel = P("Panel", lw, lh, th, 0, 0, 0, spec.color)
	leaf.PrimaryPart = panel
	-- филёнки с обеих сторон
	local inset = B.shade(spec.color, 0.92)
	for _, s in ipairs({ -1, 1 }) do
		if spec.glass then
			P("Glass", lw * 0.55, lh * 0.32, 0.06, 0, lh * 0.22, s * (th / 2), "#CFEAFF", Enum.Material.Glass, { Transparency = 0.5 })
			P("Inset", lw * 0.62, lh * 0.32, 0.06, 0, -lh * 0.22, s * (th / 2 + 0.02), inset)
		else
			P("Inset", lw * 0.62, lh * 0.34, 0.06, 0, lh * 0.2, s * (th / 2 + 0.02), inset)
			P("Inset", lw * 0.62, lh * 0.34, 0.06, 0, -lh * 0.2, s * (th / 2 + 0.02), inset)
		end
		-- ручка
		P.ball("Knob", 0.42, lw / 2 - 0.45, -lh / 2 + 3.7, s * (th / 2 + 0.22), "#D8B25A", Enum.Material.Metal)
		P("KnobBase", 0.25, 0.6, 0.12, lw / 2 - 0.45, -lh / 2 + 3.7, s * (th / 2 + 0.05), "#C79E4A", Enum.Material.Metal)
	end
	if spec.sign then
		local plate = P("Plate", 2.2, 0.9, 0.08, 0, lh * 0.36, -openSign * (th / 2 + 0.06), spec.locked and "#E25B7E" or "#4A7BD0")
		B.sign(plate, openSign > 0 and Enum.NormalId.Front or Enum.NormalId.Back, spec.sign, { Font = Enum.Font.GothamBlack })
	end
	for _, p in ipairs(leaf:GetDescendants()) do
		if p:IsA("BasePart") and p ~= panel then
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	-- подсказка
	local prompt = B.prompt(panel, "Prompt", "Открыть", "", { MaxActivationDistance = 7, HoldDuration = 0 })
	if spec.locked then
		prompt:SetAttribute("Thought", spec.locked)
		prompt:SetAttribute("Locked", true)
	end
	m:SetAttribute("DoorId", id)

	local angle = Instance.new("NumberValue")
	angle.Name = "Angle"
	angle.Parent = m
	local closedCF = hingeCF * CFrame.new(lw / 2 + 0.05, lh / 2 + 0.02, 0)
	local function place(a)
		-- поворот вокруг вертикали в петле: свободный край уходит в сторону into
		local rot = CFrame.Angles(0, -openSign * math.rad(a), 0)
		leaf:PivotTo(hingeCF * rot * CFrame.new(lw / 2 + 0.05, lh / 2 + 0.02, 0))
	end
	angle.Changed:Connect(function(a) place(a) end)
	local busy = false
	local function setOpen(open, who)
		if busy then return end
		busy = true
		m:SetAttribute("Open", open)
		prompt.ActionText = open and "Закрыть" or "Открыть"
		local snd = Instance.new("Sound")
		snd.SoundId = B.asset(open and C.Sounds.DoorOpen or C.Sounds.DoorClose)
		snd.Volume = 0.5
		snd.RollOffMaxDistance = 60
		snd.Parent = panel
		if snd.SoundId ~= "" then snd:Play() end
		task.delay(3, function() snd:Destroy() end)
		local tw = TweenService:Create(angle, TweenInfo.new(open and 0.7 or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = open and 100 or 0 })
		tw:Play()
		tw.Completed:Wait()
		busy = false
	end
	prompt.Triggered:Connect(function(plr)
		if spec.locked then
			-- подёргать ручку
			local t0 = TweenService:Create(angle, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 1, true), { Value = 1.5 })
			t0:Play()
			return
		end
		setOpen(not m:GetAttribute("Open"), plr)
	end)
	if spec.open and spec.open > 0 then
		angle.Value = 100 * spec.open
		place(angle.Value)
		m:SetAttribute("Open", true)
		prompt.ActionText = "Закрыть"
	else
		leaf:PivotTo(closedCF)
	end
	return m
end

function Doors.build(ctx, root)
	B, C, House = ctx.Build, ctx.Config, ctx.House
	local f = B.folder(root, "Doors")
	for id, spec in pairs(SPEC) do
		buildDoor(id, spec, f)
	end
	return f
end

return Doors
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Exterior</string><ProtectedString name="Source"><![CDATA[-- Улица вокруг дома: газон, дорожки, подъездная дорога, улица, соседние дома, деревья, забор.
-- Внутрь соседних домов не попасть — это декорации для вида из окон.
local Exterior = {}

local B, C
local GROUND = -1.2

local function tree(parent, x, z, s, kind)
	local m = B.model(parent, "Tree")
	B.outline(m)
	s = s or 1
	B.vcyl(m, "Trunk", 9 * s, 1.6 * s, CFrame.new(x, GROUND + 4.5 * s, z), "#7A5235")
	local leaf = kind == 2 and "#5E9E3E" or "#4E8F3A"
	B.ball(m, "Crown", 9 * s, CFrame.new(x, GROUND + 11 * s, z), leaf)
	B.ball(m, "Crown", 6.5 * s, CFrame.new(x + 3 * s, GROUND + 9.5 * s, z + 1.5 * s), B.shade(leaf, 1.12))
	B.ball(m, "Crown", 6 * s, CFrame.new(x - 2.8 * s, GROUND + 10 * s, z - 1.6 * s), B.shade(leaf, 0.9))
	return m
end

local function bush(parent, x, z, s)
	local m = B.model(parent, "Bush")
	B.ball(m, "Bush", 3.2 * s, CFrame.new(x, GROUND + 1.2 * s, z), "#5A9E45")
	B.ball(m, "Bush", 2.4 * s, CFrame.new(x + 1.4 * s, GROUND + 1.0 * s, z + 0.6 * s), "#6AAE52")
	return m
end

-- соседний дом (коробка с двускатной крышей, окна, дверь)
local function neighbour(parent, cx, cz, w, d, h, wall, roofCol, facing)
	local m = B.model(parent, "Neighbour")
	local base = CFrame.new(cx, GROUND, cz) * CFrame.Angles(0, math.rad(facing or 0), 0)
	local P = B.kit(m, base)
	P("Body", w, h, d, 0, h / 2, 0, wall)
	P("Foundation", w + 0.6, 1.2, d + 0.6, 0, 0.6, 0, "#B9B3A8", Enum.Material.Concrete)
	local rise = d * 0.32
	P.wedge("Roof", w + 2, rise, d / 2 + 1, 0, h + rise / 2, -d / 4 - 0.5, roofCol)
	P.wedge("Roof", w + 2, rise, d / 2 + 1, 0, h + rise / 2, d / 4 + 0.5, roofCol, nil, nil, CFrame.Angles(0, math.rad(180), 0))
	-- окна на фасаде (−Z) и сзади
	local cols = math.max(2, math.floor(w / 9))
	for fl = 0, 1 do
		for i = 0, cols - 1 do
			local x = -w / 2 + (i + 0.5) * w / cols
			if not (fl == 0 and i == math.floor(cols / 2)) then
				P("Win", 3.6, 4.2, 0.2, x, 4 + fl * 11, -d / 2 - 0.05, "#7FB2D6", Enum.Material.Glass, { Transparency = 0.15 })
				P("WinFrame", 4.2, 4.8, 0.15, x, 4 + fl * 11, -d / 2 - 0.02, "#F6F2EA")
			end
			P("WinB", 3.6, 4.2, 0.2, x, 4 + fl * 11, d / 2 + 0.05, "#7FB2D6", Enum.Material.Glass, { Transparency = 0.15 })
			P("WinBFrame", 4.2, 4.8, 0.15, x, 4 + fl * 11, d / 2 + 0.02, "#F6F2EA")
		end
	end
	P("Door", 4, 7.5, 0.3, (math.floor(cols / 2) + 0.5) * w / cols - w / 2, 4.95, -d / 2 - 0.1, "#7A4A2E")
	-- боковые окна
	for fl = 0, 1 do
		P("WinS", 0.2, 4.2, 3.6, -w / 2 - 0.05, 4 + fl * 11, 0, "#7FB2D6", Enum.Material.Glass, { Transparency = 0.15 })
		P("WinS", 0.2, 4.2, 3.6, w / 2 + 0.05, 4 + fl * 11, 0, "#7FB2D6", Enum.Material.Glass, { Transparency = 0.15 })
	end
	return m
end

function Exterior.build(ctx, root)
	B, C = ctx.Build, ctx.Config
	local ext = B.folder(root, "Exterior")
	-- земля
	B.part(ext, "Grass", Vector3.new(1000, 2, 1000), CFrame.new(28, GROUND - 1, 20), "#7DB65A", Enum.Material.Grass)
	-- улица перед домом (z < −22)
	B.part(ext, "Street", Vector3.new(1000, 0.2, 26), CFrame.new(28, GROUND + 0.05, -42), "#5B5E66", Enum.Material.Asphalt)
	for x = -200, 260, 16 do
		B.part(ext, "Line", Vector3.new(7, 0.05, 0.6), CFrame.new(x, GROUND + 0.18, -42), "#F2D85A")
	end
	B.part(ext, "Sidewalk", Vector3.new(1000, 0.5, 5), CFrame.new(28, GROUND + 0.25, -26.5), "#C9C4B8", Enum.Material.Concrete)
	B.part(ext, "Sidewalk", Vector3.new(1000, 0.5, 5), CFrame.new(28, GROUND + 0.25, -57.5), "#C9C4B8", Enum.Material.Concrete)
	B.part(ext, "Curb", Vector3.new(1000, 0.6, 0.5), CFrame.new(28, GROUND + 0.3, -29.2), "#B3AEA2", Enum.Material.Concrete)
	-- дорожка к крыльцу и подъезд к гаражу
	B.part(ext, "Path", Vector3.new(4.5, 0.3, 16), CFrame.new(32, GROUND + 0.15, -16), "#C9C4B8", Enum.Material.Concrete)
	B.part(ext, "Driveway", Vector3.new(18, 0.25, 26), CFrame.new(68.5, GROUND + 0.12, -14), "#A7A39B", Enum.Material.Concrete)
	-- почтовый ящик
	local mb = B.model(ext, "Mailbox")
	B.outline(mb)
	B.part(mb, "Post", Vector3.new(0.4, 3.6, 0.4), CFrame.new(38, GROUND + 1.8, -22.5), "#6B4226")
	B.part(mb, "Box", Vector3.new(1.0, 1.0, 1.8), CFrame.new(38, GROUND + 4.0, -22.5), "#3B6FB0")
	B.part(mb, "Flag", Vector3.new(0.1, 0.8, 0.3), CFrame.new(38.55, GROUND + 4.4, -22.2), "#D23B3B")
	-- машина у гаража (простая, мультяшная)
	local car = B.model(ext, "Car")
	B.outline(car)
	local P = B.kit(car, CFrame.new(68.5, GROUND, -12))
	P("Body", 7.0, 2.4, 13, 0, 2.2, 0, "#C9D6E2")
	P("Cabin", 6.2, 2.2, 6.5, 0, 4.4, 0.8, "#B3C3D2")
	P("Windshield", 5.8, 1.8, 0.15, 0, 4.4, -2.5, "#5C7A92", Enum.Material.Glass, { Transparency = 0.1 })
	for _, w in ipairs({ { -3.4, -4 }, { 3.4, -4 }, { -3.4, 4.2 }, { 3.4, 4.2 } }) do
		P.cyl("Wheel", 1.0, 2.4, w[1], 1.2, w[2], "#222226")
	end
	P("Light", 1.2, 0.6, 0.1, -2.4, 2.6, -6.55, "#FFF6C2", Enum.Material.Neon)
	P("Light", 1.2, 0.6, 0.1, 2.4, 2.6, -6.55, "#FFF6C2", Enum.Material.Neon)
	-- забор вокруг заднего двора
	local fence = B.model(ext, "Fence")
	local function fenceLine(a, b)
		local d = (b - a)
		local n = math.floor(d.Magnitude / 1.4)
		for i = 0, n do
			local p = a + d * (i / n)
			B.part(fence, "Board", Vector3.new(1.0, 5, 0.25), CFrame.lookAt(p + Vector3.new(0, GROUND + 2.5, 0), p + Vector3.new(0, GROUND + 2.5, 0) + Vector3.new(d.Z, 0, -d.X)), "#F4EFE6")
		end
		local mid = (a + b) / 2
		B.part(fence, "Rail", Vector3.new(0.3, 0.4, d.Magnitude), CFrame.lookAt(mid + Vector3.new(0, GROUND + 3.8, 0), mid + Vector3.new(0, GROUND + 3.8, 0) + d), "#E6E0D4")
	end
	fenceLine(Vector3.new(-14, 0, 6), Vector3.new(-14, 0, 86))
	fenceLine(Vector3.new(-14, 0, 86), Vector3.new(96, 0, 86))
	fenceLine(Vector3.new(96, 0, 86), Vector3.new(96, 0, 6))
	-- деревья и кусты
	tree(ext, 74, 40, 1.15, 1)      -- в лучах утреннего солнца у окна Морти
	tree(ext, -8, 64, 1.0, 2)
	tree(ext, 40, 70, 1.25, 1)
	tree(ext, 10, -20, 0.9, 2)
	tree(ext, 90, -20, 1.0, 1)
	tree(ext, -40, -70, 1.1, 2)
	tree(ext, 120, -72, 1.0, 1)
	for _, b in ipairs({ { 4, -3 }, { 12, -3 }, { 20, -3 }, { 44, -3 }, { 50, -3 }, { 2, 44 }, { 54, 44 } }) do
		bush(ext, b[1], b[2], 1)
	end
	-- клумба и качели на заднем дворе
	local sw = B.model(ext, "Swing")
	B.outline(sw)
	B.part(sw, "Post", Vector3.new(0.5, 10, 0.5), CFrame.new(20, GROUND + 5, 62) * CFrame.Angles(0, 0, math.rad(8)), "#C23B3B")
	B.part(sw, "Post", Vector3.new(0.5, 10, 0.5), CFrame.new(28, GROUND + 5, 62) * CFrame.Angles(0, 0, math.rad(-8)), "#C23B3B")
	B.part(sw, "Bar", Vector3.new(9, 0.5, 0.5), CFrame.new(24, GROUND + 9.8, 62), "#C23B3B")
	B.part(sw, "Seat", Vector3.new(2.2, 0.3, 1), CFrame.new(24, GROUND + 2.5, 62), "#3B6FB0")
	-- соседи
	local nb = B.folder(ext, "Neighbours")
	neighbour(nb, -48, 18, 40, 30, 22, "#D7C3E0", "#5E5A6E", 0)
	neighbour(nb, 140, 18, 44, 30, 22, "#BFD8C0", "#6B5E57", 0)
	neighbour(nb, -10, -84, 42, 30, 22, "#F0D2A6", "#6E5E57", 180)
	neighbour(nb, 50, -84, 40, 30, 22, "#C8DCEA", "#5A5E6E", 180)
	neighbour(nb, 110, -84, 42, 30, 22, "#E8C9C0", "#6E5E57", 180)
	-- фонари на улице
	for _, x in ipairs({ -20, 46, 110 }) do
		local lp = B.model(ext, "StreetLamp")
		B.part(lp, "Pole", Vector3.new(0.6, 16, 0.6), CFrame.new(x, GROUND + 8, -30), "#3A3A44")
		B.part(lp, "Arm", Vector3.new(0.4, 0.4, 3), CFrame.new(x, GROUND + 15.8, -31.3), "#3A3A44")
		B.part(lp, "Bulb", Vector3.new(1.2, 0.6, 1.2), CFrame.new(x, GROUND + 15.4, -32.6), "#FFF1C6")
	end
	return ext
end

return Exterior
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">House</string><ProtectedString name="Source"><![CDATA[-- Дом Смитов: каркас (полы, потолки, стены с проёмами, окна, лестница, крыша, гараж, крыльцо).
-- Мебель расставляет Rooms.lua, двери — Doors.lua, улицу — Exterior.lua.
--
-- План (вид сверху, x — вправо, z — вниз; улица со стороны z < 0):
--   Этаж 1 (пол y = 0):  гостиная x 0..22 | прихожая и столовая x 22..36 (лестница у стены x 22.5..28.5,
--                        z 4..20, подъём к z = 20) | кладовая x 36..56, z 0..14 | кухня x 36..56, z 14..40
--   Этаж 2 (пол y = 12): спальня родителей x 0..22, z 0..26 | ванная x 0..22, z 26..40 | коридор x 22..36 |
--                        комната Саммер x 36..56, z 0..20 | комната Морти x 36..56, z 20..40
local House = {}

local B, C
local H

-- Комнаты: этаж, границы, цвета стен/пола/потолка, материал пола
local ROOMS = {
	{ id = "Living", label = "Гостиная", fl = 1, x0 = 0, x1 = 22, z0 = 0, z1 = 40, wall = "#BFCC9A", floor = "#A9764B", fmat = "WoodPlanks", ceil = "#F3EEE4" },
	{ id = "Foyer", label = "Прихожая", fl = 1, x0 = 22, x1 = 36, z0 = 0, z1 = 40, wall = "#E9D6B5", floor = "#A0704A", fmat = "WoodPlanks", ceil = "#F3EEE4" },
	{ id = "Mudroom", label = "Кладовая", fl = 1, x0 = 36, x1 = 56, z0 = 0, z1 = 14, wall = "#D8D2C2", floor = "#9C9488", fmat = "Slate", ceil = "#F0EDE6" },
	{ id = "Kitchen", label = "Кухня", fl = 1, x0 = 36, x1 = 56, z0 = 14, z1 = 40, wall = "#F1DB9F", floor = "checker", ceil = "#F6F1E6" },
	{ id = "Parents", label = "Спальня", fl = 2, x0 = 0, x1 = 22, z0 = 0, z1 = 26, wall = "#D9B7B0", floor = "#B9A48C", fmat = "Fabric", ceil = "#F3EEE4" },
	{ id = "Bath", label = "Ванная", fl = 2, x0 = 0, x1 = 22, z0 = 26, z1 = 40, wall = "#A9DAD6", floor = "#E8EEF0", fmat = "Slate", ceil = "#F4F7F7" },
	{ id = "Hall", label = "Коридор", fl = 2, x0 = 22, x1 = 36, z0 = 0, z1 = 40, wall = "#E9D6B5", floor = "#A0704A", fmat = "WoodPlanks", ceil = "#F3EEE4" },
	{ id = "Summer", label = "Комната Саммер", fl = 2, x0 = 36, x1 = 56, z0 = 0, z1 = 20, wall = "#E7B4D0", floor = "#C6B29A", fmat = "Fabric", ceil = "#F6EEF2" },
	{ id = "Morty", label = "Комната Морти", fl = 2, x0 = 36, x1 = 56, z0 = 20, z1 = 40, wall = "#9EC3D3", floor = "#B9A58D", fmat = "Fabric", ceil = "#F1ECE4" },
}
House.ROOMS = ROOMS

-- Проёмы. axis = "x": стена x = const (проём вдоль z), axis = "z": стена z = const (проём вдоль x).
-- kind: door (дверь с полотном), arch (просто проём), window, exdoor (входная/задняя дверь)
local OPENINGS = {
	-- этаж 1
	{ id = "Front", kind = "exdoor", fl = 1, axis = "z", at = 0, c = 32, w = 4.6, y0 = 0, y1 = 8 },
	{ kind = "window", fl = 1, axis = "z", at = 0, c = 25.5, w = 3, y0 = 3, y1 = 8 },
	{ kind = "window", fl = 1, axis = "z", at = 0, c = 6, w = 5, y0 = 3, y1 = 8.5 },
	{ kind = "window", fl = 1, axis = "z", at = 0, c = 16, w = 5, y0 = 3, y1 = 8.5 },
	{ kind = "window", fl = 1, axis = "x", at = 0, c = 12, w = 5, y0 = 3, y1 = 8.5 },
	{ kind = "window", fl = 1, axis = "x", at = 0, c = 28, w = 5, y0 = 3, y1 = 8.5 },
	{ kind = "arch", fl = 1, axis = "x", at = 22, c = 30, w = 12, y0 = 0, y1 = 9 },
	{ kind = "window", fl = 1, axis = "z", at = 40, c = 31, w = 5, y0 = 3, y1 = 8.5 },
	{ id = "Mudroom", kind = "door", fl = 1, axis = "x", at = 36, c = 7, w = 4.6, y0 = 0, y1 = 8 },
	{ kind = "arch", fl = 1, axis = "x", at = 36, c = 29, w = 14, y0 = 0, y1 = 9 },
	{ kind = "window", fl = 1, axis = "x", at = 56, c = 30, w = 7, y0 = 4.6, y1 = 8.6, id = "KitchenWindow" },
	{ id = "Back", kind = "exdoor", fl = 1, axis = "z", at = 40, c = 50, w = 4.2, y0 = 0, y1 = 8 },
	{ kind = "window", fl = 1, axis = "z", at = 40, c = 42, w = 4.5, y0 = 4.6, y1 = 8.6 },
	{ id = "Garage", kind = "door", fl = 1, axis = "x", at = 56, c = 7, w = 4.6, y0 = 0, y1 = 8 },
	{ kind = "window", fl = 1, axis = "z", at = 0, c = 46, w = 4, y0 = 4, y1 = 8 },
	-- этаж 2
	{ kind = "window", fl = 2, axis = "z", at = 0, c = 32, w = 4, y0 = 3.5, y1 = 8 },
	{ kind = "window", fl = 2, axis = "z", at = 40, c = 30, w = 4, y0 = 3.5, y1 = 8 },
	{ id = "Parents", kind = "door", fl = 2, axis = "x", at = 22, c = 23.2, w = 4.6, y0 = 0, y1 = 8 },
	{ id = "Bath", kind = "door", fl = 2, axis = "x", at = 22, c = 33, w = 4.2, y0 = 0, y1 = 8 },
	{ id = "Summer", kind = "door", fl = 2, axis = "x", at = 36, c = 10, w = 4.6, y0 = 0, y1 = 8 },
	{ id = "Morty", kind = "door", fl = 2, axis = "x", at = 36, c = 24, w = 4.6, y0 = 0, y1 = 8 },
	{ kind = "window", fl = 2, axis = "x", at = 56, c = 30.5, w = 8, y0 = 3, y1 = 9, id = "MortyWindow" },
	{ kind = "window", fl = 2, axis = "z", at = 40, c = 50, w = 4.5, y0 = 3.5, y1 = 8.5, id = "MortyWindow2" },
	{ kind = "window", fl = 2, axis = "x", at = 56, c = 10, w = 5, y0 = 3.5, y1 = 8.5 },
	{ kind = "window", fl = 2, axis = "z", at = 0, c = 46, w = 5, y0 = 3.5, y1 = 8.5 },
	{ kind = "window", fl = 2, axis = "x", at = 0, c = 13, w = 6, y0 = 3.5, y1 = 8.5 },
	{ kind = "window", fl = 2, axis = "z", at = 0, c = 11, w = 5, y0 = 3.5, y1 = 8.5 },
	{ kind = "window", fl = 2, axis = "z", at = 40, c = 11, w = 3, y0 = 5, y1 = 8 },
}
House.OPENINGS = OPENINGS

-- Лестница: x 22.5..28.5, низ у z = 4 (y = 0), верх у z = 20 (y = 12)
local STAIR = { x0 = 22.5, x1 = 28.5, z0 = 4, z1 = 20, steps = 16 }
House.STAIR = STAIR

local T = 0.35        -- толщина отделки стены (с каждой стороны)
local SHELL = 0.7     -- толщина наружной обшивки
local SIDING = "#EADBB2"
local TRIM = "#F6F2EA"
local ROOF = "#6E5E57"
local FOUND = "#B9B3A8"

local function floorY(fl) return fl == 1 and C.House.Floor1 or C.House.Floor2 end

-- проёмы, лежащие на линии стены (axis, at) этажа fl
local function openingsOn(fl, axis, at, from, to, origin)
	local out = {}
	for _, o in ipairs(OPENINGS) do
		if o.fl == fl and o.axis == axis and math.abs(o.at - at) < 0.01 and o.c > from and o.c < to then
			table.insert(out, { at = o.c - origin, w = o.w, y0 = o.y0, y1 = o.y1 })
		end
	end
	return out
end

-- отделка комнаты: 4 тонкие стены изнутри, с проёмами
local function lining(room, parent)
	local y = floorY(room.fl)
	local h = C.House.WallH
	local m = B.model(parent, "Walls_" .. room.id)
	local col = B.color(room.wall)
	local x0, x1, z0, z1 = room.x0, room.x1, room.z0, room.z1
	-- южная (z0) и северная (z1) стены идут вдоль x
	B.wall(m, "S", Vector3.new(x0, y, z0 + T / 2), Vector3.new(x1, y, z0 + T / 2), h, T, col, nil, openingsOn(room.fl, "z", z0, x0, x1, x0))
	B.wall(m, "N", Vector3.new(x0, y, z1 - T / 2), Vector3.new(x1, y, z1 - T / 2), h, T, col, nil, openingsOn(room.fl, "z", z1, x0, x1, x0))
	-- западная (x0) и восточная (x1) идут вдоль z (между южной и северной)
	B.wall(m, "W", Vector3.new(x0 + T / 2, y, z0 + T), Vector3.new(x0 + T / 2, y, z1 - T), h, T, col, nil, openingsOn(room.fl, "x", x0, z0, z1, z0 + T))
	B.wall(m, "E", Vector3.new(x1 - T / 2, y, z0 + T), Vector3.new(x1 - T / 2, y, z1 - T), h, T, col, nil, openingsOn(room.fl, "x", x1, z0, z1, z0 + T))
	-- плинтус и карниз по периметру (с разрывами в дверях)
	local trim = B.model(parent, "Trim_" .. room.id)
	local function band(axis, at, from, to, inward, yb, hb, thick)
		local ops = openingsOn(room.fl, axis, at, from, to, 0)
		local cuts = {}
		for _, o in ipairs(ops) do
			if o.y0 < yb + hb then table.insert(cuts, { o.at - o.w / 2, o.at + o.w / 2 }) end
		end
		table.sort(cuts, function(a, b) return a[1] < b[1] end)
		local cur = from
		local function seg(s0, s1)
			if s1 - s0 < 0.1 then return end
			local len = s1 - s0
			local mid = (s0 + s1) / 2
			local pos, size
			if axis == "z" then
				pos = Vector3.new(mid, y + yb + hb / 2, at + inward * (T + thick / 2))
				size = Vector3.new(len, hb, thick)
			else
				pos = Vector3.new(at + inward * (T + thick / 2), y + yb + hb / 2, mid)
				size = Vector3.new(thick, hb, len)
			end
			B.part(trim, "Trim", size, CFrame.new(pos), TRIM)
		end
		for _, c in ipairs(cuts) do
			seg(cur, c[1])
			cur = math.max(cur, c[2])
		end
		seg(cur, to)
	end
	band("z", z0, x0 + T, x1 - T, 1, 0, 0.6, 0.15)
	band("z", z1, x0 + T, x1 - T, -1, 0, 0.6, 0.15)
	band("x", x0, z0 + T, z1 - T, 1, 0, 0.6, 0.15)
	band("x", x1, z0 + T, z1 - T, -1, 0, 0.6, 0.15)
	band("z", z0, x0 + T, x1 - T, 1, h - 0.45, 0.45, 0.22)
	band("z", z1, x0 + T, x1 - T, -1, h - 0.45, 0.45, 0.22)
	band("x", x0, z0 + T, z1 - T, 1, h - 0.45, 0.45, 0.22)
	band("x", x1, z0 + T, z1 - T, -1, h - 0.45, 0.45, 0.22)
end

-- пол и потолок комнаты (с дырой под лестницу)
local function slabs(room, parent)
	local y = floorY(room.fl)
	local h = C.House.WallH
	local m = B.model(parent, "Floor_" .. room.id)
	local function rectXZ(name, x0, x1, z0, z1, yc, th, color, mat)
		if x1 - x0 < 0.05 or z1 - z0 < 0.05 then return end
		B.part(m, name, Vector3.new(x1 - x0, th, z1 - z0), CFrame.new((x0 + x1) / 2, yc, (z0 + z1) / 2), color, mat)
	end
	-- вырез под лестницу (для коридора на 2 этаже и потолка прихожей на 1)
	local hole = (room.id == "Hall") or (room.id == "Foyer")
	local function rectWithHole(name, yc, th, color, mat)
		if not hole then
			rectXZ(name, room.x0, room.x1, room.z0, room.z1, yc, th, color, mat)
			return
		end
		local sx0, sx1, sz0, sz1 = STAIR.x0, STAIR.x1, STAIR.z0, STAIR.z1
		rectXZ(name, room.x0, room.x1, room.z0, sz0, yc, th, color, mat)
		rectXZ(name, room.x0, room.x1, sz1, room.z1, yc, th, color, mat)
		rectXZ(name, room.x0, sx0, sz0, sz1, yc, th, color, mat)
		rectXZ(name, sx1, room.x1, sz0, sz1, yc, th, color, mat)
	end
	-- пол
	if room.floor == "checker" then
		local tile = 4
		local nx = math.floor((room.x1 - room.x0) / tile + 0.5)
		local nz = math.floor((room.z1 - room.z0) / tile + 0.5)
		local tw, tz = (room.x1 - room.x0) / nx, (room.z1 - room.z0) / nz
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				local col = ((i + j) % 2 == 0) and "#EFEAE0" or "#C9BFA9"
				rectXZ("Tile", room.x0 + i * tw, room.x0 + (i + 1) * tw, room.z0 + j * tz, room.z0 + (j + 1) * tz, y - 0.25, 0.5, col)
			end
		end
	elseif room.fl == 2 and hole then
		rectWithHole("Floor", y - 0.25, 0.5, room.floor, B.mat(room.fmat))
	else
		rectXZ("Floor", room.x0, room.x1, room.z0, room.z1, y - 0.25, 0.5, room.floor, B.mat(room.fmat))
	end
	-- потолок (нижняя часть перекрытия)
	if room.fl == 1 then
		rectWithHole("Ceiling", y + h + 0.25, 0.5, room.ceil)
	else
		rectXZ("Ceiling", room.x0, room.x1, room.z0, room.z1, y + h + 0.25, 0.5, room.ceil)
	end
end

-- наружная обшивка: 4 стены по периметру дома на два этажа, с проёмами окон и дверей
local function shell(parent)
	local m = B.model(parent, "Shell")
	local X0, X1, Z0, Z1 = C.House.X0, C.House.X1, C.House.Z0, C.House.Z1
	local h = C.House.WallH
	local o = SHELL / 2
	for fl = 1, 2 do
		local y = floorY(fl)
		local hh = h + 1
		B.wall(m, "S" .. fl, Vector3.new(X0 - SHELL, y, Z0 - o), Vector3.new(X1 + SHELL, y, Z0 - o), hh, SHELL, SIDING, nil, openingsOn(fl, "z", Z0, X0, X1, X0 - SHELL))
		B.wall(m, "N" .. fl, Vector3.new(X0 - SHELL, y, Z1 + o), Vector3.new(X1 + SHELL, y, Z1 + o), hh, SHELL, SIDING, nil, openingsOn(fl, "z", Z1, X0, X1, X0 - SHELL))
		B.wall(m, "W" .. fl, Vector3.new(X0 - o, y, Z0), Vector3.new(X0 - o, y, Z1), hh, SHELL, SIDING, nil, openingsOn(fl, "x", X0, Z0, Z1, Z0))
		B.wall(m, "E" .. fl, Vector3.new(X1 + o, y, Z0), Vector3.new(X1 + o, y, Z1), hh, SHELL, SIDING, nil, openingsOn(fl, "x", X1, Z0, Z1, Z0))
	end
	-- межэтажный пояс, углы, цоколь
	local band = "#D9C79A"
	B.part(m, "Band", Vector3.new(X1 - X0 + SHELL * 2 + 0.4, 0.8, 0.3), CFrame.new((X0 + X1) / 2, 11.6, Z0 - SHELL - 0.15), band)
	B.part(m, "Band", Vector3.new(X1 - X0 + SHELL * 2 + 0.4, 0.8, 0.3), CFrame.new((X0 + X1) / 2, 11.6, Z1 + SHELL + 0.15), band)
	B.part(m, "Band", Vector3.new(0.3, 0.8, Z1 - Z0 + SHELL * 2), CFrame.new(X0 - SHELL - 0.15, 11.6, (Z0 + Z1) / 2), band)
	B.part(m, "Band", Vector3.new(0.3, 0.8, Z1 - Z0 + SHELL * 2), CFrame.new(X1 + SHELL + 0.15, 11.6, (Z0 + Z1) / 2), band)
	for _, p in ipairs({ { X0 - SHELL, Z0 - SHELL }, { X1 + SHELL, Z0 - SHELL }, { X0 - SHELL, Z1 + SHELL }, { X1 + SHELL, Z1 + SHELL } }) do
		B.part(m, "Corner", Vector3.new(0.9, 24, 0.9), CFrame.new(p[1], 12, p[2]), TRIM)
	end
	-- цоколь (дом стоит на 1.2 выше земли)
	B.part(m, "Foundation", Vector3.new(X1 - X0 + SHELL * 2 + 0.6, 1.4, Z1 - Z0 + SHELL * 2 + 0.6), CFrame.new((X0 + X1) / 2, -0.75, (Z0 + Z1) / 2), FOUND, Enum.Material.Concrete)
	return m
end

-- окно: рама изнутри и снаружи, стекло, перемычка, подоконник
local function window(o, parent)
	local y = floorY(o.fl)
	local m = B.model(parent, o.id or "Window")
	B.attrs(m, { Kind = "Window" })
	local horiz = o.axis == "z"
	local w, hgt = o.w, o.y1 - o.y0
	local cy = y + (o.y0 + o.y1) / 2
	local base
	if horiz then base = CFrame.new(o.c, cy, o.at) else base = CFrame.new(o.at, cy, o.c) * CFrame.Angles(0, math.rad(90), 0) end
	-- в локальных координатах окна: X — вдоль стены, Z — сквозь стену (наружу при at = 0 / x = 0 — это −Z)
	local P = B.kit(m, base)
	local depth = T * 2 + SHELL + 0.4
	P("Glass", w - 0.3, hgt - 0.3, 0.12, 0, 0, 0, "#BFE6FF", Enum.Material.Glass, { Transparency = 0.72, CastShadow = false, Reflectance = 0.05 })
	local f = 0.3
	-- рама (сквозь всю толщину стены)
	P("Frame", w + f * 2, f, depth, 0, hgt / 2 + f / 2, 0, TRIM)
	P("Frame", w + f * 2, f, depth, 0, -hgt / 2 - f / 2, 0, TRIM)
	P("Frame", f, hgt, depth, -w / 2 - f / 2, 0, 0, TRIM)
	P("Frame", f, hgt, depth, w / 2 + f / 2, 0, 0, TRIM)
	-- переплёт
	P("Mullion", 0.18, hgt, 0.2, 0, 0, 0, TRIM)
	if hgt > 4.2 then P("Mullion", w, 0.18, 0.2, 0, hgt * 0.12, 0, TRIM) end
	-- подоконники с обеих сторон
	P("Sill", w + 1.0, 0.25, 0.7, 0, -hgt / 2 - f - 0.12, depth / 2 + 0.2, TRIM)
	P("Sill", w + 1.0, 0.25, 0.7, 0, -hgt / 2 - f - 0.12, -depth / 2 - 0.2, TRIM)
	return m
end

-- наличник вокруг дверного проёма (с обеих сторон стены)
local function casing(o, parent)
	local y = floorY(o.fl)
	local m = B.model(parent, "Casing")
	local base
	if o.axis == "z" then base = CFrame.new(o.c, y, o.at) else base = CFrame.new(o.at, y, o.c) * CFrame.Angles(0, math.rad(90), 0) end
	local P = B.kit(m, base)
	local depth = (o.kind == "exdoor" or o.id == "Garage") and (T + SHELL + 0.3) * 2 or (T * 2 + 0.3)
	local h = o.y1
	P("Jamb", 0.45, h + 0.45, depth, -o.w / 2 - 0.22, h / 2 + 0.22, 0, TRIM)
	P("Jamb", 0.45, h + 0.45, depth, o.w / 2 + 0.22, h / 2 + 0.22, 0, TRIM)
	P("Head", o.w + 0.9, 0.45, depth, 0, h + 0.22, 0, TRIM)
	return m
end

-- лестница: видимые ступени (без столкновений) + невидимый пандус (по нему ходят)
local function stairs(parent)
	local m = B.model(parent, "Stairs")
	local n = STAIR.steps
	local run = (STAIR.z1 - STAIR.z0) / n
	local rise = 12 / n
	local wdt = STAIR.x1 - STAIR.x0
	local cx = (STAIR.x0 + STAIR.x1) / 2
	for i = 1, n do
		local top = rise * i
		local z0 = STAIR.z0 + (i - 1) * run
		B.part(m, "Step", Vector3.new(wdt, top, run), CFrame.new(cx, top / 2, z0 + run / 2), "#C99A6B", nil, { CanCollide = false })
		B.part(m, "Nose", Vector3.new(wdt, 0.18, run + 0.12), CFrame.new(cx, top - 0.09, z0 + run / 2 - 0.06), "#9B6A42", nil, { CanCollide = false })
		B.part(m, "Riser", Vector3.new(wdt - 0.1, rise - 0.2, 0.06), CFrame.new(cx, top - rise / 2 - 0.1, z0 - 0.02), "#F6F2EA", nil, { CanCollide = false })
	end
	-- пандус
	local len = math.sqrt((STAIR.z1 - STAIR.z0) ^ 2 + 12 ^ 2)
	B.wedge(m, "Ramp", Vector3.new(wdt, 12, STAIR.z1 - STAIR.z0), CFrame.new(cx, 6, (STAIR.z0 + STAIR.z1) / 2), nil, nil,
		{ Transparency = 1, CanCollide = true, CastShadow = false, CanQuery = true })
	-- боковая панель (тетива) со стороны прихожей
	B.part(m, "Stringer", Vector3.new(0.3, 1.1, len + 0.6), CFrame.new(STAIR.x1 + 0.15, 6.2, (STAIR.z0 + STAIR.z1) / 2) * CFrame.Angles(-math.atan2(12, STAIR.z1 - STAIR.z0), 0, 0), "#9B6A42")
	-- перила вдоль лестницы
	local rail = "#7A4E2C"
	for i = 0, 4 do
		local z = STAIR.z0 + 0.6 + i * (STAIR.z1 - STAIR.z0 - 1.2) / 4
		local yb = (z - STAIR.z0) / (STAIR.z1 - STAIR.z0) * 12
		B.part(m, "Baluster", Vector3.new(0.3, 3.2, 0.3), CFrame.new(STAIR.x1 - 0.2, yb + 1.6, z), "#F6F2EA")
	end
	B.part(m, "Handrail", Vector3.new(0.35, 0.3, len), CFrame.new(STAIR.x1 - 0.2, 6 + 3.2, (STAIR.z0 + STAIR.z1) / 2) * CFrame.Angles(-math.atan2(12, STAIR.z1 - STAIR.z0), 0, 0), rail)
	B.part(m, "Newel", Vector3.new(0.7, 4.2, 0.7), CFrame.new(STAIR.x1 - 0.2, 2.1, STAIR.z0 - 0.2), rail)
	-- ограждение проёма на 2 этаже (восточный и южный край)
	local y2 = 12
	B.part(m, "Rail2", Vector3.new(0.35, 0.3, STAIR.z1 - STAIR.z0 + 0.4), CFrame.new(STAIR.x1 + 0.1, y2 + 3.4, (STAIR.z0 + STAIR.z1) / 2), rail)
	B.part(m, "Rail2", Vector3.new(STAIR.x1 - STAIR.x0 + 0.4, 0.3, 0.35), CFrame.new(cx, y2 + 3.4, STAIR.z0 - 0.1), rail)
	for z = STAIR.z0, STAIR.z1, 2 do
		B.part(m, "Baluster2", Vector3.new(0.25, 3.4, 0.25), CFrame.new(STAIR.x1 + 0.1, y2 + 1.7, z), "#F6F2EA")
	end
	for x = STAIR.x0 + 1, STAIR.x1, 2 do
		B.part(m, "Baluster2", Vector3.new(0.25, 3.4, 0.25), CFrame.new(x, y2 + 1.7, STAIR.z0 - 0.1), "#F6F2EA")
	end
	-- невидимые барьеры по краю проёма (чтобы не упасть вниз)
	B.marker(m, "Barrier", Vector3.new(0.5, 6, STAIR.z1 - STAIR.z0), CFrame.new(STAIR.x1 + 0.1, y2 + 3, (STAIR.z0 + STAIR.z1) / 2), { CanCollide = true })
	B.marker(m, "Barrier", Vector3.new(STAIR.x1 - STAIR.x0, 6, 0.5), CFrame.new(cx, y2 + 3, STAIR.z0 - 0.1), { CanCollide = true })
	-- кладовка под лестницей (стенка со стороны гостиной уже есть) — торцевая стенка внизу
	return m
end

-- крыша: двускатная, конёк вдоль x
local function roof(parent)
	local m = B.model(parent, "Roof")
	local X0, X1, Z0, Z1 = C.House.X0, C.House.X1, C.House.Z0, C.House.Z1
	local base = 24
	local rise = 11
	local half = (Z1 - Z0) / 2 + SHELL
	local cz = (Z0 + Z1) / 2
	local cx = (X0 + X1) / 2
	-- чердак (фронтоны): два клина в цвет обшивки
	-- у клина высокая грань сзади (+Z): южная половина — как есть, северная — развёрнута
	B.wedge(m, "Gable", Vector3.new(X1 - X0 + SHELL * 2, rise, half), CFrame.new(cx, base + rise / 2, cz - half / 2), SIDING)
	B.wedge(m, "Gable", Vector3.new(X1 - X0 + SHELL * 2, rise, half), CFrame.new(cx, base + rise / 2, cz + half / 2) * CFrame.Angles(0, math.rad(180), 0), SIDING)
	-- скаты
	local slope = math.atan2(rise, half)
	local len = math.sqrt(rise * rise + half * half) + 2.2
	local over = 2.2
	local w = X1 - X0 + SHELL * 2 + over * 2
	for _, s in ipairs({ -1, 1 }) do
		local cf = CFrame.new(cx, base + rise / 2 + 0.6, cz + s * half / 2) * CFrame.Angles(s * slope, 0, 0)
		B.part(m, "RoofSlab", Vector3.new(w, 0.7, len), cf * CFrame.new(0, 0, s * 1.0), ROOF)
		-- полосы черепицы
		for k = 1, 5 do
			B.part(m, "Shingle", Vector3.new(w, 0.12, 0.25), cf * CFrame.new(0, 0.4, s * 1.0 + (k - 3) * len / 6), B.shade(ROOF, 0.85))
		end
		-- водосток
		B.part(m, "Gutter", Vector3.new(w, 0.5, 0.5), CFrame.new(cx, base - 0.5, cz + s * (half + over)), "#E9E5DC")
	end
	B.part(m, "Ridge", Vector3.new(w, 0.6, 1.2), CFrame.new(cx, base + rise + 0.75, cz), B.shade(ROOF, 0.8))
	-- карниз над вторым этажом
	B.part(m, "Eave", Vector3.new(X1 - X0 + SHELL * 2 + 0.8, 0.5, Z1 - Z0 + SHELL * 2 + 0.8), CFrame.new(cx, base - 0.25, cz), TRIM)
	-- труба
	B.part(m, "Chimney", Vector3.new(3, 14, 3), CFrame.new(X0 + 6, base + 7, cz + 6), "#A0574A", Enum.Material.Brick)
	B.part(m, "ChimneyCap", Vector3.new(3.6, 0.6, 3.6), CFrame.new(X0 + 6, base + 14.3, cz + 6), "#6B4A40")
	return m
end

-- гараж справа от дома: снаружи, внутрь не попасть
local function garage(parent)
	local m = B.model(parent, "Garage")
	local x0, x1, z0, z1 = C.House.X1 + SHELL, C.House.X1 + 25, -1, 26
	local h = 13
	B.part(m, "Body", Vector3.new(x1 - x0, h, z1 - z0), CFrame.new((x0 + x1) / 2, h / 2 - 1.2, (z0 + z1) / 2), SIDING)
	B.part(m, "Floor", Vector3.new(x1 - x0, 1.2, z1 - z0), CFrame.new((x0 + x1) / 2, -0.6, (z0 + z1) / 2), FOUND, Enum.Material.Concrete)
	-- ворота
	local door = B.part(m, "GarageDoor", Vector3.new(16, 9, 0.4), CFrame.new((x0 + x1) / 2, 3.3, z0 - 0.2), "#F1EEE6")
	for k = 1, 4 do
		B.part(m, "Panel", Vector3.new(16.2, 0.18, 0.5), CFrame.new((x0 + x1) / 2, -1.2 + k * 2.2, z0 - 0.25), "#D9D4C8")
	end
	B.part(m, "DoorTrim", Vector3.new(17.2, 0.6, 0.6), CFrame.new((x0 + x1) / 2, 8.1, z0 - 0.2), TRIM)
	local _ = door
	-- плоско-скатная крыша
	-- односкатная: высокая сторона у стены дома (−X)
	B.wedge(m, "Roof", Vector3.new(z1 - z0 + 2, 4, x1 - x0 + 2), CFrame.new((x0 + x1) / 2, h - 1.2 + 2, (z0 + z1) / 2) * CFrame.Angles(0, math.rad(-90), 0), ROOF)
	-- окошко сбоку
	B.part(m, "Window", Vector3.new(0.3, 3, 4), CFrame.new(x1 + 0.05, 6, 16), "#7DA6C2", Enum.Material.Glass, { Transparency = 0.2 })
	B.part(m, "WindowFrame", Vector3.new(0.4, 3.6, 4.6), CFrame.new(x1 + 0.02, 6, 16), TRIM)
	-- зелёный отсвет из-под ворот (Рик что-то мастерит)
	local glow = B.part(m, "Glow", Vector3.new(15, 0.15, 0.6), CFrame.new((x0 + x1) / 2, -1.1, z0 - 0.05), "#7CFF4A", Enum.Material.Neon, { CastShadow = false })
	B.light(glow, "PointLight", { Color = Color3.fromRGB(120, 255, 80), Brightness = 1.5, Range = 8, Shadows = false })
	return m
end

-- крыльцо с навесом у входной двери
local function porch(parent)
	local m = B.model(parent, "Porch")
	local cx = 32
	B.part(m, "Deck", Vector3.new(12, 1.2, 6), CFrame.new(cx, -0.6, -3.7), "#A88C6C", Enum.Material.WoodPlanks)
	B.part(m, "Step", Vector3.new(7, 0.6, 1.6), CFrame.new(cx, -0.9, -7.5), "#B9B3A8", Enum.Material.Concrete)
	for _, dx in ipairs({ -5.4, 5.4 }) do
		B.part(m, "Column", Vector3.new(0.8, 9.6, 0.8), CFrame.new(cx + dx, 4.8, -6.2), TRIM)
	end
	B.wedge(m, "Canopy", Vector3.new(13, 1.6, 7), CFrame.new(cx, 10.4, -3.8), ROOF)
	B.part(m, "Beam", Vector3.new(13, 0.6, 0.8), CFrame.new(cx, 9.4, -6.2), TRIM)
	B.part(m, "Mat", Vector3.new(4, 0.1, 2.4), CFrame.new(cx, 0.05, -1.8), "#7A3E2E", Enum.Material.Fabric)
	local lamp = B.part(m, "PorchLamp", Vector3.new(0.6, 1, 0.6), CFrame.new(cx + 3.4, 8.5, -0.9), "#FFF1C6", Enum.Material.Neon)
	B.light(lamp, "PointLight", { Color = Color3.fromRGB(255, 214, 160), Brightness = 0.6, Range = 10, Enabled = false })
	-- номер дома
	local plate = B.part(m, "Number", Vector3.new(2.2, 1, 0.15), CFrame.new(cx - 3.6, 6.5, -0.95), "#2B3A5A")
	B.sign(plate, Enum.NormalId.Front, "19", { TextColor3 = Color3.fromRGB(240, 220, 160) })
	return m
end

-- пол и потолок для каждой комнаты, отделка стен, окна, наличники
function House.build(ctx, root)
	B, C = ctx.Build, ctx.Config
	H = root
	local structure = B.folder(root, "Structure")
	for _, r in ipairs(ROOMS) do
		lining(r, structure)
		slabs(r, structure)
	end
	shell(structure)
	local wins = B.folder(root, "Windows")
	for _, o in ipairs(OPENINGS) do
		if o.kind == "window" then window(o, wins)
		elseif o.kind == "door" or o.kind == "exdoor" or o.kind == "arch" then casing(o, structure) end
	end
	stairs(structure)
	roof(structure)
	garage(structure)
	porch(structure)
	-- зоны комнат (для подсказок и звуков шагов)
	local zones = B.folder(root, "Rooms")
	for _, r in ipairs(ROOMS) do
		local y = floorY(r.fl)
		local z = B.marker(zones, r.id, Vector3.new(r.x1 - r.x0, C.House.WallH, r.z1 - r.z0),
			CFrame.new((r.x0 + r.x1) / 2, y + C.House.WallH / 2, (r.z0 + r.z1) / 2))
		B.attrs(z, { Label = r.label, Floor = r.fl, Mat = r.fmat or "Tile" })
	end
	return root
end

-- данные проёма по id (для Doors.lua)
function House.opening(id)
	for _, o in ipairs(OPENINGS) do
		if o.id == id then return o end
	end
	return nil
end

return House
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[-- Мебель и мелочи по комнатам. Предметы — Model с атрибутом Outline (контур как в мультике).
-- Подсказки «Осмотреть» с атрибутом Thought показывают мысль Морти (текст — Config.Text[Thought]).
-- Метки для сюжета (камера в кровати, стул на кухне и т.д.) — в папке House.Markers.
local Rooms = {}

local B, C
local FURN, LIGHTS, MARK

local Y1, Y2 = 0, 12

local function item(name, cf, outline)
	local m = B.model(FURN, name)
	if outline ~= false then B.outline(m) end
	return m, B.kit(m, cf)
end

local function inspect(part, thought, action, dist)
	local p = B.prompt(part, "Inspect", action or "Осмотреть", "", { MaxActivationDistance = dist or 6 })
	p:SetAttribute("Thought", thought)
	return p
end

local function mark(name, cf)
	return B.marker(MARK, name, Vector3.new(1, 1, 1), cf)
end

-- потолочный светильник: плафон + PointLight (включает клиент по сцене)
local function ceilingLamp(room, x, y, z, d, color)
	local lamp = B.vcyl(LIGHTS, "Lamp", 0.45, d or 2.6, CFrame.new(x, y - 0.25, z), "#FFF6E2", Enum.Material.SmoothPlastic, { CastShadow = false })
	B.vcyl(LIGHTS, "LampBase", 0.15, (d or 2.6) + 0.4, CFrame.new(x, y - 0.06, z), "#E9E2D2", nil, { CastShadow = false })
	B.attrs(lamp, { Room = room, Glow = true })
	B.light(lamp, "PointLight", { Color = color or Color3.fromRGB(255, 226, 186), Brightness = 1.2, Range = 22, Enabled = false, Shadows = true })
	return lamp
end

-- стул (классический деревянный): cf — центр на полу, смотрит в −Z
local function chair(name, cf, color)
	local m, P = item(name, cf)
	color = color or "#B3784A"
	P("Seat", 2.2, 0.3, 2.2, 0, 2.1, 0, color)
	for _, p in ipairs({ { -0.9, -0.9 }, { 0.9, -0.9 }, { -0.9, 0.9 }, { 0.9, 0.9 } }) do
		P("Leg", 0.25, 2.0, 0.25, p[1], 1.0, p[2], B.shade(color, 0.85))
	end
	P("Back", 2.2, 2.4, 0.25, 0, 3.4, 0.98, color)
	P("BackRail", 0.25, 2.4, 0.25, -0.98, 3.4, 0.98, B.shade(color, 0.85))
	P("BackRail", 0.25, 2.4, 0.25, 0.98, 3.4, 0.98, B.shade(color, 0.85))
	return m
end

-- растение в горшке
local function plant(name, cf, s)
	s = s or 1
	local m, P = item(name, cf)
	P.vcyl("Pot", 1.4 * s, 1.5 * s, 0, 0.7 * s, 0, "#C4673F")
	P.vcyl("Soil", 0.1, 1.3 * s, 0, 1.38 * s, 0, "#5A3A22")
	P.ball("Leaves", 2.2 * s, 0, 2.6 * s, 0, "#4F9A45")
	P.ball("Leaves", 1.6 * s, 0.6 * s, 3.4 * s, 0.2 * s, "#5DAE50")
	P.ball("Leaves", 1.5 * s, -0.6 * s, 3.2 * s, -0.3 * s, "#468C3E")
	return m
end

-- рамка с картинкой на стене: cf — центр, смотрит в −Z (картинка на передней грани)
local function picture(name, cf, w, h, draw)
	local m, P = item(name, cf)
	P("Frame", w + 0.3, h + 0.3, 0.15, 0, 0, 0, "#6B4A2E")
	local canvas = P("Canvas", w, h, 0.05, 0, 0, -0.08, "#F4EFE4")
	local g = B.surface(canvas, Enum.NormalId.Front, 40)
	draw(g)
	return m, canvas
end

-- рисунки для плакатов и фото (рисуем рамками GUI, без картинок)
local function drawSpace(g)
	B.rect(g, 0, 0, 1, 1, "#1B1046")
	for i = 1, 22 do
		local x, y = ((i * 37) % 97) / 100, ((i * 53) % 89) / 100
		B.rect(g, x, y, 0.015, 0.011, "#FFFFFF")
	end
	B.circle(g, 0.3, 0.27, 0.42, 0.3, "#FF8A3D")
	B.rect(g, 0.12, 0.4, 0.78, 0.04, "#FFD27A", { Rotation = -12 })
	B.text(g, 0.05, 0.8, 0.9, 0.13, "КОСМОС", "#FFFFFF")
end
local function drawDino(g)
	B.rect(g, 0, 0, 1, 1, "#F2C230")
	B.text(g, 0.05, 0.04, 0.9, 0.12, "ДИНО-ЭКСПО", "#1B1B1B")
	B.circle(g, 0.22, 0.42, 0.5, 0.25, "#2B7A3B")
	B.rect(g, 0.6, 0.22, 0.1, 0.32, "#2B7A3B")
	B.circle(g, 0.55, 0.16, 0.22, 0.14, "#2B7A3B")
	B.rect(g, 0.3, 0.62, 0.08, 0.2, "#2B7A3B")
	B.rect(g, 0.52, 0.62, 0.08, 0.2, "#2B7A3B")
	B.text(g, 0.1, 0.86, 0.8, 0.08, "МУЗЕЙ · СУББОТА", "#1B1B1B", Enum.Font.GothamBold)
end
local function drawBand(g)
	B.rect(g, 0, 0, 1, 1, "#D6324A")
	B.text(g, 0.06, 0.08, 0.88, 0.22, "ШЛЁП", "#111111")
	B.text(g, 0.06, 0.3, 0.88, 0.22, "ТАПКИ", "#111111")
	for i = 0, 4 do B.circle(g, 0.1 + i * 0.17, 0.66, 0.12, 0.09, "#FFE14A") end
	B.text(g, 0.1, 0.84, 0.8, 0.1, "ТУР 2026", "#FFFFFF", Enum.Font.GothamBold)
end
local function drawCalendar(g)
	B.rect(g, 0, 0, 1, 1, "#FFFFFF")
	B.rect(g, 0, 0, 1, 0.2, "#E2504A")
	B.text(g, 0.05, 0.03, 0.9, 0.14, "НОЯБРЬ", "#FFFFFF")
	for r = 0, 4 do
		for c = 0, 6 do
			local n = r * 7 + c - 4
			if n >= 1 and n <= 30 then
				B.text(g, 0.04 + c * 0.135, 0.25 + r * 0.14, 0.12, 0.1, tostring(n), n == 3 and "#E2504A" or "#333333", Enum.Font.GothamBold)
			end
		end
	end
	B.circle(g, 0.04 + 0 * 0.135 - 0.01, 0.25 + 1 * 0.14 - 0.02, 0.14, 0.14, "#E2504A", { BackgroundTransparency = 0.6 })
end
local function drawFamily(g)
	B.rect(g, 0, 0, 1, 1, "#9FD0F0")
	B.rect(g, 0, 0.7, 1, 0.3, "#7CC46A")
	local people = { { 0.1, "#B9C3CC", 0.62, "#9FB7C9" }, { 0.28, "#E9A06A", 0.55, "#F1D2B0" }, { 0.46, "#F2D85A", 0.5, "#F1D2B0" },
		{ 0.62, "#F08AB0", 0.52, "#F1D2B0" }, { 0.8, "#6D8F5A", 0.56, "#F1D2B0" } }
	for _, p in ipairs(people) do
		B.rect(g, p[1], p[3] + 0.12, 0.14, 0.35, p[2])
		B.circle(g, p[1] + 0.02, p[3] - 0.02, 0.1, 0.15, p[4])
	end
	B.rect(g, 0.1, 0.42, 0.14, 0.06, "#C9D6E2") -- седые волосы деда
	B.text(g, 0.55, 0.88, 0.42, 0.1, "Смиты", "#FFFFFF", Enum.Font.GothamBold)
end
local function drawLandscape(g)
	B.rect(g, 0, 0, 1, 1, "#F3B36B")
	B.circle(g, 0.6, 0.15, 0.25, 0.3, "#FFE48A")
	B.rect(g, 0, 0.55, 1, 0.45, "#5E8F6A")
	B.rect(g, 0, 0.75, 1, 0.25, "#3F6B52")
end

