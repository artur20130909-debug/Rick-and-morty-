<Item class="Folder" referent="RBX00000021"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[-- Персонажи и их приёмы. Названия и описания — то, что видит игрок.
-- AI: подсказка ботам (range — с какой дистанции применять, kind — тип приёма).
local Characters = {}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

Characters.List = { "StormFist", "VoidLord", "CrimsonBlade", "ShadowCaller", "FlameDemon", "Thunderer" }
Characters.Default = "StormFist"

Characters.Defs = {
	StormFist = {
		Name = "Кулак Бури",
		Title = "Неудержимый",
		Desc = "Боец ближнего боя: быстрые серии, удар с отложенной волной и Резонанс — нажми клавишу приёма ещё раз в момент вспышки.",
		Color = rgb(255, 92, 51), Accent = rgb(255, 214, 92), Dark = rgb(60, 14, 10),
		M1Style = "fists",
		Difficulty = "Легко",
		Moves = {
			{ Id = "FistRush", Name = "Рывок Кулака", Cooldown = 9, Desc = "Рывок вперёд и серия ударов. Нажми 1 ещё раз во время вспышки — РЕЗОНАНС.", AI = { range = 26, kind = "gap" } },
			{ Id = "WhirlKick", Name = "Вихревой Пинок", Cooldown = 8, Desc = "Круговой удар ногой: бьёт всех рядом и подбрасывает.", AI = { range = 8, kind = "aoe" } },
			{ Id = "DelayedImpact", Name = "Отложенный Удар", Cooldown = 10, Desc = "Удар, а через миг — вторая волна. Вторая волна пробивает блок.", AI = { range = 7, kind = "melee" } },
			{ Id = "Crusher", Name = "Сокрушитель", Cooldown = 14, Desc = "Захват в прыжке и бросок о землю.", AI = { range = 15, kind = "grab" } },
		},
		Awakening = {
			Name = "ЯРОСТЬ БУРИ",
			Moves = {
				{ Id = "ThunderRush", Name = "Громовой Рывок", Cooldown = 6, Desc = "Длинный рывок с молниями: три удара и Резонанс.", AI = { range = 34, kind = "gap" } },
				{ Id = "Hurricane", Name = "Ураган", Cooldown = 7, Desc = "Смерч ударов: затягивает врагов и выбрасывает вверх.", AI = { range = 12, kind = "aoe" } },
				{ Id = "ThousandFists", Name = "Тысяча Кулаков", Cooldown = 9, Desc = "Град ударов перед собой.", AI = { range = 7, kind = "melee" } },
				{ Id = "HeavenStrike", Name = "Удар Небес", Cooldown = 999, Ultimate = true, Desc = "Прыжок в небо и падение с кулаком: огромный взрыв.", AI = { range = 45, kind = "ult" } },
			},
		},
	},

	VoidLord = {
		Name = "Повелитель Пустоты",
		Title = "Безмерный",
		Desc = "Маг пространства: притягивает, отталкивает, прыгает за спину и бьёт лучом. В пробуждении открывает территорию.",
		Color = rgb(92, 214, 255), Accent = rgb(170, 92, 255), Dark = rgb(20, 16, 48),
		M1Style = "palms",
		M1 = { Reach = 4.2 },
		Difficulty = "Средне",
		Moves = {
			{ Id = "Attract", Name = "Притяжение", Cooldown = 9, Desc = "Шар пустоты: стягивает врагов в одну точку.", AI = { range = 45, kind = "ranged" } },
			{ Id = "Repel", Name = "Отторжение", Cooldown = 9, Desc = "Взрыв пустоты перед собой: отбрасывает очень далеко.", AI = { range = 12, kind = "melee" } },
			{ Id = "Blink", Name = "Скачок", Cooldown = 7, Desc = "Мгновенно за спину ближайшего врага и удар ногой.", AI = { range = 40, kind = "gap" } },
			{ Id = "VoidBeam", Name = "Луч Пустоты", Cooldown = 15, Desc = "Заряд и огромный луч, пробивающий всё на пути.", AI = { range = 80, kind = "ranged" } },
		},
		Awakening = {
			Name = "БЕЗМЕРНОСТЬ",
			Moves = {
				{ Id = "GravityWell", Name = "Гравитационный Колодец", Cooldown = 8, Desc = "Чёрная дыра: три секунды тянет всех вокруг.", AI = { range = 45, kind = "ranged" } },
				{ Id = "Supernova", Name = "Сверхновая", Cooldown = 9, Desc = "Взрыв пустоты во все стороны.", AI = { range = 15, kind = "aoe" } },
				{ Id = "Distortion", Name = "Искажение", Cooldown = 6, Desc = "Три скачка подряд — и каждый с ударом.", AI = { range = 40, kind = "gap" } },
				{ Id = "EventHorizon", Name = "Территория: Горизонт Событий", Cooldown = 999, Ultimate = true, Domain = true, Desc = "Купол: враги внутри замедлены, не могут применять приёмы и получают урон.", AI = { range = 30, kind = "ult" } },
			},
		},
	},

	CrimsonBlade = {
		Name = "Алый Клинок",
		Title = "Мастер Меча",
		Desc = "Мечник: режет на расстоянии, ловит врага в контрстойку и пролетает сквозь толпу.",
		Color = rgb(230, 32, 56), Accent = rgb(245, 240, 235), Dark = rgb(40, 6, 12),
		M1Style = "sword",
		M1 = { Reach = 4.6, HitboxSize = Vector3.new(7.5, 6, 7), Damage = 3.8, FinisherDamage = 6 },
		Difficulty = "Средне",
		Moves = {
			{ Id = "WindCut", Name = "Рассечение", Cooldown = 7, Desc = "Летящий разрез: пробивает до трёх врагов.", AI = { range = 60, kind = "ranged" } },
			{ Id = "Counter", Name = "Контрстойка", Cooldown = 11, Desc = "Короткая стойка. Если ударят — блокирует и рубит в ответ.", AI = { range = 6, kind = "defense" } },
			{ Id = "BladeFlurry", Name = "Шквал Лезвий", Cooldown = 10, Desc = "Рывок сквозь врагов, затем серия порезов.", AI = { range = 26, kind = "gap" } },
			{ Id = "RisingSlash", Name = "Восходящий Разрез", Cooldown = 12, Desc = "Подброс разрезом и удар сверху.", AI = { range = 7, kind = "melee" } },
		},
		Awakening = {
			Name = "КРОВАВАЯ ЛУНА",
			Moves = {
				{ Id = "BladeFan", Name = "Веер Клинков", Cooldown = 6, Desc = "Пять летящих разрезов веером.", AI = { range = 55, kind = "ranged" } },
				{ Id = "InstantCut", Name = "Мгновенный Разрез", Cooldown = 6, Desc = "Телепорт к врагу и разрез насквозь.", AI = { range = 50, kind = "gap" } },
				{ Id = "ThousandCuts", Name = "Тысяча Порезов", Cooldown = 9, Desc = "Буря порезов вокруг себя.", AI = { range = 12, kind = "aoe" } },
				{ Id = "BladeGarden", Name = "Территория: Сад Клинков", Cooldown = 999, Ultimate = true, Domain = true, Desc = "Купол, в котором разрезы сами находят каждого врага.", AI = { range = 30, kind = "ult" } },
			},
		},
	},

	ShadowCaller = {
		Name = "Призыватель Теней",
		Title = "Тень",
		Desc = "Призыватель: теневые псы, вороны и пасть из-под земли. Умеет нырять в тень.",
		Color = rgb(128, 72, 220), Accent = rgb(64, 110, 255), Dark = rgb(14, 10, 24),
		M1Style = "claws",
		Difficulty = "Сложно",
		Moves = {
			{ Id = "Hounds", Name = "Теневые Псы", Cooldown = 10, Desc = "Два пса бегут к врагу и кусают.", AI = { range = 45, kind = "ranged" } },
			{ Id = "CrowSwarm", Name = "Стая Воронов", Cooldown = 9, Desc = "Стая летит вперёд, бьёт и ослепляет.", AI = { range = 45, kind = "ranged" } },
			{ Id = "ShadowDive", Name = "Нырок в Тень", Cooldown = 10, Desc = "Уйти в тень (неуязвим) и выпрыгнуть с апперкотом. Нажми 3 ещё раз, чтобы выйти раньше.", AI = { range = 20, kind = "gap" } },
			{ Id = "AbyssMaw", Name = "Пасть Бездны", Cooldown = 14, Desc = "Под врагом вырывается огромная пасть.", AI = { range = 45, kind = "ranged" } },
		},
		Awakening = {
			Name = "НОЧНОЙ ЛЕГИОН",
			Moves = {
				{ Id = "HoundPack", Name = "Стая Псов", Cooldown = 7, Desc = "Четыре пса бросаются на врагов.", AI = { range = 50, kind = "ranged" } },
				{ Id = "ShadowGiant", Name = "Теневой Великан", Cooldown = 9, Desc = "Огромный кулак тени бьёт вперёд.", AI = { range = 25, kind = "melee" } },
				{ Id = "ShadowChains", Name = "Теневые Цепи", Cooldown = 9, Desc = "Цепи сковывают всех вокруг.", AI = { range = 18, kind = "aoe" } },
				{ Id = "Abyss", Name = "Территория: Бездна", Cooldown = 999, Ultimate = true, Domain = true, Desc = "Пол становится тенью: враги вязнут, а псы кусают.", AI = { range = 30, kind = "ult" } },
			},
		},
	},

	FlameDemon = {
		Name = "Пламенный Демон",
		Title = "Пекло",
		Desc = "Огонь на дистанции: шары, столбы пламени и метеор. Поджигает врагов.",
		Color = rgb(255, 128, 28), Accent = rgb(255, 222, 90), Dark = rgb(70, 18, 6),
		M1Style = "flame",
		Difficulty = "Легко",
		Moves = {
			{ Id = "Fireball", Name = "Огненный Шар", Cooldown = 7, Desc = "Шар взрывается и поджигает.", AI = { range = 60, kind = "ranged" } },
			{ Id = "FlameDash", Name = "Огненный Рывок", Cooldown = 8, Desc = "Рывок, за которым горит дорожка.", AI = { range = 26, kind = "gap" } },
			{ Id = "FlamePillar", Name = "Столб Пламени", Cooldown = 10, Desc = "Под врагом вырывается столб огня.", AI = { range = 50, kind = "ranged" } },
			{ Id = "Meteor", Name = "Метеор", Cooldown = 15, Desc = "С неба падает метеор.", AI = { range = 55, kind = "ranged" } },
		},
		Awakening = {
			Name = "ИНФЕРНО",
			Moves = {
				{ Id = "FireBarrage", Name = "Огненный Шквал", Cooldown = 6, Desc = "Пять огненных шаров подряд.", AI = { range = 60, kind = "ranged" } },
				{ Id = "FireRing", Name = "Кольцо Огня", Cooldown = 8, Desc = "Огненная волна во все стороны.", AI = { range = 18, kind = "aoe" } },
				{ Id = "Phoenix", Name = "Феникс", Cooldown = 9, Desc = "Полёт огненной птицей сквозь врагов.", AI = { range = 35, kind = "gap" } },
				{ Id = "SolarFlare", Name = "Солнечная Вспышка", Cooldown = 999, Ultimate = true, Desc = "Маленькое солнце падает на арену.", AI = { range = 40, kind = "ult" } },
			},
		},
	},

	Thunderer = {
		Name = "Громовержец",
		Title = "Молния",
		Desc = "Самый быстрый: мгновенные шаги, цепные молнии и рельсотрон.",
		Color = rgb(110, 196, 255), Accent = rgb(255, 248, 160), Dark = rgb(12, 22, 48),
		M1Style = "zap",
		M1 = { Interval = 0.25, Damage = 3.1, FinisherDamage = 5 },
		Difficulty = "Средне",
		Moves = {
			{ Id = "FlashStep", Name = "Шаг Молнии", Cooldown = 6, Desc = "Мгновенный рывок сквозь врагов.", AI = { range = 26, kind = "gap" } },
			{ Id = "ChainLightning", Name = "Цепная Молния", Cooldown = 9, Desc = "Молния перескакивает между врагами.", AI = { range = 45, kind = "ranged" } },
			{ Id = "ThunderClap", Name = "Громовой Хлопок", Cooldown = 10, Desc = "Хлопок: оглушает всех рядом.", AI = { range = 11, kind = "aoe" } },
			{ Id = "Railgun", Name = "Рельсотрон", Cooldown = 14, Desc = "Короткий заряд и молниевый луч.", AI = { range = 90, kind = "ranged" } },
		},
		Awakening = {
			Name = "БУРЯ",
			Moves = {
				{ Id = "StormSteps", Name = "Шквальные Шаги", Cooldown = 5, Desc = "Три шага молнии подряд к врагу.", AI = { range = 40, kind = "gap" } },
				{ Id = "Thunderbolt", Name = "Удар Молнии", Cooldown = 8, Desc = "Молнии с неба бьют всех вокруг.", AI = { range = 35, kind = "aoe" } },
				{ Id = "Overload", Name = "Перегрузка", Cooldown = 8, Desc = "Разряд вокруг себя бьёт несколько раз.", AI = { range = 14, kind = "aoe" } },
				{ Id = "Judgment", Name = "Небесный Суд", Cooldown = 999, Ultimate = true, Desc = "Гроза: молнии бьют по врагам по всей округе.", AI = { range = 60, kind = "ult" } },
			},
		},
	},
}

function Characters.get(id)
	return Characters.Defs[id] or Characters.Defs[Characters.Default]
end

function Characters.valid(id)
	return type(id) == "string" and Characters.Defs[id] ~= nil
end

-- текущие 4 приёма (обычные или пробуждённые)
function Characters.moveset(id, awakened)
	local def = Characters.get(id)
	if awakened then return def.Awakening.Moves end
	return def.Moves
end

-- найти приём по Id
function Characters.findMove(id, moveId)
	local def = Characters.get(id)
	for _, m in ipairs(def.Moves) do if m.Id == moveId then return m end end
	for _, m in ipairs(def.Awakening.Moves) do if m.Id == moveId then return m end end
	return nil
end

return Characters
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Общие настройки боя. Все числа баланса — здесь.
local Config = {}

Config.GameName = "CURSED ARENA"
Config.Subtitle = "битва техник"
Config.Version = "1.0"

-- персонаж
Config.MaxHealth = 100
Config.WalkSpeed = 20
Config.JumpHeight = 7.5
Config.StunSpeed = 4          -- скорость под оглушением
Config.BusySpeed = 9          -- скорость во время приёма (если приём не задал свою)
Config.RespawnTime = 4
Config.SpawnProtection = 2.5  -- неуязвимость после появления, с
Config.RegenDelay = 9         -- через сколько секунд без урона начинается лечение
Config.RegenPerSecond = 3
Config.ComboResetTime = 2.2   -- счётчик комбо сбрасывается, если долго не попадать
Config.InCombatTime = 6       -- столько секунд после урона нельзя сменить персонажа
Config.KillPlaneY = -60

-- M1 (обычные удары, ЛКМ). Четвёртый удар — добивающий.
Config.M1 = {
	Count = 4,
	Interval = 0.29,      -- минимум между ударами
	ComboWindow = 0.95,   -- если пауза дольше — серия начинается заново
	EndLag = 1.05,        -- пауза после четвёртого удара
	Windup = 0.09,        -- через сколько после замаха проверяется попадание
	Damage = 3.5,
	FinisherDamage = 5.5,
	Stun = 0.62,
	BusyTime = 0.24,
	BusySpeed = 11,
	HitboxSize = Vector3.new(5.6, 6, 6),
	Reach = 3.6,          -- центр хитбокса на столько впереди
	Knockback = 62,       -- отбрасывание добивающим
	KnockUp = 24,
	Ragdoll = 1.25,
	UppercutUp = 64,      -- пробел + 4-й удар
	DownslamDown = 95,    -- 4-й удар в воздухе
}

-- блок (F) и парирование
Config.Block = {
	ChipMult = 0.2,       -- сколько урона приёмов проходит сквозь блок
	MaxDurability = 9,    -- сколько ударов выдержит блок
	RegenPerSecond = 1.6,
	GuardBreakStun = 1.8,
	ParryWindow = 0.17,   -- если зажать блок прямо перед ударом — парирование
	ParryStun = 1.15,
	Speed = 7,
	FrontDot = -0.1,      -- блок держит удары спереди и сбоку
	Cooldown = 0.35,      -- после отпускания блока
}

-- рывок (Q): вперёд/назад/вбок
Config.Dash = {
	Speed = 90,
	Time = 0.26,
	FrontCooldown = 2.4,
	BackCooldown = 2.2,
	SideCooldown = 1.5,
	EvadeTime = 0.24,     -- боковой рывок уводит от M1
}

-- пробуждение (G): копится от урона
Config.Awaken = {
	Max = 100,
	PerDamageDealt = 1.15,
	PerDamageTaken = 0.55,
	Duration = 60,
	Heal = 25,
	SpeedMult = 1.14,
	DamageMult = 1.2,
	CooldownMult = 0.65,
	Invuln = 1.6,         -- неуязвимость во время позы пробуждения
}

-- территория (ульта трёх персонажей)
Config.Domain = {
	Radius = 42,
	Duration = 9,
	ClashDistance = 0.8,  -- если две территории ближе (r1+r2)*k — они ломают друг друга
}

-- боты
Config.Bots = {
	Default = 2,
	Max = 6,
	RespawnTime = 5,
	Names = { "Рэн", "Аки", "Сора", "Кайто", "Мирай", "Юки", "Харуто", "Нао", "Рику", "Мэй", "Дайки", "Хина" },
	Difficulty = {
		{ Name = "Лёгкие", React = 0.55, Block = 0.15, Aggro = 0.45, MoveChance = 0.25, Dash = 0.15 },
		{ Name = "Обычные", React = 0.32, Block = 0.35, Aggro = 0.7, MoveChance = 0.45, Dash = 0.3 },
		{ Name = "Сильные", React = 0.18, Block = 0.55, Aggro = 0.9, MoveChance = 0.7, Dash = 0.45 },
	},
	DefaultDifficulty = 2,
}

-- манекены в додзё
Config.Dummy = {
	HealDelay = 3,
	RespawnTime = 3,
}

-- ломающиеся предметы карты
Config.Breakables = {
	RestoreTime = 25,
}

-- клавиши ПК
Config.Keys = {
	Block = Enum.KeyCode.F,
	Dash = Enum.KeyCode.Q,
	Awaken = Enum.KeyCode.G,
	Menu = Enum.KeyCode.M,
	Moves = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four },
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Costumes</string><ProtectedString name="Source"><![CDATA[-- Образы персонажей из деталей (для ботов, манекенов и предпросмотра в меню)
-- и оружие (меч Алого Клинка — у всех, кто им играет).
local Costumes = {}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

-- цвета тела: кожа, торс, ноги
Costumes.Body = {
	StormFist = { skin = rgb(224, 172, 132), torso = rgb(232, 96, 40), legs = rgb(36, 32, 34) },
	VoidLord = { skin = rgb(236, 206, 180), torso = rgb(44, 30, 74), legs = rgb(30, 22, 52) },
	CrimsonBlade = { skin = rgb(240, 200, 170), torso = rgb(236, 232, 226), legs = rgb(40, 34, 36) },
	ShadowCaller = { skin = rgb(206, 170, 150), torso = rgb(24, 20, 30), legs = rgb(18, 16, 22) },
	FlameDemon = { skin = rgb(196, 120, 92), torso = rgb(28, 24, 24), legs = rgb(150, 54, 20) },
	Thunderer = { skin = rgb(230, 186, 150), torso = rgb(38, 76, 160), legs = rgb(28, 30, 44) },
	Dummy = { skin = rgb(196, 160, 110), torso = rgb(150, 116, 74), legs = rgb(120, 92, 60) },
}

local function mk(model, name, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

-- прикрепить к части тела: offset — в системе этой части (в покое)
local function attach(folder, bodyPart, name, size, offset, color, material, shape)
	local p = mk(folder, name, size, bodyPart.CFrame * offset, color, material, shape)
	local w = Instance.new("WeldConstraint")
	w.Part0 = bodyPart
	w.Part1 = p
	w.Parent = p
	p.Parent = folder
	return p
end
Costumes.attach = attach

local function wedge(folder, bodyPart, name, size, offset, color, material)
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Size = size
	p.CFrame = bodyPart.CFrame * offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = bodyPart
	w.Part1 = p
	w.Parent = p
	p.Parent = folder
	return p
end

function Costumes.setBody(model, id)
	local c = Costumes.Body[id] or Costumes.Body.Dummy
	local map = { Head = c.skin, ["Left Arm"] = c.skin, ["Right Arm"] = c.skin, Torso = c.torso, ["Left Leg"] = c.legs, ["Right Leg"] = c.legs }
	for name, col in pairs(map) do
		local p = model:FindFirstChild(name)
		if p then p.Color = col end
	end
	local bc = model:FindFirstChildOfClass("BodyColors")
	if bc then
		bc.HeadColor3, bc.LeftArmColor3, bc.RightArmColor3 = c.skin, c.skin, c.skin
		bc.TorsoColor3, bc.LeftLegColor3, bc.RightLegColor3 = c.torso, c.legs, c.legs
	end
end

local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

-- полный образ (боты, меню)
local builders = {}

builders.StormFist = function(f, m)
	local head, torso = m.Head, m.Torso
	local hair = rgb(30, 22, 20)
	attach(f, head, "Hair", Vector3.new(1.3, 0.35, 1.3), CF(0, 0.55, 0.02), hair)
	for i = -2, 2 do
		wedge(f, head, "Spike", Vector3.new(0.22, 0.45, 0.5), CF(i * 0.26, 0.85, 0.15) * ANG(rad(-15), 0, 0), hair)
	end
	attach(f, head, "Headband", Vector3.new(1.32, 0.18, 1.32), CF(0, 0.32, 0), rgb(220, 30, 30))
	attach(f, head, "BandTail", Vector3.new(0.2, 0.12, 0.9), CF(0.25, 0.3, 0.95) * ANG(rad(-25), rad(10), 0), rgb(220, 30, 30))
	attach(f, torso, "Belt", Vector3.new(2.06, 0.3, 1.06), CF(0, -0.75, 0), rgb(20, 20, 20))
	attach(f, torso, "Collar", Vector3.new(0.5, 1.5, 0.06), CF(0, 0.2, -0.53) * ANG(0, 0, rad(28)), rgb(255, 196, 120))
	for _, side in ipairs({ "Left Arm", "Right Arm" }) do
		local arm = m[side]
		attach(f, arm, "Wrap", Vector3.new(1.06, 0.55, 1.06), CF(0, -0.68, 0), rgb(245, 238, 225), Enum.Material.Fabric)
	end
end

builders.VoidLord = function(f, m)
	local head, torso = m.Head, m.Torso
	local cloth = rgb(48, 28, 84)
	attach(f, head, "Hood", Vector3.new(1.45, 1.45, 1.45), CF(0, 0.12, 0.12), cloth, Enum.Material.Fabric)
	attach(f, head, "HoodFront", Vector3.new(1.45, 0.4, 0.3), CF(0, 0.62, -0.62), cloth, Enum.Material.Fabric)
	attach(f, head, "EyeL", Vector3.new(0.22, 0.1, 0.05), CF(-0.22, 0.08, -0.62), rgb(92, 230, 255), Enum.Material.Neon)
	attach(f, head, "EyeR", Vector3.new(0.22, 0.1, 0.05), CF(0.22, 0.08, -0.62), rgb(92, 230, 255), Enum.Material.Neon)
	attach(f, torso, "Coat", Vector3.new(2.12, 2.1, 1.12), CF(0, -0.05, 0), cloth, Enum.Material.Fabric)
	attach(f, torso, "CoatTail", Vector3.new(2.0, 1.6, 0.12), CF(0, -1.6, 0.5), cloth, Enum.Material.Fabric)
	attach(f, torso, "Trim", Vector3.new(0.14, 2.1, 1.14), CF(0, -0.05, 0), rgb(170, 92, 255), Enum.Material.Neon)
	attach(f, torso, "Sigil", Vector3.new(0.5, 0.5, 0.06), CF(0, 0.35, -0.6) * ANG(0, 0, rad(45)), rgb(92, 230, 255), Enum.Material.Neon)
end

builders.CrimsonBlade = function(f, m)
	local head, torso = m.Head, m.Torso
	local hair = rgb(24, 18, 20)
	attach(f, head, "Hair", Vector3.new(1.3, 0.4, 1.3), CF(0, 0.52, 0.05), hair)
	attach(f, head, "TopKnot", Vector3.new(0.45, 0.5, 0.45), CF(0, 0.9, 0.3), hair)
	attach(f, head, "Tip", Vector3.new(0.47, 0.16, 0.47), CF(0, 1.1, 0.3), rgb(220, 30, 50))
	attach(f, torso, "Sash", Vector3.new(2.08, 0.4, 1.08), CF(0, -0.7, 0), rgb(214, 28, 48))
	attach(f, torso, "Lapel", Vector3.new(0.4, 2.0, 0.06), CF(-0.2, 0.05, -0.53) * ANG(0, 0, rad(-20)), rgb(214, 28, 48))
	attach(f, torso, "Scabbard", Vector3.new(0.22, 0.22, 3.4), CF(-1.1, -0.85, 0.4) * ANG(rad(-20), rad(10), 0), rgb(20, 16, 18))
end

builders.ShadowCaller = function(f, m)
	local head, torso = m.Head, m.Torso
	local cloak = rgb(16, 14, 22)
	attach(f, head, "Hood", Vector3.new(1.42, 1.42, 1.42), CF(0, 0.12, 0.14), cloak, Enum.Material.Fabric)
	attach(f, head, "Mask", Vector3.new(1.0, 1.0, 0.12), CF(0, 0, -0.62), rgb(232, 226, 214))
	attach(f, head, "SlitL", Vector3.new(0.26, 0.08, 0.05), CF(-0.2, 0.1, -0.69), rgb(150, 80, 255), Enum.Material.Neon)
	attach(f, head, "SlitR", Vector3.new(0.26, 0.08, 0.05), CF(0.2, 0.1, -0.69), rgb(150, 80, 255), Enum.Material.Neon)
	attach(f, torso, "Cloak", Vector3.new(2.16, 2.0, 1.16), CF(0, 0, 0), cloak, Enum.Material.Fabric)
	attach(f, torso, "Cape", Vector3.new(2.3, 3.2, 0.12), CF(0, -0.6, 0.62) * ANG(rad(6), 0, 0), cloak, Enum.Material.Fabric)
	attach(f, torso, "Scarf", Vector3.new(2.2, 0.45, 1.2), CF(0, 0.82, 0), rgb(92, 46, 160), Enum.Material.Fabric)
end

builders.FlameDemon = function(f, m)
	local head, torso = m.Head, m.Torso
	local hair = rgb(250, 120, 30)
	attach(f, head, "Hair", Vector3.new(1.3, 0.4, 1.3), CF(0, 0.52, 0.04), hair, Enum.Material.Neon)
	for i = -1, 1 do
		wedge(f, head, "Flame", Vector3.new(0.35, 0.6, 0.55), CF(i * 0.38, 0.95, 0.1) * ANG(rad(-10), 0, rad(i * -12)), rgb(255, 196, 60), Enum.Material.Neon)
	end
	wedge(f, head, "HornL", Vector3.new(0.18, 0.55, 0.3), CF(-0.5, 0.72, -0.1) * ANG(rad(-10), 0, rad(20)), rgb(40, 20, 18))
	wedge(f, head, "HornR", Vector3.new(0.18, 0.55, 0.3), CF(0.5, 0.72, -0.1) * ANG(rad(-10), 0, rad(-20)), rgb(40, 20, 18))
	attach(f, torso, "Belt", Vector3.new(2.06, 0.3, 1.06), CF(0, -0.85, 0), rgb(60, 30, 20))
	attach(f, torso, "Mark", Vector3.new(0.7, 0.18, 0.06), CF(0, 0.4, -0.53), rgb(255, 140, 30), Enum.Material.Neon)
	for _, side in ipairs({ "Left Arm", "Right Arm" }) do
		attach(f, m[side], "Cuff", Vector3.new(1.06, 0.3, 1.06), CF(0, -0.8, 0), rgb(255, 140, 30), Enum.Material.Neon)
	end
end

builders.Thunderer = function(f, m)
	local head, torso = m.Head, m.Torso
	local hair = rgb(255, 240, 150)
	attach(f, head, "Hair", Vector3.new(1.3, 0.35, 1.3), CF(0, 0.55, 0.04), hair)
	for i = -2, 2 do
		wedge(f, head, "Spike", Vector3.new(0.25, 0.5, 0.6), CF(i * 0.25, 0.85, 0.2) * ANG(rad(-35), 0, 0), hair)
	end
	attach(f, head, "Goggles", Vector3.new(1.34, 0.2, 1.34), CF(0, 0.32, 0), rgb(40, 40, 46))
	attach(f, head, "Lens", Vector3.new(0.7, 0.24, 0.1), CF(0, 0.34, -0.66), rgb(120, 210, 255), Enum.Material.Glass)
	attach(f, torso, "Stripe", Vector3.new(0.3, 2.04, 1.04), CF(0.55, 0, 0) * ANG(0, 0, rad(18)), rgb(255, 230, 90), Enum.Material.Neon)
	attach(f, torso, "Collar", Vector3.new(2.1, 0.35, 1.1), CF(0, 0.9, 0), rgb(26, 50, 120))
end

builders.Dummy = function(f, m)
	local torso = m.Torso
	attach(f, torso, "Target", Vector3.new(1.0, 1.0, 0.05), CF(0, 0.1, -0.53), rgb(230, 230, 230))
	attach(f, torso, "Bull", Vector3.new(0.45, 0.45, 0.06), CF(0, 0.1, -0.54), rgb(220, 40, 40))
end

function Costumes.apply(model, id)
	local old = model:FindFirstChild("Costume")
	if old then old:Destroy() end
	Costumes.setBody(model, id)
	local face = model:FindFirstChild("Head") and model.Head:FindFirstChild("face")
	if face and (id == "VoidLord" or id == "ShadowCaller") then face.Transparency = 1 end
	local f = Instance.new("Folder")
	f.Name = "Costume"
	f.Parent = model
	local b = builders[id]
	if b then b(f, model) end
	return f
end

-- меч в правой руке (лезвие — вперёд из кулака)
function Costumes.sword(model, color)
	local arm = model:FindFirstChild("Right Arm")
	if not arm then return nil end
	local old = model:FindFirstChild("Weapon")
	if old then old:Destroy() end
	local f = Instance.new("Folder")
	f.Name = "Weapon"
	f.Parent = model
	attach(f, arm, "Handle", Vector3.new(0.24, 0.24, 1.3), CF(0, -0.95, -0.15), rgb(26, 20, 22), Enum.Material.Fabric)
	attach(f, arm, "Guard", Vector3.new(0.12, 0.6, 0.6), CF(0, -0.95, -0.85) * ANG(0, rad(90), 0), rgb(210, 170, 70), Enum.Material.Metal, Enum.PartType.Cylinder)
	local blade = attach(f, arm, "Blade", Vector3.new(0.07, 0.3, 4.3), CF(0, -0.92, -3.05), rgb(222, 226, 232), Enum.Material.Metal)
	blade.Reflectance = 0.25
	local edge = attach(f, arm, "Edge", Vector3.new(0.05, 0.06, 4.25), CF(0, -0.79, -3.05), color or rgb(230, 32, 56), Enum.Material.Neon)
	edge.Transparency = 0.4
	return f
end

return Costumes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Poses</string><ProtectedString name="Source"><![CDATA[-- Позы и анимации персонажей (R6). Значения — в градусах, смысл полей см. в Rig.
-- Анимация: d — длина, loop — по кругу, fi/fo — плавный вход/выход,
-- k — ключи { t, поза, e } (e — сглаживание к этому ключу: lin/in/out/inout/back).
-- Сустав, которого нет в ключе, держит значение из прошлого ключа.
-- Суставы, которых нет ни в одном ключе, анимация не трогает (ноги продолжают бежать).
local Poses = {}

local function K(t, pose, e) return { t = t, p = pose, e = e or "inout" } end

---------------------------------------------------------------- базовые позы
Poses.Base = {
	stand = { T = { u = 0 }, H = {}, RA = { p = 3, r = 5 }, LA = { p = 3, r = 5 }, RL = { r = 3 }, LL = { r = 3 } },
	-- боевая стойка: левое плечо вперёд, кулаки у подбородка
	fists = { T = { p = 4, y = 16, u = -0.2 }, H = { p = -3, y = -15 }, RA = { p = 50, r = -36 }, LA = { p = 66, r = -28 },
		RL = { p = -13, r = 7 }, LL = { p = 15, r = 5 } },
	palms = { T = { p = 2, y = 8, u = -0.1 }, H = { p = -2, y = -8 }, RA = { p = 28, r = -14, y = -20 }, LA = { p = 36, r = -18, y = -20 },
		RL = { p = -8, r = 6 }, LL = { p = 9, r = 5 } },
	sword = { T = { p = 4, y = 18, u = -0.25 }, H = { p = -2, y = -18 }, RA = { p = 26, r = -10 }, LA = { p = 30, r = -30 },
		RL = { p = -15, r = 8 }, LL = { p = 18, r = 5 } },
	claws = { T = { p = 12, y = 10, u = -0.3 }, H = { p = -10, y = -10 }, RA = { p = 40, r = 10 }, LA = { p = 46, r = 8 },
		RL = { p = -14, r = 9 }, LL = { p = 16, r = 7 } },
	block = { T = { p = 10, u = -0.35 }, H = { p = 8 }, RA = { p = 100, r = -42 }, LA = { p = 108, r = -46 },
		RL = { p = -16, r = 8 }, LL = { p = 18, r = 6 } },
	block_sword = { T = { p = 8, y = 10, u = -0.35 }, H = { p = 4, y = -10 }, RA = { p = 96, r = -72 }, LA = { p = 92, r = -36 },
		RL = { p = -16, r = 8 }, LL = { p = 18, r = 6 } },
	stun = { T = { p = 17, r = 6, u = -0.25 }, H = { p = 22, r = 8 }, RA = { p = 12, r = 12 }, LA = { p = 8, r = 10 },
		RL = { p = 6, r = 6 }, LL = { p = -4, r = 4 } },
	dizzy = { T = { p = 8, u = -0.2 }, H = { p = 12 }, RA = { p = 6, r = 18 }, LA = { p = 6, r = 18 }, RL = { r = 6 }, LL = { r = 6 } },
	air_up = { T = { p = -4 }, H = { p = -6 }, RA = { p = 30, r = 28 }, LA = { p = 30, r = 28 }, RL = { p = 34 }, LL = { p = -8 } },
	air_down = { T = { p = 6 }, H = { p = 4 }, RA = { p = 12, r = 62 }, LA = { p = 12, r = 62 }, RL = { p = 12, r = 8 }, LL = { p = -12, r = 8 } },
	rooted = { T = { p = 6, u = -0.2 }, H = { p = 10 }, RA = { p = 2, r = 8 }, LA = { p = 2, r = 8 }, RL = { r = 4 }, LL = { r = 4 } },
}
-- какая стойка у стиля M1
Poses.StanceOf = { fists = "fists", flame = "fists", zap = "fists", palms = "palms", sword = "sword", claws = "claws" }

---------------------------------------------------------------- анимации
