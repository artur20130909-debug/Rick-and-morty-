	for _, c in ipairs({ { -1.25, -3.1, 180 }, { 1.25, -3.1, 180 }, { -1.25, 3.1, 0 }, { 1.25, 3.1, 0 } }) do
		chair(fu, CF(14 + c[1], F1, 10.5 + c[2], c[3]), "#7a5a3a")
	end
	fvc(fu, "FruitBowl", tf, 0, 3.1, 0, 0.45, 1.6, "#d8c8a8", M.plastic, NCS)
	for i = 0, 3 do
