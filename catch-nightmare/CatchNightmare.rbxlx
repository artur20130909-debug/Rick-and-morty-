<Item class="StarterPlayer" referent="RBX0000001B"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">70</float><float name="CharacterWalkSpeed">16</float><float name="CharacterJumpHeight">7.2</float></Properties><Item class="StarterPlayerScripts" referent="RBX0000001A"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000019"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Запуск клиента: картинка мира (свет, подсказки, клетки) и интерфейс.
