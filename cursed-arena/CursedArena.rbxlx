<Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[-- Процедурный аниматор всех бойцов (игроки, боты, манекены) на этом клиенте.
-- База: стойка/бег/прыжок/блок/оглушение; поверх — анимация приёма (Poses.Anims) и «откид» при попадании.
-- Позы переводятся в Motor6D.Transform каждый кадр (RunService.PreSimulation).
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Poses = require(Shared.Poses)
local Rig = require(Shared.Rig)
local Characters = require(Shared.Characters)

local Animator = {}
local recs = {}        -- model -> запись
Animator.recs = recs
Animator.local_model = nil
Animator.localBlock = false

local JOINTS = Poses.JOINTS
local BASE = Poses.BaseVals
local MAXDIST = 320

local function newVals()
	local t = {}
	for _, j in ipairs(JOINTS) do t[j] = { 0, 0, 0, 0, 0, 0 } end
	return t
end

local function copyInto(dst, src)
	for _, j in ipairs(JOINTS) do
		local d, s = dst[j], src[j]
		for i = 1, 6 do d[i] = s[i] end
	end
end

-- dst = dst*(1-w) + src*w  (только суставы src)
local function blend(dst, src, w)
	if w <= 0 then return end
	for j, s in pairs(src) do
		local d = dst[j]
		if d then
			for i = 1, 6 do d[i] = d[i] + (s[i] - d[i]) * w end
		end
	end
end

local function addScaled(dst, src, k)
	if k == 0 then return end
	for j, s in pairs(src) do
		local d = dst[j]
		if d then for i = 1, 6 do d[i] = d[i] + s[i] * k end end
	end
end

local function approach(cur, target, rate, dt)
	return cur + (target - cur) * math.min(1, rate * dt)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function getRec(model)
	local r = recs[model]
	if r then return r end
	local root = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return nil end
	local motors, rot0 = Rig.find(model)
	if not motors.T then return nil end
	r = {
		model = model, root = root, hum = hum, motors = motors, rot0 = rot0,
		vals = newVals(), base = newVals(), runVals = newVals(), tmp = {},
		phase = 0, blockW = 0, stunW = 0, airW = 0, combatW = 0, moveW = 0, rootedW = 0,
		action = nil, flinch = nil, freezeUntil = 0, lastCombat = -100, t = 0,
		airborne = false, airCheck = 0,
	}
	recs[model] = r
	return r
end

function Animator.track(model)
	return getRec(model)
end

-- проиграть анимацию приёма
function Animator.play(model, name, speed)
	local anim = Poses.get(name)
	if not anim then return end
	local r = getRec(model)
	if not r then return end
	-- плавный переход: текущая поза — стартовая точка
	r.action = { anim = anim, name = name, t = 0, speed = speed or 1, w = 0, out = false, outW = 1 }
	r.lastCombat = os.clock()
	r.lastPlay = { name = name, at = os.clock() }
end

function Animator.stop(model)
	local r = recs[model]
	if r and r.action and not r.action.out then
		r.action.out = true
		r.action.outW = r.action.w
	end
end

-- недавно уже запущена такая анимация (предсказание на своём клиенте)
function Animator.recentlyPlayed(model, name, window)
	local r = recs[model]
	return r and r.lastPlay and r.lastPlay.name == name and os.clock() - r.lastPlay.at < (window or 0.35)
end

function Animator.flinch(model, heavy)
	local r = getRec(model)
	if not r then return end
	r.flinch = { t = 0, kind = heavy and "heavy" or "light", side = math.random() < 0.5 and -1 or 1 }
	r.lastCombat = os.clock()
end

-- стоп-кадр при сильном ударе
function Animator.freeze(model, t)
	local r = recs[model]
	if r then r.freezeUntil = math.max(r.freezeUntil, os.clock() + t) end
end

function Animator.combat(model)
	local r = recs[model]
	if r then r.lastCombat = os.clock() end
end

---------------------------------------------------------------- бег
local function runPose(r, out, amp, style, phase, back)
	local s = math.sin(phase)
	local c = math.cos(phase)
	local bob = math.abs(c)
	local dir = back and -1 or 1
	local T, H, RA, LA, RL, LL = out.T, out.H, out.RA, out.LA, out.RL, out.LL
	T[1], T[2], T[3], T[4], T[5], T[6] = (back and -4 or 9) * amp, 7 * s * amp * dir, 0, 0, -0.18 * amp + 0.2 * bob * amp, 0
	H[1], H[2], H[3] = (back and 2 or -5) * amp, -6 * s * amp * dir, 0
	H[4], H[5], H[6] = 0, 0, 0
	local arm = 48 * amp
	if style == "ninja" then
		RA[1], RA[2], RA[3] = -62, 0, 14
		LA[1], LA[2], LA[3] = -62, 0, 14
		T[1] = 22 * amp
		H[1] = -14 * amp
	elseif style == "sword" then
		RA[1], RA[2], RA[3] = 30 - 10 * s * amp, 0, 8
		LA[1], LA[2], LA[3] = arm * s, 0, 7
	else
		RA[1], RA[2], RA[3] = -arm * s, 0, 7
		LA[1], LA[2], LA[3] = arm * s, 0, 7
	end
	RA[4], RA[5], RA[6] = 0, 0, 0
	LA[4], LA[5], LA[6] = 0, 0, 0
	RL[1], RL[2], RL[3], RL[4], RL[5], RL[6] = 46 * s * amp * dir, 0, 2, 0, 0, 0
	LL[1], LL[2], LL[3], LL[4], LL[5], LL[6] = -46 * s * amp * dir, 0, 2, 0, 0, 0
end

local RUN_STYLE = { Thunderer = "ninja", ShadowCaller = "ninja", CrimsonBlade = "sword" }

---------------------------------------------------------------- кадр
local function updateRec(r, dt, now, camPos)
	local model, root, hum = r.model, r.root, r.hum
	if not model.Parent or not root.Parent then return false end
	if model:GetAttribute("Ragdoll") or hum.Health <= 0 then
		r.action = nil
		return true
	end
	if camPos and (root.Position - camPos).Magnitude > MAXDIST then return true end
	local frozen = now < r.freezeUntil
	local adt = frozen and 0 or dt
	r.t = r.t + adt
	local charId = model:GetAttribute("Char") or "StormFist"
	local def = Characters.Defs[charId]
	local style = def and def.M1Style or "fists"
	if charId == "Dummy" then style = "stand" end

	-- движение
	local vel = root.AssemblyLinearVelocity
	local cf = root.CFrame
	local fwd = vel:Dot(cf.LookVector)
	local side = vel:Dot(cf.RightVector)
	local hs = math.sqrt(fwd * fwd + side * side)
	-- в воздухе?
	r.airCheck = r.airCheck - dt
	if r.airCheck <= 0 then
		r.airCheck = 0.06
		local map = workspace:FindFirstChild("Map")
		if map then
			rayParams.FilterDescendantsInstances = { map }
			local hit = workspace:Raycast(root.Position, Vector3.new(0, -4.2, 0), rayParams)
			r.airborne = hit == nil
		end
	end
	local blocking = model:GetAttribute("Blocking") or (model == Animator.local_model and Animator.localBlock)
	local stunned = model:GetAttribute("Stunned")
	local rooted = model:GetAttribute("Rooted")
	local guardBroken = model:GetAttribute("GuardBroken")
	r.blockW = approach(r.blockW, blocking and 1 or 0, 22, dt)
	r.stunW = approach(r.stunW, stunned and 1 or 0, 12, dt)
	r.rootedW = approach(r.rootedW, rooted and 1 or 0, 10, dt)
	r.airW = approach(r.airW, r.airborne and 1 or 0, 10, dt)
	local inCombat = (os.clock() - r.lastCombat) < 6 or model:GetAttribute("Awakened")
	r.combatW = approach(r.combatW, inCombat and 1 or 0, 3, dt)
	r.moveW = approach(r.moveW, math.clamp(hs / 14, 0, 1), 10, dt)

	-- база: спокойная стойка -> боевая
	local vals = r.vals
	local stanceName = Poses.StanceOf[style] or "fists"
	if style == "stand" then stanceName = "stand" end
	copyInto(vals, BASE.stand)
	if stanceName ~= "stand" then blend(vals, BASE[stanceName], r.combatW) end
	-- дыхание
	local br = math.sin(r.t * 2.1)
	vals.T[5] = vals.T[5] + 0.03 * br
	vals.RA[1] = vals.RA[1] + 1.6 * br
	vals.LA[1] = vals.LA[1] + 1.6 * br
	vals.H[1] = vals.H[1] - 1 * br

	-- бег
	if r.moveW > 0.01 and not r.airborne then
		local stride = 7.2
		r.phase = r.phase + adt * hs / stride * math.pi * 2
		local amp = math.clamp(hs / 20, 0.35, 1.25)
		runPose(r, r.runVals, amp, RUN_STYLE[charId] or "normal", r.phase, fwd < -2)
		blend(vals, r.runVals, r.moveW)
	end
	-- воздух
	if r.airW > 0.01 then
		local vy = vel.Y
		local airPose = vy > 4 and BASE.air_up or BASE.air_down
		blend(vals, airPose, r.airW * 0.85)
	end
	-- блок / оглушение / сковывание
	if r.blockW > 0.01 then blend(vals, style == "sword" and BASE.block_sword or BASE.block, r.blockW) end
	if r.stunW > 0.01 then
		blend(vals, guardBroken and BASE.dizzy or BASE.stun, r.stunW)
		local sway = math.sin(r.t * (guardBroken and 4 or 9))
		vals.T[3] = vals.T[3] + sway * (guardBroken and 8 or 2) * r.stunW
		vals.H[3] = vals.H[3] + sway * (guardBroken and 12 or 3) * r.stunW
	end
	if r.rootedW > 0.01 then blend(vals, BASE.rooted, r.rootedW) end

	-- приём
	local a = r.action
	if a then
		local anim = a.anim
		a.t = a.t + adt * a.speed
		local w
		if a.out then
			a.outW = a.outW - adt / math.max(0.02, anim.fo)
			w = a.outW
			if w <= 0 then
				r.action = nil
				w = 0
			end
		else
			w = math.min(1, a.t / math.max(0.01, anim.fi))
			if not anim.loop and a.t >= anim.d then
				if anim.fo <= 0 then
					r.action = nil
					w = 0
				else
					a.out = true
					a.outW = 1
				end
			end
		end
		a.w = w
		if r.action and w > 0 then
			local tt = anim.loop and a.t or math.min(a.t, anim.d)
			Poses.sample(anim, tt, r.tmp)
			-- только суставы этой анимации
			for j in pairs(anim.mask) do
				local d, s = vals[j], r.tmp[j]
				for i = 1, 6 do d[i] = d[i] + (s[i] - d[i]) * w end
			end
		end
	end

	-- откид при попадании
	local fl = r.flinch
	if fl then
		fl.t = fl.t + adt
		local k
		if fl.t < 0.05 then k = fl.t / 0.05 else k = math.max(0, 1 - (fl.t - 0.05) / 0.28) end
		if k <= 0 then
			r.flinch = nil
		else
			addScaled(vals, Poses.FlinchVals[fl.kind], k)
			vals.T[3] = vals.T[3] + 8 * fl.side * k
		end
	end

	Rig.apply(r.motors, r.rot0, vals)
	return true
end

local started = false
function Animator.start()
	if started then return end
	started = true
	-- новые бойцы появляются в workspace (игроки) и workspace.Bots
	RunService.PreSimulation:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position
		local now = os.clock()
		for model, r in pairs(recs) do
			local ok, alive = pcall(updateRec, r, dt, now, camPos)
			if not ok then
				warn("[Animator] " .. tostring(alive))
				recs[model] = nil
			elseif not alive then
				recs[model] = nil
			end
		end
	end)
	-- подхватываем всех бойцов
	local function scan(container)
		for _, m in ipairs(container:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Fighter") then getRec(m) end
		end
	end
	local function watch(container)
		container.ChildAdded:Connect(function(m)
			if m:IsA("Model") then
				task.defer(function()
					if m:GetAttribute("Fighter") then getRec(m) end
				end)
				m:GetAttributeChangedSignal("Fighter"):Connect(function()
					if m:GetAttribute("Fighter") then getRec(m) end
				end)
			end
		end)
	end
	scan(workspace)
	watch(workspace)
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		scan(bots)
		watch(bots)
	end
	workspace.ChildAdded:Connect(function(c)
		if c.Name == "Bots" and c:IsA("Folder") then
			scan(c)
			watch(c)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			scan(workspace)
			local b = workspace:FindFirstChild("Bots")
			if b then scan(b) end
		end
	end)
end

return Animator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">CameraFX</string><ProtectedString name="Source"><![CDATA[-- Камера: тряска, «удар» FOV, короткая кинокамера (пробуждение, ульта).
-- Кинокамера всегда возвращает обычную камеру сама (даже при ошибке или смерти).
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local CameraFX = {}
CameraFX.enabled = true      -- настройка «Тряска камеры»
CameraFX.baseFov = 70

local trauma = 0
local fovKick = 0
local cine = nil

function CameraFX.shake(m)
	if not CameraFX.enabled then return end
	trauma = math.min(1, trauma + (m or 0.5) * 0.42)
end

function CameraFX.kick(f)
	fovKick = math.max(fovKick, f or 4)
end

local function restore()
	local cam = workspace.CurrentCamera
	if not cam then return end
	cam.CameraType = Enum.CameraType.Custom
	local char = Players.LocalPlayer and Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end

-- облёт вокруг модели dur секунд
function CameraFX.cinematic(model, dur)
	if cine then return end
	local root = model and model:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not root or not cam then return end
	cine = { model = model, root = root, t0 = os.clock(), dur = dur, startCF = cam.CFrame,
		yaw0 = math.atan2(-(cam.CFrame.Position - root.Position).X, (cam.CFrame.Position - root.Position).Z) }
	cam.CameraType = Enum.CameraType.Scriptable
	task.delay(dur + 0.3, function()
		if cine then
			cine = nil
			restore()
		end
	end)
end

function CameraFX.cancelCinematic()
	if cine then
		cine = nil
		restore()
	end
end

RunService:BindToRenderStep("CursedCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end
	if cine then
		local ok = pcall(function()
			local c = cine
			local t = (os.clock() - c.t0) / c.dur
			if t >= 1 or not c.root.Parent then
				cine = nil
				restore()
				return
			end
			local look = c.root.CFrame.LookVector
			local ang = math.atan2(look.X, look.Z) + math.pi * (0.15 + 0.5 * t)
			local dist = 11 - 3 * math.sin(t * math.pi)
			local focus = c.root.Position + Vector3.new(0, 1.6, 0)
			local pos = focus + Vector3.new(math.sin(ang) * dist, 2.5 + 1.5 * t, math.cos(ang) * dist)
			cam.CFrame = CFrame.lookAt(pos, focus)
		end)
		if not ok then
			cine = nil
			restore()
		end
	end
	if trauma > 0 then
		local s = trauma * trauma
		local t = os.clock() * 26
		local rx = math.noise(t, 1.3) * s * 0.07
		local ry = math.noise(t, 7.1) * s * 0.07
		local rz = math.noise(t, 13.7) * s * 0.05
		cam.CFrame = cam.CFrame * CFrame.Angles(rx, ry, rz)
		trauma = math.max(0, trauma - dt * 2.4)
	end
	if fovKick > 0.01 then
		cam.FieldOfView = CameraFX.baseFov + fovKick
		fovKick = fovKick * math.max(0, 1 - dt * 9)
	elseif cam.FieldOfView ~= CameraFX.baseFov then
		cam.FieldOfView = CameraFX.baseFov
	end
end)

-- при смене персонажа — обычная камера
Players.LocalPlayer.CharacterAdded:Connect(function()
	cine = nil
	task.defer(restore)
end)

return CameraFX
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Controller</string><ProtectedString name="Source"><![CDATA[-- Управление: ПК (мышь + клавиатура), геймпад, телефон (кнопки создаёт HUD и зовёт Controller.*).
-- M1 и рывок показываются у себя сразу (без ожидания сервера), урон и проверки — на сервере.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = ReplicatedStorage:WaitForChild("Client")
local Config = require(Shared.Config)
local Characters = require(Shared.Characters)
local Poses = require(Shared.Poses)
local Util = require(Shared.Util)
local Animator = require(Client.Animator)
local Effects = require(Client.Effects)

local Controller = {}
local player = Players.LocalPlayer
local Action = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Action")

Controller.enabled = true           -- false, пока открыто меню
Controller.cds = { 0, 0, 0, 0 }     -- конец перезарядки приёмов (время сервера)
Controller.cdLen = { 1, 1, 1, 1 }   -- полная длина перезарядки (для полоски)
Controller.dashReady = { F = 0, B = 0, L = 0, R = 0 } -- os.clock(), когда рывок снова доступен
Controller.recast = nil             -- { slot, from, to } окно повторного нажатия (время сервера)
Controller.awakened = false
-- обратные вызовы для интерфейса
Controller.onDenied = nil           -- function(what, slot) — нажали, но нельзя (перезарядка, мало шкалы)
Controller.onM1 = nil               -- function(index)
Controller.onDash = nil             -- function(key)
Controller.onMove = nil             -- function(slot)

local state = {
	char = nil, hum = nil, root = nil,
	m1Index = 0, m1Last = -100, m1CdEnd = 0, busyEnd = 0,
	m1Held = false, blockHeld = false, blocking = false,
	faceDir = nil, faceUntil = 0,
	dashUntil = 0, dashLV = nil, dashFace = nil,
	lastSend = {},
}
Controller.state = state

---------------------------------------------------------------- персонаж
local function attr(name)
	return state.char and state.char:GetAttribute(name)
end

local function alive()
	return state.hum ~= nil and state.hum.Health > 0 and state.root ~= nil and state.root.Parent ~= nil
end

local function charId()
	local id = attr("Char") or player:GetAttribute("CharId")
	if Characters.valid(id) then return id end
	return Characters.Default
end

local m1Cache = {}
local function m1Config()
	local id = charId()
	local c = m1Cache[id]
	if c then return c end
	c = {}
	for k, v in pairs(Config.M1) do c[k] = v end
	local def = Characters.get(id)
	if def.M1 then for k, v in pairs(def.M1) do c[k] = v end end
	m1Cache[id] = c
	return c
end

-- можно ли сейчас действовать (по данным сервера и своим)
local function free()
	if not Controller.enabled or not alive() then return false end
	if attr("Ragdoll") or attr("Stunned") or attr("Rooted") then return false end
	if attr("Busy") then return false end
	if state.blocking then return false end
	return true
end
Controller.free = free

local function serverNow()
	return workspace:GetServerTimeNow()
end

---------------------------------------------------------------- прицел
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function enemiesNear(pos, range)
	local out = {}
	local function scan(folder)
		if not folder then return end
		for _, m in ipairs(folder:GetChildren()) do
			if m ~= state.char and m:IsA("Model") and m:GetAttribute("Fighter") then
				local r = m:FindFirstChild("HumanoidRootPart")
				local h = m:FindFirstChildOfClass("Humanoid")
				if r and h and h.Health > 0 and not m:GetAttribute("Invisible") then
					local d = (r.Position - pos).Magnitude
					if d <= range then out[#out + 1] = { model = m, root = r, dist = d } end
				end
			end
		end
	end
	scan(workspace)
	scan(workspace:FindFirstChild("Bots"))
	return out
end

local function mouseLocked()
	return UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
end

-- куда целимся: { dir = направление, pos = точка на карте }
function Controller.aim()
	local cam = workspace.CurrentCamera
	if not cam or not alive() then return {} end
	local rootPos = state.root.Position
	local look = Util.flat(cam.CFrame.LookVector, state.root.CFrame.LookVector)
	local pos
	local filter = { state.char }
	local fx = workspace:FindFirstChild("FX")
	if fx then filter[#filter + 1] = fx end
	local lfx = workspace:FindFirstChild("LocalFX")
	if lfx then filter[#filter + 1] = lfx end
	rayParams.FilterDescendantsInstances = filter
	local ray
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		local vs = cam.ViewportSize
		ray = cam:ViewportPointToRay(vs.X / 2, vs.Y * 0.42)
	elseif mouseLocked() then
		local vs = cam.ViewportSize
		ray = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
	else
		local m = UserInputService:GetMouseLocation()
		ray = cam:ViewportPointToRay(m.X, m.Y)
	end
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
	pos = hit and hit.Position or (ray.Origin + ray.Direction * 500)
	local dir = look
	-- свободная мышь на ПК: бьём в сторону курсора
	if not mouseLocked() and UserInputService.MouseEnabled then
		dir = Util.flat(pos - rootPos, look)
	end
	-- мягкое наведение: ближайший враг перед нами
	local best, bestScore
	for _, e in ipairs(enemiesNear(rootPos, 16)) do
		local to = Util.flat(e.root.Position - rootPos, dir)
		local dot = to:Dot(dir)
		if dot > 0.6 or e.dist < 5 and dot > 0.1 then
			local score = e.dist - dot * 6
			if not bestScore or score < bestScore then best, bestScore = e, score end
		end
	end
	if best then
		dir = Util.flat(best.root.Position - rootPos, dir)
		if (pos - rootPos).Magnitude > 40 or not hit then pos = best.root.Position end
	end
	return { dir = dir, pos = pos }
end

-- повернуться в сторону удара на короткое время
local function faceFor(dir, t)
	if not dir or not alive() then return end
	state.faceDir = Util.flat(dir, state.root.CFrame.LookVector)
	state.faceUntil = os.clock() + t
	state.hum.AutoRotate = false
	local p = state.root.Position
	state.root.CFrame = CFrame.lookAt(p, p + state.faceDir)
end

---------------------------------------------------------------- M1
local function jumpHeld()
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then return true end
	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then return true end
	if UserInputService.TouchEnabled and state.hum and state.hum.Jump then return true end
	return Controller.touchJump == true
end

function Controller.m1()
	if not free() then return false end
	local cfg = m1Config()
	local now = os.clock()
	if now < state.m1CdEnd then return false end
	if now - state.m1Last < cfg.Interval then return false end
	if now - state.m1Last > cfg.ComboWindow then state.m1Index = 0 end
	state.m1Index = state.m1Index + 1
	state.m1Last = now
	local idx = state.m1Index
	local finisher = idx >= cfg.Count
	local variant = "n"
	local up = jumpHeld()
	local air = state.hum.FloorMaterial == Enum.Material.Air
	if finisher then
		if up then variant = "up" elseif air then variant = "down" end
		state.m1CdEnd = now + cfg.EndLag
		state.m1Index = 0
	end
	state.busyEnd = now + cfg.BusyTime * (finisher and 1.7 or 1)
	local aim = Controller.aim()
	faceFor(aim.dir, finisher and 0.4 or 0.3)
	local style = Characters.get(charId()).M1Style
	local list = Poses.M1[style] or Poses.M1.fists
	local name
	if variant == "up" then name = list[5] elseif variant == "down" then name = list[6] else name = list[idx] end
	Animator.play(state.char, name)
	Effects.swing(state.char, style, idx, variant)
	Action:FireServer("M1", aim, up, air)
	if Controller.onM1 then Controller.onM1(idx) end
	return true
end

function Controller.setM1Held(on)
	state.m1Held = on and true or false
	if on then Controller.m1() end
end

---------------------------------------------------------------- блок
function Controller.setBlock(on)
	on = on and true or false
	state.blockHeld = on
	if on then
		if not alive() or not Controller.enabled then return end
		if attr("Ragdoll") or attr("Stunned") or attr("Rooted") or attr("Busy") then return end
		state.blocking = true
		Animator.localBlock = true
		state.m1Held = false
		Action:FireServer("Block", true)
	elseif state.blocking then
		state.blocking = false
		Animator.localBlock = false
		Action:FireServer("Block", false)
	end
end

---------------------------------------------------------------- рывок
local DASH_CD = { F = "FrontCooldown", B = "BackCooldown", L = "SideCooldown", R = "SideCooldown" }

local function stopDash()
	if state.dashLV then
		state.dashLV:Destroy()
		state.dashLV = nil
	end
	state.dashUntil = 0
	state.dashFace = nil
	if state.hum and os.clock() >= state.faceUntil then state.hum.AutoRotate = true end
end

-- направление по нажатым клавишам относительно камеры
local function dashDirection()
	local cam = workspace.CurrentCamera
	local look = Util.flat(cam and cam.CFrame.LookVector or state.root.CFrame.LookVector, state.root.CFrame.LookVector)
	local right = Vector3.new(-look.Z, 0, look.X)
	local md = state.hum.MoveDirection
	md = Vector3.new(md.X, 0, md.Z)
	if md.Magnitude < 0.2 then
		local fwd = Util.flat(state.root.CFrame.LookVector)
		return "F", fwd, fwd
	end
	md = md.Unit
	local f, r = md:Dot(look), md:Dot(right)
	if math.abs(f) >= math.abs(r) * 0.9 then
		if f >= 0 then return "F", md, md end
		return "B", md, -md
	end
	return (r > 0 and "R" or "L"), md, look
end

function Controller.dash()
	if not free() or attr("Busy") then return false end
	local key, dir, face = dashDirection()
	local now = os.clock()
	if now < Controller.dashReady[key] then
		if Controller.onDenied then Controller.onDenied("dash", key) end
		return false
	end
	Controller.dashReady[key] = now + Config.Dash[DASH_CD[key]]
	-- сброс серии M1 не нужен: рывок можно вставить между ударами
	stopDash()
	local root = state.root
	local att = root:FindFirstChild("ClientDashAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "ClientDashAtt"
		att.Parent = root
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "ClientDash"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	lv.PlaneVelocity = Vector2.new(dir.X, dir.Z) * Config.Dash.Speed
	lv.MaxForce = 1e6
	lv.Parent = root
	state.dashLV = lv
	state.dashUntil = now + Config.Dash.Time
	state.dashFace = face
	state.hum.AutoRotate = false
	local p = root.Position
	root.CFrame = CFrame.lookAt(p, p + face)
	Effects.dashFX(state.char, key)
	Action:FireServer("Dash", key, dir)
	if Controller.onDash then Controller.onDash(key) end
	return true
end

---------------------------------------------------------------- приёмы 1–4 и пробуждение
function Controller.slotReady(slot)
	return serverNow() >= (Controller.cds[slot] or 0)
end

function Controller.recastOpen(slot)
	local rc = Controller.recast
	return rc ~= nil and rc.slot == slot and serverNow() <= rc.to + 0.1
end

function Controller.move(slot)
	if not alive() or not Controller.enabled then return false end
	local now = os.clock()
	-- не чаще 8 раз в секунду на кнопку
	if now - (state.lastSend[slot] or 0) < 0.12 then return false end
	local recast = Controller.recastOpen(slot)
	if not recast then
		if not Controller.slotReady(slot) then
			if Controller.onDenied then Controller.onDenied("cooldown", slot) end
			return false
		end
		if attr("Silenced") then
			if Controller.onDenied then Controller.onDenied("silenced", slot) end
			return false
		end
		if not free() then return false end
	end
	state.lastSend[slot] = now
	local aim = Controller.aim()
	if not recast then faceFor(aim.dir, 0.25) end
	Action:FireServer("Move", slot, aim)
	if Controller.onMove then Controller.onMove(slot) end
	return true
end

function Controller.awaken()
	if not alive() or not Controller.enabled then return false end
	if attr("Awakened") then return false end
	if (attr("Meter") or 0) < Config.Awaken.Max then
		if Controller.onDenied then Controller.onDenied("meter") end
		return false
	end
	if not free() then return false end
	Action:FireServer("Awaken")
	return true
end

-- снять всё зажатое (открыли меню, умерли)
function Controller.releaseAll()
	state.m1Held = false
	if state.blocking or state.blockHeld then
		state.blockHeld = true
		Controller.setBlock(false)
	end
	state.blockHeld = false
end

---------------------------------------------------------------- ввод
local MOVE_KEYS = {}
for i, k in ipairs(Config.Keys.Moves) do MOVE_KEYS[k] = i end
local PAD_MOVES = { [Enum.KeyCode.ButtonX] = 1, [Enum.KeyCode.ButtonY] = 2, [Enum.KeyCode.ButtonR1] = 3, [Enum.KeyCode.ButtonL1] = 4 }
local NUMPAD = { [Enum.KeyCode.KeypadOne] = 1, [Enum.KeyCode.KeypadTwo] = 2, [Enum.KeyCode.KeypadThree] = 3, [Enum.KeyCode.KeypadFour] = 4 }

UserInputService.InputBegan:Connect(function(input, processed)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then
		if processed then return end
		Controller.setM1Held(true)
		return
	end
	if processed then return end
	local k = input.KeyCode
	if k == Config.Keys.Block or k == Enum.KeyCode.ButtonL2 then
		Controller.setBlock(true)
	elseif k == Config.Keys.Dash or k == Enum.KeyCode.ButtonB then
		Controller.dash()
	elseif k == Config.Keys.Awaken or k == Enum.KeyCode.DPadUp then
		Controller.awaken()
	elseif k == Enum.KeyCode.ButtonR2 then
		Controller.setM1Held(true)
	elseif MOVE_KEYS[k] or NUMPAD[k] or PAD_MOVES[k] then
		Controller.move(MOVE_KEYS[k] or NUMPAD[k] or PAD_MOVES[k])
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	local k = input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.ButtonR2 then
		state.m1Held = false
	elseif k == Config.Keys.Block or k == Enum.KeyCode.ButtonL2 then
		Controller.setBlock(false)
	end
end)

UserInputService.WindowFocusReleased:Connect(function()
	Controller.releaseAll()
end)

---------------------------------------------------------------- кадр
RunService.RenderStepped:Connect(function()
	if not alive() then return end
	local now = os.clock()
	-- зажатая ЛКМ — серия продолжается сама
	if state.m1Held and not state.blocking then Controller.m1() end
	-- блок: если зажат, но сервер ещё не дал (были оглушены) — пробуем снова
	if state.blockHeld and not state.blocking then Controller.setBlock(true) end
	if state.blocking and (attr("Ragdoll") or attr("Stunned")) and not attr("Blocking") then
		-- пробили блок или оглушили: отпускаем, игрок нажмёт снова
		state.blocking = false
		Animator.localBlock = false
	end
	-- рывок
	if state.dashLV then
		if now >= state.dashUntil or attr("Ragdoll") or attr("Stunned") then
			stopDash()
		elseif state.dashFace then
			local p = state.root.Position
			state.root.CFrame = CFrame.lookAt(p, p + state.dashFace)
		end
	end
	-- поворот к цели удара
	if state.faceDir then
		if now < state.faceUntil and not attr("Ragdoll") then
			if not state.dashLV then
				local p = state.root.Position
				local cur = Util.flat(state.root.CFrame.LookVector)
				local d = cur:Lerp(state.faceDir, 0.5)
				if d.Magnitude > 0.05 then state.root.CFrame = CFrame.lookAt(p, p + d.Unit) end
			end
		else
			state.faceDir = nil
			if not state.dashLV then state.hum.AutoRotate = true end
		end
	end
end)

local function bind(char)
	state.char = char
	state.hum = char:WaitForChild("Humanoid", 10)
	state.root = char:WaitForChild("HumanoidRootPart", 10)
	state.m1Index, state.m1Last, state.m1CdEnd, state.busyEnd = 0, -100, 0, 0
	state.blocking, state.m1Held = false, false
	state.faceDir, state.dashLV, state.dashUntil = nil, nil, 0
	Animator.local_model = char
	Animator.localBlock = false
	Controller.recast = nil
	for k in pairs(Controller.dashReady) do Controller.dashReady[k] = 0 end
	if state.hum then
		state.hum.Died:Connect(function()
			if state.char == char then Controller.releaseAll() end
		end)
	end
end

player.CharacterAdded:Connect(bind)
if player.Character then task.spawn(bind, player.Character) end

return Controller
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Обработчики эффектов от сервера (Remotes.FX): удары, блоки, приёмы, снаряды, территории.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = ReplicatedStorage:WaitForChild("Client")
local Characters = require(Shared.Characters)
local Poses = require(Shared.Poses)
local Util = require(Shared.Util)
local FX = require(Client.FX)
local Animator = require(Client.Animator)
local CameraFX = require(Client.CameraFX)
local SoundFX = require(Client.SoundFX)

local Effects = {}
local H = {}
Effects.handlers = H
Effects.ui = nil          -- ставит ClientMain: { flash = f(color, t, a), announce = f(...), killfeed = f(...), damage = f(...) }

local player = Players.LocalPlayer
local WHITE = Color3.new(1, 1, 1)

local function myChar() return player.Character end
local function isMe(model) return model ~= nil and model == player.Character end
local function rootOf(m) return m and m:FindFirstChild("HumanoidRootPart") end
local function colorsOf(model)
	local id = model and model:GetAttribute("Char")
	local def = id and Characters.Defs[id]
	if def then return def.Color, def.Accent end
	return Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 220, 120)
end
local function ground(pos)
	return (Util.ground(pos, 30))
end

local HIT_COLORS = {
	punch = { Color3.fromRGB(255, 236, 200), Color3.fromRGB(255, 255, 255) },
	heavy = { Color3.fromRGB(255, 150, 70), Color3.fromRGB(255, 240, 200) },
	crit = { Color3.fromRGB(230, 20, 30), Color3.fromRGB(10, 0, 0) },
	crit2 = { Color3.fromRGB(255, 70, 40), Color3.fromRGB(255, 220, 120) },
	slash = { Color3.fromRGB(240, 40, 60), Color3.fromRGB(255, 255, 255) },
	slashHeavy = { Color3.fromRGB(230, 20, 50), Color3.fromRGB(255, 230, 230) },
	void = { Color3.fromRGB(92, 214, 255), Color3.fromRGB(170, 92, 255) },
	shadow = { Color3.fromRGB(128, 72, 220), Color3.fromRGB(30, 20, 50) },
	bite = { Color3.fromRGB(140, 80, 230), Color3.fromRGB(20, 10, 30) },
	fire = { Color3.fromRGB(255, 128, 28), Color3.fromRGB(255, 222, 90) },
	zap = { Color3.fromRGB(110, 196, 255), Color3.fromRGB(255, 248, 160) },
}
local HIT_SOUND = { punch = "Punch", heavy = "PunchHeavy", crit = "Resonance", crit2 = "PunchHeavy", slash = "Slash", slashHeavy = "SlashHeavy",
	void = "Punch", shadow = "Punch", bite = "Bite", fire = "Punch", zap = "Zap" }

---------------------------------------------------------------- удары
H.Hit = function(d)
	local target = d.t
	local kind = d.k or "punch"
	local cols = HIT_COLORS[kind] or HIT_COLORS.punch
	local pos = d.p or (rootOf(target) and rootOf(target).Position)
	if not pos then return end
	local heavy = d.heavy or kind == "crit" or kind == "heavy"
	FX.impact(pos, cols[1], heavy, cols[2])
	if kind == "fire" then
		FX.emit(pos, { tex = "fire", color = cols[1], color2 = cols[2], n = 10, speed = 10, life = 0.35 })
	elseif kind == "shadow" or kind == "bite" then
		FX.emit(pos, { tex = "smoke", color = Color3.fromRGB(40, 20, 60), n = 6, speed = 8, life = 0.5, light = 0 })
	elseif kind == "zap" then
		for _ = 1, 2 do FX.bolt(pos, pos + Vector3.new(Util.rand(-4, 4), Util.rand(-2, 4), Util.rand(-4, 4)), cols[1], 0.18, 0.12, cols[2]) end
	elseif kind == "slash" or kind == "slashHeavy" then
		FX.slashMark(pos, cols[1], heavy and 7 or 5, 0.22)
	end
	SoundFX.play(HIT_SOUND[kind] or "Punch", pos)
	if target then
		Animator.flinch(target, heavy)
		if d.hs then Animator.freeze(target, d.hs) end
	end
	if d.a then
		Animator.combat(d.a)
		if d.hs then Animator.freeze(d.a, d.hs) end
	end
	-- камера и интерфейс для участников
	if isMe(d.a) then
		CameraFX.shake((d.s or 0.25) * 0.8)
		if heavy then CameraFX.kick(3) end
		if Effects.ui and d.d and d.d > 0 then Effects.ui.damage(target, d.d, cols[1], d.crit) end
	elseif isMe(target) then
		CameraFX.shake(math.max(0.35, d.s or 0.35))
		if Effects.ui then Effects.ui.flash(Color3.fromRGB(200, 20, 20), 0.25, heavy and 0.35 or 0.2) end
	end
end

H.Dmg = function(d)
	if isMe(d.a) and Effects.ui and d.d and d.d >= 0.5 then
		Effects.ui.damage(d.t, d.d, Color3.fromRGB(255, 170, 90), false, true)
	end
end

H.Block = function(d)
	local t = d.t
	local root = rootOf(t)
	local pos = d.p or (root and root.Position)
	if not pos then return end
	local front = root and (root.Position + root.CFrame.LookVector * 1.6) or pos
	FX.ball(front, Color3.fromRGB(150, 210, 255), 0.6, d.heavy and 3 or 2, 0.18, 0.2)
	FX.sparks(front, Color3.fromRGB(200, 230, 255), d.heavy and 12 or 7, 40, { dir = root and root.CFrame.LookVector, spread = 0.9, size = 0.18, life = 0.15 })
	SoundFX.play("Block", pos)
	Animator.flinch(t, false)
	if isMe(t) then CameraFX.shake(0.25) end
end

H.Parry = function(d)
	local root = rootOf(d.t)
	local pos = d.p or (root and root.Position)
	if not pos then return end
	FX.ball(pos, WHITE, 1, 6, 0.3, 0)
	FX.ring(pos, Color3.fromRGB(180, 230, 255), 1, 10, 0.4, { cf = CFrame.lookAt(pos, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(math.rad(90), 0, 0), w = 0.6 })
	FX.light(pos, Color3.fromRGB(200, 240, 255), 30, 8, 0.35)
	FX.text(pos + Vector3.new(0, 3.5, 0), "ПАРИРОВАНИЕ!", Color3.fromRGB(170, 230, 255), 1)
	SoundFX.play("Parry", pos)
	if d.a then Animator.flinch(d.a, true) end
	if isMe(d.t) or isMe(d.a) then CameraFX.shake(0.6) end
end

H.GuardBreak = function(d)
	local pos = d.p or (rootOf(d.t) and rootOf(d.t).Position)
	if not pos then return end
	FX.ball(pos, Color3.fromRGB(255, 200, 120), 1, 5, 0.3, 0.1)
	FX.sparks(pos, Color3.fromRGB(150, 210, 255), 18, 50, { size = 0.3 })
	FX.text(pos + Vector3.new(0, 3.5, 0), "БЛОК ПРОБИТ", Color3.fromRGB(255, 190, 90), 0.9)
	SoundFX.play("GuardBreak", pos)
	if isMe(d.t) then CameraFX.shake(0.7) end
end

H.Evade = function(d)
	if d.t then FX.afterimage(d.t, Color3.fromRGB(200, 220, 255), 0.3) end
end

H.Death = function(d)
	local pos = d.p
	if pos then
		FX.ball(pos, Color3.fromRGB(255, 255, 255), 1, 5, 0.4, 0.3)
		FX.emit(pos, { tex = "smoke", color = Color3.fromRGB(80, 80, 90), n = 10, speed = 8, life = 1, light = 0, lightInf = 1 })
	end
	SoundFX.play("Death", d.m)
end

---------------------------------------------------------------- анимации
H.Anim = function(d)
	if not d.m then return end
	if isMe(d.m) and Animator.recentlyPlayed(d.m, d.a, 0.3) then return end
	Animator.play(d.m, d.a, d.s)
end
H.AnimStop = function(d)
	if d.m then Animator.stop(d.m) end
end

H.M1 = function(d)
	local list = Poses.M1[d.st or "fists"] or Poses.M1.fists
	local name
	if d.v == "up" then name = list[5] elseif d.v == "down" then name = list[6] else name = list[math.clamp(d.i or 1, 1, 4)] end
	if isMe(d.m) then return end
	Animator.play(d.m, name)
	Effects.swing(d.m, d.st, d.i, d.v)
end

-- след замаха M1
function Effects.swing(model, style, i, variant)
	local root = rootOf(model)
	if not root then return end
	local c1, c2 = colorsOf(model)
	local fin = (i or 1) >= 4 or variant == "up" or variant == "down"
	SoundFX.play(fin and "SwingHeavy" or (style == "sword" and "Slash" or "Swing"), root.Position, style == "sword" and 0.6 or 1)
	if style == "sword" then
		local tilt = (i == 1 and 35) or (i == 2 and 0) or (i == 3 and -60) or 80
		task.delay(0.07, function()
			if not root.Parent then return end
			FX.slash(root.CFrame * CFrame.new(0, 0.4, -1) * CFrame.Angles(0, 0, math.rad(tilt)), c1, fin and 7 or 5.5, fin and 1.3 or 0.9, 0.26, 170, WHITE)
		end)
	elseif style == "palms" then
		task.delay(0.1, function()
			if not root.Parent then return end
			local p = root.Position + root.CFrame.LookVector * 3
			FX.ring(p, c1, 0.5, fin and 5 or 3, 0.22, { cf = CFrame.lookAt(p, p + root.CFrame.LookVector) * CFrame.Angles(math.rad(90), 0, 0), w = 0.3, h = 0.15, n = 18 })
		end)
	elseif style == "claws" then
		task.delay(0.1, function()
			if not root.Parent then return end
			local p = root.Position + root.CFrame.LookVector * 3
			for k = -1, 1 do FX.slashMark(p + root.CFrame.RightVector * k * 0.5, c1, 3.5, 0.2) end
		end)
	elseif style == "flame" then
		task.delay(0.1, function()
			if not root.Parent then return end
			FX.emit(root.Position + root.CFrame.LookVector * 3, { tex = "fire", color = c1, color2 = c2, n = 8, speed = 12, life = 0.3 })
		end)
	elseif style == "zap" then
		task.delay(0.08, function()
			if not root.Parent then return end
			local p = root.Position + root.CFrame.LookVector * 3
			FX.bolt(root.Position + root.CFrame.LookVector, p, c1, 0.15, 0.1, c2)
		end)
	end
end

H.Dash = function(d)
	local m = d.m
	if not m or isMe(m) then return end
	Effects.dashFX(m, d.d)
end

function Effects.dashFX(model, key)
	Animator.play(model, "dash_" .. (key or "F"))
	local root = rootOf(model)
	if not root then return end
	local c1 = colorsOf(model)
	FX.trail(model, Color3.fromRGB(230, 230, 240):Lerp(c1, 0.3), 0.28, nil, 0.8)
	FX.emit(ground(root.Position) + Vector3.new(0, 0.5, 0), { tex = "smoke", color = Color3.fromRGB(200, 196, 190), n = 6, speed = 6, life = 0.5, light = 0, lightInf = 1,
		size = NumberSequence.new(1.2, 2.4), transp = NumberSequence.new(0.5, 1) })
	SoundFX.play("Dash", root.Position)
end

---------------------------------------------------------------- пробуждение и ульты
local auras = {}
local function addAura(model)
	if auras[model] then return end
	local root = rootOf(model)
	local torso = model:FindFirstChild("Torso")
	if not root or not torso then return end
	local c1, c2 = colorsOf(model)
	local att = Instance.new("Attachment")
	att.Parent = torso
	local e = Instance.new("ParticleEmitter")
	e.Texture = FX.TEX.spark
	e.Color = ColorSequence.new(c1, c2)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Rate = 35 * FX.quality
	e.Speed = NumberRange.new(3, 7)
	e.SpreadAngle = Vector2.new(25, 25)
	e.Acceleration = Vector3.new(0, 12, 0)
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Parent = att
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 0.88
	hl.FillColor = c1
	hl.OutlineColor = c2
	hl.OutlineTransparency = 0.25
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = FX.folder
	local light = Instance.new("PointLight")
	light.Color = c1
	light.Range = 12
	light.Brightness = 1.5
	light.Parent = torso
	auras[model] = { att, hl, light }
end
local function removeAura(model)
	local a = auras[model]
	if a then
		for _, x in ipairs(a) do x:Destroy() end
		auras[model] = nil
	end
end
Effects.addAura, Effects.removeAura = addAura, removeAura

H.Awaken = function(d)
	local m = d.m
	local root = rootOf(m)
	if not root then return end
	local c1, c2 = colorsOf(m)
	local pos = root.Position
	FX.ball(pos, WHITE, 1, 8, 0.4, 0)
	FX.ball(pos, c1, 2, 14, 0.8, 0.3)
	FX.ring(ground(pos) + Vector3.new(0, 0.3, 0), c1, 2, 26, 0.8, { w = 1.4, h = 0.5 })
	FX.ring(ground(pos) + Vector3.new(0, 0.3, 0), c2, 1, 18, 0.6, { w = 0.8, h = 0.4 })
	FX.light(pos, c1, 45, 10, 1)
	for _ = 1, 4 do FX.bolt(pos, pos + Vector3.new(Util.rand(-10, 10), Util.rand(4, 14), Util.rand(-10, 10)), c1, 0.3, 0.3, c2) end
	FX.emit(pos, { tex = "spark", color = c1, color2 = c2, n = 40, speed = 30, life = 0.8 })
	SoundFX.play("Awaken", pos)
	addAura(m)
	local near = myChar() and rootOf(myChar()) and (rootOf(myChar()).Position - pos).Magnitude < 80
	if near then CameraFX.shake(0.8) end
	if Effects.ui then Effects.ui.announce(d.name or "ПРОБУЖДЕНИЕ", c1, isMe(m) and "ПРОБУЖДЕНИЕ" or nil) end
	if isMe(m) then CameraFX.cinematic(m, 1.4) end
end

H.AwakenEnd = function(d)
	if d.m then removeAura(d.m) end
end

H.Ult = function(d)
	local m = d.m
	local c1 = d.c or colorsOf(m)
	if Effects.ui then Effects.ui.announce(d.text or "", c1, d.domain and "ТЕРРИТОРИЯ" or "УЛЬТА") end
	local root = rootOf(m)
	if root then
		FX.light(root.Position, c1, 40, 8, 0.8)
		FX.ball(root.Position, c1, 1, 7, 0.5, 0.2)
	end
	if Effects.ui and root and myChar() and rootOf(myChar()) and (rootOf(myChar()).Position - root.Position).Magnitude < 120 then
		Effects.ui.flash(c1, 0.35, 0.25)
	end
	if isMe(m) and d.domain then CameraFX.cinematic(m, 1.1) end
end

H.Swap = function(d)
	local root = rootOf(d.m)
	if root then
		local c1 = colorsOf(d.m)
		FX.ball(root.Position, c1, 1, 5, 0.35, 0.3)
		FX.emit(root.Position, { tex = "smoke", color = c1, n = 10, speed = 8, life = 0.6 })
	end
	removeAura(d.m)
end

---------------------------------------------------------------- общие эффекты приёмов
H.Burst = function(d)
	if not d.p then return end
	local c = d.c or WHITE
	FX.ball(d.p, c, 0.5, d.r or 4, 0.3, 0.2)
	if d.k == "wind" then
		FX.ring(d.p, c, 1, (d.r or 4) * 1.4, 0.35, { w = 0.6, h = 0.3 })
	elseif d.k == "void" then
		FX.ball(d.p, Color3.fromRGB(10, 6, 30), 0.5, (d.r or 4) * 0.6, 0.35, 0.1, Enum.Material.SmoothPlastic)
		FX.emit(d.p, { tex = "spark", color = c, n = 16, speed = (d.r or 4) * 4, life = 0.4 })
	elseif d.k == "shadow" then
		FX.emit(d.p, { tex = "smoke", color = Color3.fromRGB(40, 20, 60), n = 10, speed = 10, life = 0.6, light = 0 })
	elseif d.k == "slash" then
		for _ = 1, 4 do FX.slashMark(d.p + Vector3.new(Util.rand(-3, 3), Util.rand(-1, 3), Util.rand(-3, 3)), c, 6, 0.3) end
	else
		FX.sparks(d.p, c, 8, 35, { size = 0.22 })
	end
	FX.light(d.p, c, (d.r or 4) * 4, 4, 0.25)
end

H.Ring = function(d)
	if d.p then FX.ring(d.p + Vector3.new(0, 0.3, 0), d.c or WHITE, 1, d.r or 8, d.t or 0.35, { w = 0.9, h = 0.4 }) end
end

H.Shock = function(d)
	if not d.p then return end
	local c = d.c or WHITE
	FX.ball(d.p, d.c2 or WHITE, 0.5, (d.r or 8) * 0.35, 0.18, 0)
	FX.ring(d.p, c, 1, d.r or 8, 0.35, { w = 1, h = 0.5 })
	FX.ring(ground(d.p) + Vector3.new(0, 0.2, 0), c, 1, (d.r or 8) * 1.1, 0.45, { w = 0.7, h = 0.3 })
	FX.light(d.p, c, (d.r or 8) * 3, 6, 0.3)
	if d.k == "zap" then
		for _ = 1, 5 do
			local a = Util.rand(0, 6.28)
			FX.bolt(d.p, d.p + Vector3.new(math.cos(a) * (d.r or 8), Util.rand(-1, 2), math.sin(a) * (d.r or 8)), c, 0.25, 0.2, d.c2)
		end
	end
end

H.Vortex = function(d)
	if d.p then FX.vortex(d.p, d.r or 10, d.c or WHITE, d.t or 1.2, d.c2) end
	if d.k == "void" then SoundFX.play("Void", d.p) end
end

H.Beam = function(d)
	if not (d.a and d.b) then return end
	FX.beam(d.a, d.b, d.c or WHITE, d.w or 4, d.t or 0.6, d.c2)
	FX.ball(d.a, d.c2 or WHITE, 1, (d.w or 4) * 1.2, 0.3, 0.1)
	FX.ball(d.b, d.c or WHITE, 1, (d.w or 4) * 1.5, 0.4, 0.2)
	if d.k == "zap" then
		for _ = 1, 3 do FX.bolt(d.a, d.b, d.c2 or WHITE, 0.3, 0.25, d.c) end
	end
	local me = myChar() and rootOf(myChar())
	if me and (me.Position - d.a).Magnitude < 90 then CameraFX.shake(0.6) end
end

H.Bolt = function(d)
	if d.a and d.b then FX.bolt(d.a, d.b, d.c or WHITE, d.w or 0.5, 0.25, d.c2) end
end

H.Strike = function(d)
	if not d.p then return end
	local top = d.p + Vector3.new(Util.rand(-6, 6), d.big and 140 or 90, Util.rand(-6, 6))
	FX.bolt(top, d.p, d.c or WHITE, d.big and 1.6 or 0.9, d.big and 0.4 or 0.25, d.c2)
	FX.bolt(top, d.p, d.c2 or WHITE, d.big and 0.6 or 0.4, d.big and 0.4 or 0.25, d.c)
	FX.ball(d.p, WHITE, 1, d.big and 9 or 5, 0.25, 0)
	FX.ring(d.p + Vector3.new(0, 0.3, 0), d.c or WHITE, 1, d.big and 14 or 7, 0.35, { w = 0.8, h = 0.3 })
	FX.light(d.p, d.c or WHITE, d.big and 70 or 35, 10, 0.3)
	FX.debris(d.p, d.big and 10 or 4, FX.groundColor(d.p), Enum.Material.Slate, 28, 0.6)
end

H.SlashArc = function(d)
	if d.cf then FX.slash(d.cf, d.c or WHITE, d.r or 6, d.w or 1, 0.3, 170, WHITE) end
end

H.SlashMark = function(d)
	if d.p then FX.slashMark(d.p, d.c or WHITE, d.big and 8 or 6, 0.3) end
end

H.Lines = function(d)
	if not (d.a and d.b) then return end
	local dir = d.b - d.a
	if dir.Magnitude < 0.5 then return end
	local right = dir:Cross(Vector3.yAxis)
	right = right.Magnitude > 0.01 and right.Unit or Vector3.xAxis
	for i = -2, 2 do
		local off = right * i * 0.7 + Vector3.new(0, i * 0.35, 0)
		FX.beam(d.a + off, d.b + off, d.c or WHITE, (d.w or 0.6) * (i == 0 and 1.4 or 0.6), 0.3, WHITE)
	end
	FX.slashMark(d.b, d.c or WHITE, 8, 0.3)
end

H.Trail = function(d)
	if d.m then
		local c = d.c or WHITE
		FX.trail(d.m, c, d.t or 0.4, nil, 1)
		if d.k == "zap" then
			local root = rootOf(d.m)
			if root then
				task.spawn(function()
					local t0 = os.clock()
					while os.clock() - t0 < (d.t or 0.4) and root.Parent do
						FX.bolt(root.Position, root.Position - root.CFrame.LookVector * 4 + Vector3.new(Util.rand(-1, 1), Util.rand(-1, 1), 0), c, 0.15, 0.1)
						task.wait(0.05)
					end
				end)
			end
		end
	end
end

-- заряд в руках
H.Charge = function(d)
	local m = d.m
	if not m then return end
	local c = d.c or WHITE
	local hands = {}
	if d.hand == "R" then hands = { m:FindFirstChild("Right Arm") }
	else hands = { m:FindFirstChild("Right Arm"), m:FindFirstChild("Left Arm") } end
	local dur = d.t or 0.4
	for _, arm in ipairs(hands) do
		if arm then
			local ball = FX.part({ Shape = Enum.PartType.Ball, Color = c, Size = Vector3.one * 0.2, Transparency = 0.1 })
			local l = Instance.new("PointLight")
			l.Color = c
			l.Range = 10
			l.Brightness = 3
			l.Parent = ball
			FX.run(dur, function(t)
				if not arm.Parent then return end
				local s = (d.big and 2.6 or 1.4) * (0.3 + 0.7 * t) * (1 + math.sin(t * 40) * 0.08)
				ball.Size = Vector3.one * s
				ball.CFrame = arm.CFrame * CFrame.new(0, -1.2, 0)
			end, function() ball:Destroy() end)
		end
	end
	local root = rootOf(m)
	if root then
		FX.emit(root.Position, { tex = "spark", color = c, n = 18, speed = -14, life = dur, spread = 180 })
		if d.big then SoundFX.play("Charge", root.Position) end
	end
end

H.Cone = function(d)
	if not (d.p and d.d) then return end
	local dir = d.d
	local len, w = d.len or 14, d.w or 10
	for i = 1, 3 do
		local p = d.p + dir * (len * i / 3)
		local cf = CFrame.lookAt(p, p + dir) * CFrame.Angles(math.rad(90), 0, 0)
		task.delay(i * 0.04, function()
			FX.ring(p, i % 2 == 0 and (d.c2 or WHITE) or d.c, w * 0.15 * i, w * 0.3 * i + 2, 0.35, { cf = cf, w = 0.8, h = 0.3, n = 22 })
		end)
	end
	FX.ball(d.p + dir * 3, d.c or WHITE, 1, 6, 0.25, 0.2)
	FX.emit(d.p + dir * 4, { tex = "spark", color = d.c or WHITE, n = 24, speed = 40, life = 0.5, spread = 25 })
end

H.Explosion = function(d)
	if not d.p then return end
	FX.explosion(d.p, d.r or 10, d.c or Color3.fromRGB(255, 140, 40), d.c2)
	if d.k == "void" then
		FX.ball(d.p, Color3.fromRGB(8, 4, 20), (d.r or 10) * 0.2, (d.r or 10) * 0.7, 0.5, 0, Enum.Material.SmoothPlastic)
	elseif d.k == "zap" then
		for _ = 1, 6 do
			local a = Util.rand(0, 6.28)
			FX.bolt(d.p, d.p + Vector3.new(math.cos(a), Util.rand(0, 0.8), math.sin(a)) * (d.r or 10), d.c, 0.3, 0.3, d.c2)
		end
	elseif d.k == "fire" then
		FX.emit(d.p, { tex = "fire", color = d.c, color2 = d.c2, n = 30, speed = (d.r or 10) * 2, life = 0.6,
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, (d.r or 10) * 0.3), NumberSequenceKeypoint.new(1, 0) }) })
	end
	SoundFX.play((d.r or 10) > 18 and "ExplosionBig" or "Explosion", d.p)
	local me = myChar() and rootOf(myChar())
	if me then
		local dist = (me.Position - d.p).Magnitude
		if dist < (d.r or 10) * 6 then CameraFX.shake(math.clamp(1.2 - dist / ((d.r or 10) * 6), 0.2, 1.2)) end
	end
end

H.Crater = function(d)
	if d.p then FX.crater(d.p, d.r or 8, d.c) end
end

H.Impact = function(d)
	if not d.p then return end
	local gc = FX.groundColor(d.p)
	FX.ring(d.p + Vector3.new(0, 0.3, 0), gc:Lerp(WHITE, 0.4), 1, d.r or 6, 0.35, { w = 0.7, h = 0.3, mat = Enum.Material.SmoothPlastic, t0 = 0.3 })
	FX.debris(d.p, 5, gc, Enum.Material.Slate, 22, 0.6)
	FX.emit(d.p + Vector3.new(0, 0.5, 0), { tex = "smoke", color = gc:Lerp(WHITE, 0.5), n = 8, speed = 10, life = 0.6, light = 0, lightInf = 1 })
end

H.Warn = function(d)
	if d.p then FX.warn(d.p, d.r or 6, d.c or Color3.fromRGB(255, 60, 60), d.t or 0.6) end
end

H.Pillar = function(d)
	if not d.p then return end
	FX.pillar(d.p, d.r or 5, d.h or 30, d.c or WHITE, d.t or 0.8, d.c2)
	if d.k == "fire" then
		FX.emit(d.p + Vector3.new(0, 4, 0), { tex = "fire", color = d.c, color2 = d.c2, n = 30, speed = 30, life = 0.7, spread = 20,
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0) }) })
	end
	FX.ring(d.p + Vector3.new(0, 0.3, 0), d.c or WHITE, 1, (d.r or 5) * 1.8, 0.4, { w = 0.8, h = 0.3 })
end

H.Meteor = function(d)
	if not d.p then return end
	local dur = d.t or 1.2
	local from = d.p + Vector3.new(-50, 150, 35)
	local rock = FX.part({ Shape = Enum.PartType.Ball, Color = Color3.fromRGB(70, 40, 30), Material = Enum.Material.CrackedLava, Size = Vector3.one * 9 })
	local glow = FX.part({ Shape = Enum.PartType.Ball, Color = d.c or Color3.fromRGB(255, 120, 30), Size = Vector3.one * 12, Transparency = 0.45 })
	local l = Instance.new("PointLight")
	l.Color = d.c or Color3.fromRGB(255, 120, 30)
	l.Range = 40
	l.Brightness = 5
	l.Parent = glow
	local last = from
	FX.run(dur, function(t)
		local p = from:Lerp(d.p, t * t)
		rock.CFrame = CFrame.new(p) * CFrame.Angles(t * 8, t * 5, 0)
		glow.CFrame = CFrame.new(p)
		if (p - last).Magnitude > 4 then
			FX.ball(p, d.c2 or Color3.fromRGB(255, 200, 80), 3, 7, 0.4, 0.3)
			last = p
		end
	end, function() FX.kill(rock, glow) end)
	SoundFX.play("Fire", d.p, 0.8)
end

H.Sun = function(d)
	local m = d.m
	local root = rootOf(m)
	if not root then return end
	local dur = d.t or 1.6
	local core = FX.part({ Shape = Enum.PartType.Ball, Color = d.c2 or WHITE, Size = Vector3.one })
	local shell = FX.part({ Shape = Enum.PartType.Ball, Color = d.c or Color3.fromRGB(255, 130, 30), Size = Vector3.one, Transparency = 0.35 })
	local l = Instance.new("PointLight")
	l.Color = d.c or Color3.fromRGB(255, 140, 40)
	l.Range = 60
	l.Brightness = 6
	l.Parent = core
	FX.run(dur + 0.4, function(t)
		if not root.Parent then return end
		local k = math.min(1, t * (dur + 0.4) / dur)
		local r = (d.r or 9) * k
		local p = root.Position + Vector3.new(0, 6 + r, 0)
		core.Size = Vector3.one * math.max(0.2, r * 1.3)
		shell.Size = Vector3.one * math.max(0.2, r * 2 * (1 + math.sin(t * 30) * 0.04))
		core.CFrame = CFrame.new(p)
		shell.CFrame = CFrame.new(p)
	end, function() FX.kill(core, shell) end)
	SoundFX.play("Charge", root.Position, 1.2)
end

H.SunFall = function(d)
	if not (d.a and d.b) then return end
	local ball = FX.part({ Shape = Enum.PartType.Ball, Color = d.c or Color3.fromRGB(255, 130, 30), Size = Vector3.one * 18, Transparency = 0.2 })
	local core = FX.part({ Shape = Enum.PartType.Ball, Color = d.c2 or WHITE, Size = Vector3.one * 11 })
	FX.run(d.t or 0.35, function(t)
		local p = d.a:Lerp(d.b, t * t)
		ball.CFrame = CFrame.new(p)
		core.CFrame = CFrame.new(p)
	end, function() FX.kill(ball, core) end)
end

H.Storm = function(d)
	-- тучи: затемнить небо у тех, кто рядом
	local me = myChar() and rootOf(myChar())
	if not me or not d.p or (me.Position - d.p).Magnitude > (d.r or 60) * 1.5 then return end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "StormGrade"
	cc.TintColor = Color3.fromRGB(170, 185, 230)
	cc.Brightness = 0
	cc.Contrast = 0
	cc.Parent = Lighting
	local dur = d.t or 3
	FX.run(dur, function(t)
		local k = math.min(1, t * dur / 0.4) * (1 - math.max(0, (t * dur - (dur - 0.5)) / 0.5))
		cc.Brightness = -0.18 * k
		cc.Contrast = 0.2 * k
	end, function() cc:Destroy() end)
end

H.FireTrail = function(d)
	if not (d.a and d.b) then return end
	local dir = d.b - d.a
	local n = math.clamp(math.floor(dir.Magnitude / 4), 1, 12)
	for i = 0, n do
		local p = d.a:Lerp(d.b, i / n) + Vector3.new(0, 0.4, 0)
		local host = FX.part({ Size = Vector3.new(2, 0.2, 2), CFrame = CFrame.new(p), Transparency = 1 })
		local fire = Instance.new("Fire")
		fire.Color = d.c or Color3.fromRGB(255, 128, 28)
		fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
		fire.Size = 4
		fire.Heat = 9
		fire.Parent = host
		local glow = FX.part({ Shape = Enum.PartType.Cylinder, Color = d.c or Color3.fromRGB(255, 128, 28), Size = Vector3.new(0.12, 3.2, 3.2),
			CFrame = CFrame.new(p - Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.4 })
		task.delay(d.t or 2, function()
			fire.Enabled = false
			FX.run(0.5, function(t) glow.Transparency = 0.4 + 0.6 * t end, function() FX.kill(glow) end)
			task.delay(1.5, function() host:Destroy() end)
		end)
	end
end

H.FireRing = function(d)
	if not d.p then return end
	FX.ring(d.p + Vector3.new(0, 1, 0), d.c, 1, d.r or 20, d.t or 0.55, { w = 2.2, h = 2.4, n = 32, k = 1.6 })
	FX.ring(d.p + Vector3.new(0, 0.4, 0), d.c2 or WHITE, 1, (d.r or 20) * 0.95, d.t or 0.55, { w = 0.8, h = 0.5, n = 32, k = 1.6 })
	FX.light(d.p, d.c, (d.r or 20) * 2.5, 8, 0.6)
	for i = 1, 10 do
		local a = i / 10 * 6.28
		task.delay(0.05 * (i % 4), function()
			FX.emit(d.p + Vector3.new(math.cos(a) * (d.r or 20) * 0.6, 1, math.sin(a) * (d.r or 20) * 0.6),
				{ tex = "fire", color = d.c, color2 = d.c2, n = 6, speed = 14, life = 0.5 })
		end)
	end
end

H.Phoenix = function(d)
	local m = d.m
	local torso = m and m:FindFirstChild("Torso")
	if not torso then return end
	local wings = {}
	for _, s in ipairs({ -1, 1 }) do
		wings[#wings + 1] = { p = FX.part({ Color = d.c or Color3.fromRGB(255, 128, 28), Size = Vector3.new(5, 0.3, 2.2), Transparency = 0.15 }), s = s }
	end
	local body = FX.part({ Shape = Enum.PartType.Ball, Color = d.c2 or Color3.fromRGB(255, 222, 90), Size = Vector3.one * 3.5, Transparency = 0.3 })
	FX.trail(m, d.c or Color3.fromRGB(255, 128, 28), d.t or 0.5, nil, 2)
	FX.run(d.t or 0.5, function(t)
		if not torso.Parent then return end
		local flap = math.sin(t * 40) * 0.5
		for _, w in ipairs(wings) do
			w.p.CFrame = torso.CFrame * CFrame.new(w.s * 2.8, 0.6, 0) * CFrame.Angles(0, 0, w.s * flap)
			w.p.Transparency = 0.15 + 0.85 * t ^ 3
		end
		body.CFrame = torso.CFrame
		body.Transparency = 0.3 + 0.7 * t ^ 2
	end, function()
		for _, w in ipairs(wings) do w.p:Destroy() end
		body:Destroy()
	end)
end

H.ShadowPool = function(d)
	if not d.p then return end
	local r = d.r or 5
	local disc = FX.part({ Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(10, 6, 16), Material = Enum.Material.SmoothPlastic,
		Size = Vector3.new(0.12, 0.2, 0.2), CFrame = CFrame.new(d.p + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	local edge = FX.part({ Shape = Enum.PartType.Cylinder, Color = d.c or Color3.fromRGB(128, 72, 220), Size = Vector3.new(0.08, 0.2, 0.2),
		CFrame = CFrame.new(d.p + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.2 })
	local dur = d.t or 0.8
	FX.run(dur, function(t)
		local k = math.min(1, t * dur / 0.2) * (1 - math.max(0, (t - 0.7) / 0.3))
		local rr = r * 2 * k
		disc.Size = Vector3.new(0.12, math.max(0.05, rr), math.max(0.05, rr))
		edge.Size = Vector3.new(0.08, math.max(0.05, rr + 0.8), math.max(0.05, rr + 0.8))
		if d.warn then edge.Transparency = 0.2 + 0.4 * math.abs(math.sin(t * 20)) end
	end, function() FX.kill(disc, edge) end)
	FX.emit(d.p + Vector3.new(0, 0.5, 0), { tex = "smoke", color = Color3.fromRGB(30, 16, 48), n = 6, speed = 4, life = 0.8, light = 0, accel = Vector3.new(0, 6, 0) })
end

H.ShadowBurst = function(d)
	if not d.p then return end
	for i = 1, 10 do
		local a = i / 10 * 6.28
		local p = d.p + Vector3.new(math.cos(a) * (d.r or 6) * 0.5, 0, math.sin(a) * (d.r or 6) * 0.5)
		local spike = FX.part({ Color = Color3.fromRGB(12, 8, 20), Material = Enum.Material.SmoothPlastic, Size = Vector3.new(0.8, 0.2, 0.8),
			CFrame = CFrame.new(p) * CFrame.Angles(Util.rand(-0.4, 0.4), a, Util.rand(-0.4, 0.4)) })
		FX.run(0.5, function(t)
			local h = 7 * math.sin(math.min(1, t * 3) * math.pi / 2) * (1 - math.max(0, (t - 0.6) / 0.4))
			spike.Size = Vector3.new(0.8, math.max(0.1, h), 0.8)
			spike.CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, a, 0)
		end, function() spike:Destroy() end)
	end
	FX.ball(d.p + Vector3.new(0, 2, 0), d.c or Color3.fromRGB(128, 72, 220), 1, d.r or 6, 0.35, 0.3)
	FX.emit(d.p + Vector3.new(0, 1, 0), { tex = "smoke", color = Color3.fromRGB(40, 20, 60), n = 12, speed = 12, life = 0.7, light = 0 })
end

H.Maw = function(d)
	if not d.p then return end
	local r = d.r or 7
	local teeth = {}
	local n = d.small and 6 or 10
	for i = 1, n do
		local a = i / n * 6.28
		local base = d.p + Vector3.new(math.cos(a) * r * 0.8, 0, math.sin(a) * r * 0.8)
		teeth[#teeth + 1] = { p = FX.part({ Color = Color3.fromRGB(14, 8, 22), Material = Enum.Material.SmoothPlastic, Size = Vector3.new(1.2, 1, 1.2) }), base = base, a = a }
	end
	local glow = FX.part({ Shape = Enum.PartType.Cylinder, Color = d.c or Color3.fromRGB(128, 72, 220), Size = Vector3.new(0.1, r * 1.8, r * 1.8),
		CFrame = CFrame.new(d.p + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.3 })
	local H0 = d.small and 4 or r * 1.4
	FX.run(0.7, function(t)
		local rise = math.sin(math.min(1, t * 3) * math.pi / 2)
		local close = math.clamp((t - 0.25) / 0.2, 0, 1)
		local fall = math.max(0, (t - 0.65) / 0.35)
		for _, x in ipairs(teeth) do
			local h = H0 * rise * (1 - fall)
			local tilt = math.rad(15 + 45 * close)
			x.p.Size = Vector3.new(1.2, math.max(0.1, h), 1.2)
			local toC = (d.p - x.base)
			x.p.CFrame = CFrame.lookAt(x.base, x.base + Vector3.new(toC.X, 0, toC.Z)) * CFrame.Angles(-tilt, 0, 0) * CFrame.new(0, h / 2, 0)
		end
		glow.Transparency = 0.3 + 0.7 * t
	end, function()
		for _, x in ipairs(teeth) do x.p:Destroy() end
		glow:Destroy()
	end)
	FX.light(d.p, d.c or Color3.fromRGB(128, 72, 220), r * 4, 4, 0.5)
end

H.Smoke = function(d)
	if d.p then
		FX.emit(d.p, { tex = "smoke", color = Color3.fromRGB(30, 18, 46), n = 10, speed = 6, life = 0.7, light = 0, lightInf = 1,
			size = NumberSequence.new((d.r or 3) * 0.6, (d.r or 3) * 1.2) })
		FX.ball(d.p, d.c or Color3.fromRGB(128, 72, 220), 0.5, d.r or 3, 0.3, 0.4)
	end
end

H.GiantFist = function(d)
	if not d.cf then return end
	local dur = d.t or 0.6
	local len = d.len or 30
	local fist = FX.part({ Color = d.c2 or Color3.fromRGB(14, 10, 22), Material = Enum.Material.SmoothPlastic, Size = Vector3.new(8, 7, 8), Transparency = 0.1 })
	local knuckles = FX.part({ Color = d.c or Color3.fromRGB(128, 72, 220), Size = Vector3.new(8.2, 2, 2.2), Transparency = 0.2 })
	local arm = FX.part({ Color = d.c2 or Color3.fromRGB(14, 10, 22), Material = Enum.Material.SmoothPlastic, Size = Vector3.new(5, 5, 1), Transparency = 0.2 })
	FX.run(dur, function(t)
		local k = math.min(1, t * dur / 0.3)
		k = 1 - (1 - k) ^ 3
		local back = d.cf * CFrame.new(0, 3, 6)
		local tip = back * CFrame.new(0, 0, -len * k - 4)
		fist.CFrame = tip
		knuckles.CFrame = tip * CFrame.new(0, 1.5, -3.6)
		local mid = back:Lerp(tip, 0.5)
		arm.Size = Vector3.new(5, 5, math.max(1, len * k))
		arm.CFrame = mid
		local fade = math.max(0, (t - 0.6) / 0.4)
		fist.Transparency = 0.1 + 0.9 * fade
		knuckles.Transparency = 0.2 + 0.8 * fade
		arm.Transparency = 0.2 + 0.8 * fade
	end, function() FX.kill(fist, knuckles, arm) end)
	SoundFX.play("Shadow", d.cf.Position, 1.2)
end

H.Chains = function(d)
	local m = d.m
	local root = rootOf(m)
	if not root or not d.a then return end
	local links = {}
	for i = 1, 10 do
		links[i] = FX.part({ Color = (i % 2 == 0) and (d.c or Color3.fromRGB(128, 72, 220)) or Color3.fromRGB(20, 16, 28), Size = Vector3.new(0.4, 0.4, 1.2),
			Material = i % 2 == 0 and Enum.Material.Neon or Enum.Material.Metal })
	end
	local dur = d.t or 2
	FX.run(dur, function(t)
		if not root.Parent then return end
		local a, b = d.a, root.Position
		for i, l in ipairs(links) do
			local p0 = a:Lerp(b, (i - 1) / #links)
			local p1 = a:Lerp(b, i / #links)
			l.Size = Vector3.new(0.4, 0.4, (p1 - p0).Magnitude + 0.2)
			l.CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, 0, i * 0.8)
			l.Transparency = t > 0.85 and (t - 0.85) / 0.15 or 0
		end
	end, function() for _, l in ipairs(links) do l:Destroy() end end)
end

H.Afterimage = function(d)
	if d.m then FX.afterimage(d.m, d.c or WHITE, 0.4) end
end

H.Blink = function(d)
	if not (d.a and d.b) then return end
	FX.beam(d.a, d.b, d.c or WHITE, 0.35, 0.2, WHITE)
	FX.ball(d.a, d.c or WHITE, 0.5, 3, 0.25, 0.2)
	FX.ball(d.b, d.c or WHITE, 0.5, 3.5, 0.3, 0.2)
	SoundFX.play("Teleport", d.b)
end

H.Glint = function(d)
	local m = d.m
	local blade = m and m:FindFirstChild("Weapon") and m.Weapon:FindFirstChild("Blade")
	local p = blade and blade.Position or (rootOf(m) and rootOf(m).Position)
	if p then
		FX.ball(p, d.c or WHITE, 0.2, 1.6, 0.3, 0)
		FX.sparks(p, d.c or WHITE, 5, 12, { size = 0.12, g = 0 })
	end
end

H.Mark = function(d)
	local root = rootOf(d.m)
	if not root then return end
	local dur = d.t or 0.45
	FX.run(dur, function(t)
		if not root.Parent then return end
	end)
	FX.ring(root.Position, d.c or WHITE, 3, 1, dur, { w = 0.35, h = 0.35, n = 16, k = 1 })
	FX.text(root.Position + Vector3.new(0, 3, 0), "!", d.c or WHITE, 0.6, dur)
end

-- окно Резонанса: вспышка на кулаке
H.Cue = function(d)
	local m = d.m
	local arm = m and m:FindFirstChild("Right Arm")
	if not arm then return end
	task.delay(d.d or 0.1, function()
		if not arm.Parent then return end
		local p = (arm.CFrame * CFrame.new(0, -1.2, 0)).Position
		FX.ball(p, d.c or Color3.fromRGB(255, 214, 92), 0.4, 3.5, 0.22, 0)
		FX.light(p, d.c or Color3.fromRGB(255, 214, 92), 18, 6, 0.25)
		if isMe(m) and Effects.ui and Effects.ui.cue then Effects.ui.cue((d.t or 0.3) - (d.d or 0.1)) end
	end)
end

H.Resonance = function(d)
	local p = d.p
	if not p then return end
	FX.ball(p, Color3.fromRGB(8, 0, 0), 1, 7, 0.3, 0, Enum.Material.SmoothPlastic)
	FX.ball(p, d.c or Color3.fromRGB(230, 20, 30), 2, 11, 0.45, 0.25)
	for _ = 1, 8 do
		local dir = Vector3.new(Util.rand(-1, 1), Util.rand(-0.6, 1), Util.rand(-1, 1)).Unit
		FX.bolt(p, p + dir * Util.rand(6, 13), Color3.fromRGB(10, 0, 0), 0.4, 0.3, d.c or Color3.fromRGB(230, 20, 30))
	end
	FX.ring(p, d.c or Color3.fromRGB(230, 20, 30), 1, 14, 0.45, { cf = CFrame.lookAt(p, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(math.rad(90), 0, 0) })
	FX.light(p, Color3.fromRGB(255, 30, 30), 50, 10, 0.5)
	FX.text(p + Vector3.new(0, 4.5, 0), "РЕЗОНАНС!", Color3.fromRGB(255, 60, 60), 1.4, 1.1)
	SoundFX.play("Resonance", p)
	local me = myChar() and rootOf(myChar())
	if me and (me.Position - p).Magnitude < 80 then CameraFX.shake(1) end
	if Effects.ui then Effects.ui.flash(Color3.fromRGB(120, 0, 0), 0.25, 0.35) end
end

H.Text = function(d)
	local p = d.p or (rootOf(d.m) and rootOf(d.m).Position + Vector3.new(0, 4, 0))
	if p then FX.text(p, d.text or "", d.c or WHITE, 1) end
end

H.Shake = function(d)
	local me = myChar() and rootOf(myChar())
	if not me or not d.p then return end
	local dist = (me.Position - d.p).Magnitude
	local r = d.r or 60
	if dist < r then CameraFX.shake((d.m or 1) * (1 - dist / r)) end
end

H.Sound = function(d)
	SoundFX.play(d.n, d.p or d.m)
end

---------------------------------------------------------------- снаряды (картинка у клиента)
local projs = {}
local function makeProj(d)
	local kind = d.k
	local c = d.c or WHITE
	local s = d.s or 2
	local parts = {}
	if kind == "voidorb" then
		parts[1] = FX.part({ Shape = Enum.PartType.Ball, Color = Color3.fromRGB(10, 6, 30), Material = Enum.Material.SmoothPlastic, Size = Vector3.one * s * 1.3 })
		parts[2] = FX.part({ Shape = Enum.PartType.Ball, Color = c, Size = Vector3.one * s * 2.2, Transparency = 0.45 })
	elseif kind == "fireball" then
		parts[1] = FX.part({ Shape = Enum.PartType.Ball, Color = Color3.fromRGB(255, 240, 180), Size = Vector3.one * s * 1.1 })
		parts[2] = FX.part({ Shape = Enum.PartType.Ball, Color = c, Size = Vector3.one * s * 2, Transparency = 0.3 })
	elseif kind == "slash" then
		parts[1] = FX.part({ Color = c, Size = Vector3.new(s, 0.3, 0.7) })
		parts[2] = FX.part({ Color = WHITE, Size = Vector3.new(s * 0.8, 0.12, 0.35) })
		parts[3] = FX.part({ Color = c, Size = Vector3.new(s * 0.7, 0.25, 0.6), Transparency = 0.4 })
		parts[4] = FX.part({ Color = c, Size = Vector3.new(s * 0.7, 0.25, 0.6), Transparency = 0.4 })
	elseif kind == "crows" then
		for i = 1, 9 do
			parts[i] = FX.part({ Color = Color3.fromRGB(14, 10, 20), Material = Enum.Material.SmoothPlastic, Size = Vector3.new(1.4, 0.15, 0.6) })
		end
	else
		parts[1] = FX.part({ Shape = Enum.PartType.Ball, Color = c, Size = Vector3.one * s * 1.5 })
	end
	local l = Instance.new("PointLight")
	l.Color = c
	l.Range = 16
	l.Brightness = 3
	l.Parent = parts[1]
	return parts
end

H.Proj = function(d)
	if not d.id then return end
	local p = { d = d, parts = makeProj(d), t0 = d.t0, offsets = {} }
	if d.k == "crows" then
		for i = 1, #p.parts do p.offsets[i] = Vector3.new(Util.rand(-4, 4), Util.rand(-1.5, 2.5), Util.rand(-3, 3)) end
	end
	projs[d.id] = p
	if d.k == "fireball" then SoundFX.play("Fire", d.p) elseif d.k == "slash" then SoundFX.play("Slash", d.p) end
end

H.ProjEnd = function(d)
	local p = projs[d.id]
	if not p then return end
	projs[d.id] = nil
	for _, x in ipairs(p.parts) do x:Destroy() end
	local c = p.d.c or WHITE
	if d.p then
		if p.d.k == "slash" then
			FX.slashMark(d.p, c, 6, 0.25)
		elseif p.d.k == "crows" then
			FX.emit(d.p, { tex = "smoke", color = Color3.fromRGB(20, 14, 30), n = 8, speed = 10, life = 0.5, light = 0 })
		elseif p.d.k ~= "fireball" and p.d.k ~= "voidorb" then
			FX.ball(d.p, c, 0.5, 3, 0.2, 0.2)
		end
	end
end

RunService.RenderStepped:Connect(function()
	if next(projs) == nil then return end
	local now = Util.now()
	for id, p in pairs(projs) do
		local d = p.d
		local el = now - (p.t0 or now)
		local v = d.v
		local dist = math.min(v.Magnitude * el, d.r or 100)
		local dir = v.Magnitude > 0 and v.Unit or Vector3.zAxis
		local pos = d.p + dir * dist
		local cf = CFrame.lookAt(pos, pos + dir)
		if d.k == "voidorb" or d.k == "fireball" then
			local wob = 1 + math.sin(el * 30) * 0.08
			p.parts[1].CFrame = cf
			p.parts[2].CFrame = cf
			p.parts[2].Size = Vector3.one * (d.s or 2) * 2 * wob
			if d.k == "fireball" and math.random() < 0.5 then
				FX.ball(pos - dir * 1.5, d.c or WHITE, (d.s or 2) * 0.6, (d.s or 2) * 1.2, 0.25, 0.3)
			end
		elseif d.k == "slash" then
			local s = d.s or 6
			p.parts[1].CFrame = cf
			p.parts[2].CFrame = cf * CFrame.new(0, 0, -0.1)
			p.parts[3].CFrame = cf * CFrame.new(-s * 0.5, 0, 0.5) * CFrame.Angles(0, math.rad(-25), 0)
			p.parts[4].CFrame = cf * CFrame.new(s * 0.5, 0, 0.5) * CFrame.Angles(0, math.rad(25), 0)
		elseif d.k == "crows" then
			for i, part in ipairs(p.parts) do
				local o = p.offsets[i]
				local flap = math.sin(el * 25 + i) * 0.6
				part.CFrame = cf * CFrame.new(o + Vector3.new(0, math.sin(el * 6 + i) * 0.5, 0)) * CFrame.Angles(0, 0, flap)
			end
		else
			p.parts[1].CFrame = cf
		end
		if el > 6 then
			for _, x in ipairs(p.parts) do x:Destroy() end
			projs[id] = nil
		end
	end
end)

---------------------------------------------------------------- территории
local domains = {}
local grade
local function setGrade(style, on)
	if on then
		if not grade then
			grade = Instance.new("ColorCorrectionEffect")
			grade.Name = "DomainGrade"
			grade.Parent = Lighting
		end
		local tint = { void = Color3.fromRGB(170, 160, 255), blade = Color3.fromRGB(255, 150, 160), abyss = Color3.fromRGB(170, 140, 220) }
		grade.TintColor = tint[style] or WHITE
		grade.Contrast = 0.25
		grade.Saturation = -0.2
		grade.Brightness = -0.08
		grade.Enabled = true
	elseif grade then
		grade.Enabled = false
	end
end

H.Domain = function(d)
	local model, cols = FX.dome(d.c, d.r or 42, d.style, (d.dur or 9) + 0.2)
	local dom = { id = d.id, c = d.c, r = d.r or 42, style = d.style, model = model, cols = cols, t0 = os.clock(), dur = d.dur or 9 }
	domains[d.id] = dom
	FX.ring(d.c + Vector3.new(0, 0.5, 0), cols[2], 2, dom.r, 0.7, { w = 2, h = 1 })
	FX.light(d.c + Vector3.new(0, 10, 0), cols[2], dom.r * 2, 8, 1)
	SoundFX.play("Domain", d.c)
	CameraFX.shake(0.7)
	-- внутреннее убранство
	task.spawn(function()
		while domains[d.id] and os.clock() - dom.t0 < dom.dur do
			if dom.style == "void" then
				for _ = 1, 3 do
					local a = Util.rand(0, 6.28)
					local rr = Util.rand(0, dom.r * 0.9)
					FX.ball(d.c + Vector3.new(math.cos(a) * rr, Util.rand(2, dom.r * 0.7), math.sin(a) * rr), Util.pick({ cols[2], cols[3], WHITE }), 0.2, 0.6, 1.2, 0.1)
				end
			elseif dom.style == "blade" then
				local a = Util.rand(0, 6.28)
				local rr = Util.rand(0, dom.r * 0.9)
				FX.slashMark(d.c + Vector3.new(math.cos(a) * rr, Util.rand(2, 12), math.sin(a) * rr), cols[2], Util.rand(5, 10), 0.35)
			elseif dom.style == "abyss" then
				local a = Util.rand(0, 6.28)
				local rr = Util.rand(0, dom.r * 0.9)
				FX.emit(d.c + Vector3.new(math.cos(a) * rr, 0.5, math.sin(a) * rr), { tex = "smoke", color = Color3.fromRGB(20, 10, 34), n = 3, speed = 3, life = 1.2, light = 0,
					accel = Vector3.new(0, 3, 0) })
			end
			task.wait(0.12)
		end
	end)
end

H.DomainEnd = function(d)
	local dom = domains[d.id]
	if not dom then return end
	domains[d.id] = nil
	if dom.model and dom.model.Parent then
		-- быстро растворить
		for _, x in ipairs(dom.model:GetDescendants()) do
			if x:IsA("BasePart") then
				local t0 = x.Transparency
				FX.run(0.4, function(t) x.Transparency = t0 + (1 - t0) * t end)
			end
		end
		task.delay(0.45, function() if dom.model then dom.model:Destroy() end end)
	end
	if d.reason == "clash" then FX.explosion(dom.c + Vector3.new(0, 6, 0), 16, dom.cols[2], WHITE) end
end

H.DomainClash = function(d)
	if d.p then
		FX.explosion(d.p + Vector3.new(0, 5, 0), 20, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 200, 120))
		FX.text(d.p + Vector3.new(0, 10, 0), "СТОЛКНОВЕНИЕ ТЕРРИТОРИЙ", Color3.fromRGB(255, 240, 200), 1.6, 1.6)
	end
end

-- внутри территории: подкрасить картинку
RunService.Heartbeat:Connect(function()
	local me = myChar() and rootOf(myChar())
	local inside
	if me then
		for _, dom in pairs(domains) do
			local p = me.Position
			if (Vector3.new(p.X, 0, p.Z) - Vector3.new(dom.c.X, 0, dom.c.Z)).Magnitude <= dom.r then inside = dom end
		end
	end
	setGrade(inside and inside.style, inside ~= nil)
end)

---------------------------------------------------------------- карта
H.Break = function(d)
	for _, m in ipairs(d.list or {}) do
		local parts = {}
		if m:IsA("BasePart") then parts = { m } else
			for _, x in ipairs(m:GetDescendants()) do if x:IsA("BasePart") then parts[#parts + 1] = x end end
		end
		for i, p in ipairs(parts) do
			if i > 6 then break end
			local n = math.clamp(math.floor(p.Size.Magnitude / 2), 2, 6)
			FX.debris(p.Position, n, p.Color, p.Material, 30 * (d.f or 1), math.clamp(p.Size.Magnitude / 6, 0.4, 1.4))
		end
	end
	if d.p then SoundFX.play("Explosion", d.p, 0.6) end
end

H.Restore = function(d) end
H.Kill = function(d) if Effects.ui then Effects.ui.killfeed(d) end end
H.Streak = function(d) if Effects.ui then Effects.ui.announce(string.format("%s — серия %d!", d.name or "?", d.n or 0), d.c, "СЕРИЯ") end end
H.BotsConfig = function(d) if Effects.ui and Effects.ui.botsConfig then Effects.ui.botsConfig(d) end end

function Effects.handle(name, data)
	local h = H[name]
	if h then
		local ok, err = pcall(h, data or {})
		if not ok then warn("[Effects] " .. tostring(name) .. ": " .. tostring(err)) end
	end
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">FX</string><ProtectedString name="Source"><![CDATA[-- Визуальные эффекты на клиенте: из неоновых деталей, частиц, следов и света.
-- Всё живёт в workspace.LocalFX и обновляется одним циклом (FX.run).
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local FX = {}

local folder = Instance.new("Folder")
folder.Name = "LocalFX"
folder.Parent = workspace
FX.folder = folder

FX.quality = 1 -- 0.5 на слабых устройствах (меньше частиц)

local TEX = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
}
FX.TEX = TEX

local WHITE = Color3.new(1, 1, 1)
local rand = Util.rand

---------------------------------------------------------------- цикл обновления
local active = {}
function FX.run(dur, update, done)
	local e = { t0 = os.clock(), dur = math.max(dur, 1e-3), update = update, done = done }
	active[#active + 1] = e
	return e
end
function FX.stop(e)
	if e then e.dur = 0 end
end

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	for i = #active, 1, -1 do
		local e = active[i]
		local a = (now - e.t0) / e.dur
		if a >= 1 then
			table.remove(active, i)
			pcall(e.update, 1, dt)
			if e.done then pcall(e.done) end
		else
			local ok, err = pcall(e.update, a, dt)
			if not ok then
				table.remove(active, i)
				warn("[FX] " .. tostring(err))
				if e.done then pcall(e.done) end
			end
		end
	end
end)

---------------------------------------------------------------- детали
function FX.part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then p[k] = v end
	end
	p.Parent = props.Parent or folder
	return p
end

local function kill(...)
	for i = 1, select("#", ...) do
		local x = select(i, ...)
		if x then x:Destroy() end
	end
end
FX.kill = kill

local function easeOut(a, k) return 1 - (1 - a) ^ (k or 3) end

-- шар: растёт и тает
function FX.ball(pos, color, r0, r1, dur, t0, mat)
	t0 = t0 or 0.1
	local p = FX.part({ Shape = Enum.PartType.Ball, Color = color, Size = Vector3.one * r0 * 2, CFrame = CFrame.new(pos), Transparency = t0,
		Material = mat or Enum.Material.Neon })
	FX.run(dur, function(a)
		local r = r0 + (r1 - r0) * easeOut(a, 3)
		p.Size = Vector3.one * math.max(0.05, r * 2)
		p.Transparency = t0 + (1 - t0) * a ^ 0.9
	end, function() p:Destroy() end)
	return p
end

-- свет-вспышка
function FX.light(pos, color, range, brightness, dur)
	local p = FX.part({ Size = Vector3.one * 0.2, CFrame = CFrame.new(pos), Transparency = 1 })
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = p
	FX.run(dur, function(a) l.Brightness = brightness * (1 - a) ^ 2 end, function() p:Destroy() end)
end

-- кольцо (ударная волна) из сегментов: cf задаёт центр и плоскость (по умолчанию горизонт)
function FX.ring(pos, color, r0, r1, dur, opts)
	opts = opts or {}
	local n = opts.n or 28
	local w, h = opts.w or 0.7, opts.h or 0.35
	local cf = opts.cf or CFrame.new(pos)
	local segs = {}
	local t0 = opts.t0 or 0.05
	for i = 1, n do
		segs[i] = FX.part({ Color = color, Size = Vector3.new(w, h, 1), Transparency = t0, Material = opts.mat or Enum.Material.Neon })
	end
	FX.run(dur, function(a)
		local e = easeOut(a, opts.k or 2.5)
		local r = r0 + (r1 - r0) * e
		local seg = 2 * math.pi * math.max(r, 0.1) / n * 1.12
		local tr = t0 + (1 - t0) * a ^ 1.6
		local ww = w * (1 - a * 0.6)
		for i, s in ipairs(segs) do
			local ang = i / n * 2 * math.pi
			s.Size = Vector3.new(ww, h, seg)
			s.CFrame = cf * CFrame.Angles(0, ang, 0) * CFrame.new(r, 0, 0)
			s.Transparency = tr
		end
	end, function() for _, s in ipairs(segs) do s:Destroy() end end)
end

-- искры: летят из точки и падают
function FX.sparks(pos, color, n, speed, opts)
	opts = opts or {}
	n = math.max(1, math.floor(n * FX.quality + 0.5))
	local g = opts.g or 60
	local size = opts.size or 0.22
	for _ = 1, n do
		local dir
		if opts.dir then
			local sp = opts.spread or 0.6
			dir = (opts.dir + Vector3.new(rand(-sp, sp), rand(-sp, sp) + 0.2, rand(-sp, sp))).Unit
		else
			dir = Vector3.new(rand(-1, 1), rand(-0.2, 1), rand(-1, 1))
			if dir.Magnitude < 0.05 then dir = Vector3.yAxis end
			dir = dir.Unit
		end
		local v = dir * speed * rand(0.45, 1)
		local p = FX.part({ Color = opts.c2 and (math.random() < 0.5 and color or opts.c2) or color, Size = Vector3.one * size, CFrame = CFrame.new(pos) })
		local cur = pos
		local life = rand(opts.life or 0.25, (opts.life or 0.25) * 2)
		FX.run(life, function(a, dt)
			v = v + Vector3.new(0, -g, 0) * dt
			v = v * (1 - math.min(0.9, (opts.drag or 2) * dt))
			cur = cur + v * dt
			local L = math.clamp(v.Magnitude * 0.03, 1, 6)
			p.Size = Vector3.new(size, size, size * L) * (1 - a * 0.7)
			if v.Magnitude > 0.1 then p.CFrame = CFrame.lookAt(cur, cur + v) else p.CFrame = CFrame.new(cur) end
			p.Transparency = a ^ 1.5
		end, function() p:Destroy() end)
	end
end

-- частицы с текстурой (дым, огонь, блёстки)
local emitterHost
local function host()
	if emitterHost and emitterHost.Parent then return emitterHost end
	emitterHost = FX.part({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = CFrame.new(0, -5000, 0), Name = "EmitterHost" })
	return emitterHost
end
function FX.emit(pos, opts)
	local att = Instance.new("Attachment")
	att.WorldPosition = pos
	att.Parent = host()
	att.WorldPosition = pos
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX[opts.tex or "spark"] or opts.tex
	e.Color = ColorSequence.new(opts.color or WHITE, opts.color2 or opts.color or WHITE)
	e.LightEmission = opts.light or 0.8
	e.LightInfluence = opts.lightInf or 0
	e.Size = opts.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = opts.transp or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(opts.life or 0.4, (opts.life or 0.4) * 1.6)
	local sp = opts.speed or 12
	e.Speed = NumberRange.new(math.min(sp, sp * 1.8), math.max(sp, sp * 1.8))
	e.SpreadAngle = Vector2.new(opts.spread or 180, opts.spread or 180)
	e.Drag = opts.drag or 3
	e.Acceleration = opts.accel or Vector3.zero
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Rotation = NumberRange.new(0, 360)
	e.Rate = 0
	e.EmissionDirection = Enum.NormalId.Top
	e.Shape = Enum.ParticleEmitterShape.Sphere
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Parent = att
	e:Emit(math.max(1, math.floor((opts.n or 12) * FX.quality + 0.5)))
	task.delay((opts.life or 0.4) * 1.8 + 0.1, function() att:Destroy() end)
	return e
end

-- луч-цилиндр от a к b (ядро + оболочка)
function FX.beam(a, b, color, width, dur, color2)
	local d = b - a
	local len = d.Magnitude
	if len < 0.1 then return end
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	local outer = FX.part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(len, width, width), CFrame = cf, Transparency = 0.25 })
	local core = FX.part({ Shape = Enum.PartType.Cylinder, Color = color2 or WHITE, Size = Vector3.new(len, width * 0.45, width * 0.45), CFrame = cf, Transparency = 0 })
	FX.light(a + d * 0.15, color, 30, 6, dur)
	FX.run(dur, function(t)
		local grow = math.min(1, t * 8)
		local shrink = 1 - math.max(0, (t - 0.55) / 0.45)
		local k = grow * shrink
		local wob = 1 + math.sin(t * 60) * 0.06
		outer.Size = Vector3.new(len, width * k * wob, width * k * wob)
		core.Size = Vector3.new(len, width * 0.45 * k, width * 0.45 * k)
		outer.Transparency = 0.25 + 0.75 * (1 - shrink)
	end, function() kill(outer, core) end)
end

-- молния: ломаная линия
function FX.bolt(a, b, color, width, dur, color2)
	width = width or 0.4
	dur = dur or 0.22
	local d = b - a
	local len = d.Magnitude
	if len < 0.1 then return end
	local n = math.clamp(math.floor(len / 3.5), 3, 18)
	local pts = { a }
	local right = d:Cross(Vector3.yAxis)
	if right.Magnitude < 0.01 then right = Vector3.xAxis end
	right = right.Unit
	local up = right:Cross(d).Unit
	for i = 1, n - 1 do
		local t = i / n
		local amp = math.sin(t * math.pi) * math.min(3.5, len * 0.12)
		pts[#pts + 1] = a + d * t + right * rand(-amp, amp) + up * rand(-amp, amp)
	end
	pts[#pts + 1] = b
	local segs = {}
	for i = 1, #pts - 1 do
		local p0, p1 = pts[i], pts[i + 1]
		local L = (p1 - p0).Magnitude
		segs[#segs + 1] = FX.part({ Color = (i % 2 == 0 and color2) or color, Size = Vector3.new(width, width, L + width * 0.5),
			CFrame = CFrame.lookAt((p0 + p1) / 2, p1) })
	end
	FX.light((a + b) / 2, color, math.min(60, len), 5, dur)
	FX.run(dur, function(t)
		local flick = (math.floor(t * 30) % 2 == 0) and 0 or 0.5
		for _, s in ipairs(segs) do s.Transparency = math.clamp(t ^ 2 + flick * 0.5, 0, 1) end
	end, function() for _, s in ipairs(segs) do s:Destroy() end end)
end

-- дуга-разрез: cf — центр и плоскость (дуга в плоскости XZ этой системы), r — радиус
function FX.slash(cf, color, r, width, dur, span, color2)
	span = math.rad(span or 170)
	width = width or 1
	dur = dur or 0.28
	local n = 16
	local segs = {}
	for i = 1, n do
		segs[i] = FX.part({ Color = (color2 and i % 3 == 0) and color2 or color, Size = Vector3.new(0.1, 0.12, 1), Transparency = 1 })
	end
	local sweep = 0.35
	FX.run(dur, function(t)
		local shown = math.min(1, t / sweep)
		local fade = math.max(0, (t - sweep) / (1 - sweep))
		for i, s in ipairs(segs) do
			local f = (i - 0.5) / n
			if f <= shown then
				local ang = -span / 2 + span * f
				local thick = width * math.sin(f * math.pi) * (1 - fade * 0.5)
				local seg = 2 * r * math.sin(span / n / 2) * 1.15
				s.Size = Vector3.new(math.max(0.05, thick), 0.12, seg)
				s.CFrame = cf * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)
				s.Transparency = 0.05 + 0.95 * fade
			else
				s.Transparency = 1
			end
		end
	end, function() for _, s in ipairs(segs) do s:Destroy() end end)
end

-- крест-разрез (отметина)
function FX.slashMark(pos, color, size, dur)
	size = size or 6
	local cf = CFrame.new(pos) * CFrame.Angles(rand(0, 6.28), rand(0, 6.28), rand(0, 6.28))
	local a = FX.part({ Color = color, Size = Vector3.new(0.12, 0.12, size), CFrame = cf })
	local w = FX.part({ Color = WHITE, Size = Vector3.new(0.05, 0.05, size * 0.9), CFrame = cf })
	FX.run(dur or 0.25, function(t)
		local k = math.sin(math.min(1, t * 2) * math.pi / 2)
		a.Size = Vector3.new(0.18 * (1 - t), 0.18 * (1 - t), size * k)
		w.Size = Vector3.new(0.06, 0.06, size * 0.9 * k)
		a.Transparency = t ^ 2
		w.Transparency = t
	end, function() kill(a, w) end)
end

-- следы на руках и ногах
local LIMBS = { "Right Arm", "Left Arm", "Right Leg", "Left Leg" }
function FX.trail(model, color, dur, limbs, width)
	local trails = {}
	for _, name in ipairs(limbs or LIMBS) do
		local part = model:FindFirstChild(name)
		if part then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 0.6, 0)
			a0.Parent = part
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -1, 0)
			a1.Parent = part
			local tr = Instance.new("Trail")
			tr.Attachment0 = a0
			tr.Attachment1 = a1
			tr.Color = ColorSequence.new(color)
			tr.LightEmission = 1
			tr.Lifetime = 0.18
			tr.FaceCamera = true
			tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
			tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, width or 1), NumberSequenceKeypoint.new(1, 0) })
			tr.Parent = part
			trails[#trails + 1] = { tr, a0, a1 }
		end
	end
	task.delay(dur, function()
		for _, x in ipairs(trails) do x[1].Enabled = false end
		task.delay(0.3, function()
			for _, x in ipairs(trails) do kill(x[1], x[2], x[3]) end
		end)
	end)
end

-- призрачная копия тела (рывки, телепорты)
local BODY = { "Head", "Torso", "Right Arm", "Left Arm", "Right Leg", "Left Leg" }
function FX.afterimage(model, color, dur)
	dur = dur or 0.4
	local ghosts = {}
	for _, name in ipairs(BODY) do
		local p = model:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local g = FX.part({ Color = color, Size = name == "Head" and Vector3.new(1.2, 1.2, 1.2) or p.Size, CFrame = p.CFrame, Transparency = 0.35,
				Shape = name == "Head" and Enum.PartType.Ball or Enum.PartType.Block })
			ghosts[#ghosts + 1] = g
		end
	end
	FX.run(dur, function(t)
		for _, g in ipairs(ghosts) do g.Transparency = 0.35 + 0.65 * t end
	end, function() for _, g in ipairs(ghosts) do g:Destroy() end end)
end

-- кратер: камни по кругу, тёмное пятно, пыль
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
local function groundColor(pos)
	local map = workspace:FindFirstChild("Map")
	if not map then return Color3.fromRGB(110, 110, 110), Enum.Material.Slate end
	groundParams.FilterDescendantsInstances = { map }
	local r = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -10, 0), groundParams)
	if r and r.Instance then return r.Instance.Color, r.Material end
	return Color3.fromRGB(110, 110, 110), Enum.Material.Slate
end
FX.groundColor = groundColor

function FX.crater(pos, r, color, life)
	life = life or 5
	local gc, gm = groundColor(pos)
	if gm == Enum.Material.Grass or gm == Enum.Material.LeafyGrass then gm = Enum.Material.Ground end
	local rocks = {}
	local n = math.clamp(math.floor(r * 1.4), 8, 22)
	for i = 1, n do
		local ang = i / n * math.pi * 2 + rand(-0.15, 0.15)
		local dist = r * rand(0.75, 1.0)
		local s = r * rand(0.16, 0.3)
		local p = FX.part({ Color = gc:Lerp(Color3.new(0.25, 0.22, 0.2), rand(0.1, 0.4)), Material = gm, Size = Vector3.new(s * 1.3, s, s),
			CFrame = CFrame.new(pos + Vector3.new(math.cos(ang) * dist, -s * 0.9, math.sin(ang) * dist))
				* CFrame.Angles(0, -ang, 0) * CFrame.Angles(0, 0, math.rad(rand(25, 55))),
			Transparency = 0, CastShadow = true })
		rocks[#rocks + 1] = { p = p, up = s * 0.9 }
	end
	local scorch = FX.part({ Shape = Enum.PartType.Cylinder, Color = Color3.new(0.06, 0.05, 0.05), Material = Enum.Material.Slate,
		Size = Vector3.new(0.15, r * 1.6, r * 1.6), CFrame = CFrame.new(pos + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.2 })
	local glow = color and FX.part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(0.12, r * 0.9, r * 0.9),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.2 })
	FX.run(0.18, function(t)
		for _, x in ipairs(rocks) do
			x.p.CFrame = x.p.CFrame + Vector3.new(0, x.up * (1 / 0.18) * (1 / 60), 0)
		end
	end)
	FX.emit(pos + Vector3.new(0, 1, 0), { tex = "smoke", color = gc:Lerp(Color3.new(0.8, 0.78, 0.74), 0.5), n = math.floor(10 + r), speed = r * 1.6,
		life = 0.9, size = NumberSequence.new({ NumberSequenceKeypoint.new(0, r * 0.25), NumberSequenceKeypoint.new(1, r * 0.6) }),
		transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }), light = 0, lightInf = 1, drag = 4,
		accel = Vector3.new(0, 4, 0) })
	FX.debris(pos, math.floor(6 + r * 0.6), gc, gm, r * 1.6)
	task.delay(life, function()
		FX.run(1, function(t)
			for _, x in ipairs(rocks) do x.p.Transparency = t end
			scorch.Transparency = 0.2 + 0.8 * t
			if glow then glow.Transparency = 0.2 + 0.8 * t end
		end, function()
			for _, x in ipairs(rocks) do x.p:Destroy() end
			kill(scorch, glow)
		end)
	end)
	if glow then
		FX.run(1.2, function(t) glow.Transparency = 0.2 + 0.8 * t end)
	end
end

-- обломки: летят с силой и катятся по земле
function FX.debris(pos, n, color, material, speed, sizeMul)
	n = math.max(1, math.floor(n * FX.quality + 0.5))
	for _ = 1, n do
		local s = rand(0.35, 1.1) * (sizeMul or 1)
		local p = FX.part({ Color = color, Material = material or Enum.Material.Slate, Size = Vector3.new(s, s * rand(0.6, 1), s * rand(0.6, 1)),
			CFrame = CFrame.new(pos + Vector3.new(rand(-1, 1), rand(0.5, 1.5), rand(-1, 1))), CastShadow = true })
		local v = Vector3.new(rand(-1, 1), rand(0.6, 1.4), rand(-1, 1)).Unit * (speed or 30) * rand(0.5, 1)
		local spin = Vector3.new(rand(-8, 8), rand(-8, 8), rand(-8, 8))
		local cur = p.CFrame
		local floorY = pos.Y
		FX.run(rand(1.4, 2.2), function(t, dt)
			v = v + Vector3.new(0, -110, 0) * dt
			local np = cur.Position + v * dt
			if np.Y < floorY + s / 2 then
				np = Vector3.new(np.X, floorY + s / 2, np.Z)
				v = Vector3.new(v.X * 0.6, -v.Y * 0.3, v.Z * 0.6)
				spin = spin * 0.6
			end
			cur = CFrame.new(np) * (cur - cur.Position) * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt)
			p.CFrame = cur
			if t > 0.7 then p.Transparency = (t - 0.7) / 0.3 end
		end, function() p:Destroy() end)
	end
end

-- круг-предупреждение на земле
function FX.warn(pos, r, color, dur)
	local disc = FX.part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(0.1, r * 2, r * 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.75 })
	local edge = FX.part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(0.14, r * 2, r * 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.9 })
	FX.run(dur, function(t)
		disc.Transparency = 0.82 - 0.12 * math.abs(math.sin(t * dur * 12))
		local k = math.max(0.05, t)
		edge.Size = Vector3.new(0.14, r * 2 * k, r * 2 * k)
		edge.Transparency = 0.45
	end, function() kill(disc, edge) end)
end

-- столб (огонь, тень)
function FX.pillar(pos, r, h, color, dur, color2)
	local outer = FX.part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(0.1, r * 2, r * 2),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0.2 })
	local core = FX.part({ Shape = Enum.PartType.Cylinder, Color = color2 or WHITE, Size = Vector3.new(0.1, r, r),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 0 })
	FX.light(pos + Vector3.new(0, 4, 0), color, r * 6, 6, dur)
	FX.run(dur, function(t)
		local grow = easeOut(math.min(1, t * 4), 3)
		local hh = h * grow
		local w = 1 - math.max(0, (t - 0.5) / 0.5)
		outer.Size = Vector3.new(hh, r * 2 * w, r * 2 * w)
		outer.CFrame = CFrame.new(pos + Vector3.new(0, hh / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
		core.Size = Vector3.new(hh, r * w, r * w)
		core.CFrame = outer.CFrame
		outer.Transparency = 0.2 + 0.8 * (1 - w)
		core.Transparency = 1 - w
	end, function() kill(outer, core) end)
end

-- текст над точкой
function FX.text(pos, text, color, size, dur)
	local p = FX.part({ Size = Vector3.one * 0.1, Transparency = 1, CFrame = CFrame.new(pos) })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(300, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 250
	bb.Parent = p
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Text = text
	l.TextColor3 = color or WHITE
	l.TextStrokeTransparency = 0.2
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
	l.TextScaled = true
	l.Parent = bb
	dur = dur or 0.9
	FX.run(dur, function(t)
		local pop = t < 0.15 and (0.6 + t / 0.15 * 0.5) or (1.1 - math.min(0.1, (t - 0.15)))
		bb.Size = UDim2.fromOffset(300 * (size or 1) * pop, 60 * (size or 1) * pop)
		bb.StudsOffsetWorldSpace = Vector3.new(0, t * 2.5, 0)
		l.TextTransparency = math.max(0, (t - 0.6) / 0.4)
		l.TextStrokeTransparency = 0.2 + 0.8 * math.max(0, (t - 0.6) / 0.4)
	end, function() p:Destroy() end)
end

-- вспышка экрана
function FX.screenFlash(gui, color, dur, alpha)
	if not gui then return end
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 1 - (alpha or 0.5)
	f.BorderSizePixel = 0
	f.ZIndex = 50
	f.Parent = gui
	FX.run(dur, function(t) f.BackgroundTransparency = 1 - (alpha or 0.5) * (1 - t) end, function() f:Destroy() end)
end

---------------------------------------------------------------- составные эффекты
-- удар в точку: вспышка + искры (+ кольцо, если тяжёлый)
function FX.impact(pos, color, heavy, color2)
	FX.ball(pos, color2 or WHITE, 0.4, heavy and 3.2 or 1.8, heavy and 0.22 or 0.15, 0.05)
	FX.ball(pos, color, 0.6, heavy and 4.5 or 2.6, heavy and 0.3 or 0.2, 0.35)
	FX.sparks(pos, color, heavy and 14 or 8, heavy and 55 or 38, { c2 = color2 or WHITE, size = heavy and 0.28 or 0.2, life = 0.18 })
	FX.light(pos, color, heavy and 22 or 12, heavy and 5 or 3, 0.2)
	if heavy then
		FX.ring(pos, color, 1, 7, 0.35, { cf = CFrame.lookAt(pos, workspace.CurrentCamera.CFrame.Position) * CFrame.Angles(math.rad(90), 0, 0), w = 0.5, h = 0.2, n = 22 })
	end
end

-- взрыв
function FX.explosion(pos, r, color, color2)
	FX.ball(pos, Color3.new(1, 1, 0.95), r * 0.15, r * 0.6, 0.18, 0)
	FX.ball(pos, color2 or color, r * 0.3, r * 0.95, 0.4, 0.15)
	FX.ball(pos, color, r * 0.4, r * 1.15, 0.6, 0.45)
	FX.ring(pos - Vector3.new(0, 2.5, 0), color, r * 0.3, r * 1.3, 0.5, { w = 1.2, h = 0.4 })
	FX.light(pos, color, r * 4, 8, 0.6)
	FX.sparks(pos, color2 or color, 18, r * 4, { size = 0.35, life = 0.35, g = 40, c2 = color })
	FX.emit(pos, { tex = "smoke", color = Color3.fromRGB(60, 55, 52), color2 = Color3.fromRGB(30, 28, 28), n = math.floor(8 + r * 0.6), speed = r * 1.2,
		life = 1.1, size = NumberSequence.new({ NumberSequenceKeypoint.new(0, r * 0.3), NumberSequenceKeypoint.new(1, r * 0.7) }),
		transp = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }), light = 0, lightInf = 1, drag = 3,
		accel = Vector3.new(0, 6, 0) })
end

-- водоворот (притяжение, колодец)
function FX.vortex(pos, r, color, dur, color2)
	local arms = {}
	local nArms, nSeg = 4, 9
	for i = 1, nArms do
		for j = 1, nSeg do
			arms[#arms + 1] = { p = FX.part({ Color = (j % 2 == 0 and color2) or color, Size = Vector3.new(0.4, 0.4, 1.6), Transparency = 0.2 }), i = i, j = j }
		end
	end
	local core = FX.part({ Shape = Enum.PartType.Ball, Color = Color3.new(0.02, 0.02, 0.05), Size = Vector3.one * 2, CFrame = CFrame.new(pos),
		Material = Enum.Material.SmoothPlastic })
	local halo = FX.part({ Shape = Enum.PartType.Ball, Color = color, Size = Vector3.one * 3, CFrame = CFrame.new(pos), Transparency = 0.5 })
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = r * 1.6
	l.Brightness = 4
	l.Parent = halo
	FX.run(dur, function(t)
		local spin = t * dur * 7
		local appear = math.min(1, t * 6)
		local vanish = 1 - math.max(0, (t - 0.85) / 0.15)
		for _, a in ipairs(arms) do
			local f = a.j / nSeg
			local ang = spin + a.i / nArms * math.pi * 2 + f * 2.4
			local rad = r * f * appear * vanish
			local p0 = pos + Vector3.new(math.cos(ang) * rad, math.sin(spin * 0.5 + f * 3) * 0.6, math.sin(ang) * rad)
			local tangent = Vector3.new(-math.sin(ang), 0, math.cos(ang))
			a.p.CFrame = CFrame.lookAt(p0, p0 + tangent)
			a.p.Size = Vector3.new(0.45, 0.45, 1.2 + f * 2.5)
			a.p.Transparency = 0.15 + 0.6 * (1 - f) + 0.25 * (1 - vanish)
		end
		local s = (2 + math.sin(t * dur * 20) * 0.3) * appear * vanish
		core.Size = Vector3.one * math.max(0.1, s)
		halo.Size = Vector3.one * math.max(0.1, s * 1.8)
	end, function()
		for _, a in ipairs(arms) do a.p:Destroy() end
		kill(core, halo)
	end)
	FX.emit(pos, { tex = "spark", color = color, n = 20, speed = -r * 1.5, life = 0.6, spread = 180 })
end

-- купол территории из панелей (видно и изнутри, и снаружи)
function FX.dome(center, r, style, dur)
	local colors = {
		void = { Color3.fromRGB(16, 14, 40), Color3.fromRGB(110, 70, 230), Color3.fromRGB(92, 214, 255) },
		blade = { Color3.fromRGB(30, 4, 8), Color3.fromRGB(230, 32, 56), Color3.fromRGB(255, 220, 220) },
		abyss = { Color3.fromRGB(8, 6, 14), Color3.fromRGB(110, 60, 200), Color3.fromRGB(60, 100, 255) },
	}
	local c = colors[style] or colors.void
	local model = Instance.new("Model")
	model.Name = "Dome"
	model.Parent = folder
	local panels = {}
	local rings, perRing = 7, 22
	for i = 0, rings - 1 do
		local lat0 = i / rings * math.pi / 2
		local lat1 = (i + 1) / rings * math.pi / 2
		local latM = (lat0 + lat1) / 2
		local ringR = math.cos(latM) * r
		local n = math.max(6, math.floor(perRing * math.cos(latM) + 0.5))
		for j = 0, n - 1 do
			local lon = (j + 0.5) / n * math.pi * 2
			local pos = center + Vector3.new(math.cos(lon) * ringR, math.sin(latM) * r, math.sin(lon) * ringR)
			local w = 2 * math.pi * ringR / n * 1.06
			local hgt = (lat1 - lat0) * r * 1.06
			local p = FX.part({ Color = (j + i) % 5 == 0 and c[2] or c[1], Material = Enum.Material.Glass, Size = Vector3.new(w, hgt, 0.4),
				CFrame = CFrame.lookAt(pos, center + Vector3.new(0, math.sin(latM) * r * 0.2, 0)) * CFrame.Angles(0, 0, 0),
				Transparency = 1, Parent = model })
			panels[#panels + 1] = { p = p, row = i, glow = (j + i) % 5 == 0 }
		end
	end
	-- светящийся обод у земли
	local rim = {}
	for k = 1, 36 do
		local ang = k / 36 * math.pi * 2
		local pos = center + Vector3.new(math.cos(ang) * r, 0.4, math.sin(ang) * r)
		rim[k] = FX.part({ Color = c[2], Size = Vector3.new(1.2, 0.8, 2 * math.pi * r / 36 * 1.1), CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang))),
			Transparency = 0.2, Parent = model })
	end
	local floor = FX.part({ Shape = Enum.PartType.Cylinder, Color = c[1], Material = Enum.Material.Glass, Size = Vector3.new(0.2, r * 2, r * 2),
		CFrame = CFrame.new(center + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1, Parent = model })
	local build = 0.7
	FX.run(dur, function(t)
		local el = t * dur
		local shown = math.min(1, el / build)
		local closing = math.max(0, (el - (dur - 0.5)) / 0.5)
		for _, x in ipairs(panels) do
			local rowShown = shown * rings - x.row
			local base = x.glow and 0.35 or 0.25
			if rowShown <= 0 then x.p.Transparency = 1
			else x.p.Transparency = math.clamp(1 - math.min(1, rowShown) * (1 - base) + closing * (1 - base), base, 1) end
		end
		for _, p in ipairs(rim) do p.Transparency = 0.2 + 0.8 * closing end
		floor.Transparency = math.clamp(0.55 + (1 - shown) * 0.45 + closing * 0.45, 0.55, 1)
	end, function() model:Destroy() end)
	return model, c
end

return FX
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Интерфейс боя: здоровье, пробуждение, панель приёмов, рывок/блок, комбо, лента убийств,
-- объявления, цифры урона, вспышки экрана, экран поражения, подсказки управления.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = ReplicatedStorage:WaitForChild("Client")
local Config = require(Shared.Config)
local Characters = require(Shared.Characters)
local Theme = require(Client.Theme)
local Controller = require(Client.Controller)
local SoundFX = require(Client.SoundFX)

local Hud = {}
Hud.showDamage = true
Hud.onMenu = nil        -- ставит ClientMain: открыть меню

local player = Players.LocalPlayer
local ui = {}           -- ссылки на элементы
Hud.ui = ui

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local SLOT_W, SLOT_H, GAP = 154, 58, 8
local BOTTOM_W = SLOT_W * 4 + GAP * 3

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function hex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function textWidth(text, size)
	local n = utf8.len(text) or #text
	return n * size * 0.62
end

local function touchOnly()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

---------------------------------------------------------------- корень с масштабом
-- корневой кадр размером 1/s экрана + UIScale s: всё рисуется в «эталонных» 1366x768
local function scaleFor()
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(1366, 768)
	return math.clamp(math.min(vs.X / 1366, vs.Y / 768), 0.55, 1.5)
end

function Hud.makeRoot(gui, name)
	local s = scaleFor()
	local root = Theme.frame({ Name = name or "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1 / s, 1 / s), Parent = gui })
	local sc = Instance.new("UIScale")
	sc.Scale = s
	sc.Parent = root
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local ns = scaleFor()
			sc.Scale = ns
			root.Size = UDim2.fromScale(1 / ns, 1 / ns)
		end)
	end
	return root
end

---------------------------------------------------------------- построение
local function keyBadge(parent, text, pos, size)
	local b = Theme.label({ Name = "Key", Text = text, Size = UDim2.fromOffset(size or 20, size or 20), Position = pos,
		BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(235, 235, 240), TextColor3 = BLACK,
		FontFace = Theme.Black, TextSize = 13, ZIndex = 4, Parent = parent })
	Theme.corner(b, 4)
	return b
end

local function buildSlot(parent, i)
	local s = Theme.button({ Name = "Slot" .. i, AutoButtonColor = false, Size = UDim2.fromOffset(SLOT_W, SLOT_H),
		Position = UDim2.fromOffset((i - 1) * (SLOT_W + GAP), 0), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.18,
		ClipsDescendants = true, Parent = parent })
	Theme.corner(s, 6)
	local stroke = Theme.stroke(s, Theme.Line, 1.5, 0.15)
	local grad = Theme.gradient(s, Color3.fromRGB(34, 34, 46), Color3.fromRGB(12, 12, 18), 90)
	local accent = Theme.frame({ Name = "Accent", Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Theme.Accent, ZIndex = 3, Parent = s })
	local cd = Theme.frame({ Name = "Cooldown", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0), BackgroundColor3 = BLACK, BackgroundTransparency = 0.38, ZIndex = 2, Parent = s })
	local key = keyBadge(s, tostring(i), UDim2.fromOffset(6, 7))
	local name = Theme.label({ Name = "MoveName", Text = "", Size = UDim2.new(1, -14, 0, 30), Position = UDim2.fromOffset(8, 25),
		FontFace = Theme.Black, TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 4, Parent = s })
	local time = Theme.label({ Name = "Time", Text = "", Size = UDim2.fromOffset(60, 20), Position = UDim2.new(1, -66, 0, 6),
		FontFace = Theme.BlackItalic, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4, Parent = s })
	Theme.textStroke(time, 1.5)
	local tag = Theme.label({ Name = "Tag", Text = "", Size = UDim2.fromOffset(80, 16), Position = UDim2.new(1, -86, 0, 8),
		FontFace = Theme.Black, TextSize = 11, TextColor3 = Theme.Gold, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4, Parent = s })
	local glow = Theme.frame({ Name = "Glow", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 5, Parent = s })
	s.Activated:Connect(function() Controller.move(i) end)
	return { frame = s, stroke = stroke, grad = grad, accent = accent, cd = cd, key = key, name = name, time = time, tag = tag, glow = glow,
		wasReady = true, base = s.Position }
end

local function bar(parent, name, pos, size, color)
	local track = Theme.frame({ Name = name, Position = pos, Size = size, BackgroundColor3 = Color3.fromRGB(8, 8, 12),
		BackgroundTransparency = 0.25, ClipsDescendants = true, Parent = parent })
	Theme.corner(track, 4)
	Theme.stroke(track, Color3.fromRGB(0, 0, 0), 1.5, 0.3)
	local ghost = Theme.frame({ Name = "Ghost", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 236, 236),
		BackgroundTransparency = 0.35, ZIndex = 2, Parent = track })
	Theme.corner(ghost, 4)
	local fill = Theme.frame({ Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 3, Parent = track })
	Theme.corner(fill, 4)
	local g = Theme.gradient(fill, color, Theme.shade(color, -0.25), 90)
	local shine = Theme.frame({ Name = "Shine", Size = UDim2.new(1, 0, 0.42, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.82,
		ZIndex = 4, Parent = fill })
	Theme.corner(shine, 4)
	return { track = track, ghost = ghost, fill = fill, grad = g, shown = 1, ghostV = 1 }
end

local function chip(parent, name, text, pos)
	local c = Theme.frame({ Name = name, Position = pos, Size = UDim2.fromOffset(96, 24), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.2, ClipsDescendants = true, Parent = parent })
	Theme.corner(c, 5)
	local stroke = Theme.stroke(c, Theme.Line, 1.2, 0.3)
	local fill = Theme.frame({ Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(70, 70, 92),
		BackgroundTransparency = 0.25, ZIndex = 2, Parent = c })
	local label = Theme.label({ Name = "Label", Text = text, Size = UDim2.fromScale(1, 1), FontFace = Theme.Black, TextSize = 12,
		ZIndex = 3, Parent = c })
	return { frame = c, fill = fill, label = label, stroke = stroke }
end

local function buildBottom(root)
	local b = Theme.frame({ Name = "Bottom", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(BOTTOM_W, 150), Parent = root })
	ui.bottom = b
	-- имя и персонаж
	ui.name = Theme.label({ Name = "PlayerName", Text = player.DisplayName, Size = UDim2.fromOffset(300, 20), Position = UDim2.fromOffset(2, 38),
		FontFace = Theme.Bold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Parent = b })
	Theme.textStroke(ui.name, 1.2)
	ui.awakenText = Theme.label({ Name = "AwakenText", Text = "", Size = UDim2.fromOffset(330, 20), Position = UDim2.new(1, -332, 0, 38),
		FontFace = Theme.BlackItalic, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Dim, Parent = b })
	Theme.textStroke(ui.awakenText, 1.2)
	-- здоровье
	ui.hp = bar(b, "Health", UDim2.fromOffset(0, 60), UDim2.new(1, 0, 0, 18), Theme.Good)
	ui.hpText = Theme.label({ Name = "HPText", Text = "100", Size = UDim2.fromOffset(90, 18), Position = UDim2.new(1, -96, 0, 60),
		FontFace = Theme.BlackItalic, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6, Parent = b })
	Theme.textStroke(ui.hpText, 1.5)
	-- пробуждение
	ui.meter = bar(b, "Awakening", UDim2.fromOffset(0, 82), UDim2.new(1, 0, 0, 7), Theme.Accent)
	ui.meter.shown = 0
	ui.meter.ghostV = 0
	ui.meter.ghost.Visible = false
	ui.meterGlow = Theme.frame({ Name = "MeterGlow", Position = UDim2.fromOffset(-3, 79), Size = UDim2.new(1, 6, 0, 13),
		BackgroundColor3 = Theme.Gold, BackgroundTransparency = 1, ZIndex = 0, Parent = b })
	Theme.corner(ui.meterGlow, 6)
	local meterBtn = Theme.button({ Name = "AwakenButton", Text = "", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 76),
		Size = UDim2.new(1, 0, 0, 16), ZIndex = 7, Parent = b })
	meterBtn.Activated:Connect(function() Controller.awaken() end)
	-- приёмы
	local row = Theme.frame({ Name = "Slots", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, SLOT_H), Parent = b })
	ui.slots = {}
	for i = 1, 4 do ui.slots[i] = buildSlot(row, i) end
	-- рывок и блок
	local side = Theme.frame({ Name = "Side", BackgroundTransparency = 1, Position = UDim2.fromOffset(-106, 66), Size = UDim2.fromOffset(96, 84), Parent = b })
	ui.dashF = chip(side, "Dash", "Q  РЫВОК", UDim2.fromOffset(0, 0))
	ui.dashS = chip(side, "Evade", "A/D+Q  УВОРОТ", UDim2.fromOffset(0, 28))
	ui.block = chip(side, "Block", "F  БЛОК", UDim2.fromOffset(0, 56))
	ui.dashS.label.TextSize = 11
end

local function buildCard(root)
	local c = Theme.frame({ Name = "Card", Position = UDim2.fromOffset(16, 64), Size = UDim2.fromOffset(300, 66), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.2, ClipsDescendants = true, Parent = root })
	Theme.corner(c, 6)
	Theme.stroke(c, Theme.Line, 1.2, 0.3)
	ui.cardGrad = Theme.gradient(c, Theme.Accent, Theme.Panel, 0, 0.55, 0.05)
	ui.cardStripe = Theme.frame({ Name = "Stripe", Size = UDim2.new(0, 6, 1, 0), BackgroundColor3 = Theme.Accent, ZIndex = 2, Parent = c })
	ui.cardName = Theme.label({ Name = "CharName", Text = "", Position = UDim2.fromOffset(18, 8), Size = UDim2.new(1, -24, 0, 30),
		FontFace = Theme.BlackItalic, TextSize = 25, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = c })
	Theme.textStroke(ui.cardName, 1.5)
	ui.cardTitle = Theme.label({ Name = "CharTitle", Text = "", Position = UDim2.fromOffset(19, 38), Size = UDim2.new(1, -24, 0, 18),
		FontFace = Theme.Medium, TextSize = 13, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = c })
	local menu = Theme.button({ Name = "MenuButton", Text = "МЕНЮ", Position = UDim2.fromOffset(16, 136), Size = UDim2.fromOffset(120, 32),
		BackgroundColor3 = Theme.Panel2, BackgroundTransparency = 0.1, TextSize = 15, Parent = root })
	Theme.corner(menu, 6)
	Theme.stroke(menu, Theme.Line, 1.2, 0.2)
	ui.menuKey = keyBadge(menu, "M", UDim2.new(1, -26, 0, 6))
	menu.Activated:Connect(function()
		SoundFX.play("Click")
		if Hud.onMenu then Hud.onMenu() end
	end)
	ui.menuButton = menu
end

local function buildCombo(root)
	local c = Theme.frame({ Name = "Combo", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -36, 0.44, 0),
		Size = UDim2.fromOffset(240, 120), Parent = root })
	ui.combo = c
	ui.comboNum = Theme.label({ Name = "Num", Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(240, 76),
		FontFace = Theme.BlackItalic, TextSize = 72, TextXAlignment = Enum.TextXAlignment.Right, Parent = c })
	ui.comboGrad = Theme.gradient(ui.comboNum, WHITE, Theme.Gold, 90)
	Theme.textStroke(ui.comboNum, 3)
	ui.comboLabel = Theme.label({ Name = "Label", Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 74), Size = UDim2.fromOffset(240, 24),
		FontFace = Theme.BlackItalic, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Right, Parent = c })
	Theme.textStroke(ui.comboLabel, 2)
	c.Visible = false
end

local function buildFeed(root)
	local f = Theme.frame({ Name = "Killfeed", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 250),
		Size = UDim2.fromOffset(420, 240), Parent = root })
	Theme.list(f, Enum.FillDirection.Vertical, 5, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top)
	ui.feed = f
	ui.feedN = 0
end

local function buildAnnounce(root)
	local a = Theme.frame({ Name = "Announce", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(900, 110), Parent = root })
	ui.announce = a
	ui.annBand = Theme.frame({ Name = "Band", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = BLACK, BackgroundTransparency = 1, Parent = a })
	ui.annBandGrad = Theme.gradient(ui.annBand, WHITE, WHITE, 0)
	ui.annBandGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) })
	ui.annSub = Theme.label({ Name = "Sub", Text = "", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(1, 0, 0, 24),
		FontFace = Theme.Black, TextSize = 16, TextColor3 = Theme.Gold, TextTransparency = 1, Parent = a })
	Theme.textStroke(ui.annSub, 1.5)
	ui.annText = Theme.label({ Name = "Title", Text = "", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.new(1, 0, 0, 64),
		FontFace = Theme.BlackItalic, TextSize = 50, TextTransparency = 1, Parent = a })
	ui.annStroke = Theme.textStroke(ui.annText, 3)
	ui.annStroke.Transparency = 1
end

local function buildCenter(root)
	-- вспышка экрана
	ui.flash = Theme.frame({ Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 40, Parent = root })
	-- окно «нажми ещё раз»
	ui.cue = Theme.label({ Name = "Cue", Text = "ЖМИ!", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.fromOffset(300, 60),
		FontFace = Theme.BlackItalic, TextSize = 44, TextColor3 = Theme.Gold, TextTransparency = 1, ZIndex = 30, Parent = root })
	ui.cueStroke = Theme.textStroke(ui.cue, 3)
	ui.cueStroke.Transparency = 1
	-- уведомления
	ui.notify = Theme.label({ Name = "Notify", Text = "", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -182), Size = UDim2.fromOffset(560, 34),
		BackgroundTransparency = 1, BackgroundColor3 = Theme.Panel, FontFace = Theme.Bold, TextSize = 16, TextTransparency = 1, ZIndex = 20, Parent = root })
	Theme.corner(ui.notify, 6)
	ui.notifyStroke = Theme.stroke(ui.notify, Theme.Bad, 1.5, 1)
end

local function buildDeath(root)
	local d = Theme.frame({ Name = "Death", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, ZIndex = 35, Visible = false, Parent = root })
	local g = Theme.gradient(d, BLACK, BLACK, 90)
	g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.35, 0.75), NumberSequenceKeypoint.new(0.65, 0.75), NumberSequenceKeypoint.new(1, 0.15) })
	ui.death = d
	ui.deathTitle = Theme.label({ Name = "Title", Text = "ВЫ ПОВЕРЖЕНЫ", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(900, 80), FontFace = Theme.BlackItalic, TextSize = 64, TextColor3 = Color3.fromRGB(255, 70, 70), ZIndex = 36, Parent = d })
	Theme.textStroke(ui.deathTitle, 3)
	ui.deathBy = Theme.label({ Name = "By", Text = "", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(900, 30), FontFace = Theme.Bold, TextSize = 20, RichText = true, ZIndex = 36, Parent = d })
	Theme.textStroke(ui.deathBy, 1.5)
	ui.deathTimer = Theme.label({ Name = "Timer", Text = "", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromOffset(900, 26), FontFace = Theme.Medium, TextSize = 17, TextColor3 = Theme.Dim, ZIndex = 36, Parent = d })
end

local HINTS = {
	{ "ЛКМ", "удар (зажми — серия)" },
	{ "F", "блок (вовремя — парирование)" },
	{ "Q", "рывок  ·  A/D + Q — уворот" },
	{ "1–4", "приёмы" },
	{ "Пробел", "+ 4-й удар — апперкот" },
	{ "G", "пробуждение (шкала полна)" },
	{ "M", "меню и персонажи" },
}
local function buildHints(root)
	local h = Theme.frame({ Name = "Hints", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Size = UDim2.fromOffset(268, 24 + #HINTS * 22),
		BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.3, Parent = root })
	Theme.corner(h, 6)
	Theme.stroke(h, Theme.Line, 1.2, 0.4)
	Theme.label({ Name = "Head", Text = "УПРАВЛЕНИЕ  ·  H — скрыть", Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 18),
		FontFace = Theme.Black, TextSize = 11, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = h })
	for i, row in ipairs(HINTS) do
		local y = 22 + (i - 1) * 22
		local k = Theme.label({ Name = "K" .. i, Text = row[1], Position = UDim2.fromOffset(10, y + 2), Size = UDim2.fromOffset(math.max(22, textWidth(row[1], 12) + 10), 18),
			BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(230, 230, 236), TextColor3 = BLACK, FontFace = Theme.Black, TextSize = 12, Parent = h })
		Theme.corner(k, 4)
		Theme.label({ Name = "T" .. i, Text = row[2], Position = UDim2.fromOffset(78, y), Size = UDim2.fromOffset(186, 22),
			FontFace = Theme.Medium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = h })
	end
	ui.hints = h
end

-- gui — основной HUD (прячется вместе с меню), overlay — поверх всего (объявления, вспышки, уведомления)
function Hud.init(gui, overlay)
	ui.gui = gui
	local root = Hud.makeRoot(gui, "HUD")
	ui.root = root
	local top = Hud.makeRoot(overlay or gui, "Overlay")
	ui.top = top
	buildBottom(root)
	buildCard(root)
	buildCombo(root)
	buildFeed(root)
	buildAnnounce(top)
	buildCenter(top)
	buildDeath(root)
	buildHints(root)
	if touchOnly() then
		ui.hints.Visible = false
		ui.menuKey.Visible = false
		for _, s in ipairs(ui.slots) do s.key.Visible = false end
		ui.dashF.label.Text = "РЫВОК"
		ui.dashS.label.Text = "УВОРОТ"
		ui.block.label.Text = "БЛОК"
	end
	-- подсказки прячутся сами через 40 с
	task.delay(40, function()
		if ui.hints.Visible then tween(ui.hints, 0.5, { BackgroundTransparency = 1 }) task.wait(0.5) ui.hints.Visible = false end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.H then
			ui.hints.Visible = not ui.hints.Visible
			ui.hints.BackgroundTransparency = 0.3
		end
	end)
	Hud.setCharacter(player:GetAttribute("CharId") or Characters.Default, false)
end

---------------------------------------------------------------- персонаж и приёмы
Hud.charId = nil
Hud.awakened = false

function Hud.setCharacter(charId, awakened)
	if not Characters.valid(charId) then charId = Characters.Default end
	Hud.charId = charId
	Hud.awakened = awakened and true or false
	local def = Characters.get(charId)
	local moves = Characters.moveset(charId, Hud.awakened)
	ui.cardName.Text = string.upper(def.Name)
	ui.cardTitle.Text = def.Title .. "  ·  сложность: " .. string.lower(def.Difficulty)
	ui.cardStripe.BackgroundColor3 = def.Color
	ui.cardGrad.Color = ColorSequence.new(def.Color, Theme.Panel)
	ui.name.Text = player.DisplayName .. '  <font color="' .. hex(def.Color) .. '">' .. def.Name .. "</font>"
	ui.meter.grad.Color = ColorSequence.new(def.Color, def.Accent)
	for i, s in ipairs(ui.slots) do
		local m = moves[i]
		s.name.Text = m and string.upper(m.Name) or ""
		s.accent.BackgroundColor3 = (m and m.Ultimate) and Theme.Gold or def.Color
		s.tag.Text = (m and m.Ultimate) and (m.Domain and "ТЕРРИТОРИЯ" or "УЛЬТА") or ""
		s.stroke.Color = (m and m.Ultimate) and Theme.Gold or Theme.Line
		if Hud.awakened then
			s.grad.Color = ColorSequence.new(Theme.shade(def.Dark, 0.15), Color3.fromRGB(12, 12, 18))
		else
			s.grad.Color = ColorSequence.new(Color3.fromRGB(34, 34, 46), Color3.fromRGB(12, 12, 18))
		end
	end
end

---------------------------------------------------------------- кадр
local function setBar(b, value, dt, ghostRate)
	b.shown = b.shown + (value - b.shown) * math.min(1, dt * 18)
	if value > b.ghostV then b.ghostV = value else b.ghostV = b.ghostV + (value - b.ghostV) * math.min(1, dt * (ghostRate or 2.2)) end
	b.fill.Size = UDim2.fromScale(math.clamp(b.shown, 0, 1), 1)
	b.ghost.Size = UDim2.fromScale(math.clamp(b.ghostV, 0, 1), 1)
end

local pulse = 0
local function fmtTime(t)
	if t >= 10 then return string.format("%d", math.ceil(t)) end
	return string.format("%.1f", t)
end

function Hud.update(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	pulse = pulse + dt
	-- здоровье
	if hum then
		local frac = hum.MaxHealth > 0 and hum.Health / hum.MaxHealth or 0
		setBar(ui.hp, frac, dt)
		ui.hpText.Text = string.format("%d", math.ceil(math.max(0, hum.Health)))
		local col = frac > 0.5 and Theme.Good or (frac > 0.25 and Color3.fromRGB(255, 200, 70) or Theme.Bad)
		ui.hp.grad.Color = ColorSequence.new(col, Theme.shade(col, -0.3))
	end
	-- пробуждение
	local meter = char and (char:GetAttribute("Meter") or 0) or 0
	local awakened = char and char:GetAttribute("Awakened") or false
	setBar(ui.meter, meter / Config.Awaken.Max, dt)
	local def = Characters.get(Hud.charId)
	if awakened then
		local left = meter / Config.Awaken.Max * Config.Awaken.Duration
		ui.awakenText.Text = string.format("%s  %d:%02d", def.Awakening.Name, math.floor(left / 60), math.floor(left % 60))
		ui.awakenText.TextColor3 = def.Accent
		ui.meterGlow.BackgroundTransparency = 0.6 + 0.15 * math.sin(pulse * 6)
		ui.meterGlow.BackgroundColor3 = def.Color
	elseif meter >= Config.Awaken.Max then
		ui.awakenText.Text = touchOnly() and "НАЖМИ НА ШКАЛУ — ПРОБУЖДЕНИЕ!" or "G — ПРОБУЖДЕНИЕ!"
		ui.awakenText.TextColor3 = Theme.Gold:Lerp(WHITE, 0.5 + 0.5 * math.sin(pulse * 8))
		ui.meterGlow.BackgroundTransparency = 0.45 + 0.3 * math.sin(pulse * 8)
		ui.meterGlow.BackgroundColor3 = Theme.Gold
	else
		ui.awakenText.Text = string.format("ПРОБУЖДЕНИЕ  %d%%", math.floor(meter))
		ui.awakenText.TextColor3 = Theme.Dim
		ui.meterGlow.BackgroundTransparency = 1
	end
	if awakened ~= Hud.awakened and Hud.charId then Hud.setCharacter(Hud.charId, awakened) end
	-- приёмы
	local now = workspace:GetServerTimeNow()
	local silenced = char and char:GetAttribute("Silenced")
	local rc = Controller.recast
	for i, s in ipairs(ui.slots) do
		local left = (Controller.cds[i] or 0) - now
		local len = math.max(0.1, Controller.cdLen[i] or 1)
		local recast = rc and rc.slot == i and now <= rc.to
		if recast then
			s.cd.Size = UDim2.fromScale(1, 0)
			s.time.Text = ""
			local open = now >= rc.from
			s.glow.BackgroundTransparency = open and (0.55 + 0.25 * math.sin(pulse * 30)) or 0.85
			s.glow.BackgroundColor3 = Theme.Gold
			s.tag.Text = "ЕЩЁ РАЗ!"
			s.name.TextTransparency = 0
		elseif left > 0 then
			s.cd.Size = UDim2.fromScale(1, math.clamp(left / len, 0, 1))
			s.time.Text = fmtTime(left)
			s.name.TextTransparency = 0.45
			s.wasReady = false
			if s.glow.BackgroundColor3 == Theme.Gold then s.glow.BackgroundTransparency = 1 end
		else
			s.cd.Size = UDim2.fromScale(1, 0)
			s.time.Text = ""
			s.name.TextTransparency = 0
			if not s.wasReady then
				s.wasReady = true
				s.glow.BackgroundColor3 = WHITE
				s.glow.BackgroundTransparency = 0.35
				tween(s.glow, 0.45, { BackgroundTransparency = 1 })
			end
			if s.tag.Text == "ЕЩЁ РАЗ!" then
				local moves = Characters.moveset(Hud.charId, Hud.awakened)
				local m = moves[i]
				s.tag.Text = (m and m.Ultimate) and (m.Domain and "ТЕРРИТОРИЯ" or "УЛЬТА") or ""
				s.glow.BackgroundTransparency = 1
			end
		end
		if silenced and not recast then s.name.TextTransparency = 0.6 end
	end
	-- рывок
	local t = os.clock()
	local function dashChip(c, keys)
		local rem, total = 0, 1
		for _, k in ipairs(keys) do
			local r = (Controller.dashReady[k] or 0) - t
			if r > rem then
				rem = r
				total = (k == "F" and Config.Dash.FrontCooldown) or (k == "B" and Config.Dash.BackCooldown) or Config.Dash.SideCooldown
			end
		end
		c.fill.Size = UDim2.fromScale(math.clamp(rem / total, 0, 1), 1)
		c.label.TextTransparency = rem > 0 and 0.45 or 0
	end
	dashChip(ui.dashF, { "F" })
	dashChip(ui.dashS, { "L", "R" })
	local blocking = char and (char:GetAttribute("Blocking") or Controller.state.blocking)
	local broken = char and char:GetAttribute("GuardBroken")
	if broken then
		ui.block.fill.Size = UDim2.fromScale(1, 1)
		ui.block.fill.BackgroundColor3 = Theme.Bad
		ui.block.label.Text = "БЛОК ПРОБИТ"
	elseif blocking then
		ui.block.fill.Size = UDim2.fromScale(1, 1)
		ui.block.fill.BackgroundColor3 = Color3.fromRGB(90, 150, 255)
		ui.block.label.Text = touchOnly() and "БЛОК" or "F  БЛОК"
	else
		ui.block.fill.Size = UDim2.fromScale(0, 1)
		ui.block.label.Text = touchOnly() and "БЛОК" or "F  БЛОК"
	end
	-- экран поражения
	if ui.deathUntil then
		local rem = ui.deathUntil - os.clock()
		if rem > 0 then
			ui.deathTimer.Text = string.format("Возрождение через %d…", math.ceil(rem))
		else
			ui.deathTimer.Text = "Возрождение…"
		end
	end
end

---------------------------------------------------------------- реакции
function Hud.denied(what, slot)
	if what == "cooldown" and slot and ui.slots[slot] then
		local s = ui.slots[slot]
		s.frame.Position = s.base + UDim2.fromOffset(4, 0)
		tween(s.frame, 0.18, { Position = s.base }, Enum.EasingStyle.Elastic)
	elseif what == "silenced" then
		Hud.notify("Внутри чужой территории приёмы не работают!", "bad")
	elseif what == "meter" then
		ui.meterGlow.BackgroundColor3 = Theme.Bad
		ui.meterGlow.BackgroundTransparency = 0.5
		tween(ui.meterGlow, 0.4, { BackgroundTransparency = 1 })
	end
end

function Hud.pressed(slot)
	local s = ui.slots[slot]
	if not s then return end
	s.glow.BackgroundColor3 = WHITE
	s.glow.BackgroundTransparency = 0.6
	tween(s.glow, 0.25, { BackgroundTransparency = 1 })
end

function Hud.flash(color, t, a)
	local f = ui.flash
	f.BackgroundColor3 = color or WHITE
	f.BackgroundTransparency = 1 - (a or 0.3)
	tween(f, t or 0.25, { BackgroundTransparency = 1 })
end

local annToken = 0
function Hud.announce(text, color, sub)
	annToken = annToken + 1
	local tok = annToken
	color = color or WHITE
	ui.annText.Text = text or ""
	ui.annSub.Text = sub or ""
	ui.annText.TextColor3 = WHITE
	ui.annStroke.Color = Theme.shade(color, -0.6)
	ui.annBandGrad.Color = ColorSequence.new(color, color)
	ui.annText.TextSize = 70
	ui.annText.TextTransparency = 0
	ui.annStroke.Transparency = 0.1
	ui.annSub.TextTransparency = sub and 0 or 1
	ui.annSub.TextColor3 = color:Lerp(WHITE, 0.35)
	ui.annBand.BackgroundTransparency = 0.25
	ui.annBand.Size = UDim2.new(0.2, 0, 0, 64)
	tween(ui.annText, 0.25, { TextSize = 50 }, Enum.EasingStyle.Back)
	tween(ui.annBand, 0.3, { Size = UDim2.new(1, 0, 0, 64) })
	task.delay(2.2, function()
		if tok ~= annToken then return end
		tween(ui.annText, 0.5, { TextTransparency = 1 })
		tween(ui.annStroke, 0.5, { Transparency = 1 })
		tween(ui.annSub, 0.5, { TextTransparency = 1 })
		tween(ui.annBand, 0.5, { BackgroundTransparency = 1 })
	end)
end

local notifyToken = 0
function Hud.notify(text, kind)
	notifyToken = notifyToken + 1
	local tok = notifyToken
	local n = ui.notify
	n.Text = text
	n.Size = UDim2.fromOffset(math.max(260, textWidth(text, 16) + 40), 34)
	n.TextTransparency = 0
	n.BackgroundTransparency = 0.15
	ui.notifyStroke.Transparency = 0.2
	ui.notifyStroke.Color = kind == "bad" and Theme.Bad or (kind == "good" and Theme.Good or Theme.Line)
	if kind == "bad" then SoundFX.play("Click", nil, 0.6) end
	task.delay(2.6, function()
		if tok ~= notifyToken then return end
		tween(n, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
		tween(ui.notifyStroke, 0.4, { Transparency = 1 })
	end)
end

local cueToken = 0
function Hud.cue(window)
	cueToken = cueToken + 1
	local tok = cueToken
	local c = ui.cue
	c.Text = "ЖМИ!"
	c.TextSize = 70
	c.TextTransparency = 0
	ui.cueStroke.Transparency = 0.1
	tween(c, 0.12, { TextSize = 46 }, Enum.EasingStyle.Back)
	SoundFX.play("Ready", nil, 0.8)
	task.delay(math.max(0.2, window or 0.25), function()
		if tok ~= cueToken then return end
		tween(c, 0.2, { TextTransparency = 1 })
		tween(ui.cueStroke, 0.2, { Transparency = 1 })
	end)
end

local comboToken = 0
function Hud.combo(n)
	comboToken = comboToken + 1
	local tok = comboToken
	local c = ui.combo
	if not n or n < 2 then
		if c.Visible then
			tween(ui.comboNum, 0.3, { TextTransparency = 1 })
			tween(ui.comboLabel, 0.3, { TextTransparency = 1 })
			task.delay(0.3, function() if tok == comboToken then c.Visible = false end end)
		end
		return
	end
	c.Visible = true
	ui.comboNum.Text = tostring(n)
	ui.comboLabel.Text = n >= 20 and "БЕЗУМНОЕ КОМБО" or (n >= 10 and "СУПЕР КОМБО" or "УДАРОВ")
	ui.comboNum.TextTransparency = 0
	ui.comboLabel.TextTransparency = 0
	local hot = n >= 10 and Theme.Bad or Theme.Gold
	ui.comboGrad.Color = ColorSequence.new(WHITE, hot)
	ui.comboNum.TextSize = 92
	tween(ui.comboNum, 0.16, { TextSize = 72 }, Enum.EasingStyle.Back)
end

-- лента убийств
function Hud.killfeed(d)
	local feed = ui.feed
	ui.feedN = ui.feedN + 1
	local kname, vname = d.k, d.v or "?"
	local kc, vc = d.kc or WHITE, d.vc or WHITE
	local mine = (kname == player.DisplayName) or (vname == player.DisplayName)
	local size = 15
	local wK = kname and textWidth(kname, size) or 0
	local wV = textWidth(vname, size)
	local w = math.floor(wK + wV + (kname and 64 or 40))
	local e = Theme.frame({ Name = "Kill" .. ui.feedN, LayoutOrder = -ui.feedN, Size = UDim2.fromOffset(w, 28), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.2, Parent = feed })
	Theme.corner(e, 5)
	local st = Theme.stroke(e, mine and Theme.Gold or Theme.Line, mine and 1.6 or 1.1, mine and 0.1 or 0.4)
	local x = 10
	local labels = {}
	if kname then
		labels[#labels + 1] = Theme.label({ Name = "Killer", Text = kname, Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(wK + 2, 28),
			FontFace = Theme.Black, TextSize = size, TextColor3 = kc:Lerp(WHITE, 0.25), TextXAlignment = Enum.TextXAlignment.Left, Parent = e })
		x = x + wK + 8
	end
	-- значок: два скрещённых клинка
	local icon = Theme.frame({ Name = "Icon", BackgroundTransparency = 1, Position = UDim2.fromOffset(x, 4), Size = UDim2.fromOffset(20, 20), Parent = e })
	for _, r in ipairs({ 45, -45 }) do
		labels[#labels + 1] = Theme.frame({ Name = "Blade", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 3), Rotation = r, BackgroundColor3 = kname and Theme.Bad or Theme.Dim, Parent = icon })
	end
	x = x + 26
	labels[#labels + 1] = Theme.label({ Name = "Victim", Text = vname, Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(wV + 2, 28),
		FontFace = Theme.Black, TextSize = size, TextColor3 = vc:Lerp(WHITE, 0.25), TextXAlignment = Enum.TextXAlignment.Left, Parent = e })
	-- не больше 6 строк
	local kids = {}
	for _, c in ipairs(feed:GetChildren()) do if c:IsA("Frame") then kids[#kids + 1] = c end end
	table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	for i = 7, #kids do kids[i]:Destroy() end
	task.delay(7, function()
		if not e.Parent then return end
		tween(e, 0.5, { BackgroundTransparency = 1 })
		tween(st, 0.5, { Transparency = 1 })
		for _, l in ipairs(labels) do
			if l:IsA("TextLabel") then tween(l, 0.5, { TextTransparency = 1 }) else tween(l, 0.5, { BackgroundTransparency = 1 }) end
		end
		task.wait(0.55)
		e:Destroy()
	end)
	-- моё поражение
	if vname == player.DisplayName and d.kind == "player" then Hud.death(kname, kc) end
end

-- цифры урона над целью
local dmgStack = {}
function Hud.damage(model, amount, color, crit, dot)
	if not Hud.showDamage or not model then return end
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	if not root then return end
	local now = os.clock()
	local st = dmgStack[model]
	if not st or now - st.t > 0.6 then st = { t = now, n = 0 } end
	st.t = now
	st.n = (st.n + 1) % 4
	dmgStack[model] = st
	local bb = Instance.new("BillboardGui")
	bb.Name = "Damage"
	bb.Adornee = root
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Size = UDim2.fromOffset(140, 48)
	bb.StudsOffset = Vector3.new((math.random() - 0.5) * 2.4, 2.6 + st.n * 0.7, 0)
	bb.MaxDistance = 160
	local l = Theme.label({ Name = "Amount", Text = string.format(amount >= 10 and "%d" or "%.1f", amount), Size = UDim2.fromScale(1, 1),
		FontFace = Theme.BlackItalic, TextSize = crit and 40 or (dot and 20 or 28), TextColor3 = crit and Color3.fromRGB(255, 60, 60) or (color or WHITE):Lerp(WHITE, 0.35),
		Parent = bb })
	Theme.textStroke(l, crit and 3 or 2)
	bb.Parent = player:FindFirstChildOfClass("PlayerGui")
	l.TextSize = (crit and 56 or 38)
	tween(l, 0.15, { TextSize = crit and 40 or (dot and 20 or 28) }, Enum.EasingStyle.Back)
	tween(bb, 0.8, { StudsOffset = bb.StudsOffset + Vector3.new(0, 2.2, 0) }, Enum.EasingStyle.Quad)
	task.delay(0.45, function() tween(l, 0.35, { TextTransparency = 1 }) end)
	game:GetService("Debris"):AddItem(bb, 0.9)
end

function Hud.death(killer, kc)
	local d = ui.death
	if not ui.deathUntil then
		d.Visible = true
		d.BackgroundTransparency = 1
		tween(d, 0.6, { BackgroundTransparency = 0.25 })
		ui.deathTitle.TextTransparency = 1
		tween(ui.deathTitle, 0.4, { TextTransparency = 0 })
		ui.deathUntil = os.clock() + Config.RespawnTime
		ui.deathBy.Text = ""
	end
	if killer then
		ui.deathBy.Text = 'Вас победил <font color="' .. hex((kc or WHITE):Lerp(WHITE, 0.2)) .. '">' .. killer .. "</font>"
	end
end

function Hud.respawned()
	ui.deathUntil = nil
	if ui.death.Visible then
		tween(ui.death, 0.3, { BackgroundTransparency = 1 })
		tween(ui.deathTitle, 0.3, { TextTransparency = 1 })
		task.delay(0.32, function() ui.death.Visible = false end)
	end
end

function Hud.setVisible(on)
	ui.root.Visible = on
end

return Hud
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[-- Меню: выбор персонажа (3D-превью, приёмы, пробуждение), настройки, управление.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = ReplicatedStorage:WaitForChild("Client")
local Config = require(Shared.Config)
local Characters = require(Shared.Characters)
local Costumes = require(Shared.Costumes)
local Poses = require(Shared.Poses)
local Rig = require(Shared.Rig)
local Theme = require(Client.Theme)
local Hud = require(Client.Hud)
local FX = require(Client.FX)
local CameraFX = require(Client.CameraFX)
local SoundFX = require(Client.SoundFX)

local Menu = {}
Menu.isOpen = false
Menu.onOpen = nil       -- function(open)
Menu.current = nil      -- выбранный (подтверждённый сервером) персонаж
Menu.viewing = nil      -- персонаж в карточке подробностей

local player = Players.LocalPlayer
local Action = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Action")
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local ui = {}
Menu.ui = ui

local function tween(inst, t, props, style)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

---------------------------------------------------------------- 3D-превью персонажа
local function stanceVals(def)
	local name = Poses.StanceOf[def.M1Style] or "fists"
	return Poses.BaseVals[name] or Poses.BaseVals.stand
end

-- готовая модель персонажа в боевой стойке (позу «запекаем» в C0 — так она видна в ViewportFrame)
function Menu.makeModel(charId)
	local rig = ReplicatedStorage:FindFirstChild("PreviewRig")
	if not rig then return nil end
	local m = rig:Clone()
	local def = Characters.get(charId)
	Costumes.apply(m, charId)
	if charId == "CrimsonBlade" then Costumes.sword(m, def.Color) end
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	local motors, rot0 = Rig.find(m)
	Rig.apply(motors, rot0, stanceVals(def))
	for _, mo in pairs(motors) do
		mo.C0 = mo.C0 * mo.Transform
		mo.Transform = CFrame.new()
	end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = p.Name == "HumanoidRootPart"
			p.CanCollide = false
		end
	end
	return m
end

local function viewport(parent, props, charId, camDist, yaw)
	local vp = Instance.new("ViewportFrame")
	vp.Name = "Preview"
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(150, 150, 165)
	vp.LightColor = Color3.fromRGB(255, 246, 236)
	vp.LightDirection = Vector3.new(-0.6, -1, -0.7)
	Theme.apply(vp, props)
	local wm = Instance.new("WorldModel")
	wm.Parent = vp
	local m = Menu.makeModel(charId)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	if m then
		m:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, math.pi + (yaw or 0.45), 0))
		m.Parent = wm
	end
	local d = camDist or 11
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 3.3, d), Vector3.new(0, 2.75, 0))
	vp.Parent = parent
	return vp, m, wm
end

---------------------------------------------------------------- построение
local function sectionTitle(parent, text, pos)
	local l = Theme.label({ Name = "Title", Text = text, Position = pos, Size = UDim2.fromOffset(600, 34), FontFace = Theme.BlackItalic,
		TextSize = 30, TextXAlignment = Enum.TextXAlignment.Left, Parent = parent })
	Theme.textStroke(l, 1.5)
	return l
end

local function pill(parent, text, color, pos, w)
	local p = Theme.label({ Name = "Pill", Text = text, Position = pos, Size = UDim2.fromOffset(w or 90, 20), BackgroundTransparency = 0.1,
		BackgroundColor3 = color, TextColor3 = WHITE, FontFace = Theme.Black, TextSize = 11, Parent = parent })
	Theme.corner(p, 10)
	return p
end

local DIFF_COLOR = { ["Легко"] = Color3.fromRGB(70, 180, 100), ["Средне"] = Color3.fromRGB(210, 150, 40), ["Сложно"] = Color3.fromRGB(210, 60, 60) }

local function buildCard(parent, charId, index)
	local def = Characters.get(charId)
	local col = (index - 1) % 3
	local row = math.floor((index - 1) / 3)
	local card = Theme.button({ Name = charId, AutoButtonColor = false, Size = UDim2.fromOffset(196, 254),
		Position = UDim2.fromOffset(col * 210, row * 268), BackgroundColor3 = Theme.Panel, ClipsDescendants = true, Parent = parent })
	Theme.corner(card, 8)
	local stroke = Theme.stroke(card, Theme.Line, 1.5, 0.2)
	Theme.gradient(card, Theme.shade(def.Dark, 0.1), Color3.fromRGB(12, 12, 18), 90)
	-- фон-полоса цвета персонажа
	local band = Theme.frame({ Name = "Band", Position = UDim2.fromOffset(-30, 70), Size = UDim2.fromOffset(260, 60), Rotation = -14,
		BackgroundColor3 = def.Color, BackgroundTransparency = 0.55, Parent = card })
	Theme.gradient(band, def.Color, def.Accent, 0, 0.2, 0.7)
	local vp = viewport(card, { Size = UDim2.fromOffset(196, 186), Position = UDim2.fromOffset(0, 4), ZIndex = 2 }, charId, 11.5, 0.5)
	local shade = Theme.frame({ Name = "Shade", Position = UDim2.new(0, 0, 1, -74), Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.35, ZIndex = 3, Parent = card })
	Theme.gradient(shade, BLACK, BLACK, 90, 1, 0.1)
	local name = Theme.label({ Name = "CharName", Text = string.upper(def.Name), Position = UDim2.new(0, 10, 1, -58), Size = UDim2.new(1, -16, 0, 24),
		FontFace = Theme.BlackItalic, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = card })
	Theme.textStroke(name, 1.5)
	Theme.label({ Name = "CharTitle", Text = def.Title, Position = UDim2.new(0, 11, 1, -33), Size = UDim2.new(1, -100, 0, 18),
		FontFace = Theme.Medium, TextSize = 13, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = card })
	local diff = pill(card, string.upper(def.Difficulty), DIFF_COLOR[def.Difficulty] or Theme.Line, UDim2.new(1, -82, 1, -33), 72)
	diff.ZIndex = 4
	local badge = pill(card, "ВЫ ЗА НЕГО", def.Color, UDim2.fromOffset(8, 8), 92)
	badge.ZIndex = 5
	badge.Visible = false
	local accent = Theme.frame({ Name = "Accent", Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = def.Color, ZIndex = 5, Parent = card })
	card.MouseEnter:Connect(function()
		if Menu.viewing ~= charId then stroke.Color = Theme.shade(def.Color, 0.2) stroke.Transparency = 0.4 end
	end)
	card.MouseLeave:Connect(function()
		if Menu.viewing ~= charId then stroke.Color = Theme.Line stroke.Transparency = 0.2 end
	end)
	card.Activated:Connect(function()
		SoundFX.play("Click")
		Menu.view(charId)
	end)
	return { card = card, stroke = stroke, badge = badge, vp = vp, accent = accent }
end

local function moveRow(parent, y, key, m, color)
	local r = Theme.frame({ Name = "Move" .. key, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Theme.Panel2,
		BackgroundTransparency = 0.25, Parent = parent })
	Theme.corner(r, 5)
	local k = Theme.label({ Name = "Key", Text = key, Position = UDim2.fromOffset(6, 11), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 0,
		BackgroundColor3 = m.Ultimate and Theme.Gold or color, TextColor3 = m.Ultimate and BLACK or WHITE, FontFace = Theme.Black, TextSize = 12, Parent = r })
	Theme.corner(k, 4)
	local name = Theme.label({ Name = "MoveName", Text = string.upper(m.Name), Position = UDim2.fromOffset(34, 3), Size = UDim2.new(1, -90, 0, 18),
		FontFace = Theme.Black, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	local cd = Theme.label({ Name = "Cooldown", Text = m.Ultimate and (m.Domain and "ТЕРРИТОРИЯ" or "УЛЬТА") or (tostring(m.Cooldown) .. " с"),
		Position = UDim2.new(1, -92, 0, 3), Size = UDim2.fromOffset(84, 18), FontFace = Theme.Bold, TextSize = 11,
		TextColor3 = m.Ultimate and Theme.Gold or Theme.Dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = r })
	local desc = Theme.label({ Name = "Desc", Text = m.Desc, Position = UDim2.fromOffset(34, 20), Size = UDim2.new(1, -40, 0, 20),
		FontFace = Theme.Medium, TextSize = 11, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top, Parent = r })
	return { frame = r, key = k, name = name, cd = cd, desc = desc }
end

local function buildDetails(parent)
	local d = Theme.frame({ Name = "Details", Position = UDim2.fromOffset(640, 0), Size = UDim2.fromOffset(330, 640), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.12, ClipsDescendants = true, Parent = parent })
	Theme.corner(d, 8)
	ui.detStroke = Theme.stroke(d, Theme.Line, 1.5, 0.2)
	ui.detGrad = Theme.gradient(d, Theme.Panel2, Theme.Panel, 90)
	ui.details = d
	ui.detBand = Theme.frame({ Name = "Band", Position = UDim2.fromOffset(-40, 60), Size = UDim2.fromOffset(420, 90), Rotation = -12,
		BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.5, Parent = d })
	ui.detBandGrad = Theme.gradient(ui.detBand, Theme.Accent, Theme.Gold, 0, 0.2, 0.75)
	ui.detView = Theme.frame({ Name = "View", BackgroundTransparency = 1, Size = UDim2.fromOffset(330, 214), Parent = d })
	ui.detName = Theme.label({ Name = "CharName", Text = "", Position = UDim2.fromOffset(16, 206), Size = UDim2.fromOffset(300, 32),
		FontFace = Theme.BlackItalic, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left, Parent = d })
	Theme.textStroke(ui.detName, 1.5)
	ui.detTitle = Theme.label({ Name = "CharTitle", Text = "", Position = UDim2.fromOffset(17, 236), Size = UDim2.fromOffset(200, 18),
		FontFace = Theme.Bold, TextSize = 13, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = d })
	ui.detDiff = pill(d, "", Theme.Line, UDim2.fromOffset(232, 236), 82)
	ui.detDesc = Theme.label({ Name = "Desc", Text = "", Position = UDim2.fromOffset(16, 258), Size = UDim2.fromOffset(300, 46),
		FontFace = Theme.Medium, TextSize = 12, TextColor3 = Color3.fromRGB(215, 216, 226), TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = d })
	ui.detMoves = Theme.frame({ Name = "Moves", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 306), Size = UDim2.fromOffset(306, 186), Parent = d })
	ui.detAwk = Theme.label({ Name = "Awakening", Text = "", Position = UDim2.fromOffset(16, 496), Size = UDim2.fromOffset(300, 18),
		FontFace = Theme.BlackItalic, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = d })
	ui.detAwkList = Theme.label({ Name = "AwakeningMoves", Text = "", Position = UDim2.fromOffset(16, 515), Size = UDim2.fromOffset(300, 48),
		FontFace = Theme.Medium, TextSize = 11, TextColor3 = Theme.Dim, TextWrapped = true, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = d })
	ui.selectBtn = Theme.button({ Name = "Select", Text = "ВЫБРАТЬ", Position = UDim2.fromOffset(12, 576), Size = UDim2.fromOffset(306, 52),
		BackgroundColor3 = Theme.Accent, TextSize = 22, FontFace = Theme.BlackItalic, Parent = d })
	Theme.corner(ui.selectBtn, 6)
	ui.selectGrad = Theme.gradient(ui.selectBtn, WHITE, Color3.fromRGB(200, 200, 200), 90)
	Theme.textStroke(ui.selectBtn, 1.5)
	ui.selectBtn.Activated:Connect(function()
		local id = Menu.viewing
		if not id then return end
		SoundFX.play("Select")
		if id == Menu.current then
			Menu.close()
			return
		end
		ui.selectBtn.Text = "…"
		Action:FireServer("Select", id)
	end)
end

local function buildCharacters(page)
	sectionTitle(page, "ВЫБОР ПЕРСОНАЖА", UDim2.fromOffset(0, 0))
	Theme.label({ Name = "Hint", Text = "Нажми на бойца, чтобы увидеть приёмы. Сменить можно вне боя.", Position = UDim2.fromOffset(2, 34),
		Size = UDim2.fromOffset(620, 18), FontFace = Theme.Medium, TextSize = 13, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = page })
	local grid = Theme.frame({ Name = "Grid", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 64), Size = UDim2.fromOffset(616, 522), Parent = page })
	ui.cards = {}
	for i, id in ipairs(Characters.List) do ui.cards[id] = buildCard(grid, id, i) end
	local holder = Theme.frame({ Name = "DetailsHolder", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(970, 640), Parent = page })
	buildDetails(holder)
end

-- переключатели настроек
local function settingRow(parent, y, title, sub)
	local r = Theme.frame({ Name = "Row", Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(640, 58), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15, Parent = parent })
	Theme.corner(r, 6)
	Theme.stroke(r, Theme.Line, 1.2, 0.4)
	Theme.label({ Name = "Name", Text = title, Position = UDim2.fromOffset(16, sub and 8 or 0), Size = UDim2.fromOffset(330, sub and 22 or 58),
		FontFace = Theme.Black, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	if sub then
		Theme.label({ Name = "Sub", Text = sub, Position = UDim2.fromOffset(16, 30), Size = UDim2.fromOffset(330, 18), FontFace = Theme.Medium,
			TextSize = 12, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	end
	return r
end

local function segmented(parent, options, onPick)
	local n = #options
	local w = 90
	local holder = Theme.frame({ Name = "Segmented", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(n * w + (n - 1) * 4, 34), Parent = parent })
	local btns = {}
	local function set(i)
		for j, b in ipairs(btns) do
			b.BackgroundColor3 = j == i and Theme.Accent or Theme.Panel2
			b.TextColor3 = j == i and WHITE or Theme.Dim
		end
	end
	for i, text in ipairs(options) do
		local b = Theme.button({ Name = "Opt" .. i, Text = text, Position = UDim2.fromOffset((i - 1) * (w + 4), 0), Size = UDim2.fromOffset(w, 34),
			TextSize = 13, Parent = holder })
		Theme.corner(b, 5)
		b.Activated:Connect(function()
			SoundFX.play("Click")
			set(i)
			onPick(i)
		end)
		btns[i] = b
	end
	return set
end

local function stepper(parent, fmt, onStep)
	local holder = Theme.frame({ Name = "Stepper", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(180, 34), Parent = parent })
	local minus = Theme.button({ Name = "Minus", Text = "−", Size = UDim2.fromOffset(40, 34), TextSize = 22, Parent = holder })
	Theme.corner(minus, 5)
	local value = Theme.label({ Name = "Value", Text = "", Position = UDim2.fromOffset(44, 0), Size = UDim2.fromOffset(92, 34), BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Panel2, FontFace = Theme.Black, TextSize = 16, Parent = holder })
	Theme.corner(value, 5)
	local plus = Theme.button({ Name = "Plus", Text = "+", Position = UDim2.fromOffset(140, 0), Size = UDim2.fromOffset(40, 34), TextSize = 22, Parent = holder })
	Theme.corner(plus, 5)
	minus.Activated:Connect(function() SoundFX.play("Click") onStep(-1) end)
	plus.Activated:Connect(function() SoundFX.play("Click") onStep(1) end)
	return function(v) value.Text = string.format(fmt, v) end
end

local function buildSettings(page)
	sectionTitle(page, "НАСТРОЙКИ", UDim2.fromOffset(0, 0))
	local y = 56
	-- боты (общие для сервера)
	local r = settingRow(page, y, "Боты на арене", "Общая настройка сервера: 0–" .. Config.Bots.Max)
	local botN = ReplicatedStorage:GetAttribute("BotCount") or Config.Bots.Default
	local setBots
	setBots = stepper(r, "%d", function(d)
		botN = math.clamp(botN + d, 0, Config.Bots.Max)
		setBots(botN)
		Action:FireServer("Bots", botN, nil)
	end)
	setBots(botN)
	ui.setBots = function(n) botN = n setBots(n) end
	y = y + 66
	r = settingRow(page, y, "Сложность ботов", "Как быстро боты реагируют и ставят блок")
	local names = {}
	for i, d in ipairs(Config.Bots.Difficulty) do names[i] = d.Name end
	ui.setLevel = segmented(r, names, function(i) Action:FireServer("Bots", nil, i) end)
	ui.setLevel(ReplicatedStorage:GetAttribute("BotLevel") or Config.Bots.DefaultDifficulty)
	y = y + 66
	r = settingRow(page, y, "Тряска камеры", "Встряска экрана от сильных ударов")
	local setShake = segmented(r, { "Вкл", "Выкл" }, function(i) CameraFX.enabled = i == 1 end)
	setShake(1)
	y = y + 66
	r = settingRow(page, y, "Качество эффектов", "Ниже — больше кадров в секунду на слабых устройствах")
	local setQ = segmented(r, { "Низкое", "Среднее", "Высокое" }, function(i) FX.quality = ({ 0.45, 0.75, 1 })[i] end)
	setQ(UserInputService.TouchEnabled and 2 or 3)
	y = y + 66
	r = settingRow(page, y, "Цифры урона", "Показывать урон над противником")
	local setDmg = segmented(r, { "Вкл", "Выкл" }, function(i) Hud.showDamage = i == 1 end)
	setDmg(1)
	y = y + 66
	r = settingRow(page, y, "Громкость эффектов", nil)
	local vol = 100
	local setVol
	setVol = stepper(r, "%d%%", function(d)
		vol = math.clamp(vol + d * 10, 0, 150)
		SoundFX.volume = vol / 100
		setVol(vol)
	end)
	setVol(vol)
	y = y + 66
	local resp = Theme.button({ Name = "Respawn", Text = "ВОЗРОДИТЬСЯ (если застрял)", Position = UDim2.fromOffset(0, y + 6), Size = UDim2.fromOffset(320, 42),
		TextSize = 15, BackgroundColor3 = Theme.Panel2, Parent = page })
	Theme.corner(resp, 6)
	Theme.stroke(resp, Theme.Line, 1.2, 0.3)
	resp.Activated:Connect(function()
		SoundFX.play("Click")
		Action:FireServer("Respawn")
		Menu.close()
	end)
end

local CONTROLS = {
	{ "ЛКМ", "Удар. Зажми — серия из четырёх ударов" },
	{ "Пробел + 4-й", "Апперкот: подбрасывает врага" },
	{ "4-й в прыжке", "Удар вниз: впечатывает в землю" },
	{ "F", "Блок (держи). Нажми прямо перед ударом — парирование" },
	{ "Q", "Рывок вперёд или назад (W/S)" },
	{ "A/D + Q", "Уворот вбок — уходит от обычных ударов" },
	{ "1 2 3 4", "Приёмы персонажа" },
	{ "G", "Пробуждение, когда шкала заполнена: новые приёмы и ульта" },
	{ "Shift", "Фиксация камеры (как в боевых играх)" },
	{ "M", "Меню · H — подсказки" },
}
local TIPS = {
	"Шкала пробуждения копится, когда вы наносите и получаете урон.",
	"Блок выдерживает около девяти ударов, потом пробивается.",
	"Территория (ульта трёх бойцов) запрещает врагам внутри применять приёмы.",
	"Кулак Бури: нажми клавишу приёма ещё раз во время вспышки — Резонанс.",
	"Телефон: приёмы — нажатие на ячейку, пробуждение — на шкалу.",
	"Геймпад: R2 удар, L2 блок, B рывок, X/Y/R1/L1 приёмы, крестовина ↑ — пробуждение.",
}
local function buildControls(page)
	sectionTitle(page, "УПРАВЛЕНИЕ", UDim2.fromOffset(0, 0))
	for i, row in ipairs(CONTROLS) do
		local y = 56 + (i - 1) * 40
		local k = Theme.label({ Name = "Key" .. i, Text = row[1], Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(130, 32), BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(232, 232, 238), TextColor3 = BLACK, FontFace = Theme.Black, TextSize = 14, Parent = page })
		Theme.corner(k, 5)
		Theme.label({ Name = "Text" .. i, Text = row[2], Position = UDim2.fromOffset(146, y), Size = UDim2.fromOffset(480, 32), FontFace = Theme.Bold,
			TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = page })
	end
	local tips = Theme.frame({ Name = "Tips", Position = UDim2.fromOffset(660, 56), Size = UDim2.fromOffset(310, 392), BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15, Parent = page })
	Theme.corner(tips, 8)
	Theme.stroke(tips, Theme.Line, 1.2, 0.3)
	Theme.label({ Name = "Head", Text = "СОВЕТЫ", Position = UDim2.fromOffset(16, 10), Size = UDim2.fromOffset(280, 24), FontFace = Theme.BlackItalic,
		TextSize = 18, TextColor3 = Theme.Gold, TextXAlignment = Enum.TextXAlignment.Left, Parent = tips })
	for i, t in ipairs(TIPS) do
		Theme.label({ Name = "Tip" .. i, Text = "•  " .. t, Position = UDim2.fromOffset(16, 40 + (i - 1) * 58), Size = UDim2.fromOffset(282, 54),
			FontFace = Theme.Medium, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = Color3.fromRGB(215, 216, 226), Parent = tips })
	end
end

local TABS = { { "chars", "ПЕРСОНАЖИ" }, { "settings", "НАСТРОЙКИ" }, { "controls", "УПРАВЛЕНИЕ" } }

function Menu.init(gui)
	ui.gui = gui
	local root = Hud.makeRoot(gui, "Menu")
	ui.root = root
	root.Visible = false
	-- фон
	local bg = Theme.frame({ Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 6, 10), BackgroundTransparency = 0.12, Parent = root })
	Theme.gradient(bg, Color3.fromRGB(30, 10, 14), Color3.fromRGB(6, 6, 12), 25)
	ui.bg = bg
	for i = 1, 3 do
		Theme.frame({ Name = "Slash" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.18 + i * 0.07, 0, 0.5, 0),
			Size = UDim2.new(0, 34 + i * 10, 1.6, 0), Rotation = 18, BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.86 + i * 0.03, Parent = bg })
	end
	-- левая колонка
	local left = Theme.frame({ Name = "Left", BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 44), Size = UDim2.fromOffset(300, 690), Parent = root })
	local l1 = Theme.label({ Name = "Logo1", Text = "CURSED", Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(300, 64), FontFace = Theme.BlackItalic,
		TextSize = 62, TextXAlignment = Enum.TextXAlignment.Left, Parent = left })
	Theme.textStroke(l1, 2)
	local l2 = Theme.label({ Name = "Logo2", Text = "ARENA", Position = UDim2.fromOffset(28, 54), Size = UDim2.fromOffset(300, 64), FontFace = Theme.BlackItalic,
		TextSize = 62, TextXAlignment = Enum.TextXAlignment.Left, Parent = left })
	Theme.gradient(l2, Theme.Accent, Theme.Gold, 0)
	Theme.textStroke(l2, 2)
	Theme.label({ Name = "Subtitle", Text = string.upper(Config.Subtitle), Position = UDim2.fromOffset(32, 118), Size = UDim2.fromOffset(268, 20),
		FontFace = Theme.Black, TextSize = 14, TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = left })
	ui.tabs = {}
	for i, t in ipairs(TABS) do
		local b = Theme.button({ Name = "Tab_" .. t[1], Text = t[2], Position = UDim2.fromOffset(0, 172 + (i - 1) * 54), Size = UDim2.fromOffset(280, 46),
			TextSize = 18, FontFace = Theme.BlackItalic, BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.2,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = left })
		Theme.corner(b, 6)
		Theme.padding(b, 18)
		local bar = Theme.frame({ Name = "Bar", Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = Theme.Accent, Visible = false, Parent = b })
		b.Activated:Connect(function()
			SoundFX.play("Click")
			Menu.tab(t[1])
		end)
		ui.tabs[t[1]] = { btn = b, bar = bar }
	end
	local play = Theme.button({ Name = "Play", Text = "В БОЙ", Position = UDim2.fromOffset(0, 560), Size = UDim2.fromOffset(280, 64),
		TextSize = 30, FontFace = Theme.BlackItalic, BackgroundColor3 = WHITE, Parent = left })
	Theme.corner(play, 6)
	Theme.gradient(play, Theme.Accent, Color3.fromRGB(200, 40, 60), 0)
	Theme.textStroke(play, 2)
	play.Activated:Connect(function()
		SoundFX.play("Select")
		Menu.close()
	end)
	ui.play = play
	Theme.label({ Name = "Version", Text = "версия " .. Config.Version .. "  ·  оригинальная игра в жанре battlegrounds", Position = UDim2.fromOffset(0, 640),
		Size = UDim2.fromOffset(300, 16), FontFace = Theme.Medium, TextSize = 11, TextColor3 = Color3.fromRGB(110, 110, 125),
		TextXAlignment = Enum.TextXAlignment.Left, Parent = left })
	-- страницы
	local content = Theme.frame({ Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(370, 44), Size = UDim2.fromOffset(970, 690), Parent = root })
	ui.pages = {}
	for _, t in ipairs(TABS) do
		ui.pages[t[1]] = Theme.frame({ Name = "Page_" .. t[1], BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	end
	buildCharacters(ui.pages.chars)
	buildSettings(ui.pages.settings)
	buildControls(ui.pages.controls)
	Menu.current = player:GetAttribute("CharId") or Characters.Default
	Menu.view(Menu.current)
	Menu.tab("chars")
	-- крутим превью в карточке подробностей
	RunService.RenderStepped:Connect(function()
		if not Menu.isOpen or not ui.detModel or not ui.detModel.Parent then return end
		local t = os.clock()
		ui.detModel:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, math.pi + 0.5 + math.sin(t * 0.7) * 0.6, 0))
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Config.Keys.Menu or input.KeyCode == Enum.KeyCode.ButtonSelect then
			if Menu.isOpen then Menu.close() else Menu.open() end
		end
	end)
end

function Menu.tab(name)
	for id, t in pairs(ui.tabs) do
		local on = id == name
		t.bar.Visible = on
		t.btn.BackgroundColor3 = on and Theme.Panel2 or Theme.Panel
		t.btn.BackgroundTransparency = on and 0.05 or 0.25
		t.btn.TextColor3 = on and WHITE or Theme.Dim
		ui.pages[id].Visible = on
	end
	Menu.activeTab = name
end

-- показать персонажа в карточке подробностей
function Menu.view(charId)
	if not Characters.valid(charId) then return end
	Menu.viewing = charId
	local def = Characters.get(charId)
	for id, c in pairs(ui.cards) do
		local on = id == charId
		c.stroke.Color = on and def.Color or Theme.Line
		c.stroke.Thickness = on and 3 or 1.5
		c.stroke.Transparency = on and 0 or 0.2
		c.badge.Visible = id == Menu.current
	end
	ui.detStroke.Color = def.Color
	ui.detBand.BackgroundColor3 = def.Color
	ui.detBandGrad.Color = ColorSequence.new(def.Color, def.Accent)
	ui.detGrad.Color = ColorSequence.new(Theme.shade(def.Dark, 0.12), Theme.Panel)
	ui.detName.Text = string.upper(def.Name)
	ui.detTitle.Text = def.Title
	ui.detDiff.Text = string.upper(def.Difficulty)
	ui.detDiff.BackgroundColor3 = DIFF_COLOR[def.Difficulty] or Theme.Line
	ui.detDesc.Text = def.Desc
	for _, c in ipairs(ui.detMoves:GetChildren()) do c:Destroy() end
	for i, m in ipairs(def.Moves) do moveRow(ui.detMoves, (i - 1) * 46, tostring(i), m, def.Color) end
	ui.detAwk.Text = "ПРОБУЖДЕНИЕ: " .. def.Awakening.Name
	ui.detAwk.TextColor3 = def.Accent:Lerp(WHITE, 0.2)
	local parts = {}
	for i, m in ipairs(def.Awakening.Moves) do
		local n = m.Name
		if m.Ultimate then n = '<font color="#FFD65C">' .. n .. "</font>" end
		parts[#parts + 1] = i .. " " .. n
	end
	ui.detAwkList.Text = table.concat(parts, "  ·  ")
	-- большое превью
	for _, c in ipairs(ui.detView:GetChildren()) do c:Destroy() end
	local _, m = viewport(ui.detView, { Size = UDim2.fromScale(1, 1) }, charId, 10.5, 0.5)
	ui.detModel = m
	if charId == Menu.current then
		ui.selectBtn.Text = "ВЫБРАН — В БОЙ"
		ui.selectBtn.BackgroundColor3 = Theme.Good
	else
		ui.selectBtn.Text = "ВЫБРАТЬ"
		ui.selectBtn.BackgroundColor3 = def.Color
	end
end

-- ответ сервера на выбор
function Menu.selected(charId, ok)
	if ok then
		Menu.current = charId
		Hud.notify("Теперь вы — " .. Characters.get(charId).Name, "good")
		SoundFX.play("Ready")
		Menu.view(charId)
		task.delay(0.35, function() if Menu.isOpen then Menu.close() end end)
	else
		Menu.view(Menu.viewing or charId)
	end
end

function Menu.botsConfig(d)
	if d.n and ui.setBots then ui.setBots(d.n) end
	if d.l and ui.setLevel then ui.setLevel(d.l) end
end

local blur
function Menu.open(tab)
	if tab then Menu.tab(tab) end
	if Menu.isOpen then return end
	Menu.isOpen = true
	ui.root.Visible = true
	ui.bg.BackgroundTransparency = 0.6
	tween(ui.bg, 0.25, { BackgroundTransparency = 0.12 })
	local cam = workspace.CurrentCamera
	if cam then
		blur = blur or Instance.new("BlurEffect")
		blur.Size = 0
		blur.Parent = cam
		tween(blur, 0.25, { Size = 14 })
	end
	Menu.view(Menu.viewing or Menu.current)
	if Menu.onOpen then Menu.onOpen(true) end
end

function Menu.close()
	if not Menu.isOpen then return end
	Menu.isOpen = false
	ui.root.Visible = false
	if blur then blur.Parent = nil end
	if Menu.onOpen then Menu.onOpen(false) end
end

return Menu
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">SoundFX</string><ProtectedString name="Source"><![CDATA[-- Звуки на клиенте. Свой звук из ReplicatedStorage.SoundLibrary важнее встроенного.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local SoundFX = {}
SoundFX.volume = 1

local host
local function hostPart()
	if host and host.Parent then return host end
	host = Instance.new("Part")
	host.Name = "SoundHost"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.one * 0.2
	host.CFrame = CFrame.new(0, -3000, 0)
	host.Parent = workspace:FindFirstChild("LocalFX") or workspace
	return host
end

local function resolve(name)
	local def = Sounds.get(name)
	if not def then return nil end
	local lib = ReplicatedStorage:FindFirstChild("SoundLibrary")
	local custom = lib and lib:FindFirstChild(name)
	if custom and custom:IsA("Sound") and custom.SoundId ~= "" then
		return custom.SoundId, def.volume * (custom.Volume > 0 and custom.Volume / 0.5 or 1), def.pitch, true
	end
	return def.id, def.volume, def.pitch, false
end

-- where: Vector3 (звук в точке), модель/деталь (звук на ней) или nil (без направления)
function SoundFX.play(name, where, volMul)
	local id, vol, pitch = resolve(name)
	if not id then return nil end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol * (volMul or 1) * SoundFX.volume
	s.PlaybackSpeed = pitch[1] + math.random() * (pitch[2] - pitch[1])
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 12
	s.RollOffMaxDistance = 240
	if typeof(where) == "Vector3" then
		local att = Instance.new("Attachment")
		att.Parent = hostPart()
		att.WorldPosition = where
		s.Parent = att
		Debris:AddItem(att, 6)
	elseif typeof(where) == "Instance" then
		local part = where:IsA("BasePart") and where or where:FindFirstChild("HumanoidRootPart") or where:FindFirstChildWhichIsA("BasePart")
		s.Parent = part or SoundService
	else
		s.Parent = SoundService
	end
	s:Play()
	Debris:AddItem(s, 6)
	return s
end

return SoundFX
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Оформление интерфейса: шрифты, цвета и конструкторы элементов
local Theme = {}

Theme.Black = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Normal)
Theme.BlackItalic = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
Theme.Bold = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
Theme.Medium = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium, Enum.FontStyle.Normal)

Theme.Panel = Color3.fromRGB(14, 14, 20)
Theme.Panel2 = Color3.fromRGB(26, 26, 36)
Theme.Line = Color3.fromRGB(70, 70, 90)
Theme.Text = Color3.fromRGB(245, 245, 250)
Theme.Dim = Color3.fromRGB(160, 162, 176)
Theme.Good = Color3.fromRGB(90, 230, 130)
Theme.Bad = Color3.fromRGB(255, 80, 80)
Theme.Gold = Color3.fromRGB(255, 214, 92)
Theme.Accent = Color3.fromRGB(255, 92, 51)

local function apply(inst, props)
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Children" then inst[k] = v end
	end
	if props.Children then
		for _, c in ipairs(props.Children) do c.Parent = inst end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end
Theme.apply = apply

function Theme.frame(props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Theme.Panel
	return apply(f, props)
end

function Theme.label(props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextColor3 = Theme.Text
	l.FontFace = Theme.Bold
	l.TextSize = 16
	l.Text = ""
	return apply(l, props)
end

function Theme.button(props)
	local b = Instance.new("TextButton")
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.BackgroundColor3 = Theme.Panel2
	b.TextColor3 = Theme.Text
	b.FontFace = Theme.Black
	b.TextSize = 18
	b.Text = ""
	return apply(b, props)
end

function Theme.corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = parent
	return c
end

function Theme.stroke(parent, color, thick, transp)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Line
	s.Thickness = thick or 1.5
	s.Transparency = transp or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Theme.textStroke(parent, thick)
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = thick or 1.5
	s.Transparency = 0.25
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
	return s
end

function Theme.gradient(parent, c0, c1, rot, t0, t1)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1 or c0)
	g.Rotation = rot or 0
	if t0 or t1 then
		g.Transparency = NumberSequence.new(t0 or 0, t1 or 0)
	end
	g.Parent = parent
	return g
end

function Theme.padding(parent, px)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = parent
	return p
end

function Theme.list(parent, dir, pad, halign, valign)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, pad or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if halign then l.HorizontalAlignment = halign end
	if valign then l.VerticalAlignment = valign end
	l.Parent = parent
	return l
end

-- тёмнее/светлее
function Theme.shade(c, k)
	if k >= 0 then return c:Lerp(Color3.new(1, 1, 1), k) end
	return c:Lerp(Color3.new(0, 0, 0), -k)
end

return Theme
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Touch</string><ProtectedString name="Source"><![CDATA[-- Кнопки для телефона и планшета: УДАР (зажать — серия), БЛОК (держать), РЫВОК.
-- Приёмы — нажатием на ячейки панели, пробуждение — на шкалу (это делает Hud).
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Client = ReplicatedStorage:WaitForChild("Client")
local Theme = require(Client.Theme)
local Controller = require(Client.Controller)
local Hud = require(Client.Hud)

local Touch = {}
local ui = {}
Touch.ui = ui

local function roundButton(parent, name, text, size, pos, color)
	local b = Theme.button({ Name = name, Text = text, AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color, BackgroundTransparency = 0.35, TextSize = math.floor(size * 0.2), FontFace = Theme.BlackItalic,
		AutoButtonColor = false, Parent = parent })
	Theme.corner(b, size)
	Theme.stroke(b, Color3.new(1, 1, 1), 2, 0.55)
	Theme.textStroke(b, 1.5)
	return b
end

local function hold(btn, onDown, onUp)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			btn.BackgroundTransparency = 0.1
			onDown()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			btn.BackgroundTransparency = 0.35
			if onUp then onUp() end
		end
	end)
end

function Touch.init(gui)
	ui.enabled = UserInputService.TouchEnabled
	if not ui.enabled then return end
	local root = Hud.makeRoot(gui, "Touch")
	ui.root = root
	-- справа снизу, вокруг стандартной кнопки прыжка
	local m1 = roundButton(root, "M1", "УДАР", 118, UDim2.new(1, -250, 1, -150), Color3.fromRGB(200, 50, 50))
	hold(m1, function() Controller.setM1Held(true) end, function() Controller.setM1Held(false) end)
	local block = roundButton(root, "Block", "БЛОК", 84, UDim2.new(1, -120, 1, -290), Color3.fromRGB(60, 110, 220))
	hold(block, function() Controller.setBlock(true) end, function() Controller.setBlock(false) end)
	local dash = roundButton(root, "Dash", "РЫВОК", 84, UDim2.new(1, -250, 1, -290), Color3.fromRGB(80, 80, 100))
	hold(dash, function() Controller.dash() end)
	ui.m1, ui.block, ui.dash = m1, block, dash
	-- на телефоне панель приёмов чуть выше, чтобы не мешать джойстику
	local bottom = Hud.ui.bottom
	if bottom then bottom.Position = UDim2.new(0.5, -40, 1, -14) end
end

function Touch.update()
	if not ui.enabled or not ui.root then return end
	local c = Controller.state
	ui.block.BackgroundTransparency = c.blocking and 0.05 or 0.35
end

function Touch.setVisible(on)
	if ui.root then ui.root.Visible = on end
end

return Touch
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX0000002A"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[-- Персонажи и их приёмы. Названия и описания — то, что видит игрок.
-- AI: подсказка ботам (range — с какой дистанции применять, kind — тип приёма).
local Characters = {}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

Characters.List = { "StormFist", "VoidLord", "CrimsonBlade", "ShadowCaller", "FlameDemon", "Thunderer" }
Characters.Default = "StormFist"

Characters.Defs = {
	StormFist = {
		Name = "Кулак Бури",
		Title = "Неудержимый",
		Desc = "Боец ближнего боя: быстрые серии, удар с отложенной волной и Резонанс — нажми клавишу приёма ещё раз в момент вспышки.",
		Color = rgb(255, 92, 51), Accent = rgb(255, 214, 92), Dark = rgb(60, 14, 10),
		M1Style = "fists",
		Difficulty = "Легко",
		Moves = {
			{ Id = "FistRush", Name = "Рывок Кулака", Cooldown = 9, Desc = "Рывок вперёд и серия ударов. Нажми 1 ещё раз во время вспышки — РЕЗОНАНС.", AI = { range = 26, kind = "gap" } },
			{ Id = "WhirlKick", Name = "Вихревой Пинок", Cooldown = 8, Desc = "Круговой удар ногой: бьёт всех рядом и подбрасывает.", AI = { range = 8, kind = "aoe" } },
			{ Id = "DelayedImpact", Name = "Отложенный Удар", Cooldown = 10, Desc = "Удар, а через миг — вторая волна. Вторая волна пробивает блок.", AI = { range = 7, kind = "melee" } },
			{ Id = "Crusher", Name = "Сокрушитель", Cooldown = 14, Desc = "Захват в прыжке и бросок о землю.", AI = { range = 15, kind = "grab" } },
		},
		Awakening = {
			Name = "ЯРОСТЬ БУРИ",
			Moves = {
				{ Id = "ThunderRush", Name = "Громовой Рывок", Cooldown = 6, Desc = "Длинный рывок с молниями: три удара и Резонанс.", AI = { range = 34, kind = "gap" } },
				{ Id = "Hurricane", Name = "Ураган", Cooldown = 7, Desc = "Смерч ударов: затягивает врагов и выбрасывает вверх.", AI = { range = 12, kind = "aoe" } },
				{ Id = "ThousandFists", Name = "Тысяча Кулаков", Cooldown = 9, Desc = "Град ударов перед собой.", AI = { range = 7, kind = "melee" } },
				{ Id = "HeavenStrike", Name = "Удар Небес", Cooldown = 999, Ultimate = true, Desc = "Прыжок в небо и падение с кулаком: огромный взрыв.", AI = { range = 45, kind = "ult" } },
			},
		},
	},

	VoidLord = {
		Name = "Повелитель Пустоты",
		Title = "Безмерный",
		Desc = "Маг пространства: притягивает, отталкивает, прыгает за спину и бьёт лучом. В пробуждении открывает территорию.",
		Color = rgb(92, 214, 255), Accent = rgb(170, 92, 255), Dark = rgb(20, 16, 48),
		M1Style = "palms",
		M1 = { Reach = 4.2 },
		Difficulty = "Средне",
		Moves = {
			{ Id = "Attract", Name = "Притяжение", Cooldown = 9, Desc = "Шар пустоты: стягивает врагов в одну точку.", AI = { range = 45, kind = "ranged" } },
			{ Id = "Repel", Name = "Отторжение", Cooldown = 9, Desc = "Взрыв пустоты перед собой: отбрасывает очень далеко.", AI = { range = 12, kind = "melee" } },
			{ Id = "Blink", Name = "Скачок", Cooldown = 7, Desc = "Мгновенно за спину ближайшего врага и удар ногой.", AI = { range = 40, kind = "gap" } },
			{ Id = "VoidBeam", Name = "Луч Пустоты", Cooldown = 15, Desc = "Заряд и огромный луч, пробивающий всё на пути.", AI = { range = 80, kind = "ranged" } },
		},
		Awakening = {
