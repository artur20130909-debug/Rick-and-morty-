-- перекраска под мутацию
local function tint(m, mut)
	local mu = Config.MutationIndex[mut or ""]
	if not mu then return end
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "Root" and not p:GetAttribute("NoTint") then
			p.Color = p.Color:Lerp(mu.color, 0.6)
			if mut == "gold" then p.Material = Enum.Material.Metal end
		end
	end
	if mut == "glitch" then m:SetAttribute("Glitch", true) end
	local root = m:FindFirstChild("Root")
	if root then
		local l = Instance.new("PointLight")
		l.Name = "MutationLight"
		l.Color = mu.color
		l.Range = 9
		l.Brightness = 1.2
		l.Shadows = false
		l.Parent = root
	end
end

-- собрать монстра в начале координат; потом ставить через model:PivotTo(cf)
function Monsters.build(key, mut)
	local def = Config.MonsterIndex[key] or Config.Monsters[1]
	local m = Instance.new("Model")
	m.Name = def.key
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 1, 2)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.Parent = m
	m.PrimaryPart = root
	local builder = B[def.key] or B.slipper
	builder(ctx(m, root))
	tint(m, mut)
	m:SetAttribute("Key", def.key)
	m:SetAttribute("Mutation", mut or "")
	m:SetAttribute("Rarity", def.rarity)
	m:SetAttribute("Size", def.size)
	local r = Config.RarityIndex[def.rarity]
	if r.tier >= 4 then
		local a = Instance.new("Attachment")
		a.Name = "AuraAtt"
		a.Position = Vector3.new(0, def.size * 0.5, 0)
		a.Parent = root
		local l = Instance.new("PointLight")
		l.Name = "Aura"
		l.Color = r.color
		l.Range = 10
		l.Brightness = 0.8
		l.Shadows = false
		l.Parent = a
	end
	return m, root
end

-- подпись над монстром. line2 — нижняя строка («+25/с» или «1 к 50»)
function Monsters.label(m, line2, maxDistance)
	local root = m.PrimaryPart
	local key, mut = m:GetAttribute("Key"), m:GetAttribute("Mutation")
	local def = Config.MonsterIndex[key]
	local r = Util.rarityOf(key)
	local old = root:FindFirstChild("Label")
	if old then old:Destroy() end
	local g = Instance.new("BillboardGui")
	g.Name = "Label"
	g.Size = UDim2.new(0, 230, 0, 66)
	g.StudsOffset = Vector3.new(0, (def and def.size or 4) + 1.6, 0)
	g.MaxDistance = maxDistance or 70
	g.LightInfluence = 0
	g.AlwaysOnTop = false
	g.Parent = root
	local function line(text, y, h, color)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, h)
		t.Position = UDim2.new(0, 0, 0, y)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.RichText = true
		t.Text = text
		t.TextColor3 = color
		t.TextStrokeTransparency = 0.2
		t.Parent = g
		return t
	end
	local mu = Config.MutationIndex[mut or ""]
	local name = def and def.name or key
	if mu then name = string.format('<font color="%s">%s</font> %s', Util.hex(mu.color), mu.name, name) end
	line(name, 0, 26, Color3.new(1, 1, 1))
	line(r.name, 26, 20, r.color)
	line(line2 or "", 46, 20, Color3.fromRGB(255, 230, 120))
	return g
end

return Monsters
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Удалённые события и функции. Сервер создаёт их (Net.init), клиент ждёт.
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local Net = {}
Net.Events = { "Action", "Toast", "Announce", "Fx" }
Net.Functions = { "GetShop" }

local folder = nil
local function getFolder()
	if folder then return folder end
	if RunService:IsServer() then
		folder = RS:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = RS
		end
	else
		folder = RS:WaitForChild("Remotes")
	end
	return folder
end

local function get(class, name)
	local f = getFolder()
	local r = f:FindFirstChild(name)
	if r then return r end
	if RunService:IsServer() then
		r = Instance.new(class)
		r.Name = name
		r.Parent = f
		return r
	end
	return f:WaitForChild(name)
end

function Net.event(name) return get("RemoteEvent", name) end
function Net.func(name) return get("RemoteFunction", name) end

-- сервер: создать всё сразу
function Net.init()
	for _, n in ipairs(Net.Events) do Net.event(n) end
	for _, n in ipairs(Net.Functions) do Net.func(n) end
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Общие расчёты для сервера и клиента: формат чисел и времени, ролл редкости и мутации,
-- доход монстра, цена продажи.
local Config = require(script.Parent.Config)

local Util = {}

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.2K", 15 -> "15"
function Util.num(n)
	n = tonumber(n) or 0
	local neg = n < 0
	if neg then n = -n end
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n = n / 1000
		i = i + 1
	end
	local s
	if i == 1 then
		s = tostring(math.floor(n + 0.5))
	elseif n < 10 then
		s = string.format("%.2f", math.floor(n * 100) / 100)
	elseif n < 100 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = tostring(math.floor(n))
	end
	if s:find(".", 1, true) then
		s = (s:gsub("(%..-)0+$", "%1"))
		s = (s:gsub("%.$", ""))
	end
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

-- 125 -> "2:05"
function Util.time(sec)
	sec = math.max(0, math.floor(tonumber(sec) or 0))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

-- редкость по удаче; maxTier — самая высокая разрешённая (днём ниже)
function Util.rollRarity(rng, luck, maxTier)
	luck = math.max(1, luck or 1)
	maxTier = maxTier or #Config.Rarities
	for i = math.min(maxTier, #Config.Rarities), 2, -1 do
		local r = Config.Rarities[i]
		if rng:NextNumber() < luck / r.chance then return r end
	end
	return Config.Rarities[1]
end

-- случайный монстр этой редкости
function Util.rollMonster(rng, rarityKey)
	local list = Config.MonstersByRarity[rarityKey] or Config.MonstersByRarity.common
	return list[rng:NextInteger(1, #list)]
end

-- мутация: opts = { event = "bloodmoon"|..., gold = множитель золотых, blood = true }
function Util.rollMutation(rng, opts)
	opts = opts or {}
	local glitch = Config.MutationIndex.glitch.chance
	if opts.event == "glitch" then glitch = glitch / Config.GlitchNightMul end
	if rng:NextNumber() < 1 / glitch then return "glitch" end
	if opts.blood or opts.event == "bloodmoon" then
		local bc = opts.blood and 1.5 or Config.BloodMutationChance
		if rng:NextNumber() < 1 / bc then return "blood" end
	end
	local gold = Config.MutationIndex.gold.chance / (opts.gold or 1)
	if rng:NextNumber() < 1 / gold then return "gold" end
	return ""
end

function Util.mutMul(mut)
	local m = Config.MutationIndex[mut or ""]
	return m and m.mul or 1
end

-- доход монстра в секунду (без геймпасса)
function Util.income(key, mut)
	local m = Config.MonsterIndex[key]
	if not m then return 0 end
	return m.income * Util.mutMul(mut)
end

function Util.sellPrice(key, mut)
	return Util.income(key, mut) * Config.SellMul
end

-- подпись «Золотой Кот 404»
function Util.fullName(key, mut)
	local m = Config.MonsterIndex[key]
	local name = m and m.name or key
	local mu = Config.MutationIndex[mut or ""]
	if mu then name = mu.name .. " " .. name end
	return name
end

function Util.rarityOf(key)
	local m = Config.MonsterIndex[key]
	return Config.RarityIndex[m and m.rarity or "common"]
end

-- цвет в hex для RichText
function Util.hex(c)
	return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

return Util
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX00000018"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000D"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Запуск сервера: строит карту, включает модули и встречает игроков.
-- Модули знают друг о друге через общую таблицу S (S.Data, S.Bases, S.Carry ...).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)
local Server = script.Parent:WaitForChild("Server")

Net.init()

local S = {}
S.Data = require(Server.Data)
S.Cycle = require(Server.Cycle)
S.Bases = require(Server.Bases)
S.Carry = require(Server.Carry)
S.Wild = require(Server.Wild)
S.Shop = require(Server.Shop)
S.Monetize = require(Server.Monetize)
S.Admin = require(Server.Admin)

local world = require(Server.World).build()
S.Data.init(S)
S.Cycle.init(S)
S.Bases.init(S, world.bases)
S.Carry.init(S)
S.Wild.init(S)
S.Shop.init(S, world.shop)
S.Monetize.init(S)
S.Admin.init(S)

local function toast(player, text, color) Net.event("Toast"):FireClient(player, text, color) end

-- действия игрока
Net.event("Action").OnServerEvent:Connect(function(player, kind, a, b)
	local ok, err = pcall(function()
		if kind == "buy" then S.Shop.buy(player, a, b)
		elseif kind == "useBait" then S.Wild.useBait(player, a)
		elseif kind == "admin" then S.Admin.run(player, a)
		end
	end)
	if not ok then warn("[CN] Action " .. tostring(kind) .. ": " .. tostring(err)) end
end)

local function onCharacter(player, char)
	task.spawn(function()
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		task.wait(0.1)
		local cf = S.Bases.spawnCF(player)
		if cf then char:PivotTo(cf) end
		S.Cycle.applyLight(char)
	end)
	S.Carry.onCharacter(player, char)
end

local function onPlayer(player)
	local p = S.Data.load(player)
	if not player.Parent then
		S.Data.release(player)
		return
	end
	S.Monetize.checkPasses(player)
	local rec = S.Bases.assign(player)
	if not rec then
		player:Kick("Все базы на этом сервере заняты — зайди на другой сервер")
		return
	end
	S.Data.sync(player)
	-- доход, пока игрока не было
	if p.last > 0 then
		local away = math.min(os.time() - p.last, Config.OfflineCapSeconds)
		local inc = S.Bases.incomeOf(player)
		local earned = math.floor(away * inc * Config.OfflineRate)
		if away > 60 and earned > 0 then
			S.Data.addFear(player, earned)
			task.delay(3, function()
				if player.Parent then Net.event("Fx"):FireClient(player, "offline", earned, away) end
			end)
		end
	end
	player.CharacterAdded:Connect(function(char) onCharacter(player, char) end)
	if player.Character then onCharacter(player, player.Character) end
	if p.isNew and Config.Wild.FirstCatchHelp then
		task.delay(4, function()
			if player.Parent then S.Wild.spawnHelper(player) end
		end)
	else
		task.delay(3, function()
			if player.Parent then toast(player, "С возвращением! Доход базы: +" .. Util.num(S.Bases.incomeOf(player)) .. " 💀/с", Color3.fromRGB(255, 230, 140)) end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, pl in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, pl) end

Players.PlayerRemoving:Connect(function(player)
	S.Carry.onLeave(player)
	S.Data.release(player)
	S.Bases.release(player)
end)

print("[CN] " .. Config.GameName .. " запущена")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000017"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Admin</string><ProtectedString name="Source"><![CDATA[-- Админ-команды для тестов и «админ-ивентов»: кнопки в админ-панели (Action "admin")
-- и команды в чате. Работают в Studio, у владельца игры и у UserId из Config.Admins.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Admin = {}
local S
local last = {} -- player -> { cmd, t } защита от двойного срабатывания

function Admin.isAdmin(player)
	if RunService:IsStudio() then return true end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then return true end
	return table.find(Config.Admins, player.UserId) ~= nil
end

local function spawnRarity(player, rarityKey)
	local list = Config.MonstersByRarity[rarityKey]
	if not list then return end
	local def = list[math.random(1, #list)]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local pos = hrp and (hrp.CFrame * CFrame.new(0, 0, -10)).Position or nil
	S.Wild.spawn({ pos = pos, key = def.key, mut = "" })
end

-- выполнить команду: "day", "night", "bloodmoon", "glitch", "fog", "spawn <редкость>", "fear <n>", "luck", "restock"
function Admin.run(player, text)
	if not Admin.isAdmin(player) or type(text) ~= "string" then return false end
	text = string.lower(text):gsub("^/", "")
	local cmd, arg = text:match("^(%S+)%s*(.*)$")
	if not cmd then return false end
	local l = last[player]
	if l and l.cmd == text and os.clock() - l.t < 0.5 then return true end
	last[player] = { cmd = text, t = os.clock() }
	if cmd == "day" then S.Cycle.force("day")
	elseif cmd == "night" then S.Cycle.force("night", arg ~= "" and arg or "")
	elseif cmd == "bloodmoon" or cmd == "glitch" or cmd == "fog" then S.Cycle.force("night", cmd)
	elseif cmd == "spawn" then spawnRarity(player, arg ~= "" and arg or "legendary")
	elseif cmd == "fear" then S.Data.addFear(player, tonumber(arg) or 10000)
	elseif cmd == "luck" then S.Cycle.addServerLuck(tonumber(arg) or Config.Products.ServerLuck.minutes, player.DisplayName)
	elseif cmd == "restock" then S.Shop.restock()
	else return false end
	Net.event("Toast"):FireClient(player, "Админ: " .. text, Color3.fromRGB(150, 200, 255))
	return true
end

function Admin.init(s)
	S = s
	local function hook(player)
		player:SetAttribute("IsAdmin", Admin.isAdmin(player))
		player.Chatted:Connect(function(msg)
			if string.sub(msg, 1, 1) == "/" then Admin.run(player, msg) end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, pl in ipairs(Players:GetPlayers()) do hook(pl) end
	Players.PlayerRemoving:Connect(function(pl) last[pl] = nil end)
end

return Admin
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Bases</string><ProtectedString name="Source"><![CDATA[-- Базы игроков: выдача базы, монстры в клетках, доход каждую секунду, замок двери,
-- кража из чужой клетки, продажа, покупка клетки (через Shop).
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)
local Monsters = require(Shared.Monsters)

local Bases = {}
local S
local list = {}
local byPlayer = {}
local HALF = Config.Map.BaseSize / 2

local function toast(player, text, color) Net.event("Toast"):FireClient(player, text, color) end
local function fx(player, ...) Net.event("Fx"):FireClient(player, ...) end

local function alive(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then return hrp end
	return nil
end

function Bases.baseOf(player) return byPlayer[player] end
function Bases.all() return list end

-- точка внутри базы?
function Bases.inBase(rec, pos)
	local p = rec.cf:PointToObjectSpace(pos)
	return math.abs(p.X) <= HALF and math.abs(p.Z) <= HALF and p.Y < 40
end

-- база, в которой стоит точка (или nil)
function Bases.at(pos)
	for _, rec in ipairs(list) do
		if Bases.inBase(rec, pos) then return rec end
	end
	return nil
end

function Bases.spawnCF(player)
	local rec = byPlayer[player]
	if not rec then return nil end
	return rec.model.Spawn.CFrame
end

function Bases.incomeOf(player)
	local p = S.Data.get(player)
	if not p then return 0 end
	local sum = 0
	for _, e in pairs(p.slots) do sum = sum + Util.income(e.k, e.m) end
	if player:GetAttribute("PassDoubleFear") then sum = sum * 2 end
	return sum
end

---------------------------------------------------------------- клетки
local function slotModel(rec, s) return rec.model.Slots:FindFirstChild("Slot_" .. s) end

local function setBars(sm, visible)
	for _, b in ipairs(sm.Bars:GetChildren()) do
		b.Transparency = visible and 0 or 0.85
	end
end

-- обновить вид и подсказки клетки
function Bases.refreshSlot(rec, s)
	local sm = slotModel(rec, s)
	if not sm then return end
	local owner = rec.owner
	local p = owner and S.Data.get(owner)
	local open = p ~= nil and s <= p.cages
	local entry = p and open and p.slots[s] or nil
	local nextBuy = p ~= nil and s == p.cages + 1 and s <= S.Data.maxCages(owner)
	local pad = sm.Pad
	local att = pad.PromptAtt

	setBars(sm, open)
	if entry then
		sm.Rim.Color = Util.rarityOf(entry.k).color
	elseif open then
		sm.Rim.Color = Color3.fromRGB(85, 85, 92)
	else
		sm.Rim.Color = Color3.fromRGB(30, 30, 34)
	end

	-- монстр
	local cur = rec.monsters[s]
	if cur and (not entry or cur:GetAttribute("Key") ~= entry.k or cur:GetAttribute("Mutation") ~= entry.m) then
		cur:Destroy()
		cur = nil
		rec.monsters[s] = nil
	end
	if entry and not cur then
		local m = Monsters.build(entry.k, entry.m)
		m.Name = "Monster"
		m:PivotTo(sm.Anchor.CFrame)
		local inc = Util.income(entry.k, entry.m)
		if owner:GetAttribute("PassDoubleFear") then inc = inc * 2 end
		Monsters.label(m, "+" .. Util.num(inc) .. " 💀/с", 45)
		m.Parent = sm
		CollectionService:AddTag(m, "CageMonster")
		rec.monsters[s] = m
	end

	-- подсказки
	local locked = rec.model:GetAttribute("Locked")
	att.StealPrompt.Enabled = entry ~= nil and not locked
	att.StealPrompt.ObjectText = entry and Util.fullName(entry.k, entry.m) or ""
	att.SellPrompt.Enabled = entry ~= nil
	att.SellPrompt.ObjectText = entry and ("+" .. Util.num(Util.sellPrice(entry.k, entry.m)) .. " 💀") or ""
	att.BuyPrompt.Enabled = nextBuy
	local price = Config.CagePrices[s] or 0
	att.BuyPrompt.ObjectText = Util.num(price) .. " 💀"
	pad.LockedGui.Enabled = nextBuy
	pad.LockedGui.Text.Text = "🔒 " .. Util.num(price) .. " 💀"
end

function Bases.refreshAll(rec)
	for s = 1, #rec.slots do Bases.refreshSlot(rec, s) end
end

-- force — пересоздать модели монстров (например, после геймпасса ×2 меняются подписи)
function Bases.refreshPlayer(player, force)
	local rec = byPlayer[player]
	if not rec then return end
	if force then
		for s, m in pairs(rec.monsters) do
			m:Destroy()
			rec.monsters[s] = nil
		end
	end
	Bases.refreshAll(rec)
end

-- первая свободная открытая клетка
function Bases.freeSlot(player)
	local p = S.Data.get(player)
	if not p then return nil end
	for s = 1, p.cages do
		if not p.slots[s] then return s end
	end
	return nil
end

-- положить монстра в клетку; номер клетки или nil
function Bases.place(player, entry)
	local rec = byPlayer[player]
	local p = S.Data.get(player)
	local s = Bases.freeSlot(player)
	if not rec or not p or not s then return nil end
	p.slots[s] = { k = entry.k, m = entry.m or "" }
	Bases.refreshSlot(rec, s)
	return s
end

---------------------------------------------------------------- владельцы
local function setOwnerVisuals(rec)
	local m = rec.model
	local owner = rec.owner
	m:SetAttribute("OwnerId", owner and owner.UserId or 0)
	m:SetAttribute("OwnerName", owner and owner.DisplayName or "")
	m.SignBoard.Sign.OwnerText.Text = owner and ("База " .. owner.DisplayName) or "Свободная база"
	m.Top.OwnerGui.NameText.Text = owner and owner.DisplayName or ""
	m.Top.OwnerGui.Income.Text = ""
end

function Bases.assign(player)
	if byPlayer[player] then return byPlayer[player] end
	for _, rec in ipairs(list) do
		if not rec.owner then
			rec.owner = player
			byPlayer[player] = rec
			player:SetAttribute("BaseIndex", rec.index)
			setOwnerVisuals(rec)
			Bases.refreshAll(rec)
			return rec
		end
	end
	return nil
end

function Bases.release(player)
	local rec = byPlayer[player]
	if not rec then return end
	byPlayer[player] = nil
	rec.owner = nil
	for s, m in pairs(rec.monsters) do
		m:Destroy()
		rec.monsters[s] = nil
	end
	Bases.unlock(rec)
	setOwnerVisuals(rec)
	Bases.refreshAll(rec)
end

---------------------------------------------------------------- замок
function Bases.lock(rec)
	local m = rec.model
	if m:GetAttribute("Locked") then return false end
	m:SetAttribute("Locked", true)
	m:SetAttribute("LockEnds", S.Cycle.now() + Config.LockSeconds)
	m.Door.Transparency = 0.35
	m.Door.CanCollide = true
	m.Door.LockGui.Enabled = true
	m.LockPad.Color = Color3.fromRGB(255, 60, 70)
	Bases.refreshAll(rec)
	return true
end

function Bases.unlock(rec)
	local m = rec.model
	m:SetAttribute("Locked", false)
	m:SetAttribute("LockEnds", 0)
	m.Door.Transparency = 1
	m.Door.CanCollide = false
	m.Door.LockGui.Enabled = false
	m.LockPad.Color = Color3.fromRGB(60, 255, 106)
	if rec.owner then Bases.refreshAll(rec) end
end

---------------------------------------------------------------- действия у клеток
local function near(player, part, dist)
	local hrp = alive(player)
	return hrp ~= nil and (hrp.Position - part.Position).Magnitude <= dist
end

function Bases.steal(thief, rec, s)
	local owner = rec.owner
	if not owner or owner == thief then return end
	if rec.model:GetAttribute("Locked") then
		toast(thief, "База заперта!", Color3.fromRGB(255, 90, 90))
		return
	end
	if S.Carry.get(thief) then
		toast(thief, "Руки заняты — сначала отнеси монстра на базу", Color3.fromRGB(255, 200, 90))
		return
	end
	local sm = slotModel(rec, s)
	if not sm or not near(thief, sm.Pad, 16) then return end
	local p = S.Data.get(owner)
	local entry = p and p.slots[s]
	if not entry then return end
	p.slots[s] = nil
	Bases.refreshSlot(rec, s)
	local ok = S.Carry.start(thief, { k = entry.k, m = entry.m }, { from = "steal", ownerId = owner.UserId, ownerName = owner.DisplayName })
	if not ok then
		p.slots[s] = entry
		Bases.refreshSlot(rec, s)
		return
	end
	local name = Util.fullName(entry.k, entry.m)
	fx(owner, "stolen", name, thief.DisplayName)
	toast(thief, "Утащил " .. name .. "! Беги на свою базу!", Color3.fromRGB(255, 220, 90))
end

function Bases.sell(player, rec, s)
	if rec.owner ~= player then return end
	local p = S.Data.get(player)
	local entry = p and p.slots[s]
	if not entry then return end
	local sm = slotModel(rec, s)
	if not sm or not near(player, sm.Pad, 16) then return end
	local price = Util.sellPrice(entry.k, entry.m)
	p.slots[s] = nil
	S.Data.addFear(player, price)
	Bases.refreshSlot(rec, s)
	fx(player, "cash", price)
	toast(player, "Продано: " .. Util.fullName(entry.k, entry.m) .. " за " .. Util.num(price) .. " 💀", Color3.fromRGB(255, 220, 90))
end

---------------------------------------------------------------- запуск
function Bases.init(s, models)
	S = s
	for i, m in ipairs(models) do
		local floor = m.Floor
		local rec = {
			index = i, model = m, owner = nil, monsters = {}, slots = {},
			cf = CFrame.new(floor.Position.X, 0, floor.Position.Z) * floor.CFrame.Rotation,
		}
		for _, sm in ipairs(m.Slots:GetChildren()) do
			rec.slots[sm:GetAttribute("Slot")] = sm
		end
		list[i] = rec
		m.LockPad.Attachment.LockPrompt.Triggered:Connect(function(player)
			if rec.owner ~= player then return end
			if Bases.lock(rec) then
				toast(player, "🔒 База заперта на " .. Config.LockSeconds .. " секунд", Color3.fromRGB(120, 255, 140))
			else
				toast(player, "База уже заперта", Color3.fromRGB(255, 200, 90))
			end
		end)
		for idx, sm in pairs(rec.slots) do
			local att = sm.Pad.PromptAtt
			att.StealPrompt.Triggered:Connect(function(player) Bases.steal(player, rec, idx) end)
			att.SellPrompt.Triggered:Connect(function(player) Bases.sell(player, rec, idx) end)
			att.BuyPrompt.Triggered:Connect(function(player)
				if rec.owner == player then S.Shop.buyCage(player) end
			end)
		end
	end

	-- доход каждую секунду и снятие замков
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				local t = S.Cycle.now()
				for _, rec in ipairs(list) do
					local m = rec.model
					if m:GetAttribute("Locked") and (m:GetAttribute("LockEnds") or 0) <= t then Bases.unlock(rec) end
					local owner = rec.owner
					if owner and owner.Parent then
						local inc = Bases.incomeOf(owner)
						if inc > 0 then S.Data.addFear(owner, inc) end
						owner:SetAttribute("Income", inc)
						m:SetAttribute("Income", inc)
						m.Top.OwnerGui.Income.Text = "+" .. Util.num(inc) .. " 💀/с"
					end
				end
			end)
			if not ok then warn("[CN] Bases: " .. tostring(err)) end
		end
	end)
end

return Bases
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Carry</string><ProtectedString name="Source"><![CDATA[-- Переноска монстра на голове: пойманного в лесу или украденного с чужой базы.
-- Пока несёшь — идёшь медленнее, и любой может «Отобрать» монстра (подсказка на твоём персонаже).
-- Дошёл до своей базы — монстр сам садится в свободную клетку.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)
local Monsters = require(Shared.Monsters)

local Carry = {}
local S
local carrying = {}   -- player -> { entry = {k,m}, info = {...}, model }
local stunUntil = {}  -- player -> время
local fullWarn = {}   -- player -> время последнего «нет мест»
local WALK = 16

local function toast(player, text, color) Net.event("Toast"):FireClient(player, text, color) end
local function fx(player, ...) Net.event("Fx"):FireClient(player, ...) end
local function now() return S.Cycle.now() end

local function parts(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if hum and hrp and head and hum.Health > 0 then return hum, hrp, head end
	return nil
end

function Carry.get(player) return carrying[player] end

-- скорость: оглушён -> 0, с монстром -> медленнее
function Carry.updateSpeed(player)
	local hum = parts(player)
	if not hum then return end
	if (stunUntil[player] or 0) > now() then
		hum.WalkSpeed = 0
		return
	end
	local st = carrying[player]
	if st then
		local tier = Util.rarityOf(st.entry.k).tier
		hum.WalkSpeed = tier >= 4 and Config.CarryRareSpeed or Config.CarrySpeed
	else
		hum.WalkSpeed = WALK
	end
end

function Carry.stun(player, seconds)
	stunUntil[player] = now() + seconds
	Carry.updateSpeed(player)
	task.delay(seconds + 0.05, function()
		if player.Parent then Carry.updateSpeed(player) end
	end)
end

local function setPrompt(player, on)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local p = hrp and hrp:FindFirstChild("TacklePrompt")
	if p then p.Enabled = on end
end

-- начать нести; false, если персонажа нет
function Carry.start(player, entry, info)
	if carrying[player] then return false end
	local hum, _, head = parts(player)
	if not hum then return false end
	local m, root = Monsters.build(entry.k, entry.m)
	m.Name = "Carried_" .. player.Name
	Monsters.label(m, "🎒 " .. player.DisplayName, 80)
	m:PivotTo(head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.3, 0))
	m:SetAttribute("CarrierId", player.UserId)
	m.Parent = workspace.Carried
	root.Anchored = false
	local w = Instance.new("WeldConstraint")
	w.Part0 = head
	w.Part1 = root
	w.Parent = root
	carrying[player] = { entry = { k = entry.k, m = entry.m or "" }, info = info or {}, model = m, since = now() }
	player:SetAttribute("Carrying", Util.fullName(entry.k, entry.m))
	player:SetAttribute("CarryRarity", Util.rarityOf(entry.k).key)
	setPrompt(player, true)
	Carry.updateSpeed(player)
	fx(player, "carry", Util.fullName(entry.k, entry.m))
	return true
end

-- перестать нести (монстр исчезает); вернуть состояние
local function stop(player)
	local st = carrying[player]
	if not st then return nil end
	carrying[player] = nil
	if st.model then st.model:Destroy() end
	if player.Parent then
		player:SetAttribute("Carrying", "")
		player:SetAttribute("CarryRarity", "")
		setPrompt(player, false)
		Carry.updateSpeed(player)
	end
	return st
end

-- уронить: mode = "wild" (монстр убегает в лес рядом) или "leave" (игрок вышел/умер)
function Carry.drop(player, mode, pos)
	local st = carrying[player]
	if not st then return end
	if not pos then
		local root = st.model and st.model.PrimaryPart
		pos = root and root.Position or nil
	end
	stop(player)
	-- украденный монстр при выходе вора возвращается хозяину, если тот на сервере
	if mode == "leave" and st.info.from == "steal" then
		local owner = Players:GetPlayerByUserId(st.info.ownerId or 0)
		if owner and owner ~= player and S.Bases.place(owner, st.entry) then
			toast(owner, Util.fullName(st.entry.k, st.entry.m) .. " вернулся к тебе!", Color3.fromRGB(120, 255, 140))
			return
		end
	end
	if pos and S.Wild then
		S.Wild.spawn({ pos = Vector3.new(pos.X, 0, pos.Z), key = st.entry.k, mut = st.entry.m, fromDrop = true })
	end
end

-- отнести на свою базу
local function deliver(player, st)
	local slot = S.Bases.place(player, st.entry)
	if not slot then
		if (fullWarn[player] or 0) < now() then
			fullWarn[player] = now() + 4
			toast(player, "Нет свободных клеток! Продай монстра или купи клетку", Color3.fromRGB(255, 120, 90))
		end
		return
	end
	stop(player)
	local name = Util.fullName(st.entry.k, st.entry.m)
	local r = Util.rarityOf(st.entry.k)
	local p = S.Data.get(player)
	local info = st.info
	if info.from == "steal" and info.ownerId ~= player.UserId then
		if r.tier >= Config.StealAnnounceTier then
			S.Cycle.announce(string.format("🦹 %s украл %s у %s!", player.DisplayName, name, info.ownerName or "?"), r.color)
		end
		toast(player, "Украдено: " .. name .. "!", r.color)
	elseif info.from == "steal" then
		toast(player, "Вернул своего: " .. name, Color3.fromRGB(120, 255, 140))
	else
		if p then
			p.caught = p.caught + 1
			S.Data.sync(player)
		end
		if r.tier >= Config.AnnounceTier then
			S.Cycle.announce(string.format("🔥 %s поймал: %s (%s, 1 к %s)!", player.DisplayName, name, r.name, Util.num(r.chance)), r.color)
		end
	end
	fx(player, "delivered", name, r.key)
end

-- отобрать монстра у игрока
local function tackle(thief, victim)
	if thief == victim then return end
	local st = carrying[victim]
	if not st or carrying[thief] then return end
	if (st.immune or 0) > now() then
		toast(thief, "Не вышло — попробуй ещё раз через секунду", Color3.fromRGB(255, 200, 90))
		return
	end
	local _, hrpT = parts(thief)
	local _, hrpV = parts(victim)
	if not hrpT or not hrpV or (hrpT.Position - hrpV.Position).Magnitude > 14 then return end
	stop(victim)
	local info = st.info
	if info.from ~= "steal" then
		-- пойманный в лесу становится «украденным» у того, кто его поймал
		info = { from = "steal", ownerId = victim.UserId, ownerName = victim.DisplayName }
	end
	if Carry.start(thief, st.entry, info) then
		carrying[thief].immune = now() + Config.TackleImmunity
		Carry.stun(victim, 1)
		local name = Util.fullName(st.entry.k, st.entry.m)
		fx(victim, "tackled", name, thief.DisplayName)
		toast(thief, "Отобрал " .. name .. "! Беги на базу!", Color3.fromRGB(255, 220, 90))
	else
		Carry.drop(victim, "wild", hrpV.Position)
	end
end

-- новый персонаж: подсказка «Отобрать» и смерть
function Carry.onCharacter(player, char)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hrp or not hum then return end
	local p = Instance.new("ProximityPrompt")
	p.Name = "TacklePrompt"
	p.ActionText = "Отобрать"
	p.ObjectText = player.DisplayName
	p.HoldDuration = Config.TackleHold
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.F
	p.Enabled = false
	p:SetAttribute("For", "notself")
	p:SetAttribute("UserId", player.UserId)
	p.Parent = hrp
	p.Triggered:Connect(function(thief) tackle(thief, player) end)
	hum.Died:Connect(function()
		Carry.drop(player, "leave", hrp.Position)
	end)
	stunUntil[player] = nil
	Carry.updateSpeed(player)
end

function Carry.onLeave(player)
	Carry.drop(player, "leave")
	stunUntil[player] = nil
	fullWarn[player] = nil
end

function Carry.init(s)
	S = s
	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				for player, st in pairs(carrying) do
					local _, hrp = parts(player)
					if not hrp or not st.model.Parent then
						Carry.drop(player, "leave")
					else
						local rec = S.Bases.baseOf(player)
						if rec and S.Bases.inBase(rec, hrp.Position) then deliver(player, st) end
					end
				end
			end)
			if not ok then warn("[CN] Carry: " .. tostring(err)) end
		end
	end)
end

return Carry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Cycle</string><ProtectedString name="Source"><![CDATA[-- Смена дня и ночи, события ночи (Кровавая луна, Глитч-ночь, Туман), удача сервера.
-- Состояние лежит в атрибутах ReplicatedStorage.State: Phase, PhaseEnds, Night, Event, ServerLuck, LuckEnds.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Cycle = {}
local S
local state
local forced = nil -- { phase = "day"|"night", event = key|nil }
local rng = Random.new()

local function now() return workspace:GetServerTimeNow() end

function Cycle.announce(text, color)
	Net.event("Announce"):FireAllClients(text, color)
end

function Cycle.isNight() return state:GetAttribute("Phase") == "night" end
function Cycle.event() return state:GetAttribute("Event") or "" end

-- удача: событие ночи × удача сервера (товар за Robux)
function Cycle.luck()
	local l = 1
	local e = Config.EventIndex[Cycle.event()]
	if e and Cycle.isNight() then l = l * e.luck end
	if (state:GetAttribute("LuckEnds") or 0) > now() then l = l * (state:GetAttribute("ServerLuck") or 1) end
	return l
end

function Cycle.addServerLuck(minutes, who)
	local t = math.max(now(), state:GetAttribute("LuckEnds") or 0) + minutes * 60
	state:SetAttribute("LuckEnds", t)
	state:SetAttribute("ServerLuck", 2)
	Cycle.announce(string.format("🍀 %s включил УДАЧУ ×2 для всего сервера на %d мин!", who, minutes), Color3.fromRGB(110, 255, 120))
end

-- фонарик на голове ночью
function Cycle.applyLight(char)
	local head = char and char:FindFirstChild("Head")
	if not head then return end
	local l = head:FindFirstChild("NightLight")
	if Cycle.isNight() then
		if not l then
			l = Instance.new("PointLight")
			l.Name = "NightLight"
			l.Range = 22
			l.Brightness = 1.1
			l.Color = Color3.fromRGB(190, 210, 255)
			l.Shadows = false
			l.Parent = head
		end
	elseif l then
		l:Destroy()
	end
end

local function lightsAll()
	for _, pl in ipairs(Players:GetPlayers()) do Cycle.applyLight(pl.Character) end
end

local function rollEvent()
	local x = rng:NextNumber(0, 100)
	local acc = 0
	for _, e in ipairs(Config.Events) do
		acc = acc + e.weight
		if x < acc then return e.key end
	end
	return ""
end

local function startDay()
	state:SetAttribute("Phase", "day")
	state:SetAttribute("Event", "")
	state:SetAttribute("PhaseEnds", now() + Config.DaySeconds)
	Cycle.announce("☀ Наступил день. Редкие монстры спрятались — время строить базу!", Color3.fromRGB(255, 230, 140))
	if S.Wild then S.Wild.onDay() end
	lightsAll()
end

local function startNight(event)
	local n = (state:GetAttribute("Night") or 0) + 1
	state:SetAttribute("Night", n)
	event = event or rollEvent()
	state:SetAttribute("Phase", "night")
	state:SetAttribute("Event", event)
	state:SetAttribute("PhaseEnds", now() + Config.NightSeconds)
	local e = Config.EventIndex[event]
	if e then
		Cycle.announce(string.format("🌙 НОЧЬ %d — %s: %s!", n, e.name, e.text), e.color)
	else
		Cycle.announce(string.format("🌙 НОЧЬ %d. Кошмары вышли на охоту...", n), Color3.fromRGB(150, 170, 255))
	end
	if S.Wild then S.Wild.onNight() end
	lightsAll()
end

-- админ: сразу переключить фазу
function Cycle.force(phase, event)
	forced = { phase = phase, event = event }
end

function Cycle.init(s)
	S = s
	state = RS:FindFirstChild("State")
	if not state then
		state = Instance.new("Folder")
		state.Name = "State"
		state.Parent = RS
	end
	state:SetAttribute("Night", 0)
	state:SetAttribute("ServerLuck", 1)
	state:SetAttribute("LuckEnds", 0)
	startDay()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				if forced then
					local f = forced
					forced = nil
					if f.phase == "night" then startNight(f.event) else startDay() end
				elseif now() >= (state:GetAttribute("PhaseEnds") or 0) then
					if Cycle.isNight() then startDay() else startNight() end
				end
				if (state:GetAttribute("ServerLuck") or 1) ~= 1 and (state:GetAttribute("LuckEnds") or 0) <= now() then
					state:SetAttribute("ServerLuck", 1)
					Cycle.announce("🍀 Удача сервера закончилась", Color3.fromRGB(200, 200, 200))
				end
			end)
			if not ok then warn("[CN] Cycle: " .. tostring(err)) end
		end
	end)
end

Cycle.now = now
return Cycle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Прогресс игроков: загрузка и сохранение в DataStore, атрибуты игрока для интерфейса и таблица лидеров.
-- В неопубликованном Studio DataStore недоступен — игра работает, просто ничего не сохраняет.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS:WaitForChild("Shared").Config)

local Data = {}
local S
local store = nil
local profiles = {}

local function defaults()
	local baits = {}
	for _, b in ipairs(Config.Baits) do baits[b.key] = 0 end
	return { v = 1, fear = Config.StartFear, net = 1, cages = Config.StartCages, slots = {}, baits = baits, caught = 0, last = 0 }
end

-- из сохранения в рабочий вид: slots — массив {s,k,m} -> таблица slot -> {k,m}
local function fromSaved(saved)
	local p = defaults()
	if type(saved) ~= "table" then return p end
	p.fear = tonumber(saved.fear) or p.fear
	p.net = math.clamp(tonumber(saved.net) or 1, 1, #Config.Nets)
	p.cages = math.clamp(tonumber(saved.cages) or p.cages, Config.StartCages, Config.MaxCages + Config.PassCages)
	p.caught = tonumber(saved.caught) or 0
	p.last = tonumber(saved.last) or 0
	if type(saved.baits) == "table" then
		for k in pairs(p.baits) do p.baits[k] = math.max(0, math.floor(tonumber(saved.baits[k]) or 0)) end
	end
	if type(saved.slots) == "table" then
		for _, e in ipairs(saved.slots) do
			if type(e) == "table" and Config.MonsterIndex[e.k] and tonumber(e.s) then
				p.slots[math.floor(e.s)] = { k = e.k, m = e.m or "" }
			end
		end
	end
	return p
end

local function toSaved(p)
	local slots = {}
	for s, e in pairs(p.slots) do table.insert(slots, { s = s, k = e.k, m = e.m }) end
	table.sort(slots, function(a, b) return a.s < b.s end)
	return { v = 1, fear = math.floor(p.fear), net = p.net, cages = p.cages, slots = slots, baits = p.baits, caught = p.caught, last = os.time() }
end

local function key(player) return "u_" .. player.UserId end

function Data.init(s)
	S = s
	local ok, res = pcall(function() return DataStoreService:GetDataStore(Config.DataStoreName) end)
	if ok then store = res else warn("[CN] DataStore недоступен, прогресс не сохраняется: " .. tostring(res)) end
	-- автосохранение
	task.spawn(function()
		while true do
			task.wait(90)
			for _, pl in ipairs(Players:GetPlayers()) do
				task.spawn(Data.save, pl)
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then return end
		for _, pl in ipairs(Players:GetPlayers()) do task.spawn(Data.save, pl) end
		task.wait(2)
	end)
end

-- загрузка (уступает поток); возвращает профиль
function Data.load(player)
	local saved, failed = nil, false
	if store then
		failed = true
		for attempt = 1, 3 do
			local ok, res = pcall(function() return store:GetAsync(key(player)) end)
			if ok then
				saved, failed = res, false
				break
			end
			warn("[CN] загрузка не удалась (" .. attempt .. "): " .. tostring(res))
			task.wait(1.5)
		end
	end
	local p = fromSaved(saved)
	p.isNew = saved == nil and not failed
	p.noSave = failed -- чтобы не затереть настоящие данные пустыми
	profiles[player] = p
	-- таблица лидеров
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local fear = Instance.new("IntValue")
	fear.Name = "💀 Страх"
	fear.Parent = ls
	local caught = Instance.new("IntValue")
	caught.Name = "👻 Поймано"
	caught.Parent = ls
	ls.Parent = player
	Data.sync(player)
	return p
end

function Data.get(player) return profiles[player] end

function Data.save(player)
	local p = profiles[player]
	if not p or p.noSave or not store then return end
	local payload = toSaved(p)
	local ok, err = pcall(function() store:SetAsync(key(player), payload) end)
	if not ok then warn("[CN] сохранение не удалось: " .. tostring(err)) end
end

function Data.release(player)
	Data.save(player)
	profiles[player] = nil
end

-- максимум клеток с учётом геймпасса
function Data.maxCages(player)
	return Config.MaxCages + (player:GetAttribute("PassExtraCages") and Config.PassCages or 0)
end

-- атрибуты игрока для клиента
function Data.sync(player)
	local p = profiles[player]
	if not p then return end
	player:SetAttribute("Fear", math.floor(p.fear))
	player:SetAttribute("Net", p.net)
	player:SetAttribute("Cages", p.cages)
	player:SetAttribute("MaxCages", Data.maxCages(player))
	player:SetAttribute("Caught", p.caught)
	for k, n in pairs(p.baits) do player:SetAttribute("Bait_" .. k, n) end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local f = ls:FindFirstChild("💀 Страх")
		if f then f.Value = math.floor(p.fear) end
		local c = ls:FindFirstChild("👻 Поймано")
		if c then c.Value = p.caught end
	end
end

function Data.addFear(player, n)
	local p = profiles[player]
	if not p then return end
	p.fear = p.fear + n
	local v = math.floor(p.fear)
	player:SetAttribute("Fear", v)
	local ls = player:FindFirstChild("leaderstats")
	local f = ls and ls:FindFirstChild("💀 Страх")
	if f then f.Value = v end
end

-- списать; false, если не хватает
function Data.spend(player, n)
	local p = profiles[player]
	if not p or p.fear < n then return false end
	Data.addFear(player, -n)
	return true
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Monetize</string><ProtectedString name="Source"><![CDATA[-- Покупки за Robux: товар «Удача ×2 для всего сервера» и геймпассы (×2 Страха, +2 клетки).
-- ID задаются в Config.Products / Config.Passes; 0 — товар выключен.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)

local Monetize = {}
local S
local granted = {} -- PurchaseId -> true (чтобы не выдать дважды)

local function applyPass(player, name)
	player:SetAttribute("Pass" .. name, true)
	if name == "ExtraCages" then
		S.Data.sync(player)
		S.Bases.refreshPlayer(player)
	elseif name == "DoubleFear" then
		S.Bases.refreshPlayer(player, true)
	end
end

function Monetize.checkPasses(player)
	for name, p in pairs(Config.Passes) do
		if p.id and p.id ~= 0 then
			local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, p.id) end)
			if ok and owns then applyPass(player, name) end
		end
	end
end

function Monetize.init(s)
	S = s
	MarketplaceService.ProcessReceipt = function(info)
		if granted[info.PurchaseId] then return Enum.ProductPurchaseDecision.PurchaseGranted end
		local player = Players:GetPlayerByUserId(info.PlayerId)
		if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local luck = Config.Products.ServerLuck
		if luck.id ~= 0 and info.ProductId == luck.id then
			S.Cycle.addServerLuck(luck.minutes, player.DisplayName)
			granted[info.PurchaseId] = true
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then return end
		for name, p in pairs(Config.Passes) do
			if p.id ~= 0 and p.id == passId then applyPass(player, name) end
		end
	end)
end

return Monetize
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Лавка Ловца: сети (навсегда), приманки (запас обновляется каждые Config.RestockSeconds),
-- клетки. Запас общий на сервер, но каждый игрок может купить до «запаса» штук сам.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local Shop = {}
local S
local stock = {}
local restockId = 0
local bought = {} -- player -> { id = restockId, [key] = n }
local rng = Random.new()

local function toast(player, text, color) Net.event("Toast"):FireClient(player, text, color) end
local RED = Color3.fromRGB(255, 110, 90)
local GOLD = Color3.fromRGB(255, 220, 90)

local function restock()
	restockId = restockId + 1
	for _, b in ipairs(Config.Baits) do
		if rng:NextNumber() < b.inStock then stock[b.key] = rng:NextInteger(b.min, b.max) else stock[b.key] = 0 end
	end
	local state = RS:FindFirstChild("State")
	if state then state:SetAttribute("RestockAt", S.Cycle.now() + Config.RestockSeconds) end
	for _, b in ipairs(Config.Baits) do
		if b.inStock < 0.5 and stock[b.key] > 0 then
			S.Cycle.announce(string.format("🛒 В Лавке Ловца появилась %s %s!", b.icon, b.name), GOLD)
		end
	end
end
Shop.restock = restock

local function boughtOf(player)
	local t = bought[player]
	if not t or t.id ~= restockId then
		t = { id = restockId }
		bought[player] = t
	end
	return t
end

local function left(player, key)
	return math.max(0, (stock[key] or 0) - (boughtOf(player)[key] or 0))
end

function Shop.info(player)
	local p = S.Data.get(player)
	local l = {}
	for _, b in ipairs(Config.Baits) do l[b.key] = left(player, b.key) end
	return {
		stock = stock, left = l, restockAt = RS.State:GetAttribute("RestockAt"),
		net = p and p.net or 1, cages = p and p.cages or 0, maxCages = S.Data.maxCages(player),
	}
end

function Shop.buyCage(player)
	local p = S.Data.get(player)
	if not p then return end
	local n = p.cages + 1
	if n > S.Data.maxCages(player) then
		toast(player, "Больше клеток нет (геймпасс даёт ещё " .. Config.PassCages .. ")", RED)
		return
	end
	local price = Config.CagePrices[n] or math.huge
	if not S.Data.spend(player, price) then
		toast(player, "Не хватает Страха: нужно " .. Util.num(price) .. " 💀", RED)
		return
	end
	p.cages = n
	S.Data.sync(player)
	S.Bases.refreshPlayer(player)
	Net.event("Fx"):FireClient(player, "cash", -price)
	toast(player, "Новая клетка! Теперь их " .. n, GOLD)
end

local function buyNet(player)
	local p = S.Data.get(player)
	if not p then return end
	local def = Config.Nets[p.net + 1]
	if not def then
		toast(player, "У тебя лучшая сеть!", GOLD)
		return
	end
	if not S.Data.spend(player, def.price) then
		toast(player, "Не хватает Страха: нужно " .. Util.num(def.price) .. " 💀", RED)
		return
	end
	p.net = def.level
	S.Data.sync(player)
	Net.event("Fx"):FireClient(player, "cash", -def.price)
	toast(player, "🕸 " .. def.name .. "! Теперь ловишь монстров сети " .. def.level, GOLD)
end

local function buyBait(player, key)
	local def = Config.BaitIndex[key]
	local p = S.Data.get(player)
	if not def or not p then return end
	if left(player, key) <= 0 then
		toast(player, "Закончилось! Жди обновления лавки", RED)
		return
	end
	if not S.Data.spend(player, def.price) then
		toast(player, "Не хватает Страха: нужно " .. Util.num(def.price) .. " 💀", RED)
		return
	end
	local t = boughtOf(player)
	t[key] = (t[key] or 0) + 1
	p.baits[key] = (p.baits[key] or 0) + 1
	S.Data.sync(player)
	Net.event("Fx"):FireClient(player, "cash", -def.price)
	toast(player, def.icon .. " Куплено: " .. def.name, GOLD)
end

function Shop.buy(player, what, key)
	if what == "net" then buyNet(player)
	elseif what == "bait" then buyBait(player, key)
	elseif what == "cage" then Shop.buyCage(player)
	end
end

function Shop.init(s, shopCounter)
	S = s
	restock()
	Net.func("GetShop").OnServerInvoke = function(player) return Shop.info(player) end
	local prompt = shopCounter:FindFirstChild("ShopPrompt", true)
	if prompt then
		prompt.Triggered:Connect(function(player) Net.event("Fx"):FireClient(player, "openShop") end)
	end
	task.spawn(function()
		while true do
			task.wait(1)
			local at = RS.State:GetAttribute("RestockAt") or 0
			if S.Cycle.now() >= at then
				local ok, err = pcall(restock)
				if not ok then warn("[CN] Shop: " .. tostring(err)) end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(pl) bought[pl] = nil end)
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Wild</string><ProtectedString name="Source"><![CDATA[-- Дикие монстры в лесу: появление (днём редко и только до «Редкого», ночью часто и любые),
-- блуждание, погоня и испуг игроков ночью, ловля (держать E), приманки, монстр-подсказка для новичка.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(Shared.Net)
local Monsters = require(Shared.Monsters)

local Wild = {}
local S
local wild = {}     -- model -> состояние
local count = 0
local rng = Random.new()
local scareCd = {}  -- player -> время
local MAP = Config.Map
local W = Config.Wild

local function toast(player, text, color) Net.event("Toast"):FireClient(player, text, color) end
local function now() return S.Cycle.now() end

local function hrpOf(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then return hrp end
	return nil
end

local function flat(v) return Vector3.new(v.X, 0, v.Z) end

-- точка внутри кольца леса
local function clampForest(p)
	local f = flat(p)
	local r = f.Magnitude
	if r < 0.01 then return Vector3.new(MAP.ForestMin + 5, 0, 0) end
	local nr = math.clamp(r, MAP.ForestMin, MAP.ForestMax)
	return f.Unit * nr
end

local function randomForestPoint()
	local r = math.sqrt(rng:NextNumber(MAP.ForestMin ^ 2, MAP.ForestMax ^ 2))
	local a = rng:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

-- игрок в безопасности (у костра или на базе)
local function isSafe(pos)
	if flat(pos).Magnitude < MAP.SafeRadius + 2 then return true end
	return S.Bases.at(pos) ~= nil
end

function Wild.count() return count end

function Wild.remove(model)
	if wild[model] then
		wild[model] = nil
		count = count - 1
	end
	if model.Parent then model:Destroy() end
end

-- opts: pos, key, mut, luck, gold, blood, reserved(player), maxTier, life, idle, fromDrop
function Wild.spawn(opts)
	opts = opts or {}
	local key, mut = opts.key, opts.mut
	if not key then
		local maxTier = opts.maxTier or (S.Cycle.isNight() and #Config.Rarities or 3)
		local r = Util.rollRarity(rng, S.Cycle.luck() * (opts.luck or 1), maxTier)
		key = Util.rollMonster(rng, r.key).key
		mut = Util.rollMutation(rng, { event = S.Cycle.isNight() and S.Cycle.event() or "", gold = opts.gold, blood = opts.blood })
	end
	local def = Config.MonsterIndex[key]
	local r = Config.RarityIndex[def.rarity]
	local pos = opts.pos or randomForestPoint()
	local m, root = Monsters.build(key, mut)
	m.Name = "Wild_" .. key
	m:PivotTo(CFrame.new(pos.X, 0.15, pos.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	local line2 = r.tier > 1 and ("1 к " .. Util.num(r.chance)) or ""
	if opts.reserved then line2 = "🎯 для " .. opts.reserved.DisplayName end
	Monsters.label(m, line2, 90)
	local att = Instance.new("Attachment")
	att.Name = "PromptAtt"
	att.Position = Vector3.new(0, def.size * 0.5, 0)
	att.Parent = root
	local p = Instance.new("ProximityPrompt")
	p.Name = "CatchPrompt"
	p.ActionText = "Поймать"
	p.ObjectText = Util.fullName(key, mut) .. " · сеть " .. r.net .. "+"
	p.HoldDuration = r.hold
	p.MaxActivationDistance = 11
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Parent = att
	m:SetAttribute("Wild", true)
	m:SetAttribute("NeedNet", r.net)
	m.Parent = workspace.Wild
	local st = {
		model = m, root = root, key = key, mut = mut or "", rarity = r, pos = flat(pos), dir = Vector3.new(0, 0, -1),
		target = nil, speed = r.speed, born = now(), life = opts.life or rng:NextNumber(W.LifeMin, W.LifeMax),
		reserved = opts.reserved, reservedUntil = now() + W.ReserveSeconds, idle = opts.idle, phase = rng:NextNumber(0, 6),
		fromBait = opts.reserved ~= nil and not opts.idle,
	}
	wild[m] = st
	count = count + 1
	p.Triggered:Connect(function(player) Wild.catch(player, m) end)
	if r.tier >= Config.AnnounceTier and not opts.fromDrop then
		S.Cycle.announce(string.format("⚠ В лесу появился %s: %s!", string.upper(r.name), Util.fullName(key, mut)), r.color)
	end
	return m
end

function Wild.catch(player, m)
	local st = wild[m]
	if not st then return end
	local hrp = hrpOf(player)
	if not hrp or (flat(hrp.Position) - st.pos).Magnitude > 16 then return end
	if S.Carry.get(player) then
		toast(player, "Руки заняты — отнеси монстра на базу", Color3.fromRGB(255, 200, 90))
		return
	end
	local net = player:GetAttribute("Net") or 1
	if net < st.rarity.net then
		toast(player, "Нужна сеть " .. st.rarity.net .. " уровня! Купи её в Лавке Ловца у костра", Color3.fromRGB(255, 120, 90))
		return
	end
	if st.reserved and st.reserved ~= player and st.reserved.Parent and now() < st.reservedUntil then
		toast(player, "Это монстр из чужой приманки (ещё " .. math.ceil(st.reservedUntil - now()) .. " с)", Color3.fromRGB(255, 200, 90))
		return
	end
	local key, mut, pos = st.key, st.mut, st.pos
	Wild.remove(m)
	local ok = S.Carry.start(player, { k = key, m = mut }, { from = "wild" })
	if not ok then
		Wild.spawn({ pos = pos, key = key, mut = mut, fromDrop = true })
		return
	end
	Net.event("Fx"):FireClient(player, "caught", Util.fullName(key, mut), st.rarity.key)
end

---------------------------------------------------------------- приманки и подсказка новичку
function Wild.useBait(player, baitKey)
	local def = Config.BaitIndex[baitKey]
	local p = S.Data.get(player)
	if not def or not p or (p.baits[baitKey] or 0) <= 0 then return end
	local hrp = hrpOf(player)
	if not hrp then return end
	if isSafe(hrp.Position) then
		toast(player, "Приманку можно ставить только в лесу", Color3.fromRGB(255, 200, 90))
		return
	end
	p.baits[baitKey] = p.baits[baitKey] - 1
	S.Data.sync(player)
	local pos = flat(hrp.Position)
	local bait = Instance.new("Part")
	bait.Name = "Bait"
	bait.Shape = Enum.PartType.Ball
	bait.Size = Vector3.new(1.2, 1.2, 1.2)
	bait.Material = Enum.Material.Neon
	bait.Color = def.blood and Color3.fromRGB(220, 20, 40) or (def.gold and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 140, 80))
	bait.Anchored = true
	bait.CanCollide = false
	bait.CanQuery = false
	bait.CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 0))
	bait.Parent = workspace.Wild
	toast(player, def.icon .. " " .. def.name .. ": кто-то идёт на запах...", Color3.fromRGB(255, 220, 140))
	task.delay(Config.BaitDelay, function()
		if bait.Parent then bait:Destroy() end
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = pos + Vector3.new(math.cos(a), 0, math.sin(a)) * 7
		Wild.spawn({ pos = sp, luck = def.luck, gold = def.gold, blood = def.blood, reserved = player, maxTier = #Config.Rarities })
	end)
end

function Wild.spawnHelper(player)
	local rec = S.Bases.baseOf(player)
	if not rec then return end
	local pos = (rec.cf * CFrame.new(0, 0, -(Config.Map.BaseSize / 2 + 16))).Position
	Wild.spawn({ pos = pos, key = "slipper", mut = "", reserved = player, life = 600, idle = true, fromDrop = true })
	toast(player, "👋 Перед твоей базой — первый монстр! Подойди и держи E, чтобы поймать", Color3.fromRGB(120, 255, 140))
end

---------------------------------------------------------------- смена фаз
function Wild.onDay()
	for m, st in pairs(wild) do
		if st.rarity.nightOnly and not st.fromBait then
			Wild.remove(m)
		else
			st.life = math.min(st.life, now() - st.born + rng:NextNumber(20, 60))
		end
	end
end

function Wild.onNight() end

---------------------------------------------------------------- движение
local function nearestPlayer(pos, range)
	local best, bestD = nil, range
	for _, pl in ipairs(Players:GetPlayers()) do
		local hrp = hrpOf(pl)
		if hrp then
			local d = (flat(hrp.Position) - pos).Magnitude
			if d < bestD and not isSafe(hrp.Position) then best, bestD = pl, d end
		end
	end
	return best, bestD
end

local function step(st, dt, t)
	if st.idle then
		local bob = math.abs(math.sin(t * 3 + st.phase)) * 0.4
		st.root.CFrame = CFrame.lookAt(st.pos + Vector3.new(0, 0.15 + bob, 0), st.pos + st.dir + Vector3.new(0, 0.15 + bob, 0))
		return
	end
	local night = S.Cycle.isNight()
	local speed = st.speed
	local goal = st.target
	-- редкие ночью идут на игрока, мелкие убегают
	local pl, d = nearestPlayer(st.pos, night and 26 or 14)
	if pl then
		local hrp = hrpOf(pl)
		local pp = flat(hrp.Position)
		if night and st.rarity.tier >= 3 then
			goal = pp
			if pp.Magnitude > MAP.ForestMax + 20 then goal = pp.Unit * (MAP.ForestMax + 20) end
			speed = speed * 1.1
			if d < 3 then speed = 0 end
		else
			local away = st.pos - pp
			if away.Magnitude < 0.1 then away = st.dir end
			goal = clampForest(st.pos + away.Unit * 20)
			speed = speed * 1.2
		end
	elseif not goal or (goal - st.pos).Magnitude < 2 then
		st.target = clampForest(st.pos + Vector3.new(rng:NextNumber(-35, 35), 0, rng:NextNumber(-35, 35)))
		goal = st.target
	end
	local to = goal - st.pos
	if to.Magnitude > 0.1 and speed > 0 then
		st.dir = to.Unit
		local np = st.pos + st.dir * math.min(speed * dt, to.Magnitude)
		-- не заходить к костру
		if flat(np).Magnitude < MAP.SafeRadius + 4 then np = flat(np).Unit * (MAP.SafeRadius + 4) end
		st.pos = np
	end
	local hop = math.abs(math.sin(t * 7 + st.phase)) * (st.rarity.tier <= 2 and 0.7 or 0.25)
	local y = 0.15 + hop
	st.root.CFrame = CFrame.lookAt(st.pos + Vector3.new(0, y, 0), st.pos + st.dir + Vector3.new(0, y, 0))
end

-- испуг: монстр рядом ночью может напугать — оглушение и падение монстра с головы
local function scare(player, st)
	scareCd[player] = now() + W.ScareCooldown
	local hrp = hrpOf(player)
	S.Carry.stun(player, W.StunSeconds)
	if S.Carry.get(player) then S.Carry.drop(player, "wild", hrp and hrp.Position) end
	Net.event("Fx"):FireClient(player, "scare", st.key, st.rarity.key)
end

function Wild.init(s)
	S = s
	RunService.Heartbeat:Connect(function(dt)
		local t = now()
		for m, st in pairs(wild) do
			local ok, err = pcall(step, st, dt, t)
			if not ok then
				warn("[CN] Wild step: " .. tostring(err))
				Wild.remove(m)
			elseif t > st.born + st.life then
				Wild.remove(m)
			end
		end
	end)
	-- появление
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.5)
			acc = acc + 0.5
			local ok, err = pcall(function()
				local night = S.Cycle.isNight()
				local interval = night and W.NightInterval or W.DayInterval
				local max = night and W.NightMax or W.DayMax
				if night and S.Cycle.event() == "fog" then max = max + W.FogBonus end
				if acc >= interval then
					acc = 0
					if count < max and #Players:GetPlayers() > 0 then
						-- чаще рядом с игроками в лесу
						local pos = nil
						local list = Players:GetPlayers()
						local pl = list[rng:NextInteger(1, #list)]
						local hrp = hrpOf(pl)
						if hrp and rng:NextNumber() < 0.7 then
							local a = rng:NextNumber(0, math.pi * 2)
							local cand = clampForest(flat(hrp.Position) + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(28, 60))
							if (cand - flat(hrp.Position)).Magnitude > 20 then pos = cand end
						end
						Wild.spawn({ pos = pos })
					end
				end
				-- испуг
				if night then
					for _, pl2 in ipairs(Players:GetPlayers()) do
						local h = hrpOf(pl2)
						if h and (scareCd[pl2] or 0) < now() and not isSafe(h.Position) then
							for _, st in pairs(wild) do
								if not st.idle and (flat(h.Position) - st.pos).Magnitude < W.ScareRange and rng:NextNumber() < st.rarity.scare * 0.5 then
									scare(pl2, st)
									break
								end
							end
						end
					end
				end
			end)
			if not ok then warn("[CN] Wild spawn: " .. tostring(err)) end
		end
	end)
	Players.PlayerRemoving:Connect(function(pl) scareCd[pl] = nil end)
end

return Wild
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Строит карту при запуске сервера: земля, тёмный лес с тропинками, поляна с костром и лавкой
-- в центре, 8 баз по кругу. World.build() -> { bases = { Model... }, shop = Part }.
-- База смотрит дверью на центр карты (это её локальное −Z). Клетки — у задней стены.
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local B = require(Shared.Build)

local World = {}

local MAP = Config.Map
local rad = math.rad
local hex = Color3.fromHex

local BASE_COLORS = { "#3d5a80", "#7a3b3b", "#3b7a52", "#7a6a3b", "#5a3b7a", "#3b6f7a", "#7a3b66", "#4f4f4f" }

-- клетки: 2 ряда по 6, сначала центральные у задней стены
local SLOT_X = { -5, 5, -15, 15, -25, 25 }
local SLOT_ROWS = { 22, 8 }
local function slotOffsets()
	local out = {}
	for _, z in ipairs(SLOT_ROWS) do
		for _, x in ipairs(SLOT_X) do table.insert(out, Vector3.new(x, 0, z)) end
	end
	return out
end
World.SlotOffsets = slotOffsets()

---------------------------------------------------------------- лес
local function tree(parent, rng, x, z)
	local m = B.model(parent, "Tree")
	local h = rng:NextNumber(14, 24)
	local d = rng:NextNumber(1.6, 2.8)
	local dead = rng:NextNumber() < 0.3
	local bark = dead and hex("#3b3330") or hex("#4a3628")
	B.vcyl(m, "Trunk", h, d, CFrame.new(x, h / 2, z), bark, Enum.Material.Wood)
	if dead then
		for i = 1, rng:NextInteger(2, 4) do
			local y = h * rng:NextNumber(0.5, 0.9)
			local yaw = rng:NextNumber(0, 360)
			local len = rng:NextNumber(4, 7)
			local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rad(yaw), rad(rng:NextNumber(20, 45))) * CFrame.new(len / 2, 0, 0)
			B.part(m, "Branch", Vector3.new(len, 0.6, 0.6), cf, bark, Enum.Material.Wood)
		end
	else
		local leaf = rng:NextNumber() < 0.5 and hex("#1f3b24") or hex("#24432a")
		B.ball(m, "Leaves", rng:NextNumber(9, 13), CFrame.new(x, h, z), leaf, Enum.Material.Grass)
		B.ball(m, "Leaves", rng:NextNumber(6, 9), CFrame.new(x + rng:NextNumber(-3, 3), h + 3.5, z + rng:NextNumber(-3, 3)), leaf, Enum.Material.Grass)
	end
	return m
end

local function mushroom(parent, rng, x, z)
	local colors = { hex("#40e0ff"), hex("#b06bff"), hex("#7dff6b") }
	local col = colors[rng:NextInteger(1, #colors)]
	B.vcyl(parent, "Stem", 0.8, 0.3, CFrame.new(x, 0.4, z), hex("#d8d0c0"))
	B.vcyl(parent, "Cap", 0.4, 1.2, CFrame.new(x, 0.9, z), col, Enum.Material.Neon)
end

-- расстояние от точки до ближайшей тропы (лучи от центра к базам)
local function pathDist(x, z)
	local best = math.huge
	for i = 1, MAP.BaseCount do
		local a = rad((i - 1) * 360 / MAP.BaseCount)
		local dx, dz = math.cos(a), math.sin(a)
		local along = x * dx + z * dz
		if along > 0 then
			local px, pz = x - dx * along, z - dz * along
			best = math.min(best, math.sqrt(px * px + pz * pz))
		end
	end
	return best
end

local function buildForest(map)
	local rng = Random.new(20261011)
	local forest = B.model(map, "Forest")
	local trees = 0
	local tries = 0
	while trees < 170 and tries < 3000 do
		tries = tries + 1
		local r = math.sqrt(rng:NextNumber(MAP.ForestMin ^ 2, MAP.ForestMax ^ 2))
		local a = rng:NextNumber(0, math.pi * 2)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if pathDist(x, z) > 9 then
			tree(forest, rng, x, z)
			trees = trees + 1
		end
	end
	local props = B.model(map, "Props")
	for _ = 1, 40 do
		local r = rng:NextNumber(MAP.SafeRadius + 6, MAP.ForestMax + 20)
		local a = rng:NextNumber(0, math.pi * 2)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if pathDist(x, z) > 7 then
			local s = rng:NextNumber(2, 5)
			local cf = CFrame.new(x, s * 0.25, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3))
			B.part(props, "Rock", Vector3.new(s * 1.3, s * 0.7, s), cf, hex("#55585e"), Enum.Material.Slate)
		end
	end
	for _ = 1, 90 do
		local r = rng:NextNumber(MAP.SafeRadius + 4, MAP.ForestMax)
		local a = rng:NextNumber(0, math.pi * 2)
		mushroom(props, rng, math.cos(a) * r, math.sin(a) * r)
	end
end

local function buildPaths(map)
	local paths = B.model(map, "Paths")
	local from, to = MAP.SafeRadius - 2, MAP.BaseRadius - MAP.BaseSize / 2 + 2
	for i = 1, MAP.BaseCount do
		local a = (i - 1) * 360 / MAP.BaseCount
		local dir = Vector3.new(math.cos(rad(a)), 0, math.sin(rad(a)))
		local mid = dir * ((from + to) / 2)
		local cf = CFrame.lookAt(Vector3.new(mid.X, 0.05, mid.Z), Vector3.new(mid.X, 0.05, mid.Z) + dir)
		B.part(paths, "Path", Vector3.new(10, 0.1, to - from), cf, hex("#5e4f3c"), Enum.Material.Ground, { CanQuery = false })
		-- фонари вдоль тропы
		for k = 1, 3 do
			local p = dir * (from + (to - from) * k / 4) + Vector3.new(-dir.Z, 0, dir.X) * 6.5
			B.vcyl(paths, "LampPost", 9, 0.5, CFrame.new(p.X, 4.5, p.Z), hex("#2b2b2b"), Enum.Material.Metal)
			local lamp = B.part(paths, "Lamp", Vector3.new(1.4, 1.4, 1.4), CFrame.new(p.X, 9.4, p.Z), hex("#ffcf7a"), Enum.Material.Neon)
			B.light(lamp, "PointLight", { Range = 18, Brightness = 1.3, Color = hex("#ffc27a"), Shadows = false })
		end
	end
end

---------------------------------------------------------------- центр: костёр и лавка
local function buildClearing(map)
	local c = B.model(map, "Clearing")
	B.vcyl(c, "Ground", 0.2, MAP.SafeRadius * 2, CFrame.new(0, 0.1, 0), hex("#5b4a36"), Enum.Material.Ground)
	local fire = B.part(c, "Campfire", Vector3.new(4, 1, 4), CFrame.new(0, 0.7, 0), hex("#3a2a1c"), Enum.Material.Wood)
	B.cyl(c, "Log", 6, 1, CFrame.new(0, 0.8, 0) * CFrame.Angles(0, rad(30), 0), hex("#5a3d26"), Enum.Material.Wood)
	B.cyl(c, "Log", 6, 1, CFrame.new(0, 0.8, 0) * CFrame.Angles(0, rad(-30), 0), hex("#5a3d26"), Enum.Material.Wood)
	for i = 0, 9 do
		local a = rad(i * 36)
		B.ball(c, "Stone", 1.4, CFrame.new(math.cos(a) * 3.6, 0.5, math.sin(a) * 3.6), hex("#6b6f75"), Enum.Material.Slate)
	end
	local f = Instance.new("Fire")
	f.Size = 7
	f.Heat = 12
	f.Color = hex("#ff8a2a")
	f.SecondaryColor = hex("#ffd84a")
	f.Parent = fire
	B.light(fire, "PointLight", { Range = 45, Brightness = 2.2, Color = hex("#ffb36b") })
	-- брёвна-скамейки
	for i = 0, 3 do
		local a = rad(45 + i * 90)
		local cf = CFrame.new(math.cos(a) * 11, 0.8, math.sin(a) * 11) * CFrame.Angles(0, -(a + rad(90)), 0)
		B.cyl(c, "Bench", 7, 1.6, cf, hex("#5a3d26"), Enum.Material.Wood)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(0, 0.3, 16)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = c
	-- безопасная зона (для клиента и монстров)
	B.marker(c, "SafeZone", Vector3.new(MAP.SafeRadius * 2, 20, MAP.SafeRadius * 2), CFrame.new(0, 10, 0))
	return c
end

local function buildShop(map)
	local s = B.model(map, "Shop")
	local base = CFrame.new(0, 0, -20) -- лавка смотрит на костёр (+Z)
	local wood = hex("#7a5232")
	local counter = B.part(s, "Counter", Vector3.new(12, 3.5, 3), base * CFrame.new(0, 1.75, 0), wood, Enum.Material.WoodPlanks)
	B.part(s, "Top", Vector3.new(12.6, 0.4, 3.6), base * CFrame.new(0, 3.7, 0), hex("#5a3a22"), Enum.Material.Wood)
	for _, x in ipairs({ -5.8, 5.8 }) do
		B.part(s, "Pole", Vector3.new(0.6, 10, 0.6), base * CFrame.new(x, 5, -2.5), hex("#4a3020"), Enum.Material.Wood)
		B.part(s, "Pole", Vector3.new(0.6, 8, 0.6), base * CFrame.new(x, 4, 1.4), hex("#4a3020"), Enum.Material.Wood)
	end
	-- полосатый навес
	for i = 0, 5 do
		local col = (i % 2 == 0) and hex("#6b2fa0") or hex("#2a2140")
		B.part(s, "Awning", Vector3.new(2.2, 0.3, 5.4), base * CFrame.new(-5.5 + i * 2.2, 9, -0.6) * CFrame.Angles(rad(-14), 0, 0), col, Enum.Material.Fabric)
	end
	local board = B.part(s, "SignBoard", Vector3.new(12, 2.4, 0.4), base * CFrame.new(0, 10.6, 1.8), hex("#1a1426"), Enum.Material.Wood)
	B.sign(board, Enum.NormalId.Back, "🛒 ЛАВКА ЛОВЦА", { TextColor3 = hex("#ffd84a"), Font = Enum.Font.GothamBlack })
	-- продавец в капюшоне
	local cloak = hex("#231a33")
	B.part(s, "Keeper", Vector3.new(2.4, 4.2, 1.6), base * CFrame.new(0, 3.6, -2.6), cloak, Enum.Material.Fabric)
	B.ball(s, "Hood", 2.2, base * CFrame.new(0, 6.4, -2.6), cloak, Enum.Material.Fabric)
	local e1 = B.ball(s, "Eye", 0.35, base * CFrame.new(-0.4, 6.4, -1.6), hex("#ffe14a"), Enum.Material.Neon)
	local e2 = B.ball(s, "Eye", 0.35, base * CFrame.new(0.4, 6.4, -1.6), hex("#ffe14a"), Enum.Material.Neon)
	e1.CanCollide, e2.CanCollide = false, false
	-- товары на прилавке
	for i = 0, 4 do
		B.ball(s, "Jar", 0.9, base * CFrame.new(-4 + i * 2, 4.4, 0.3), (i % 2 == 0) and hex("#ffcf40") or hex("#ff4a6a"), Enum.Material.Glass, { Transparency = 0.2 })
	end
	B.light(board, "PointLight", { Range = 20, Brightness = 1.2, Color = hex("#c79bff"), Shadows = false })
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 1.5, 1.5)
	att.Parent = counter
	B.prompt(att, "ShopPrompt", "Открыть лавку", "Лавка Ловца", { MaxActivationDistance = 14, HoldDuration = 0 })
	return counter
end

---------------------------------------------------------------- базы
local function buildBase(folder, i)
	local a = rad((i - 1) * 360 / MAP.BaseCount)
	local center = Vector3.new(math.cos(a) * MAP.BaseRadius, 0, math.sin(a) * MAP.BaseRadius)
	local cf = CFrame.lookAt(center, Vector3.new(0, 0, 0))
	local half = MAP.BaseSize / 2
	local col = hex(BASE_COLORS[(i - 1) % #BASE_COLORS + 1])
	local m = B.model(folder, "Base_" .. i)
	m:SetAttribute("Index", i)
	m:SetAttribute("OwnerId", 0)
	m:SetAttribute("OwnerName", "")
	m:SetAttribute("Locked", false)
	m:SetAttribute("LockEnds", 0)
	m:SetAttribute("Income", 0)

	B.part(m, "Floor", Vector3.new(MAP.BaseSize, 1, MAP.BaseSize), cf * CFrame.new(0, 0.5, 0), col:Lerp(Color3.new(0, 0, 0), 0.35), Enum.Material.Concrete)
	B.marker(m, "Zone", Vector3.new(MAP.BaseSize, 24, MAP.BaseSize), cf * CFrame.new(0, 12, 0))
	local h, th = MAP.WallHeight, 2
	local wallCol = col:Lerp(Color3.fromRGB(30, 30, 35), 0.5)
	local walls = B.model(m, "Walls")
	local function w(x0, z0, x1, z1, openings)
		local p0 = (cf * CFrame.new(x0, 1, z0)).Position
		local p1 = (cf * CFrame.new(x1, 1, z1)).Position
		B.wall(walls, "Wall", p0, p1, h, th, wallCol, Enum.Material.Brick, openings)
	end
	local e = half - th / 2
	w(-half, e, half, e)                 -- задняя
	w(-e, -half, -e, half)               -- левая
	w(e, -half, e, half)                 -- правая
	w(-half, -e, half, -e, { { at = half, w = 12, y0 = 0, y1 = h } }) -- передняя с проёмом
	-- край стены (чтобы не смотрелось плоско)
	for _, x in ipairs({ -6.6, 6.6 }) do
		B.part(m, "DoorPost", Vector3.new(1.2, h + 1, 2.6), cf * CFrame.new(x, 1 + (h + 1) / 2, -e), col, Enum.Material.Metal)
	end
	local door = B.part(m, "Door", Vector3.new(12, h, 0.8), cf * CFrame.new(0, 1 + h / 2, -e), hex("#ff2a3a"), Enum.Material.Neon,
		{ Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false })
	local lockGui = Instance.new("BillboardGui")
	lockGui.Name = "LockGui"
	lockGui.Size = UDim2.new(0, 160, 0, 50)
	lockGui.StudsOffset = Vector3.new(0, h / 2 + 2, 0)
	lockGui.MaxDistance = 120
	lockGui.Enabled = false
	lockGui.Parent = door
	local lt = Instance.new("TextLabel")
	lt.Name = "Text"
	lt.Size = UDim2.fromScale(1, 1)
	lt.BackgroundTransparency = 1
	lt.Font = Enum.Font.GothamBlack
	lt.TextScaled = true
	lt.TextColor3 = hex("#ff5a6a")
	lt.TextStrokeTransparency = 0.3
	lt.Text = "🔒"
	lt.Parent = lockGui

	-- вывеска над дверью
	local sign = B.part(m, "SignBoard", Vector3.new(16, 3.2, 0.6), cf * CFrame.new(0, 1 + h + 1.6, -e), hex("#14121c"), Enum.Material.Wood)
	local _, signText = B.sign(sign, Enum.NormalId.Front, "Свободная база", { TextColor3 = hex("#ffe9a0"), Font = Enum.Font.GothamBlack })
	signText.Name = "OwnerText"
	-- имя и доход высоко над базой
	local top = B.marker(m, "Top", Vector3.new(1, 1, 1), cf * CFrame.new(0, 30, 0))
	local bg = Instance.new("BillboardGui")
	bg.Name = "OwnerGui"
	bg.Size = UDim2.new(0, 260, 0, 70)
	bg.MaxDistance = 450
	bg.LightInfluence = 0
	bg.Parent = top
	local n = Instance.new("TextLabel")
	n.Name = "NameText"
	n.Size = UDim2.new(1, 0, 0.6, 0)
	n.BackgroundTransparency = 1
	n.Font = Enum.Font.GothamBlack
	n.TextScaled = true
	n.TextColor3 = Color3.new(1, 1, 1)
	n.TextStrokeTransparency = 0.2
	n.Text = ""
	n.Parent = bg
	local inc = n:Clone()
	inc.Name = "Income"
	inc.Position = UDim2.new(0, 0, 0.6, 0)
	inc.Size = UDim2.new(1, 0, 0.4, 0)
	inc.TextColor3 = hex("#ffd84a")
	inc.Parent = bg
	-- метка «ТВОЯ БАЗА» (клиент включает её хозяину, когда он несёт монстра)
	local hm = Instance.new("BillboardGui")
	hm.Name = "HomeMarker"
	hm.Size = UDim2.new(0, 200, 0, 50)
	hm.AlwaysOnTop = true
	hm.MaxDistance = 2000
	hm.LightInfluence = 0
	hm.Enabled = false
	hm.Parent = top
	local ht = n:Clone()
	ht.Name = "Text"
	ht.Size = UDim2.fromScale(1, 1)
	ht.Text = "🏠 ТВОЯ БАЗА"
	ht.TextColor3 = hex("#7dff6b")
	ht.Parent = hm

	-- замок
	local pad = B.part(m, "LockPad", Vector3.new(5, 0.4, 5), cf * CFrame.new(-22, 1.2, -22), hex("#3cff6a"), Enum.Material.Neon)
	local post = B.part(m, "LockPost", Vector3.new(1, 4, 1), cf * CFrame.new(-22, 3, -25), hex("#2b2b30"), Enum.Material.Metal)
	B.sign(post, Enum.NormalId.Front, "🔒", nil, { PixelsPerStud = 50 })
	local lockAtt = Instance.new("Attachment")
	lockAtt.Position = Vector3.new(0, 2, 0)
	lockAtt.Parent = pad
	local lp = B.prompt(lockAtt, "LockPrompt", "Запереть базу", Config.LockSeconds .. " секунд", { HoldDuration = 0, MaxActivationDistance = 9 })
	lp:SetAttribute("For", "owner")

	B.marker(m, "Spawn", Vector3.new(2, 1, 2), cf * CFrame.new(0, 4, -16))

	-- фонари в углах
	for _, x in ipairs({ -half + 3, half - 3 }) do
		B.vcyl(m, "LampPost", 10, 0.6, cf * CFrame.new(x, 6, -half + 3), hex("#2b2b2b"), Enum.Material.Metal)
		local lamp = B.part(m, "Lamp", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(x, 11.4, -half + 3), col:Lerp(Color3.new(1, 1, 1), 0.5), Enum.Material.Neon)
		B.light(lamp, "PointLight", { Range = 34, Brightness = 1.4, Color = col:Lerp(Color3.new(1, 1, 1), 0.6), Shadows = false })
	end

	-- клетки
	local slots = B.folder(m, "Slots")
	for s, off in ipairs(World.SlotOffsets) do
		local sm = B.model(slots, "Slot_" .. s)
		sm:SetAttribute("Slot", s)
		local scf = cf * CFrame.new(off.X, 0, off.Z)
		B.part(sm, "Rim", Vector3.new(8.6, 0.6, 8.6), scf * CFrame.new(0, 1.3, 0), hex("#55555c"), Enum.Material.Neon)
		local padPart = B.part(sm, "Pad", Vector3.new(8, 1, 8), scf * CFrame.new(0, 1.5, 0), hex("#2d2d33"), Enum.Material.DiamondPlate)
		B.marker(sm, "Anchor", Vector3.new(1, 1, 1), scf * CFrame.new(0, 2.05, 0))
		local bars = B.model(sm, "Bars")
		for _, c in ipairs({ { -3.8, -3.8 }, { 3.8, -3.8 }, { -3.8, 3.8 }, { 3.8, 3.8 } }) do
			B.part(bars, "Bar", Vector3.new(0.4, 9, 0.4), scf * CFrame.new(c[1], 6.5, c[2]), hex("#5d5d66"), Enum.Material.Metal, { CanCollide = false })
		end
		B.part(bars, "Bar", Vector3.new(8, 0.4, 0.4), scf * CFrame.new(0, 11, -3.8), hex("#5d5d66"), Enum.Material.Metal, { CanCollide = false })
		B.part(bars, "Bar", Vector3.new(8, 0.4, 0.4), scf * CFrame.new(0, 11, 3.8), hex("#5d5d66"), Enum.Material.Metal, { CanCollide = false })
		B.part(bars, "Bar", Vector3.new(0.4, 0.4, 8), scf * CFrame.new(-3.8, 11, 0), hex("#5d5d66"), Enum.Material.Metal, { CanCollide = false })
		B.part(bars, "Bar", Vector3.new(0.4, 0.4, 8), scf * CFrame.new(3.8, 11, 0), hex("#5d5d66"), Enum.Material.Metal, { CanCollide = false })
		local att = Instance.new("Attachment")
		att.Name = "PromptAtt"
		att.Position = Vector3.new(0, 3, -3)
		att.Parent = padPart
		local steal = B.prompt(att, "StealPrompt", "Украсть", "", { HoldDuration = Config.StealHold, MaxActivationDistance = 10, Enabled = false })
		steal:SetAttribute("For", "others")
		local sell = B.prompt(att, "SellPrompt", "Продать", "", { HoldDuration = Config.SellHold, MaxActivationDistance = 10, Enabled = false })
		sell:SetAttribute("For", "owner")
		local buy = B.prompt(att, "BuyPrompt", "Купить клетку", "", { HoldDuration = 0, MaxActivationDistance = 10, Enabled = false })
		buy:SetAttribute("For", "owner")
		local lg = Instance.new("BillboardGui")
		lg.Name = "LockedGui"
		lg.Size = UDim2.new(0, 150, 0, 40)
		lg.StudsOffset = Vector3.new(0, 2.5, 0)
		lg.MaxDistance = 60
		lg.Enabled = false
		lg.Parent = padPart
		local lgt = n:Clone()
		lgt.Name = "Text"
		lgt.Size = UDim2.fromScale(1, 1)
		lgt.TextColor3 = hex("#c8c8d0")
		lgt.Text = "🔒"
		lgt.Parent = lg
	end
	return m
end

function World.build()
	local map = B.folder(workspace, "Map")
	local ground = B.part(map, "Ground", Vector3.new(1000, 2, 1000), CFrame.new(0, -1, 0), hex("#2b3d27"), Enum.Material.Grass)
	ground.Locked = true
	for _, s in ipairs({ { 0, 480, 1000, 1 }, { 0, -480, 1000, 1 }, { 480, 0, 1, 1000 }, { -480, 0, 1, 1000 } }) do
		B.part(map, "Border", Vector3.new(s[3], 200, s[4]), CFrame.new(s[1], 100, s[2]), nil, nil, { Transparency = 1, CanQuery = false })
	end
	buildForest(map)
	buildPaths(map)
	buildClearing(map)
	local shop = buildShop(map)
	local folder = B.folder(workspace, "Bases")
	local bases = {}
	for i = 1, MAP.BaseCount do bases[i] = buildBase(folder, i) end
	B.folder(workspace, "Wild")
	B.folder(workspace, "Carried")
	return { bases = bases, shop = shop }
end

return World
